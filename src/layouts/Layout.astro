---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/admin-themes.css';
import ImageCropHost from '../components/admin/ImageCropHost.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'blacksushi' | 'sanza' | 'crx';
  themeColor?: string;
  /** Google Fonts stylesheet del ADN de diseño (override). */
  fontHref?: string;
  /** CSS personalizado del restaurante (inyectado en <head>). */
  customCss?: string;
  /** Open Graph / WhatsApp share image */
  ogImage?: string;
  /** Favicon / PWA / apple-touch-icon */
  appIcon?: string;
  /** Manifiesto de la webapp del restaurante */
  manifestHref?: string;
  /** Nombre bajo el ícono al instalar */
  appName?: string;
  /** Absolute page URL for og:url */
  ogUrl?: string;
  /** Activa shell admin (siempre light). */
  adminPanel?: boolean;
}

const {
  title,
  description = 'Experiencia móvil CRX',
  theme = 'crx',
  themeColor = '#09090b',
  fontHref: fontHrefProp,
  customCss = '',
  ogImage = '',
  appIcon = '',
  manifestHref = '',
  appName = '',
  ogUrl = '',
  adminPanel = false,
} = Astro.props;

const fontHref =
  fontHrefProp ||
  (adminPanel
    ? 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600;1,9..144,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap'
    : theme === 'sanza'
      ? 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap'
      : theme === 'blacksushi'
        ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap'
        : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@600;700&display=swap');

const safeCustomCss = typeof customCss === 'string' ? customCss : '';
const iconHref =
  appIcon?.trim() ||
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337633/IMG_3774_zsxajg.png';
const shareImage = ogImage?.trim() || '';
const initialThemeColor = adminPanel ? '#f8fafc' : themeColor;

/** Safari toma el chrome del canvas (html/body), no de una capa interna. */
function chromeIsLight(color: string) {
  const hex = color.trim().match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i)?.[1];
  if (!hex) return false;
  const full = hex.length === 3 ? hex.split('').map((c) => c + c).join('') : hex;
  const r = parseInt(full.slice(0, 2), 16);
  const g = parseInt(full.slice(2, 4), 16);
  const b = parseInt(full.slice(4, 6), 16);
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 > 0.62;
}

const chromeScheme = adminPanel || chromeIsLight(initialThemeColor) ? 'light' : 'dark';
const chromeStyle = `background-color:${initialThemeColor};color-scheme:${chromeScheme}`;
---

<!doctype html>
<html
  lang="es"
  data-theme={adminPanel ? 'light' : theme}
  style={chromeStyle}
  class:list={[
    adminPanel && 'admin-panel light transition-colors duration-500 ease-in-out',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {
      !adminPanel ? (
        <>
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
          <meta name="mobile-web-app-capable" content="yes" />
        </>
      ) : null
    }
    <link rel="icon" href={iconHref} />
    <link rel="apple-touch-icon" href={iconHref} sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content={chromeScheme} id="meta-color-scheme" />
    <meta
      name="theme-color"
      content={initialThemeColor}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={initialThemeColor}
      media="(prefers-color-scheme: dark)"
      id="meta-theme-color"
    />
    {
      adminPanel ? (
        <>
          <link rel="manifest" href="/admin.webmanifest" />
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
          <meta name="apple-mobile-web-app-title" content="Xemilla" />
          <meta name="mobile-web-app-capable" content="yes" />
          <meta name="application-name" content="Xemilla Studio" />
        </>
      ) : manifestHref ? (
        <>
          <link rel="manifest" href={manifestHref} />
          {appName ? <meta name="apple-mobile-web-app-title" content={appName} /> : null}
          {appName ? <meta name="application-name" content={appName} /> : null}
          <script is:inline>
            if ('serviceWorker' in navigator) {
              navigator.serviceWorker.register('/sw.js').catch(function () {});
            }
          </script>
        </>
      ) : null
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogUrl ? <meta property="og:url" content={ogUrl} /> : null}
    {shareImage ? <meta property="og:image" content={shareImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage ? <meta name="twitter:image" content={shareImage} /> : null}
    <title>{title}</title>
    <ClientRouter />
    {
      adminPanel && (
        <script is:inline>
          (function () {
            try {
              var KEY = 'xemilla-admin-theme';
              var root = document.documentElement;
              root.classList.add('admin-panel', 'light');
              root.classList.remove('dark');
              root.setAttribute('data-theme', 'light');
              document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
                meta.setAttribute('content', '#f8fafc');
              });
              var scheme = document.getElementById('meta-color-scheme');
              if (scheme) scheme.setAttribute('content', 'light');
              root.style.backgroundColor = '#f8fafc';
              root.style.colorScheme = 'light';
              if (document.body) {
                document.body.style.backgroundColor = '#f8fafc';
                document.body.style.colorScheme = 'light';
              }
              try {
                localStorage.setItem(KEY, 'light');
              } catch (e) {}
            } catch (e) {}
          })();
        </script>
      )
    }
    {safeCustomCss ? <style set:html={safeCustomCss} /> : null}
  </head>
  <body
    style={chromeStyle}
    class:list={[
      'relative min-h-dvh antialiased theme-body',
      `theme-${theme}`,
      adminPanel && 'admin-panel-body transition-colors duration-500 ease-in-out',
    ]}
  >
    {
      adminPanel ? (
        <div
          class="pointer-events-none fixed inset-0 z-[-1]"
          style="background: radial-gradient(ellipse 90% 60% at 50% -10%, rgba(255,255,255,0.98), transparent 55%), linear-gradient(180deg, #f7f8fa 0%, #eef1f5 100%);"
          aria-hidden="true"
        ></div>
      ) : (
        <div class="atmosphere" aria-hidden="true">
          <div class="atmosphere__base"></div>
          <div class="atmosphere__texture"></div>
          <div class="atmosphere__glow"></div>
        </div>
      )
    }
    <div class="relative z-10 min-h-dvh w-full min-w-full max-w-none pointer-events-auto">
      <slot />
    </div>
    {adminPanel ? <ImageCropHost /> : null}
  </body>
</html>
