---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  theme?: 'blacksushi' | 'sanza' | 'crx';
  themeColor?: string;
}

const {
  title,
  description = 'Experiencia móvil CRX',
  theme = 'crx',
  themeColor = '#09090b',
} = Astro.props;

const fontHref =
  theme === 'sanza'
    ? 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap'
    : theme === 'blacksushi'
      ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap'
      : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@600;700&display=swap';
---

<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
  </head>
  <body class={`relative min-h-dvh antialiased theme-body theme-${theme}`}>
    <div class="atmosphere" aria-hidden="true">
      <div class="atmosphere__base"></div>
      <div class="atmosphere__texture"></div>
      <div class="atmosphere__glow"></div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
