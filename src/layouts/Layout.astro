---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/admin-themes.css';
import ImageCropHost from '../components/admin/ImageCropHost.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'blacksushi' | 'sanza' | 'crx';
  themeColor?: string;
  /** Google Fonts stylesheet del ADN de diseño (override). */
  fontHref?: string;
  /** CSS personalizado del restaurante (inyectado en <head>). */
  customCss?: string;
  /** Open Graph / WhatsApp share image */
  ogImage?: string;
  /** Favicon / PWA / apple-touch-icon */
  appIcon?: string;
  /** Absolute page URL for og:url */
  ogUrl?: string;
  /** Activa shell admin (tema dark/light persistido en localStorage). */
  adminPanel?: boolean;
}

const {
  title,
  description = 'Experiencia móvil CRX',
  theme = 'crx',
  themeColor = '#09090b',
  fontHref: fontHrefProp,
  customCss = '',
  ogImage = '',
  appIcon = '',
  ogUrl = '',
  adminPanel = false,
} = Astro.props;

const fontHref =
  fontHrefProp ||
  (adminPanel
    ? 'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap'
    : theme === 'sanza'
      ? 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap'
      : theme === 'blacksushi'
        ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap'
        : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@600;700&display=swap');

const safeCustomCss = typeof customCss === 'string' ? customCss : '';
const iconHref =
  appIcon?.trim() ||
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337633/IMG_3774_zsxajg.png';
const shareImage = ogImage?.trim() || '';
const initialThemeColor = adminPanel ? '#030712' : themeColor;
---

<!doctype html>
<html
  lang="es"
  data-theme={adminPanel ? 'dark' : theme}
  class:list={[
    adminPanel && 'admin-panel dark transition-colors duration-500 ease-in-out',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href={iconHref} />
    <link rel="apple-touch-icon" href={iconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={initialThemeColor} id="meta-theme-color" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogUrl ? <meta property="og:url" content={ogUrl} /> : null}
    {shareImage ? <meta property="og:image" content={shareImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage ? <meta name="twitter:image" content={shareImage} /> : null}
    <title>{title}</title>
    <ClientRouter />
    {
      adminPanel && (
        <script is:inline>
          (function () {
            try {
              var KEY = 'xemilla-admin-theme';
              var raw = '';
              try {
                raw = localStorage.getItem(KEY) || '';
              } catch (e) {}
              var v = String(raw).trim().toLowerCase();
              var light =
                v === 'light' ||
                v === 'claro' ||
                v === 'alabastro' ||
                v === 'organico' ||
                v === 'organic' ||
                v === 'cristalino';
              var id = light ? 'light' : 'dark';
              var root = document.documentElement;
              root.classList.add('admin-panel');
              root.classList.toggle('dark', id === 'dark');
              root.classList.toggle('light', id === 'light');
              root.setAttribute('data-theme', id);
              var meta = document.getElementById('meta-theme-color');
              if (meta) meta.setAttribute('content', id === 'light' ? '#eef1f4' : '#050505');
              try {
                localStorage.setItem(KEY, id);
              } catch (e) {}
            } catch (e) {}
          })();
        </script>
      )
    }
    {safeCustomCss ? <style set:html={safeCustomCss} /> : null}
  </head>
  <body
    class:list={[
      'relative min-h-dvh antialiased theme-body',
      `theme-${theme}`,
      adminPanel && 'admin-panel-body transition-colors duration-500 ease-in-out',
    ]}
  >
    {
      adminPanel ? (
        <>
          <div class="admin-deep-space" aria-hidden="true">
            <div class="admin-deep-space__base"></div>
            <div class="admin-deep-space__orbs"></div>
            <div class="admin-deep-space__nebula"></div>
            <div class="admin-deep-space__stars"></div>
            <div class="admin-deep-space__stardust"></div>
            <div class="admin-deep-space__amber"></div>
            <div class="admin-deep-space__grid"></div>
          </div>
          {/* Light: soft daylight — no logo watermark */}
          <div
            class="pointer-events-none fixed inset-0 z-[-1] opacity-100 transition-opacity duration-1000 dark:opacity-0 dark:hidden block"
            style="background: radial-gradient(ellipse 90% 60% at 50% -10%, rgba(255,255,255,0.95), transparent 55%), linear-gradient(180deg, #f5f7fa 0%, #e7ebf0 100%);"
            aria-hidden="true"
          ></div>
        </>
      ) : (
        <div class="atmosphere" aria-hidden="true">
          <div class="atmosphere__base"></div>
          <div class="atmosphere__texture"></div>
          <div class="atmosphere__glow"></div>
        </div>
      )
    }
    <div class="relative z-10 pointer-events-auto">
      <slot />
    </div>
    {adminPanel ? <ImageCropHost /> : null}
  </body>
</html>
