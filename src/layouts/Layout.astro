---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/admin-themes.css';

interface Props {
  title: string;
  description?: string;
  theme?: 'blacksushi' | 'sanza' | 'crx';
  themeColor?: string;
  /** Google Fonts stylesheet del ADN de diseño (override). */
  fontHref?: string;
  /** CSS personalizado del restaurante (inyectado en <head>). */
  customCss?: string;
  /** Open Graph / WhatsApp share image */
  ogImage?: string;
  /** Favicon / PWA / apple-touch-icon */
  appIcon?: string;
  /** Absolute page URL for og:url */
  ogUrl?: string;
  /** Activa shell admin (tema dark/light persistido en localStorage). */
  adminPanel?: boolean;
}

const {
  title,
  description = 'Experiencia móvil CRX',
  theme = 'crx',
  themeColor = '#09090b',
  fontHref: fontHrefProp,
  customCss = '',
  ogImage = '',
  appIcon = '',
  ogUrl = '',
  adminPanel = false,
} = Astro.props;

const fontHref =
  fontHrefProp ||
  (theme === 'sanza'
    ? 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap'
    : theme === 'blacksushi'
      ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap'
      : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@600;700&display=swap');

const safeCustomCss = typeof customCss === 'string' ? customCss : '';
const iconHref = appIcon?.trim() || '/favicon.svg';
const shareImage = ogImage?.trim() || '';
const initialThemeColor = adminPanel ? '#030712' : themeColor;
---

<!doctype html>
<html
  lang="es"
  data-theme={adminPanel ? 'dark' : theme}
  class:list={[
    adminPanel && 'admin-panel dark transition-colors duration-500 ease-in-out',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href={iconHref} />
    <link rel="apple-touch-icon" href={iconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={initialThemeColor} id="meta-theme-color" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogUrl ? <meta property="og:url" content={ogUrl} /> : null}
    {shareImage ? <meta property="og:image" content={shareImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage ? <meta name="twitter:image" content={shareImage} /> : null}
    <title>{title}</title>
    <ClientRouter />
    {
      adminPanel && (
        <script is:inline>
          (function () {
            try {
              var KEY = 'xemilla-admin-theme';
              var raw = '';
              try {
                raw = localStorage.getItem(KEY) || '';
              } catch (e) {}
              var v = String(raw).trim().toLowerCase();
              var light =
                v === 'light' ||
                v === 'claro' ||
                v === 'alabastro' ||
                v === 'organico' ||
                v === 'organic' ||
                v === 'cristalino';
              var id = light ? 'light' : 'dark';
              var root = document.documentElement;
              root.classList.add('admin-panel');
              root.classList.toggle('dark', id === 'dark');
              root.classList.toggle('light', id === 'light');
              root.setAttribute('data-theme', id);
              var meta = document.getElementById('meta-theme-color');
              if (meta) meta.setAttribute('content', id === 'light' ? '#f8fafc' : '#030712');
              try {
                localStorage.setItem(KEY, id);
              } catch (e) {}
            } catch (e) {}
          })();
        </script>
      )
    }
    {safeCustomCss ? <style set:html={safeCustomCss} /> : null}
  </head>
  <body
    class:list={[
      'relative min-h-dvh antialiased theme-body',
      `theme-${theme}`,
      adminPanel && 'admin-panel-body transition-colors duration-500 ease-in-out',
    ]}
  >
    {
      adminPanel ? (
        <>
          <div class="admin-deep-space" aria-hidden="true">
            <div class="admin-deep-space__base"></div>
            <div class="admin-deep-space__orbs"></div>
            <div class="admin-deep-space__nebula"></div>
            <div class="admin-deep-space__stars"></div>
            <div class="admin-deep-space__stardust"></div>
            <div class="admin-deep-space__amber"></div>
            <div class="admin-deep-space__grid"></div>
          </div>
          {/* Habitación del Tiempo — infinite light void (no palace / no grid texture) */}
          <div
            class="fixed inset-0 z-[-1] bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white via-slate-50 to-slate-200 transition-opacity duration-1000 opacity-100 dark:opacity-0 block dark:hidden pointer-events-none"
            aria-hidden="true"
          ></div>
          {/* Aquarium drift — z-[-1] behind UI; total pointer-events isolation (decorative only) */}
          <div
            class="fixed inset-0 z-[-1] pointer-events-none select-none overflow-hidden"
            id="gastronomic-drift-layer"
            aria-hidden="true"
          >
            {/* ── Dark (glow) ── */}
            <img
              data-drift-theme="dark"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787666/Fondo_de_Designer_5_eliminado_gxjvld.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 hidden w-16 object-contain filter drop-shadow-[0_0_15px_rgba(234,179,8,0.4)] dark:block md:w-20"
              loading="lazy"
              decoding="async"
            />
            <img
              data-drift-theme="dark"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787665/Fondo_de_Designer_4_eliminado_pmzl6n.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 hidden w-[4.5rem] object-contain filter drop-shadow-[0_0_15px_rgba(168,85,247,0.4)] dark:block md:w-24"
              loading="lazy"
              decoding="async"
            />
            <img
              data-drift-theme="dark"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787663/Fondo_de_Designer_eliminado_ccibl1.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 hidden w-16 object-contain filter drop-shadow-[0_0_15px_rgba(99,102,241,0.4)] dark:block md:w-20"
              loading="lazy"
              decoding="async"
            />
            <img
              data-drift-theme="dark"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787663/Fondo_de_Designer_6_eliminado_irayeg.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 hidden w-20 object-contain filter drop-shadow-[0_0_15px_rgba(244,63,94,0.4)] dark:block md:w-28"
              loading="lazy"
              decoding="async"
            />

            {/* ── Light (sharp, no glow) ── */}
            <img
              data-drift-theme="light"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787662/Fondo_de_Designer_3_eliminado_hwnxto.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 block w-16 object-contain dark:hidden md:w-20"
              loading="lazy"
              decoding="async"
            />
            <img
              data-drift-theme="light"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787664/Fondo_de_Designer_2_eliminado_dxzg7q.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 block w-[4.5rem] object-contain dark:hidden md:w-24"
              loading="lazy"
              decoding="async"
            />
            <img
              data-drift-theme="light"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787667/Fondo_de_Designer_8_eliminado_dlv1h4.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 block w-16 object-contain dark:hidden md:w-20"
              loading="lazy"
              decoding="async"
            />
            <img
              data-drift-theme="light"
              src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784787668/Fondo_de_Copia_de_Designer_1_eliminado_gqjoms.png"
              alt=""
              class="floating-item pointer-events-none select-none absolute top-0 left-0 block w-[4.5rem] object-contain dark:hidden md:w-24"
              loading="lazy"
              decoding="async"
            />
          </div>
        </>
      ) : (
        <div class="atmosphere" aria-hidden="true">
          <div class="atmosphere__base"></div>
          <div class="atmosphere__texture"></div>
          <div class="atmosphere__glow"></div>
        </div>
      )
    }
    <div class="relative z-10 pointer-events-auto">
      <slot />
    </div>
    {
      adminPanel && (
        <script is:inline>
          (function () {
            // Edge-only decorative drift — no pointer events, no click boost.
            // Re-init on astro:page-load; cancel rAF on astro:before-preparation.
            var rafId = 0;
            var running = false;
            var state = [];
            var setupGen = 0;
            var BASE_SPEED = 0.06;

            function teardown() {
              running = false;
              if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = 0;
              }
              state = [];
            }

            function isHidden(el) {
              return window.getComputedStyle(el).display === 'none';
            }

            function applyTransform(obj) {
              obj.el.style.transform =
                'translate3d(' + obj.x + 'px, ' + obj.y + 'px, 0) rotate(' + obj.rotation + 'deg)';
            }

            function animate() {
              if (!running) return;

              var vw = window.innerWidth;
              var vh = window.innerHeight;
              var i;

              for (i = 0; i < state.length; i++) {
                var obj = state[i];
                if (isHidden(obj.el)) continue;

                if (obj.width === 0) {
                  var size = obj.el.getBoundingClientRect();
                  if (size.width >= 4) {
                    obj.width = size.width;
                    obj.height = size.height;
                  }
                }

                obj.x += obj.vx;
                obj.y += obj.vy;
                obj.rotation += obj.rotSpeed;

                if (obj.x <= 0) {
                  obj.vx = Math.abs(obj.vx);
                  obj.x = 0;
                } else if (obj.x + obj.width >= vw) {
                  obj.vx = -Math.abs(obj.vx);
                  obj.x = vw - obj.width;
                }

                if (obj.y <= 0) {
                  obj.vy = Math.abs(obj.vy);
                  obj.y = 0;
                } else if (obj.y + obj.height >= vh) {
                  obj.vy = -Math.abs(obj.vy);
                  obj.y = vh - obj.height;
                }

                applyTransform(obj);
              }

              rafId = requestAnimationFrame(animate);
            }

            function startLoop() {
              if (running) return;
              running = true;
              rafId = requestAnimationFrame(animate);
            }

            function setup() {
              teardown();
              var gen = ++setupGen;
              if (!document.documentElement.classList.contains('admin-panel')) return;

              var layer = document.getElementById('gastronomic-drift-layer');
              if (!layer) return;

              if (
                window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ) {
                layer.style.visibility = 'hidden';
                return;
              }
              layer.style.visibility = '';

              var items = Array.prototype.slice.call(
                layer.querySelectorAll('.floating-item'),
              );
              if (!items.length) return;

              var vw = window.innerWidth;
              var vh = window.innerHeight;

              state = items.map(function (item) {
                item.style.left = '0';
                item.style.top = '0';
                item.style.right = 'auto';
                item.style.bottom = 'auto';
                item.style.willChange = 'transform';
                item.style.animation = 'none';
                item.style.pointerEvents = 'none';

                var angle = Math.random() * Math.PI * 2;
                var vx = Math.cos(angle) * BASE_SPEED;
                var vy = Math.sin(angle) * BASE_SPEED;
                if (Math.abs(vx) < 0.02) vx = (vx < 0 ? -1 : 1) * 0.04;
                if (Math.abs(vy) < 0.02) vy = (vy < 0 ? -1 : 1) * 0.04;

                return {
                  el: item,
                  x: Math.random() * Math.max(vw - 100, 1),
                  y: Math.random() * Math.max(vh - 100, 1),
                  vx: vx,
                  vy: vy,
                  rotSpeed: (Math.random() > 0.5 ? 1 : -1) * (0.02 + Math.random() * 0.02),
                  width: 0,
                  height: 0,
                  rotation: Math.random() * 360,
                };
              });

              function afterLayout() {
                if (gen !== setupGen) return;
                for (var i = 0; i < state.length; i++) {
                  if (!isHidden(state[i].el)) {
                    var rect = state[i].el.getBoundingClientRect();
                    if (rect.width >= 4) {
                      state[i].width = rect.width;
                      state[i].height = rect.height;
                    }
                  }
                  applyTransform(state[i]);
                }
                startLoop();
              }

              function onImgReady() {
                pending--;
                if (pending <= 0) {
                  requestAnimationFrame(afterLayout);
                }
              }

              var pending = 0;
              for (var k = 0; k < items.length; k++) {
                var img = items[k];
                if (img.tagName === 'IMG' && !img.complete) {
                  pending++;
                  img.addEventListener('load', onImgReady, { once: true });
                  img.addEventListener('error', onImgReady, { once: true });
                }
              }
              if (pending === 0) {
                requestAnimationFrame(afterLayout);
              }
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', setup);
            } else {
              setup();
            }
            document.addEventListener('astro:page-load', setup);
            document.addEventListener('astro:before-preparation', teardown);
          })();
        </script>
      )
    }
  </body>
</html>
