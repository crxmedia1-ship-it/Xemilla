---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import { getAdminPostLoginPath } from '../../config/superadmin.js';

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

const suspendido =
  Boolean(user?.banned_until && new Date(user.banned_until).getTime() > Date.now()) ||
  Astro.url.searchParams.has('suspendido');

if (user && !suspendido) {
  return Astro.redirect(getAdminPostLoginPath(user));
}

---

<Layout
  title="Admin · Xemilla"
  theme="crx"
  themeColor="#16324f"
  description="Acceso al panel de administración Xemilla"
>
  <main class="login-stage relative flex min-h-dvh items-center justify-center overflow-hidden px-5 py-10 font-blacksushi text-zinc-950">
    <div class="login-studio" aria-hidden="true">
      <img
        class="login-studio__photo"
        src="/home/fondo.jpg"
        alt=""
        width="1024"
        height="1024"
        decoding="async"
        fetchpriority="high"
      />
      <div class="login-studio__veil"></div>
    </div>

    <section class="login-card z-10 flex w-full max-w-[24rem] flex-col">
      <header class="flex flex-col items-center text-center">
        <img
          src="/propuesta/xemilla-on-light.png"
          alt="Xemilla"
          width="766"
          height="249"
          class="login-wordmark login-in login-in--1"
          loading="eager"
          decoding="async"
        />
        <h1 class="login-in login-in--2 mt-8 text-center text-[1.65rem] font-normal leading-none tracking-[-0.03em] text-zinc-950">
          Bienvenido
        </h1>
        <p class="login-in login-in--3 mt-3 mb-8 max-w-[18rem] text-center text-sm font-normal leading-snug text-zinc-950/70">
          Accede a tu panel para gestionar tu restaurante.
        </p>
      </header>

      <form
        id="login-form"
        method="post"
        action="/admin/login"
        novalidate
        onsubmit="event.preventDefault()"
      >
        <div class="login-in login-in--4 mb-5">
          <label
            for="email"
            class="mb-2 block text-[10px] font-medium uppercase tracking-[0.22em] text-zinc-950/55"
          >
            Usuario
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="tu@restaurante.com"
            class="login-field w-full rounded-full px-4 py-3 text-zinc-950 placeholder:text-zinc-950/35 transition-colors focus:outline-none"
          />
        </div>

        <div class="login-in login-in--5 mb-2">
          <label
            for="password"
            class="mb-2 block text-[10px] font-medium uppercase tracking-[0.22em] text-zinc-950/55"
          >
            Contraseña
          </label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            placeholder="••••••••"
            class="login-field w-full rounded-full px-4 py-3 text-zinc-950 placeholder:text-zinc-950/35 transition-colors focus:outline-none"
          />
        </div>

        <p
          id="login-error"
          class:list={['mt-3 text-center text-xs leading-relaxed text-rose-700', !suspendido && 'hidden']}
          role="alert"
          aria-live="polite"
        >{suspendido ? 'Tu acceso está suspendido. Contacta a Xemilla.' : ''}</p>

        <button
          type="submit"
          id="login-submit"
          class="login-in login-in--6 mt-6 w-full rounded-full bg-[#141414] py-3.5 text-sm font-medium tracking-[-0.01em] text-[#f6f3ee] transition-transform hover:bg-black active:scale-[0.98] disabled:opacity-60 disabled:active:scale-100"
        >
          Entrar al panel
        </button>
      </form>
    </section>
  </main>
</Layout>

<style>
  .login-stage {
    background: #16324f;
  }

  .login-studio {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .login-studio__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: 46% 42%;
    filter: hue-rotate(198deg) saturate(1.28) brightness(0.88);
    animation: login-ken 32s ease-in-out infinite alternate;
  }

  .login-studio__veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 48% 36% at 50% 46%, rgba(232, 240, 255, 0.28), transparent 72%);
  }

  .login-card {
    border-radius: 1.85rem;
    padding: 2.35rem 1.6rem 1.7rem;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.42) 0%,
      rgba(255, 255, 255, 0.16) 46%,
      rgba(255, 255, 255, 0.24) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.62);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.86),
      inset 0 -1px 0 rgba(255, 255, 255, 0.22),
      0 22px 44px -26px rgba(40, 12, 0, 0.5);
    backdrop-filter: blur(6px) saturate(1.2);
    animation: login-reveal 1.05s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .login-wordmark {
    display: block;
    width: min(78%, 15.5rem);
    height: auto;
  }

  .login-in {
    animation: login-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .login-in--1 { animation-delay: 0.12s; }
  .login-in--2 { animation-delay: 0.22s; }
  .login-in--3 { animation-delay: 0.32s; }
  .login-in--4 { animation-delay: 0.42s; }
  .login-in--5 { animation-delay: 0.5s; }
  .login-in--6 { animation-delay: 0.58s; }

  .login-field {
    border: 1px solid rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.55);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .login-field:focus {
    border-color: rgba(20, 20, 20, 0.55);
    background: rgba(255, 255, 255, 0.78);
  }

  @keyframes login-ken {
    from { transform: scale(1.06) translate3d(1.4%, 0.6%, 0); }
    to { transform: scale(1.16) translate3d(-1.8%, -1.5%, 0); }
  }

  @keyframes login-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 28px, 0) scale(0.96);
    }
  }

  @keyframes login-in {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .login-studio__photo,
    .login-card,
    .login-in {
      animation: none;
    }
  }
</style>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase/browser.js';

  const supabase = createSupabaseBrowserClient();

  function bindLoginForm() {
    const form = document.getElementById('login-form');
    const submitBtn = document.getElementById('login-submit');
    const errorEl = document.getElementById('login-error');
    if (!(form instanceof HTMLFormElement) || !submitBtn || !errorEl) return;
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      errorEl.classList.add('hidden');
      errorEl.textContent = '';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Entrando…';

      const formData = new FormData(form);
      const email = String(formData.get('email') ?? '').trim();
      const password = String(formData.get('password') ?? '');

      const { error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorEl.textContent = /banned/i.test(error.message || '')
          ? 'Tu acceso está suspendido. Contacta a Xemilla.'
          : 'Email o contraseña incorrectos.';
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Entrar al panel';
        return;
      }

      // El servidor decide si entra al SuperAdmin o al panel del local.
      window.location.assign('/admin/login');
    });
  }

  bindLoginForm();
  document.addEventListener('astro:page-load', bindLoginForm);
</script>
