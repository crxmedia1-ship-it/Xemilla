---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import { getAdminPostLoginPath } from '../../config/superadmin.js';

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (user) {
  return Astro.redirect(getAdminPostLoginPath(user));
}
---

<Layout
  title="Admin · Xemilla"
  theme="crx"
  themeColor="#09090b"
  description="Acceso al panel de administración Xemilla"
>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-md flex-col bg-black px-6 pb-10 pt-16 text-white sm:px-8"
  >
    <header class="text-center">
      <img
        src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784310548/Photoroom_20260717_132348_xrnil8.png"
        alt="Xemilla"
        width="192"
        height="192"
        class="mx-auto h-auto w-40 object-contain brightness-0 invert opacity-90 sm:w-48 animate-[fadeUp_0.5s_ease_both]"
      />
      <p
        class="mx-auto mt-6 max-w-[16rem] text-sm font-light leading-relaxed text-zinc-400 animate-[fadeUp_0.6s_ease_0.1s_both]"
      >
        Entrá al panel de tu restaurante.
      </p>
    </header>

    <form
      id="login-form"
      class="mt-12 space-y-5 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-5 shadow-2xl backdrop-blur-md sm:p-6 animate-[fadeUp_0.65s_ease_0.14s_both]"
      novalidate
    >
      <div class="space-y-1.5">
        <label
          for="email"
          class="block text-xs font-semibold uppercase tracking-widest text-zinc-500"
        >
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="tu@restaurante.com"
          class="w-full rounded-xl border border-zinc-800 bg-zinc-900/50 px-4 py-3 text-sm text-white placeholder-zinc-500 focus:border-zinc-600 focus:outline-none focus:ring-1 focus:ring-zinc-600"
        />
      </div>

      <div class="space-y-1.5">
        <label
          for="password"
          class="block text-xs font-semibold uppercase tracking-widest text-zinc-500"
        >
          Contraseña
        </label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          placeholder="••••••••"
          class="w-full rounded-xl border border-zinc-800 bg-zinc-900/50 px-4 py-3 text-sm text-white placeholder-zinc-500 focus:border-zinc-600 focus:outline-none focus:ring-1 focus:ring-zinc-600"
        />
      </div>

      <p
        id="login-error"
        class="hidden text-center text-xs leading-relaxed text-rose-400"
        role="alert"
        aria-live="polite"
      ></p>

      <button
        type="submit"
        id="login-submit"
        class="mt-2 flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.68rem] font-bold uppercase tracking-[0.2em] text-black transition-all duration-200 hover:scale-[1.02] hover:bg-zinc-200 disabled:opacity-60 disabled:hover:scale-100"
      >
        Entrar al Panel
      </button>
    </form>
  </main>
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase/browser.js';
  import { getAdminPostLoginPath } from '../../config/superadmin.js';

  const form = document.getElementById('login-form');
  const submitBtn = document.getElementById('login-submit');
  const errorEl = document.getElementById('login-error');
  const supabase = createSupabaseBrowserClient();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn || !errorEl) return;

    errorEl.classList.add('hidden');
    errorEl.textContent = '';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Entrando…';

    const formData = new FormData(form);
    const email = String(formData.get('email') ?? '').trim();
    const password = String(formData.get('password') ?? '');

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorEl.textContent = error.message || 'No pudimos iniciar sesión.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Entrar al Panel';
      return;
    }

    window.location.href = getAdminPostLoginPath(data.user);
  });
</script>
