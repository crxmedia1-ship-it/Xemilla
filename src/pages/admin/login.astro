---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import { getAdminPostLoginPath } from '../../config/superadmin.js';

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (user) {
  return Astro.redirect(getAdminPostLoginPath(user));
}
---

<Layout
  title="Admin · CRX Xemilla"
  theme="crx"
  themeColor="#09090b"
  description="Acceso al panel de administración Xemilla"
>
  <main class="mx-auto flex min-h-dvh max-w-md flex-col px-6 pb-10 pt-16 text-white">
    <header class="text-center">
      <p
        class="text-[0.62rem] font-semibold uppercase tracking-[0.35em] text-zinc-500 animate-[fadeUp_0.5s_ease_both]"
      >
        Xemilla
      </p>
      <h1
        class="mt-3 font-blacksushi-display text-4xl font-semibold tracking-tight animate-[fadeUp_0.55s_ease_0.05s_both]"
      >
        CRX
      </h1>
      <p
        class="mx-auto mt-3 max-w-[16rem] text-sm leading-relaxed text-zinc-400 animate-[fadeUp_0.6s_ease_0.1s_both]"
      >
        Entrá al panel de tu restaurante.
      </p>
    </header>

    <form
      id="login-form"
      class="glass-panel mt-12 space-y-4 p-5 animate-[fadeUp_0.65s_ease_0.14s_both]"
      novalidate
    >
      <div class="space-y-1.5">
        <label for="email" class="block text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-zinc-500">
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="tu@restaurante.com"
          class="glass-field font-blacksushi text-sm text-white placeholder:text-zinc-600"
        />
      </div>

      <div class="space-y-1.5">
        <label
          for="password"
          class="block text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-zinc-500"
        >
          Contraseña
        </label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          placeholder="••••••••"
          class="glass-field font-blacksushi text-sm text-white placeholder:text-zinc-600"
        />
      </div>

      <p
        id="login-error"
        class="hidden text-center text-xs leading-relaxed text-rose-400"
        role="alert"
        aria-live="polite"
      ></p>

      <button type="submit" id="login-submit" class="glass-btn mt-2 !bg-white !text-zinc-950">
        Entrar al Panel
      </button>
    </form>

    <footer class="mt-auto pt-10 text-center text-[10px] uppercase tracking-[0.28em] text-zinc-600">
      Powered by CRX
    </footer>
  </main>
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase/browser.js';
  import { getAdminPostLoginPath } from '../../config/superadmin.js';

  const form = document.getElementById('login-form');
  const submitBtn = document.getElementById('login-submit');
  const errorEl = document.getElementById('login-error');
  const supabase = createSupabaseBrowserClient();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn || !errorEl) return;

    errorEl.classList.add('hidden');
    errorEl.textContent = '';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Entrando…';

    const formData = new FormData(form);
    const email = String(formData.get('email') ?? '').trim();
    const password = String(formData.get('password') ?? '');

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorEl.textContent = error.message || 'No pudimos iniciar sesión.';
      errorEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Entrar al Panel';
      return;
    }

    window.location.href = getAdminPostLoginPath(data.user);
  });
</script>
