---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import { createSupabaseServiceClient } from '../../lib/supabase/service.js';
import {
  isSuperAdminUser,
  getAssignedRestauranteId,
} from '../../config/superadmin.js';

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});
const { data: { user } } = await supabase.auth.getUser();

if (!user) return Astro.redirect('/admin/login');

const isSuper = isSuperAdminUser(user);
const restauranteId = isSuper
  ? (Astro.url.searchParams.get('restaurante') || Astro.url.searchParams.get('id') || '')
  : (getAssignedRestauranteId(user) || '');

if (!restauranteId) return Astro.redirect(isSuper ? '/admin/super/dashboard' : '/admin/login');

const service = createSupabaseServiceClient() ?? supabase;

const { data: restaurante } = await service
  .from('restaurantes')
  .select('id, nombre_comercial, slug, logo_url, color_primario')
  .eq('id', restauranteId)
  .maybeSingle();

if (!restaurante) return Astro.redirect('/admin/super/dashboard');

const nombre = String(restaurante.nombre_comercial || 'Restaurante').trim();
const slug = String(restaurante.slug || '').trim();

// Load recent pedidos (last 2 hours)
const twoHoursAgo = new Date(Date.now() - 2 * 60 * 60 * 1000).toISOString();
const { data: pedidosRecientes } = await service
  .from('pedidos_live')
  .select('*, sesiones_mesa(estado)')
  .eq('restaurante_id', restauranteId)
  .gte('created_at', twoHoursAgo)
  .in('estado', ['pendiente', 'preparando'])
  .order('created_at', { ascending: true });

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const pedidosJson = JSON.stringify(pedidosRecientes || []);
---

<Layout
  title={`Comanda · ${nombre}`}
  theme="crx"
  themeColor="#030712"
  adminPanel
>
  <div
    id="comanda-root"
    data-restaurante-id={restauranteId}
    data-slug={slug}
    class="relative min-h-dvh bg-zinc-950 text-white"
  >
    <!-- Dark grid atmosphere -->
    <div class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-950/20 via-zinc-950 to-zinc-950"></div>
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px); background-size: 32px 32px;"></div>
    </div>

    <!-- Header -->
    <header class="relative z-10 flex items-center justify-between border-b border-white/10 bg-zinc-950/90 px-4 py-3 backdrop-blur-xl sm:px-6">
      <div class="flex items-center gap-3">
        <span class="flex size-8 items-center justify-center rounded-xl bg-amber-500/20 text-base">📋</span>
        <div>
          <h1 class="text-sm font-bold tracking-tight text-white">{nombre} · Comanda</h1>
          <div class="flex items-center gap-1.5">
            <span class="size-1.5 animate-pulse rounded-full bg-emerald-400" id="realtime-dot"></span>
            <p class="text-[0.6rem] uppercase tracking-[0.16em] text-zinc-500" id="realtime-label">Conectando…</p>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="pending-badge" class="hidden rounded-full bg-amber-500/20 px-2.5 py-0.5 text-[11px] font-bold text-amber-300"></span>
        <a
          href={`/admin/live?restaurante=${restauranteId}`}
          class="rounded-lg border border-violet-500/30 bg-violet-500/10 px-3 py-1.5 text-[11px] font-semibold text-violet-300 transition hover:bg-violet-500/20"
        >
          🟢 Mesas
        </a>
        <a
          href={`/admin/dashboard?restaurante=${restauranteId}`}
          class="rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-[11px] font-medium text-zinc-400 transition hover:text-white"
        >
          ← Admin
        </a>
      </div>
    </header>

    <!-- Stats bar -->
    <div class="relative z-10 grid grid-cols-3 gap-2 border-b border-white/8 bg-zinc-950/60 px-4 py-3 sm:px-6">
      {[
        { id: 'stat-pendiente', label: 'Pendientes', color: 'text-amber-300' },
        { id: 'stat-preparando', label: 'Preparando', color: 'text-blue-300' },
        { id: 'stat-listo', label: 'Listos Hoy', color: 'text-emerald-300' },
      ].map(s => (
        <div class="text-center">
          <p class={`text-xl font-black tabular-nums ${s.color}`} id={s.id}>0</p>
          <p class="text-[0.55rem] uppercase tracking-widest text-zinc-600">{s.label}</p>
        </div>
      ))}
    </div>

    <!-- Comanda board -->
    <main class="relative z-10 p-4 sm:p-6">
      <div
        id="comanda-board"
        class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
      >
        <!-- Cards injected by JS -->
        <div id="empty-state" class="col-span-full flex flex-col items-center justify-center py-24 text-center">
          <div class="text-4xl mb-4 opacity-40">📭</div>
          <p class="text-sm font-semibold text-zinc-500">Sin pedidos pendientes</p>
          <p class="text-[0.65rem] text-zinc-700 mt-1">Los pedidos aparecerán aquí en tiempo real</p>
        </div>
      </div>
    </main>

    <!-- Alert overlay (new order flash) -->
    <div id="alert-flash" class="pointer-events-none fixed inset-x-0 top-0 z-[100] hidden">
      <div class="mx-auto max-w-sm px-4 pt-4">
        <div class="rounded-2xl border border-amber-500/40 bg-amber-500/20 px-5 py-4 shadow-xl backdrop-blur-xl text-center animate-bounce">
          <p class="text-lg font-black text-amber-200" id="alert-flash-msg"></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ restauranteId, supabaseUrl, supabaseAnonKey, pedidosJson }}>
import { createBrowserClient } from '@supabase/ssr';

const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);

const board = document.getElementById('comanda-board');
const emptyState = document.getElementById('empty-state');
const realtimeDot = document.getElementById('realtime-dot');
const realtimeLabel = document.getElementById('realtime-label');
const pendingBadge = document.getElementById('pending-badge');

let pedidoCards = {}; // id → DOM element
let audioCtx = null;
let statsPendiente = 0;
let statsPreparando = 0;
let statsListo = 0;

// ── Audio beep ────────────────────────────────────────
function playBeep(freq = 880, duration = 0.15, times = 2) {
  try {
    audioCtx = audioCtx || new AudioContext();
    const play = (t, f, d) => {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.type = 'sine'; osc.frequency.value = f;
      gain.gain.setValueAtTime(0.4, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + d);
      osc.start(t); osc.stop(t + d);
    };
    const now = audioCtx.currentTime;
    for (let i = 0; i < times; i++) play(now + i * (duration + 0.05), freq, duration);
  } catch { /* ignore */ }
}

// ── Alert flash ───────────────────────────────────────
function showAlertFlash(msg) {
  const el = document.getElementById('alert-flash');
  const msgEl = document.getElementById('alert-flash-msg');
  if (!el || !msgEl) return;
  msgEl.textContent = msg;
  el.classList.remove('hidden');
  setTimeout(() => el.classList.add('hidden'), 3000);
}

// ── Update stats UI ────────────────────────────────────
function updateStats() {
  const p = document.getElementById('stat-pendiente');
  const prep = document.getElementById('stat-preparando');
  const l = document.getElementById('stat-listo');
  if (p) p.textContent = String(statsPendiente);
  if (prep) prep.textContent = String(statsPreparando);
  if (l) l.textContent = String(statsListo);
  if (pendingBadge) {
    const total = statsPendiente + statsPreparando;
    pendingBadge.textContent = String(total);
    pendingBadge.classList.toggle('hidden', total === 0);
  }
}

// ── Render pedido card ────────────────────────────────
function getEstadoStyle(estado) {
  return {
    pendiente: { border: 'border-amber-500/40', bg: 'bg-amber-500/10', badge: 'bg-amber-500/20 text-amber-300', dot: 'bg-amber-400' },
    preparando: { border: 'border-blue-500/40', bg: 'bg-blue-500/10', badge: 'bg-blue-500/20 text-blue-300', dot: 'bg-blue-400' },
    listo: { border: 'border-emerald-500/40', bg: 'bg-emerald-500/10', badge: 'bg-emerald-500/20 text-emerald-300', dot: 'bg-emerald-400' },
    cancelado: { border: 'border-zinc-700', bg: 'bg-zinc-900/40', badge: 'bg-zinc-700 text-zinc-400', dot: 'bg-zinc-600' },
  }[estado] || { border: 'border-white/10', bg: 'bg-white/[0.03]', badge: 'bg-zinc-800 text-zinc-400', dot: 'bg-zinc-500' };
}

function formatTime(iso) {
  try { return new Date(iso).toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit' }); } catch { return ''; }
}

function typeIcon(tipo) {
  return tipo === 'mesero' ? '🔔' : tipo === 'cuenta' ? '💰' : '🍽';
}

function renderCard(pedido) {
  const style = getEstadoStyle(pedido.estado);
  const card = document.createElement('article');
  card.id = `pedido-${pedido.id}`;
  card.className = `relative flex flex-col overflow-hidden rounded-2xl border ${style.border} ${style.bg} p-4 space-y-3 transition-all duration-300 backdrop-blur-sm`;
  card.dataset.estado = pedido.estado;

  card.innerHTML = `
    <div class="flex items-start justify-between gap-2">
      <div>
        <div class="flex items-center gap-1.5">
          <span class="size-2 rounded-full ${style.dot} animate-pulse"></span>
          <span class="text-[0.6rem] font-bold uppercase tracking-[0.16em] text-zinc-500">Mesa ${pedido.mesa_numero}</span>
        </div>
        <p class="mt-0.5 text-xs font-semibold text-zinc-300">👤 ${escHtml(pedido.comensal_nombre)}</p>
      </div>
      <div class="flex flex-col items-end gap-1">
        <span class="rounded-full px-2 py-0.5 text-[0.55rem] font-bold uppercase tracking-wider ${style.badge}">${pedido.estado}</span>
        <span class="text-[0.55rem] text-zinc-700">${formatTime(pedido.created_at)}</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xl">${typeIcon(pedido.tipo)}</span>
      <div>
        <p class="text-sm font-bold text-white">${pedido.cantidad}× ${escHtml(pedido.plato_nombre)}</p>
        ${pedido.plato_precio ? `<p class="text-[0.65rem] text-zinc-500">$${(pedido.plato_precio * pedido.cantidad).toFixed(2)}</p>` : ''}
      </div>
    </div>
    <div class="grid grid-cols-2 gap-1.5">
      ${pedido.estado === 'pendiente'
        ? `<button type="button" data-action="preparando" data-id="${pedido.id}" class="action-btn rounded-xl border border-blue-500/30 bg-blue-500/10 py-1.5 text-[0.65rem] font-semibold text-blue-300 transition hover:bg-blue-500/20">🍳 Preparando</button>
           <button type="button" data-action="cancelado" data-id="${pedido.id}" class="action-btn rounded-xl border border-zinc-700 bg-zinc-900 py-1.5 text-[0.65rem] font-semibold text-zinc-500 transition hover:text-zinc-300">✕ Cancelar</button>`
        : pedido.estado === 'preparando'
          ? `<button type="button" data-action="listo" data-id="${pedido.id}" class="action-btn col-span-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 py-1.5 text-[0.65rem] font-bold text-emerald-300 transition hover:bg-emerald-500/20">✅ Marcar Listo</button>`
          : `<span class="col-span-2 text-center text-[0.6rem] text-zinc-700 py-1">${pedido.estado === 'listo' ? '✅ Entregado' : '✕ Cancelado'}</span>`
      }
    </div>
  `;

  card.querySelectorAll('.action-btn').forEach((btn) => {
    btn.addEventListener('click', () => handleUpdate(btn.dataset.id, btn.dataset.action));
  });

  return card;
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function addOrUpdateCard(pedido) {
  const existing = document.getElementById(`pedido-${pedido.id}`);
  const card = renderCard(pedido);

  if (existing) {
    existing.replaceWith(card);
  } else {
    emptyState?.classList.add('hidden');
    board?.prepend(card);
  }
  pedidoCards[pedido.id] = card;

  // Remove from board if done
  if (['listo', 'cancelado'].includes(pedido.estado)) {
    setTimeout(() => {
      document.getElementById(`pedido-${pedido.id}`)?.remove();
      delete pedidoCards[pedido.id];
      if (board && board.querySelectorAll('article').length === 0) {
        emptyState?.classList.remove('hidden');
      }
    }, 5000);
  }
}

function recalcStats() {
  const cards = board?.querySelectorAll('article[data-estado]') || [];
  statsPendiente = 0; statsPreparando = 0;
  cards.forEach((c) => {
    if (c.dataset.estado === 'pendiente') statsPendiente++;
    else if (c.dataset.estado === 'preparando') statsPreparando++;
  });
  updateStats();
}

// ── Update pedido action ─────────────────────────────
async function handleUpdate(pedidoId, estado) {
  try {
    const res = await fetch('/api/live/update-pedido', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ restaurante_id: restauranteId, pedido_id: pedidoId, estado }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);
    // Card will update via Realtime
  } catch (err) {
    console.error('[comanda] update-pedido:', err.message);
  }
}

// ── Load initial pedidos ──────────────────────────────
const initialPedidos = JSON.parse(pedidosJson || '[]');
initialPedidos.forEach((p) => {
  // Only show active session pedidos
  if (p.sesiones_mesa?.estado === 'activa') {
    addOrUpdateCard(p);
    if (p.estado === 'pendiente') statsPendiente++;
    else if (p.estado === 'preparando') statsPreparando++;
  }
});
updateStats();

// ── Supabase Realtime ────────────────────────────────
const channel = supabase
  .channel(`live-comanda-${restauranteId}`)
  .on('postgres_changes', {
    event: 'INSERT',
    schema: 'public',
    table: 'pedidos_live',
    filter: `restaurante_id=eq.${restauranteId}`,
  }, (payload) => {
    const pedido = payload.new;
    if (!pedido) return;
    addOrUpdateCard(pedido);
    recalcStats();

    if (pedido.tipo === 'mesero') {
      playBeep(440, 0.2, 3);
      showAlertFlash(`🔔 Mesa ${pedido.mesa_numero} llama al mesero`);
    } else if (pedido.tipo === 'cuenta') {
      playBeep(660, 0.15, 2);
      showAlertFlash(`💰 Mesa ${pedido.mesa_numero} pide la cuenta`);
    } else {
      playBeep(880, 0.12, 2);
      showAlertFlash(`🍽 Mesa ${pedido.mesa_numero} · ${pedido.cantidad}× ${pedido.plato_nombre}`);
    }
  })
  .on('postgres_changes', {
    event: 'UPDATE',
    schema: 'public',
    table: 'pedidos_live',
    filter: `restaurante_id=eq.${restauranteId}`,
  }, (payload) => {
    const pedido = payload.new;
    if (!pedido) return;
    addOrUpdateCard(pedido);
    recalcStats();
    if (pedido.estado === 'listo') {
      playBeep(1100, 0.1, 1);
      statsListo++;
      updateStats();
    }
  })
  .subscribe((status) => {
    if (realtimeDot && realtimeLabel) {
      const ok = status === 'SUBSCRIBED';
      realtimeDot.className = `size-1.5 rounded-full ${ok ? 'bg-emerald-400 animate-pulse' : 'bg-red-400'}`;
      realtimeLabel.textContent = ok ? 'En vivo' : status === 'CHANNEL_ERROR' ? 'Error de conexión' : 'Conectando…';
    }
  });

// Unlock audio on first interaction
document.addEventListener('click', () => {
  audioCtx = audioCtx || new AudioContext();
  if (audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
}, { once: true });

window.addEventListener('pagehide', () => { supabase.removeChannel(channel); });
</script>

<style>
  @keyframes slide-in-from-top {
    from { transform: translateY(-100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  #alert-flash > div { animation: slide-in-from-top 0.3s ease; }
</style>
