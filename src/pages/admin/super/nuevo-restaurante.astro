---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminThemeSwitcher from '../../../components/admin/AdminThemeSwitcher.astro';
import {
  requireSuperAdmin,
  createRestauranteAsSuperAdmin,
} from '../../../lib/superadmin.js';
import { cloudinaryTrimUrl } from '../../../lib/plato-media-url.js';

const gate = await requireSuperAdmin({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (!gate) {
  return Astro.redirect('/admin/login');
}

let errorMsg = '';

/** Prefill after validation error */
const prefill = {
  nombre: '',
  slug: '',
  whatsapp: '',
  direccion: '',
  logoUrl: '',
  hubCoverUrl: '',
  hubLogoBg: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  prefill.nombre = String(form.get('nombre_comercial') ?? '');
  prefill.slug = String(form.get('slug') ?? '');
  prefill.whatsapp = String(form.get('whatsapp_num') ?? '');
  prefill.direccion = String(form.get('direccion') ?? '');
  prefill.logoUrl = String(form.get('logo_url') ?? '');
  prefill.hubCoverUrl = String(form.get('hub_cover_url') ?? '');
  prefill.hubLogoBg = String(form.get('hub_logo_bg') ?? '');

  const result = await createRestauranteAsSuperAdmin(gate.supabase, gate.user, {
    userId: gate.user.id,
    nombreComercial: prefill.nombre,
    slug: prefill.slug,
    whatsapp: prefill.whatsapp,
    direccion: prefill.direccion,
    logoUrl: prefill.logoUrl,
    hubCoverUrl: prefill.hubCoverUrl,
    hubLogoBg: prefill.hubLogoBg,
  });

  if (result.error) {
    errorMsg = result.error;
  } else if (result.restaurante) {
    return Astro.redirect('/admin/super/dashboard');
  }
}

const xemillaWordmark =
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337620/Photoroom_20260810_004814_islrgw.png';

const logoTrim = prefill.logoUrl ? cloudinaryTrimUrl(prefill.logoUrl) : '';
const plateBg = /^#[0-9A-Fa-f]{6}$/.test(prefill.hubLogoBg)
  ? prefill.hubLogoBg
  : '#111111';

const inputClass =
  'w-full bg-zinc-900/60 border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-zinc-600 focus:border-zinc-500 outline-none transition-colors';
const labelClass = 'text-[11px] font-bold uppercase tracking-wider text-zinc-400';
const dropzoneClass =
  'h-28 w-full rounded-xl border border-dashed border-zinc-800 bg-zinc-900/30 flex flex-col items-center justify-center hover:border-zinc-600 transition-colors cursor-pointer overflow-hidden';
---

<Layout
  title="Nuevo restaurante · Xemilla"
  theme="crx"
  themeColor="#050505"
  description="Registrar un nuevo local en Xemilla"
  adminPanel={true}
>
  <main class="nuevo-rest w-full min-h-dvh px-4 sm:px-8 lg:px-12 py-6 pb-20">
    <header class="mb-8 flex items-center justify-between gap-4">
      <a href="/admin/super/dashboard" class="nuevo-rest__brand" aria-label="Volver al SuperAdmin">
        <img
          src={xemillaWordmark}
          alt="xemilla"
          width="140"
          height="40"
          class="nuevo-rest__brand-img h-5 w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
      <div class="flex items-center gap-3">
        <AdminThemeSwitcher />
        <a
          href="/admin/super/dashboard"
          class="text-xs font-medium text-zinc-400 transition-colors hover:text-white"
        >
          ← SuperAdmin
        </a>
      </div>
    </header>

    <div class="w-full max-w-5xl mx-auto p-8 rounded-3xl bg-zinc-950/80 border border-zinc-800/80 backdrop-blur-2xl shadow-2xl">
      <form method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" id="nuevo-rest-form" novalidate>
        <!-- Columna izquierda: formulario -->
        <section class="lg:col-span-7 flex flex-col gap-4">
          <header>
            <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Alta en la red</p>
            <h1 class="mt-1 text-2xl font-light text-white">Nuevo Restaurante</h1>
            <p class="mt-1.5 text-xs text-zinc-400">
              Completá la ficha del Hub. El fondo y la identidad pública se configuran después en Studio.
            </p>
          </header>

          <!-- Fila 1: Nombre -->
          <div class="flex flex-col gap-1.5">
            <label for="nombre_comercial" class={labelClass}>Nombre comercial</label>
            <input
              id="nombre_comercial"
              name="nombre_comercial"
              type="text"
              required
              autocomplete="organization"
              placeholder="Ej. La Trattoria del Sol"
              value={prefill.nombre}
              class={inputClass}
              data-nombre-input
            />
          </div>

          <!-- Fila 2: Slug -->
          <div class="flex flex-col gap-1.5">
            <label for="slug" class={labelClass}>Slug público</label>
            <div class="flex items-center gap-0 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/60 focus-within:border-zinc-500 transition-colors">
              <span class="shrink-0 pl-4 text-xs font-mono text-zinc-500" aria-hidden="true">
                xemilla.com/
              </span>
              <input
                id="slug"
                name="slug"
                type="text"
                required
                pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                placeholder="la-trattoria-del-sol"
                value={prefill.slug}
                aria-describedby="slug-hint"
                class="min-w-0 flex-1 bg-transparent px-1.5 py-2.5 text-sm font-mono text-white placeholder:text-zinc-600 outline-none"
                data-slug-input
              />
            </div>
            <p id="slug-hint" class="text-[11px] text-zinc-500">
              Solo minúsculas, números y guiones · /<span data-slug-live>{prefill.slug || 'slug'}</span>
            </p>
          </div>

          <!-- Fila 3: WhatsApp + Dirección -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="whatsapp_num" class={labelClass}>WhatsApp</label>
              <input
                id="whatsapp_num"
                name="whatsapp_num"
                type="tel"
                required
                inputmode="tel"
                autocomplete="tel"
                placeholder="584141234567"
                value={prefill.whatsapp}
                class={inputClass}
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="direccion" class={labelClass}>
                Dirección <span class="font-medium normal-case tracking-normal text-zinc-600">opcional</span>
              </label>
              <input
                id="direccion"
                name="direccion"
                type="text"
                autocomplete="street-address"
                placeholder="Calle, ciudad"
                value={prefill.direccion}
                class={inputClass}
              />
            </div>
          </div>

          <!-- Fila 4: Dropzones -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <div class="flex flex-col gap-1.5">
              <p class={labelClass}>Logo</p>
              <button
                type="button"
                class={dropzoneClass}
                data-pick="logo"
                data-logo-preview
                aria-label="Elegir logo"
              >
                {
                  logoTrim ? (
                    <img
                      src={logoTrim}
                      alt=""
                      class="h-full w-full object-contain p-3"
                      data-drop-logo-img
                    />
                  ) : (
                    <span class="flex flex-col items-center gap-1 px-3 text-center">
                      <span class="text-[11px] font-medium text-zinc-400">Subir logo</span>
                      <span class="text-[10px] text-zinc-600">PNG sin fondo</span>
                    </span>
                  )
                }
              </button>
              <input type="hidden" id="logo_url" name="logo_url" value={prefill.logoUrl} />
              <input id="logo_file" type="file" accept="image/*" class="sr-only" tabindex="-1" />
              <p id="logo-upload-status" class="min-h-[1rem] text-[11px] text-zinc-500" role="status"></p>
            </div>

            <div class="flex flex-col gap-1.5">
              <p class={labelClass}>Portada Hub</p>
              <button
                type="button"
                class={dropzoneClass}
                data-pick="cover"
                data-cover-preview
                aria-label="Elegir portada"
              >
                {
                  prefill.hubCoverUrl ? (
                    <img
                      src={prefill.hubCoverUrl}
                      alt=""
                      class="h-full w-full object-cover"
                      data-drop-cover-img
                    />
                  ) : (
                    <span class="flex flex-col items-center gap-1 px-3 text-center">
                      <span class="text-[11px] font-medium text-zinc-400">Subir portada</span>
                      <span class="text-[10px] text-zinc-600">Solo tarjeta Hub</span>
                    </span>
                  )
                }
              </button>
              <input type="hidden" id="hub_cover_url" name="hub_cover_url" value={prefill.hubCoverUrl} />
              <input type="hidden" id="hub_logo_bg" name="hub_logo_bg" value={prefill.hubLogoBg} />
              <input id="hub_cover_file" type="file" accept="image/*" class="sr-only" tabindex="-1" />
              <p id="cover-upload-status" class="min-h-[1rem] text-[11px] text-zinc-500" role="status"></p>
            </div>
          </div>

          {
            errorMsg && (
              <p
                class="rounded-xl border border-rose-500/25 bg-rose-500/10 px-4 py-3 text-xs leading-relaxed text-rose-400"
                role="alert"
              >
                {errorMsg}
              </p>
            )
          }

          <!-- Acciones -->
          <div class="mt-2 flex flex-wrap items-center justify-end gap-2">
            <a
              href="/admin/super/dashboard"
              class="text-xs text-zinc-400 hover:text-white px-4 py-2 transition-colors"
            >
              Cancelar
            </a>
            <button
              type="submit"
              id="create-submit"
              class="px-5 py-2.5 bg-white text-zinc-950 font-medium text-xs rounded-xl hover:bg-zinc-200 transition-colors disabled:cursor-wait disabled:opacity-60"
            >
              Crear Restaurante
            </button>
          </div>
        </section>

        <!-- Columna derecha: Live Preview -->
        <aside class="lg:col-span-5 flex flex-col items-center justify-start sticky top-6" aria-label="Vista previa de la tarjeta">
          <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500 mb-3 w-full text-left">
            Así se ve en el Hub
          </p>

          <article
            class="aspect-[16/10] w-full rounded-2xl border border-zinc-800 overflow-hidden relative bg-zinc-900/60 shadow-lg"
            data-live-card
          >
            <!-- Cover -->
            <div class="absolute inset-0 z-0 bg-zinc-950" data-live-cover>
              {
                prefill.hubCoverUrl ? (
                  <img
                    src={prefill.hubCoverUrl}
                    alt=""
                    class="object-cover w-full h-full"
                    data-live-cover-img
                  />
                ) : (
                  <div
                    class="flex h-full w-full items-center justify-center bg-gradient-to-br from-zinc-900 to-zinc-950"
                    data-live-cover-empty
                  >
                    <span class="text-[10px] font-medium uppercase tracking-wider text-zinc-600">
                      Sin portada
                    </span>
                  </div>
                )
              }
            </div>

            <!-- Overlay degradado inferior -->
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[48%] bg-gradient-to-t from-black/70 via-black/25 to-transparent"
              aria-hidden="true"
            ></div>

            <!-- Badge Acceso Activo -->
            <div class="absolute left-3 top-3 z-20">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/25 bg-black/55 px-2.5 py-1 text-[0.62rem] font-medium tracking-wide text-emerald-300 backdrop-blur-md">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></span>
                Acceso Activo
              </span>
            </div>

            <!-- Logo plate flotante -->
            <div
              class="absolute bottom-10 left-1/2 z-20 flex h-11 w-[min(72%,11rem)] -translate-x-1/2 items-center justify-center rounded-md px-2"
              data-live-plate
              style={`background: ${plateBg};`}
            >
              <div class="flex h-full w-full items-center justify-center" data-live-logo>
                {
                  logoTrim ? (
                    <img
                      src={logoTrim}
                      alt=""
                      class="max-h-full max-w-full object-contain"
                      data-live-logo-img
                    />
                  ) : (
                    <span class="truncate px-1 text-center text-xs font-medium text-white/55" data-live-name-fallback>
                      {prefill.nombre || 'Logo'}
                    </span>
                  )
                }
              </div>
            </div>

            <!-- Pie: nombre -->
            <div class="absolute inset-x-0 bottom-0 z-20 px-3.5 pb-2.5 pt-8">
              <p class="truncate text-sm font-medium text-white drop-shadow" data-live-name>
                {prefill.nombre || 'Nombre del local'}
              </p>
              <p class="truncate font-mono text-[10px] text-zinc-400" data-live-slug>
                /{prefill.slug || 'slug'}
              </p>
            </div>
          </article>
        </aside>
      </form>
    </div>
  </main>
</Layout>

<style is:global>
  .nuevo-rest__brand-img {
    filter: brightness(0);
  }

  html.admin-panel.dark .nuevo-rest__brand-img,
  html.admin-panel[data-theme='dark'] .nuevo-rest__brand-img,
  html.admin-panel[data-theme='onyx'] .nuevo-rest__brand-img {
    filter: brightness(0) invert(1);
  }

  html.admin-panel.light .nuevo-rest__brand-img,
  html.admin-panel[data-theme='light'] .nuevo-rest__brand-img {
    filter: brightness(0);
  }
</style>

<script>
  const form = document.getElementById('nuevo-rest-form');
  const slugInput = document.getElementById('slug');
  const nombreInput = document.getElementById('nombre_comercial');
  const submitBtn = document.getElementById('create-submit');

  /**
   * @param {string | null | undefined} value
   */
  function toSlug(value) {
    return String(value ?? '')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  /**
   * @param {string} url
   */
  function cloudinaryTrim(url) {
    const raw = String(url || '').trim();
    if (!raw) return '';
    const marker = '/upload/';
    const at = raw.indexOf(marker);
    if (at === -1 || !/cloudinary\.com/i.test(raw)) return raw;
    const after = raw.slice(at + marker.length);
    if (/e_trim/.test(after)) return raw;
    return `${raw.slice(0, at + marker.length)}e_trim/${after}`;
  }

  /**
   * @param {string} sel
   * @param {string} value
   */
  function setText(sel, value) {
    document.querySelectorAll(sel).forEach((el) => {
      el.textContent = value;
    });
  }

  function refreshLive() {
    const nombre =
      nombreInput instanceof HTMLInputElement ? nombreInput.value.trim() : '';
    const slug = slugInput instanceof HTMLInputElement ? slugInput.value.trim() : '';
    setText('[data-live-name]', nombre || 'Nombre del local');
    setText('[data-live-slug]', `/${slug || 'slug'}`);
    setText('[data-slug-live]', slug || 'slug');
    const fallback = document.querySelector('[data-live-name-fallback]');
    if (fallback instanceof HTMLElement && !document.querySelector('[data-live-logo-img]')) {
      fallback.textContent = nombre || 'Logo';
    }
  }

  let slugTouched = Boolean(
    slugInput instanceof HTMLInputElement && slugInput.value.trim(),
  );

  slugInput?.addEventListener('input', () => {
    slugTouched = true;
    if (slugInput instanceof HTMLInputElement) {
      const cleaned = toSlug(slugInput.value);
      if (cleaned !== slugInput.value) slugInput.value = cleaned;
    }
    refreshLive();
  });

  nombreInput?.addEventListener('input', () => {
    if (!slugTouched && slugInput instanceof HTMLInputElement) {
      slugInput.value = toSlug(
        nombreInput instanceof HTMLInputElement ? nombreInput.value : '',
      );
    }
    refreshLive();
  });

  /**
   * @param {File} file
   * @returns {Promise<string>}
   */
  async function uploadToCloudinary(file) {
    const body = new FormData();
    body.append('file', file);
    const res = await fetch('/api/upload', { method: 'POST', body });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.url) {
      throw new Error(json.error || 'No se pudo subir la imagen');
    }
    return String(json.url);
  }

  /**
   * @param {'logo' | 'cover'} mode
   * @param {string} url
   * @param {string} [plateBg]
   */
  function applyPreview(mode, url, plateBg) {
    if (mode === 'logo') {
      const trimmed = cloudinaryTrim(url);
      const slot = document.querySelector('[data-logo-preview]');
      const live = document.querySelector('[data-live-logo]');

      if (slot instanceof HTMLElement) {
        slot.innerHTML = '';
        const img = document.createElement('img');
        img.src = trimmed;
        img.alt = '';
        img.className = 'h-full w-full object-contain p-3';
        img.dataset.dropLogoImg = '';
        slot.appendChild(img);
      }

      if (live instanceof HTMLElement) {
        live.innerHTML = '';
        const img = document.createElement('img');
        img.src = trimmed;
        img.alt = '';
        img.className = 'max-h-full max-w-full object-contain';
        img.dataset.liveLogoImg = '';
        live.appendChild(img);
      }
      return;
    }

    const slot = document.querySelector('[data-cover-preview]');
    const liveCover = document.querySelector('[data-live-cover]');
    const plate = document.querySelector('[data-live-plate]');

    if (slot instanceof HTMLElement) {
      slot.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.className = 'h-full w-full object-cover';
      img.dataset.dropCoverImg = '';
      slot.appendChild(img);
    }

    if (liveCover instanceof HTMLElement) {
      liveCover.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.className = 'object-cover w-full h-full';
      img.dataset.liveCoverImg = '';
      liveCover.appendChild(img);
    }

    if (plate instanceof HTMLElement && plateBg) {
      plate.style.background = plateBg;
    }
  }

  /**
   * @param {'logo' | 'cover'} mode
   */
  function bindPicker(mode) {
    const fileInput = document.getElementById(mode === 'logo' ? 'logo_file' : 'hub_cover_file');
    const hidden = document.getElementById(mode === 'logo' ? 'logo_url' : 'hub_cover_url');
    const status = document.getElementById(
      mode === 'logo' ? 'logo-upload-status' : 'cover-upload-status',
    );
    const plateHidden = document.getElementById('hub_logo_bg');
    if (!(fileInput instanceof HTMLInputElement)) return;

    document.querySelectorAll(`[data-pick="${mode}"]`).forEach((el) => {
      el.addEventListener('click', () => fileInput.click());
    });

    /**
     * @param {File} file
     * @param {{ plateBg?: string } | undefined} [meta]
     */
    async function runUpload(file, meta) {
      if (status) {
        status.textContent = 'Subiendo…';
        status.className = 'min-h-[1rem] text-[11px] text-zinc-400';
      }
      try {
        const url = await uploadToCloudinary(file);
        if (hidden instanceof HTMLInputElement) hidden.value = url;

        let plateBg = '';
        if (mode === 'cover') {
          const sample = window.XemillaImageCrop?.samplePlateColorFromUrl;
          if (typeof sample === 'function') {
            try {
              plateBg = (await sample(url)) || '';
            } catch {
              plateBg = '';
            }
          }
          if (meta?.plateBg) plateBg = meta.plateBg;
          if (plateHidden instanceof HTMLInputElement && plateBg) {
            plateHidden.value = plateBg;
          }
        } else if (meta?.plateBg && plateHidden instanceof HTMLInputElement) {
          plateHidden.value = meta.plateBg;
          const plate = document.querySelector('[data-live-plate]');
          if (plate instanceof HTMLElement) plate.style.background = meta.plateBg;
        }

        applyPreview(mode, url, plateBg);
        if (status) {
          status.textContent = 'Listo';
          status.className = 'min-h-[1rem] text-[11px] text-emerald-400';
        }
        refreshLive();
      } catch (err) {
        if (status) {
          status.textContent = err instanceof Error ? err.message : 'Error al subir';
          status.className = 'min-h-[1rem] text-[11px] text-rose-400';
        }
      }
    }

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      fileInput.value = '';
      if (!file) return;

      const cropApi = window.XemillaImageCrop;
      if (cropApi && typeof cropApi.open === 'function') {
        const coverEl = document.getElementById('hub_cover_url');
        const coverUrl =
          coverEl instanceof HTMLInputElement ? coverEl.value.trim() : '';
        const bgEl = document.getElementById('hub_logo_bg');
        const existingBg =
          bgEl instanceof HTMLInputElement ? bgEl.value.trim() : '';
        cropApi.open({
          file,
          aspect: mode === 'cover' ? 'cover' : 'logo',
          title: mode === 'cover' ? 'Recortar portada' : 'Recortar logo',
          coverUrl: mode === 'logo' ? coverUrl : undefined,
          background:
            mode === 'logo' && /^#[0-9A-Fa-f]{6}$/.test(existingBg)
              ? existingBg
              : undefined,
          onConfirm: (cropped, meta) => runUpload(cropped, meta),
        });
        return;
      }

      void runUpload(file);
    });
  }

  bindPicker('logo');
  bindPicker('cover');
  refreshLive();

  form?.addEventListener('submit', () => {
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creando…';
    }
  });
</script>
