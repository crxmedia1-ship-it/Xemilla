</style>

<script>
  const form = document.getElementById('nuevo-rest-form');
  const slugInput = document.getElementById('slug');
  const nombreInput = document.getElementById('nombre_comercial');
  const submitBtn = document.getElementById('create-submit');

  function toSlug(value) {
    return String(value ?? '')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  function setText(sel, value) {
    document.querySelectorAll(sel).forEach((el) => {
      el.textContent = value;
    });
  }

  function refreshLive() {
    const nombre =
      nombreInput instanceof HTMLInputElement ? nombreInput.value.trim() : '';
    const slug = slugInput instanceof HTMLInputElement ? slugInput.value.trim() : '';
    setText('[data-live-name]', nombre || 'Nombre del local');
    setText('[data-live-slug]', `/${slug || 'slug'}`);
    setText('[data-slug-live]', slug || 'slug');
    const fallback = document.querySelector('[data-live-name-fallback]');
    if (fallback && !document.querySelector('[data-live-logo] img')) {
      fallback.textContent = nombre || 'Logo';
    }
  }

  let slugTouched = Boolean(
    slugInput instanceof HTMLInputElement && slugInput.value.trim(),
  );

  slugInput?.addEventListener('input', () => {
    slugTouched = true;
    if (slugInput instanceof HTMLInputElement) {
      const cleaned = toSlug(slugInput.value);
      if (cleaned !== slugInput.value) slugInput.value = cleaned;
    }
    refreshLive();
  });

  nombreInput?.addEventListener('input', () => {
    if (!slugTouched && slugInput instanceof HTMLInputElement) {
      slugInput.value = toSlug(
        nombreInput instanceof HTMLInputElement ? nombreInput.value : '',
      );
    }
    refreshLive();
  });

  /**
   * @param {File} file
   * @returns {Promise<string>}
   */
  async function uploadToCloudinary(file) {
    const body = new FormData();
    body.append('file', file);
    const res = await fetch('/api/upload', { method: 'POST', body });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.url) {
      throw new Error(json.error || 'No se pudo subir la imagen');
    }
    return String(json.url);
  }

  /**
   * @param {'logo' | 'cover'} mode
   * @param {string} url
   * @param {string} [plateBg]
   */
  function applyPreview(mode, url, plateBg) {
    if (mode === 'logo') {
      const slot = document.querySelector('[data-logo-preview]');
      const live = document.querySelector('[data-live-logo]');
      if (slot) {
        slot.innerHTML = '';
        const img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.className = 'nuevo-rest__logo-img';
        slot.appendChild(img);
      }
      if (live) {
        live.innerHTML = '';
        const img = document.createElement('img');
        img.src = url;
        img.alt = '';
        live.appendChild(img);
      }
      return;
    }

    const slot = document.querySelector('[data-cover-preview]');
    const liveCover = document.querySelector('[data-live-cover]');
    const plate = document.querySelector('[data-live-plate]');

    if (slot) {
      slot.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.className = 'nuevo-rest__cover-img';
      slot.appendChild(img);
    }

    if (liveCover) {
      const existingPlate = liveCover.querySelector('[data-live-plate]');
      const prevLogoHtml = liveCover.querySelector('[data-live-logo]')?.innerHTML || '';
      liveCover.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      liveCover.appendChild(img);

      const plateEl =
        existingPlate instanceof HTMLElement
          ? existingPlate
          : document.createElement('div');
      plateEl.className = 'nuevo-rest__card-plate';
      plateEl.dataset.livePlate = '';
      if (plateBg) plateEl.style.background = plateBg;

      let logoWrap = plateEl.querySelector('[data-live-logo]');
      if (!(logoWrap instanceof HTMLElement)) {
        logoWrap = document.createElement('div');
        logoWrap.className = 'nuevo-rest__card-logo';
        logoWrap.dataset.liveLogo = '';
        logoWrap.innerHTML =
          prevLogoHtml ||
          `<span data-live-name-fallback>${
            nombreInput instanceof HTMLInputElement && nombreInput.value.trim()
              ? nombreInput.value.trim()
              : 'Logo'
          }</span>`;
        plateEl.appendChild(logoWrap);
      }
      liveCover.appendChild(plateEl);
    } else if (plate instanceof HTMLElement && plateBg) {
      plate.style.background = plateBg;
    }
  }

  /**
   * @param {'logo' | 'cover'} mode
   */
  function bindPicker(mode) {
    const fileInput = document.getElementById(mode === 'logo' ? 'logo_file' : 'hub_cover_file');
    const hidden = document.getElementById(mode === 'logo' ? 'logo_url' : 'hub_cover_url');
    const status = document.getElementById(
      mode === 'logo' ? 'logo-upload-status' : 'cover-upload-status',
    );
    const plateHidden = document.getElementById('hub_logo_bg');
    if (!(fileInput instanceof HTMLInputElement)) return;

    document.querySelectorAll(`[data-pick="${mode}"]`).forEach((el) => {
      el.addEventListener('click', () => fileInput.click());
    });

    /**
     * @param {File} file
     */
    async function runUpload(file) {
      if (status) {
        status.textContent = 'Subiendo…';
        status.className = 'nuevo-rest__status';
      }
      try {
        const url = await uploadToCloudinary(file);
        if (hidden instanceof HTMLInputElement) hidden.value = url;

        let plateBg = '';
        if (mode === 'cover') {
          const sample = window.XemillaImageCrop?.samplePlateColorFromUrl;
          if (typeof sample === 'function') {
            try {
              plateBg = (await sample(url)) || '';
            } catch {
              plateBg = '';
            }
          }
          if (plateHidden instanceof HTMLInputElement && plateBg) {
            plateHidden.value = plateBg;
          }
        }

        applyPreview(mode, url, plateBg);
        if (status) {
          status.textContent = 'Listo';
          status.className = 'nuevo-rest__status is-ok';
        }
        refreshLive();
      } catch (err) {
        if (status) {
          status.textContent = err instanceof Error ? err.message : 'Error al subir';
          status.className = 'nuevo-rest__status is-err';
        }
      }
    }

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      fileInput.value = '';
      if (!file) return;

      const cropApi = window.XemillaImageCrop;
      if (cropApi && typeof cropApi.open === 'function') {
        cropApi.open({
          file,
          aspect: mode === 'cover' ? 'cover' : 'logo',
          title: mode === 'cover' ? 'Recortar portada' : 'Recortar logo',
          coverUrl:
            mode === 'logo'
              ? document.getElementById('hub_cover_url') instanceof HTMLInputElement
                ? /** @type {HTMLInputElement} */ (document.getElementById('hub_cover_url')).value
                : ''
              : undefined,
          onConfirm: (cropped) => runUpload(cropped),
        });
        return;
      }

      void runUpload(file);
    });
  }

  bindPicker('logo');
  bindPicker('cover');
  refreshLive();

  form?.addEventListener('submit', () => {
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creando…';
    }
  });
</script>
