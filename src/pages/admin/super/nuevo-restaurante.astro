---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminThemeSwitcher from '../../../components/admin/AdminThemeSwitcher.astro';
import {
  requireSuperAdmin,
  createRestauranteAsSuperAdmin,
} from '../../../lib/superadmin.js';

const gate = await requireSuperAdmin({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (!gate) {
  return Astro.redirect('/admin/login');
}

let errorMsg = '';

/** Prefill after validation error */
const prefill = {
  nombre: '',
  slug: '',
  whatsapp: '',
  direccion: '',
  logoUrl: '',
  hubCoverUrl: '',
  hubLogoBg: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  prefill.nombre = String(form.get('nombre_comercial') ?? '');
  prefill.slug = String(form.get('slug') ?? '');
  prefill.whatsapp = String(form.get('whatsapp_num') ?? '');
  prefill.direccion = String(form.get('direccion') ?? '');
  prefill.logoUrl = String(form.get('logo_url') ?? '');
  prefill.hubCoverUrl = String(form.get('hub_cover_url') ?? '');
  prefill.hubLogoBg = String(form.get('hub_logo_bg') ?? '');

  const result = await createRestauranteAsSuperAdmin(gate.supabase, gate.user, {
    userId: gate.user.id,
    nombreComercial: prefill.nombre,
    slug: prefill.slug,
    whatsapp: prefill.whatsapp,
    direccion: prefill.direccion,
    logoUrl: prefill.logoUrl,
    hubCoverUrl: prefill.hubCoverUrl,
    hubLogoBg: prefill.hubLogoBg,
  });

  if (result.error) {
    errorMsg = result.error;
  } else if (result.restaurante) {
    return Astro.redirect('/admin/super/dashboard');
  }
}

const xemillaWordmark =
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337620/Photoroom_20260810_004814_islrgw.png';
---

<Layout
  title="Nuevo restaurante · Xemilla"
  theme="crx"
  themeColor="#050505"
  description="Registrar un nuevo local en Xemilla"
  adminPanel={true}
>
  <main class="nuevo-rest mx-auto min-h-dvh w-full max-w-5xl px-4 pb-20 pt-5 sm:px-6 lg:px-10 lg:pt-8">
    <header class="nuevo-rest__top solid-obstacle">
      <a href="/admin/super/dashboard" class="nuevo-rest__brand" aria-label="Volver al SuperAdmin">
        <img
          src={xemillaWordmark}
          alt="xemilla"
          width="140"
          height="40"
          class="nuevo-rest__brand-img"
          loading="eager"
          decoding="async"
        />
      </a>
      <div class="nuevo-rest__top-actions">
        <AdminThemeSwitcher />
        <a href="/admin/super/dashboard" class="nuevo-rest__back">← SuperAdmin</a>
      </div>
    </header>

    <div class="nuevo-rest__intro solid-obstacle">
      <p class="nuevo-rest__eyebrow">Alta en la red</p>
      <h1 class="nuevo-rest__title">Nuevo restaurante</h1>
      <p class="nuevo-rest__lead">
        Completá la ficha del Hub. El fondo y la identidad pública se configuran después en Studio.
      </p>
    </div>

    <form method="POST" class="nuevo-rest__layout" id="nuevo-rest-form" novalidate>
      <section class="nuevo-rest__form glass-panel solid-obstacle">
        <div class="nuevo-rest__field">
          <label for="nombre_comercial">Nombre comercial</label>
          <input
            id="nombre_comercial"
            name="nombre_comercial"
            type="text"
            required
            autocomplete="organization"
            placeholder="Ej. Black Sushi"
            value={prefill.nombre}
          />
        </div>

        <div class="nuevo-rest__field">
          <label for="slug">URL pública (slug)</label>
          <div class="nuevo-rest__slug">
            <span aria-hidden="true">/</span>
            <input
              id="slug"
              name="slug"
              type="text"
              required
              pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
              placeholder="blacksushi"
              value={prefill.slug}
              aria-describedby="slug-hint"
            />
          </div>
          <p id="slug-hint" class="nuevo-rest__hint">
            Solo minúsculas, números y guiones · xemilla.com/<span data-slug-live>{prefill.slug || 'slug'}</span>
          </p>
        </div>

        <div class="nuevo-rest__row">
          <div class="nuevo-rest__field">
            <label for="whatsapp_num">WhatsApp</label>
            <input
              id="whatsapp_num"
              name="whatsapp_num"
              type="tel"
              required
              inputmode="tel"
              autocomplete="tel"
              placeholder="584141234567"
              value={prefill.whatsapp}
            />
            <p class="nuevo-rest__hint">Código de país + número, sin espacios</p>
          </div>
          <div class="nuevo-rest__field">
            <label for="direccion">Dirección <span class="nuevo-rest__optional">opcional</span></label>
            <input
              id="direccion"
              name="direccion"
              type="text"
              autocomplete="street-address"
              placeholder="Calle, ciudad"
              value={prefill.direccion}
            />
          </div>
        </div>

        <div class="nuevo-rest__media-grid">
          <div class="nuevo-rest__media-block">
            <div class="nuevo-rest__media-head">
              <div>
                <p class="nuevo-rest__media-label">Logo</p>
                <p class="nuevo-rest__hint">Avatar del Hub y la WebApp</p>
              </div>
              <button type="button" class="nuevo-rest__upload-btn" data-pick="logo">
                Subir logo
              </button>
            </div>
            <button
              type="button"
              class="nuevo-rest__logo-slot"
              data-pick="logo"
              data-logo-preview
              aria-label="Elegir logo"
            >
              {
                prefill.logoUrl ? (
                  <img src={prefill.logoUrl} alt="" class="nuevo-rest__logo-img" />
                ) : (
                  <span>Logo</span>
                )
              }
            </button>
            <input type="hidden" id="logo_url" name="logo_url" value={prefill.logoUrl} />
            <input id="logo_file" type="file" accept="image/*" class="sr-only" tabindex="-1" />
            <p id="logo-upload-status" class="nuevo-rest__status" role="status"></p>
          </div>

          <div class="nuevo-rest__media-block nuevo-rest__media-block--cover">
            <div class="nuevo-rest__media-head">
              <div>
                <p class="nuevo-rest__media-label">Portada Hub</p>
                <p class="nuevo-rest__hint">Solo tarjeta SuperAdmin · no es el fondo público</p>
              </div>
              <button type="button" class="nuevo-rest__upload-btn" data-pick="cover">
                Subir portada
              </button>
            </div>
            <button
              type="button"
              class="nuevo-rest__cover-slot"
              data-pick="cover"
              data-cover-preview
              aria-label="Elegir portada"
            >
              {
                prefill.hubCoverUrl ? (
                  <img src={prefill.hubCoverUrl} alt="" class="nuevo-rest__cover-img" />
                ) : (
                  <span>Portada</span>
                )
              }
            </button>
            <input type="hidden" id="hub_cover_url" name="hub_cover_url" value={prefill.hubCoverUrl} />
            <input type="hidden" id="hub_logo_bg" name="hub_logo_bg" value={prefill.hubLogoBg} />
            <input id="hub_cover_file" type="file" accept="image/*" class="sr-only" tabindex="-1" />
            <p id="cover-upload-status" class="nuevo-rest__status" role="status"></p>
          </div>
        </div>

        {
          errorMsg && (
            <p class="nuevo-rest__error" role="alert">
              {errorMsg}
            </p>
          )
        }

        <div class="nuevo-rest__actions">
          <a href="/admin/super/dashboard" class="nuevo-rest__cancel">Cancelar</a>
          <button type="submit" id="create-submit" class="nuevo-rest__submit">
            Crear restaurante
          </button>
        </div>
      </section>

      <aside class="nuevo-rest__preview solid-obstacle" aria-label="Vista previa de la tarjeta">
        <p class="nuevo-rest__preview-label">Así se ve en el Hub</p>
        <article class="nuevo-rest__card" data-live-card>
          <div class="nuevo-rest__card-media" data-live-cover>
            {
              prefill.hubCoverUrl ? (
                <img src={prefill.hubCoverUrl} alt="" />
              ) : (
                <div class="nuevo-rest__card-empty">Sin portada</div>
              )
            }
            <div
              class="nuevo-rest__card-plate"
              data-live-plate
              style={prefill.hubLogoBg ? `background:${prefill.hubLogoBg}` : undefined}
            >
              <div class="nuevo-rest__card-logo" data-live-logo>
                {
                  prefill.logoUrl ? (
                    <img src={prefill.logoUrl} alt="" />
                  ) : (
                    <span data-live-name-fallback>{prefill.nombre || 'Logo'}</span>
                  )
                }
              </div>
            </div>
          </div>
          <p class="nuevo-rest__card-meta">
            <span data-live-name>{prefill.nombre || 'Nombre del local'}</span>
            <span data-live-slug>/{prefill.slug || 'slug'}</span>
          </p>
        </article>
      </aside>
    </form>
  </main>
</Layout>

