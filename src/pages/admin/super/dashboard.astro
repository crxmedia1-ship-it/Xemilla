                    {anio ? <p class="super-prop__year">{anio}</p> : null}
                    <div class="super-prop__links">
                      <button type="button" data-prop-copy={href}>Copiar enlace</button>
                      <button
                        type="button"
                        data-prop-edit
                        data-prop-nombre={p.nombre}
                        data-prop-sin={p.sin_precio ? 'true' : 'false'}
                        data-prop-setup={p.setup ?? ''}
                        data-prop-anual={p.anual ?? ''}
                        data-prop-logo={p.logo_url || ''}
                      >Editar</button>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        )
      }
      </div>
      <div data-prop-pane="metricas" hidden>
      <section class="super-propm" aria-label="Métricas de propuestas">
        <div class="super-propm__top">
          <article class="super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 super-propm__card">
            <header class="super-propm__card-head">
              <span>Embudo</span>
              <small>{formatKpi(propStats.aperturas)} aperturas</small>
            </header>
            <ol class="super-propm__funnel" aria-label="Embudo de propuestas">
              {propEmbudo.map((step, i) => (
                <li data-step={i}>
                  <span class="super-propm__funnel-label" title={step.hint}>{step.label}</span>
                  <span class="super-propm__funnel-track" aria-hidden="true">
                    <span style={`width: ${step.n ? Math.max(step.pct, 6) : 0}%`}></span>
                  </span>
                  <strong>{formatKpi(step.n)}</strong>
                  <small>{i === 0 ? '' : `${step.pct}%`}</small>
                </li>
              ))}
            </ol>
          </article>

          <article class="super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 super-propm__card">
            <header class="super-propm__card-head">
              <span>Qué les interesó</span>
              <small>% de abiertas</small>
            </header>
            <ul class="super-propm__rings">
              {propInteres.map((item) => (
                <li title={`${item.label}: ${item.vieron} de ${propStats.abiertas} abiertas · ${item.clics} clics`}>
                  <span
                    class="super-propm__ring"
                    data-hot={item.short === 'WhatsApp' ? '' : undefined}
                    style={`--p: ${item.pct}`}
                  >
                    <strong>{item.pct}<small>%</small></strong>
                  </span>
                  <span class="super-propm__ring-label">{item.short}</span>
                  <small>{formatKpi(item.clics)} {item.clics === 1 ? 'clic' : 'clics'}</small>
                </li>
              ))}
            </ul>
          </article>

          <article class="super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 super-propm__card super-propm__activity">
            <header class="super-propm__card-head">
              <span>Actividad reciente</span>
              <small>{propActividadTotal === 1 ? '1 movimiento' : `${propActividadTotal} movimientos`}</small>
            </header>
            {propActividad.length === 0 ? (
              <XemillaQuiet
                inset
                kicker="Actividad"
                title="Todavía no hay movimientos."
                detail="Cuando un restaurante abra su enlace o toque algo, aparece aquí con la hora."
              />
            ) : (
              <ol class="super-propm__feed">
                {propActividad.map((ev) => (
                  <li data-tipo={ev.tipo}>
                    <span class="super-propm__mark" aria-hidden="true">{String(ev.nombre || '?').charAt(0).toUpperCase()}</span>
                    <p>
                      <strong>{ev.nombre}</strong>
                      <em>
                        {ev.texto}
                        {ev.veces > 1 ? <b>×{ev.veces}</b> : null}
                      </em>
                    </p>
                    <time>{ev.cuando}</time>
                  </li>
                ))}
              </ol>
            )}
          </article>
        </div>
      </section>
      </div>
    </div>

    <!-- Modal: Nuevo Restaurante -->
    <div
      id="nuevo-rest-modal"
