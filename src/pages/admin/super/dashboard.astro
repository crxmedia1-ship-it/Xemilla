                              >
                                {initialsFromName(local.nombre)}
                              </div>
                            )}
                            <div class="min-w-0 flex-1">
                              <p class="truncate text-sm font-medium text-zinc-900 dark:text-white" data-net-name>{local.nombre}</p>
                              <p class="truncate font-mono text-[11px] text-zinc-500" data-net-slug>
                                {local.slug ? `/${local.slug}` : '—'}
                              </p>
                            </div>
                            <span class="shrink-0 font-mono text-sm tabular-nums text-zinc-700 dark:text-zinc-300" data-net-count>
                              {formatKpi(local.visitas)}
                            </span>
                          </div>
                          <div class="ml-11 h-1 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800/80">
                            <div
                              class="h-full rounded-full bg-zinc-400/80 dark:bg-zinc-500/60"
                              data-net-bar
                              style={`width: ${pct}%`}
                            />
                          </div>
                        </li>
                    );
                  })
                )
              }
            </ol>
          </div>
        </article>
      </section>

