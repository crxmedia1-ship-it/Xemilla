---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import XemillaQuiet from '../../../components/XemillaQuiet.astro';
import '../../../styles/admin-themes.css';
import ImageCropHost from '../../../components/admin/ImageCropHost.astro';
import {
  requireSuperAdmin,
  listAllRestaurantes,
  getSuperAdminWriteClient,
  createRestauranteAsSuperAdmin,
} from '../../../lib/superadmin.js';
import { createSupabaseServiceClient } from '../../../lib/supabase/service.js';
import { fetchNetworkIntelligence } from '../../../lib/metrics.js';
import { listPropuestas, listPropuestaEventos, getPropuestaDefaults, PROPUESTA_ADICIONALES, PROPUESTA_QR_PIEZAS, readPropuestaPiezas, readPropuestaPiezasFactura, readPropuestaPaquetes, readPropuestaPaquetesFactura, readPropuestaPaquetesOrden, readPropuestaPaquetesPlatos, propuestaTienePaquetes, readPropuestaIaMensual } from '../../../lib/propuestas.js';
import { listRestauranteVentas, VENTA_PRODUCTOS, ventaProductoLabel, formatVentaMonto, resumenVentas } from '../../../lib/ventas.js';
import {
  resolveHubTarjeta,
  readUiHub,
  HUB_TARJETAS,
  persistHubInUiEstilo,
} from '../../../lib/hub-media.js';
import { cloudinaryTrimUrl } from '../../../lib/plato-media-url.js';

const gate = await requireSuperAdmin({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (!gate) {
  return Astro.redirect('/admin/login');
}

/** Prefill / error for modal "Nuevo Restaurante" */
let createErrorMsg = '';
const createPrefill = {
  nombre: '',
  slug: '',
  whatsapp: '',
  logoUrl: '',
  hubCoverUrl: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'create-restaurante') {
    createPrefill.nombre = String(form.get('nombre_comercial') ?? '');
    createPrefill.slug = String(form.get('slug') ?? '');
    createPrefill.whatsapp = String(
      form.get('whatsapp_num') ?? form.get('whatsapp_url') ?? '',
    );
    createPrefill.logoUrl = String(form.get('logo_url') ?? '');
    createPrefill.hubCoverUrl = String(
      form.get('hub_cover_url') ?? form.get('portada_url') ?? '',
    );

    const result = await createRestauranteAsSuperAdmin(gate.supabase, gate.user, {
      userId: gate.user.id,
      nombreComercial: createPrefill.nombre,
      slug: createPrefill.slug,
      whatsapp: createPrefill.whatsapp,
      logoUrl: createPrefill.logoUrl,
      hubCoverUrl: createPrefill.hubCoverUrl,
    });

    if (result.error) {
      createErrorMsg = result.error;
    } else if (result.restaurante) {
      return Astro.redirect('/admin/super/dashboard');
    }
  }
}

const openNuevoRestModal = Boolean(createErrorMsg);
const logoTrimPrefill = createPrefill.logoUrl
  ? cloudinaryTrimUrl(createPrefill.logoUrl)
  : '';

const restaurantes = await listAllRestaurantes(gate.supabase, gate.user);
const hubWrite = getSuperAdminWriteClient(gate.supabase, gate.user);
await Promise.all(
  restaurantes.map(async (row, index) => {
    const stored = String(readUiHub(row).tarjeta || '').trim();
    if (HUB_TARJETAS.includes(stored)) return;
    const tarjeta = HUB_TARJETAS[index % HUB_TARJETAS.length];
    const prev =
      row.ui_estilo && typeof row.ui_estilo === 'object' && !Array.isArray(row.ui_estilo)
        ? row.ui_estilo
        : {};
    row.ui_estilo = { ...prev, hub: { ...readUiHub(row), tarjeta } };
    await persistHubInUiEstilo(hubWrite, String(row.id), { tarjeta });
  }),
);
const mesaPorId = new Map(
  [...restaurantes]
    .sort(
      (a, b) =>
        Number(String(b.slug) === 'crx-prueba') - Number(String(a.slug) === 'crx-prueba'),
    )
    .map((r, i) => [String(r.id), String(i + 1).padStart(2, '0')]),
);
const cartasDemo = restaurantes
  .filter((r) => r.activo !== false && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(String(r.slug || '')) && String(r.slug) !== 'crx-prueba')
  .map((r) => ({
    slug: String(r.slug),
    nombre: String(r.nombre_comercial || r.slug).trim() || String(r.slug),
  }))
  .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const propuestasClient = getSuperAdminWriteClient(gate.supabase, gate.user);
const [propuestas, propEventos, addonDefaults, ventasRows] = await Promise.all([
  listPropuestas(propuestasClient),
  listPropuestaEventos(propuestasClient),
  getPropuestaDefaults(propuestasClient),
  listRestauranteVentas(propuestasClient),
]);
const ventasPorRestaurante = new Map();
for (const venta of ventasRows) {
  const id = String(venta.restaurante_id || '');
  const list = ventasPorRestaurante.get(id) || [];
  list.push(venta);
  ventasPorRestaurante.set(id, list);
}

function arPaqueteRows(adicionales) {
  const precios = readPropuestaPaquetes(adicionales);
  const platos = readPropuestaPaquetesPlatos(adicionales);
  const guardo =
    adicionales && typeof adicionales === 'object' && Array.isArray(adicionales.paquetesFactura);
  const en = new Set(readPropuestaPaquetesFactura(adicionales));
  return readPropuestaPaquetesOrden(adicionales).map((id) => ({
    id,
    label: `Paquete ${id}`,
    amount: precios[id] || '',
    platos: platos[id] || '1',
    on: guardo ? en.has(id) : Boolean(precios[id]),
  }));
}

function qrPiezaRows(adicionales, tentSiNoHayLista) {
  const precios = readPropuestaPiezas(adicionales);
  const guardo =
    adicionales && typeof adicionales === 'object' && Array.isArray(adicionales.piezasFactura);
  const en = new Set(readPropuestaPiezasFactura(adicionales));
  return PROPUESTA_QR_PIEZAS.map((piece) => ({
    id: piece.id,
    label: piece.label,
    amount: precios[piece.id] || '',
    on: guardo ? en.has(piece.id) : Boolean(precios[piece.id]) || (tentSiNoHayLista && piece.id === 'tent'),
  }));
}
const requestedTab = Astro.url.searchParams.get('tab');
const superTab =
  requestedTab === 'metricas' || requestedTab === 'propuestas' || requestedTab === 'accesos'
    ? requestedTab
    : 'locales';

/**
 * @param {string | null | undefined} iso
 */
function formatPropuestaAnio(iso) {
  if (!iso) return '';
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return '';
  return String(date.getFullYear());
}

/** @param {Record<string, any>} p */
const propExploro = (p) =>
  Number(p.vio_ar) > 0 || Number(p.vio_nutri) > 0 || Number(p.vio_qr) > 0 || Number(p.vio_ia) > 0;
const propAbiertas = propuestas.filter((p) => Number(p.vistas) > 0);
const propStats = {
  total: propuestas.length,
  aperturas: propuestas.reduce((sum, p) => sum + (Number(p.vistas) || 0), 0),
  abiertas: propAbiertas.length,
  contacto: propuestas.filter((p) => Number(p.vio_whatsapp) > 0).length,
};
const propEmbudo = [
  { label: 'Enviadas', hint: 'Enlaces creados', n: propStats.total },
  { label: 'Abiertas', hint: 'Al menos una apertura', n: propStats.abiertas },
  { label: 'Exploraron', hint: 'AR, ficha, QRs o Klientiq', n: propuestas.filter(propExploro).length },
  { label: 'Contactaron', hint: 'Tocaron WhatsApp', n: propStats.contacto },
].map((step) => ({
  ...step,
  pct: propStats.total ? Math.round((step.n / propStats.total) * 100) : 0,
}));

/** @param {Record<string, any>} p */
function propuestaEstado(p) {
  if (Number(p.vio_whatsapp) > 0) return { label: 'Pidió contacto', tone: 'hot' };
  if (propExploro(p)) return { label: 'Exploró', tone: 'warm' };
  if (Number(p.vistas) > 0) return { label: 'Abierta', tone: 'open' };
  return { label: 'Sin abrir', tone: 'idle' };
}

const PROP_EVENTO_TEXTO = {
  vista: 'abrió la propuesta',
  ar: 'probó la realidad aumentada',
  nutri: 'miró la ficha nutricional',
  qr: 'miró los QRs de mesa',
  ia: 'miró el asistente Klientiq',
  whatsapp: 'tocó WhatsApp',
};
const propNombrePorId = new Map(propuestas.map((p) => [String(p.id), p.nombre]));
const propActividad = [];
for (const e of propEventos) {
  const nombre = propNombrePorId.get(String(e.propuesta_id));
  if (!nombre) continue;
  const prev = propActividad[propActividad.length - 1];
  if (prev && prev.nombre === nombre && prev.tipo === e.tipo) {
    prev.veces += 1;
    continue;
  }
  propActividad.push({
    id: e.id,
    nombre,
    texto: PROP_EVENTO_TEXTO[e.tipo] || e.tipo,
    tipo: e.tipo,
    cuando: formatHace(e.created_at),
    veces: 1,
  });
}
const propActividadTotal = propActividad.reduce((sum, ev) => sum + ev.veces, 0);

/** @param {string | null | undefined} iso */
function formatHace(iso) {
  const t = new Date(String(iso || '')).getTime();
  if (Number.isNaN(t)) return '';
  const min = Math.max(0, Math.round((Date.now() - t) / 60000));
  if (min < 1) return 'ahora';
  if (min < 60) return `hace ${min} min`;
  const h = Math.round(min / 60);
  if (h < 24) return `hace ${h} h`;
  const d = Math.round(h / 24);
  if (d < 30) return `hace ${d} d`;
  return new Intl.DateTimeFormat('es-VE', { dateStyle: 'medium' }).format(new Date(t));
}

/** @param {string | null | undefined} iso */
function formatFechaCorta(iso) {
  const date = new Date(String(iso || ''));
  if (Number.isNaN(date.getTime())) return '—';
  return new Intl.DateTimeFormat('es-VE', { day: 'numeric', month: 'short' }).format(date);
}
const propInteres = [
  ['Realidad aumentada', 'AR', 'vio_ar'],
  ['Ficha nutricional', 'Ficha', 'vio_nutri'],
  ['QRs de mesa', 'QRs', 'vio_qr'],
  ['Klientiq CRM + IA', 'Klientiq', 'vio_ia'],
  ['WhatsApp', 'WhatsApp', 'vio_whatsapp'],
].map(([label, short, key]) => {
  const vieron = propuestas.filter((p) => Number(p[key]) > 0).length;
  return {
    label,
    short,
    vieron,
    clics: propuestas.reduce((sum, p) => sum + (Number(p[key]) || 0), 0),
    pct: propAbiertas.length ? Math.round((vieron / propAbiertas.length) * 100) : 0,
  };
});
const writeClient = getSuperAdminWriteClient(gate.supabase, gate.user);

/** Operativo access = Auth metadata restaurante_id (not truthy restaurantes.user_id — that is often SuperAdmin). */
/** @type {import('@supabase/supabase-js').User[]} */
const authUsers = [];
const service = createSupabaseServiceClient();
if (service) {
  const perPage = 200;
  for (let page = 1; page <= 50; page += 1) {
    const { data: authPage, error: listErr } = await service.auth.admin.listUsers({
      page,
      perPage,
    });
    if (listErr) {
      console.error('[super/dashboard] listUsers:', listErr.message);
      break;
    }
    const batch = authPage?.users ?? [];
    authUsers.push(...batch);
    if (batch.length < perPage) break;
  }
}

const localesConAcceso = new Set(
  authUsers
    .flatMap((u) => [u.app_metadata?.restaurante_id, u.app_metadata?.restauranteId])
    .filter(Boolean)
    .map(String),
);

const networkIntel = await fetchNetworkIntelligence(writeClient, {
  days: 30,
  restaurantes,
  localesConAcceso,
});

/** @param {number} n */
function formatKpi(n) {
  return (Number(n) || 0).toLocaleString('es-VE');
}

/** @param {number | null | undefined} n */
function formatTasa(n) {
  if (n == null || !Number.isFinite(n)) return '';
  return `${n}%`;
}

/** @param {string | null | undefined} name */
function initialsFromName(name) {
  const parts = String(name || '')
    .trim()
    .split(/\s+/)
    .filter(Boolean);
  if (!parts.length) return '—';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return `${parts[0].charAt(0)}${parts[1].charAt(0)}`.toUpperCase();
}

const emptyCellClass = 'super-net-empty text-zinc-300 dark:text-zinc-700 font-mono text-xs';

const kpiCardClass =
  'super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 rounded-3xl p-6 shadow-[0_8px_30px_rgba(0,0,0,0.03)] dark:shadow-none transition-all flex flex-col justify-between min-h-[150px]';
const kpiLabelClass =
  'text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500';
const kpiValueClass =
  'super-net-kpi-value text-4xl lg:text-5xl font-extralight font-mono text-zinc-900 dark:text-white tracking-tight my-2';
const kpiHintClass =
  'text-[11px] text-zinc-500 font-medium flex items-center gap-1.5';
const studioBtnClass =
  'super-net-btn-studio px-3 py-1.5 text-xs font-medium rounded-xl transition-colors shadow-xs bg-zinc-900 text-white hover:bg-zinc-800 dark:bg-zinc-800 dark:text-zinc-100';
const webappBtnClass =
  'super-net-btn-web px-3 py-1.5 text-xs font-medium rounded-xl border border-zinc-200/80 dark:border-zinc-800 transition-colors bg-zinc-100 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-900 dark:text-zinc-300';

const topPlatosMax = Math.max(1, ...networkIntel.topPlatos.map((p) => p.vistas), 0);
const rankingLocalesMax = Math.max(1, ...networkIntel.rankingLocales.map((x) => x.visitas), 0);
const rankingMenorMax = Math.max(
  1,
  ...(networkIntel.rankingMenor || []).map((x) => x.visitas),
  0,
);

const MONTHS_ES = [
  'Enero',
  'Febrero',
  'Marzo',
  'Abril',
  'Mayo',
  'Junio',
  'Julio',
  'Agosto',
  'Septiembre',
  'Octubre',
  'Noviembre',
  'Diciembre',
];

/**
 * Meses desde el primer restaurante hasta Septiembre 2026 (mes en curso del Hub).
 * @param {string | null | undefined} createdAtRaw
 */
function buildNetworkMonthOptions(createdAtRaw) {
  const end = new Date(2026, 8, 1); // Septiembre 2026
  const now = new Date();
  const endClamped =
    now < end ? new Date(now.getFullYear(), now.getMonth(), 1) : end;
  let start = endClamped;
  if (createdAtRaw) {
    const parsed = new Date(createdAtRaw);
    if (!Number.isNaN(parsed.getTime())) {
      start = new Date(parsed.getFullYear(), parsed.getMonth(), 1);
    }
  }
  if (start > endClamped) start = endClamped;

  /** @type {Array<{ value: string, label: string }>} */
  const options = [];
  const cursor = new Date(start.getTime());
  while (cursor <= endClamped) {
    options.push({
      value: `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, '0')}`,
      label: `${MONTHS_ES[cursor.getMonth()]} ${cursor.getFullYear()}`,
    });
    cursor.setMonth(cursor.getMonth() + 1);
  }
  return options;
}

const networkMonthOptions = buildNetworkMonthOptions(networkIntel.firstRestaurantAt);
const networkSeriesPayload = networkIntel.series || {
  eventMode: false,
  currentMonth: '',
  all: { total: 0, byRest: {}, topPlatoByRest: {}, topPlatos: [], rankingMayor: [], rankingMenor: [] },
  months: {},
};

const tfOnClass =
  'super-tf-on px-3 py-1.5 rounded-xl font-semibold bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-xs';
const tfOffClass =
  'px-3 py-1.5 rounded-xl font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors';

const xemillaWordmark = '/propuesta/xemilla-on-light.png';

/**
 * @param {string | null | undefined} url
 * @param {string | null | undefined} num
 */
function resolveWaHref(url, num) {
  const raw = String(url || num || '').trim();
  if (!raw) return '';
  if (/^https?:\/\//i.test(raw)) return raw;
  const digits = raw.replace(/\D/g, '');
  return digits ? `https://wa.me/${digits}` : '';
}

/**
 * @param {Record<string, unknown>} r
 */
function resolveLogoUrl(r) {
  const v = String(r?.logo_url || '').trim();
  if (/^https?:\/\//i.test(v) || v.startsWith('/')) return v;
  return '';
}

/**
 * @param {Record<string, unknown>} r
 */
function resolvePhone(r) {
  return String(r?.whatsapp_url || r?.whatsapp_num || '').trim();
}

/** @param {string} phone */
function formatPhoneLabel(phone) {
  if (!/^https?:\/\//i.test(phone)) return phone;
  const digits = phone.replace(/\D/g, '');
  return digits ? `+${digits}` : phone;
}

/**
 * @param {string} direccion
 * @param {string} coordenadas
 */
function resolveMapsHref(direccion, coordenadas) {
  const coords = String(coordenadas || '').trim();
  if (coords && /^https?:\/\//i.test(coords) && !/maps\.google\.com\/?$/i.test(coords)) {
    return coords;
  }
  const q = String(direccion || '').trim();
  return q
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`
    : '';
}

/**
 * @param {string} direccion
 */
function resolveMapsEmbed(direccion) {
  const q = String(direccion || '').trim();
  if (!q) return '';
  return `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=15&output=embed`;
}
---

<Layout
  title="SuperAdmin · Xemilla"
  theme="crx"
  themeColor="#050505"
  description="Panel maestro de restaurantes Xemilla"
  adminPanel={true}
>
  <main class="super-admin-dash w-full min-w-full px-4 sm:px-8 lg:px-12 py-6 pb-20 min-h-dvh">
    <!-- Hero Until layout + glassmorphism (sin foto de fondo) -->
    <section class="super-until-hero solid-obstacle" aria-label="Súper Administrador">
      <header class="super-until-hero__nav">
        <a href="/admin/super/dashboard" class="super-until-hero__brand" aria-label="Xemilla">
          <img
            src={xemillaWordmark}
            alt="xemilla"
            width="160"
            height="48"
            class="super-until-hero__brand-img"
            loading="eager"
            decoding="async"
          />
        </a>

        <div class="super-until-hero__actions">
          <button
            type="button"
            class="super-until-hero__cta"
            data-nuevo-rest-open
            aria-haspopup="dialog"
            aria-controls="nuevo-rest-modal"
          >
            <span class="super-until-hero__cta-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              </svg>
            </span>
            Nuevo restaurante
          </button>
          <form method="POST" action="/api/admin-logout" class="super-until-hero__logout">
            <button type="submit" class="super-until-hero__logout-btn">Salir</button>
          </form>
          <details class="super-jump" data-card-menu>
            <summary class="super-jump__btn" aria-label="Accesos de Xemilla" aria-haspopup="menu">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M19.4 13.1a7.7 7.7 0 0 0 .1-2.2l2-1.2-2-3.4-2.2.6a7.8 7.8 0 0 0-1.9-1.1L15 3h-6l-.4 2.8a7.8 7.8 0 0 0-1.9 1.1l-2.2-.6-2 3.4 2 1.2a7.7 7.7 0 0 0 .1 2.2l-2 1.2 2 3.4 2.2-.6a7.8 7.8 0 0 0 1.9 1.1L9 21h6l.4-2.8a7.8 7.8 0 0 0 1.9-1.1l2.2.6 2-3.4-2-1.2Z" />
              </svg>
            </summary>
            <div class="super-card-menu flex flex-col" data-card-menu-panel role="menu" aria-label="Accesos de Xemilla">
              <p class="super-jump__title">Xemilla</p>
              <a href="/" target="_blank" rel="noopener noreferrer" class="super-card-menu__item" role="menuitem">
                <span class="super-card-menu__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z" /></svg>
                </span>
                <span class="super-card-menu__copy">
                  <span class="super-card-menu__label">Inicio</span>
                  <span class="super-card-menu__hint">Sitio comercial</span>
                </span>
              </a>
              <a href="/propuesta" target="_blank" rel="noopener noreferrer" class="super-card-menu__item" role="menuitem">
                <span class="super-card-menu__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7 3.5h7l5 5V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z" /><path d="M14 3.5V9h5" /><path d="M9 13h6M9 17h4" /></svg>
                </span>
                <span class="super-card-menu__copy">
                  <span class="super-card-menu__label">Propuesta</span>
                  <span class="super-card-menu__hint">Página de venta</span>
                </span>
              </a>
              <div class="super-card-menu__divider" aria-hidden="true"></div>
              <a href="/admin/login" target="_blank" rel="noopener noreferrer" class="super-card-menu__item" role="menuitem">
                <span class="super-card-menu__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M10 7V5a2 2 0 0 1 2-2h7v18h-7a2 2 0 0 1-2-2v-2" /><path d="M15 12H3m0 0 3-3m-3 3 3 3" /></svg>
                </span>
                <span class="super-card-menu__copy">
                  <span class="super-card-menu__label">Acceso del local</span>
                  <span class="super-card-menu__hint">Entrada del restaurante</span>
                </span>
              </a>
            </div>
          </details>
        </div>
      </header>

      <div class="super-until-hero__copy">
        <p class="super-until-hero__eyebrow">Súper Administrador</p>
      </div>

      <nav
        class="super-until-hero__links"
        role="tablist"
        aria-label="Secciones SuperAdmin"
        data-on={superTab}
      >
        <span class="super-until-hero__thumb" aria-hidden="true"></span>
        <button
          type="button"
          role="tab"
          data-super-tab="locales"
          aria-selected={superTab === 'locales' ? 'true' : 'false'}
          class="super-until-hero__link"
        >
          Restaurantes
        </button>
        <button
          type="button"
          role="tab"
          data-super-tab="propuestas"
          aria-selected={superTab === 'propuestas' ? 'true' : 'false'}
          class="super-until-hero__link"
        >
          Propuestas
        </button>
        <button
          type="button"
          role="tab"
          data-super-tab="accesos"
          aria-selected={superTab === 'accesos' ? 'true' : 'false'}
          class="super-until-hero__link"
        >
          Accesos
        </button>
        <button
          type="button"
          role="tab"
          data-super-tab="metricas"
          aria-selected={superTab === 'metricas' ? 'true' : 'false'}
          class="super-until-hero__link"
        >
          Métricas
        </button>
      </nav>
    </section>

    <div data-super-panel="locales" class="admin-fade-in-up" hidden={superTab !== 'locales'}>
      {
        restaurantes.length === 0 ? (
          <XemillaQuiet inset kicker="Restaurantes" title="Todavía no hay locales." detail="Creá el primero para empezar la red.">
            <button
              type="button"
              class="super-until-hero__cta inline-flex"
              data-nuevo-rest-open
              aria-haspopup="dialog"
              aria-controls="nuevo-rest-modal"
            >
              <span class="super-until-hero__cta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                </svg>
              </span>
              Nuevo restaurante
            </button>
          </XemillaQuiet>
        ) : (
          <>
            <div class="super-hub-search solid-obstacle">
              <label class="sr-only" for="super-hub-search-input">
                Buscar restaurante por nombre
              </label>
              <span class="super-hub-search__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.2-3.2"></path>
                </svg>
              </span>
              <input
                id="super-hub-search-input"
                type="search"
                class="super-hub-search__input"
                placeholder="Buscar por nombre…"
                autocomplete="off"
                spellcheck="false"
                data-hub-search
              />
              <button
                type="button"
                class="super-hub-search__clear"
                data-hub-search-clear
                hidden
                aria-label="Limpiar búsqueda"
              >
                ×
              </button>
              <p class="super-hub-search__count" data-hub-search-count aria-live="polite">
                {restaurantes.length} local{restaurantes.length === 1 ? '' : 'es'}
              </p>
            </div>

            <p class="super-hub-search__empty" data-hub-search-empty hidden>
              No hay locales con ese nombre.
            </p>

            <ul
              class="super-visual-grid mt-7 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 gap-6 w-full"
              data-hub-grid
            >
            {restaurantes.map((r) => {
              const tieneAcceso =
                localesConAcceso.has(String(r.id)) ||
                localesConAcceso.has(String(r.slug));
              const ctaLabel = 'AGREGAR USUARIO';
              const logoUrl = resolveLogoUrl(r);
              const phone = resolvePhone(r);
              const waHref = resolveWaHref(r.whatsapp_url, r.whatsapp_num);
              const nombre = String(r.nombre_comercial || '').trim();
              const direccion = String(r.direccion || '').trim();
              const coordenadas = String(r.coordenadas_maps || '').trim();
              const mapsHref = resolveMapsHref(direccion, coordenadas);
              const mapsEmbed = resolveMapsEmbed(direccion);
              const studioHref = `/admin/dashboard?restaurante=${encodeURIComponent(r.id)}`;
              const tarjetaActual = resolveHubTarjeta(r);
              const searchKey = `${nombre} ${r.slug || ''}`.toLowerCase();
              const esPrueba = String(r.slug || '') === 'crx-prueba';
              return (
              <li
                class:list={[
                  'super-hub-card group solid-obstacle',
                  r.activo === false && 'super-hub-card--paused',
                ]}
                data-restaurante-id={r.id}
                data-hub-name={searchKey}
                data-hub-slug={String(r.slug || '')}
                data-hub-activo={r.activo === false ? 'false' : 'true'}
              >
                <div class="super-hub-card__face" data-tarjeta={tarjetaActual}>
                  <a
                    href={studioHref}
                    class="super-hub-card__hit"
                    aria-label={`Abrir el panel de ${nombre || r.slug}`}
                  ></a>
                  <span class="super-hub-card__ticket" aria-hidden="true">Comanda · Mesa {mesaPorId.get(String(r.id))}</span>
                  <details class="super-hub-card__menu" data-card-menu>
                    <summary
                      class="cursor-pointer list-none [&::-webkit-details-marker]:hidden"
                      aria-label={`Menú de ${nombre || r.slug}`}
                    >
                      <svg width="9" height="9" viewBox="0 0 16 16" aria-hidden="true">
                        <circle cx="4" cy="8" r="1.35" fill="currentColor" />
                        <circle cx="8" cy="8" r="1.35" fill="currentColor" />
                        <circle cx="12" cy="8" r="1.35" fill="currentColor" />
                      </svg>
                    </summary>
                    <div class="super-card-menu flex flex-col" data-card-menu-panel role="menu">
                      <button type="button" data-open-ficha class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 16-4.5-4.5L9 19"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Editar ficha</span>
                          <span class="super-card-menu__hint">Cover, logo y datos</span>
                        </span>
                      </button>
                      <button type="button" data-open-info class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 10v6"/><path d="M12 7h.01"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Info del restaurante</span>
                          <span class="super-card-menu__hint">Contacto, ubicación y mapa</span>
                        </span>
                      </button>
                      <button type="button" data-open-ventas class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M6 3h12v18l-2-1.2L14 21l-2-1.2L10 21l-2-1.2L6 21z"/><path d="M9 8h6M9 12h6"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Se le vendió</span>
                          <span class="super-card-menu__hint" data-ventas-hint>
                            {resumenVentas(ventasPorRestaurante.get(String(r.id)) || []) || 'Todavía nada'}
                          </span>
                        </span>
                      </button>
                      <button type="button" data-open-creds class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Usuarios</span>
                          <span class="super-card-menu__hint">Ver, agregar, suspender</span>
                        </span>
                      </button>
                      <div class="super-card-menu__divider" aria-hidden="true"></div>
                      <a
                        href={`/${r.slug}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="super-card-menu__item"
                        role="menuitem"
                      >
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Ver WebApp</span>
                          <span class="super-card-menu__hint">/{r.slug}</span>
                        </span>
                      </a>
                      <div class="super-card-menu__divider" aria-hidden="true"></div>
                      <button
                        type="button"
                        data-toggle-activo
                        data-activo={r.activo === false ? 'false' : 'true'}
                        class="super-card-menu__item"
                        role="menuitem"
                      >
                        <span class="super-card-menu__icon" aria-hidden="true">
                          {r.activo === false ? (
                            <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                          ) : (
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 12h6"/></svg>
                          )}
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label" data-toggle-activo-label>
                            {r.activo === false ? 'Reactivar local' : 'Desactivar local'}
                          </span>
                          <span class="super-card-menu__hint" data-toggle-activo-hint>
                            {r.activo === false
                              ? 'Volver a publicar la WebApp'
                              : 'Pausar sin borrar (impago)'}
                          </span>
                        </span>
                      </button>
                      <button
                        type="button"
                        data-delete-restaurante
                        class="super-card-menu__item super-card-menu__item--danger"
                        role="menuitem"
                      >
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M7 7l1 12a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-12"/><path d="M10 11v6M14 11v6"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Eliminar permanentemente</span>
                          <span class="super-card-menu__hint">Borra menú y datos · irreversible</span>
                        </span>
                      </button>
                    </div>
                  </details>

                  <span class="super-hub-card__mark" aria-hidden="true">
                    {esPrueba && !logoUrl ? (
                      <span class="super-hub-card__sticker" aria-hidden="true">Prueba</span>
                    ) : (
                      <span class="super-hub-card__logo-glass" data-card-logo-zone>
                        {logoUrl ? (
                          <img
                            src={logoUrl}
                            alt=""
                            class="super-hub-card__logo-img"
                            loading="lazy"
                            decoding="async"
                            data-card-logo-img
                          />
                        ) : (
                          <span class="super-hub-card__logo-empty" data-card-logo-empty>
                            {initialsFromName(nombre || r.slug)}
                          </span>
                        )}
                      </span>
                    )}
                  </span>

                  <div class="super-hub-card__meta">
                    <p class="super-hub-card__name">{nombre || r.slug}</p>
                    {r.slug ? <p class="super-hub-card__slug">/{r.slug}</p> : null}
                    <div class="super-hub-card__states" data-estado-host>
                      {r.activo === false ? (
                        <span data-estado-badge class="super-hub-card__state super-hub-card__state--paused">
                          <span class="super-hub-card__dot" aria-hidden="true"></span>
                          Desactivado
                        </span>
                      ) : null}
                      {tieneAcceso ? (
                        <span data-access-badge class="super-hub-card__state super-hub-card__state--on">
                          <span class="super-hub-card__dot" aria-hidden="true"></span>
                          Acceso activo
                        </span>
                      ) : (
                        <span data-access-badge class="super-hub-card__state">
                          <span class="super-hub-card__dot" aria-hidden="true"></span>
                          Sin acceso
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                {/* Editar ficha — modal centrado */}
                <div class="hub-modal" data-ficha-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-ficha aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog hub-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby={`ficha-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <p class="hub-modal__title" id={`ficha-title-${r.id}`}>Editar ficha Hub</p>
                      <button type="button" class="hub-modal__close" data-close-ficha aria-label="Cerrar">×</button>
                    </div>
                    <p class="hub-modal__hint">
                      El logo va impreso en la comanda.
                    </p>
                    <form class="space-y-3.5" data-ficha-form data-restaurante-id={r.id} data-slug={r.slug || ''} novalidate>
                      <div class="hub-ficha-folder">
                      <div class="hub-ficha-stage" data-ficha-stage data-tarjeta={tarjetaActual}>
                        <span class="super-hub-card__ticket" aria-hidden="true">Comanda · Mesa {mesaPorId.get(String(r.id))}</span>
                        <div class="hub-ficha-stage__mark" data-ficha-logo-preview>
                          {esPrueba && !logoUrl ? (
                            <span class="super-hub-card__sticker super-hub-card__sticker--ficha" aria-hidden="true">Prueba</span>
                          ) : logoUrl ? (
                            <img src={logoUrl} alt="" data-ficha-logo-img class="hub-ficha-stage__img" />
                          ) : (
                            <span class="hub-ficha-stage__empty" data-ficha-logo-empty>
                              {initialsFromName(nombre || r.slug)}
                            </span>
                          )}
                        </div>
                      </div>
                      <span class="hub-ficha-folder__flap" aria-hidden="true"></span>
                      </div>
                      <div class="hub-ficha-stage__bar">
                        <span>Logo</span>
                        <label class="hub-ficha-file">
                          Cambiar
                          <input type="file" accept="image/*" data-ficha-logo-file />
                        </label>
                      </div>
                      <input type="hidden" name="logo_url" value={logoUrl} data-ficha-logo-url />
                      <input type="hidden" name="tarjeta" value={tarjetaActual} data-ficha-tarjeta />
                      <label class="block">
                        <span>Nombre</span>
                        <input type="text" name="nombre_comercial" required value={nombre} />
                      </label>
                      <label class="block">
                        <span>Teléfono / WhatsApp</span>
                        <input type="text" name="whatsapp_num" value={phone} placeholder="58414…" />
                      </label>
                      <p class="hidden text-[0.75rem] leading-relaxed" data-ficha-feedback role="status"></p>
                      <button type="submit" class="super-card-sheet__submit">Guardar ficha</button>
                    </form>
                  </div>
                </div>

                {/* Info del restaurante */}
                <div class="hub-modal" data-info-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-info aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog hub-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby={`info-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <p class="hub-modal__title" id={`info-title-${r.id}`}>Info del restaurante</p>
                      <button type="button" class="hub-modal__close" data-close-info aria-label="Cerrar">×</button>
                    </div>
                    <p class="hub-modal__hint">{nombre || r.slug}</p>
                    <div class="hub-info-grid">
                      <section class="hub-info-card" data-empty={phone ? undefined : ''}>
                        <div class="hub-info-card__head">
                          <span class="hub-info-card__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                          </span>
                          <span class="hub-modal__section-label">Contacto</span>
                        </div>
                        {phone ? (
                          <p class="hub-info-card__value">{formatPhoneLabel(phone)}</p>
                        ) : (
                          <p class="hub-info-card__value hub-modal__section-value--muted">Sin número cargado</p>
                        )}
                        {phone ? (
                          <div class="hub-info-card__actions">
                            {waHref ? (
                              <a href={waHref} target="_blank" rel="noopener noreferrer" class="hub-info-btn hub-info-btn--primary">
                                WhatsApp
                              </a>
                            ) : null}
                            <a href={`tel:${formatPhoneLabel(phone).replace(/[^\d+]/g, '')}`} class="hub-info-btn">Llamar</a>
                          </div>
                        ) : null}
                      </section>
                      <section class="hub-info-card" data-empty={direccion ? undefined : ''}>
                        <div class="hub-info-card__head">
                          <span class="hub-info-card__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          </span>
                          <span class="hub-modal__section-label">Ubicación</span>
                        </div>
                        {direccion ? (
                          <p class="hub-info-card__value">{direccion}</p>
                        ) : (
                          <p class="hub-info-card__value hub-modal__section-value--muted">Sin dirección cargada</p>
                        )}
                        {mapsHref ? (
                          <div class="hub-info-card__actions">
                            <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="hub-info-btn">
                              Abrir en Maps
                            </a>
                          </div>
                        ) : null}
                      </section>
                      {mapsEmbed ? (
                        <div class="hub-info-card hub-info-card--map">
                          <iframe
                            class="hub-modal__map"
                            src={mapsEmbed}
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title={`Mapa de ${nombre || r.slug}`}
                          ></iframe>
                        </div>
                      ) : null}
                    </div>
                  </div>
                </div>

                {/* Lo que ya pagó este restaurante */}
                <div class="hub-modal" data-ventas-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-ventas aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog" role="dialog" aria-modal="true" aria-labelledby={`ventas-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <p class="hub-modal__title" id={`ventas-title-${r.id}`}>Se le vendió</p>
                      <button type="button" class="hub-modal__close" data-close-ventas aria-label="Cerrar">×</button>
                    </div>
                    <p class="hub-modal__hint">{nombre || r.slug}</p>
                    <ul class="hub-ventas" data-ventas-list>
                      {(ventasPorRestaurante.get(String(r.id)) || []).map((venta) => (
                        <li data-venta-id={venta.id} data-monto={venta.monto} data-moneda={venta.moneda}>
                          <span>{ventaProductoLabel(venta.producto)}</span>
                          <b>{formatVentaMonto(venta.monto, venta.moneda)}</b>
                          <button type="button" data-venta-remove aria-label={`Quitar ${ventaProductoLabel(venta.producto)}`}>Quitar</button>
                        </li>
                      ))}
                    </ul>
                    <p class="hub-ventas__empty" data-ventas-empty hidden={(ventasPorRestaurante.get(String(r.id)) || []).length > 0}>
                      Todavía no hay nada cargado.
                    </p>
                    <form class="hub-venta-form" data-ventas-form data-restaurante-id={r.id}>
                      <label>
                        <span>Producto</span>
                        <select name="producto" required>
                          <option value="">Elegir producto</option>
                          {VENTA_PRODUCTOS.map((item) => (
                            <option value={item.id}>{item.label}</option>
                          ))}
                        </select>
                      </label>
                      <label>
                        <span>Monto</span>
                        <input type="text" name="monto" inputmode="decimal" placeholder="0" required />
                      </label>
                      <label>
                        <span>Moneda</span>
                        <select name="moneda" required>
                          <option value="usd">USD</option>
                          <option value="bs">Bs</option>
                        </select>
                      </label>
                      <button type="submit" class="super-card-sheet__submit">Añadir</button>
                      <p class="hub-ventas__status" data-ventas-status role="status"></p>
                    </form>
                  </div>
                </div>

                {/* Credenciales */}
                <div class="hub-modal" data-creds-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-creds aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog hub-users-dialog" role="dialog" aria-modal="true" aria-labelledby={`creds-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <div class="hub-users-head">
                        <p class="hub-users-head__eyebrow">{nombre || r.slug}</p>
                        <p class="hub-modal__title" id={`creds-title-${r.id}`}>
                          Usuarios del local
                          <em class="hub-users-head__count" data-usuarios-count hidden></em>
                        </p>
                      </div>
                      <button type="button" class="hub-modal__close" data-close-creds aria-label="Cerrar">×</button>
                    </div>
                    <div class="hub-users" data-usuarios-list data-restaurante-id={r.id}>
                      <p class="hub-users__empty">Cargando usuarios…</p>
                    </div>
                    <form
                      class="hub-users-add"
                      data-operativo-form
                      data-restaurante-id={r.id}
                      data-restaurante-nombre={nombre}
                      data-has-access={tieneAcceso ? 'true' : 'false'}
                      novalidate
                    >
                      <p class="hub-users-add__title">Agregar usuario</p>
                      <div class="hub-role" role="radiogroup" aria-label="Rol">
                        <label class="hub-role__opt">
                          <input type="radio" name="rol" value="admin" checked />
                          <svg class="hub-role__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                          <strong>Admin del local</strong>
                          <small>Todo el Studio: menú, precios y perfil</small>
                        </label>
                        <label class="hub-role__opt" data-role-gerente>
                          <input type="radio" name="rol" value="gerente" />
                          <svg class="hub-role__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                          <strong>Gerente de sede</strong>
                          <small data-role-gerente-hint>Solo agota platos en su sede</small>
                        </label>
                      </div>
                      <label class="block" data-sede-field hidden>
                        <span>Sede</span>
