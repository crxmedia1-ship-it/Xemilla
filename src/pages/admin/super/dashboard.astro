      <div data-prop-pane="historial" hidden>
      {
        propuestas.length === 0 ? (
          <XemillaQuiet inset kicker="Historial" title="Todavía no hay propuestas." detail="Cuando crees una, el enlace queda en este historial." />
        ) : (
          <ul class="super-props__list">
            {propuestas.map((p) => {
              const href = `/propuesta?p=${p.id}`;
              const anio = formatPropuestaAnio(p.created_at);
              return (
                <li>
                  <article class="super-prop" data-propuesta-card={p.id}>
                    {p.logo_url ? <img src={p.logo_url} alt="" class="super-prop__logo" /> : null}
