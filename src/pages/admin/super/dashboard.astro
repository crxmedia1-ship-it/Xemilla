          <div class="super-prop-price__modes" role="radiogroup" aria-label="Logo de la propuesta">
            <label class="super-prop-price__mode">
              <input type="radio" name="logo_modo" value="con" checked data-prop-logo-mode />
              <span>Con logo</span>
