---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import AdminXemillaMark from '../../../components/admin/AdminXemillaMark.astro';
import AdminMetricsPanel from '../../../components/admin/AdminMetricsPanel.astro';
import AdminThemeSwitcher from '../../../components/admin/AdminThemeSwitcher.astro';
import { requireSuperAdmin, listAllRestaurantes, getSuperAdminWriteClient } from '../../../lib/superadmin.js';
import { createSupabaseServiceClient } from '../../../lib/supabase/service.js';
import { fetchMetricsSnapshot } from '../../../lib/metrics.js';

const gate = await requireSuperAdmin({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (!gate) {
  return Astro.redirect('/admin/login');
}

const restaurantes = await listAllRestaurantes(gate.supabase, gate.user);
const writeClient = getSuperAdminWriteClient(gate.supabase, gate.user);
const networkMetrics = await fetchMetricsSnapshot(writeClient, { days: 30 });

/** Operativo access = Auth metadata restaurante_id (not truthy restaurantes.user_id — that is often SuperAdmin). */
/** @type {import('@supabase/supabase-js').User[]} */
const authUsers = [];
const service = createSupabaseServiceClient();
if (service) {
  const perPage = 200;
  for (let page = 1; page <= 50; page += 1) {
    const { data: authPage, error: listErr } = await service.auth.admin.listUsers({
      page,
      perPage,
    });
    if (listErr) {
      console.error('[super/dashboard] listUsers:', listErr.message);
      break;
    }
    const batch = authPage?.users ?? [];
    authUsers.push(...batch);
    if (batch.length < perPage) break;
  }
}

const localesConAcceso = new Set(
  authUsers
    .flatMap((u) => [
      u.user_metadata?.restaurante_id,
      u.app_metadata?.restaurante_id,
      u.user_metadata?.restauranteId,
      u.app_metadata?.restauranteId,
    ])
    .filter(Boolean)
    .map(String),
);
---

<Layout
  title="SuperAdmin · Xemilla"
  theme="crx"
  themeColor="#09090b"
  description="Panel maestro de restaurantes Xemilla"
  adminPanel={true}
>
  <main class="mx-auto min-h-dvh w-full max-w-7xl px-6 pb-20 pt-10 lg:px-10">
    <header class="solid-obstacle flex flex-wrap items-end justify-between gap-6">
      <div class="admin-brand-lockup admin-brand-lockup--xemilla">
        <img
          src="https://res.cloudinary.com/dgphys1xd/image/upload/v1784310548/Photoroom_20260717_132348_xrnil8.png"
          alt="Xemilla"
          width="200"
          height="88"
          class="admin-xemilla-hero-logo"
          loading="eager"
          decoding="async"
        />
        <div>
          <p class="text-[0.62rem] font-semibold uppercase tracking-[0.32em] text-zinc-500">
            Súper Administrador
          </p>
          <h1 class="mt-2 font-blacksushi-display text-4xl font-semibold tracking-tight lg:text-5xl">
            Xemilla
          </h1>
          <p class="mt-2 text-sm text-zinc-400">
            {restaurantes.length} local{restaurantes.length === 1 ? '' : 'es'} en la red · vista escritorio
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <AdminThemeSwitcher />
        <a
          href="/admin/super/nuevo-restaurante"
          class="admin-action-btn inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 active:scale-95 hover:bg-zinc-100"
        >
          Nuevo restaurante
        </a>
        <form method="POST" action="/api/admin-logout">
          <button
            type="submit"
            class="rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-[0.58rem] font-semibold uppercase tracking-[0.18em] text-zinc-500 transition hover:border-white/20 hover:text-zinc-300"
          >
            Salir
          </button>
        </form>
      </div>
    </header>

    <nav
      class="mt-10 flex flex-wrap gap-2 border-b border-white/8 pb-4"
      role="tablist"
      aria-label="Secciones SuperAdmin"
    >
      <button
        type="button"
        role="tab"
        data-super-tab="locales"
        aria-selected="true"
        class="dashboard-tab inline-flex items-center rounded-xl border border-white/15 bg-white px-4 py-2.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-950 transition-all duration-200 ease-out"
      >
        Locales
      </button>
      <button
        type="button"
        role="tab"
        data-super-tab="metricas"
        aria-selected="false"
        class="dashboard-tab inline-flex items-center rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-400 transition-all duration-200 ease-out hover:border-white/20 hover:text-zinc-200"
      >
        Métricas
      </button>
    </nav>

    <div data-super-panel="locales" class="admin-fade-in-up">
      {
        restaurantes.length === 0 ? (
          <div class="glass-panel solid-obstacle mt-12 max-w-xl p-8 text-center">
            <p class="text-sm leading-relaxed text-zinc-400">
              Todavía no hay locales registrados. Creá el primero.
            </p>
          </div>
        ) : (
          <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {restaurantes.map((r) => {
              const tieneAcceso =
                localesConAcceso.has(String(r.id)) ||
                localesConAcceso.has(String(r.slug));
              const ctaLabel = tieneAcceso ? 'ACTUALIZAR CLAVE' : 'CREAR ACCESO';
              return (
              <li class="glass-panel solid-obstacle flex min-h-[11rem] flex-col justify-between gap-5 p-6 transition-all duration-300 ease-out transform will-change-transform hover:-translate-y-1 hover:scale-[1.01] hover:shadow-lg hover:border-white/20">
                <div class="space-y-1">
                  <div class="flex items-start justify-between gap-2">
                    <h2 class="font-blacksushi-display text-2xl font-semibold leading-tight tracking-tight text-white">
                      {r.nombre_comercial}
                    </h2>
                    {tieneAcceso ? (
                      <span
                        data-access-badge
                        class="shrink-0 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2 py-0.5 rounded-full font-medium tracking-wide"
                      >
                        🟢 Acceso Activo
                      </span>
                    ) : (
                      <span
                        data-access-badge
                        class="shrink-0 bg-zinc-800/50 text-zinc-500 border border-zinc-700/50 text-xs px-2 py-0.5 rounded-full font-medium tracking-wide"
                      >
                        ⚪ Sin Acceso
                      </span>
                    )}
                  </div>
                  <p class="font-mono text-[0.58rem] uppercase tracking-[0.14em] text-zinc-600">
                    /{r.slug}
                  </p>
                </div>

                <div class="mt-auto space-y-3">
                  <a
                    href={`/admin/dashboard?restaurante=${encodeURIComponent(r.id)}`}
                    class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl border border-white/12 bg-white/[0.08] px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white transition-all duration-200 hover:opacity-90 hover:border-white/25 hover:bg-white/[0.14] active:scale-95"
                  >
                    Gestionar Restaurante
                  </a>

                  <details class="group rounded-xl border border-white/8 bg-black/20 open:border-white/15">
                    <summary class="cursor-pointer list-none px-3 py-2.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:text-zinc-300 [&::-webkit-details-marker]:hidden">
                      <span class="inline-flex items-center gap-2">
                        Credenciales operativas
                        <span class="text-zinc-600 transition group-open:rotate-90" aria-hidden="true">›</span>
                      </span>
                    </summary>
                    <form
                      class="space-y-2.5 border-t border-white/8 px-3 pb-3 pt-3"
                      data-operativo-form
                      data-restaurante-id={r.id}
                      data-restaurante-nombre={r.nombre_comercial}
                      data-has-access={tieneAcceso ? 'true' : 'false'}
                      novalidate
                    >
                      <label class="block space-y-1">
                        <span class="text-[0.55rem] font-semibold uppercase tracking-[0.14em] text-zinc-600">
                          Email
                        </span>
                        <input
                          type="email"
                          name="email"
                          required
                          autocomplete="off"
                          placeholder="admin@local.com"
                          class="w-full rounded-lg border border-white/10 bg-zinc-950/80 px-2.5 py-2 text-xs text-white outline-none placeholder:text-zinc-600 focus:border-indigo-400"
                        />
                      </label>
                      <label class="block space-y-1">
                        <span class="text-[0.55rem] font-semibold uppercase tracking-[0.14em] text-zinc-600">
                          Contraseña
                        </span>
                        <input
                          type="password"
                          name="password"
                          required
                          minlength="8"
                          autocomplete="new-password"
                          placeholder="Mín. 8 caracteres"
                          class="w-full rounded-lg border border-white/10 bg-zinc-950/80 px-2.5 py-2 text-xs text-white outline-none placeholder:text-zinc-600 focus:border-indigo-400"
                        />
                      </label>
                      <p
                        class="hidden text-[0.7rem] leading-relaxed"
                        data-operativo-feedback
                        role="status"
                        aria-live="polite"
                      ></p>
                      <button
                        type="submit"
                        data-operativo-submit
                        class="inline-flex w-full items-center justify-center rounded-lg bg-white px-3 py-2 text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-zinc-950 transition hover:bg-zinc-100 disabled:opacity-50"
                      >
                        {ctaLabel}
                      </button>
                    </form>
                  </details>
                </div>
              </li>
              );
            })}
          </ul>
        )
      }
    </div>

    <div data-super-panel="metricas" class="mt-10" hidden>
      <AdminMetricsPanel
        metrics={networkMetrics}
        network={true}
        title="Métricas de la red"
        subtitle="Agregado de alertas de mesa en todos los locales · últimos 30 días"
      />
    </div>

    <AdminXemillaMark />
  </main>
</Layout>

<script>
  function initSuperTabs() {
    const tabs = document.querySelectorAll('[data-super-tab]');
    const panels = document.querySelectorAll('[data-super-panel]');
    if (!tabs.length) return;

    /**
     * @param {string} id
     */
    function setTab(id) {
      tabs.forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        const on = btn.dataset.superTab === id;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const on = panel.dataset.superPanel === id;
        panel.hidden = !on;
        if (on) {
          panel.classList.remove('admin-fade-in-up');
          void panel.offsetWidth;
          panel.classList.add('admin-fade-in-up');
        }
      });
    }

    tabs.forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => setTab(btn.dataset.superTab || 'locales'));
    });
  }

  const ACCESS_ACTIVE_CLASSES =
    'shrink-0 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2 py-0.5 rounded-full font-medium tracking-wide';
  const DEFAULT_CTA = 'CREAR ACCESO';
  const ACTIVE_CTA = 'ACTUALIZAR CLAVE';

  /**
   * @param {HTMLFormElement} form
   */
  function markAccessActive(form) {
    form.dataset.hasAccess = 'true';
    const card = form.closest('li');
    const badge = card?.querySelector('[data-access-badge]');
    if (badge instanceof HTMLElement) {
      badge.className = ACCESS_ACTIVE_CLASSES;
      badge.textContent = '🟢 Acceso Activo';
    }
  }

  function initOperativoForms() {
    document.querySelectorAll('[data-operativo-form]').forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const restauranteId = form.dataset.restauranteId || '';
        const feedback = form.querySelector('[data-operativo-feedback]');
        const submitBtn = form.querySelector('button[type="submit"]');
        const emailInput = form.querySelector('input[name="email"]');
        const passwordInput = form.querySelector('input[name="password"]');

        if (!(feedback instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) {
          return;
        }

        const email =
          emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
        const password =
          passwordInput instanceof HTMLInputElement ? passwordInput.value : '';

        const idleLabel =
          form.dataset.hasAccess === 'true' ? ACTIVE_CTA : DEFAULT_CTA;

        feedback.classList.add('hidden');
        feedback.textContent = '';
        feedback.classList.remove('text-rose-400', 'text-emerald-400');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando...';

        try {
          const res = await fetch('/api/create-admin-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              email,
              password,
              restaurante_id: restauranteId,
            }),
          });
          /** @type {{ ok?: boolean, error?: string, email?: string, reused?: boolean }} */
          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data.ok) {
            feedback.textContent = data.error || 'No se pudo crear el usuario.';
            feedback.classList.add('text-rose-400');
            feedback.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.textContent = idleLabel;
            return;
          }

          feedback.textContent = data.reused
            ? `Actualizado: ${data.email || email} (Admin Operativo).`
            : `Creado: ${data.email || email} (Admin Operativo).`;
          feedback.classList.add('text-emerald-400');
          feedback.classList.remove('hidden');
          submitBtn.textContent = '¡Credenciales Listas!';
          if (passwordInput instanceof HTMLInputElement) passwordInput.value = '';
          markAccessActive(form);
          submitBtn.disabled = false;
          window.setTimeout(() => {
            if (submitBtn.textContent === '¡Credenciales Listas!') {
              submitBtn.textContent = ACTIVE_CTA;
            }
          }, 2500);
        } catch (err) {
          feedback.textContent =
            err instanceof Error ? err.message : 'Error de red al crear credenciales.';
          feedback.classList.add('text-rose-400');
          feedback.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = idleLabel;
        }
      });
    });
  }

  function initSuperHub() {
    initSuperTabs();
    initOperativoForms();
  }

  initSuperHub();
  document.addEventListener('astro:page-load', initSuperHub);
</script>
