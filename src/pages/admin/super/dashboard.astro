---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import {
  requireSuperAdmin,
  listAllRestaurantes,
  getSuperAdminWriteClient,
  createRestauranteAsSuperAdmin,
} from '../../../lib/superadmin.js';
import { createSupabaseServiceClient } from '../../../lib/supabase/service.js';
import { fetchNetworkIntelligence } from '../../../lib/metrics.js';
import { resolveHubCoverUrl, resolveHubLogoBg } from '../../../lib/hub-media.js';
import { cloudinaryTrimUrl } from '../../../lib/plato-media-url.js';

const gate = await requireSuperAdmin({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (!gate) {
  return Astro.redirect('/admin/login');
}

/** Prefill / error for modal "Nuevo Restaurante" */
let createErrorMsg = '';
const createPrefill = {
  nombre: '',
  slug: '',
  whatsapp: '',
  logoUrl: '',
  hubCoverUrl: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'create-restaurante') {
    createPrefill.nombre = String(form.get('nombre_comercial') ?? '');
    createPrefill.slug = String(form.get('slug') ?? '');
    createPrefill.whatsapp = String(
      form.get('whatsapp_num') ?? form.get('whatsapp_url') ?? '',
    );
    createPrefill.logoUrl = String(form.get('logo_url') ?? '');
    createPrefill.hubCoverUrl = String(
      form.get('hub_cover_url') ?? form.get('portada_url') ?? '',
    );

    const result = await createRestauranteAsSuperAdmin(gate.supabase, gate.user, {
      userId: gate.user.id,
      nombreComercial: createPrefill.nombre,
      slug: createPrefill.slug,
      whatsapp: createPrefill.whatsapp,
      logoUrl: createPrefill.logoUrl,
      hubCoverUrl: createPrefill.hubCoverUrl,
    });

    if (result.error) {
      createErrorMsg = result.error;
    } else if (result.restaurante) {
      return Astro.redirect('/admin/super/dashboard');
    }
  }
}

const openNuevoRestModal = Boolean(createErrorMsg);
const logoTrimPrefill = createPrefill.logoUrl
  ? cloudinaryTrimUrl(createPrefill.logoUrl)
  : '';

const restaurantes = await listAllRestaurantes(gate.supabase, gate.user);
const writeClient = getSuperAdminWriteClient(gate.supabase, gate.user);

/** Operativo access = Auth metadata restaurante_id (not truthy restaurantes.user_id — that is often SuperAdmin). */
/** @type {import('@supabase/supabase-js').User[]} */
const authUsers = [];
const service = createSupabaseServiceClient();
if (service) {
  const perPage = 200;
  for (let page = 1; page <= 50; page += 1) {
    const { data: authPage, error: listErr } = await service.auth.admin.listUsers({
      page,
      perPage,
    });
    if (listErr) {
      console.error('[super/dashboard] listUsers:', listErr.message);
      break;
    }
    const batch = authPage?.users ?? [];
    authUsers.push(...batch);
    if (batch.length < perPage) break;
  }
}

const localesConAcceso = new Set(
  authUsers
    .flatMap((u) => [u.app_metadata?.restaurante_id, u.app_metadata?.restauranteId])
    .filter(Boolean)
    .map(String),
);

const networkIntel = await fetchNetworkIntelligence(writeClient, {
  days: 30,
  restaurantes,
  localesConAcceso,
});

const networkLocalesActivos = networkIntel.localesOperativos;

/** @param {number} n */
function formatKpi(n) {
  return (Number(n) || 0).toLocaleString('es-VE');
}

/** @param {number | null | undefined} n */
function formatTasa(n) {
  if (n == null || !Number.isFinite(n)) return '';
  return `${n}%`;
}

/** @param {string | null | undefined} name */
function initialsFromName(name) {
  return String(name || '')
    .trim()
    .slice(0, 2)
    .toUpperCase() || '—';
}

const emptyCellClass = 'super-net-empty text-zinc-300 dark:text-zinc-700 font-mono text-xs';

const kpiCardClass =
  'super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 rounded-3xl p-6 shadow-[0_8px_30px_rgba(0,0,0,0.03)] dark:shadow-none transition-all flex flex-col justify-between min-h-[150px]';
const kpiLabelClass =
  'text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500';
const kpiValueClass =
  'super-net-kpi-value text-4xl lg:text-5xl font-extralight font-mono text-zinc-900 dark:text-white tracking-tight my-2';
const kpiHintClass =
  'text-[11px] text-zinc-500 font-medium flex items-center gap-1.5';
const studioBtnClass =
  'super-net-btn-studio px-3 py-1.5 text-xs font-medium rounded-xl transition-colors shadow-xs bg-zinc-900 text-white hover:bg-zinc-800 dark:bg-zinc-800 dark:text-zinc-100';
const webappBtnClass =
  'super-net-btn-web px-3 py-1.5 text-xs font-medium rounded-xl border border-zinc-200/80 dark:border-zinc-800 transition-colors bg-zinc-100 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-900 dark:text-zinc-300';

const topPlatosMax = Math.max(1, ...networkIntel.topPlatos.map((p) => p.vistas), 0);
const rankingLocalesMax = Math.max(1, ...networkIntel.rankingLocales.map((x) => x.visitas), 0);
const rankingMenorMax = Math.max(
  1,
  ...(networkIntel.rankingMenor || []).map((x) => x.visitas),
  0,
);

const MONTHS_ES = [
  'Enero',
  'Febrero',
  'Marzo',
  'Abril',
  'Mayo',
  'Junio',
  'Julio',
  'Agosto',
  'Septiembre',
  'Octubre',
  'Noviembre',
  'Diciembre',
];

/**
 * Meses desde el primer restaurante hasta Septiembre 2026 (mes en curso del Hub).
 * @param {string | null | undefined} createdAtRaw
 */
function buildNetworkMonthOptions(createdAtRaw) {
  const end = new Date(2026, 8, 1); // Septiembre 2026
  const now = new Date();
  const endClamped =
    now < end ? new Date(now.getFullYear(), now.getMonth(), 1) : end;
  let start = endClamped;
  if (createdAtRaw) {
    const parsed = new Date(createdAtRaw);
    if (!Number.isNaN(parsed.getTime())) {
      start = new Date(parsed.getFullYear(), parsed.getMonth(), 1);
    }
  }
  if (start > endClamped) start = endClamped;

  /** @type {Array<{ value: string, label: string }>} */
  const options = [];
  const cursor = new Date(start.getTime());
  while (cursor <= endClamped) {
    options.push({
      value: `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, '0')}`,
      label: `${MONTHS_ES[cursor.getMonth()]} ${cursor.getFullYear()}`,
    });
    cursor.setMonth(cursor.getMonth() + 1);
  }
  return options;
}

const networkMonthOptions = buildNetworkMonthOptions(networkIntel.firstRestaurantAt);
const networkSeriesPayload = networkIntel.series || {
  eventMode: false,
  currentMonth: '',
  all: { total: 0, byRest: {}, topPlatoByRest: {}, topPlatos: [], rankingMayor: [], rankingMenor: [] },
  months: {},
};

const tfOnClass =
  'super-tf-on px-3 py-1.5 rounded-xl font-semibold bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-xs';
const tfOffClass =
  'px-3 py-1.5 rounded-xl font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors';

const xemillaWordmark =
  'https://res.cloudinary.com/wdmzaemi/image/upload/v1789022797/Photoroom_20260810_004814.png';

/**
 * @param {string | null | undefined} url
 * @param {string | null | undefined} num
 */
function resolveWaHref(url, num) {
  const raw = String(url || num || '').trim();
  if (!raw) return '';
  if (/^https?:\/\//i.test(raw)) return raw;
  const digits = raw.replace(/\D/g, '');
  return digits ? `https://wa.me/${digits}` : '';
}

/**
 * Portada del Hub — columna hub_cover_url o ui_estilo.hub.cover_url.
 * @param {Record<string, unknown>} r
 */
function resolveCoverUrl(r) {
  return resolveHubCoverUrl(r);
}

/**
 * @param {Record<string, unknown>} r
 */
function resolveLogoUrl(r) {
  const v = String(r?.logo_url || '').trim();
  return v && /^https?:\/\//i.test(v) ? v : '';
}

/**
 * Color de placa del logo.
 * @param {Record<string, unknown>} r
 */
function resolveLogoPlateBg(r) {
  return resolveHubLogoBg(r);
}

/**
 * @param {Record<string, unknown>} r
 */
function resolvePhone(r) {
  return String(r?.whatsapp_url || r?.whatsapp_num || '').trim();
}

/**
 * @param {string} direccion
 * @param {string} coordenadas
 */
function resolveMapsHref(direccion, coordenadas) {
  const coords = String(coordenadas || '').trim();
  if (coords && /^https?:\/\//i.test(coords) && !/maps\.google\.com\/?$/i.test(coords)) {
    return coords;
  }
  const q = String(direccion || '').trim();
  return q
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`
    : '';
}

/**
 * @param {string} direccion
 */
function resolveMapsEmbed(direccion) {
  const q = String(direccion || '').trim();
  if (!q) return '';
  return `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=15&output=embed`;
}
---

<Layout
  title="SuperAdmin · Xemilla"
  theme="crx"
  themeColor="#050505"
  description="Panel maestro de restaurantes Xemilla"
  adminPanel={true}
>
  <main class="super-admin-dash w-full min-w-full px-4 sm:px-8 lg:px-12 py-6 pb-20 min-h-dvh">
    <!-- Hero Until layout + glassmorphism (sin foto de fondo) -->
    <section class="super-until-hero solid-obstacle" aria-label="Súper Administrador">
      <header class="super-until-hero__nav">
        <a href="/admin/super/dashboard" class="super-until-hero__brand" aria-label="Xemilla">
          <img
            src={xemillaWordmark}
            alt="xemilla"
            width="160"
            height="48"
            class="super-until-hero__brand-img"
            loading="eager"
            decoding="async"
          />
        </a>

        <nav
          class="super-until-hero__links"
          role="tablist"
          aria-label="Secciones SuperAdmin"
        >
          <button
            type="button"
            role="tab"
            data-super-tab="locales"
            aria-selected="true"
            class="super-until-hero__link"
          >
            Locales
          </button>
          <button
            type="button"
            role="tab"
            data-super-tab="metricas"
            aria-selected="false"
            class="super-until-hero__link"
          >
            Métricas
          </button>
        </nav>

        <div class="super-until-hero__actions">
          <button
            type="button"
            class="super-until-hero__cta"
            data-nuevo-rest-open
            aria-haspopup="dialog"
            aria-controls="nuevo-rest-modal"
          >
            <span class="super-until-hero__cta-icon" aria-hidden="true">+</span>
            Nuevo restaurante
          </button>
          <form method="POST" action="/api/admin-logout" class="super-until-hero__logout">
            <button type="submit" class="super-until-hero__logout-btn">Salir</button>
          </form>
        </div>
      </header>

      <div class="super-until-hero__copy">
        <p class="super-until-hero__eyebrow">Súper Administrador</p>
        <p class="super-until-hero__sub">
          {restaurantes.length} local{restaurantes.length === 1 ? '' : 'es'} en la red
          · {networkLocalesActivos} con acceso activo
        </p>
      </div>
    </section>

    <div data-super-panel="locales" class="admin-fade-in-up">
      {
        restaurantes.length === 0 ? (
          <div class="glass-panel solid-obstacle mt-12 max-w-xl p-8 text-center">
            <p class="text-sm leading-relaxed text-zinc-400">
              Todavía no hay locales registrados. Creá el primero.
            </p>
            <button
              type="button"
              class="super-until-hero__cta mt-5 inline-flex"
              data-nuevo-rest-open
              aria-haspopup="dialog"
              aria-controls="nuevo-rest-modal"
            >
              <span class="super-until-hero__cta-icon" aria-hidden="true">+</span>
              Nuevo restaurante
            </button>
          </div>
        ) : (
          <>
            <div class="super-hub-search solid-obstacle">
              <label class="sr-only" for="super-hub-search-input">
                Buscar restaurante por nombre
              </label>
              <span class="super-hub-search__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.2-3.2"></path>
                </svg>
              </span>
              <input
                id="super-hub-search-input"
                type="search"
                class="super-hub-search__input"
                placeholder="Buscar por nombre…"
                autocomplete="off"
                spellcheck="false"
                data-hub-search
              />
              <button
                type="button"
                class="super-hub-search__clear"
                data-hub-search-clear
                hidden
                aria-label="Limpiar búsqueda"
              >
                ×
              </button>
              <p class="super-hub-search__count" data-hub-search-count aria-live="polite">
                {restaurantes.length} local{restaurantes.length === 1 ? '' : 'es'}
              </p>
            </div>

            <p class="super-hub-search__empty" data-hub-search-empty hidden>
              No hay locales con ese nombre.
            </p>

            <ul
              class="super-visual-grid mt-7 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5 gap-6 w-full"
              data-hub-grid
            >
            {restaurantes.map((r) => {
              const tieneAcceso =
                localesConAcceso.has(String(r.id)) ||
                localesConAcceso.has(String(r.slug));
              const ctaLabel = tieneAcceso ? 'ACTUALIZAR CLAVE' : 'CREAR ACCESO';
              const coverUrl = resolveCoverUrl(r);
              const logoUrl = resolveLogoUrl(r);
              const logoPlateBg = resolveLogoPlateBg(r);
              const phone = resolvePhone(r);
              const waHref = resolveWaHref(r.whatsapp_url, r.whatsapp_num);
              const nombre = String(r.nombre_comercial || '').trim();
              const direccion = String(r.direccion || '').trim();
              const coordenadas = String(r.coordenadas_maps || '').trim();
              const mapsHref = resolveMapsHref(direccion, coordenadas);
              const mapsEmbed = resolveMapsEmbed(direccion);
              const studioHref = `/admin/dashboard?restaurante=${encodeURIComponent(r.id)}`;
              const searchKey = `${nombre} ${r.slug || ''}`.toLowerCase();
              return (
              <li
                class:list={[
                  'super-hub-card group solid-obstacle',
                  r.activo === false && 'super-hub-card--paused',
                ]}
                data-restaurante-id={r.id}
                data-hub-name={searchKey}
                data-hub-slug={String(r.slug || '')}
                data-hub-activo={r.activo === false ? 'false' : 'true'}
              >
                <div class="super-hub-card__media">
                  {/* Cover 100% */}
                  <div class="absolute inset-0 z-0 overflow-hidden bg-black" data-card-cover-zone>
                    {coverUrl ? (
                      <img
                        src={coverUrl}
                        alt=""
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                        loading="lazy"
                        decoding="async"
                        data-card-cover-img
                      />
                    ) : (
                      <div class="h-full w-full bg-black" aria-hidden="true" data-card-cover-empty></div>
                    )}
                    <div
                      class="pointer-events-none absolute inset-x-0 bottom-0 h-[42%] bg-gradient-to-t from-black/45 via-black/10 to-transparent"
                      aria-hidden="true"
                    ></div>
                  </div>

                  {/* Logo — placa con color derivado del cover */}
                  <div
                    class="super-hub-card__logo-glass"
                    data-card-logo-zone
                    data-logo-plate-bg={logoPlateBg}
                    style={`--hub-logo-plate: ${logoPlateBg}; background: ${logoPlateBg};`}
                  >
                    {logoUrl ? (
                      <img
                        src={logoUrl}
                        alt={nombre || r.slug}
                        class="super-hub-card__logo-img"
                        loading="lazy"
                        decoding="async"
                        data-card-logo-img
                      />
                    ) : (
                      <span class="super-hub-card__logo-empty" data-card-logo-empty>Logo</span>
                    )}
                  </div>

                  <div class="absolute left-3 top-3 z-20 flex flex-col gap-1.5">
                    {r.activo === false ? (
                      <span
                        data-estado-badge
                        class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-black/55 px-2.5 py-1 text-[0.62rem] font-medium tracking-wide text-amber-300 backdrop-blur-md"
                      >
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-400" aria-hidden="true"></span>
                        Desactivado
                      </span>
                    ) : null}
                    {tieneAcceso ? (
                      <span
                        data-access-badge
                        class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/25 bg-black/55 px-2.5 py-1 text-[0.62rem] font-medium tracking-wide text-emerald-300 backdrop-blur-md"
                      >
                        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></span>
                        Acceso Activo
                      </span>
                    ) : (
                      <span
                        data-access-badge
                        class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-black/55 px-2.5 py-1 text-[0.62rem] font-medium tracking-wide text-zinc-400 backdrop-blur-md"
                      >
                        <span class="h-1.5 w-1.5 rounded-full bg-zinc-500" aria-hidden="true"></span>
                        Sin Acceso
                      </span>
                    )}
                  </div>

                  <details class="absolute right-3 top-3 z-30" data-card-menu>
                    <summary
                      class="cursor-pointer list-none [&::-webkit-details-marker]:hidden"
                      aria-label={`Menú de ${nombre || r.slug}`}
                    >
                      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                        <circle cx="4" cy="8" r="1.35" fill="currentColor" />
                        <circle cx="8" cy="8" r="1.35" fill="currentColor" />
                        <circle cx="12" cy="8" r="1.35" fill="currentColor" />
                      </svg>
                    </summary>
                    <div class="super-card-menu flex flex-col" data-card-menu-panel role="menu">
                      <a href={studioHref} class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Entrar al Studio</span>
                          <span class="super-card-menu__hint">Abrir panel del local</span>
                        </span>
                      </a>
                      <button type="button" data-open-ficha class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 16-4.5-4.5L9 19"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Editar ficha</span>
                          <span class="super-card-menu__hint">Cover, logo y datos</span>
                        </span>
                      </button>
                      <button type="button" data-open-info class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 10v6"/><path d="M12 7h.01"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Info del restaurante</span>
                          <span class="super-card-menu__hint">Contacto, ubicación y mapa</span>
                        </span>
                      </button>
                      <button type="button" data-open-creds class="super-card-menu__item" role="menuitem">
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Credenciales</span>
                          <span class="super-card-menu__hint">Acceso operativo</span>
                        </span>
                      </button>
                      <div class="super-card-menu__divider" aria-hidden="true"></div>
                      <a
                        href={`/${r.slug}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="super-card-menu__item"
                        role="menuitem"
                      >
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Ver WebApp</span>
                          <span class="super-card-menu__hint">/{r.slug}</span>
                        </span>
                      </a>
                      <div class="super-card-menu__divider" aria-hidden="true"></div>
                      <button
                        type="button"
                        data-toggle-activo
                        data-activo={r.activo === false ? 'false' : 'true'}
                        class="super-card-menu__item"
                        role="menuitem"
                      >
                        <span class="super-card-menu__icon" aria-hidden="true">
                          {r.activo === false ? (
                            <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                          ) : (
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 12h6"/></svg>
                          )}
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label" data-toggle-activo-label>
                            {r.activo === false ? 'Reactivar local' : 'Desactivar local'}
                          </span>
                          <span class="super-card-menu__hint" data-toggle-activo-hint>
                            {r.activo === false
                              ? 'Volver a publicar la WebApp'
                              : 'Pausar sin borrar (impago)'}
                          </span>
                        </span>
                      </button>
                      <button
                        type="button"
                        data-delete-restaurante
                        class="super-card-menu__item super-card-menu__item--danger"
                        role="menuitem"
                      >
                        <span class="super-card-menu__icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M7 7l1 12a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-12"/><path d="M10 11v6M14 11v6"/></svg>
                        </span>
                        <span class="super-card-menu__copy">
                          <span class="super-card-menu__label">Eliminar permanentemente</span>
                          <span class="super-card-menu__hint">Borra menú y datos · irreversible</span>
                        </span>
                      </button>
                    </div>
                  </details>

                  <div class="pointer-events-none absolute inset-0 z-[12] flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover:pointer-events-auto group-hover:opacity-100">
                    <a
                      href={studioHref}
                      class="rounded-full border border-white/25 bg-white/12 px-5 py-2 text-sm font-medium text-white shadow-lg backdrop-blur-md transition hover:bg-white/20"
                    >
                      Entrar al Studio
                    </a>
                  </div>
                </div>

                {/* Editar ficha — modal centrado */}
                <div class="hub-modal" data-ficha-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-ficha aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog hub-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby={`ficha-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <p class="hub-modal__title" id={`ficha-title-${r.id}`}>Editar ficha Hub</p>
                      <button type="button" class="hub-modal__close" data-close-ficha aria-label="Cerrar">×</button>
                    </div>
                    <p class="hub-modal__hint">
                      Cover a pantalla completa · logo PNG sin fondo: la placa toma un color del cover automáticamente.
                    </p>
                    <form class="space-y-3.5" data-ficha-form data-restaurante-id={r.id} data-slug={r.slug || ''} novalidate>
                      <div class="hub-ficha-preview">
                        <div>
                          <div class="hub-ficha-slot hub-ficha-slot--cover" data-ficha-cover-preview>
                            <span class="hub-ficha-slot__badge">Cover 100%</span>
                            {coverUrl ? (
                              <img src={coverUrl} alt="" data-ficha-cover-img />
                            ) : (
                              <span class="hub-ficha-slot__empty" data-ficha-cover-empty>Sin cover</span>
                            )}
                          </div>
                          <div class="hub-ficha-slot__actions">
                            <span>Foto cover</span>
                            <label class="hub-ficha-file">
                              Cambiar / recortar
                              <input type="file" accept="image/*" data-ficha-cover-file />
                            </label>
                          </div>
                          <input type="hidden" name="hub_cover_url" value={coverUrl} data-ficha-cover-url />
                        </div>

                        <div>
                          <div
                            class="hub-ficha-slot hub-ficha-slot--logo"
                            data-ficha-logo-preview
                            style={`--hub-logo-plate: ${logoPlateBg};`}
                          >
                            <span class="hub-ficha-slot__badge">Logo · rectángulo</span>
                            {logoUrl ? (
                              <img
                                src={logoUrl}
                                alt=""
                                data-ficha-logo-img
                                class="mx-auto max-h-16 w-auto object-contain"
                              />
                            ) : (
                              <span class="hub-ficha-slot__empty" data-ficha-logo-empty>Sin logo</span>
                            )}
                          </div>
                          <div class="hub-ficha-slot__actions">
                            <span>Logo PNG</span>
                            <label class="hub-ficha-file">
                              Cambiar / recortar
                              <input type="file" accept="image/*" data-ficha-logo-file />
                            </label>
                          </div>
                          <input type="hidden" name="logo_url" value={logoUrl} data-ficha-logo-url />
                          <input type="hidden" name="hub_logo_bg" value={logoPlateBg} data-ficha-logo-bg />
                        </div>
                      </div>

                      <label class="block">
                        <span>Nombre</span>
                        <input type="text" name="nombre_comercial" required value={nombre} />
                      </label>
                      <label class="block">
                        <span>Teléfono / WhatsApp</span>
                        <input type="text" name="whatsapp_num" value={phone} placeholder="58414…" />
                      </label>
                      <p class="hidden text-[0.75rem] leading-relaxed" data-ficha-feedback role="status"></p>
                      <button type="submit" class="super-card-sheet__submit">Guardar ficha</button>
                    </form>
                  </div>
                </div>

                {/* Info del restaurante */}
                <div class="hub-modal" data-info-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-info aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog hub-modal__dialog--wide" role="dialog" aria-modal="true" aria-labelledby={`info-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <p class="hub-modal__title" id={`info-title-${r.id}`}>Info del restaurante</p>
                      <button type="button" class="hub-modal__close" data-close-info aria-label="Cerrar">×</button>
                    </div>
                    <p class="hub-modal__hint">{nombre || r.slug}</p>
                    <div class="hub-modal__section">
                      <span class="hub-modal__section-label">Contacto</span>
                      {phone ? (
                        <div>
                          <p class="hub-modal__section-value">{phone}</p>
                          {waHref ? (
                            <a href={waHref} target="_blank" rel="noopener noreferrer" class="hub-modal__link">
                              Abrir WhatsApp
                            </a>
                          ) : null}
                        </div>
                      ) : (
                        <p class="hub-modal__section-value hub-modal__section-value--muted">Sin número cargado</p>
                      )}
                    </div>
                    <div class="hub-modal__section">
                      <span class="hub-modal__section-label">Ubicación</span>
                      {direccion ? (
                        <p class="hub-modal__section-value">{direccion}</p>
                      ) : (
                        <p class="hub-modal__section-value hub-modal__section-value--muted">Sin dirección cargada</p>
                      )}
                      {mapsHref ? (
                        <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="hub-modal__link">
                          Abrir en Google Maps
                        </a>
                      ) : null}
                    </div>
                    {mapsEmbed ? (
                      <div class="hub-modal__section" style="padding:0.55rem;">
                        <span class="hub-modal__section-label" style="padding:0.35rem 0.4rem 0;">Mapa</span>
                        <iframe
                          class="hub-modal__map"
                          src={mapsEmbed}
                          loading="lazy"
                          referrerpolicy="no-referrer-when-downgrade"
                          title={`Mapa de ${nombre || r.slug}`}
                        ></iframe>
                      </div>
                    ) : null}
                  </div>
                </div>

                {/* Credenciales */}
                <div class="hub-modal" data-creds-panel data-restaurante-host={r.id} hidden>
                  <button type="button" class="hub-modal__backdrop" data-close-creds aria-label="Cerrar"></button>
                  <div class="hub-modal__dialog" role="dialog" aria-modal="true" aria-labelledby={`creds-title-${r.id}`}>
                    <div class="hub-modal__header">
                      <p class="hub-modal__title" id={`creds-title-${r.id}`}>Credenciales operativas</p>
                      <button type="button" class="hub-modal__close" data-close-creds aria-label="Cerrar">×</button>
                    </div>
                    <p class="hub-modal__hint">Acceso del equipo al Studio de {nombre || r.slug}.</p>
                    <form
                      class="space-y-3"
                      data-operativo-form
                      data-restaurante-id={r.id}
                      data-restaurante-nombre={nombre}
                      data-has-access={tieneAcceso ? 'true' : 'false'}
                      novalidate
                    >
                      <label class="block">
                        <span>Email</span>
                        <input type="email" name="email" required autocomplete="off" placeholder="admin@local.com" />
                      </label>
                      <label class="block">
                        <span>Contraseña</span>
                        <input
                          type="password"
                          name="password"
                          required
                          minlength="8"
                          autocomplete="new-password"
                          placeholder="Mín. 8 caracteres"
                        />
                      </label>
                      <p class="hidden text-[0.75rem] leading-relaxed" data-operativo-feedback role="status" aria-live="polite"></p>
                      <button type="submit" data-operativo-submit class="super-card-sheet__submit">{ctaLabel}</button>
                    </form>
                  </div>
                </div>
              </li>
              );
            })}
          </ul>
          </>
        )
      }
    </div>

    <div
      data-super-panel="metricas"
      class="super-net mt-8 w-full min-w-full space-y-8"
      hidden
      data-network-series={JSON.stringify(networkSeriesPayload)}
    >
      <header class="w-full flex flex-wrap items-end justify-between gap-4">
        <div class="min-w-0">
          <p class="text-[0.68rem] font-medium uppercase tracking-[0.22em] text-zinc-500">
            Network Intelligence
          </p>
          <h2 class="mt-1 text-2xl font-light tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-3xl">
            Métricas de la red
          </h2>
          <p class="mt-1.5 max-w-2xl text-sm text-zinc-500">
            Tráfico, catálogo y rendimiento agregado
          </p>
        </div>
        <div
          class="super-tf-bar inline-flex p-1 bg-zinc-100 dark:bg-zinc-900 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-xs"
          data-super-timeframe-bar
          role="group"
          aria-label="Periodo de métricas de red"
        >
          <button type="button" class={tfOnClass} data-super-timeframe="all" aria-pressed="true">
            General
          </button>
          <button type="button" class={tfOffClass} data-super-timeframe="current" aria-pressed="false">
            Este Mes
          </button>
          <select
            class="bg-transparent text-zinc-500 font-medium px-2 py-1 outline-none cursor-pointer hover:text-zinc-900 dark:hover:text-white"
            data-super-timeframe-select
            aria-label="Mes a mes"
          >
            <option value="" selected>Mes a mes</option>
            {
              networkMonthOptions.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))
            }
          </select>
        </div>
      </header>

      <!-- A) KPIs maestros -->
      <section
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full"
        aria-label="KPIs maestros de red"
      >
        <article class={kpiCardClass}>
          <p class={kpiLabelClass}>Vistas Totales WebApps</p>
          <p class={kpiValueClass} data-net-kpi="vistas-webapps">
            {formatKpi(networkIntel.vistasWebApps ?? networkIntel.traficoGlobal)}
          </p>
          <p class={kpiHintClass}>
            <span class="h-1 w-1 rounded-full bg-zinc-400 dark:bg-zinc-500" aria-hidden="true"></span>
            Vistas globales en WebApps
          </p>
        </article>

        <article class={kpiCardClass}>
          <p class={kpiLabelClass}>Locales Operativos</p>
          <p class={kpiValueClass}>
            {formatKpi(networkIntel.localesOperativos)}
            <span class="text-2xl text-zinc-400 dark:text-zinc-500">
              / {formatKpi(networkIntel.localesTotal)}
            </span>
          </p>
          <p class={kpiHintClass}>
            <span class="h-1 w-1 rounded-full bg-emerald-500/70" aria-hidden="true"></span>
            Con credenciales activas
          </p>
        </article>

        <article class={kpiCardClass}>
          <p class={kpiLabelClass}>Catálogo Global</p>
          <p class={kpiValueClass}>{formatKpi(networkIntel.catalogoGlobal)}</p>
          <p class={kpiHintClass}>
            <span class="h-1 w-1 rounded-full bg-zinc-400 dark:bg-zinc-500" aria-hidden="true"></span>
            Platos activos en Supabase
          </p>
        </article>

        <article class={kpiCardClass}>
          <p class={kpiLabelClass}>Conversión de Red</p>
          <p class={kpiValueClass}>{formatKpi(networkIntel.conversionRed)}</p>
          <p class={kpiHintClass}>
            <span class="h-1 w-1 rounded-full bg-zinc-400 dark:bg-zinc-500" aria-hidden="true"></span>
            Clics WhatsApp + Maps
          </p>
        </article>
      </section>

      <!-- B) Tabla rendimiento por restaurante -->
      <section class="w-full overflow-x-auto" aria-label="Rendimiento por restaurante">
        <div class="super-net-card w-full rounded-3xl bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.03)] dark:shadow-none">
          <div class="bg-zinc-50/80 dark:bg-zinc-900/80 border-b border-zinc-200/80 dark:border-zinc-800 text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 py-3.5 px-6 flex items-center justify-between gap-4">
            <span>Rendimiento por restaurante</span>
            <span class="normal-case tracking-normal font-medium text-zinc-500" data-net-visits-hint>
              Visitas · periodo seleccionado
            </span>
          </div>
          <table class="w-full min-w-[64rem] border-collapse text-left text-sm">
            <thead>
              <tr class="bg-zinc-50/80 dark:bg-zinc-900/80 border-b border-zinc-200/80 dark:border-zinc-800 text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                <th class="py-3.5 px-6 font-bold text-left">Restaurante</th>
                <th class="py-3.5 px-6 font-bold text-left">Slug</th>
                <th class="py-3.5 px-6 font-bold text-left tabular-nums" data-net-visits-col>
                  Visitas
                </th>
                <th class="py-3.5 px-6 font-bold text-left">Plato Más Visto</th>
                <th class="py-3.5 px-6 font-bold text-left">Tasa Clics WhatsApp</th>
                <th class="py-3.5 px-6 font-bold text-left">Estado Acceso</th>
                <th class="py-3.5 px-6 font-bold text-right">Acciones</th>
              </tr>
            </thead>
            <tbody data-net-table-body>
              {
                networkIntel.porLocal.length === 0 ? (
                  <tr>
                    <td colspan="7" class="py-10 px-6 text-center text-zinc-500">
                      No hay locales en la red.
                    </td>
                  </tr>
                ) : (
                  networkIntel.porLocal.map((row) => {
                    const studioHref = `/admin/dashboard?restaurante=${encodeURIComponent(row.id)}`;
                    const webHref = row.slug ? `/${row.slug}` : '';
                    const logoTrim = row.logoUrl ? cloudinaryTrimUrl(row.logoUrl) : '';
                    const tasa = formatTasa(row.tasaWhatsapp);
                    const platoTop =
                      row.platoMasVisto && row.platoMasVisto !== '—' ? row.platoMasVisto : '';
                    return (
                      <tr
                        class="border-b border-zinc-100 dark:border-zinc-800/60 last:border-0 hover:bg-zinc-50/70 dark:hover:bg-zinc-900/40 transition-colors"
                        data-net-row={row.id}
                      >
                        <td class="py-4 px-6 text-left">
                          <div class="flex items-center gap-3">
                            {logoTrim ? (
                              <img
                                src={logoTrim}
                                alt={row.nombre}
                                class="w-8 h-8 rounded-lg object-contain bg-zinc-50 dark:bg-zinc-950 p-1 border border-zinc-200 dark:border-zinc-800 shrink-0"
                                loading="lazy"
                                decoding="async"
                              />
                            ) : (
                              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-xs font-mono font-bold text-zinc-500 dark:text-zinc-300 shrink-0">
                                {initialsFromName(row.nombre)}
                              </div>
                            )}
                            <span class="text-sm font-semibold text-zinc-900 dark:text-white">{row.nombre}</span>
                          </div>
                        </td>
                        <td class="py-4 px-6 text-left">
                          {row.slug ? (
                            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">/{row.slug}</span>
                          ) : (
                            <span class={emptyCellClass}>—</span>
                          )}
                        </td>
                        <td
                          class="py-4 px-6 text-left font-mono tabular-nums text-zinc-800 dark:text-zinc-200"
                          data-net-visitas
                        >
                          {formatKpi(row.visitas30d)}
                        </td>
                        <td class="py-4 px-6 text-left" data-net-plato-top>
                          {platoTop ? (
                            <span class="text-zinc-700 dark:text-zinc-300">{platoTop}</span>
                          ) : (
                            <span class={emptyCellClass}>—</span>
                          )}
                        </td>
                        <td class="py-4 px-6 text-left">
                          {tasa ? (
                            <span class="font-mono tabular-nums text-zinc-700 dark:text-zinc-300">{tasa}</span>
                          ) : (
                            <span class={emptyCellClass}>—</span>
                          )}
                        </td>
                        <td class="py-4 px-6 text-left">
                          {row.tieneAcceso ? (
                            <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 px-2.5 py-1 rounded-full text-xs font-mono">
                              <span
                                class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500 dark:bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]"
                                aria-hidden="true"
                              />
                              Activo
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1.5 bg-zinc-100 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700/50 px-2.5 py-1 rounded-full text-xs font-mono">
                              <span class="h-1.5 w-1.5 rounded-full bg-zinc-400 dark:bg-zinc-500" aria-hidden="true" />
                              Sin acceso
                            </span>
                          )}
                        </td>
                        <td class="py-4 px-6">
                          <div class="flex items-center justify-end gap-2">
                            <a href={studioHref} class={studioBtnClass}>
                              Studio ↗
                            </a>
                            {webHref ? (
                              <a
                                href={webHref}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={webappBtnClass}
                              >
                                WebApp ↗
                              </a>
                            ) : (
                              <span class={`${webappBtnClass} opacity-40 pointer-events-none`}>
                                WebApp ↗
                              </span>
                            )}
                          </div>
                        </td>
                      </tr>
                    );
                  })
                )
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- C) Top platos + ranking mayor/menor -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full" aria-label="Rankings de red">
        <article class="super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 rounded-3xl p-6 shadow-[0_8px_30px_rgba(0,0,0,0.03)] dark:shadow-none flex flex-col">
          <header class="text-sm font-semibold text-zinc-900 dark:text-white tracking-wide mb-4 flex items-center justify-between gap-3">
            <span>Top 5 Platos Más Consultados en Toda la Red</span>
            <span class="text-[11px] font-medium uppercase tracking-wider text-zinc-500 shrink-0" data-net-period-label>
              General
            </span>
          </header>
          <ol class="flex flex-col divide-y divide-zinc-100 dark:divide-zinc-800/50" data-net-top-platos>
            {
              networkIntel.topPlatos.length === 0 ? (
                <li class="rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-800/80 px-4 py-6 text-center text-sm text-zinc-500" data-net-empty>
                  Sin vistas registradas en el periodo.
                </li>
              ) : (
                networkIntel.topPlatos.map((plato, i) => {
                  const pct = Math.round((plato.vistas / topPlatosMax) * 100);
                  return (
                      <li class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0" data-net-plato-row>
                        <div class="flex items-center gap-3">
                          <span class="w-8 shrink-0 font-mono text-xs text-zinc-400 dark:text-zinc-500" data-net-rank>
                            #{String(i + 1).padStart(2, '0')}
                          </span>
                          <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-zinc-900 dark:text-white" data-net-name>{plato.nombre}</p>
                            <p class="truncate text-[11px] text-zinc-500" data-net-rest>{plato.restaurante}</p>
                          </div>
                          <span class="shrink-0 font-mono text-sm tabular-nums text-zinc-700 dark:text-zinc-300" data-net-count>
                            {formatKpi(plato.vistas)}
                          </span>
                        </div>
                        <div class="ml-11 h-1 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800/80">
                          <div
                            class="h-full rounded-full bg-zinc-400/80 dark:bg-zinc-500/60"
                            data-net-bar
                            style={`width: ${pct}%`}
                          />
                        </div>
                      </li>
                  );
                })
              )
            }
          </ol>
        </article>

        <article class="super-net-card bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 rounded-3xl p-6 shadow-[0_8px_30px_rgba(0,0,0,0.03)] dark:shadow-none flex flex-col gap-6">
          <div>
            <header class="text-sm font-semibold text-zinc-900 dark:text-white tracking-wide mb-4 flex items-center justify-between gap-3">
              <span>Mayor tráfico</span>
              <span class="text-[11px] font-medium uppercase tracking-wider text-zinc-500 shrink-0">
                Ranking
              </span>
            </header>
            <ol class="flex flex-col divide-y divide-zinc-100 dark:divide-zinc-800/50" data-net-rank-mayor>
              {
                networkIntel.rankingLocales.length === 0 ? (
                  <li class="rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-800/80 px-4 py-6 text-center text-sm text-zinc-500">
                    Sin locales para ranking.
                  </li>
                ) : (
                  networkIntel.rankingLocales.map((local, i) => {
                    const pct = Math.round((local.visitas / rankingLocalesMax) * 100);
                    const logoTrim = local.logoUrl ? cloudinaryTrimUrl(local.logoUrl) : '';
                    return (
                        <li class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0" data-net-local-row>
                          <div class="flex items-center gap-3">
                            <span class="w-8 shrink-0 font-mono text-xs text-zinc-400 dark:text-zinc-500" data-net-rank>
                              #{String(i + 1).padStart(2, '0')}
                            </span>
                            {logoTrim ? (
                              <img
                                src={logoTrim}
                                alt={local.nombre}
                                class="w-8 h-8 rounded-lg object-contain bg-zinc-50 dark:bg-zinc-950 p-1 border border-zinc-200 dark:border-zinc-800 shrink-0"
                                loading="lazy"
                                decoding="async"
                                data-net-logo
                              />
                            ) : (
                              <div
                                class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-xs font-mono font-bold text-zinc-500 dark:text-zinc-300 shrink-0"
                                data-net-initials
                              >
                                {initialsFromName(local.nombre)}
                              </div>
                            )}
                            <div class="min-w-0 flex-1">
                              <p class="truncate text-sm font-medium text-zinc-900 dark:text-white" data-net-name>{local.nombre}</p>
                              <p class="truncate font-mono text-[11px] text-zinc-500" data-net-slug>
                                {local.slug ? `/${local.slug}` : '—'}
                              </p>
                            </div>
                            <span class="shrink-0 font-mono text-sm tabular-nums text-zinc-700 dark:text-zinc-300" data-net-count>
                              {formatKpi(local.visitas)}
                            </span>
                          </div>
                          <div class="ml-11 h-1 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800/80">
                            <div
                              class="h-full rounded-full bg-zinc-400/80 dark:bg-zinc-500/60"
                              data-net-bar
                              style={`width: ${pct}%`}
                            />
                          </div>
                        </li>
                    );
                  })
                )
              }
            </ol>
          </div>

          <div class="border-t border-zinc-100 dark:border-zinc-800/50 pt-5">
            <header class="text-sm font-semibold text-zinc-900 dark:text-white tracking-wide mb-4 flex items-center justify-between gap-3">
              <span>Menor tráfico</span>
              <span class="text-[11px] font-medium uppercase tracking-wider text-zinc-500 shrink-0">
                Ranking
              </span>
            </header>
            <ol class="flex flex-col divide-y divide-zinc-100 dark:divide-zinc-800/50" data-net-rank-menor>
              {
                (networkIntel.rankingMenor || []).length === 0 ? (
                  <li class="rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-800/80 px-4 py-6 text-center text-sm text-zinc-500">
                    Sin locales para ranking.
                  </li>
                ) : (
                  (networkIntel.rankingMenor || []).map((local, i) => {
                    const pct = Math.round((local.visitas / rankingMenorMax) * 100);
                    const logoTrim = local.logoUrl ? cloudinaryTrimUrl(local.logoUrl) : '';
                    return (
                        <li class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0" data-net-local-row>
                          <div class="flex items-center gap-3">
                            <span class="w-8 shrink-0 font-mono text-xs text-zinc-400 dark:text-zinc-500" data-net-rank>
                              #{String(i + 1).padStart(2, '0')}
                            </span>
                            {logoTrim ? (
                              <img
                                src={logoTrim}
                                alt={local.nombre}
                                class="w-8 h-8 rounded-lg object-contain bg-zinc-50 dark:bg-zinc-950 p-1 border border-zinc-200 dark:border-zinc-800 shrink-0"
                                loading="lazy"
                                decoding="async"
                                data-net-logo
                              />
                            ) : (
                              <div
                                class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-xs font-mono font-bold text-zinc-500 dark:text-zinc-300 shrink-0"
                                data-net-initials
                              >
                                {initialsFromName(local.nombre)}
                              </div>
                            )}
                            <div class="min-w-0 flex-1">
                              <p class="truncate text-sm font-medium text-zinc-900 dark:text-white" data-net-name>{local.nombre}</p>
                              <p class="truncate font-mono text-[11px] text-zinc-500" data-net-slug>
                                {local.slug ? `/${local.slug}` : '—'}
                              </p>
                            </div>
                            <span class="shrink-0 font-mono text-sm tabular-nums text-zinc-700 dark:text-zinc-300" data-net-count>
                              {formatKpi(local.visitas)}
                            </span>
                          </div>
                          <div class="ml-11 h-1 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800/80">
                            <div
                              class="h-full rounded-full bg-zinc-400/80 dark:bg-zinc-500/60"
                              data-net-bar
                              style={`width: ${pct}%`}
                            />
                          </div>
                        </li>
                    );
                  })
                )
              }
            </ol>
          </div>
        </article>
      </section>
    </div>

    <!-- Modal: Nuevo Restaurante -->
    <div
      id="nuevo-rest-modal"
      class="nuevo-rest-modal fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 transition-all"
      role="dialog"
      aria-modal="true"
      aria-labelledby="nuevo-rest-title"
      hidden={!openNuevoRestModal}
      data-nuevo-rest-overlay
      data-open-on-load={openNuevoRestModal ? 'true' : 'false'}
    >
      <div
        class="nuevo-rest-modal__card w-full max-w-xl rounded-3xl p-6 sm:p-8 bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 shadow-2xl flex flex-col gap-4"
        data-nuevo-rest-card
      >
        <header class="flex flex-col gap-1">
          <div class="flex items-center justify-between gap-3">
            <h2
              id="nuevo-rest-title"
              class="nuevo-rest-modal__title text-xl font-medium text-zinc-900 dark:text-white"
            >
              Nuevo Restaurante
            </h2>
            <button
              type="button"
              class="nuevo-rest-modal__close text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 p-1 rounded-lg text-lg leading-none"
              data-nuevo-rest-close
              aria-label="Cerrar"
            >
              ✕
            </button>
          </div>
          <p class="text-xs text-zinc-400 dark:text-zinc-500">
            Alta rápida en la red Xemilla
          </p>
        </header>

        <form method="POST" id="nuevo-rest-form" class="flex flex-col gap-5" novalidate>
          <input type="hidden" name="intent" value="create-restaurante" />

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="nombre_comercial" class="sr-only">Nombre comercial</label>
              <input
                id="nombre_comercial"
                name="nombre_comercial"
                type="text"
                required
                autocomplete="organization"
                placeholder="Nombre comercial"
                value={createPrefill.nombre}
                class="nuevo-rest-field bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:border-zinc-400 outline-none w-full"
              />
            </div>
            <div>
              <label for="slug" class="sr-only">Slug</label>
              <input
                id="slug"
                name="slug"
                type="text"
                required
                pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                placeholder="slug-publico"
                value={createPrefill.slug}
                class="nuevo-rest-field bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm font-mono text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:border-zinc-400 outline-none w-full"
              />
            </div>

            <div class="col-span-2">
              <label for="whatsapp_num" class="sr-only">WhatsApp</label>
              <input
                id="whatsapp_num"
                name="whatsapp_num"
                type="tel"
                required
                inputmode="tel"
                autocomplete="tel"
                placeholder="+58 414..."
                value={createPrefill.whatsapp}
                class="nuevo-rest-field bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:border-zinc-400 outline-none w-full"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <button
                type="button"
                class="relative h-28 w-full rounded-2xl border-2 border-dashed border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col items-center justify-center p-2 cursor-pointer hover:border-zinc-400 transition-colors text-center text-xs text-zinc-500 overflow-hidden"
                data-upload-trigger="logo"
                aria-label="Subir logo"
              >
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center gap-0.5 p-2"
                  data-upload-placeholder="logo"
                  hidden={Boolean(logoTrimPrefill)}
                >
                  <span class="font-medium">Logo</span>
                  <span class="text-[10px] text-zinc-400">PNG · clic</span>
                </div>
                <div class="absolute inset-0" data-upload-preview="logo" hidden={!logoTrimPrefill}>
                  <img
                    src={logoTrimPrefill || undefined}
                    alt="Logo"
                    class="h-full w-full object-contain p-2"
                    data-upload-img="logo"
                    hidden={!logoTrimPrefill}
                  />
                </div>
                <span
                  class="pointer-events-none absolute inset-0 hidden items-center justify-center bg-zinc-950/50 text-[11px] font-medium text-white backdrop-blur-[2px]"
                  data-upload-loading="logo"
                >
                  Cargando...
                </span>
              </button>
              <input type="file" id="input-logo-file" accept="image/*" class="hidden" />
              <input type="hidden" id="logo_url" name="logo_url" value={createPrefill.logoUrl} />
              <p
                class="mt-1 min-h-[1rem] text-[10px] text-zinc-400"
                role="status"
                data-upload-status="logo"
              ></p>
            </div>

            <div>
              <button
                type="button"
                class="relative h-28 w-full rounded-2xl border-2 border-dashed border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col items-center justify-center p-2 cursor-pointer hover:border-zinc-400 transition-colors text-center text-xs text-zinc-500 overflow-hidden"
                data-upload-trigger="portada"
                aria-label="Subir portada Hub"
              >
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center gap-0.5 p-2"
                  data-upload-placeholder="portada"
                  hidden={Boolean(createPrefill.hubCoverUrl)}
                >
                  <span class="font-medium">Portada Hub</span>
                  <span class="text-[10px] text-zinc-400">JPG · clic</span>
                </div>
                <div
                  class="absolute inset-0"
                  data-upload-preview="portada"
                  hidden={!createPrefill.hubCoverUrl}
                >
                  <img
                    src={createPrefill.hubCoverUrl || undefined}
                    alt="Portada"
                    class="h-full w-full object-cover"
                    data-upload-img="portada"
                    hidden={!createPrefill.hubCoverUrl}
                  />
                </div>
                <span
                  class="pointer-events-none absolute inset-0 hidden items-center justify-center bg-zinc-950/50 text-[11px] font-medium text-white backdrop-blur-[2px]"
                  data-upload-loading="portada"
                >
                  Cargando...
                </span>
              </button>
              <input type="file" id="input-portada-file" accept="image/*" class="hidden" />
              <input
                type="hidden"
                id="hub_cover_url"
                name="hub_cover_url"
                value={createPrefill.hubCoverUrl}
                data-portada-hidden
              />
              <input
                type="hidden"
                name="portada_url"
                value={createPrefill.hubCoverUrl}
                data-portada-alias
              />
              <p
                class="mt-1 min-h-[1rem] text-[10px] text-zinc-400"
                role="status"
                data-upload-status="portada"
              ></p>
            </div>
          </div>

          {
            createErrorMsg && (
              <p
                class="rounded-xl border border-rose-500/25 bg-rose-500/10 px-3.5 py-2.5 text-xs leading-relaxed text-rose-600 dark:text-rose-400"
                role="alert"
              >
                {createErrorMsg}
              </p>
            )
          }

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-zinc-100 dark:border-zinc-900">
            <button
              type="button"
              class="text-xs text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 px-4 py-2"
              data-nuevo-rest-close
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="create-submit"
              class="nuevo-rest-submit px-5 py-2.5 rounded-xl font-medium text-xs bg-zinc-900 text-white hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200 transition-all shadow-sm disabled:cursor-wait disabled:opacity-60"
            >
              Crear
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

