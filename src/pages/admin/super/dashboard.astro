            {cartasDemo.map((carta) => (
              <option value={carta.slug}>{carta.nombre}</option>
            ))}
          </select>
        </label>

        <fieldset class="super-prop-form__wide super-prop-price">
          <div class="super-prop-addon-list">
            {PROPUESTA_ADICIONALES.map((item) => {
              const amount = addonDefaults[item.id] || '';
              const iaMensual = item.id === 'ia' ? readPropuestaIaMensual(addonDefaults) : '';
              const iaConPrecios = item.id === 'ia' && (Boolean(amount) || Boolean(iaMensual));
              const arConPaquetes = item.id === 'ar' && (Boolean(amount) || propuestaTienePaquetes(addonDefaults));
              const qrConPiezas = item.id === 'qr' && (Boolean(amount) || Object.keys(readPropuestaPiezas(addonDefaults)).length > 0);
              return (
                <div class="super-prop-addon" data-addon-row data-addon-packages={item.id === 'ar' ? '' : undefined} data-packs-on={arConPaquetes ? '' : undefined} data-addon-pieces={item.id === 'qr' ? '' : undefined} data-detail-on={qrConPiezas ? '' : undefined} data-addon-ia={item.id === 'ia' ? '' : undefined} data-ia-on={iaConPrecios ? '' : undefined}>
                  <p class="super-prop-addon__name">{item.label}</p>
                  <div class="super-prop-addon__controls">
                    {item.id === 'ia' ? null : (
                      <label class="super-prop-factura">
                        <input type="checkbox" data-adicional-factura={item.id} checked={Boolean(amount)} />
                        <span class="super-prop-factura__ui" aria-hidden="true"></span>
                        <span>Factura</span>
                      </label>
                    )}
                    <select class="super-prop-select" data-adicional-mode aria-label={`Precio de ${item.label}`}>
                      <option value="" selected={!arConPaquetes && !qrConPiezas && !iaConPrecios && !amount}>A consultar</option>
                      <option value="precio" selected={arConPaquetes || qrConPiezas || iaConPrecios || Boolean(amount)}>Con precio</option>
                    </select>
                    <span class="super-prop-money" data-adicional-money hidden={!amount}>
                      <input type="number" data-adicional={item.id} min="0" step="1" inputmode="numeric" placeholder="0" value={amount} disabled={!amount} />
                      <em>$</em>
                    </span>
                  </div>
                  {item.id === 'ar' ? (
                    <div class="super-prop-pieces super-prop-packages" data-prop-packs>
                      {arPaqueteRows(addonDefaults).map((pack, index) => (
                        <div class:list={['super-prop-addon', 'super-prop-addon--piece', index === 0 && 'is-on']} data-addon-row data-prop-pack>
                          <p class="super-prop-addon__name" data-prop-pack-name>{pack.label}</p>
                          <div class="super-prop-pack-qty">
                            <span>Platos</span>
                            <button type="button" data-prop-pack-qty-step="-1" aria-label="Menos platos">−</button>
                            <input type="number" data-paquete-platos={pack.id} min="1" max="40" step="1" inputmode="numeric" value={pack.platos} aria-label={`Platos de ${pack.label}`} />
                            <button type="button" data-prop-pack-qty-step="1" aria-label="Más platos">+</button>
                          </div>
                          <div class="super-prop-addon__controls">
                            <label class="super-prop-factura">
                              <input type="checkbox" data-adicional-factura={pack.id} checked={pack.on} />
                              <span class="super-prop-factura__ui" aria-hidden="true"></span>
                              <span>Factura</span>
                            </label>
                            <select class="super-prop-select" data-adicional-mode aria-label={`Precio de ${pack.label}`}>
                              <option value="precio" selected>Con precio</option>
                            </select>
                            <span class="super-prop-money" data-adicional-money>
                              <span>Precio</span>
                              <input type="number" data-paquete={pack.id} min="0" step="1" inputmode="numeric" placeholder="0" value={pack.amount} />
                              <em>$</em>
                            </span>
                          </div>
                        </div>
                      ))}
                      <button type="button" class="super-prop-pack-add" data-prop-pack-add>Añadir otro</button>
                    </div>
                  ) : null}
                  {item.id === 'qr' ? (
                    <div class="super-prop-pieces">
                      {qrPiezaRows(addonDefaults, false).map((piece) => (
                        <div class="super-prop-addon super-prop-addon--piece" data-addon-row data-piece-row>
                          <p class="super-prop-addon__name">{piece.label}</p>
                          <div class="super-prop-addon__controls">
                            <select class="super-prop-select" data-adicional-mode aria-label={`Precio de ${piece.label}`}>
                              <option value="precio" selected>Con precio</option>
                            </select>
                            <span class="super-prop-money" data-adicional-money>
                              <input type="number" data-pieza={piece.id} min="0" step="1" inputmode="numeric" placeholder="A consultar" value={piece.amount} />
                            </span>
                            <label class="super-prop-factura" title="Si lo marcas, entra en la factura. Si no, lo ven y lo añaden.">
                              <input type="checkbox" data-adicional-factura={piece.id} checked={piece.on} aria-label={`Incluir ${piece.label} en la factura`} />
                              <span class="super-prop-factura__ui" aria-hidden="true"></span>
                              <span>Factura</span>
                            </label>
                          </div>
                        </div>
                      ))}
                      <p class="super-prop-pieces__hint">Márcalo para que entre en la factura. Si no, lo ven y lo añaden ellos.</p>
                    </div>
                  ) : null}
                  {item.id === 'ia' ? (
                    <div class="super-prop-ia">
                      <label class="super-prop-ia__row">
                        <span>Instalación</span>
                        <span class="super-prop-money">
                          <input type="number" data-ia-instalacion min="0" step="1" inputmode="numeric" placeholder="0" value={amount} aria-label="Precio de instalación de Klientiq" />
                          <em>$</em>
                        </span>
                      </label>
                      <label class="super-prop-ia__row">
                        <span>Mensual</span>
                        <span class="super-prop-money">
                          <input type="number" data-ia-mensual min="0" step="1" inputmode="numeric" placeholder="0" value={iaMensual} aria-label="Mantenimiento mensual de Klientiq" />
                          <em>$</em>
                        </span>
                      </label>
                      <label class="super-prop-factura" title="Si lo marcas, entra en la factura. Si no, lo ven y lo añaden.">
                        <input type="checkbox" data-adicional-factura="ia" checked={iaConPrecios} aria-label="Incluir Klientiq en la factura" />
                        <span class="super-prop-factura__ui" aria-hidden="true"></span>
                        <span>Factura</span>
                      </label>
                    </div>
                  ) : null}
                </div>
              );
            })}
          </div>
        </fieldset>

        <input type="hidden" name="mundo" value="estudio" />
        <div class="super-prop-form__actions" data-prop-actions hidden>
          <div class="prop-slide" data-prop-slide>
            <span class="prop-slide__sheen" aria-hidden="true"></span>
            <span class="prop-slide__label">Crear propuesta</span>
            <button type="button" class="prop-slide__knob" data-prop-slide-knob aria-label="Desliza para crear la propuesta">
              <svg class="prop-slide__glyph prop-slide__glyph--go" viewBox="0 0 16 16" aria-hidden="true">
