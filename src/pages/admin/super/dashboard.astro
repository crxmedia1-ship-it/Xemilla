          </ul>
        )
      }
    </div>

    <!-- Modal: Nuevo Restaurante -->
    <div
      id="nuevo-rest-modal"
      class="nuevo-rest-modal fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 transition-all"
      role="dialog"
      aria-modal="true"
      aria-labelledby="nuevo-rest-title"
      hidden={!openNuevoRestModal}
      data-nuevo-rest-overlay
      data-open-on-load={openNuevoRestModal ? 'true' : 'false'}
    >
      <div
        class="nuevo-rest-modal__card w-full max-w-xl rounded-3xl p-6 sm:p-8 bg-white dark:bg-zinc-950 border border-zinc-200/90 dark:border-zinc-800/80 shadow-2xl flex flex-col gap-4"
        data-nuevo-rest-card
      >
        <header class="flex flex-col gap-1">
          <div class="flex items-center justify-between gap-3">
            <h2
              id="nuevo-rest-title"
              class="nuevo-rest-modal__title text-xl font-medium text-zinc-900 dark:text-white"
            >
              Nuevo Restaurante
            </h2>
            <button
              type="button"
              class="nuevo-rest-modal__close text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 p-1 rounded-lg text-lg leading-none"
              data-nuevo-rest-close
              aria-label="Cerrar"
            >
              ✕
            </button>
          </div>
          <p class="text-xs text-zinc-400 dark:text-zinc-500">
            Alta rápida en la red Xemilla
          </p>
        </header>

        <form method="POST" id="nuevo-rest-form" class="flex flex-col gap-5" novalidate>
          <input type="hidden" name="intent" value="create-restaurante" />

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="nombre_comercial" class="sr-only">Nombre comercial</label>
              <input
                id="nombre_comercial"
                name="nombre_comercial"
                type="text"
                required
                autocomplete="organization"
                placeholder="Nombre comercial"
                value={createPrefill.nombre}
                class="nuevo-rest-field bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:border-zinc-400 outline-none w-full"
              />
            </div>
            <div>
              <label for="slug" class="sr-only">Slug</label>
              <input
                id="slug"
                name="slug"
                type="text"
                required
                pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                placeholder="slug-publico"
                value={createPrefill.slug}
                class="nuevo-rest-field bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm font-mono text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:border-zinc-400 outline-none w-full"
              />
            </div>

            <div class="col-span-2">
              <label for="whatsapp_num" class="sr-only">WhatsApp</label>
              <input
                id="whatsapp_num"
                name="whatsapp_num"
                type="tel"
                required
                inputmode="tel"
                autocomplete="tel"
                placeholder="+58 414..."
                value={createPrefill.whatsapp}
                class="nuevo-rest-field bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:border-zinc-400 outline-none w-full"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <button
                type="button"
                class="relative h-28 w-full rounded-2xl border-2 border-dashed border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col items-center justify-center p-2 cursor-pointer hover:border-zinc-400 transition-colors text-center text-xs text-zinc-500 overflow-hidden"
                data-upload-trigger="logo"
                aria-label="Subir logo"
              >
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center gap-0.5 p-2"
                  data-upload-placeholder="logo"
                  hidden={Boolean(logoTrimPrefill)}
                >
                  <span class="font-medium">Logo</span>
                  <span class="text-[10px] text-zinc-400">PNG · clic</span>
                </div>
                <div class="absolute inset-0" data-upload-preview="logo" hidden={!logoTrimPrefill}>
                  <img
                    src={logoTrimPrefill || undefined}
                    alt="Logo"
                    class="h-full w-full object-contain p-2"
                    data-upload-img="logo"
                    hidden={!logoTrimPrefill}
                  />
                </div>
                <span
                  class="pointer-events-none absolute inset-0 hidden items-center justify-center bg-zinc-950/50 text-[11px] font-medium text-white backdrop-blur-[2px]"
                  data-upload-loading="logo"
                >
                  Cargando...
                </span>
              </button>
              <input type="file" id="input-logo-file" accept="image/*" class="hidden" />
              <input type="hidden" id="logo_url" name="logo_url" value={createPrefill.logoUrl} />
              <p
                class="mt-1 min-h-[1rem] text-[10px] text-zinc-400"
                role="status"
                data-upload-status="logo"
              ></p>
            </div>

            <div>
              <button
                type="button"
                class="relative h-28 w-full rounded-2xl border-2 border-dashed border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col items-center justify-center p-2 cursor-pointer hover:border-zinc-400 transition-colors text-center text-xs text-zinc-500 overflow-hidden"
                data-upload-trigger="portada"
                aria-label="Subir portada Hub"
              >
                <div
                  class="absolute inset-0 flex flex-col items-center justify-center gap-0.5 p-2"
                  data-upload-placeholder="portada"
                  hidden={Boolean(createPrefill.hubCoverUrl)}
                >
                  <span class="font-medium">Portada Hub</span>
                  <span class="text-[10px] text-zinc-400">JPG · clic</span>
                </div>
                <div
                  class="absolute inset-0"
                  data-upload-preview="portada"
                  hidden={!createPrefill.hubCoverUrl}
                >
                  <img
                    src={createPrefill.hubCoverUrl || undefined}
                    alt="Portada"
                    class="h-full w-full object-cover"
                    data-upload-img="portada"
                    hidden={!createPrefill.hubCoverUrl}
                  />
                </div>
                <span
                  class="pointer-events-none absolute inset-0 hidden items-center justify-center bg-zinc-950/50 text-[11px] font-medium text-white backdrop-blur-[2px]"
                  data-upload-loading="portada"
                >
                  Cargando...
                </span>
              </button>
              <input type="file" id="input-portada-file" accept="image/*" class="hidden" />
              <input
                type="hidden"
                id="hub_cover_url"
                name="hub_cover_url"
                value={createPrefill.hubCoverUrl}
                data-portada-hidden
              />
              <input
                type="hidden"
                name="portada_url"
                value={createPrefill.hubCoverUrl}
                data-portada-alias
              />
              <p
                class="mt-1 min-h-[1rem] text-[10px] text-zinc-400"
                role="status"
                data-upload-status="portada"
              ></p>
            </div>
          </div>

          {
            createErrorMsg && (
              <p
                class="rounded-xl border border-rose-500/25 bg-rose-500/10 px-3.5 py-2.5 text-xs leading-relaxed text-rose-600 dark:text-rose-400"
                role="alert"
              >
                {createErrorMsg}
              </p>
            )
          }

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-zinc-100 dark:border-zinc-900">
            <button
              type="button"
              class="text-xs text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 px-4 py-2"
              data-nuevo-rest-close
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="create-submit"
              class="nuevo-rest-submit px-5 py-2.5 rounded-xl font-medium text-xs bg-zinc-900 text-white hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200 transition-all shadow-sm disabled:cursor-wait disabled:opacity-60"
            >
              Crear
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <ImageCropHost />
</Layout>

