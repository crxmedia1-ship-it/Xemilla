                            <p class={labelClass}>Productos destacados</p>
                            <p class="text-[11px] leading-relaxed text-zinc-500">
                              Activa solo lo que quieras mostrar en el modal público. Precio en moneda local.
                            </p>
                            {
                              marca.boutique_productos.map((prod, idx) => (
                                <div class="rounded-xl border border-white/8 bg-black/30 p-3 space-y-2.5" data-boutique-row>
                                  <div class="flex items-center justify-between gap-3">
                                    <label class="flex items-center gap-2 text-xs text-zinc-300">
                                      <input type="checkbox" data-boutique-activo checked={prod.activo} class="size-3.5 rounded border-white/20 bg-black/40 text-emerald-500 focus:ring-emerald-500/40" />
                                      <span class="font-medium tracking-tight">Visible</span>
                                    </label>
                                    <input type="hidden" data-boutique-id value={prod.id} />
                                    <span class="text-[0.5rem] font-semibold uppercase tracking-[0.16em] text-zinc-600">#{idx + 1}</span>
                                  </div>
                                  <div class="grid gap-2 sm:grid-cols-2">
                                    <input type="text" data-boutique-nombre value={prod.nombre} placeholder="Nombre" class={fieldClass} />
                                    <input type="number" data-boutique-precio value={prod.precio} min="0" step="0.01" inputmode="decimal" placeholder="Precio" class={fieldClass} />
                                  </div>
                                  <input type="url" data-boutique-imagen value={prod.imagen_url || ''} placeholder="URL imagen (opcional)" class={fieldClass} />
                                </div>
                              ))
                            }
                          </div>
                        </div>
                      </article>

                      {/* ── Ficha nutricional ── full-width */}
                      <article
                        class:list={['gadget-card relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-white/[0.025] transition-all duration-300 sm:col-span-2', marca.gadget_nutricion && 'gadget-card--on']}
