  }

  /* Catálogo de gadgets (Lego modules) */
  .gadget-card.is-active,
  .gadget-card.gadget-card--on {
    opacity: 1;
    border-color: color-mix(in srgb, var(--gadget-accent, #9f1239) 45%, transparent);
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--gadget-accent, #9f1239) 14%, transparent),
        rgba(0, 0, 0, 0.28) 55%
      );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--gadget-accent, #9f1239) 22%, transparent),
      0 0 0 1px color-mix(in srgb, var(--gadget-accent, #9f1239) 18%, transparent);
  }

  .gadget-card.is-active .gadget-card__icon,
  .gadget-card.gadget-card--on .gadget-card__icon {
    border-color: color-mix(in srgb, var(--gadget-accent, #9f1239) 40%, transparent);
