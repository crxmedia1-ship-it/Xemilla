                  <label class="nut-chip">
                    <input type="checkbox" value={opt.id} data-nut-alergeno class="sr-only" />
                    {opt.label}
                  </label>
                ))}
              </div>
            </div>
            <p id="nutricion-modal-error" class="hidden text-xs text-rose-400" role="alert"></p>
            <button
              type="button"
              id="nutricion-modal-save"
              class="admin-action-btn nut-save-btn"
            >
              Guardar nutrición
            </button>
          </div>
        </div>
      </div>

  {/* Modal nombre (móvil: misma UX que descripción) */}
  <div
    id="nombre-modal"
    class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nombre-modal-title"
    data-open="false"
    aria-hidden="true"
  >
    <div data-modal-card class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}>
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <div class="min-w-0">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.2em] text-zinc-500">
            Nombre
          </p>
          <h3 id="nombre-modal-title" class="mt-1 font-blacksushi-display text-xl font-semibold">
            Editar plato
          </h3>
        </div>
        <button
          type="button"
          id="nombre-modal-close"
          class="rounded-lg px-3 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:bg-white/5 hover:text-white"
        >
          Cerrar
        </button>
      </div>
      <div class="space-y-4 px-5 py-5">
        <label for="nombre-modal-text" class="sr-only">Nombre del plato</label>
        <input
          id="nombre-modal-text"
          type="text"
          maxlength="120"
          placeholder="Nombre del plato…"
          class="w-full rounded-2xl border border-white/10 bg-black/40 px-4 py-3.5 text-base font-semibold tracking-tight text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
        />
        <p id="nombre-modal-error" class="hidden text-xs text-rose-400" role="alert"></p>
        <button
          type="button"
          id="nombre-modal-save"
          class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95"
        >
          Guardar
        </button>
      </div>
    </div>
  </div>

  {/* Modal Nuevo Plato — exclusivo SuperAdmin (no render en admin de restaurante) */}
  {
    isSuperAdmin && (
      <div
        id="nuevo-plato-modal"
        class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
        role="dialog"
        aria-modal="true"
        aria-labelledby="nuevo-plato-title"
        data-open="false"
        aria-hidden="true"
      >
    <div
      data-modal-card
      class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}
    >
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <div class="min-w-0">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-zinc-500">
            SuperAdmin
          </p>
          <h3 id="nuevo-plato-title" class="mt-1 font-blacksushi-display text-xl font-semibold">
            Nuevo plato
          </h3>
        </div>
        <button
          type="button"
          id="nuevo-plato-close"
          class="rounded-lg px-3 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:bg-white/5 hover:text-white"
        >
          Cerrar
        </button>
      </div>

      <form id="nuevo-plato-form" class="space-y-4 px-5 py-5">
        <div>
          <label for="np-categoria" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Categoría
          </label>
          <input
            id="np-categoria"
            name="categoria"
            list="np-categorias-list"
            autocomplete="off"
            placeholder="Ej. Entradas"
            class="w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
          />
          <datalist id="np-categorias-list"></datalist>
        </div>

        <div>
          <label for="np-nombre" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Nombre
          </label>
          <input
            id="np-nombre"
            name="nombre"
            required
            autocomplete="off"
            placeholder="Nombre del plato"
            class="w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
          />
        </div>

        <div>
          <label for="np-descripcion" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Descripción
          </label>
          <textarea
            id="np-descripcion"
            name="descripcion"
            rows="3"
            placeholder="Descripción breve…"
            class="w-full resize-y rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm leading-relaxed text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="np-precio" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
              Precio
            </label>
            <input
              id="np-precio"
              name="precio"
              type="number"
              inputmode="decimal"
              min="0"
              step="0.01"
              required
              placeholder="0.00"
              class="precio-input w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm tabular-nums text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
            />
          </div>
          <div class="flex flex-col justify-end pb-1">
            <div class="flex items-center justify-between rounded-xl border border-white/10 bg-black/30 px-3.5 py-2.5">
              <span class="text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
                Destacado
              </span>
              <button
                type="button"
                id="np-destacado"
                role="switch"
                aria-checked="false"
                class="ios-toggle"
                title="Destacado"
              >
                <span class="ios-toggle__knob" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>

        <div>
          <label for="np-imagen" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Imagen / video
          </label>
          <input
            id="np-imagen"
            name="imagen"
            type="file"
            accept="image/*,video/*,image/gif"
            class="block w-full text-xs text-zinc-400 file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-2 file:text-[0.55rem] file:font-semibold file:uppercase file:tracking-[0.14em] file:text-zinc-200 hover:file:bg-white/15"
          />
          <p class="mt-1.5 text-[11px] text-zinc-600">Opcional · se sube a Cloudinary</p>
        </div>

        <div
              class:list={['space-y-3 rounded-2xl border border-white/8 bg-black/25 p-3.5', !marca.gadget_nutricion && 'hidden']}
              data-np-nutricion
              data-shows-when-nutricion
            >
              <p class="text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
                Ficha nutricional
              </p>
              <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
                <div class="nut-metric">
                  <label for="np-calorias">kcal</label>
                  <input id="np-calorias" name="calorias" type="number" min="0" step="1" inputmode="numeric" />
                </div>
                <div class="nut-metric">
                  <label for="np-proteinas">Prot</label>
                  <input id="np-proteinas" name="proteinas" type="number" min="0" step="1" inputmode="numeric" />
                </div>
                <div class="nut-metric">
                  <label for="np-carbs">Carbs</label>
                  <input id="np-carbs" name="carbs" type="number" min="0" step="1" inputmode="numeric" />
                </div>
                <div class="nut-metric">
                  <label for="np-grasas">Grasas</label>
                  <input id="np-grasas" name="grasas" type="number" min="0" step="1" inputmode="numeric" />
                </div>
              </div>
              <div>
                <p class="mb-2 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-zinc-500">Alérgenos</p>
                <div class="flex flex-wrap gap-2">
                  {ALERGENOS_OPTIONS.map((opt) => (
                    <label class="nut-chip">
                      <input type="checkbox" name="alergias" value={opt.id} class="sr-only" />
                      {opt.label}
                    </label>
                  ))}
                </div>
              </div>
            </div>

        <p id="nuevo-plato-error" class="hidden text-xs text-rose-400" role="alert"></p>

        <button
          type="submit"
          id="nuevo-plato-submit"
          class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95 disabled:opacity-50"
        >
          Crear plato
        </button>
      </form>
    </div>
  </div>
    )
  }
</Layout>

<style>
  .precio-input::-webkit-outer-spin-button,
  .precio-input::-webkit-inner-spin-button {
