      data-open="false"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <p id="crx-toast-msg" class="text-sm font-medium tracking-wide text-zinc-100"></p>
    </div>

    {
      restaurante ? (
        <>
          {
            isSuperAdmin ? (
              <button
                type="button"
                class="studio-fab"
                data-nuevo-plato-open
                aria-label="Nuevo plato"
              >
                <span aria-hidden="true">+</span>
              </button>
            ) : null
          }
          <nav class="studio-dock" aria-label="Navegación Studio" data-admin-bottom-nav>
            <button type="button" class="studio-dock__btn is-active" data-tab-target="menu" aria-selected="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h10"></path>
              </svg>
              <span>Menú</span>
            </button>
            {
              !isSuperAdmin && (
            <button type="button" class="studio-dock__btn" data-tab-target="perfil" aria-selected="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
