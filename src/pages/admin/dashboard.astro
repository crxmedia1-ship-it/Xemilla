  // Sync number readouts ↔ range sliders (Escalas sizes + overlay)
  const pxSliderRoot = marcaForm instanceof HTMLElement ? marcaForm : document;
  pxSliderRoot.querySelectorAll('[data-px-slider-for]').forEach((slider) => {
    if (!(slider instanceof HTMLInputElement)) return;
    const inputId = slider.dataset.pxSliderFor;
    if (!inputId?.startsWith('marca-home-')) return;
    const numberInput = document.getElementById(inputId);
    if (!(numberInput instanceof HTMLInputElement)) return;

    const readBounds = () => {
      const min = Number(numberInput.min);
      const max = Number(numberInput.max);
      return {
        min: Number.isFinite(min) ? min : Number(slider.min) || 0,
        max: Number.isFinite(max) ? max : Number(slider.max) || 9999,
      };
    };

    const clamp = () => {
      const { min, max } = readBounds();
      let n = Math.round(Number(numberInput.value));
      if (!Number.isFinite(n)) n = min;
      n = Math.min(max, Math.max(min, n));
      numberInput.value = String(n);
      slider.min = String(min);
      slider.max = String(max);
      slider.value = String(n);
    };

    slider.addEventListener('input', () => {
      numberInput.value = slider.value;
    }, { signal });
    numberInput.addEventListener('input', () => {
      const raw = String(numberInput.value || '').trim();
      if (raw === '' || raw === '-' || raw === '+') return;
      const n = Number(raw);
      if (!Number.isFinite(n)) return;
      const { min, max } = readBounds();
      slider.value = String(Math.min(max, Math.max(min, Math.round(n))));
    }, { signal });
    numberInput.addEventListener('change', clamp, { signal });
    numberInput.addEventListener('blur', clamp, { signal });
    clamp();
  });

  // Profile menu (avatar → glass dropdown) — supports mobile + desktop instances
  (function wireAdminProfileMenu() {
    const roots = document.querySelectorAll('[data-admin-profile]');
    if (!roots.length) return;

    /**
     * @param {HTMLElement} root
     */
    function bindRoot(root) {
      const trigger = root.querySelector('[data-admin-profile-trigger], .admin-profile-trigger');
      const menu = root.querySelector('[data-admin-profile-menu]');
      if (!(trigger instanceof HTMLButtonElement)) return;
      if (!(menu instanceof HTMLElement)) return;

      const setOpen = (open) => {
        menu.hidden = !open;
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      trigger.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();
          // Close other open profile menus first
          roots.forEach((other) => {
            if (!(other instanceof HTMLElement) || other === root) return;
            const otherMenu = other.querySelector('[data-admin-profile-menu]');
            const otherTrigger = other.querySelector('[data-admin-profile-trigger], .admin-profile-trigger');
            if (otherMenu instanceof HTMLElement) otherMenu.hidden = true;
            if (otherTrigger instanceof HTMLElement) otherTrigger.setAttribute('aria-expanded', 'false');
          });
          setOpen(menu.hidden);
        },
        { signal },
      );

      document.addEventListener(
        'click',
        (event) => {
          if (menu.hidden) return;
          const target = event.target;
          if (target instanceof Node && root.contains(target)) return;
          setOpen(false);
        },
        { signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            trigger.focus();
          }
        },
        { signal },
      );
    }

    roots.forEach((root) => {
      if (root instanceof HTMLElement) bindRoot(root);
    });
  })();

