  function isVideoUrl(url) {
    return /\.(mp4|webm|ogg)(\?|$)/i.test(url) || /\/video\/upload\//i.test(url);
  }

  function paintToggle(btn, on) {
    btn.setAttribute('aria-checked', String(on));
    btn.classList.toggle('is-on', on);
