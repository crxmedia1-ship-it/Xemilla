  /* iOS-style toggle — premium track + semantic accents */
  .ios-toggle {
    --toggle-off: #3f3f46;
    --toggle-on: #10b981;
    position: relative;
    display: inline-block;
    width: 2.9rem;
    height: 1.7rem;
    border-radius: 9999px;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: var(--toggle-off);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: background-color 200ms ease-out, box-shadow 200ms ease-out;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .ios-toggle.is-on {
    background: var(--toggle-on);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 0 3px color-mix(in srgb, var(--toggle-on) 18%, transparent);
  }

  .ios-toggle--live {
    --toggle-on: #059669;
  }

  .ios-toggle__knob {
    position: absolute;
    top: 0.16rem;
    left: 0.16rem;
    width: 1.38rem;
    height: 1.38rem;
    border-radius: 9999px;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.22),
      0 4px 10px rgba(0, 0, 0, 0.12);
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease-out;
    transform: translateX(0);
  }

  .ios-toggle.is-on .ios-toggle__knob {
    transform: translateX(1.2rem);
  }

