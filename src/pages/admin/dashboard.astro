  /* iOS-style toggle — premium track + semantic accents */
  .ios-toggle {
    --toggle-off: #3f3f46;
    --toggle-on: #10b981;
    position: relative;
    display: inline-block;
    width: 2.9rem;
    height: 1.7rem;
    border-radius: 9999px;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: var(--toggle-off);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: background-color 200ms ease-out, box-shadow 200ms ease-out;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .ios-toggle.is-on {
    background: var(--toggle-on);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 0 3px color-mix(in srgb, var(--toggle-on) 18%, transparent);
  }

  .ios-toggle--live {
    --toggle-on: #059669;
  }

  .ios-toggle--star {
    --toggle-on: #c9a227;
  }

  .ios-toggle__knob {
    position: absolute;
    top: 0.16rem;
    left: 0.16rem;
    width: 1.38rem;
    height: 1.38rem;
    border-radius: 9999px;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.22),
      0 4px 10px rgba(0, 0, 0, 0.12);
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease-out;
    transform: translateX(0);
  }

  .ios-toggle.is-on .ios-toggle__knob {
    transform: translateX(1.2rem);
  }

  .ios-toggle:active .ios-toggle__knob {
    width: 1.5rem;
  }

  .ios-toggle:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.35);
    outline-offset: 2px;
  }

  html.admin-panel.light .ios-toggle,
  html.admin-panel[data-theme='light'] .ios-toggle,
  html.admin-panel[data-theme='alabastro'] .ios-toggle,
  html.admin-panel[data-theme='organico'] .ios-toggle {
    --toggle-off: #e4e4e7;
    box-shadow: inset 0 0 0 1px rgba(24, 24, 27, 0.06);
  }

  html.admin-panel.light .ios-toggle.is-on,
  html.admin-panel[data-theme='light'] .ios-toggle.is-on,
