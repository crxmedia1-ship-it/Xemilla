                              id="marca-reservas-confirmacion-nativa"
                              name="reservas_confirmacion_nativa"
                              class={fieldClass}
                            >
                              <option value="ninguna" selected={marca.reservas_confirmacion_nativa === 'ninguna'}>
                                Sin confirmación automática
                              </option>
                              <option value="whatsapp" selected={marca.reservas_confirmacion_nativa === 'whatsapp'}>
                                Por WhatsApp
                              </option>
                              <option value="email" selected={marca.reservas_confirmacion_nativa === 'email'}>
                                Por Email
                              </option>
                              <option value="ambas" selected={marca.reservas_confirmacion_nativa === 'ambas'}>
                                WhatsApp y Email
                              </option>
                            </select>
                          </label>
                          <p class="text-[11px] leading-relaxed text-neutral-400">
                            El formulario nativo se muestra dentro de la WebApp; la confirmación avisa al local por el canal elegido.
                          </p>
                        </div>

                        <input
                          type="hidden"
                          id="marca-reservas-destino-valor"
                          name="reservas_destino_valor"
                          value={marca.reservas_destino_valor}
                          data-reservas-destino-valor
                        />

                        <label class="mt-1 block space-y-1.5">
                          <span class={labelClass}>Política de reserva</span>
                          <textarea
                            id="marca-reservas-politica"
                            name="reservas_politica"
                            rows="3"
                            placeholder="Ej. Reserva sujeta a disponibilidad. Cancelar con 2 h de antelación."
                            class={fieldClass}
                          >{marca.reservas_politica}</textarea>
                        </label>
                      </section>
                    </div>
                  </div>

                  {/* —— GADGETS —— */}
                  <div
                    data-marca-panel="gadgets"
                    class="identidad-studio-card space-y-4 rounded-3xl border border-zinc-200/90 bg-white p-6 shadow-[0_4px_25px_rgba(0,0,0,0.03)] backdrop-blur-xl transition-all dark:border-zinc-800/80 dark:bg-zinc-900/60 dark:shadow-none"
                    hidden
                  >
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1 block">Gadgets</p>
                      <p class="mt-0.5 text-xs text-neutral-500">
                        Módulos opcionales del menú digital. Activá solo lo que uses.
                      </p>
                    </div>

                    <div class="gadget-catalog grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2">

                      {/* 1. Wi‑Fi */}
                      <article
                        class:list={[
                          'gadget-card flex h-full flex-col bg-zinc-50/80 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-all',
                          marca.gadget_wifi && 'gadget-card--on',
                        ]}
                        data-gadget-card
                        data-gadget-id="wifi"
                      >
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex min-w-0 items-center gap-3">
                            <span class="gadget-card__icon flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5a8.5 8.5 0 0 1 14 0M8.5 15.5a4.5 4.5 0 0 1 7 0M12 19h.01" />
                              </svg>
                            </span>
                            <div class="min-w-0">
                              <h4 class="text-sm font-semibold text-neutral-900">Red Wi-Fi</h4>
                              <p class="text-xs text-neutral-500">Facilita la conexión a tus clientes</p>
                            </div>
                          </div>
                          <label class="relative shrink-0 cursor-pointer" title="Activar Wi‑Fi">
                            <input type="checkbox" id="marca-gadget-wifi" name="gadget_wifi" checked={marca.gadget_wifi} class="peer sr-only" data-marca-gadget data-gadget-switch role="switch" aria-checked={marca.gadget_wifi ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_wifi && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-wifi" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                        <div class:list={['gadget-card__config', marca.gadget_wifi && 'is-open']} data-gadget-config aria-hidden={marca.gadget_wifi ? 'false' : 'true'}>
                          <div class="gadget-card__config-inner mt-4 grid gap-3 border-t border-neutral-100 pt-4" data-gadget-config-inner>
                            <label class="block">
                              <span class={gadgetLabelClass}>Nombre de Red (SSID)</span>
                              <input type="text" id="marca-wifi-ssid" name="gadget_wifi_ssid" value={marca.wifi_ssid} placeholder="Nombre de la red" class={gadgetFieldClass} />
                            </label>
                            <label class="block">
                              <span class={gadgetLabelClass}>Contraseña</span>
                              <input type="text" id="marca-wifi-password" name="gadget_wifi_clave" value={marca.wifi_password} placeholder="Contraseña" class={gadgetFieldClass} />
                            </label>
                          </div>
                        </div>
                      </article>

                      {/* 2. AR / 3D */}
                      <article
                        class:list={[
                          'gadget-card flex h-full flex-col bg-zinc-50/80 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-all',
                          marca.gadget_ar && 'gadget-card--on',
                        ]}
                        data-gadget-card
                        data-gadget-id="ar"
                      >
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex min-w-0 items-center gap-3">
                            <span class="gadget-card__icon flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                              </svg>
                            </span>
                            <div class="min-w-0">
                              <h4 class="text-sm font-semibold text-neutral-900">Platos en AR / 3D</h4>
                              <p class="text-xs text-neutral-500">Proyección interactiva en mesa</p>
                            </div>
                          </div>
                          <label class="relative shrink-0 cursor-pointer" title="Activar Realidad Aumentada">
                            <input type="checkbox" id="marca-gadget-ar" name="gadget_ar" checked={marca.gadget_ar} class="peer sr-only" data-marca-gadget data-gadget-switch role="switch" aria-checked={marca.gadget_ar ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_ar && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-ar" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                        <div class:list={['gadget-card__config', marca.gadget_ar && 'is-open']} data-gadget-config aria-hidden={marca.gadget_ar ? 'false' : 'true'}>
                          <div class="gadget-card__config-inner mt-4 border-t border-neutral-100 pt-4" data-gadget-config-inner>
                            <p class="gadget-note-on rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2.5 text-xs leading-relaxed text-emerald-900">
                              Visor 3D y proyección AR activados. Los platos con archivo .glb o .usdz asignado mostrarán el botón interactivo en la carta.
                            </p>
                          </div>
                        </div>
                      </article>

                      {/* 3. Alérgenos */}
                      <article
                        class:list={[
                          'gadget-card flex h-full flex-col bg-zinc-50/80 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-all',
                          marca.gadget_nutricion && 'gadget-card--on',
                        ]}
                        data-gadget-card
                        data-gadget-id="nutricion"
                      >
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex min-w-0 items-center gap-3">
                            <span class="gadget-card__icon flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5c-2.8 3.2-6 6.4-6 10a6 6 0 0 0 12 0c0-3.6-3.2-6.8-6-10Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14.5v3" />
                              </svg>
                            </span>
                            <div class="min-w-0">
                              <h4 class="text-sm font-semibold text-neutral-900">Filtros de Alérgenos</h4>
                              <p class="text-xs text-neutral-500">Informa sobre alérgenos y dietas</p>
                            </div>
                          </div>
                          <label class="relative shrink-0 cursor-pointer" title="Activar Alérgenos">
                            <input type="checkbox" id="marca-gadget-nutricion" name="gadget_nutricion" checked={marca.gadget_nutricion} class="peer sr-only" data-marca-gadget data-gadget-switch role="switch" aria-checked={marca.gadget_nutricion ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_nutricion && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-nutricion" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                        <div class:list={['gadget-card__config', marca.gadget_nutricion && 'is-open']} data-gadget-config aria-hidden={marca.gadget_nutricion ? 'false' : 'true'}>
                          <div class="gadget-card__config-inner mt-4 space-y-2 border-t border-neutral-100 pt-4" data-gadget-config-inner>
                            <div class="flex flex-wrap gap-2">
                              <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-2 text-xs font-medium text-neutral-800 transition hover:border-neutral-300 has-[:checked]:border-emerald-300 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800">
                                <input type="checkbox" id="marca-gadget-nut-gluten" name="gadget_nut_filtro_gluten_free" checked={marca.gadget_nut_filtro_gluten_free} class="size-3.5 rounded border-neutral-300 text-emerald-500 focus:ring-emerald-500/30" />
                                Gluten Free
                              </label>
                              <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-2 text-xs font-medium text-neutral-800 transition hover:border-neutral-300 has-[:checked]:border-emerald-300 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800">
                                <input type="checkbox" id="marca-gadget-nut-vegano" name="gadget_nut_filtro_vegano" checked={marca.gadget_nut_filtro_vegano} class="size-3.5 rounded border-neutral-300 text-emerald-500 focus:ring-emerald-500/30" />
                                Vegano
                              </label>
                              <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-2 text-xs font-medium text-neutral-800 transition hover:border-neutral-300 has-[:checked]:border-emerald-300 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800">
                                <input type="checkbox" id="marca-gadget-nut-frutos" name="gadget_nut_filtro_frutos_secos" checked={marca.gadget_nut_filtro_frutos_secos} class="size-3.5 rounded border-neutral-300 text-emerald-500 focus:ring-emerald-500/30" />
                                Frutos Secos
                              </label>
                              <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-2 text-xs font-medium text-neutral-800 transition hover:border-neutral-300 has-[:checked]:border-emerald-300 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800">
                                <input type="checkbox" id="marca-gadget-nut-calorias" name="gadget_nut_filtro_calorias" checked={marca.gadget_nut_filtro_calorias} class="size-3.5 rounded border-neutral-300 text-emerald-500 focus:ring-emerald-500/30" />
                                Calorías
                              </label>
                            </div>
                          </div>
                        </div>
                      </article>

                      {/* 4. Boutique */}
                      <article
                        class:list={[
                          'gadget-card flex h-full flex-col bg-zinc-50/80 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-all',
                          marca.gadget_boutique && 'gadget-card--on',
                        ]}
                        data-gadget-card
                        data-gadget-id="boutique"
                      >
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex min-w-0 items-center gap-3">
                            <span class="gadget-card__icon flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 8.5h12l-1 11.5a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 20L6 8.5Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 8.5V7a3 3 0 0 1 6 0v1.5" />
                              </svg>
                            </span>
                            <div class="min-w-0">
                              <h4 class="text-sm font-semibold text-neutral-900">Boutique &amp; Merch</h4>
                              <p class="text-xs text-neutral-500">Vende productos oficiales</p>
                            </div>
                          </div>
                          <label class="relative shrink-0 cursor-pointer" title="Activar Boutique">
                            <input type="checkbox" id="marca-gadget-boutique" name="gadget_boutique" checked={marca.gadget_boutique} class="peer sr-only" data-marca-gadget data-gadget-switch role="switch" aria-checked={marca.gadget_boutique ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_boutique && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-boutique" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                        <div class:list={['gadget-card__config', marca.gadget_boutique && 'is-open']} data-gadget-config aria-hidden={marca.gadget_boutique ? 'false' : 'true'}>
                          <div class="gadget-card__config-inner mt-4 grid gap-3 border-t border-neutral-100 pt-4" data-gadget-config-inner>
                            <label class="block">
                              <span class={gadgetLabelClass}>Nombre del catálogo</span>
                              <input type="text" id="marca-boutique-titulo" name="boutique_titulo" value={marca.boutique_titulo} placeholder="Boutique" class={gadgetFieldClass} />
                            </label>
                            <label class="block">
                              <span class={gadgetLabelClass}>Enlace externo / URL</span>
                              <input type="url" id="marca-boutique-catalogo-url" name="boutique_catalogo_url" value={marca.boutique_catalogo_url} placeholder="https://…" class={gadgetFieldClass} />
                            </label>
                            {/* Persistencia silenciosa de productos existentes */}
                            <div class="hidden" aria-hidden="true">
                              {
                                marca.boutique_productos.map((prod) => (
                                  <div data-boutique-row>
                                    <input type="hidden" data-boutique-id value={prod.id} />
                                    <input type="hidden" data-boutique-nombre value={prod.nombre} />
                                    <input type="hidden" data-boutique-precio value={prod.precio} />
                                    <input type="hidden" data-boutique-imagen value={prod.imagen_url || ''} />
                                    <input type="checkbox" data-boutique-activo checked={prod.activo} />
                                  </div>
                                ))
                              }
                            </div>
                          </div>
                        </div>
                      </article>

                      {/* 5. Sucursales (de pago, con cupo de sedes) */}
                      <article
                        class:list={[
                          'gadget-card flex h-full flex-col bg-zinc-50/80 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-all',
                          marca.gadget_sucursales && 'gadget-card--on',
                        ]}
                        data-gadget-card
                        data-gadget-id="sucursales"
                      >
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex min-w-0 items-center gap-3">
                            <span class="gadget-card__icon flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 20.5h17M5 20.5V9.5l4-2.5 4 2.5v11M13 20.5V12l3.5-2 3.5 2v8.5M8 12.5h2M8 16h2" />
                              </svg>
                            </span>
                            <div class="min-w-0">
                              <h4 class="text-sm font-semibold text-neutral-900">Sucursales</h4>
                              <p class="text-xs text-neutral-500">Varias sedes, cada una agota lo suyo</p>
                            </div>
                          </div>
                          <label class="relative shrink-0 cursor-pointer" title="Activar Sucursales">
                            <input type="checkbox" id="marca-gadget-sucursales" name="gadget_sucursales" checked={marca.gadget_sucursales} class="peer sr-only" data-marca-gadget data-gadget-switch role="switch" aria-checked={marca.gadget_sucursales ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_sucursales && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-sucursales" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                        <div class:list={['gadget-card__config', marca.gadget_sucursales && 'is-open']} data-gadget-config aria-hidden={marca.gadget_sucursales ? 'false' : 'true'}>
                          <div class="gadget-card__config-inner mt-4 grid gap-3 border-t border-neutral-100 pt-4" data-gadget-config-inner>
                            <label class="block">
                              <span class={gadgetLabelClass}>Sedes contratadas (incluye la principal)</span>
                              <input type="number" id="marca-sucursales-cupo" name="sucursales_cupo" min="1" max="50" step="1" inputmode="numeric" value={marca.sucursales_cupo} class={gadgetFieldClass} />
                            </label>
                            <p class="text-xs leading-relaxed text-neutral-500">
                              Sedes creadas ahora: {sucursales.length}. Al guardar aparece el selector de sede en Menú; desde ahí se crean y editan.
                            </p>
                          </div>
                        </div>
                      </article>

                    </div>
                  </div>

                  {/* —— QR & IMPRESIÓN (Centro de Recursos) —— */}
                  <div
                    data-marca-panel="qr"
                    class="identidad-studio-card space-y-5 rounded-3xl border border-zinc-200/90 bg-white p-6 shadow-[0_4px_25px_rgba(0,0,0,0.03)] backdrop-blur-xl transition-all dark:border-zinc-800/80 dark:bg-zinc-900/60 dark:shadow-none sm:p-6"
                    hidden
                    data-qr-slug={publicSlug}
                    data-qr-logo={marca.logo_url || ''}
                    data-qr-brand={marca.color_primario || '#9f1239'}
                  >
                    <header class="space-y-1">
                      <p id="qr-section-title" class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1 block">QR &amp; Impresión</p>
                      <p class="text-xs text-neutral-500">Centro de recursos y descarga del menú digital</p>
                    </header>

                    <div class="grid gap-5 lg:grid-cols-2 lg:items-start">
                      {/* Columna izquierda — Ajustes y descargas */}
                      <div class="space-y-4">
                        <div class="space-y-2">
                          <p class="text-xs font-medium text-neutral-600">Enlace del Menú</p>
                          <div class="flex overflow-hidden rounded-lg border border-neutral-200 bg-neutral-50 focus-within:border-neutral-400 focus-within:ring-2 focus-within:ring-neutral-200">
                            <input
                              type="text"
                              id="qr-public-url"
                              readonly
                              value={publicSlug ? `https://xemilla.app/${publicSlug}` : ''}
                              class="min-w-0 flex-1 border-0 bg-transparent px-3 py-2.5 text-xs text-neutral-800 outline-none"
                            />
                            <button
                              type="button"
                              id="qr-copy-link"
                              class="shrink-0 border-l border-neutral-200 bg-white px-3.5 text-xs font-medium text-neutral-700 transition hover:bg-neutral-50"
                            >
                              Copiar
                            </button>
                          </div>
                        </div>

                        <div class="space-y-2">
                          <p class="text-xs font-medium text-neutral-600">Estilo del QR Estándar</p>
                          <div class="grid grid-cols-2 gap-2" role="group" aria-label="Estilo del QR">
                            <button
                              type="button"
                              data-qr-style="standard"
                              class="qr-style-btn rounded-lg border border-emerald-500 bg-emerald-50 px-3 py-2.5 text-xs font-medium text-emerald-700 transition"
                              aria-pressed="true"
                            >
                              Monocromático Negro
                            </button>
                            <button
                              type="button"
                              data-qr-style="brand"
                              class="qr-style-btn rounded-lg border border-neutral-200 bg-white px-3 py-2.5 text-xs font-medium text-neutral-700 transition hover:border-neutral-300"
                              aria-pressed="false"
                            >
                              Color de Marca
                            </button>
                          </div>
                        </div>

                        <label
                          class:list={[
                            'flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3',
                            !marca.logo_url && 'opacity-60',
                          ]}
                          title={marca.logo_url ? 'Incluir logo central' : 'Subí un logo en Identidad para activar esta opción'}
                        >
                          <span class="min-w-0">
                            <span class="block text-sm font-medium text-neutral-900">Incluir logo central</span>
                            <span class="mt-0.5 block text-xs text-neutral-500">
                              {marca.logo_url
                                ? 'Usa el logo principal de Identidad sobre el QR'
                                : 'Subí el logo principal en Identidad para usarlo aquí'}
                            </span>
                          </span>
                          <input
                            type="checkbox"
                            id="qr-include-logo"
                            class="peer sr-only"
                            role="switch"
                            aria-checked="false"
                            disabled={!marca.logo_url}
                          />
                          <span
                            class="relative h-7 w-12 shrink-0 rounded-full bg-neutral-300 transition peer-checked:bg-emerald-500 after:absolute after:left-0.5 after:top-0.5 after:size-6 after:rounded-full after:bg-white after:shadow-sm after:transition peer-checked:after:translate-x-5 peer-disabled:opacity-50"
                            aria-hidden="true"
                          ></span>
                        </label>

                        <div class="space-y-2 pt-1">
                          <button
                            type="button"
                            id="qr-download-svg"
                            class="qr-btn-primary flex w-full items-center justify-center gap-2 rounded-lg bg-neutral-900 py-2.5 text-xs font-medium text-white transition hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-40"
                            disabled={!publicSlug}
                          >
                            Descargar QR Vectorial (SVG para Imprenta)
                          </button>
                          <button
                            type="button"
                            id="qr-download-png"
                            class="qr-btn-secondary flex w-full items-center justify-center gap-2 rounded-lg border border-neutral-200 bg-white py-2.5 text-xs font-medium text-neutral-700 transition hover:bg-neutral-50 disabled:cursor-not-allowed disabled:opacity-40"
                            disabled={!publicSlug}
                          >
                            Descargar PNG (Digital / Redes)
                          </button>
                        </div>

                        <p id="qr-error-msg" class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2.5 text-xs font-medium text-red-700" role="alert"></p>
                        <p id="qr-status-msg" class="hidden text-xs font-medium text-emerald-700" role="status"></p>
                      </div>

                      {/* Columna derecha — Visor */}
                      <div class="flex flex-col items-center justify-center rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
                        <div class="relative flex size-[240px] items-center justify-center overflow-hidden rounded-xl border border-neutral-100 bg-white p-2 shadow-sm sm:size-[280px]">
                          {publicSlug ? (
                            <img
                              id="qr-preview-img"
                              src={`https://api.qrserver.com/v1/create-qr-code/?size=480x480&margin=12&ecc=H&color=000000&bgcolor=ffffff&data=${encodeURIComponent(`https://xemilla.app/${publicSlug}`)}`}
                              alt={`QR de ${publicSlug}`}
                              width="240"
                              height="240"
                              class="size-full object-contain"
                              loading="eager"
                              data-qr-preview-mode="standard"
                            />
                          ) : (
                            <p id="qr-preview-empty" class="px-4 text-center text-sm font-medium text-neutral-500">
                              Guarda un slug para generar el QR
                            </p>
                          )}
                          <div
                            id="qr-preview-logo-wrap"
                            class="qr-logo-plate pointer-events-none absolute left-1/2 top-1/2 z-10 hidden -translate-x-1/2 -translate-y-1/2 items-center justify-center overflow-hidden rounded-xl bg-white p-1.5 shadow-sm"
                            hidden
                            aria-hidden="true"
                          >
                            <img
                              id="qr-preview-logo"
                              src=""
                              alt=""
                              class="h-full w-full object-contain"
                              decoding="async"
                            />
                          </div>
                        </div>
                        <p class="mt-4 text-center text-xs font-medium text-neutral-500" id="qr-preview-caption">
                          Apunta la cámara de tu móvil para verificar la experiencia en vivo
                        </p>
                        {publicSlug ? (
                          <p class="mt-1 text-center font-mono text-[11px] text-neutral-400">xemilla.app/{publicSlug}</p>
                        ) : null}
                      </div>
                    </div>
                  </div>

                  <p id="marca-feedback" class="hidden text-xs text-zinc-500" role="status"></p>
                </div>
              </div>
            </form>

          </div>
            )
          }
        </div>
      )
