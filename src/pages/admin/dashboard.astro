          Cerrar
        </button>
      </div>
      <div class="space-y-4 px-5 py-5">
        <label for="desc-modal-text" class="sr-only">Descripción del plato</label>
        <textarea
          id="desc-modal-text"
          rows="7"
          placeholder="Escribí la descripción completa del plato…"
          class="w-full resize-y rounded-2xl border border-white/10 bg-black/40 px-4 py-3 text-sm leading-relaxed text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
        ></textarea>
        <p id="desc-modal-error" class="hidden text-xs text-rose-400" role="alert"></p>
        <button
          type="button"
          id="desc-modal-save"
          class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95"
        >
          Guardar
        </button>
      </div>
    </div>
  </div>

  {/* Modal Nuevo Plato — exclusivo SuperAdmin (no render en admin de restaurante) */}
  {
    isSuperAdmin && (
      <div
        id="nuevo-plato-modal"
        class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
        role="dialog"
        aria-modal="true"
        aria-labelledby="nuevo-plato-title"
        data-open="false"
        aria-hidden="true"
      >
    <div
      data-modal-card
      class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}
    >
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <div class="min-w-0">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-zinc-500">
            SuperAdmin
          </p>
          <h3 id="nuevo-plato-title" class="mt-1 font-blacksushi-display text-xl font-semibold">
