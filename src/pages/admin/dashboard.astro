                                    type="url"
                                    data-boutique-imagen
                                    value={prod.imagen_url || ''}
                                    placeholder="URL imagen (opcional)"
                                    class={fieldClass}
                                  />
                                </div>
                              ))
                            }
                          </div>
                        </div>
                      </article>
                    </div>
                  </div>

                  <p id="marca-feedback" class="hidden text-xs text-zinc-500" role="status"></p>
                </div>
              </div>
            </form>

          </div>
            )
          }
        </div>
      )
    }

    <AdminXemillaMark />
    </div>

    <div
      id="mesa-alertas-stack"
      class="pointer-events-none fixed right-4 top-20 z-[90] flex w-[min(92vw,22rem)] flex-col gap-3"
      aria-live="assertive"
      aria-relevant="additions"
    ></div>

    <audio
      id="mesa-alerta-chime"
      preload="auto"
      src="https://actions.google.com/sounds/v1/alarms/dinner_bell_triangle.ogg"
    ></audio>

    <div
      id="crx-toast"
      class="crx-toast pointer-events-none fixed bottom-6 left-1/2 z-[80] max-w-[min(92vw,24rem)] -translate-x-1/2 rounded-2xl border border-white/12 bg-zinc-950/95 px-5 py-3.5 text-center shadow-2xl shadow-black/50 backdrop-blur-xl"
      data-open="false"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <p id="crx-toast-msg" class="text-sm font-medium tracking-wide text-zinc-100"></p>
    </div>
  </main>

  {/* Modal media */}
  <div
    id="plato-modal"
    class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="plato-modal-title"
    data-open="false"
    aria-hidden="true"
  >
    <div
      data-modal-card
      class={`modal-card glass-panel ${bounceWallClass} w-full max-w-2xl overflow-hidden p-0 shadow-2xl`}
    >
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <h3 id="plato-modal-title" class="truncate font-blacksushi-display text-xl font-semibold">
          Plato
        </h3>
        <button
          type="button"
          id="plato-modal-close"
          class="rounded-lg px-3 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:bg-white/5 hover:text-white"
        >
          Cerrar
        </button>
      </div>

      <div id="modal-preview" class="hidden">
        <div class="relative aspect-[4/3] overflow-hidden bg-zinc-950">
          <img
            id="plato-modal-img"
            src=""
            alt=""
            class="absolute inset-0 size-full object-cover object-center"
          />
          <video
            id="plato-modal-video"
            class="absolute inset-0 hidden size-full object-contain object-center"
            controls
            playsinline
          ></video>
          <div
            id="modal-replace-busy"
            class="absolute inset-0 hidden items-center justify-center bg-black/55 backdrop-blur-[2px]"
          >
            <p class="rounded-full border border-white/15 bg-black/60 px-4 py-2 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-white">
              Subiendo…
            </p>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/8 px-5 py-3.5">
          <p class="text-xs text-zinc-500">Reemplazá la media sin salir del preview.</p>
          <label class="relative inline-flex cursor-pointer items-center">
            <input
              id="modal-replace-file"
              type="file"
              accept="image/*,video/*,image/gif"
              class="sr-only"
            />
            <span
              id="modal-replace-label"
              class="inline-flex items-center gap-2 rounded-xl border border-white/12 bg-white/[0.06] px-3.5 py-2 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-200 transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:border-white/25 hover:bg-neutral-800/50 hover:text-white"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M12 16V4"></path>
                <path d="M8 8l4-4 4 4"></path>
                <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"></path>
              </svg>
              Cambiar archivo
            </span>
          </label>
        </div>
        <p id="modal-replace-error" class="hidden px-5 pb-3 text-xs text-rose-400" role="alert"></p>
      </div>

      <div id="modal-attach" class="hidden space-y-4 px-5 py-5">
        <p class="text-sm leading-relaxed text-zinc-400">
          Este plato no tiene media. Pegá una URL de Cloudinary o subí un archivo.
        </p>
        <div class="space-y-1.5">
          <label for="modal-url" class="text-[0.58rem] font-semibold uppercase tracking-[0.18em] text-zinc-500">
            URL Cloudinary
          </label>
          <input
            id="modal-url"
            type="url"
            placeholder="https://res.cloudinary.com/..."
            class="w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-3 text-sm text-white outline-none transition placeholder:text-zinc-700 focus:border-white/25"
          />
        </div>
        <div class="space-y-1.5">
          <label for="modal-file" class="text-[0.58rem] font-semibold uppercase tracking-[0.18em] text-zinc-500">
            O archivo local
          </label>
          <input
            id="modal-file"
            type="file"
            accept="image/*,video/mp4,video/webm,image/gif"
            class="block w-full text-xs text-zinc-400 file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-2 file:text-[0.58rem] file:font-semibold file:uppercase file:tracking-[0.14em] file:text-white"
          />
        </div>
        <p id="modal-attach-error" class="hidden text-xs text-rose-400" role="alert"></p>
        <button
          type="button"
          id="modal-attach-save"
          class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95"
        >
          Guardar media
        </button>
      </div>
    </div>
  </div>

  {/* Modal descripción */}
  <div
    id="desc-modal"
    class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="desc-modal-title"
    data-open="false"
    aria-hidden="true"
  >
    <div data-modal-card class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}>
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <div class="min-w-0">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.2em] text-zinc-500">
            Descripción
          </p>
          <h3 id="desc-modal-title" class="mt-1 truncate font-blacksushi-display text-xl font-semibold">
            Plato
          </h3>
        </div>
        <button
          type="button"
          id="desc-modal-close"
          class="rounded-lg px-3 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:bg-white/5 hover:text-white"
