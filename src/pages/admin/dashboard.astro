                              value={marca.ubicacion_color_fondo || '#0a0a0a'}
                              class="id-swatch__dot"
                            />
                            <input
                              type="text"
                              id="marca-ubicacion-color-fondo"
                              name="ubicacion_color_fondo"
                              value={marca.ubicacion_color_fondo}
                              placeholder="#0a0a0a"
                              spellcheck="false"
                              class="id-swatch__hex"
                            />
                          </span>
                        </label>
                        <label class="id-swatch">
                          <span>Títulos</span>
                          <span class="id-swatch__ctrl">
                            <input
                              type="color"
                              id="marca-ubicacion-color-titulo-picker"
                              value={marca.ubicacion_color_titulo || '#ffffff'}
                              class="id-swatch__dot"
                            />
                            <input
                              type="text"
                              id="marca-ubicacion-color-titulo"
                              name="ubicacion_color_titulo"
                              value={marca.ubicacion_color_titulo}
                              placeholder="#ffffff"
                              spellcheck="false"
                              class="id-swatch__hex"
                            />
                          </span>
                        </label>
                        <label class="id-swatch">
                          <span>Cuerpo</span>
                          <span class="id-swatch__ctrl">
                            <input
                              type="color"
