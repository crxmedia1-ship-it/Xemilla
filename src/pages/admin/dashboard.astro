  function refreshSearchIndex(row) {
    if (!(row instanceof HTMLElement)) return;
    const nombre = row.querySelector('[data-field="nombre"]');
    const descBtn = row.querySelector('[data-edit-descripcion]');
    const cat = row.querySelector('[data-categoria]');
    const n = nombre instanceof HTMLInputElement ? nombre.value : '';
    const d =
      descBtn instanceof HTMLElement ? descBtn.dataset.descripcion || '' : '';
    const c = cat?.textContent || '';
    row.dataset.search = `${n} ${c} ${d}`.toLowerCase();
    row.dataset.nombre = n;
    row.dataset.categoria = c.trim();
  }

  function refreshCount() {
    const rows = allRows();
    const n = rows.length;
    if (countEl) countEl.textContent = String(n);
    emptyEl?.classList.toggle('hidden', n > 0);
    tableWrap?.classList.toggle('hidden', n === 0);
    toolbar?.classList.toggle('hidden', n === 0);
    refreshCategoryPills();
    applySearchFilter();
  }

  function setCategoryPillActive(btn, active) {
    if (!(btn instanceof HTMLElement)) return;
    btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    btn.className = active ? CAT_PILL_ACTIVE : CAT_PILL_INACTIVE;
  }

  function refreshCategoryPills() {
    if (!(categoryFilters instanceof HTMLElement)) return;
    const names = new Set();
    for (const cat of categoriasCache) {
      const n = String(cat?.nombre || '').trim();
      if (n) names.add(n);
    }
    for (const row of allRows()) {
      if (!(row instanceof HTMLElement)) continue;
      const n = String(row.dataset.categoria || '').trim();
      if (n && n !== '—') names.add(n);
    }

    const current = activeCategoryFilter;
    categoryFilters.innerHTML = '';

    const todas = document.createElement('button');
    todas.type = 'button';
    todas.dataset.catFilter = 'todas';
    todas.textContent = 'Todas';
    setCategoryPillActive(todas, current === 'todas');
    categoryFilters.appendChild(todas);

    const sorted = [...names].sort((a, b) => a.localeCompare(b, 'es'));
    for (const name of sorted) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.catFilter = name;
      btn.textContent = name;
      setCategoryPillActive(btn, current === name);
      categoryFilters.appendChild(btn);
    }

    if (current !== 'todas' && !names.has(current)) {
      activeCategoryFilter = 'todas';
      setCategoryPillActive(todas, true);
    }
  }

  function applySearchFilter() {
    const q = (searchInput instanceof HTMLInputElement ? searchInput.value : '').trim().toLowerCase();
    const catFilter = String(activeCategoryFilter || 'todas').trim().toLowerCase();
    const rows = allRows();
    let visible = 0;
    for (const row of rows) {
      if (!(row instanceof HTMLElement)) continue;
      const rowCat = String(row.dataset.categoria || '').trim().toLowerCase();
      const catMatch = catFilter === 'todas' || rowCat === catFilter;
      const textMatch = !q || (row.dataset.search || '').includes(q);
      const match = catMatch && textMatch;
      row.classList.toggle('hidden', !match);
      if (match) visible += 1;
    }
    const filtered = Boolean(q) || catFilter !== 'todas';
    if (searchMeta) {
      searchMeta.textContent = filtered
        ? `${visible} de ${rows.length}`
        : `${rows.length} visibles`;
    }
    const hasRows = rows.length > 0;
    noResults?.classList.toggle('hidden', !(hasRows && visible === 0));
    tableWrap?.classList.toggle('hidden', !hasRows || visible === 0);
  }

  searchInput?.addEventListener('input', applySearchFilter, { signal });

  categoryFilters?.addEventListener(
    'click',
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest('[data-cat-filter]');
      if (!(btn instanceof HTMLElement) || !categoryFilters.contains(btn)) return;
      const next = String(btn.dataset.catFilter || 'todas');
      activeCategoryFilter = next;
      for (const pill of categoryFilters.querySelectorAll('[data-cat-filter]')) {
        if (!(pill instanceof HTMLElement)) continue;
        setCategoryPillActive(pill, pill.dataset.catFilter === next);
      }
      applySearchFilter();
    },
    { signal },
  );

  /** @type {HTMLTableRowElement | null} */
  let draggedPlatoRow = null;
  /** @type {HTMLTableRowElement | null} */
  let dropIndicatorRow = null;

  function clearPlatoDropIndicator() {
    if (!(dropIndicatorRow instanceof HTMLTableRowElement)) return;
    dropIndicatorRow.classList.remove(...ROW_DROP_BEFORE, ...ROW_DROP_AFTER);
    dropIndicatorRow = null;
  }

  function clearPlatoDragVisual(row) {
    if (!(row instanceof HTMLTableRowElement)) return;
    row.classList.remove(...ROW_DRAG_ACTIVE);
  }

  function setPlatoDropIndicator(row, before) {
    if (!(row instanceof HTMLTableRowElement) || row === draggedPlatoRow) return;
    if (dropIndicatorRow && dropIndicatorRow !== row) clearPlatoDropIndicator();
    dropIndicatorRow = row;
    row.classList.remove(...ROW_DROP_BEFORE, ...ROW_DROP_AFTER);
    row.classList.add(...(before ? ROW_DROP_BEFORE : ROW_DROP_AFTER));
  }

  function platoRowFromEvent(event) {
    const target = event.target;
    if (!(target instanceof Element) || !(tbody instanceof HTMLElement)) return null;
    const row = target.closest('tr[data-plato-id]');
    if (!(row instanceof HTMLTableRowElement) || !tbody.contains(row)) return null;
    return row;
  }

  tbody?.addEventListener(
    'dragstart',
    (event) => {
      if (!(event instanceof DragEvent)) return;
      const row = platoRowFromEvent(event);
      if (!row) return;
      const origin = event.target;
      if (
        origin instanceof Element &&
        origin.closest('input, button, label, a, textarea, select, [contenteditable="true"]')
      ) {
        event.preventDefault();
        return;
      }
      draggedPlatoRow = row;
      row.classList.add(...ROW_DRAG_ACTIVE);
      if (event.dataTransfer) {
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', row.dataset.platoId || '');
      }
    },
    { signal },
  );

  tbody?.addEventListener(
    'dragover',
    (event) => {
      if (!(event instanceof DragEvent) || !draggedPlatoRow) return;
      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
      const row = platoRowFromEvent(event);
      if (!row || row === draggedPlatoRow) {
        clearPlatoDropIndicator();
        return;
      }
      const rect = row.getBoundingClientRect();
      const before = event.clientY < rect.top + rect.height / 2;
      setPlatoDropIndicator(row, before);
    },
    { signal },
  );

  tbody?.addEventListener(
    'dragenter',
    (event) => {
      if (!(event instanceof DragEvent) || !draggedPlatoRow) return;
      event.preventDefault();
      const row = platoRowFromEvent(event);
      if (!row || row === draggedPlatoRow) return;
      const rect = row.getBoundingClientRect();
      const before = event.clientY < rect.top + rect.height / 2;
      setPlatoDropIndicator(row, before);
    },
    { signal },
  );

  tbody?.addEventListener(
    'dragleave',
    (event) => {
      if (!(event instanceof DragEvent)) return;
      const row = platoRowFromEvent(event);
      if (!row || row !== dropIndicatorRow) return;
      const related = event.relatedTarget;
      if (related instanceof Node && row.contains(related)) return;
      clearPlatoDropIndicator();
    },
    { signal },
  );

  tbody?.addEventListener(
    'drop',
    (event) => {
      if (!(event instanceof DragEvent) || !(tbody instanceof HTMLElement)) return;
      event.preventDefault();
      const target = platoRowFromEvent(event);
      const dragged = draggedPlatoRow;
      clearPlatoDropIndicator();
      if (!dragged || !target || dragged === target || !tbody.contains(dragged)) {
        clearPlatoDragVisual(dragged);
        draggedPlatoRow = null;
        return;
      }
      const rect = target.getBoundingClientRect();
      const before = event.clientY < rect.top + rect.height / 2;
      if (before) tbody.insertBefore(dragged, target);
      else tbody.insertBefore(dragged, target.nextSibling);
      clearPlatoDragVisual(dragged);
      draggedPlatoRow = null;
      console.log('Nuevo orden visual aplicado');
    },
    { signal },
  );

  tbody?.addEventListener(
    'dragend',
    () => {
      clearPlatoDropIndicator();
      clearPlatoDragVisual(draggedPlatoRow);
      draggedPlatoRow = null;
    },
    { signal },
  );

