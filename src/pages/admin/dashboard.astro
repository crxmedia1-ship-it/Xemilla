    return wrap;
  }

  function collectNosotrosBloques() {
    if (!(bloquesList instanceof HTMLElement)) return [];
    return Array.from(bloquesList.querySelectorAll('[data-nosotros-bloque]'))
      .map((el) => {
        const titulo =
          /** @type {HTMLInputElement | null} */ (el.querySelector('[data-bloque-titulo]'))
            ?.value || '';
        const texto =
          /** @type {HTMLTextAreaElement | null} */ (el.querySelector('[data-bloque-texto]'))
            ?.value || '';
        const media_url =
          /** @type {HTMLInputElement | null} */ (el.querySelector('[data-bloque-media]'))
            ?.value || '';
        const alineacion =
          /** @type {HTMLSelectElement | null} */ (el.querySelector('[data-bloque-alineacion]'))
            ?.value || 'alternada';
        return {
          titulo: titulo.trim(),
          texto: texto.trim(),
          media_url: media_url.trim(),
          alineacion: alineacion === 'inversa' ? 'inversa' : 'alternada',
        };
      })
      .filter((b) => b.titulo || b.texto || b.media_url);
  }

  function collectCategoriasFondos() {
    return Array.from(document.querySelectorAll('[data-cat-fondo]'))
      .map((el) => {
        if (!(el instanceof HTMLElement)) return null;
        const id = el.dataset.catId;
        const bg_valor =
          /** @type {HTMLInputElement | null} */ (el.querySelector('[data-cat-bg-valor]'))
            ?.value || '';
        const valor = bg_valor.trim();
        let bg_type = 'color';
        if (valor) {
          if (/\.(mp4|webm|ogg|mov)(\?|$)/i.test(valor) || /\/video\/upload\//i.test(valor)) {
            bg_type = 'video';
          } else if (/^https?:\/\//i.test(valor) || valor.startsWith('/') || /\.(jpe?g|png|webp|gif|avif)(\?|$)/i.test(valor)) {
            bg_type = 'image';
          } else if (valor.startsWith('#')) {
            bg_type = 'color';
          } else {
            bg_type = 'image';
          }
        }
        return { id, bg_type, bg_valor: valor };
      })
      .filter(Boolean);
  }

  function collectBoutiqueProductos() {
    return Array.from(document.querySelectorAll('[data-boutique-row]')).map((row, index) => {
      if (!(row instanceof HTMLElement)) {
        return { id: `item-${index + 1}`, nombre: 'Producto', precio: 0, imagen_url: '', activo: false };
      }
      const id =
        /** @type {HTMLInputElement | null} */ (row.querySelector('[data-boutique-id]'))?.value ||
        `item-${index + 1}`;
      const nombre =
        /** @type {HTMLInputElement | null} */ (row.querySelector('[data-boutique-nombre]'))
          ?.value || 'Producto';
      const precioRaw = Number(
        /** @type {HTMLInputElement | null} */ (row.querySelector('[data-boutique-precio]'))
          ?.value || 0,
      );
      const imagen_url =
        /** @type {HTMLInputElement | null} */ (row.querySelector('[data-boutique-imagen]'))
          ?.value || '';
      const activo = Boolean(
        /** @type {HTMLInputElement | null} */ (row.querySelector('[data-boutique-activo]'))
          ?.checked,
      );
      return {
        id,
        nombre,
        precio: Number.isFinite(precioRaw) ? precioRaw : 0,
        imagen_url,
        activo,
      };
    });
  }

  addBloqueBtn?.addEventListener('click', () => {
    if (!(bloquesList instanceof HTMLElement)) return;
    const n = bloquesList.querySelectorAll('[data-nosotros-bloque]').length + 1;
    bloquesList.appendChild(createBloqueEl(n));
  }, { signal });

  bloquesList?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const btn = target.closest('[data-remove-bloque]');
    if (!btn) return;
    const card = btn.closest('[data-nosotros-bloque]');
    if (!(card instanceof HTMLElement) || !(bloquesList instanceof HTMLElement)) return;
    if (bloquesList.querySelectorAll('[data-nosotros-bloque]').length <= 1) {
      card.querySelectorAll('input, textarea').forEach((input) => {
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
          input.value = '';
        }
      });
      const sel = card.querySelector('[data-bloque-alineacion]');
      if (sel instanceof HTMLSelectElement) sel.value = 'alternada';
      return;
    }
    card.remove();
    renumberBloques();
  }, { signal });

  // Sync visual ios-toggle + estado de tarjetas gadget
  document.querySelectorAll('[data-marca-gadget]').forEach((input) => {
    if (!(input instanceof HTMLInputElement)) return;
    const ui = document.querySelector(`[data-marca-toggle-ui][data-for="${input.id}"]`);
    const card = input.closest('[data-gadget-card]');
    const config = card?.querySelector('[data-gadget-config]');

    const sync = () => {
      const on = input.checked;
      if (ui instanceof HTMLElement) ui.classList.toggle('is-on', on);
      input.setAttribute('aria-checked', on ? 'true' : 'false');

      if (card instanceof HTMLElement) {
        card.classList.toggle('gadget-card--on', on);
        card.classList.toggle('is-active', on);
      }

      if (config instanceof HTMLElement) {
        config.classList.toggle('is-open', on);
        config.setAttribute('aria-hidden', on ? 'false' : 'true');
      }

      // Update status badge text
      const badge = card?.querySelector('[data-gadget-status]');
      if (badge instanceof HTMLElement) {
        badge.textContent = on ? 'Activo' : 'Inactivo';
      }

      if (input.id === 'marca-menu-fondos-cinematicos') {
        const wrap = document.getElementById('categorias-fondos-wrap');
        const fondoGeneral = document.getElementById('menu-fondo-general');
        if (wrap instanceof HTMLElement) wrap.hidden = !on;
        if (fondoGeneral instanceof HTMLElement) fondoGeneral.hidden = on;
      }

      // Nutrition-specific: show/hide menu tools without leaving Identidad
      if (input.id === 'marca-gadget-nutricion') {
        document.querySelectorAll('[data-shows-when-nutricion]').forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          el.classList.toggle('hidden', !on);
          el.hidden = !on;
        });
        if (root instanceof HTMLElement) root.dataset.gadgetNutricion = on ? 'true' : 'false';
        if (!on) setNutricionBulkPanelOpen(false);
      }

      // AR gadget: sync root attr + plato modal AR section visibility
      if (input.id === 'marca-gadget-ar') {
        if (root instanceof HTMLElement) root.dataset.gadgetAr = on ? 'true' : 'false';
        document.querySelectorAll('[data-shows-when-ar]').forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          el.classList.toggle('hidden', !on);
          el.hidden = !on;
        });
      }
    };

    input.addEventListener('click', (e) => e.stopPropagation(), { signal });
    input.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Enter') e.preventDefault();
      },
      { signal },
    );
    input.addEventListener('change', sync, { signal });
    sync();

    if (input.id === 'marca-gadget-nutricion') {
      input.addEventListener(
        'change',
        async () => {
          if (!restauranteId) return;
          const prev = !input.checked;
          input.disabled = true;
          try {
            const res = await fetch('/api/update-gadget-nutricion', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                restaurante_id: restauranteId,
                activo: input.checked,
              }),
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(json.error || 'No se pudo guardar el gadget');
            showToast(
              json.message ||
                (input.checked
                  ? 'Gadget nutricional activo. En Menú aparece Carga nutricional y el botón en cada plato.'
                  : 'Gadget nutricional apagado'),
              'ok',
            );
          } catch (err) {
            input.checked = prev;
            sync();
            showToast(
              err instanceof Error ? err.message : 'Error al guardar nutrición',
              'error',
            );
          } finally {
            input.disabled = false;
          }
        },
        { signal },
      );
    }

    if (input.id === 'marca-gadget-ar') {
      input.addEventListener(
        'change',
        async () => {
          if (!restauranteId) return;
          const prev = !input.checked;
          input.disabled = true;
          try {
            const res = await fetch('/api/update-gadget-ar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                restaurante_id: restauranteId,
                activo: input.checked,
              }),
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(json.error || 'No se pudo guardar el gadget');
            showToast(
              json.message ||
                (input.checked ? 'Gadget AR activo' : 'Gadget AR apagado'),
              'ok',
            );
          } catch (err) {
            input.checked = prev;
            sync();
            showToast(
              err instanceof Error ? err.message : 'Error al guardar AR',
              'error',
            );
          } finally {
            input.disabled = false;
          }
        },
        { signal },
      );
    }
  });

  // Mantener --gadget-accent alineado con el color primario del form
  const colorPrimarioInput = document.getElementById('marca-color-primario');
  const gadgetsPanel = document.querySelector('[data-marca-panel="gadgets"]');
  const syncGadgetAccent = () => {
    if (!(gadgetsPanel instanceof HTMLElement)) return;
    if (!(colorPrimarioInput instanceof HTMLInputElement)) return;
    const v = colorPrimarioInput.value.trim();
    if (v) gadgetsPanel.style.setProperty('--gadget-accent', v);
  };
  colorPrimarioInput?.addEventListener('input', syncGadgetAccent, { signal });
  syncGadgetAccent();

  marcaForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(marcaSave instanceof HTMLButtonElement)) return;
    if (!restauranteId) {
      showToast('Restaurante no disponible', 'error');
      return;
    }

    const val = (id) => {
      const el = document.getElementById(id);
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
        return el.value;
      }
      return '';
    };

    const checked = (id) => {
      const el = document.getElementById(id);
      return el instanceof HTMLInputElement ? el.checked : false;
    };

    if (typeof syncMenuFondoHidden === 'function') syncMenuFondoHidden();
    if (typeof syncNosotrosFondoHidden === 'function') syncNosotrosFondoHidden();

    marcaSave.disabled = true;
    marcaSave.textContent = 'Guardando…';
    if (marcaFeedback) {
      marcaFeedback.classList.add('hidden');
      marcaFeedback.textContent = '';
    }

    try {
      // Ruta relativa — nunca hardcodear localhost ni dominio fijo
      const res = await fetch('/api/update-marca', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          restaurante_id: restauranteId,
          logo_url: val('marca-logo-url'),
          nombre_comercial: val('marca-nombre-comercial'),
          tagline_superior: val('marca-tagline-superior'),
          eslogan: val('marca-eslogan'),
          color_primario: val('marca-color-primario'),
          color_texto: val('marca-color-texto'),
          color_fondo: val('marca-fondo-home-valor'),
          estilo_adn: 'elegant',
          tipografia_combo: val('marca-tipografia-combo') || 'luxe-editorial',
          tipo_letra: val('marca-tipografia-combo') || 'luxe-editorial',
          custom_css: val('marca-css-avanzado'),
          css_avanzado: val('marca-css-avanzado'),
          share_image_url: val('marca-share-image-url'),
          app_icon_url: val('marca-app-icon-url'),
          home_titulo_size: Number(val('marca-home-titulo-size')) || 28,
          home_logo_size: Number(val('marca-home-logo-size')) || 160,
          home_eslogan_size: Number(val('marca-home-eslogan-size')) || 14,
          home_menu_size: Number(val('marca-home-menu-size')) || 16,
          logo_size: Number(val('marca-home-logo-size')) || 160,
          titulo_size: Number(val('marca-home-titulo-size')) || 28,
          eslogan_size: Number(val('marca-home-eslogan-size')) || 14,
          menu_size: Number(val('marca-home-menu-size')) || 16,
          home_tracking: val('marca-home-tracking'),
          // Legacy: sin input UI; sincroniza con color de eslogan para no romper CSS --home-subtitulo-color
          home_subtitulo_color: val('marca-home-eslogan-color'),
          home_titulo_color: val('marca-home-titulo-color'),
          home_eslogan_color: val('marca-home-eslogan-color'),
          home_menu_color: val('marca-home-menu-color'),
          home_subtexto_color: val('marca-home-subtexto-color'),
          home_borde_destacado_color: val('marca-home-borde-destacado-color'),
          home_overlay_opacity: Number(val('marca-home-overlay-opacity')) || 40,
          home_overlay_estilo: val('marca-home-overlay-estilo') || 'oscuro',
          home_fondo_animacion: val('marca-home-fondo-animacion') || 'in',
          home_estilo_navegacion: val('marca-home-estilo-navegacion') || 'frontal',
          home_efecto_entrada: val('marca-home-efecto-entrada') || 'ninguno',
          overlay_opacity: Number(val('marca-home-overlay-opacity')) || 40,
          overlay_estilo: val('marca-home-overlay-estilo') || 'oscuro',
          fondo_animacion: val('marca-home-fondo-animacion') || 'in',
          estilo_navegacion: val('marca-home-estilo-navegacion') || 'frontal',
          efecto_entrada: val('marca-home-efecto-entrada') || 'ninguno',
          fondo_tipo: val('marca-fondo-home-tipo'),
          fondo_valor: val('marca-fondo-home-valor'),
          titulo_color: val('marca-home-titulo-color'),
          eslogan_color: val('marca-home-eslogan-color'),
          menu_color: val('marca-home-menu-color'),
          subtexto_color: val('marca-home-subtexto-color'),
          borde_destacado_color: val('marca-home-borde-destacado-color'),
          nosotros_color_fondo: val('marca-nosotros-color-fondo'),
          nosotros_color_titulo: val('marca-nosotros-color-titulo'),
          nosotros_color_cuerpo: val('marca-nosotros-color-cuerpo'),
          ubicacion_color_fondo: val('marca-ubicacion-color-fondo'),
          ubicacion_color_titulo: val('marca-ubicacion-color-titulo'),
          ubicacion_color_cuerpo: val('marca-ubicacion-color-cuerpo'),
          fondo_home_tipo: val('marca-fondo-home-tipo'),
          fondo_home_valor: val('marca-fondo-home-valor'),
          fondo_nosotros_tipo: val('marca-fondo-nosotros-tipo'),
          fondo_nosotros_valor: val('marca-fondo-nosotros-valor'),
          fondo_menu_tipo: val('marca-fondo-menu-tipo'),
          fondo_menu_valor: val('marca-fondo-menu-valor'),
          menu_fondos_cinematicos: checked('marca-menu-fondos-cinematicos'),
          menu_font: val('marca-menu-font'),
          menu_color_texto: val('marca-menu-color-texto'),
          fondo_ubicacion_tipo: val('marca-fondo-ubicacion-tipo'),
          fondo_ubicacion_valor: val('marca-fondo-ubicacion-valor'),
          nosotros_bloques: collectNosotrosBloques(),
          coordenadas_maps: val('marca-coordenadas'),
          redes_instagram: val('marca-redes-instagram'),
          redes_facebook: val('marca-redes-facebook'),
          redes_tiktok: val('marca-redes-tiktok'),
          redes_tripadvisor: val('marca-redes-tripadvisor'),
          redes_instagram_activo: socialOn('instagram', 'marca'),
          redes_facebook_activo: socialOn('facebook', 'marca'),
          redes_tiktok_activo: socialOn('tiktok', 'marca'),
          redes_tripadvisor_activo: socialOn('tripadvisor', 'marca'),
          instagram_url: val('marca-redes-instagram'),
          whatsapp_url: val('marca-whatsapp'),
          horarios: (() => {
            syncHorarioHidden('marca');
            return val('marca-horarios');
          })(),
          categorias_fondos: collectCategoriasFondos(),
          gadget_reservas: checked('marca-gadget-reservas'),
          reservas_label: val('marca-reservas-label'),
          reservas_destino_tipo: val('marca-reservas-destino-tipo'),
          reservas_destino_valor: val('marca-reservas-destino-valor'),
          gadget_wifi: checked('marca-gadget-wifi'),
          gadget_mesero: checked('marca-gadget-mesero'),
          gadget_cuenta: checked('marca-gadget-dividir'),
          gadget_dividir_cuenta: checked('marca-gadget-dividir'),
          gadget_llamar_mesero: checked('marca-gadget-mesero'),
          gadget_wifi_ssid: val('marca-wifi-ssid'),
          gadget_wifi_clave: val('marca-wifi-password'),
          wifi_ssid: val('marca-wifi-ssid'),
          wifi_password: val('marca-wifi-password'),
          gadget_boutique: checked('marca-gadget-boutique'),
          gadget_nutricion: checked('marca-gadget-nutricion'),
          gadget_ar: checked('marca-gadget-ar'),
          boutique_productos: collectBoutiqueProductos(),
          home_theme: val('marca-home-theme') || 'editorial',
          ubicacion_theme: val('marca-ubicacion-theme') || 'modal',
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error || `No se pudo guardar (${res.status})`);

      if (root instanceof HTMLElement) {
        root.dataset.gadgetNutricion = checked('marca-gadget-nutricion') ? 'true' : 'false';
        root.dataset.gadgetAr = checked('marca-gadget-ar') ? 'true' : 'false';
      }
      document.querySelectorAll('[data-shows-when-ar]').forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const on = checked('marca-gadget-ar');
        el.classList.toggle('hidden', !on);
        el.hidden = !on;
      });

      showToast(
        json.message || '¡Identidad de marca actualizada con éxito!',
        'ok',
      );
      syncLocalOps('marca');
    } catch (err) {
      let msg = err instanceof Error ? err.message : 'Error al guardar';
      // TypeError: Failed to fetch / NetworkError → endpoint caído o sin respuesta
      if (
        err instanceof TypeError ||
        /failed to fetch|networkerror|load failed/i.test(msg)
      ) {
        msg =
          'No se pudo conectar con /api/update-marca. Revisá que el servidor esté activo y que la respuesta sea JSON.';
      }
      if (marcaFeedback) {
        marcaFeedback.textContent = msg;
        marcaFeedback.classList.remove('hidden');
        marcaFeedback.classList.add('text-rose-400');
      }
      showToast(msg, 'error');
    } finally {
      marcaSave.disabled = false;
      marcaSave.textContent = 'Guardar';
    }
  }, { signal });

  }

  document.addEventListener('astro:page-load', () => {
    try {
      initAdminDashboard();
    } catch (err) {
      console.error('Error en menú:', err);
    }
  });
  document.addEventListener('astro:before-preparation', teardownAdminDashboard);
</script>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase/browser.js';

  /** @type {AbortController | null} */
  let __alertasPageAc = null;
  /** @type {(() => void) | null} */
  let __alertasChannelCleanup = null;

  function teardownMesaAlertas() {
    __alertasPageAc?.abort();
    __alertasPageAc = null;
    __alertasChannelCleanup?.();
    __alertasChannelCleanup = null;
  }

  function initMesaAlertas() {
    teardownMesaAlertas();

    const dashRoot = document.getElementById('dashboard-root');
    const restId = String(dashRoot?.dataset.restauranteId || '').trim();
    const stack = document.getElementById('mesa-alertas-stack');
    const chimeEl = document.getElementById('mesa-alerta-chime');

    if (!restId || !(stack instanceof HTMLElement)) return;

    const ac = new AbortController();
    __alertasPageAc = ac;
    const { signal } = ac;

    const supabase = createSupabaseBrowserClient();

    /**
     * @param {string} mesa
     * @param {string} tipo
     */
    function alertaCopy(mesa, tipo) {
      if (tipo === 'cuenta') return `Mesa ${mesa} solicita la cuenta`;
      return `Mesa ${mesa} llama al mesero`;
    }

    let chimeCtx = null;

    function playChime() {
      if (chimeEl instanceof HTMLAudioElement) {
        chimeEl.currentTime = 0;
        void chimeEl.play().catch(() => {
          try {
            const AC = window.AudioContext || /** @type {any} */ (window).webkitAudioContext;
            if (!AC) return;
            if (!chimeCtx || chimeCtx.state === 'closed') {
              chimeCtx = new AC();
            }
            const ctx = chimeCtx;
            const o = ctx.createOscillator();
            const g = ctx.createGain();
            o.type = 'sine';
            o.frequency.setValueAtTime(880, ctx.currentTime);
            o.frequency.exponentialRampToValueAtTime(660, ctx.currentTime + 0.35);
            g.gain.setValueAtTime(0.0001, ctx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.02);
            g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.55);
            o.connect(g);
            g.connect(ctx.destination);
            o.start();
            o.stop(ctx.currentTime + 0.6);
          } catch {
            /* ignore */
          }
        });
      }
    }

    /**
     * @param {{ id: string, mesa: string, tipo: string }} alerta
     */
    function showAlertaCard(alerta) {
      const card = document.createElement('article');
      card.className =
        'mesa-alerta-card rounded-2xl border px-4 py-3.5 text-left shadow-lg backdrop-blur-md';
      card.dataset.alertaId = alerta.id;

      const label = document.createElement('p');
      label.className =
        'text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-emerald-300/90';
      label.textContent = 'Nueva solicitud';

      const msg = document.createElement('p');
      msg.className = 'mt-1.5 text-sm font-medium tracking-tight text-zinc-100';
      msg.textContent = alertaCopy(alerta.mesa, alerta.tipo);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'mt-3 inline-flex items-center justify-center rounded-xl bg-emerald-500 px-3.5 py-2 text-[0.55rem] font-semibold uppercase tracking-[0.16em] text-white transition hover:opacity-90 active:scale-95';
      btn.textContent = 'Marcar como atendido';

      btn.addEventListener(
        'click',
        async () => {
          btn.disabled = true;
          btn.textContent = '…';
          try {
            const res = await fetch('/api/alerta-atendida', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ alerta_id: alerta.id }),
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(json.error || 'Error');
            card.style.opacity = '0';
            card.style.transform = 'translateX(12px)';
            setTimeout(() => card.remove(), 280);
          } catch {
            btn.disabled = false;
            btn.textContent = 'Reintentar';
          }
        },
        { signal },
      );

      card.append(label, msg, btn);
      stack.prepend(card);
      playChime();
    }

    // Alertas pendientes al cargar
    void supabase
      .from('alertas_mesas')
      .select('id, mesa, tipo, atendida, created_at')
      .eq('restaurante_id', restId)
      .eq('atendida', false)
      .order('created_at', { ascending: false })
      .limit(8)
      .then(({ data, error }) => {
        if (signal.aborted) return;
        if (error) {
          console.warn('[alertas_mesas]', error.message);
          return;
        }
        (data || []).forEach((row) => {
          showAlertaCard({
            id: row.id,
            mesa: row.mesa,
            tipo: row.tipo,
          });
        });
      });

    const channel = supabase
      .channel(`alertas-mesas-${restId}`)
      .on(
        'postgres_changes',
        {
          event: 'INSERT',
          schema: 'public',
          table: 'alertas_mesas',
          filter: `restaurante_id=eq.${restId}`,
        },
        (payload) => {
          const row = payload.new;
          if (!row || row.atendida) return;
          showAlertaCard({
            id: row.id,
            mesa: row.mesa,
            tipo: row.tipo,
          });
        },
      )
      .on(
        'postgres_changes',
        {
          event: 'UPDATE',
          schema: 'public',
          table: 'alertas_mesas',
          filter: `restaurante_id=eq.${restId}`,
        },
        (payload) => {
          const row = payload.new;
          if (!row?.atendida || !row.id) return;
          const card = stack.querySelector(`[data-alerta-id="${row.id}"]`);
          card?.remove();
        },
      )
      .subscribe();

    let alertasTornDown = false;
    function teardownAlertasRealtime() {
      if (alertasTornDown) return;
      alertasTornDown = true;
      void supabase.removeChannel(channel);
      if (chimeCtx && chimeCtx.state !== 'closed') {
        void chimeCtx.close().catch(() => {});
        chimeCtx = null;
      }
    }
    __alertasChannelCleanup = teardownAlertasRealtime;
    window.addEventListener('pagehide', teardownAlertasRealtime, { signal });
    window.addEventListener('beforeunload', teardownAlertasRealtime, { signal });
  }

  document.addEventListener('astro:page-load', () => {
    try {
      initMesaAlertas();
    } catch (err) {
      console.error('Error en menú:', err);
    }
  });
  document.addEventListener('astro:before-preparation', teardownMesaAlertas);
</script>
