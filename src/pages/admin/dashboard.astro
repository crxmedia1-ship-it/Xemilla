  .id-swatch__hex {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--text-primary, #fff);
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    outline: none;
