  @media (max-width: 1023px) {
    .studio-dock {
      position: fixed;
      left: 50%;
      bottom: max(0.55rem, env(safe-area-inset-bottom));
      z-index: 70;
      display: flex;
      width: min(94vw, 26rem);
      transform: translateX(-50%);
      align-items: stretch;
      justify-content: space-around;
      gap: 0.15rem;
      padding: 0.4rem 0.35rem;
      border-radius: 1.45rem;
      border: 1px solid color-mix(in srgb, var(--border-subtle, rgba(255, 255, 255, 0.12)) 100%, transparent);
      background: color-mix(in srgb, var(--bg-card, rgba(18, 18, 18, 0.92)) 92%, transparent);
      backdrop-filter: blur(18px) saturate(1.2);
      -webkit-backdrop-filter: blur(18px) saturate(1.2);
      box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.28),
        0 1px 0 rgba(255, 255, 255, 0.06) inset;
      pointer-events: auto;
      transition:
        padding 220ms cubic-bezier(0.22, 1, 0.36, 1),
        width 220ms cubic-bezier(0.22, 1, 0.36, 1),
        border-radius 220ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 220ms ease;
      will-change: transform, padding;
    }

    /* Instagram-style: shrink on scroll down */
    .studio-dock.is-compact {
      width: min(72vw, 17.5rem);
      padding: 0.22rem 0.28rem;
      border-radius: 1.15rem;
      transform: translateX(-50%) translateY(0.15rem);
      box-shadow:
        0 10px 24px rgba(0, 0, 0, 0.22),
        0 1px 0 rgba(255, 255, 255, 0.05) inset;
    }

