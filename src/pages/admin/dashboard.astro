                            <input type="checkbox" id="marca-gadget-nutricion" name="gadget_nutricion" checked={marca.gadget_nutricion} class="peer sr-only" data-marca-gadget role="switch" aria-checked={marca.gadget_nutricion ? 'true' : 'false'} />
