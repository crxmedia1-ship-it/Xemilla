                            <label class="block space-y-1.5">
                              <span class={labelClass}>SSID · Nombre de red</span>
                              <input type="text" id="marca-wifi-ssid" name="gadget_wifi_ssid" value={marca.wifi_ssid} placeholder="Nombre de la red" class={fieldClass} />
                            </label>
                            <label class="block space-y-1.5">
                              <span class={labelClass}>Clave Wi‑Fi</span>
                              <input type="text" id="marca-wifi-password" name="gadget_wifi_clave" value={marca.wifi_password} placeholder="Contraseña" class={fieldClass} />
                            </label>
                          </div>
                        </div>
                      </article>

                      {/* ── Llamar mesero ── */}
                      <article
                        class:list={['gadget-card relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-white/[0.025] transition-all duration-300', marca.gadget_mesero && 'gadget-card--on']}
                        data-gadget-card
                        data-gadget-id="mesero"
                      >
                        <div class="flex items-start gap-3 p-4">
                          <span class="gadget-card__icon flex size-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-zinc-400 transition-colors duration-300" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 0a6 6 0 0 1 6 6v1.5a3 3 0 0 0 1.5 2.6L21 17H3l1.5-1.4A3 3 0 0 0 6 13.5V12a6 6 0 0 1 6-6zm-3.5 14a3.5 3.5 0 0 0 7 0" />
                            </svg>
                          </span>
                          <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                              <h4 class="text-sm font-semibold tracking-tight text-zinc-100">Llamar mesero</h4>
                              <span class="gadget-status" data-gadget-status>{marca.gadget_mesero ? 'Activo' : 'Inactivo'}</span>
                            </div>
                            <p class="mt-0.5 text-[11px] leading-snug text-zinc-500">Botón en la WebApp para llamar al staff de mesa.</p>
                          </div>
                          <label class="relative shrink-0 cursor-pointer pt-0.5" title="Activar Llamar mesero">
                            <input type="checkbox" id="marca-gadget-mesero" name="gadget_mesero" checked={marca.gadget_mesero} class="peer sr-only" data-marca-gadget role="switch" aria-checked={marca.gadget_mesero ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_mesero && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-mesero" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                      </article>

                      {/* ── Pedir / Dividir cuenta ── */}
                      <article
                        class:list={['gadget-card relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-white/[0.025] transition-all duration-300', marca.gadget_cuenta && 'gadget-card--on']}
                        data-gadget-card
                        data-gadget-id="dividir"
                      >
                        <div class="flex items-start gap-3 p-4">
                          <span class="gadget-card__icon flex size-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-zinc-400 transition-colors duration-300" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h.01M16 17h.01M7 17 17 7M9.5 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm8 10a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" />
                            </svg>
                          </span>
                          <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                              <h4 class="text-sm font-semibold tracking-tight text-zinc-100">Pedir / Dividir cuenta</h4>
                              <span class="gadget-status" data-gadget-status>{marca.gadget_cuenta ? 'Activo' : 'Inactivo'}</span>
                            </div>
                            <p class="mt-0.5 text-[11px] leading-snug text-zinc-500">Permite al cliente solicitar y dividir la cuenta desde la mesa.</p>
