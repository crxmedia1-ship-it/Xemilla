          gadget_mesero: checked('marca-gadget-mesero'),
          gadget_cuenta: checked('marca-gadget-dividir'),
          gadget_dividir_cuenta: checked('marca-gadget-dividir'),
          gadget_llamar_mesero: checked('marca-gadget-mesero'),
          gadget_wifi_ssid: val('marca-wifi-ssid'),
          gadget_wifi_clave: val('marca-wifi-password'),
          wifi_ssid: val('marca-wifi-ssid'),
          wifi_password: val('marca-wifi-password'),
          gadget_boutique: checked('marca-gadget-boutique'),
          boutique_productos: collectBoutiqueProductos(),
          home_theme: val('marca-home-theme') || 'editorial',
          ubicacion_theme: val('marca-ubicacion-theme') || 'modal',
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error || `No se pudo guardar (${res.status})`);

      showToast(
        json.message || '¡Identidad de marca actualizada con éxito!',
        'ok',
      );
    } catch (err) {
      let msg = err instanceof Error ? err.message : 'Error al guardar';
      // TypeError: Failed to fetch / NetworkError → endpoint caído o sin respuesta
      if (
        err instanceof TypeError ||
        /failed to fetch|networkerror|load failed/i.test(msg)
      ) {
        msg =
          'No se pudo conectar con /api/update-marca. Revisá que el servidor esté activo y que la respuesta sea JSON.';
      }
      if (marcaFeedback) {
        marcaFeedback.textContent = msg;
        marcaFeedback.classList.remove('hidden');
        marcaFeedback.classList.add('text-rose-400');
      }
      showToast(msg, 'error');
    } finally {
      marcaSave.disabled = false;
      marcaSave.textContent = '💾 Guardar';
    }
  }, { signal });

  }

  document.addEventListener('astro:page-load', () => {
    try {
      initAdminDashboard();
    } catch (err) {
      console.error('Error en menú:', err);
    }
  });
  document.addEventListener('astro:before-preparation', teardownAdminDashboard);
</script>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase/browser.js';

  /** @type {AbortController | null} */
  let __alertasPageAc = null;
  /** @type {(() => void) | null} */
  let __alertasChannelCleanup = null;

  function teardownMesaAlertas() {
    __alertasPageAc?.abort();
    __alertasPageAc = null;
    __alertasChannelCleanup?.();
    __alertasChannelCleanup = null;
  }

  function initMesaAlertas() {
    teardownMesaAlertas();

    const dashRoot = document.getElementById('dashboard-root');
    const restId = String(dashRoot?.dataset.restauranteId || '').trim();
    const stack = document.getElementById('mesa-alertas-stack');
    const chimeEl = document.getElementById('mesa-alerta-chime');

    if (!restId || !(stack instanceof HTMLElement)) return;

    const ac = new AbortController();
    __alertasPageAc = ac;
    const { signal } = ac;

    const supabase = createSupabaseBrowserClient();

    /**
     * @param {string} mesa
     * @param {string} tipo
     */
    function alertaCopy(mesa, tipo) {
      if (tipo === 'cuenta') return `Mesa ${mesa} solicita la cuenta`;
      return `Mesa ${mesa} llama al mesero`;
    }

    let chimeCtx = null;

    function playChime() {
      if (chimeEl instanceof HTMLAudioElement) {
        chimeEl.currentTime = 0;
        void chimeEl.play().catch(() => {
          try {
            const AC = window.AudioContext || /** @type {any} */ (window).webkitAudioContext;
            if (!AC) return;
            if (!chimeCtx || chimeCtx.state === 'closed') {
              chimeCtx = new AC();
            }
            const ctx = chimeCtx;
            const o = ctx.createOscillator();
            const g = ctx.createGain();
            o.type = 'sine';
            o.frequency.setValueAtTime(880, ctx.currentTime);
            o.frequency.exponentialRampToValueAtTime(660, ctx.currentTime + 0.35);
            g.gain.setValueAtTime(0.0001, ctx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.02);
            g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.55);
            o.connect(g);
            g.connect(ctx.destination);
            o.start();
            o.stop(ctx.currentTime + 0.6);
          } catch {
            /* ignore */
          }
        });
      }
    }

    /**
     * @param {{ id: string, mesa: string, tipo: string }} alerta
     */
    function showAlertaCard(alerta) {
      const card = document.createElement('article');
      card.className =
        'mesa-alerta-card rounded-2xl border px-4 py-3.5 text-left shadow-lg backdrop-blur-md';
      card.dataset.alertaId = alerta.id;

      const label = document.createElement('p');
      label.className =
        'text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-emerald-300/90';
      label.textContent = 'Nueva solicitud';

      const msg = document.createElement('p');
      msg.className = 'mt-1.5 text-sm font-medium tracking-tight text-zinc-100';
      msg.textContent = alertaCopy(alerta.mesa, alerta.tipo);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'mt-3 inline-flex items-center justify-center rounded-xl bg-emerald-500 px-3.5 py-2 text-[0.55rem] font-semibold uppercase tracking-[0.16em] text-white transition hover:opacity-90 active:scale-95';
      btn.textContent = 'Marcar como atendido';

      btn.addEventListener(
        'click',
        async () => {
          btn.disabled = true;
          btn.textContent = '…';
          try {
            const res = await fetch('/api/alerta-atendida', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ alerta_id: alerta.id }),
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(json.error || 'Error');
            card.style.opacity = '0';
            card.style.transform = 'translateX(12px)';
            setTimeout(() => card.remove(), 280);
          } catch {
            btn.disabled = false;
            btn.textContent = 'Reintentar';
          }
        },
        { signal },
      );

      card.append(label, msg, btn);
      stack.prepend(card);
      playChime();
    }

    // Alertas pendientes al cargar
    void supabase
      .from('alertas_mesas')
      .select('id, mesa, tipo, atendida, created_at')
      .eq('restaurante_id', restId)
      .eq('atendida', false)
      .order('created_at', { ascending: false })
      .limit(8)
      .then(({ data, error }) => {
        if (signal.aborted) return;
        if (error) {
          console.warn('[alertas_mesas]', error.message);
          return;
        }
        (data || []).forEach((row) => {
          showAlertaCard({
            id: row.id,
            mesa: row.mesa,
            tipo: row.tipo,
          });
        });
      });

    const channel = supabase
      .channel(`alertas-mesas-${restId}`)
      .on(
        'postgres_changes',
        {
          event: 'INSERT',
          schema: 'public',
          table: 'alertas_mesas',
          filter: `restaurante_id=eq.${restId}`,
        },
        (payload) => {
          const row = payload.new;
          if (!row || row.atendida) return;
          showAlertaCard({
            id: row.id,
            mesa: row.mesa,
            tipo: row.tipo,
          });
        },
      )
      .on(
        'postgres_changes',
        {
          event: 'UPDATE',
          schema: 'public',
          table: 'alertas_mesas',
          filter: `restaurante_id=eq.${restId}`,
        },
        (payload) => {
          const row = payload.new;
          if (!row?.atendida || !row.id) return;
          const card = stack.querySelector(`[data-alerta-id="${row.id}"]`);
          card?.remove();
        },
      )
      .subscribe();

    let alertasTornDown = false;
    function teardownAlertasRealtime() {
      if (alertasTornDown) return;
      alertasTornDown = true;
      void supabase.removeChannel(channel);
      if (chimeCtx && chimeCtx.state !== 'closed') {
        void chimeCtx.close().catch(() => {});
        chimeCtx = null;
      }
    }
    __alertasChannelCleanup = teardownAlertasRealtime;
    window.addEventListener('pagehide', teardownAlertasRealtime, { signal });
    window.addEventListener('beforeunload', teardownAlertasRealtime, { signal });
  }

  document.addEventListener('astro:page-load', () => {
    try {
      initMesaAlertas();
    } catch (err) {
      console.error('Error en menú:', err);
    }
  });
  document.addEventListener('astro:before-preparation', teardownMesaAlertas);
</script>
