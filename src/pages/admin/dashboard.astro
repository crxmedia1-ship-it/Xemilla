---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import AdminXemillaMark from '../../components/admin/AdminXemillaMark.astro';
import AdminMetricsPanel from '../../components/admin/AdminMetricsPanel.astro';
import AdminThemeSwitcher from '../../components/admin/AdminThemeSwitcher.astro';
import PerfilLocalCard from '../../components/admin/PerfilLocalCard.astro';
import { getAdminDashboardData } from '../../lib/admin.js';
import { fetchMetricsSnapshot, emptyMetricsSnapshot } from '../../lib/metrics.js';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import {
  getSuperAdminWriteClient,
} from '../../lib/superadmin.js';
import { parseBoutiqueConfig } from '../../lib/boutique.js';
import {
  normalizeHomeTheme,
  normalizeUbicacionTheme,
} from '../../lib/layout-themes.js';
import { macrosPresentIn, resolveMacroId } from '../../config/menu-macros.js';
import { platoFillUrl } from '../../lib/plato-media-url.js';
import {
  parseHorarioSemana,
  previewHorarioHoy,
} from '../../lib/horarios-semana.js';
import { ALERGENOS_OPTIONS } from '../../config/nutricion.js';
import {
  parseUiEstilo,
  HOME_PX_DEFAULTS,
  HOME_PX_RANGES,
  normalizeEstiloNavegacion,
  normalizeFondoAnimacion,
  normalizeEfectoEntrada,
  normalizeOverlayEstilo,
  parseRedesSociales,
} from '../../lib/secciones-ui.js';
import {
  TYPOGRAPHY_COMBO_OPTIONS,
  normalizeTypographyComboId,
  DEFAULT_TYPOGRAPHY_COMBO,
} from '../../config/typography-combos.js';
import {
  resolveMenuFont,
  MENU_FONT_GROUPS,
  MENU_GOOGLE_FONT_OPTIONS,
  MENU_FONTS_PREVIEW_HREF,
} from '../../config/menu-fonts.js';
import {
  getUserAdminRole,
  getAssignedRestauranteId,
  ADMIN_ROLE_SUPER,
} from '../../config/superadmin.js';
import { resolveHubCoverUrl, resolveHubLogoBg } from '../../lib/hub-media.js';
import {
  googleMapsEmbedSrc,
  mapsOpenHref,
} from '../../lib/maps-preview.js';

const restauranteId =
  Astro.url.searchParams.get('restaurante') ||
  Astro.url.searchParams.get('id') ||
  null;
const restauranteSlug = Astro.url.searchParams.get('slug') || null;

const session = await getAdminDashboardData(
  { request: Astro.request, cookies: Astro.cookies },
  { restauranteId, slug: restauranteSlug },
);

if (!session) {
  return Astro.redirect('/admin/login');
}

const {
  restaurante,
  platos: platosLoaded = [],
  categorias = [],
  managingAsSuperAdmin,
  user,
  assignedRestauranteId: sessionAssignedId,
} = session;

/** Same array loaded in SSR — table rows must map this, never a stale/empty stand-in. */
const platos = Array.isArray(platosLoaded) ? platosLoaded : [];

/** Strict SSR: true only if allowlist SuperAdmin OR metadata role === 'superadmin'. Operativo → false. */
const isSuperAdmin = getUserAdminRole(user) === ADMIN_ROLE_SUPER;
const assignedRestauranteId =
  sessionAssignedId || getAssignedRestauranteId(user);

if (!isSuperAdmin) {
  // Operativo: URL solo coherencia; SSR ya forzó metadata. Canonicalizar a asignado.
  if (assignedRestauranteId) {
    const urlMatchesAssigned =
      restauranteId === assignedRestauranteId ||
      restauranteSlug === assignedRestauranteId;
    if (!urlMatchesAssigned) {
      return Astro.redirect(
        `/admin/dashboard?restaurante=${encodeURIComponent(assignedRestauranteId)}`,
      );
    }
  } else if (restauranteId || restauranteSlug) {
    // Sin asignación: no dejar ?restaurante= / ?slug= ajenos en la URL
    return Astro.redirect('/admin/dashboard');
  }
} else if (!restauranteId && !restauranteSlug) {
  // SuperAdmin sin restaurante en la URL → hub de locales (un solo dueño, muchos locales).
  return Astro.redirect('/admin/super/dashboard');
}

const nombre = restaurante?.nombre_comercial ?? 'Sin restaurante';
const restId = restaurante?.id ?? '';
if (isSuperAdmin && restId) {
  const urlToken = String(restauranteId || restauranteSlug || '').trim();
  if (urlToken && urlToken !== restId) {
    return Astro.redirect(
      `/admin/dashboard?restaurante=${encodeURIComponent(restId)}`,
    );
  }
}
const publicSlug = String(restaurante?.slug || restauranteSlug || '').trim();
const publicWebAppUrl = publicSlug ? `/${publicSlug}` : '';
const categoriasJson = JSON.stringify(categorias);
const opsTelefono = String(
  restaurante?.whatsapp_url || restaurante?.whatsapp_num || '',
).trim();
const opsHorario = String(restaurante?.horarios || '').trim();
const horarioSemana = parseHorarioSemana(opsHorario);
const horarioHoy = previewHorarioHoy(horarioSemana);
const hubCoverUrl = resolveHubCoverUrl(restaurante || {});
const hubLogoUrl = String(restaurante?.logo_url || '').trim();
const hubLogoBg = resolveHubLogoBg(restaurante || {});
const hubNombre = String(restaurante?.nombre_comercial || nombre || '').trim();
const brandInitials = hubNombre
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w.charAt(0))
  .join('')
  .toUpperCase() || 'R';
const xemillaWordmark =
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337620/Photoroom_20260810_004814_islrgw.png';
const menuCategoryNames = [
  ...new Set(
    [
      ...categorias.map((c) => String(c?.nombre || '').trim()),
      ...platos.map((p) => String(p?.categoria_nombre || '').trim()),
    ].filter(Boolean),
  ),
];
const presentMacros = macrosPresentIn(menuCategoryNames);
/** Stable category key for DnD sync (prefer id, fallback to name). */
const menuCategoriaIdByName = new Map(
  categorias
    .filter((c) => String(c?.nombre || '').trim())
    .map((c) => [String(c.nombre).trim().toLowerCase(), c.id]),
);
function resolveMenuCategoriaId(nombre, id) {
  if (id != null && String(id).trim() !== '') return String(id);
  const key = String(nombre || '').trim().toLowerCase();
  const mapped = menuCategoriaIdByName.get(key);
  if (mapped != null && String(mapped).trim() !== '') return String(mapped);
  return String(nombre || '').trim();
}

/** Relative 1..n order within each category (not global). */
const platoRelativeOrderById = new Map();
{
  const counters = new Map();
  for (const plato of platos) {
    const key = String(plato?.categoria_id ?? plato?.categoria_nombre ?? '');
    const n = (counters.get(key) || 0) + 1;
    counters.set(key, n);
    if (plato?.id != null) platoRelativeOrderById.set(plato.id, n);
  }
}

const metricsClient = isSuperAdmin
  ? getSuperAdminWriteClient(
      createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies }),
      user,
    )
  : createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies });

const metrics = restId
  ? await fetchMetricsSnapshot(metricsClient, { restauranteId: restId, days: 30 })
  : emptyMetricsSnapshot();

function parseConfig(value) {
  if (!value) return {};
  if (typeof value === 'object') return value;
  try {
    return JSON.parse(String(value));
  } catch {
    return {};
  }
}

const configWifi = parseConfig(restaurante?.config_wifi);
const configReservas = parseConfig(restaurante?.config_reservas);
const boutiqueConfig = parseBoutiqueConfig(restaurante?.config_boutique);
const seccionesFondo = parseConfig(restaurante?.secciones_fondo);
const uiEstiloParsed = parseUiEstilo(restaurante?.ui_estilo);
const uiEstiloRaw = uiEstiloParsed;

function fondoSeccion(key, fallbackTipo = 'color', fallbackValor = '') {
  const entry = seccionesFondo?.[key] || {};
  return {
    tipo: entry.tipo || entry.type || fallbackTipo,
    valor: entry.valor || entry.value || entry.url || fallbackValor,
  };
}

function parseJsonArray(value) {
  if (Array.isArray(value)) return value;
  if (typeof value === 'string' && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
}

/** @type {Array<{ titulo: string, texto: string, media_url: string, alineacion: string }>} */
let nosotrosBloques = parseJsonArray(restaurante?.nosotros_bloques)
  .map((b) => ({
    titulo: String(b?.titulo || '').trim(),
    texto: String(b?.texto || b?.contenido || '').trim(),
    media_url: String(b?.media_url || b?.imagen || '').trim(),
    alineacion: String(b?.alineacion || 'alternada').toLowerCase() === 'inversa' ? 'inversa' : 'alternada',
  }))
  .filter((b) => b.titulo || b.texto || b.media_url);

if (nosotrosBloques.length === 0 && (restaurante?.nosotros_titulo || restaurante?.nosotros_texto || restaurante?.nosotros_imagen)) {
  nosotrosBloques = [
    {
      titulo: restaurante?.nosotros_titulo || 'Nosotros',
      texto: restaurante?.nosotros_texto || '',
      media_url: restaurante?.nosotros_imagen || '',
      alineacion: 'alternada',
    },
  ];
}

if (nosotrosBloques.length === 0) {
  nosotrosBloques = [{ titulo: '', texto: '', media_url: '', alineacion: 'alternada' }];
}

const redesParsed = parseRedesSociales(restaurante?.redes_sociales);
const redesById = Object.fromEntries(redesParsed.map((r) => [r.red, r]));
if (!redesById.instagram && restaurante?.instagram_url) {
  redesById.instagram = {
    red: 'instagram',
    url: String(restaurante.instagram_url).trim(),
    activo: true,
  };
}

function redField(id) {
  const row = redesById[id];
  const url = String(row?.url || '').trim();
  return { url, on: Boolean(url) && row?.activo !== false };
}

const opsInstagram = redField('instagram');
const opsFacebook = redField('facebook');
const opsTiktok = redField('tiktok');
const opsTripadvisor = redField('tripadvisor');
const opsMaps = String(restaurante?.coordenadas_maps || '').trim();
const opsMapsEmbed = googleMapsEmbedSrc(opsMaps);
const opsMapsOpen = mapsOpenHref(opsMaps);
const opsWifiSsid = String(
  restaurante?.gadget_wifi_ssid || configWifi?.ssid || '',
).trim();

const fondoHome = fondoSeccion(
  'home',
  restaurante?.imagen_fondo ? 'image' : 'color',
  restaurante?.imagen_fondo || restaurante?.color_fondo || '#0a0a0a',
);
const fondoNosotros = fondoSeccion('nosotros', 'color', '');
const fondoMenu = fondoSeccion('menu', 'color', '');
const fondoUbicacion = fondoSeccion('ubicacion', 'color', '');

const GLOBAL_FONT_OPTIONS = TYPOGRAPHY_COMBO_OPTIONS.map((c) => ({
  id: c.id,
  label: `${c.label} — ${c.description}`,
  value: c.id,
}));

function matchTipografiaCombo(raw) {
  return normalizeTypographyComboId(raw || DEFAULT_TYPOGRAPHY_COMBO);
}

function hexPickerValue(value, fallback = '#0a0a0a') {
  const v = String(value || '').trim();
  if (/^#[0-9a-f]{6}$/i.test(v)) return v;
  if (/^#[0-9a-f]{3}$/i.test(v)) {
    return `#${v[1]}${v[1]}${v[2]}${v[2]}${v[3]}${v[3]}`;
  }
  return fallback;
}

const marca = {
  color_primario: restaurante?.color_primario || '#9f1239',
  color_fondo: restaurante?.color_fondo || '#0a0a0a',
  color_texto: restaurante?.color_texto || '#ffffff',
  tipografia_combo: matchTipografiaCombo(
    restaurante?.tipo_letra || restaurante?.estilo_adn,
  ),
  logo_url: restaurante?.logo_url || '',
  nombre_comercial: restaurante?.nombre_comercial || nombre || '',
  tagline_superior: String(uiEstiloRaw?.home?.tagline_superior || '').trim(),
  eslogan: restaurante?.eslogan || '',
  share_image_url: restaurante?.share_image_url || '',
  app_icon_url: restaurante?.app_icon_url || '',
  home_titulo_size: uiEstiloRaw?.home?.titulo_size ?? HOME_PX_DEFAULTS.titulo,
  home_logo_size: uiEstiloRaw?.home?.logo_size ?? HOME_PX_DEFAULTS.logo,
  home_eslogan_size: uiEstiloRaw?.home?.eslogan_size ?? HOME_PX_DEFAULTS.eslogan,
  home_menu_size: uiEstiloRaw?.home?.menu_size ?? HOME_PX_DEFAULTS.menu,
  home_tracking: [
    'tracking-normal',
    'tracking-wider',
    'tracking-widest',
    'tracking-[0.3em]',
  ].includes(uiEstiloRaw?.home?.tracking)
    ? uiEstiloRaw.home.tracking
    : 'tracking-[0.3em]',
  home_subtitulo_color:
    uiEstiloRaw?.home?.subtitulo_color ||
    restaurante?.color_primario ||
    '#9f1239',
  home_titulo_color: uiEstiloRaw?.home?.titulo_color || '',
  home_eslogan_color: uiEstiloRaw?.home?.eslogan_color || '',
  home_menu_color: uiEstiloRaw?.home?.menu_color || '',
  home_subtexto_color: uiEstiloRaw?.home?.subtexto_color || '',
  home_borde_destacado_color: uiEstiloRaw?.home?.borde_destacado_color || '',
  home_overlay_opacity:
    uiEstiloRaw?.home?.overlay_opacity ?? HOME_PX_DEFAULTS.overlay_opacity,
  home_overlay_estilo: normalizeOverlayEstilo(
    uiEstiloRaw?.home?.overlay_estilo,
  ),
  home_fondo_animacion: normalizeFondoAnimacion(
    uiEstiloRaw?.home?.fondo_animacion,
  ),
  home_estilo_navegacion: normalizeEstiloNavegacion(
    uiEstiloRaw?.home?.estilo_navegacion,
  ),
  home_efecto_entrada: normalizeEfectoEntrada(
    uiEstiloRaw?.home?.efecto_entrada,
  ),
  nosotros_color_fondo: uiEstiloRaw?.nosotros?.color_fondo || '',
  nosotros_color_titulo: uiEstiloRaw?.nosotros?.color_titulo || '',
  nosotros_color_cuerpo: uiEstiloRaw?.nosotros?.color_cuerpo || '',
  ubicacion_color_fondo: uiEstiloRaw?.ubicacion?.color_fondo || '',
  ubicacion_color_titulo: uiEstiloRaw?.ubicacion?.color_titulo || '',
  ubicacion_color_cuerpo: uiEstiloRaw?.ubicacion?.color_cuerpo || '',
  /** Canónico: ui_estilo.css_avanzado; alias columna custom_css */
  css_avanzado: uiEstiloRaw?.css_avanzado || restaurante?.custom_css || '',
  custom_css: uiEstiloRaw?.css_avanzado || restaurante?.custom_css || '',
  fondo_home_tipo: fondoHome.tipo,
  fondo_home_valor: fondoHome.valor,
  fondo_nosotros_tipo: fondoNosotros.tipo,
  fondo_nosotros_valor: fondoNosotros.valor,
  fondo_menu_tipo: fondoMenu.tipo,
  fondo_menu_valor: fondoMenu.valor,
  menu_fondos_cinematicos:
    uiEstiloRaw?.menu?.fondos_cinematicos === true ||
    uiEstiloRaw?.menu?.fondos_cinematicos === false
      ? Boolean(uiEstiloRaw.menu.fondos_cinematicos)
      : (categorias || []).some((cat) => {
          const tipo = String(cat.bg_type || '').toLowerCase();
          const valor = String(cat.bg_valor || '').trim();
          return Boolean(valor) && (tipo === 'image' || tipo === 'video' || /^https?:\/\//i.test(valor));
        }),
  menu_font: resolveMenuFont(restaurante?.menu_font).family,
  menu_color_texto:
    uiEstiloRaw?.menu?.color_texto || restaurante?.color_texto || '#ffffff',
  fondo_ubicacion_tipo: fondoUbicacion.tipo,
  fondo_ubicacion_valor: fondoUbicacion.valor,
  nosotros_bloques: nosotrosBloques,
  direccion: restaurante?.direccion || '',
  coordenadas_maps: restaurante?.coordenadas_maps || '',
  redes_instagram: redesById.instagram?.url || '',
  redes_facebook: redesById.facebook?.url || '',
  redes_tiktok: redesById.tiktok?.url || '',
  redes_tripadvisor: redesById.tripadvisor?.url || '',
  whatsapp_url:
    restaurante?.whatsapp_url || restaurante?.whatsapp_num || '',
  horarios: restaurante?.horarios || '',
  gadget_wifi: Boolean(restaurante?.gadget_wifi),
  gadget_mesero: Boolean(
    restaurante?.gadget_mesero || restaurante?.gadget_llamar_mesero,
  ),
  gadget_cuenta: Boolean(
    restaurante?.gadget_cuenta || restaurante?.gadget_dividir_cuenta,
  ),
  gadget_dividir_cuenta: Boolean(
    restaurante?.gadget_cuenta || restaurante?.gadget_dividir_cuenta,
  ),
  gadget_reservas: Boolean(restaurante?.gadget_reservas),
  gadget_llamar_mesero: Boolean(
    restaurante?.gadget_mesero || restaurante?.gadget_llamar_mesero,
  ),
  wifi_ssid:
    restaurante?.gadget_wifi_ssid || configWifi.ssid || '',
  wifi_password:
    restaurante?.gadget_wifi_clave || configWifi.password || '',
  gadget_boutique: Boolean(restaurante?.gadget_boutique),
  gadget_nutricion: Boolean(restaurante?.gadget_nutricion),
  gadget_ar: Boolean(restaurante?.gadget_ar),
  boutique_productos: boutiqueConfig.productos,
  home_theme: normalizeHomeTheme(restaurante?.home_theme),
  ubicacion_theme: normalizeUbicacionTheme(restaurante?.ubicacion_theme),
  reservas_label: configReservas.label || configReservas.boton_texto || 'PEDIR / RESERVAR',
  reservas_destino_tipo:
    configReservas.destino_tipo === 'whatsapp' || configReservas.tipo === 'whatsapp'
      ? 'whatsapp'
      : 'enlace',
  reservas_destino_valor:
    configReservas.destino_valor ||
    configReservas.url ||
    configReservas.href ||
    '',
};

const fieldClass =
  'w-full rounded-md border border-zinc-800 bg-zinc-950 px-2.5 py-2 text-xs font-mono text-white outline-none transition placeholder:text-zinc-600 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/50';
const labelClass = 'text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500';
/** Glass Bento chrome. */
const bounceWallClass =
  'relative z-10 dark:bg-zinc-900/95 bg-white/80 backdrop-blur-xl border border-zinc-500/10 rounded-2xl shadow-xl';
const studioCardClass = `studio-card ${bounceWallClass} solid-obstacle hover:border-indigo-500/40 transition-all duration-300 p-4 space-y-3 gap-3`;
const colorRowClass =
  'flex items-center gap-2 rounded-full border border-white/10 bg-zinc-950/60 px-2 py-1.5';
function formatNutricionPreview(plato) {
  const parts = [];
  if (plato?.calorias != null && String(plato.calorias).trim() !== '') {
    parts.push(`${plato.calorias} kcal`);
  }
  const alergias = Array.isArray(plato?.alergias) ? plato.alergias : [];
  if (alergias.length) {
    const labels = alergias
      .map((id) => ALERGENOS_OPTIONS.find((opt) => opt.id === id)?.label || id)
      .slice(0, 3);
    parts.push(labels.join(', ') + (alergias.length > 3 ? '…' : ''));
  }
  return parts.length ? parts.join(' · ') : 'Sin ficha · clic para editar';
}

const tabPillBase =
  'dashboard-tab shrink-0 px-4 py-1.5 rounded-full text-xs font-semibold tracking-tight transition-all';
const tabPillActive = `${tabPillBase} is-on`;
const tabPillInactive = `${tabPillBase}`;

const userEmail = String(user?.email || '').trim();
const userDisplayName = (() => {
  const metaName = String(
    user?.user_metadata?.full_name ||
      user?.user_metadata?.name ||
      user?.user_metadata?.display_name ||
      '',
  ).trim();
  if (metaName) return metaName;
  const local = userEmail.split('@')[0] || 'Admin';
  return local
    .split(/[._\-\s]+/)
    .filter(Boolean)
    .map((p) => p.charAt(0).toUpperCase() + p.slice(1).toLowerCase())
    .join(' ') || 'Admin';
})();
const userRoleLabel = isSuperAdmin
  ? `${userDisplayName} (SuperAdmin)`
  : `${userDisplayName} (Operativo)`;
const userInitials = (() => {
  const parts = userDisplayName.split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return `${parts[0][0] || ''}${parts[1][0] || ''}`.toUpperCase();
  }
  const local = userEmail.split('@')[0] || '';
  const localParts = local.split(/[._\-\s]+/).filter(Boolean);
  if (localParts.length >= 2) {
    return `${localParts[0][0] || ''}${localParts[1][0] || ''}`.toUpperCase();
  }
  return (local.slice(0, 2) || 'AD').toUpperCase();
})();
const sampleBulk = isSuperAdmin
  ? `Categoría | Nombre | Descripción | Precio | Destacado | Imagen
Crudos | Edamame | Salteado con sal marina | 6.50 | SI | https://res.cloudinary.com/demo/image/upload/sample.jpg
De Tierra | Bife | Corte a la parrilla | 24.00 | NO |
Contornos | Yuca frita | Crujiente | 6.00 | NO |
Postres | Tres leches | Coco | 9.00 | SI |`
  : '';
---

<Layout
  title={`${nombre} · Menú`}
  theme="crx"
  themeColor="#09090b"
  description="Gestión masiva del menú"
  adminPanel={true}
>
  <header
    class="admin-studio-header solid-obstacle relative sticky top-0 z-50 flex w-full flex-col gap-2 border-b px-4 py-2.5 backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:px-6 sm:py-3"
  >
    {/* Top row: brand + actions */}
    <div class="flex min-w-0 items-center justify-between gap-2 sm:contents">
      <div class="flex min-w-0 items-center gap-2.5">
        <a
          href={managingAsSuperAdmin || isSuperAdmin ? '/admin/super/dashboard' : '/admin/dashboard'}
          class="admin-studio-brand shrink-0"
          aria-label="Xemilla Studio"
        >
          {
            hubLogoUrl ? (
              <span
                class="admin-studio-brand__plate admin-studio-brand__plate--logo"
                style={hubLogoBg ? `--studio-brand-plate:${hubLogoBg}` : undefined}
              >
                <img
                  src={hubLogoUrl}
                  alt=""
                  class="admin-studio-brand__logo admin-studio-brand__logo--mark"
                  width="120"
                  height="40"
                />
              </span>
            ) : restaurante ? (
              <span class="admin-studio-brand__plate admin-studio-brand__plate--mono" aria-hidden="true">
                <span class="admin-studio-brand__initials">{brandInitials}</span>
              </span>
            ) : (
              <span class="admin-studio-brand__plate admin-studio-brand__plate--xemilla">
                <img src={xemillaWordmark} alt="" class="admin-studio-brand__logo admin-studio-brand__logo--word" width="88" height="28" />
              </span>
            )
          }
          <span class="admin-studio-brand__copy">
            <span class="admin-studio-brand__eyebrow">Xemilla</span>
            <span class="admin-studio-brand__title">Studio</span>
          </span>
        </a>
      </div>

      <div class="flex shrink-0 items-center gap-2 sm:order-3 sm:gap-4">
        <div class="admin-studio-header__utils hidden items-center gap-1 md:flex">
          {
            publicWebAppUrl ? (
              <a
                href={publicWebAppUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="admin-studio-header__link"
              >
                WebApp ↗
              </a>
            ) : null
          }
          <a
            href="/admin/login"
            target="_blank"
            rel="noopener noreferrer"
            class="admin-studio-header__link"
          >
            Login ↗
          </a>
        </div>

        {
          isSuperAdmin && restaurante ? (
            <button
              type="submit"
              form="marca-form"
              id="marca-save"
              hidden
              class="admin-action-btn inline-flex items-center justify-center rounded-lg bg-white px-3 py-1.5 text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-zinc-950 transition hover:bg-zinc-100 active:scale-[0.98] disabled:opacity-50 sm:px-4"
            >
              Guardar
            </button>
          ) : null
        }

        <AdminThemeSwitcher />
        <div class="relative" data-admin-profile>
          <button
            type="button"
            id="admin-profile-trigger"
            class="admin-profile-trigger"
            aria-expanded="false"
            aria-haspopup="menu"
            aria-controls="admin-profile-menu"
            title={userEmail || 'Perfil'}
            data-admin-profile-trigger
          >
            <span class="admin-profile-trigger__initials">{userInitials}</span>
          </button>
          <div
            id="admin-profile-menu"
            class="admin-profile-dropdown"
            role="menu"
            aria-labelledby="admin-profile-trigger"
            hidden
            data-admin-profile-menu
          >
            <div class="admin-profile-dropdown__meta">
              <p class="admin-profile-dropdown__name">{userRoleLabel}</p>
              {
                userEmail ? (
                  <p class="admin-profile-dropdown__email">{userEmail}</p>
                ) : null
              }
            </div>
            <form method="POST" action="/api/admin-logout" class="admin-profile-dropdown__actions">
              <button type="submit" role="menuitem" class="admin-profile-dropdown__logout">
                Cerrar Sesión
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    {/* Nav pills — desktop centered; mobile uses bottom dock */}
    {
      restaurante ? (
        <nav
          class="admin-studio-header__nav hidden w-full items-center justify-center overflow-x-auto scrollbar-hide sm:absolute sm:left-1/2 sm:order-2 sm:flex sm:w-auto sm:-translate-x-1/2"
          role="tablist"
          aria-label="Secciones del panel"
          data-admin-top-nav
        >
          <div class="admin-studio-header__tabs flex gap-1 rounded-full p-1">
            <button
              type="button"
              role="tab"
              id="tab-menu"
              data-tab-target="menu"
              aria-selected="true"
              aria-controls="panel-menu"
              class={`${tabPillActive} active`}
            >
              Menú
            </button>
            <button
              type="button"
              role="tab"
              id="tab-metricas"
              data-tab-target="metricas"
              aria-selected="false"
              aria-controls="panel-metricas"
              class={`${tabPillInactive}`}
            >
              Métricas
            </button>
            {
              !isSuperAdmin && (
            <button
              type="button"
              role="tab"
              id="tab-perfil"
              data-tab-target="perfil"
              aria-selected="false"
              aria-controls="panel-perfil"
              class={`${tabPillInactive}`}
            >
              Perfil
            </button>
              )
            }
            {
              isSuperAdmin && (
                <button
                  type="button"
                  role="tab"
                  id="tab-identidad"
                  data-tab-target="identidad"
                  aria-selected="false"
                  aria-controls="panel-identidad"
                  class={`${tabPillInactive}`}
                >
                  Identidad
                </button>
              )
            }
          </div>
        </nav>
      ) : null
    }
  </header>

  <main class="relative z-10 min-h-[calc(100dvh-4rem)] w-full bg-transparent">
    <div class="relative z-10 mx-auto w-full max-w-[96rem] px-4 pb-[max(9.5rem,calc(env(safe-area-inset-bottom)+8rem))] pt-4 sm:px-6 sm:pb-16 sm:pt-5 lg:px-8">
    {
      !restaurante ? (
        <div class={`glass-panel ${bounceWallClass} max-w-xl p-8 text-center`}>
          <p class="text-sm text-zinc-400">
            {
              isSuperAdmin
                ? 'No encontramos ese restaurante. Volvé al hub de SuperAdmin y abrí un local.'
                : assignedRestauranteId
                ? 'Tu restaurante asignado ya no existe en la base. Pedile al SuperAdmin que te reasigne.'
                : 'No tenés un restaurante asignado. Pedile al SuperAdmin que cree tus credenciales operativas.'
            }
          </p>
          {
            isSuperAdmin ? (
              <a
                href="/admin/super/dashboard"
                class="mt-4 inline-flex text-sm font-semibold text-white underline"
              >
                Ir al hub
              </a>
            ) : null
          }
        </div>
      ) : (
        <div
          data-restaurante-id={restId}
          id="dashboard-root"
          data-categorias={categoriasJson}
          data-is-super-admin={isSuperAdmin ? 'true' : 'false'}
          data-gadget-nutricion={marca.gadget_nutricion ? 'true' : 'false'}
          data-gadget-ar={marca.gadget_ar ? 'true' : 'false'}
        >
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3 sm:mb-5">
            <div class="min-w-0">
              <h1 class="studio-resto-title">
                {nombre}
              </h1>
              <p class="mt-1.5 text-sm text-zinc-500 sm:mt-2">
                <span id="platos-count">{platos.length}</span> platos · edición en vivo
              </p>
            </div>
            {
              managingAsSuperAdmin || isSuperAdmin ? (
                <a
                  href="/admin/super/dashboard"
                  class="inline-flex items-center gap-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-zinc-500 transition hover:text-zinc-300"
                >
                  <span aria-hidden="true">←</span>
                  SuperAdmin
                </a>
              ) : null
            }
          </div>

          <div
            id="panel-menu"
            role="tabpanel"
            aria-labelledby="tab-menu"
            data-tab-panel="menu"
            class="admin-fade-in-up"
          >
          {
            isSuperAdmin && (
              <div class="menu-command mb-2">
                <div class="hidden flex-wrap items-center gap-2 sm:flex">
                  <button
                    type="button"
                    id="bulk-toggle"
                    aria-expanded="false"
                    aria-controls="bulk-panel"
                    class="menu-cmd-btn"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <path d="M12 16V4"></path>
                      <path d="M8 8l4-4 4 4"></path>
                      <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"></path>
                    </svg>
                    Carga Masiva (CSV / Texto)
                    <svg id="bulk-toggle-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300" aria-hidden="true">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </button>

                  <button
                    type="button"
                    id="nutricion-bulk-toggle"
                    data-shows-when-nutricion
                    aria-expanded="false"
                    aria-controls="nutricion-bulk-panel"
                    class:list={[
                      'menu-cmd-btn',
                      !marca.gadget_nutricion && 'hidden',
                    ]}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <path d="M4 6.75h16M6 6.75v10.5A1.5 1.5 0 0 0 7.5 18.75h9a1.5 1.5 0 0 0 1.5-1.5V6.75M9 10.5h6M9 14h4" />
                    </svg>
                    Carga nutricional
                  </button>

                  <button
                    type="button"
                    id="nuevo-plato-open"
                    data-nuevo-plato-open
                    class="menu-cmd-btn menu-cmd-btn--primary"
                  >
                    <span aria-hidden="true">+</span>
                    Nuevo Plato
                  </button>
                </div>

                {/* Mobile primary actions — full-width app bar */}
                <div class="grid grid-cols-2 gap-2 sm:hidden">
                  <button
                    type="button"
                    id="bulk-toggle-mobile"
                    aria-expanded="false"
                    aria-controls="bulk-panel"
                    class="menu-cmd-btn justify-center py-3 sm:py-2"
                  >
                    Carga masiva
                  </button>
                  <button
                    type="button"
                    data-nuevo-plato-open
                    class="menu-cmd-btn menu-cmd-btn--primary justify-center py-3 sm:py-2"
                  >
                    + Nuevo
                  </button>
                  <button
                    type="button"
                    id="nutricion-bulk-toggle-mobile"
                    data-shows-when-nutricion
                    aria-expanded="false"
                    aria-controls="nutricion-bulk-panel"
                    class:list={[
                      'col-span-2 menu-cmd-btn justify-center py-3',
                      !marca.gadget_nutricion && 'hidden',
                    ]}
                  >
                    Carga nutricional
                  </button>
                </div>

                <section
                  id="bulk-panel"
                  class={`bulk-panel glass-panel ${bounceWallClass} overflow-hidden`}
                  data-open="false"
                  aria-hidden="true"
                >
                  <div class="bulk-panel__inner p-6 lg:p-7">
                    <p class="text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-zinc-500">
                      Bulk Upload
                    </p>
                    <h2 class="mt-2 font-blacksushi-display text-2xl font-semibold tracking-tight">
                      Cargador Masivo de Menú
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-500">
                      Pegá filas con Categoría, Nombre, Descripción, Precio, Destacado e Imagen.
                      La columna Categoría define el lugar (ej. Contornos, De Tierra, Crudos); aliases como
                      Guarniciones se normalizan solos.
                    </p>
                    <p class="mt-3 max-w-2xl rounded-xl border border-white/8 bg-white/[0.03] px-3.5 py-3 text-xs leading-relaxed text-zinc-500">
                      Tip multimedia: en la columna
                      <span class="font-medium text-zinc-300">Imagen</span>
                      podés pegar URLs de Cloudinary (foto, GIF o video).
                    </p>

                    <label for="bulk-text" class="sr-only">Texto del menú</label>
                    <textarea
                      id="bulk-text"
                      rows="12"
                      spellcheck="false"
                      placeholder={sampleBulk}
                      class="mt-5 min-h-[16rem] w-full resize-y rounded-2xl border border-white/10 bg-black/35 px-4 py-4 font-mono text-[12px] leading-relaxed text-zinc-200 outline-none transition placeholder:text-zinc-700 focus:border-white/25 focus:ring-2 focus:ring-white/10"
                    ></textarea>

                    <div id="bulk-preview" class="bulk-preview mt-4 hidden" aria-live="polite">
                      <div class="bulk-preview__head">
                        <p class="bulk-preview__title">Vista previa de macros</p>
                        <p id="bulk-preview-meta" class="bulk-preview__meta"></p>
                      </div>
                      <div id="bulk-preview-summary" class="bulk-preview__summary"></div>
                      <div class="bulk-preview__table-wrap">
                        <table class="bulk-preview__table">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Plato</th>
                              <th>Categoría</th>
                              <th>Macro</th>
                              <th>Precio</th>
                            </tr>
                          </thead>
                          <tbody id="bulk-preview-body"></tbody>
                        </table>
                      </div>
                      <p id="bulk-preview-errors" class="bulk-preview__errors hidden"></p>
                    </div>

                    <p id="bulk-feedback" class="mt-3 hidden text-xs leading-relaxed" role="status"></p>

                    <button
                      type="button"
                      id="bulk-submit"
                      data-restaurante-id={restId}
                      class="admin-action-btn mt-4 inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95 disabled:opacity-50"
                    >
                      Procesar e Insertar Menú Completo
                    </button>
                  </div>
                </section>

                <section
                  id="nutricion-bulk-panel"
                  class:list={[
                    `bulk-panel glass-panel ${bounceWallClass} overflow-hidden`,
                    !marca.gadget_nutricion && 'hidden',
                  ]}
                  data-open="false"
                  data-shows-when-nutricion
                  aria-hidden="true"
                >
                  <div class="bulk-panel__inner p-6 lg:p-7">
                    <p class="text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-zinc-500">
                      Nutrición
                    </p>
                    <h2 class="mt-2 font-blacksushi-display text-2xl font-semibold tracking-tight">
                      Carga masiva nutricional
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-500">
                      Pegá un array JSON. El match es por <span class="text-zinc-300">nombre</span> de plato.
                      Campos:
                      <span class="font-mono text-zinc-400">nombre, calorias, proteinas, carbs, grasas, alergias[], ingredientes_detalle</span>.
                    </p>
                    <textarea
                      id="nutricion-bulk-text"
                      rows="8"
                      spellcheck="false"
                      placeholder='[{"nombre":"Ceviche de Pargo","calorias":220,"proteinas":28,"carbs":8,"grasas":9,"alergias":["pescado","picante"],"ingredientes_detalle":"Pargo, limón, ají…"}]'
                      class="mt-5 min-h-[12rem] w-full resize-y rounded-2xl border border-white/10 bg-black/35 px-4 py-4 font-mono text-[12px] leading-relaxed text-zinc-200 outline-none transition placeholder:text-zinc-700 focus:border-white/25 focus:ring-2 focus:ring-white/10"
                    ></textarea>
                    <div class="mt-4 flex flex-wrap items-center gap-3">
                      <button
                        type="button"
                        id="nutricion-bulk-sync"
                        class="admin-action-btn inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95 disabled:opacity-50"
                      >
                        Procesar y Sincronizar
                      </button>
                      <p id="nutricion-bulk-status" class="text-[11px] text-zinc-500" aria-live="polite"></p>
                    </div>
                  </div>
                </section>
              </div>
            )
          }

          <section class="min-w-0">
            <div
              id="platos-toolbar"
              class:list={['platos-toolbar mb-4 space-y-2 sm:mb-5', platos.length === 0 && 'hidden']}
            >
              {/* Status chips — full-width glass bento */}
              <div
                id="status-scroll"
                class="studio-status-bento w-full"
                role="toolbar"
                aria-label="Filtrar por estado"
              >
                <button type="button" data-status-filter="todas" aria-pressed="true" class="status-filter-pill is-on">
                  Todos
                </button>
                <button type="button" data-status-filter="disponibles" aria-pressed="false" class="status-filter-pill status-filter-pill--live">
                  En carta
                </button>
                <button type="button" data-status-filter="agotados" aria-pressed="false" class="status-filter-pill status-filter-pill--off">
                  Agotados
                </button>
                <button type="button" data-status-filter="destacados" aria-pressed="false" class="status-filter-pill status-filter-pill--star">
                  Destacados
                </button>
              </div>

              {/* Nivel 1: Macrocategorías */}
              <div
                id="macro-scroll"
                class="studio-macro-row scrollbar-hide w-full"
                role="toolbar"
                aria-label="Filtrar por macrocategoría"
              >
                <button
                  type="button"
                  data-macro-filter="todas"
                  aria-pressed="true"
                  class="macro-filter-pill is-on"
                >
                  Menú completo
                </button>
                {
                  presentMacros.map((macro) => (
                    <button
                      type="button"
                      data-macro-filter={macro.id}
                      aria-pressed="false"
                      class="macro-filter-pill"
                    >
                      {macro.label}
                    </button>
                  ))
                }
              </div>

              {/* Nivel 2: Subcategorías (condicional) */}
              <div
                id="subcat-scroll"
                class="studio-subcat-row scrollbar-hide w-full is-empty"
                role="toolbar"
                aria-label="Filtrar por subcategoría"
                hidden
              ></div>

              {/* Orden canónico de categorías (DnD / sync) — oculto, lo gestiona JS */}
              <div id="category-scroll" class="sr-only" aria-hidden="true"></div>

              {/* Search below filters (Workable / Xero pattern) */}
              <div class="studio-search-row mt-4 flex w-full flex-wrap items-center gap-3 sm:mt-5">
                <div class="relative min-w-0 w-full flex-1">
                  <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-600" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="M20 20l-3.5-3.5"></path>
                    </svg>
                  </span>
                  <input
                    id="platos-search"
                    type="search"
                    autocomplete="off"
                    placeholder="Buscar plato…"
                    class="studio-search-input w-full rounded-2xl border border-white/10 bg-black/40 py-3.5 pl-10 pr-4 text-base text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10 sm:rounded-xl sm:py-3 sm:text-sm"
                  />
                </div>
                <div class="flex w-full items-center justify-between gap-2 sm:w-auto sm:shrink-0">
                  <p id="search-meta" class="text-xs text-zinc-600">{platos.length} visibles</p>
                  <p id="menu-orden-status" class="text-[10px] text-zinc-500 opacity-0 transition-opacity duration-200" aria-live="polite"></p>
                </div>
              </div>
            </div>

            <div
              id="platos-empty"
              class:list={['glass-panel', bounceWallClass, 'p-10 text-center', platos.length > 0 && 'hidden']}
            >
              <p class="text-sm text-zinc-500">
                {isSuperAdmin
                  ? 'Todavía no hay platos. Usá “Nuevo Plato” o la carga masiva.'
                  : 'Todavía no hay platos en este menú.'}
              </p>
            </div>

            <div id="platos-no-results" class={`glass-panel ${bounceWallClass} mb-3 hidden p-6 text-center text-sm text-zinc-500`}>
              No hay coincidencias para esa búsqueda.
            </div>

            <div
              id="platos-table-wrap"
              class:list={['glass-panel', bounceWallClass, 'platos-table-wrap overflow-hidden', platos.length === 0 && 'hidden']}
            >
              <div class="platos-table-scroll overflow-x-auto">
                <table class="platos-table w-full border-collapse text-sm">
                  <thead>
                    <tr class="border-b border-white/8 text-[0.55rem] font-semibold uppercase tracking-[0.16em] text-zinc-600">
                      <th class="w-12 px-2 py-3" aria-label="Orden"></th>
                      <th class="px-3 py-3 text-left font-semibold">Plato</th>
                      <th class="w-[8.5rem] px-2 py-3 text-left font-semibold">Categoría</th>
                      <th class="w-[7rem] px-2 py-3 text-center font-semibold">Precio</th>
                      <th class="w-[5.75rem] px-2 py-3 text-center font-semibold">Destacado</th>
                      <th class="w-[5.75rem] px-2 py-3 text-center font-semibold">Disponible</th>
                      <th class="w-12 px-2 py-3 text-right font-semibold"><span class="sr-only">Acciones</span></th>
                    </tr>
                  </thead>
                  <tbody id="platos-tbody">
                    {
                      platos.map((plato) => (
                        <tr
                          class="platos-row border-b border-white/[0.05] transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:bg-neutral-800/50"
                          data-plato-id={plato.id}
                          data-disponible={plato.disponible ? 'true' : 'false'}
                          data-destacado={plato.destacado ? 'true' : 'false'}
                          data-imagen={plato.imagen_url || ''}
                          data-nombre={plato.nombre}
                          data-categoria={plato.categoria_nombre || ''}
                          data-categoria-id={resolveMenuCategoriaId(
                            plato.categoria_nombre,
                            plato.categoria_id,
                          )}
                          data-calorias={plato.calorias ?? ''}
                          data-proteinas={plato.proteinas ?? ''}
                          data-carbs={plato.carbs ?? ''}
                          data-grasas={plato.grasas ?? ''}
                          data-alergias={JSON.stringify(plato.alergias || [])}
                          data-ingredientes-detalle={plato.ingredientes_detalle || ''}
                          data-modelo3d-url={plato.modelo_3d_url || ''}
                          data-search={`${plato.nombre} ${plato.categoria_nombre} ${plato.descripcion || ''}`.toLowerCase()}
                        >
                          <td class="platos-cell platos-cell--order px-2 py-3.5 text-center" data-label="#">
                            <input
                              type="number"
                              min="1"
                              step="1"
                              value={platoRelativeOrderById.get(plato.id) ?? 1}
                              data-plato-id={plato.id}
                              data-dish-order
                              aria-label="Orden del plato"
                              title="Cambiar orden"
                              class="w-12 bg-transparent text-white/80 font-mono text-center border-b border-white/10 hover:border-white/30 focus:border-white focus:outline-none transition-colors appearance-none p-1 text-sm"
                            />
                          </td>
                          <td class="platos-cell platos-cell--dish px-3 py-3 text-left" data-label="Plato">
                            <div class="dish-identity">
                              <div class="dish-thumb-slot" data-media-actions>
                              {
                                plato.imagen_url ? (
                                  <button
                                    type="button"
                                    data-ver-plato
                                    title="Ver / editar media"
                                    class="dish-thumb"
                                  >
                                    <img
                                      src={platoFillUrl(plato.imagen_url, { w: 480, h: 360 })}
                                      alt=""
                                      class="dish-thumb__img"
                                      loading="lazy"
                                    />
                                  </button>
                                ) : (
                                  <label class="dish-thumb dish-thumb--empty">
                                    <input
                                      type="file"
                                      accept="image/*,video/*,image/gif"
                                      data-upload-media
                                      class="sr-only"
                                    />
                                    <span data-upload-label title="Subir media" class="dish-thumb__placeholder">
                                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                        <circle cx="12" cy="13" r="4"></circle>
                                      </svg>
                                    </span>
                                  </label>
                                )
                              }
                              </div>
                              <div class="dish-copy">
                              <div class="dish-edit-field">
                                <span class="dish-edit-field__label">Nombre</span>
                              <div class="dish-name-row">
                              <div class="dish-name-stack">
                                <button
                                  type="button"
                                  data-edit-nombre
                                  class="dish-name-btn dish-edit-hit"
                                  title="Editar nombre"
                                  aria-label={`Editar nombre: ${plato.nombre}`}
                                >
                                  <span class="dish-name-marquee" data-nombre-preview>
                                    <span class="dish-name-marquee__track">
                                      <span data-nombre-text>{plato.nombre}</span>
                                      <span class="dish-name-marquee__clone" aria-hidden="true" data-nombre-clone>
                                        {plato.nombre}
                                      </span>
                                    </span>
                                  </span>
                                </button>
                                <input
                                  type="text"
                                  value={plato.nombre}
                                  data-field="nombre"
                                  data-original={plato.nombre}
