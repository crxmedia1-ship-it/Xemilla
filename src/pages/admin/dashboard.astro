                          <label class="relative shrink-0 cursor-pointer pt-0.5" title="Activar Pedir / Dividir cuenta">
                            <input type="checkbox" id="marca-gadget-dividir" name="gadget_cuenta" checked={marca.gadget_cuenta} class="peer sr-only" data-marca-gadget role="switch" aria-checked={marca.gadget_cuenta ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_cuenta && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-dividir" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                      </article>

                      {/* ── Boutique / Tienda ── */}
                      <article
                        class:list={['gadget-card relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-white/[0.025] transition-all duration-300', marca.gadget_boutique && 'gadget-card--on']}
                        data-gadget-card
                        data-gadget-id="boutique"
                      >
                        <div class="flex items-start gap-3 p-4">
                          <span class="gadget-card__icon flex size-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-zinc-400 transition-colors duration-300" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 8.5 6 5h12l1.5 3.5M4.5 8.5V19a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1V8.5M4.5 8.5h15M9.5 12.5h5" />
                            </svg>
                          </span>
                          <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                              <h4 class="text-sm font-semibold tracking-tight text-zinc-100">Boutique / Tienda</h4>
                              <span class="gadget-status" data-gadget-status>{marca.gadget_boutique ? 'Activo' : 'Inactivo'}</span>
                            </div>
                            <p class="mt-0.5 text-[11px] leading-snug text-zinc-500">Vitrina de productos destacados en el modal de la WebApp.</p>
                          </div>
                          <label class="relative shrink-0 cursor-pointer pt-0.5" title="Activar Boutique">
                            <input type="checkbox" id="marca-gadget-boutique" name="gadget_boutique" checked={marca.gadget_boutique} class="peer sr-only" data-marca-gadget role="switch" aria-checked={marca.gadget_boutique ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_boutique && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-boutique" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
