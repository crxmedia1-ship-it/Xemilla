      background: rgba(255, 255, 255, 0.88);
      box-shadow:
        0 16px 36px rgba(15, 23, 42, 0.12),
        0 1px 0 rgba(255, 255, 255, 0.95) inset;
    }

    .studio-dock__btn {
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.18rem;
      min-height: 3.05rem;
      min-width: 0;
      border: 0;
      border-radius: 1.05rem;
      background: transparent;
      color: var(--text-muted, #a1a1aa);
      font-size: 0.62rem;
      font-weight: 650;
      letter-spacing: 0.02em;
      padding: 0.3rem 0.15rem;
      transition:
        color 160ms ease,
        background-color 160ms ease,
        transform 120ms ease,
        min-height 220ms cubic-bezier(0.22, 1, 0.36, 1),
        gap 220ms cubic-bezier(0.22, 1, 0.36, 1),
        padding 220ms cubic-bezier(0.22, 1, 0.36, 1),
        border-radius 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .studio-dock__btn svg {
      width: 1.2rem;
      height: 1.2rem;
      flex-shrink: 0;
      transition: width 220ms cubic-bezier(0.22, 1, 0.36, 1), height 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .studio-dock__btn > span {
      display: block;
      max-height: 1.2rem;
      overflow: hidden;
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity 180ms ease,
        max-height 220ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .studio-dock.is-compact .studio-dock__btn {
      min-height: 2.35rem;
      gap: 0;
      padding: 0.35rem 0.1rem;
      border-radius: 0.9rem;
    }

    .studio-dock.is-compact .studio-dock__btn svg {
      width: 1.05rem;
      height: 1.05rem;
    }

    .studio-dock.is-compact .studio-dock__btn > span {
      max-height: 0;
      opacity: 0;
      transform: translateY(0.25rem);
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .studio-dock,
      .studio-dock__btn,
      .studio-dock__btn svg,
      .studio-dock__btn > span,
      .studio-fab {
        transition: none !important;
      }
    }

    .studio-dock__btn.is-active,
    .studio-dock__btn[aria-selected='true'] {
      color: var(--text-primary, #fff);
      background: color-mix(in srgb, var(--overlay-soft, rgba(255, 255, 255, 0.08)) 100%, transparent);
    }

    html.admin-panel.light .studio-dock__btn.is-active,
    html.admin-panel[data-theme='light'] .studio-dock__btn.is-active,
    html.admin-panel.light .studio-dock__btn[aria-selected='true'],
    html.admin-panel[data-theme='light'] .studio-dock__btn[aria-selected='true'] {
      color: #18181b;
      background: rgba(24, 24, 27, 0.08);
    }

    .studio-dock__btn:active {
      transform: scale(0.96);
    }

    .studio-fab {
      position: fixed;
      right: max(1rem, env(safe-area-inset-right));
      bottom: calc(5.5rem + env(safe-area-inset-bottom));
      z-index: 68;
      display: grid;
      place-items: center;
      width: 3.35rem;
      height: 3.35rem;
      border: 0;
      border-radius: 9999px;
      background: #fff;
      color: #09090b;
      font-size: 1.65rem;
      font-weight: 500;
      line-height: 1;
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
      transition:
        bottom 220ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 140ms ease,
        opacity 140ms ease;
    }

    .studio-fab.is-dock-compact {
      bottom: calc(4.15rem + env(safe-area-inset-bottom));
    }

    html.admin-panel.light .studio-fab,
    html.admin-panel[data-theme='light'] .studio-fab {
      background: #18181b;
      color: #fff;
      box-shadow: 0 14px 32px rgba(15, 23, 42, 0.22);
    }

    .studio-fab:active {
      transform: scale(0.94);
    }

    /* Compact app chrome — height/background live in admin-themes.css */

    .platos-toolbar {
      position: relative;
      top: auto;
      z-index: 5;
      margin: 0;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      padding: 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: 0;
    }

    html.admin-panel.light .platos-toolbar,
    html.admin-panel[data-theme='light'] .platos-toolbar,
    html.admin-panel[data-theme='alabastro'] .platos-toolbar,
    html.admin-panel[data-theme='organico'] .platos-toolbar {
      background: transparent;
    }

    .platos-table-wrap {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      overflow: visible !important;
      max-width: 100%;
      min-width: 0;
    }

    .platos-table-scroll {
      overflow: visible !important;
      max-width: 100%;
      min-width: 0;
    }

    /* Break table layout on phones — Safari/WebKit glitches with table+grid mix */
    .platos-table {
      display: block !important;
      min-width: 0 !important;
      width: 100%;
      max-width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .platos-table thead {
      display: none;
    }

    .platos-table tbody {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
      max-width: 100%;
      padding-bottom: 1.25rem;
    }

    /* Shopify / Zomato style dish card — thumb lives in dish identity */
    .platos-row {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'dish dish'
        'meta dest'
        'price avail';
      gap: 0.45rem 0.65rem;
      align-items: start;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      flex-shrink: 0;
      padding: 0.85rem;
      margin: 0;
      border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08)) !important;
      border-radius: 1.25rem;
      background: var(--bg-card, rgba(24, 24, 27, 0.78));
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
      transform: none !important;
      overflow: hidden;
    }

    .platos-row:hover {
      transform: none !important;
    }

    .platos-row.hidden {
      display: none !important;
    }

    .platos-cell {
      display: block;
      padding: 0 !important;
      width: auto;
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
      text-align: left !important;
      vertical-align: top;
    }

    .platos-cell--order {
      position: absolute;
      top: 0.55rem;
      left: 0.55rem;
      z-index: 2;
      grid-area: auto;
      width: auto;
    }

    .platos-cell--order input[data-dish-order] {
      width: 1.7rem;
      min-height: 1.7rem;
      border: 0;
      border-radius: 0.55rem;
      background: rgba(0, 0, 0, 0.55);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 700;
      backdrop-filter: blur(6px);
    }

    .platos-cell--media {
      display: none !important;
    }

    .platos-cell--dish {
      grid-column: 1 / -1;
      grid-row: 1;
      min-width: 0;
      max-width: 100%;
      overflow: visible;
    }

    .dish-identity {
      display: flex;
      align-items: flex-start;
      gap: 1.15rem;
      min-width: 0;
      padding-right: 3.1rem;
    }

    .dish-thumb-slot {
      flex: 0 0 8.5rem;
      width: 8.5rem;
      aspect-ratio: 4 / 3;
      height: auto;
    }

    @media (max-width: 480px) {
      .dish-identity {
        gap: 0.85rem;
        padding-right: 0;
      }

      .dish-thumb-slot {
        flex-basis: 6.25rem;
        width: 6.25rem;
      }
    }

    .dish-thumb,
    .dish-thumb--empty {
      width: 100%;
      height: auto;
      min-width: 0;
      min-height: 0;
      max-width: none;
      max-height: none;
      aspect-ratio: 4 / 3;
      border-radius: 0.95rem;
    }

    .dish-copy {
      display: flex;
      min-width: 0;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 0.65rem;
    }

    .platos-cell--dish .field-inline,
    .platos-cell--dish [data-edit-descripcion] {
      max-width: none !important;
      width: 100%;
    }

    .dish-name-stack {
      position: relative;
      width: 100%;
      min-width: 0;
    }

    .dish-name-btn {
      display: block;
      width: 100%;
      min-width: 0;
      margin: 0;
      cursor: pointer;
      color: inherit;
      -webkit-tap-highlight-color: transparent;
    }

    .dish-name-input {
      display: none !important;
    }

    .dish-name-marquee {
      display: block;
      overflow: hidden;
      width: 100%;
      mask-image: linear-gradient(90deg, #000 0%, #000 88%, transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 88%, transparent 100%);
    }

    .dish-name-marquee__track {
      display: inline-flex;
      align-items: center;
      width: max-content;
      max-width: none;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.25;
      color: var(--text-primary, #fff);
      white-space: nowrap;
      will-change: transform;
    }

    .dish-name-marquee__track > span {
      padding-right: 1.85rem;
    }

    .dish-name-marquee.is-overflow .dish-name-marquee__track {
      animation-name: studio-dish-marquee;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    .dish-name-marquee:not(.is-overflow) .dish-name-marquee__clone {
      display: none;
    }

    .dish-name-btn:active .dish-name-marquee__track {
      opacity: 0.72;
    }

    .platos-cell--dish .field-inline {
      font-size: 0.875rem;
      font-weight: 650;
      letter-spacing: -0.02em;
      padding: 0.05rem 0;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .platos-cell--dish [data-descripcion-preview] {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 0.6875rem;
      line-height: 1.35;
    }

    .platos-cell--dish [data-field-saved] {
      display: none;
    }

    .nut-edit-btn {
      position: relative;
      z-index: 4;
      width: 100%;
      max-width: none;
      min-height: 2.85rem;
      margin-top: 0;
      padding: 0.7rem 0.85rem;
      border-radius: 0.95rem;
      pointer-events: auto;
    }

    .dish-gadget-stack {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      width: 100%;
      margin-top: 0.7rem;
    }

    .dish-gadget-stack:not(:has(.nut-edit-btn:not(.hidden):not([hidden]))) {
      display: none;
      margin-top: 0;
    }

    .nut-edit-btn__title {
      font-size: 0.72rem;
      letter-spacing: 0.06em;
    }

    .nut-edit-btn__preview {
      font-size: 0.78rem;
    }

    .platos-cell--destacado {
      grid-area: dest;
      align-self: center;
      justify-self: end;
      width: auto;
      padding: 0 !important;
      z-index: 5;
    }

    .platos-cell--cat {
      grid-area: meta;
      display: inline-flex;
      align-items: center;
      width: auto;
      max-width: 100%;
      padding: 0.28rem 0.55rem !important;
      border-radius: 9999px;
      background: color-mix(in srgb, var(--overlay-soft, rgba(255, 255, 255, 0.06)) 100%, transparent);
      font-size: 0.68rem !important;
      font-weight: 600;
      color: var(--text-muted, #a1a1aa) !important;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .platos-cell--precio {
      grid-area: price;
      display: flex;
      align-items: center;
      margin-top: 0.1rem;
      min-width: 0;
    }

    .platos-cell--precio .precio-input {
      width: 5.5rem;
      min-height: 2.6rem;
      border-radius: 0.9rem;
      border: 1px solid color-mix(in srgb, var(--border-subtle, rgba(255, 255, 255, 0.12)) 100%, transparent);
      background: color-mix(in srgb, var(--overlay-soft, rgba(255, 255, 255, 0.04)) 100%, transparent);
      font-size: 1.02rem;
      font-weight: 650;
    }

    .platos-cell--disponible {
      grid-area: avail;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      justify-self: end;
      min-height: 2.6rem;
      width: auto;
      margin-top: 0.1rem;
      padding: 0.25rem 0.4rem 0.25rem 0.65rem !important;
      border-radius: 9999px;
      background: color-mix(in srgb, var(--overlay-soft, rgba(255, 255, 255, 0.05)) 100%, transparent);
    }

    .platos-cell--cat::before,
    .platos-cell--destacado::before,
    .platos-cell--disponible::before,
    .platos-cell--order::before,
    .platos-cell--dish::before,
    .platos-cell--precio::before,
    .platos-cell--media::before {
      content: none;
    }

    .platos-cell--disponible::after {
      content: 'En carta';
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-soft, #71717a);
      order: -1;
    }

    .platos-row[data-disponible='false'] .platos-cell--disponible::after {
      content: 'Agotado';
      color: #fb7185;
    }

    #nutricion-modal {
      z-index: 120;
      align-items: center;
      justify-content: center;
      padding:
        max(0.85rem, env(safe-area-inset-top))
        max(0.85rem, env(safe-area-inset-right))
        max(0.85rem, env(safe-area-inset-bottom))
        max(0.85rem, env(safe-area-inset-left));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    #nutricion-modal .modal-card {
      width: min(100%, 26rem);
      max-height: min(88dvh, 36rem);
      margin: auto;
      border-radius: 1.25rem;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    #nutricion-modal .nutricion-modal__head {
      flex-shrink: 0;
    }

    #nutricion-modal .nutricion-modal__body {
      flex: 1 1 auto;
      min-height: 0;
      max-height: none;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 1rem;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
    }

    #nutricion-modal #nutricion-modal-title {
      font-size: 1.05rem;
      line-height: 1.25;
    }

    #nutricion-modal .grid.grid-cols-2 {
      gap: 0.5rem;
    }

    #nutricion-modal .nut-metric {
      padding: 0.55rem 0.5rem;
    }

    #nutricion-modal .nut-metric input {
      font-size: 0.95rem;
    }

    #nutricion-modal .nut-chip {
      font-size: 0.68rem;
      padding: 0.42rem 0.65rem;
    }

    #nutricion-modal .nut-save-btn {
      width: 100%;
      min-height: 2.65rem;
      margin-top: 0.25rem;
    }

    .platos-row[data-disponible='false'] {
      opacity: 0.78;
    }

    .ios-toggle {
      width: 3.05rem;
      height: 1.78rem;
      flex-shrink: 0;
    }

    .ios-toggle__knob {
      width: 1.42rem;
      height: 1.42rem;
    }

    .ios-toggle.is-on .ios-toggle__knob {
      transform: translateX(1.28rem);
    }

    /* Hide redundant page hero on phone — name lives in header */
    #dashboard-root > .mb-5,
    #dashboard-root > .mb-8 {
      display: none;
    }

    /* Force-hide between sm–md handled via Tailwind + layout; no escaped class selectors (breaks lightningcss). */

    /* Extra clearance under last menu content for dock + FAB */
    #panel-menu,
    #panel-metricas,
    #panel-perfil,
    #panel-identidad {
      padding-bottom: 0.5rem;
    }

    .crx-toast {
      bottom: calc(6.25rem + env(safe-area-inset-bottom)) !important;
    }
  }

  @media (min-width: 1024px) {
    .status-filter-pill {
      min-height: 0;
