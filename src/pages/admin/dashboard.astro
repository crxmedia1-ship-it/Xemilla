            <form id="marca-form" class="relative z-10 space-y-4" novalidate>
              <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
                <h2 class="font-blacksushi-display text-lg font-semibold tracking-tight text-white">
                  Identidad de Marca
                </h2>
              </div>

              <div class="space-y-4">
                <nav
                  class="flex gap-1 overflow-x-auto pb-0.5"
                  role="tablist"
                  aria-label="Subsecciones de identidad"
                  id="marca-subnav"
                >
                  {
                    [
                      { id: 'home', label: 'Home / Core' },
                      { id: 'nosotros', label: 'Nosotros' },
                      { id: 'menu', label: 'Menú' },
                      { id: 'ubicacion', label: 'Horarios y Ubicación' },
                      { id: 'reservas', label: 'Reservas' },
                      { id: 'gadgets', label: 'Gadgets' },
                      { id: 'qr', label: 'QR & Impresión' },
                    ].map((tab, i) => (
                      <button
                        type="button"
                        role="tab"
                        data-marca-subtab={tab.id}
                        aria-selected={i === 0 ? 'true' : 'false'}
                        class:list={[
                          'marca-subtab shrink-0 whitespace-nowrap rounded-full px-3.5 py-1.5 text-xs font-medium transition-all',
                          i === 0
                            ? 'bg-white/10 text-white'
                            : 'text-zinc-400 hover:bg-white/5 hover:text-white',
                        ]}
                      >
                        {tab.label}
                      </button>
                    ))
                  }
                </nav>

                <div class="min-w-0 space-y-4">
                  {/* —— HOME / CORE —— */}
                  <div data-marca-panel="home" class="overflow-visible">
                    <div
                      class="relative z-10 grid grid-cols-1 gap-4 lg:grid-cols-2"
                      data-marca-home-controls
                      style={`--color-acento: ${marca.color_primario || '#818cf8'};`}
                    >

                    {/* 1 — Estructura & Layout */}
                    <section class={`${studioCardClass} lg:col-span-2`} aria-labelledby="marca-sec-estructura">
                      <div class="flex flex-wrap items-end justify-between gap-2">
                        <div>
                          <p id="marca-sec-estructura" class={identidadHeadingClass}>Estructura &amp; Layout</p>
                          <p class="mt-1 text-[11px] leading-relaxed text-zinc-500">
                            Elige la composición del Home. La navegación se deriva del layout.
                          </p>
                        </div>
                      </div>

                      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" role="radiogroup" aria-label="Layout del Home">
                        {
                          HOME_LAYOUT_OPTIONS.map((opt) => {
                            const selected = marca.home_layout === opt.id;
                            return (
                              <label
                                class:list={[
                                  'home-layout-card',
                                  studioLayoutCardBase,
                                  selected ? studioLayoutCardActive : studioLayoutCardIdle,
                                ]}
                              >
                                <input
                                  type="radio"
                                  name="home_layout"
                                  value={opt.id}
                                  class="sr-only"
                                  checked={selected}
                                  data-home-layout-option
                                  data-home-theme={opt.theme}
                                />
                                <span class="flex items-start justify-between gap-2">
                                  <span class="text-[0.74rem] font-semibold tracking-[0.04em]">
                                    {opt.label}
                                  </span>
                                  <span
                                    class:list={[
                                      'shrink-0',
                                      selected ? studioLayoutBadgeActive : 'hidden',
                                    ]}
                                    data-home-layout-activo
                                  >
                                    ACTIVO
                                  </span>
                                </span>
                                <span class="text-[11px] leading-snug text-neutral-400">{opt.hint}</span>
                                <span
                                  class:list={[
                                    'mt-auto inline-flex w-fit rounded-full px-2 py-0.5 text-[0.58rem] font-semibold uppercase tracking-[0.12em]',
                                    selected
                                      ? 'bg-emerald-600/15 text-emerald-800 dark:bg-emerald-400/20 dark:text-emerald-200'
                                      : 'bg-zinc-200/60 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400',
                                  ]}
                                >
                                  {opt.navBadge ?? 'Frontal'}
                                </span>
                              </label>
                            );
                          })
                        }
                      </div>
                      <input type="hidden" id="marca-home-theme" name="home_theme" value={marca.home_theme} data-home-theme-input />
                      <input type="hidden" id="marca-home-nav" name="estilo_navegacion" value={resolvedHomeMarca.estiloNavegacion} />
                    </section>

                    {/* Columna izquierda — Identidad & Textos */}
                    <section class={`${studioCardClass} !pb-5`} aria-labelledby="marca-sec-identidad-textos">
                      <p id="marca-sec-identidad-textos" class={identidadHeadingClass}>Identidad &amp; Textos</p>

                      <label class="block space-y-1.5">
                        <span class={labelClass}>Combo Tipográfico</span>
                        <select id="marca-tipografia-combo" name="tipografia_combo" class={fieldClass}>
                          {
                            GLOBAL_FONT_OPTIONS.map((opt) => (
                              <option value={opt.value} selected={marca.tipografia_combo === opt.value}>
                                {opt.label}
                              </option>
                            ))
                          }
                        </select>
                      </label>

                      <label class="block space-y-1.5">
                        <span class={labelClass}>Texto Superior</span>
                        <input type="text" id="marca-tagline-superior" name="tagline_superior" value={marca.tagline_superior} placeholder="Sushi de autor · Temporada" class={fieldClass} />
                        <span class="block text-[10px] leading-snug text-zinc-500">Línea corta encima del logo (opcional). Si está vacío o igual al slogan, no se muestra.</span>
                      </label>

                      <label class="block space-y-1.5">
                        <span class={labelClass}>Título Principal</span>
                        <input type="text" id="marca-nombre-comercial" name="nombre_comercial" value={marca.nombre_comercial} placeholder={nombre} class={fieldClass} />
                      </label>

                      <label class="block space-y-1.5">
                        <span class={labelClass}>Slogan</span>
                        <input type="text" id="marca-eslogan" name="eslogan" value={marca.eslogan} placeholder="Savor Asian fusion delights." class={fieldClass} />
                        <span class="block text-[10px] leading-snug text-zinc-500">Frase debajo del logo en el Home Editorial (y otros themes).</span>
                      </label>

                      <div class="rounded-xl border border-white/15 bg-transparent px-4 py-3">
                        <p class="mb-3 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-zinc-500">Escalas</p>
                        <div class="grid grid-cols-2 gap-x-4 gap-y-3.5">
                          {
                            [
                              { id: 'marca-home-logo-size', name: 'logo_size', label: 'Logo', value: marca.home_logo_size, min: HOME_PX_RANGES.logo.min, max: HOME_PX_RANGES.logo.max },
                              { id: 'marca-home-titulo-size', name: 'titulo_size', label: 'Título', value: marca.home_titulo_size, min: HOME_PX_RANGES.titulo.min, max: HOME_PX_RANGES.titulo.max },
                              { id: 'marca-home-eslogan-size', name: 'eslogan_size', label: 'Eslogan', value: marca.home_eslogan_size, min: HOME_PX_RANGES.eslogan.min, max: HOME_PX_RANGES.eslogan.max },
                              { id: 'marca-home-menu-size', name: 'menu_size', label: 'Menú', value: marca.home_menu_size, min: HOME_PX_RANGES.menu.min, max: HOME_PX_RANGES.menu.max },
                            ].map((field) => (
                              <label class="block min-w-0 space-y-1.5" for={field.id}>
                                <span class="flex items-center justify-between gap-2 px-0.5">
                                  <span class="text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-zinc-400">{field.label}</span>
                                  <span class={identidadRangeValueClass}>
                                    <span data-px-value-for={field.id}>{field.value}</span> px
                                  </span>
                                </span>
                                <input type="number" id={field.id} name={field.name} value={field.value} min={field.min} max={field.max} step="1" inputmode="numeric" class="sr-only" tabindex="-1" aria-hidden="true" />
                                <input type="range" min={field.min} max={field.max} step="1" value={field.value} data-px-slider-for={field.id} class={identidadRangeClass} aria-label={`${field.label} tamaño`} />
                              </label>
                            ))
                          }
                        </div>
                      </div>
                    </section>

                    {/* Columna derecha — Logo & Atmósfera */}
                    <section class={studioCardClass} aria-labelledby="marca-sec-logo-atmosfera">
                      <p id="marca-sec-logo-atmosfera" class={identidadHeadingClass}>Logo &amp; Atmósfera</p>

                      <div class="flex items-center gap-5 rounded-xl border border-white/15 bg-transparent px-4 py-4">
                        <div
                          class="relative flex size-[5.25rem] shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/20 bg-white/[0.03]"
                          data-logo-preview
                          aria-hidden="true"
                        >
                          <img
                            class="size-full object-contain p-2.5"
                            data-logo-preview-img
                            src={marca.logo_url || undefined}
                            alt=""
                            hidden={!marca.logo_url}
                            loading="lazy"
                            decoding="async"
                          />
                          <span
                            class="flex h-full w-full items-center justify-center text-neutral-400"
                            data-logo-preview-ph
                            hidden={Boolean(marca.logo_url)}
                          >
                            <svg class="h-6 w-6 shrink-0 stroke-[1.5] text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                              <path d="M4.5 7.5h2.2l1.1-1.8h8.4l1.1 1.8h2.2A1.5 1.5 0 0 1 21 9v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18V9a1.5 1.5 0 0 1 1.5-1.5Z" stroke-linejoin="round" />
                              <circle cx="12" cy="13.25" r="3.25" />
                            </svg>
                          </span>
                        </div>
                        <div class="min-w-0 flex-1 space-y-3">
                          <div class="space-y-1">
                            <p class="text-[0.72rem] font-medium text-zinc-200">Logo del restaurante</p>
                            <p class="text-[11px] leading-snug text-zinc-500">Sube una imagen o pega una URL. El enlace largo queda oculto.</p>
                          </div>
                          <div class="flex flex-wrap gap-2.5">
                            <label class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-white/15 bg-transparent px-3.5 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-white transition hover:border-white/30 hover:bg-white/[0.06]">
                              Cambiar Logo
                              <input type="file" accept="image/*" class="sr-only" data-home-logo-file />
                            </label>
                            <button
                              type="button"
                              class="rounded-lg border border-white/15 bg-transparent px-3.5 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-zinc-400 transition hover:border-white/30 hover:text-zinc-200"
                              data-home-logo-url-toggle
                            >
                              URL
                            </button>
                          </div>
                          <input
                            type="url"
                            id="marca-logo-url"
                            name="logo_url"
                            value={marca.logo_url}
                            placeholder="https://…"
                            class={`${fieldClass} hidden`}
                            data-logo-url-input
                            data-home-logo-url-field
                          />
                        </div>
                      </div>

                      <div class="grid grid-cols-3 gap-3 rounded-xl border border-white/15 bg-transparent px-3 py-3">
                        <label class="block min-w-0 space-y-1.5">
                          <span class="text-xs font-mono text-zinc-400">Fondo</span>
                          <div class="flex items-center gap-2 rounded-full border border-white/15 bg-transparent px-2 py-1.5">
                            <input type="color" id="marca-color-fondo-picker" value={hexPickerValue(marca.fondo_home_tipo === 'color' ? marca.fondo_home_valor : marca.color_fondo, '#0a0a0a')} class="h-7 w-7 shrink-0 cursor-pointer rounded-full border-0 bg-transparent p-0" data-home-fondo-color-picker />
                            <input type="text" id="marca-color-fondo" name="color_fondo_hint" value={marca.fondo_home_tipo === 'color' ? marca.fondo_home_valor : marca.color_fondo} placeholder="#0a0a0a" spellcheck="false" class="min-w-0 flex-1 border-0 bg-transparent px-0.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-zinc-300 outline-none placeholder:text-zinc-600" data-home-fondo-color-text />
                          </div>
                        </label>
                        <label class="block min-w-0 space-y-1.5">
                          <span class="text-xs font-mono text-zinc-400">Texto Primario</span>
                          <div class="flex items-center gap-2 rounded-full border border-white/15 bg-transparent px-2 py-1.5">
                            <input type="color" id="marca-home-titulo-color-picker" value={marca.home_titulo_color || marca.color_texto || '#ffffff'} class="h-7 w-7 shrink-0 cursor-pointer rounded-full border-0 bg-transparent p-0" />
                            <input type="text" id="marca-home-titulo-color" name="titulo_color" value={marca.home_titulo_color || marca.color_texto || '#ffffff'} placeholder="#ffffff" spellcheck="false" class="min-w-0 flex-1 border-0 bg-transparent px-0.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-zinc-300 outline-none placeholder:text-zinc-600" />
                          </div>
                        </label>
                        <label class="block min-w-0 space-y-1.5">
                          <span class="text-xs font-mono text-zinc-400">Acento</span>
                          <div class="flex items-center gap-2 rounded-full border border-white/15 bg-transparent px-2 py-1.5">
                            <input type="color" id="marca-color-primario-picker" value={marca.color_primario} class="h-7 w-7 shrink-0 cursor-pointer rounded-full border-0 bg-transparent p-0" />
                            <input type="text" id="marca-color-primario" name="color_primario" value={marca.color_primario} placeholder="#9f1239" spellcheck="false" class="min-w-0 flex-1 border-0 bg-transparent px-0.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wide text-zinc-300 outline-none placeholder:text-zinc-600" />
                          </div>
                        </label>
                      </div>
                      <input type="hidden" id="marca-color-texto" name="color_texto" value={marca.color_texto || '#ffffff'} />
                      <input type="hidden" id="marca-home-eslogan-color" name="eslogan_color" value={marca.home_eslogan_color || marca.home_subtitulo_color || ''} />
                      <input type="hidden" id="marca-home-menu-color" name="menu_color" value={marca.home_menu_color || marca.color_texto || ''} />
                      <input type="hidden" id="marca-home-borde-destacado-color" name="borde_destacado_color" value={marca.home_borde_destacado_color || marca.color_primario || ''} />
                      <input type="hidden" id="marca-home-subtexto-color" name="subtexto_color" value={marca.home_subtexto_color || marca.color_primario || '#9f1239'} />

                      <label class="block space-y-1.5">
                        <span class={labelClass}>Tipo Fondo</span>
                        <select id="marca-fondo-home-tipo" name="fondo_home_tipo" data-fondo-tipo="home" data-fondo-valor-target="marca-fondo-home-valor" class={fieldClass}>
                          <option value="color" selected={marca.fondo_home_tipo === 'color'}>Color sólido</option>
                          <option value="image" selected={marca.fondo_home_tipo === 'image'}>Imagen</option>
                          <option value="carrusel" selected={marca.fondo_home_tipo === 'carrusel'}>Carrusel</option>
                          <option value="video" selected={marca.fondo_home_tipo === 'video'}>Video URL</option>
                        </select>
                      </label>

                      <label class="block space-y-1.5" for="marca-fondo-home-valor" data-home-fondo-valor-wrap>
                        <span class={labelClass} data-fondo-valor-label="home">
                          {marca.fondo_home_tipo === 'carrusel'
                            ? 'URLs del carrusel'
                            : marca.fondo_home_tipo === 'video'
                              ? 'Video URL'
                              : marca.fondo_home_tipo === 'image'
                                ? 'Imagen URL'
                                : 'Color de fondo'}
                        </span>
                        <textarea
                          id="marca-fondo-home-valor"
                          name="fondo_home_valor"
                          rows={marca.fondo_home_tipo === 'carrusel' ? 3 : 2}
                          placeholder={
                            marca.fondo_home_tipo === 'carrusel'
                              ? 'https://…/foto1.jpg\nhttps://…/foto2.jpg'
                              : marca.fondo_home_tipo === 'video'
                                ? 'https://…/video.mp4'
                                : marca.fondo_home_tipo === 'image'
                                  ? 'https://…/imagen.jpg'
                                  : '#0a0a0a'
                          }
                          class={`${fieldClass} min-h-[2.5rem] resize-y leading-relaxed`}
                        >{marca.fondo_home_valor}</textarea>
                      </label>

                      <label class="block space-y-1.5" for="marca-home-overlay-estilo">
                        <span class={labelClass}>Overlay</span>
                        <select id="marca-home-overlay-estilo" name="home_overlay_estilo" data-overlay-estilo-home class={fieldClass}>
                          <option value="puro" selected={marca.home_overlay_estilo === 'puro'}>Puro</option>
                          <option value="gradiente" selected={marca.home_overlay_estilo === 'gradiente'}>Gradiente</option>
                          <option value="vineta" selected={marca.home_overlay_estilo === 'vineta'}>Viñeta</option>
                          <option value="oscuro" selected={marca.home_overlay_estilo === 'oscuro' || !marca.home_overlay_estilo}>Oscuro</option>
                          <option value="cinematico" selected={marca.home_overlay_estilo === 'cinematico'}>Cinemático</option>
                        </select>
                      </label>

                      <div
                        class="space-y-1.5"
                        data-overlay-oscuro-controls
                        hidden={
                          marca.home_overlay_estilo !== 'oscuro' &&
                          marca.home_overlay_estilo !== 'cinematico' &&
                          Boolean(marca.home_overlay_estilo)
                        }
                      >
                        <div>
                          <div class="mb-1.5 flex items-center justify-between">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Opacidad Overlay</span>
                            <span
                              id="overlay-opacity-val"
                              class="font-mono text-xs font-bold text-zinc-900 dark:text-zinc-100"
                            >{marca.home_overlay_opacity}%</span>
                          </div>
                          <input
                            type="range"
                            id="marca-home-overlay-opacity"
                            name="home_overlay_opacity"
                            min={HOME_PX_RANGES.overlay.min}
                            max={HOME_PX_RANGES.overlay.max}
                            step="5"
                            value={marca.home_overlay_opacity}
                            class="h-1.5 w-full cursor-pointer appearance-none rounded-lg bg-zinc-200 accent-emerald-500 dark:bg-zinc-800"
                            aria-label="Opacidad Overlay"
                            data-overlay-opacity-range
                          />
                        </div>
                      </div>
                    </section>

                    {/* Cinemática & Efectos */}
                    <section class={`${studioCardClass} lg:col-span-2`} aria-labelledby="marca-sec-cinematica">
                      <p id="marca-sec-cinematica" class={identidadHeadingClass}>Cinemática &amp; Efectos</p>
                      <div class="grid gap-4 md:grid-cols-3">
                        <label class="block space-y-1.5" for="marca-home-efecto-entrada">
                          <span class={labelClass}>Animación de Entrada</span>
                          <select id="marca-home-efecto-entrada" name="home_efecto_entrada" class={fieldClass}>
                            <option value="reveal" selected={marca.home_efecto_entrada === 'reveal'}>Text Reveal</option>
                            <option value="rise" selected={marca.home_efecto_entrada === 'rise'}>Fade Up</option>
                            <option value="blur" selected={marca.home_efecto_entrada === 'blur'}>Scale Blur</option>
                            <option value="zoom" selected={marca.home_efecto_entrada === 'zoom'}>Zoom-In</option>
                            <option value="tracking" selected={marca.home_efecto_entrada === 'tracking'}>Tracking</option>
                            <option value="ninguno" selected={marca.home_efecto_entrada === 'ninguno' || !marca.home_efecto_entrada}>Ninguno</option>
                          </select>
                        </label>

                        <label class="block space-y-1.5" for="marca-home-fondo-animacion">
                          <span class={labelClass}>Animación de Fondo</span>
                          <select id="marca-home-fondo-animacion" name="home_fondo_animacion" data-fondo-animacion-home class={fieldClass}>
                            <option value="in" selected={marca.home_fondo_animacion === 'in' || !marca.home_fondo_animacion}>Slow Zoom / Ken Burns</option>
                            <option value="out" selected={marca.home_fondo_animacion === 'out'}>Zoom Out</option>
                            <option value="pan" selected={marca.home_fondo_animacion === 'pan'}>Pan</option>
                            <option value="float" selected={marca.home_fondo_animacion === 'float'}>Float</option>
                            <option value="glow" selected={marca.home_fondo_animacion === 'glow'}>Glow</option>
                            <option value="ninguna" selected={marca.home_fondo_animacion === 'ninguna'}>Static</option>
                          </select>
                        </label>

                        <label class="block space-y-1.5">
                          <span class={labelClass}>Estilo Botones / Badges</span>
                          <select id="marca-home-tracking" name="home_tracking" class={fieldClass}>
                            <option value="tracking-normal" selected={marca.home_tracking === 'tracking-normal'}>Compacto</option>
                            <option value="tracking-wider" selected={marca.home_tracking === 'tracking-wider'}>Normal</option>
                            <option value="tracking-widest" selected={marca.home_tracking === 'tracking-widest'}>Amplio</option>
                            <option value="tracking-[0.3em]" selected={marca.home_tracking === 'tracking-[0.3em]'}>Editorial</option>
                          </select>
                        </label>
                      </div>

                      <label
                        class:list={['mt-1 block space-y-1.5', !marcaHasOperationalGadgets && 'hidden']}
                        for="marca-home-gadget-servicios-estilo"
                        data-shows-when-operational-gadgets
                        hidden={!marcaHasOperationalGadgets}
                      >
                        <span class={labelClass}>Servicios de mesa</span>
                        <select id="marca-home-gadget-servicios-estilo" name="home_gadget_servicios_estilo" class={fieldClass}>
                          <option value="drawer" selected={marca.home_gadget_servicios_estilo === 'drawer' || !marca.home_gadget_servicios_estilo}>
                            Drawer (panel inferior)
                          </option>
                          <option value="radial" selected={marca.home_gadget_servicios_estilo === 'radial'}>
                            Radial (botones en arco)
                          </option>
                        </select>
                      </label>
                    </section>

                    {/* Avanzado — acordeón */}
                    <details class={`${studioCardClass} lg:col-span-2 group`} aria-labelledby="marca-sec-avanzado">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
                        <div>
                          <p id="marca-sec-avanzado" class={identidadHeadingClass}>Opciones Avanzadas</p>
                          <p class="mt-1 text-[11px] text-zinc-500">Share image, ícono PWA y CSS personalizado</p>
                        </div>
