                        data-gadget-id="nutricion"
                      >
                        <div class="flex items-start gap-3 p-4">
                          <span class="gadget-card__icon flex size-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-zinc-400 transition-colors duration-300" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 6.75h15M6 6.75v10.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5V6.75M9 10.5h6M9 14h4" />
                            </svg>
                          </span>
                          <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                              <h4 class="text-sm font-semibold tracking-tight text-zinc-100">Ficha nutricional</h4>
                              <span class="gadget-status" data-gadget-status>{marca.gadget_nutricion ? 'Activo' : 'Inactivo'}</span>
                            </div>
                            <p class="mt-0.5 text-[11px] leading-snug text-zinc-500">Kcal, macros y alérgenos por plato. Activa filtros de dieta en la WebApp.</p>
                          </div>
