                              value={marca.ubicacion_color_cuerpo || '#d4d4d8'}
                              class="id-swatch__dot"
                            />
                            <input
                              type="text"
                              id="marca-ubicacion-color-cuerpo"
                              name="ubicacion_color_cuerpo"
                              value={marca.ubicacion_color_cuerpo}
                              placeholder="#d4d4d8"
                              spellcheck="false"
                              class="id-swatch__hex"
                            />
                          </span>
                        </label>
                      </div>
                      <label class="id-ubicacion__field">
                        <span>WhatsApp</span>
                        <input
                          type="text"
                          id="marca-whatsapp"
                          name="whatsapp_url"
                          value={marca.whatsapp_url}
                          placeholder="+58…"
                          class="id-ubicacion__input"
                        />
                      </label>
                    </div>

                    <div class="marca-local-ops mt-1 w-full">
                      <PerfilLocalCard
                        scope="marca"
                        mapsInputId="marca-coordenadas"
                        horarioHiddenId="marca-horarios"
                        horarioText={opsHorario}
                        horarioSemana={horarioSemana}
                        horarioHoy={horarioHoy}
                        mapsUrl={opsMaps}
                        mapsEmbed={opsMapsEmbed}
                        mapsOpen={opsMapsOpen}
                        instagram={opsInstagram}
                        facebook={opsFacebook}
                        tiktok={opsTiktok}
                        tripadvisor={opsTripadvisor}
                        socialIdPrefix="marca-redes-"
                      />
                    </div>
                  </div>

                  {/* —— RESERVAS —— */}
                  <div data-marca-panel="reservas" class={`${studioCardClass} space-y-4`} hidden>
                    <p class={labelClass}>Reservas</p>

                    <label class="flex cursor-pointer items-center justify-between gap-4 rounded-xl border border-white/10 bg-black/30 px-4 py-3.5">
                      <span class="text-sm text-zinc-200">Activar botón de Reservas en Home</span>
                      <input type="checkbox" id="marca-gadget-reservas" name="gadget_reservas" checked={marca.gadget_reservas} class="peer sr-only" data-marca-gadget role="switch" />
                      <span class:list={['ios-toggle', 'pointer-events-none', marca.gadget_reservas && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-reservas" aria-hidden="true">
                        <span class="ios-toggle__knob"></span>
                      </span>
                    </label>

                    <div class="grid gap-5 lg:grid-cols-2">
                      <label class="block space-y-2 lg:col-span-2">
                        <span class={labelClass}>Texto del botón principal</span>
                        <input type="text" id="marca-reservas-label" name="reservas_label" value={marca.reservas_label} placeholder="PEDIR / RESERVAR" class={fieldClass} />
                      </label>
                      <label class="block space-y-2">
                        <span class={labelClass}>Tipo de destino</span>
                        <select id="marca-reservas-destino-tipo" name="reservas_destino_tipo" class={fieldClass}>
                          <option value="whatsapp" selected={marca.reservas_destino_tipo === 'whatsapp'}>WhatsApp</option>
                          <option value="enlace" selected={marca.reservas_destino_tipo === 'enlace'}>Enlace externo</option>
                        </select>
                      </label>
                      <label class="block space-y-2">
                        <span class={labelClass}>URL o número de teléfono</span>
                        <input type="text" id="marca-reservas-destino-valor" name="reservas_destino_valor" value={marca.reservas_destino_valor} placeholder="+58414… o https://…" class={fieldClass} />
                      </label>
                    </div>
                  </div>

                  {/* —— GADGETS —— */}
                  <div
