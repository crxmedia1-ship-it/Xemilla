          </div>
          <div class="max-h-[min(70vh,32rem)] space-y-5 overflow-y-auto px-5 py-5">
            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
              <div class="nut-metric">
                <label for="nut-calorias">kcal</label>
                <input id="nut-calorias" type="number" min="0" step="1" inputmode="numeric" />
              </div>
              <div class="nut-metric">
                <label for="nut-proteinas">Prot</label>
                <input id="nut-proteinas" type="number" min="0" step="1" inputmode="numeric" />
              </div>
              <div class="nut-metric">
                <label for="nut-carbs">Carbs</label>
                <input id="nut-carbs" type="number" min="0" step="1" inputmode="numeric" />
              </div>
              <div class="nut-metric">
                <label for="nut-grasas">Grasas</label>
                <input id="nut-grasas" type="number" min="0" step="1" inputmode="numeric" />
              </div>
            </div>
            <div>
              <p class="mb-2 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-zinc-500">Alérgenos</p>
