        aria-modal="true"
        aria-labelledby="nutricion-modal-title"
        data-open="false"
        aria-hidden="true"
      >
        <div data-modal-card class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}>
          <div class="nutricion-modal__head flex items-center justify-between gap-3 border-b border-white/8 px-4 py-3.5 sm:px-5 sm:py-4">
            <div class="min-w-0 flex-1">
              <p class="text-[0.55rem] font-semibold uppercase tracking-[0.2em] text-zinc-500">
