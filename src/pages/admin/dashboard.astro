                                <span class="id-cat-fondo__name">{cat.nombre}</span>
                                <input
                                  type="text"
                                  inputmode="url"
                                  data-cat-bg-valor
                                  value={cat.bg_valor || ''}
                                  placeholder="https://…"
                                  class="id-ubicacion__input"
                                />
                              </div>
                            ))}
                          </div>
                        )
                      }
                    </div>
                  </div>

                  {/* —— HORARIOS & UBICACIÓN —— */}
                  <div data-marca-panel="ubicacion" class={`${studioCardClass} space-y-3`} hidden>
                    <p class={labelClass}>Horarios &amp; Ubicación</p>

                    <div class="id-ubicacion">
                      <div class="id-ubicacion__row">
                        <label class="id-ubicacion__field">
                          <span>Plantilla</span>
                          <select id="marca-ubicacion-theme" name="ubicacion_theme" class="id-ubicacion__select">
                            <option value="modal" selected={marca.ubicacion_theme === 'modal'}>Modal / Drawer</option>
                            <option value="split" selected={marca.ubicacion_theme === 'split'}>Split mapa</option>
                          </select>
                        </label>
                        <label class="id-ubicacion__field">
                          <span>Fondo</span>
                          <select id="marca-fondo-ubicacion-tipo" name="fondo_ubicacion_tipo" class="id-ubicacion__select">
                            <option value="color" selected={marca.fondo_ubicacion_tipo === 'color'}>Color</option>
                            <option value="image" selected={marca.fondo_ubicacion_tipo === 'image'}>Imagen</option>
                            <option value="video" selected={marca.fondo_ubicacion_tipo === 'video'}>Video</option>
                          </select>
                        </label>
                      </div>
                      <label class="id-ubicacion__field">
                        <span>Valor del fondo</span>
                        <input
                          type="text"
                          id="marca-fondo-ubicacion-valor"
                          name="fondo_ubicacion_valor"
                          value={marca.fondo_ubicacion_valor}
