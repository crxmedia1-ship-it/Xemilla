              <span
                id="modal-replace-label"
                class="inline-flex items-center gap-2 rounded-xl border border-white/12 bg-white/[0.06] px-3.5 py-2 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-200 transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:border-white/25 hover:bg-neutral-800/50 hover:text-white"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M12 16V4"></path>
                  <path d="M8 8l4-4 4 4"></path>
                  <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"></path>
                </svg>
                Cambiar archivo
              </span>
            </label>
          </div>
        </div>
        <p id="modal-replace-error" class="hidden px-5 pb-3 text-xs text-rose-400" role="alert"></p>
      </div>

      <div id="modal-attach" class="hidden space-y-4 px-5 py-5">
