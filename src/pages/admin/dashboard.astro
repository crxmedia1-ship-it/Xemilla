                    hidden
                  >
                    <p class={labelClass}>Gadgets</p>

                    <div class="gadget-catalog grid gap-3 sm:grid-cols-2">

                      {/* ── Wi‑Fi ── */}
                      <article
                        class:list={['gadget-card relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-white/[0.025] transition-all duration-300', marca.gadget_wifi && 'gadget-card--on']}
                        data-gadget-card
                        data-gadget-id="wifi"
                      >
                        <div class="flex items-start gap-3 p-4">
                          <span class="gadget-card__icon flex size-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-zinc-400 transition-colors duration-300" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5a8.5 8.5 0 0 1 14 0M8.5 15.5a4.5 4.5 0 0 1 7 0M12 19h.01" />
                            </svg>
                          </span>
                          <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex items-center gap-2">
                              <h4 class="text-sm font-semibold tracking-tight text-zinc-100">Wi‑Fi invitados</h4>
                              <span class="gadget-status" data-gadget-status>{marca.gadget_wifi ? 'Activo' : 'Inactivo'}</span>
                            </div>
                            <p class="mt-0.5 text-[11px] leading-snug text-zinc-500">Muestra SSID y clave en la mesa del cliente.</p>
                          </div>
                          <label class="relative shrink-0 cursor-pointer pt-0.5" title="Activar Wi‑Fi">
                            <input type="checkbox" id="marca-gadget-wifi" name="gadget_wifi" checked={marca.gadget_wifi} class="peer sr-only" data-marca-gadget role="switch" aria-checked={marca.gadget_wifi ? 'true' : 'false'} />
                            <span class:list={['ios-toggle pointer-events-none', marca.gadget_wifi && 'is-on']} data-marca-toggle-ui data-for="marca-gadget-wifi" aria-hidden="true"><span class="ios-toggle__knob"></span></span>
                          </label>
                        </div>
                        <div class:list={['gadget-card__config', marca.gadget_wifi && 'is-open']} data-gadget-config aria-hidden={marca.gadget_wifi ? 'false' : 'true'}>
