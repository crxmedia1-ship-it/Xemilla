    justify-content: center;
    height: 1.55rem;
    min-width: 2.2rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(167, 139, 250, 0.4);
    background: rgba(139, 92, 246, 0.14);
    color: #ddd6fe;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
  }

  .ar-chip:hover {
    border-color: rgba(167, 139, 250, 0.7);
    background: rgba(139, 92, 246, 0.28);
    color: #fff;
  }

  .ar-chip.is-on {
    border-color: #7c3aed;
    background: #7c3aed;
    color: #fff;
  }

  .dish-name-btn {
    display: none;
  }

  .dish-copy {
    gap: 0.7rem;
  }

  .dish-edit-field {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.28rem;
    min-width: 0;
  }

  .dish-edit-field__label {
    padding-left: 0.1rem;
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-soft, #71717a) 78%, transparent);
    line-height: 1;
  }

  .dish-name-input.dish-edit-hit,
  .dish-name-btn.dish-edit-hit {
    color: var(--text-primary, #fafafa);
  }

  .dish-copy [data-descripcion-preview] {
    color: var(--text-muted, #a1a1aa) !important;
  }

  .dish-copy [data-descripcion-preview].is-empty,
  .dish-copy [data-descripcion-preview].italic {
    color: color-mix(in srgb, var(--text-muted, #a1a1aa) 72%, transparent) !important;
  }

  .dish-edit-hit {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.42rem 0.15rem 0.5rem;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary, #fafafa) 14%, transparent);
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .dish-name-input.dish-edit-hit {
    cursor: text;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .dish-edit-hit:hover {
    border-bottom-color: color-mix(in srgb, var(--text-primary, #fafafa) 38%, transparent);
