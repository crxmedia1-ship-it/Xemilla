    setBulkPanelOpen(next);
    if (next) setNutricionBulkPanelOpen(false);
  }

  bulkToggle?.addEventListener('click', toggleBulkPanel, { signal });
  bulkToggleMobile?.addEventListener('click', toggleBulkPanel, { signal });

