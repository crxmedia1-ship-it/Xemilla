  {/* Modal nombre (móvil: misma UX que descripción) */}
  <div
    id="nombre-modal"
    class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nombre-modal-title"
    data-open="false"
    aria-hidden="true"
  >
    <div data-modal-card class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}>
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <div class="min-w-0">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.2em] text-zinc-500">
            Nombre
          </p>
          <h3 id="nombre-modal-title" class="mt-1 font-blacksushi-display text-xl font-semibold">
            Editar plato
          </h3>
        </div>
        <button
          type="button"
          id="nombre-modal-close"
          class="rounded-lg px-3 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:bg-white/5 hover:text-white"
        >
          Cerrar
        </button>
      </div>
      <div class="space-y-4 px-5 py-5">
        <label for="nombre-modal-text" class="sr-only">Nombre del plato</label>
        <input
          id="nombre-modal-text"
          type="text"
          maxlength="120"
          placeholder="Nombre del plato…"
          class="w-full rounded-2xl border border-white/10 bg-black/40 px-4 py-3.5 text-base font-semibold tracking-tight text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
        />
        <p id="nombre-modal-error" class="hidden text-xs text-rose-400" role="alert"></p>
        <button
          type="button"
          id="nombre-modal-save"
          class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95"
        >
          Guardar
        </button>
      </div>
    </div>
  </div>

  {/* Modal Nuevo Plato — exclusivo SuperAdmin (no render en admin de restaurante) */}
  {
    isSuperAdmin && (
      <div
        id="nuevo-plato-modal"
        class="modal-overlay fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-6 backdrop-blur-md"
        role="dialog"
        aria-modal="true"
        aria-labelledby="nuevo-plato-title"
        data-open="false"
        aria-hidden="true"
      >
    <div
      data-modal-card
      class={`modal-card glass-panel ${bounceWallClass} w-full max-w-lg overflow-hidden p-0 shadow-2xl`}
    >
      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
        <div class="min-w-0">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-zinc-500">
            SuperAdmin
          </p>
          <h3 id="nuevo-plato-title" class="mt-1 font-blacksushi-display text-xl font-semibold">
            Nuevo plato
          </h3>
        </div>
        <button
          type="button"
          id="nuevo-plato-close"
          class="rounded-lg px-3 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 transition hover:bg-white/5 hover:text-white"
        >
          Cerrar
        </button>
      </div>

      <form id="nuevo-plato-form" class="space-y-4 px-5 py-5">
        <div>
          <label for="np-categoria" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Categoría
          </label>
          <input
            id="np-categoria"
            name="categoria"
            list="np-categorias-list"
            autocomplete="off"
            placeholder="Ej. Entradas"
            class="w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
          />
          <datalist id="np-categorias-list"></datalist>
        </div>

        <div>
          <label for="np-nombre" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Nombre
          </label>
          <input
            id="np-nombre"
            name="nombre"
            required
            autocomplete="off"
            placeholder="Nombre del plato"
            class="w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
          />
        </div>

        <div>
          <label for="np-descripcion" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Descripción
          </label>
          <textarea
            id="np-descripcion"
            name="descripcion"
            rows="3"
            placeholder="Descripción breve…"
            class="w-full resize-y rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm leading-relaxed text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="np-precio" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
              Precio
            </label>
            <input
              id="np-precio"
              name="precio"
              type="number"
              inputmode="decimal"
              min="0"
              step="0.01"
              required
              placeholder="0.00"
              class="precio-input w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm tabular-nums text-white outline-none transition placeholder:text-zinc-600 focus:border-white/25 focus:ring-2 focus:ring-white/10"
            />
          </div>
          <div class="flex flex-col justify-end pb-1">
            <div class="flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-black/30 px-3.5 py-2.5">
              <span class="text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
                Destacado
              </span>
              <div class="dest-control dest-control--row">
                <div class="dest-tipo" role="radiogroup" aria-label="Tipo de destacado" id="np-destacado-tipo" hidden>
                  {DESTACADO_TIPOS.map((tipo) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked={tipo === 'chef'}
                      data-set-destacado-tipo={tipo}
                      title={DESTACADO_TIPO_LABELS[tipo]}
                      class:list={['dest-tipo__opt', tipo === 'chef' && 'is-active']}
                    >
                      {tipo === 'chef' ? 'Chef' : 'Promo'}
                    </button>
                  ))}
                </div>
                <button
                  type="button"
                  id="np-destacado"
                  role="switch"
                  aria-checked="false"
                  class="ios-toggle"
                  title="Destacado"
                >
                  <span class="ios-toggle__knob" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label for="np-imagen" class="mb-1.5 block text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
            Imagen / video
          </label>
          <input
            id="np-imagen"
            name="imagen"
            type="file"
            accept="image/*,video/*,image/gif"
            class="block w-full text-xs text-zinc-400 file:mr-3 file:rounded-lg file:border-0 file:bg-white/10 file:px-3 file:py-2 file:text-[0.55rem] file:font-semibold file:uppercase file:tracking-[0.14em] file:text-zinc-200 hover:file:bg-white/15"
          />
          <p class="mt-1.5 text-[11px] text-zinc-600">Opcional · se sube a Cloudinary</p>
        </div>

        <div
              class:list={['space-y-3 rounded-2xl border border-white/8 bg-black/25 p-3.5', !marca.gadget_nutricion && 'hidden']}
              data-np-nutricion
              data-shows-when-nutricion
            >
              <p class="text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500">
                Ficha nutricional
              </p>
              <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
                <div class="nut-metric">
                  <label for="np-calorias">kcal</label>
                  <input id="np-calorias" name="calorias" type="number" min="0" step="1" inputmode="numeric" />
                </div>
                <div class="nut-metric">
                  <label for="np-proteinas">Prot</label>
                  <input id="np-proteinas" name="proteinas" type="number" min="0" step="1" inputmode="numeric" />
                </div>
                <div class="nut-metric">
                  <label for="np-carbs">Carbs</label>
                  <input id="np-carbs" name="carbs" type="number" min="0" step="1" inputmode="numeric" />
                </div>
                <div class="nut-metric">
                  <label for="np-grasas">Grasas</label>
                  <input id="np-grasas" name="grasas" type="number" min="0" step="1" inputmode="numeric" />
                </div>
              </div>
              <div>
                <p class="mb-2 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-zinc-500">Alérgenos</p>
                <div class="flex flex-wrap gap-2">
                  {ALERGENOS_OPTIONS.map((opt) => (
                    <label class="nut-chip">
                      <input type="checkbox" name="alergias" value={opt.id} class="sr-only" />
                      {opt.label}
                    </label>
                  ))}
                </div>
              </div>
            </div>

        <p id="nuevo-plato-error" class="hidden text-xs text-rose-400" role="alert"></p>

        <button
          type="submit"
          id="nuevo-plato-submit"
          class="admin-action-btn inline-flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95 disabled:opacity-50"
        >
          Crear plato
        </button>
      </form>
    </div>
  </div>
    )
  }
  <ImageCropHost />
</Layout>

<style>
  .precio-input::-webkit-outer-spin-button,
  .precio-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .precio-input[type='number'] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  details[aria-labelledby='marca-sec-avanzado'] > summary {
    list-style: none;
  }
  details[aria-labelledby='marca-sec-avanzado'] > summary::-webkit-details-marker {
    display: none;
  }

  .field-inline.is-saved {
    box-shadow: inset 0 0 0 1px rgba(52, 211, 153, 0.45);
    background: rgba(16, 185, 129, 0.08);
  }
  .field-inline.is-error {
    box-shadow: inset 0 0 0 1px rgba(251, 113, 133, 0.5);
    background: rgba(244, 63, 94, 0.08);
  }

  /* Dish name: desktop keeps input; mobile uses marquee + modal */
  .dish-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    width: 100%;
  }

  .dish-name-stack {
    position: relative;
    flex: 1;
    width: auto;
    min-width: 0;
  }

  .ar-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.55rem;
    min-width: 2.2rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(167, 139, 250, 0.4);
    background: rgba(139, 92, 246, 0.14);
    color: #ddd6fe;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
  }

  .ar-chip.hidden,
  .ar-chip[hidden],
  [data-shows-when-ar].hidden,
  [data-shows-when-ar][hidden] {
    display: none !important;
  }

  .ar-chip:hover {
    border-color: rgba(167, 139, 250, 0.7);
    background: rgba(139, 92, 246, 0.28);
    color: #fff;
  }

  .ar-chip.is-on {
    border-color: #7c3aed;
    background: #7c3aed;
    color: #fff;
  }

  .dish-name-btn {
    display: none;
  }

  .dish-copy {
    gap: 0.7rem;
  }

  .dish-edit-field {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.28rem;
    min-width: 0;
  }

  .dish-edit-field__label {
    padding-left: 0.1rem;
    font-size: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-soft, #71717a) 78%, transparent);
    line-height: 1;
  }

  .dish-name-input.dish-edit-hit,
  .dish-name-btn.dish-edit-hit {
    color: var(--text-primary, #fafafa);
  }

  .dish-copy [data-descripcion-preview] {
    color: var(--text-muted, #a1a1aa) !important;
  }

  .dish-copy [data-descripcion-preview].is-empty,
  .dish-copy [data-descripcion-preview].italic {
    color: color-mix(in srgb, var(--text-muted, #a1a1aa) 72%, transparent) !important;
  }

  .dish-edit-hit {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.42rem 0.15rem 0.5rem;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary, #fafafa) 14%, transparent);
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .dish-name-input.dish-edit-hit {
    cursor: text;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .dish-edit-hit:hover {
    border-bottom-color: color-mix(in srgb, var(--text-primary, #fafafa) 38%, transparent);
    background: transparent;
  }

  .dish-edit-hit:focus,
  .dish-edit-hit:focus-visible,
  .dish-edit-hit:focus-within {
    outline: none;
    border-bottom-color: var(--text-primary, #fafafa);
    background: transparent;
    box-shadow: none;
  }

  html.admin-panel.light .dish-edit-hit,
  html.admin-panel[data-theme='light'] .dish-edit-hit,
  html.admin-panel[data-theme='alabastro'] .dish-edit-hit,
  html.admin-panel[data-theme='organico'] .dish-edit-hit {
    border-bottom-color: rgba(24, 24, 27, 0.12);
    background: transparent;
    box-shadow: none;
  }

  html.admin-panel.light .dish-edit-hit:hover,
  html.admin-panel[data-theme='light'] .dish-edit-hit:hover,
  html.admin-panel[data-theme='alabastro'] .dish-edit-hit:hover,
  html.admin-panel[data-theme='organico'] .dish-edit-hit:hover,
  html.admin-panel.light .dish-edit-hit:focus,
  html.admin-panel[data-theme='light'] .dish-edit-hit:focus,
  html.admin-panel[data-theme='alabastro'] .dish-edit-hit:focus,
  html.admin-panel[data-theme='organico'] .dish-edit-hit:focus {
    border-bottom-color: rgba(24, 24, 27, 0.45);
    background: transparent;
  }

  /* Squarespace / Wix: thumb + identity grouped; controls tight on the right */
  @media (min-width: 1024px) {
    .platos-table {
      table-layout: fixed;
      width: 100%;
    }

    .platos-table th:nth-child(1),
    .platos-table td.platos-cell--order {
      width: 3.25rem;
    }

    .platos-table thead tr {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      color: var(--text-muted, #a1a1aa);
    }

    .platos-table thead th {
      padding-top: 0.95rem;
      padding-bottom: 0.95rem;
    }

    .platos-table th:nth-child(3),
    .platos-table td.platos-cell--cat {
      width: 11rem;
    }

    .platos-table th:nth-child(4),
    .platos-table td.platos-cell--precio {
      width: 9.75rem;
      text-align: center;
    }

    .platos-table th:nth-child(5),
    .platos-table td.platos-cell--destacado,
    .platos-table th:nth-child(6),
    .platos-table td.platos-cell--disponible {
      width: 7.25rem;
    }

    .platos-table th:nth-child(7),
    .platos-table td.platos-cell--media {
      width: 4rem;
    }

    .platos-row td {
      vertical-align: middle;
    }

    .platos-cell--cat,
    .platos-cell--precio,
    .platos-cell--destacado,
    .platos-cell--disponible,
    .platos-cell--media {
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }

    .platos-cell--cat {
      white-space: nowrap;
      font-size: 0.95rem;
      font-weight: 500;
      line-height: 1.3;
      color: var(--text-secondary, #d4d4d8);
      padding-left: 1.35rem;
    }

    .platos-cell--precio {
      text-align: center;
    }

    .platos-cell--precio .inline-flex {
      justify-content: center;
      gap: 0.4rem;
      width: 100%;
    }

    .platos-cell--precio .text-xs {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-muted, #a1a1aa);
    }

    .platos-cell--precio .precio-input {
      width: 7.5rem;
      min-height: 2.55rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.2;
    }

    html.admin-panel.light .platos-cell--precio .precio-input,
    html.admin-panel[data-theme='light'] .platos-cell--precio .precio-input,
    html.admin-panel[data-theme='alabastro'] .platos-cell--precio .precio-input,
    html.admin-panel[data-theme='organico'] .platos-cell--precio .precio-input {
      border-color: rgba(24, 24, 27, 0.12);
      background: rgba(24, 24, 27, 0.04);
    }

    .platos-cell--destacado,
    .platos-cell--disponible {
      text-align: center;
    }

    .platos-row .ios-toggle {
      width: 3.5rem;
      height: 2.05rem;
    }

    .platos-row .ios-toggle__knob {
      top: 0.18rem;
      left: 0.18rem;
      width: 1.69rem;
      height: 1.69rem;
    }

    .platos-row .ios-toggle.is-on .ios-toggle__knob {
      transform: translateX(1.45rem);
    }

    .platos-row .ios-toggle:active .ios-toggle__knob {
      width: 1.85rem;
    }

    .platos-cell--media [data-delete] {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.55rem;
      height: 2.55rem;
      padding: 0;
      border-radius: 0.85rem;
      color: #a1a1aa;
    }

    .platos-cell--media [data-delete] svg {
      width: 1.3rem;
      height: 1.3rem;
      stroke-width: 1.85;
    }

    .platos-cell--dish {
      display: grid;
      grid-template-columns: 11.5rem minmax(0, 23rem);
      justify-content: start;
      column-gap: 1.5rem;
      row-gap: 0.55rem;
      align-items: center;
      padding-right: 2.5rem;
    }

    .dish-identity {
      display: contents;
    }

    .dish-thumb-slot {
      grid-column: 1;
      grid-row: 1 / span 2;
      width: 11.5rem;
      aspect-ratio: 4 / 3;
      height: auto;
    }

    .dish-copy {
      display: flex;
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      max-width: 23rem;
      flex-direction: column;
      gap: 0.75rem;
    }

    .platos-cell--dish > .dish-gadget-stack {
      grid-column: 2;
      grid-row: 2;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-top: 0;
      width: 100%;
      max-width: 23rem;
    }

    .platos-cell--dish .nut-edit-btn {
      margin-top: 0;
      width: 100%;
      max-width: none;
    }

    .dish-name-input,
    .platos-cell--dish .dish-name-input {
      font-size: 0.98rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .dish-copy [data-descripcion-preview] {
      font-size: 0.8rem;
      line-height: 1.4;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .platos-table th:nth-child(3),
    .platos-table td.platos-cell--cat {
      width: 8rem;
    }

    .platos-table th:nth-child(4),
    .platos-table td.platos-cell--precio {
      width: 8rem;
    }

    .platos-table th:nth-child(5),
    .platos-table td.platos-cell--destacado,
    .platos-table th:nth-child(6),
    .platos-table td.platos-cell--disponible {
      width: 6.5rem;
    }

    .platos-cell--cat {
      padding-left: 0.85rem;
      white-space: normal;
    }

    .platos-cell--precio,
    .platos-cell--destacado,
    .platos-cell--disponible {
      padding-left: 0.35rem;
      padding-right: 0.35rem;
    }

    .platos-cell--precio .precio-input {
      width: 5.75rem;
    }

    .platos-cell--dish {
      grid-template-columns: 7rem minmax(0, 1fr);
      column-gap: 1rem;
      padding-right: 1rem;
    }

    .dish-thumb-slot {
      width: 7rem;
    }
  }

  .dish-thumb,
  .dish-thumb--empty {
    position: relative;
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    min-width: 0;
    max-width: none;
    min-height: 0;
    max-height: none;
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    border-radius: 0.85rem;
    overflow: hidden;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .dish-thumb:hover,
  .dish-thumb--empty:hover {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28);
  }

  .dish-thumb__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .dish-thumb__placeholder {
