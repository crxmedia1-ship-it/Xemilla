---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import '../../styles/admin-themes.css';
import ImageCropHost from '../../components/admin/ImageCropHost.astro';
import AdminXemillaMark from '../../components/admin/AdminXemillaMark.astro';
import AdminMetricsPanel from '../../components/admin/AdminMetricsPanel.astro';
import PerfilLocalCard from '../../components/admin/PerfilLocalCard.astro';
import WelcomePopupCard from '../../components/admin/WelcomePopupCard.astro';
import { getAdminDashboardData } from '../../lib/admin.js';
import { fetchMetricsSnapshot, emptyMetricsSnapshot } from '../../lib/metrics.js';
import { createSupabaseServerClient } from '../../lib/supabase/server.js';
import {
  getSuperAdminWriteClient,
} from '../../lib/superadmin.js';
import { parseBoutiqueConfig } from '../../lib/boutique.js';
import {
  DESTACADO_TIPOS,
  DESTACADO_TIPO_LABELS,
  destacadoPickerHtml,
} from '../../lib/destacado-tipo.js';
import {
  normalizeNosotrosTheme,
  normalizeUbicacionTheme,
  resolveHomeThemeAndNav,
  HOME_LAYOUT_OPTIONS,
  NOSOTROS_LAYOUT_OPTIONS,
  UBICACION_LAYOUT_OPTIONS,
  homeLayoutToTheme,
  homeThemeToLayout,
  nosotrosLayoutToTheme,
  nosotrosThemeToLayout,
  normalizeNosotrosLayout,
  ubicacionLayoutToTheme,
  ubicacionThemeToLayout,
  normalizeUbicacionLayout,
  RESERVAS_LAYOUT_OPTIONS,
} from '../../lib/layout-themes.js';
import { normalizeContenedorEstilo, normalizeBloqueAlineacion } from '../../lib/nosotros-layout.js';
import {
  NOSOTROS_FUENTES_TITULO,
  NOSOTROS_FUENTES_CUERPO,
  resolveNosotrosFuenteTitulo,
  resolveNosotrosFuenteCuerpo,
  buildNosotrosFontsHref,
} from '../../config/nosotros-typography.js';
import { macrosPresentIn } from '../../config/menu-macros.js';
import { platoFillUrl, cloudinaryTrimUrl } from '../../lib/plato-media-url.js';
import { resolveMediaUrl } from '../../lib/cloudinary.js';
import {
  parseHorarioSemana,
  previewHorarioHoy,
} from '../../lib/horarios-semana.js';
import { ALERGENOS_OPTIONS } from '../../config/nutricion.js';
import {
  parseUiEstilo,
  parseReservasConfig,
  HOME_PX_DEFAULTS,
  HOME_PX_RANGES,
  normalizeFondoAnimacion,
  normalizeEfectoEntrada,
  normalizeOverlayEstilo,
  parseRedesSociales,
  normalizeChipsLayout,
  normalizeChipsEstilo,
  normalizePlatosLayout,
  normalizeEstiloTarjetas,
  normalizeDestacadosEstilo,
  normalizeDestacadosEfecto,
  normalizeMenuNavegacion,
  normalizeGadgetServiciosEstilo,
  MENU_LAYOUT_OPTIONS,
  normalizeMenuLayout,
} from '../../lib/secciones-ui.js';
import { hasOperationalGadgets } from '../../lib/gadgets.js';
import { normalizeUbicacionGridEstilo } from '../../lib/ubicacion-theme-data.js';
import {
  TYPOGRAPHY_COMBO_OPTIONS,
  normalizeTypographyComboId,
  DEFAULT_TYPOGRAPHY_COMBO,
} from '../../config/typography-combos.js';
import { resolveMenuFont } from '../../config/menu-fonts.js';
import {
  getUserAdminRole,
  getAssignedRestauranteId,
  ADMIN_ROLE_SUPER,
} from '../../config/superadmin.js';
import {
  googleMapsEmbedSrc,
  mapsOpenHref,
} from '../../lib/maps-preview.js';
import { parsePopupBanner } from '../../lib/popup-banner.js';

const restauranteId =
  Astro.url.searchParams.get('restaurante') ||
  Astro.url.searchParams.get('id') ||
  null;
const restauranteSlug = Astro.url.searchParams.get('slug') || null;

const session = await getAdminDashboardData(
  { request: Astro.request, cookies: Astro.cookies },
  { restauranteId, slug: restauranteSlug },
);

if (!session) {
  return Astro.redirect('/admin/login');
}

const {
  restaurante,
  platos: platosLoaded = [],
  categorias = [],
  sucursales = [],
  agotadosPorSucursal = {},
  managingAsSuperAdmin,
  user,
  assignedRestauranteId: sessionAssignedId,
} = session;

/** Same array loaded in SSR — table rows must map this, never a stale/empty stand-in. */
const platos = Array.isArray(platosLoaded) ? platosLoaded : [];

/** Strict SSR: true only if allowlist SuperAdmin OR metadata role === 'superadmin'. Operativo → false. */
const isSuperAdmin = getUserAdminRole(user) === ADMIN_ROLE_SUPER;
const assignedRestauranteId =
  sessionAssignedId || getAssignedRestauranteId(user);

if (!isSuperAdmin) {
  // Operativo: URL solo coherencia; SSR ya forzó metadata. Canonicalizar a asignado.
  if (assignedRestauranteId) {
    const urlMatchesAssigned =
      restauranteId === assignedRestauranteId ||
      restauranteSlug === assignedRestauranteId;
    if (!urlMatchesAssigned) {
      return Astro.redirect(
        `/admin/dashboard?restaurante=${encodeURIComponent(assignedRestauranteId)}`,
      );
    }
  } else if (restauranteId || restauranteSlug) {
    // Sin asignación: no dejar ?restaurante= / ?slug= ajenos en la URL
    return Astro.redirect('/admin/dashboard');
  }
} else if (!restauranteId && !restauranteSlug) {
  // SuperAdmin sin restaurante en la URL → hub de locales (un solo dueño, muchos locales).
  return Astro.redirect('/admin/super/dashboard');
}

const nombre = restaurante?.nombre_comercial ?? 'Sin restaurante';
const restId = restaurante?.id ?? '';
if (isSuperAdmin && restId) {
  const urlToken = String(restauranteId || restauranteSlug || '').trim();
  if (urlToken && urlToken !== restId) {
    return Astro.redirect(
      `/admin/dashboard?restaurante=${encodeURIComponent(restId)}`,
    );
  }
}
const publicSlug = String(restaurante?.slug || restauranteSlug || '').trim();
const publicWebAppUrl = publicSlug ? `https://xemilla.app/${publicSlug}` : '';
const categoriasJson = JSON.stringify(categorias);
const sucursalesJson = JSON.stringify(sucursales);
const agotadosSucursalJson = JSON.stringify(agotadosPorSucursal);
const sucursalesActivas = sucursales.filter((s) => s.activo);
const gadgetSucursales = Boolean(restaurante?.gadget_sucursales);
const sucursalesCupo = Math.max(1, Number(restaurante?.sucursales_cupo) || 1);
/** Solo con el gadget contratado; SuperAdmin lo ve sin 2.ª sede para poder crearla. */
const showSucursales =
  gadgetSucursales && (sucursalesActivas.length > 1 || (isSuperAdmin && sucursales.length > 0));
const opsHorario = String(restaurante?.horarios || '').trim();
const horarioSemana = parseHorarioSemana(opsHorario);
const horarioHoy = previewHorarioHoy(horarioSemana);
const hubLogoUrl = String(restaurante?.logo_url || '').trim();
const hubLogoTrimUrl = cloudinaryTrimUrl(hubLogoUrl);
const footLogoUrl = cloudinaryTrimUrl(resolveMediaUrl(hubLogoUrl, 'logo') || hubLogoUrl);
const xemillaWordmark =
  'https://res.cloudinary.com/wdmzaemi/image/upload/v1789022797/Photoroom_20260810_004814.png';
const hubNombre = String(restaurante?.nombre_comercial || nombre || '').trim();
const menuCategoryNames = [
  ...new Set(
    [
      ...categorias.map((c) => String(c?.nombre || '').trim()),
      ...platos.map((p) => String(p?.categoria_nombre || '').trim()),
    ].filter(Boolean),
  ),
];
const presentMacros = macrosPresentIn(menuCategoryNames);
/** Stable category key for DnD sync (prefer id, fallback to name). */
const menuCategoriaIdByName = new Map(
  categorias
    .filter((c) => String(c?.nombre || '').trim())
    .map((c) => [String(c.nombre).trim().toLowerCase(), c.id]),
);
function resolveMenuCategoriaId(nombre, id) {
  if (id != null && String(id).trim() !== '') return String(id);
  const key = String(nombre || '').trim().toLowerCase();
  const mapped = menuCategoriaIdByName.get(key);
  if (mapped != null && String(mapped).trim() !== '') return String(mapped);
  return String(nombre || '').trim();
}

/** Relative 1..n order within each category (not global). */
const platoRelativeOrderById = new Map();
{
  const counters = new Map();
  for (const plato of platos) {
    const key = String(plato?.categoria_id ?? plato?.categoria_nombre ?? '');
    const n = (counters.get(key) || 0) + 1;
    counters.set(key, n);
    if (plato?.id != null) platoRelativeOrderById.set(plato.id, n);
  }
}

const metricsClient = isSuperAdmin
  ? getSuperAdminWriteClient(
      createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies }),
      user,
    )
  : createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies });

const metrics = restId
  ? await fetchMetricsSnapshot(metricsClient, { restauranteId: restId, days: 30 })
  : emptyMetricsSnapshot();

function parseConfig(value) {
  if (!value) return {};
  if (typeof value === 'object') return value;
  try {
    return JSON.parse(String(value));
  } catch {
    return {};
  }
}

const configWifi = parseConfig(restaurante?.config_wifi);
const configReservas = parseReservasConfig(restaurante?.config_reservas);
const boutiqueConfig = parseBoutiqueConfig(restaurante?.config_boutique);
const seccionesFondo = parseConfig(restaurante?.secciones_fondo);
const uiEstiloParsed = parseUiEstilo(restaurante?.ui_estilo);
const uiEstiloRaw = uiEstiloParsed;

function fondoSeccion(key, fallbackTipo = 'color', fallbackValor = '') {
  const entry = seccionesFondo?.[key] || {};
  return {
    tipo: entry.tipo || entry.type || fallbackTipo,
    valor: entry.valor || entry.value || entry.url || fallbackValor,
  };
}

function parseJsonArray(value) {
  if (Array.isArray(value)) return value;
  if (typeof value === 'string' && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
}

/** @type {Array<{ titulo: string, texto: string, media_url: string, media: string[], alineacion: string }>} */
let nosotrosBloques = parseJsonArray(restaurante?.nosotros_bloques)
  .map((b) => {
    /** @type {string[]} */
    const media = [];
    const push = (v) => {
      const url = String(v || '').trim();
      if (!url || media.length >= 3) return;
      media.push(url);
    };
    if (Array.isArray(b?.media) && b.media.length > 0) {
      for (const m of b.media) push(m);
    } else {
      if (Array.isArray(b?.media_urls)) {
        for (const m of b.media_urls) push(m);
      }
      push(b?.media_url);
      push(b?.imagen);
    }
    // Evita que una URL de media contaminada llegue al campo Título
    let titulo = String(b?.titulo || '').trim();
    if (/^https?:\/\//i.test(titulo) || /res\.cloudinary\.com/i.test(titulo)) {
      push(titulo);
      titulo = '';
    }
    return {
      titulo,
      texto: String(b?.texto || b?.contenido || '').trim(),
      media_url: media[0] || '',
      media: media.length ? media : [],
      alineacion: String(b?.alineacion || 'alternada').toLowerCase() === 'inversa' ? 'inversa' : 'alternada',
    };
  })
  .filter((b) => b.titulo || b.texto || b.media.length);

if (nosotrosBloques.length === 0 && (restaurante?.nosotros_titulo || restaurante?.nosotros_texto || restaurante?.nosotros_imagen)) {
  const img = restaurante?.nosotros_imagen || '';
  nosotrosBloques = [
    {
      titulo: restaurante?.nosotros_titulo || 'Nosotros',
      texto: restaurante?.nosotros_texto || '',
      media_url: img,
      media: img ? [img] : [],
      alineacion: 'alternada',
    },
  ];
}

if (nosotrosBloques.length === 0) {
  nosotrosBloques = [{ titulo: '', texto: '', media_url: '', media: [], alineacion: 'alternada' }];
}

/** Filas visibles de media en admin (mín. 1 campo vacío). */
function bloqueMediaForAdmin(bloque) {
  const filled = (bloque.media || [])
    .map((m) => String(m || '').trim())
    .filter(Boolean);
  return filled.length ? filled : [''];
}

function bloqueAlineacionForAdmin(bloque) {
  return normalizeBloqueAlineacion(bloque?.alineacion);
}

const redesParsed = parseRedesSociales(restaurante?.redes_sociales);
const redesById = Object.fromEntries(redesParsed.map((r) => [r.red, r]));
if (!redesById.instagram && restaurante?.instagram_url) {
  redesById.instagram = {
    red: 'instagram',
    url: String(restaurante.instagram_url).trim(),
    activo: true,
  };
}
if (
  !redesById.whatsapp &&
  (restaurante?.whatsapp_url || restaurante?.whatsapp_num)
) {
  redesById.whatsapp = {
    red: 'whatsapp',
    url: String(restaurante.whatsapp_url || restaurante.whatsapp_num).trim(),
    activo: true,
  };
}

function redField(id) {
  const row = redesById[id];
  const url = String(row?.url || '').trim();
  return { url, on: Boolean(url) && row?.activo !== false };
}

const opsInstagram = redField('instagram');
const opsFacebook = redField('facebook');
const opsTiktok = redField('tiktok');
const opsTripadvisor = redField('tripadvisor');
const opsWhatsapp = redField('whatsapp');
const opsTelefonoContacto = redField('telefono');
const opsMaps = String(restaurante?.coordenadas_maps || '').trim();
const opsMapsEmbed = googleMapsEmbedSrc(opsMaps);
const opsMapsOpen = mapsOpenHref(opsMaps);
const opsDireccion = String(restaurante?.direccion || '').trim();
const opsPopupBanner = parsePopupBanner(restaurante?.popup_banner);

const fondoHome = (() => {
  const bgType = String(restaurante?.home_bg_type || '').trim();
  const bgValue = String(restaurante?.home_bg_value || '').trim();
  const fromSecciones = fondoSeccion(
    'home',
    bgType || (restaurante?.imagen_fondo ? 'image' : 'color'),
    bgValue || restaurante?.imagen_fondo || restaurante?.color_fondo || '#0a0a0a',
  );
  // Preferir columnas canónicas cuando hay video (secciones_fondo a veces queda en image stale)
  if (bgType === 'video' && bgValue) {
    return { tipo: 'video', valor: bgValue };
  }
  if (
    fromSecciones.tipo === 'image' &&
    /\.(mp4|webm|mov)(\?|$)/i.test(String(fromSecciones.valor || ''))
  ) {
    return { tipo: 'video', valor: fromSecciones.valor };
  }
  if (bgType && bgValue && ['image', 'carrusel', 'color'].includes(bgType)) {
    return { tipo: bgType, valor: bgValue };
  }
  return fromSecciones;
})();
const fondoNosotros = fondoSeccion('nosotros', 'color', '');
const fondoMenu = fondoSeccion('menu', 'color', '');
const fondoUbicacion = fondoSeccion('ubicacion', 'color', '');

const GLOBAL_FONT_OPTIONS = TYPOGRAPHY_COMBO_OPTIONS.map((c) => ({
  id: c.id,
  label: `${c.label} — ${c.description}`,
  value: c.id,
}));

function matchTipografiaCombo(raw) {
  return normalizeTypographyComboId(raw || DEFAULT_TYPOGRAPHY_COMBO);
}

function hexPickerValue(value, fallback = '#0a0a0a') {
  const v = String(value || '').trim();
  if (/^#[0-9a-f]{6}$/i.test(v)) return v;
  if (/^#[0-9a-f]{3}$/i.test(v)) {
    return `#${v[1]}${v[1]}${v[2]}${v[2]}${v[3]}${v[3]}`;
  }
  return fallback;
}

const resolvedHomeMarca = resolveHomeThemeAndNav(
  uiEstiloRaw?.home?.layout || restaurante?.home_theme,
  uiEstiloRaw?.home?.estilo_navegacion,
);
const adminHomeLayout =
  uiEstiloRaw?.home?.layout
    ? homeThemeToLayout(homeLayoutToTheme(uiEstiloRaw.home.layout))
    : resolvedHomeMarca.layout;
const adminHomeTheme = resolvedHomeMarca.homeTheme;

const marca = {
  color_primario: restaurante?.color_primario || '#9f1239',
  color_fondo: restaurante?.color_fondo || '#0a0a0a',
  color_texto: restaurante?.color_texto || '#ffffff',
  tipografia_combo: matchTipografiaCombo(
    restaurante?.tipo_letra || restaurante?.estilo_adn,
  ),
  logo_url: restaurante?.logo_url || '',
  nombre_comercial: restaurante?.nombre_comercial || nombre || '',
  tagline_superior: String(uiEstiloRaw?.home?.tagline_superior || '').trim(),
  eslogan: restaurante?.eslogan || '',
  share_image_url: restaurante?.share_image_url || '',
  app_icon_url: restaurante?.app_icon_url || '',
  home_titulo_size: uiEstiloRaw?.home?.titulo_size ?? HOME_PX_DEFAULTS.titulo,
  home_logo_size: uiEstiloRaw?.home?.logo_size ?? HOME_PX_DEFAULTS.logo,
  home_eslogan_size: uiEstiloRaw?.home?.eslogan_size ?? HOME_PX_DEFAULTS.eslogan,
  home_menu_size: uiEstiloRaw?.home?.menu_size ?? HOME_PX_DEFAULTS.menu,
  home_tracking: [
    'tracking-normal',
    'tracking-wider',
    'tracking-widest',
    'tracking-[0.3em]',
  ].includes(uiEstiloRaw?.home?.tracking)
    ? uiEstiloRaw.home.tracking
    : 'tracking-[0.3em]',
  home_subtitulo_color:
    uiEstiloRaw?.home?.subtitulo_color ||
    restaurante?.color_primario ||
    '#9f1239',
  home_titulo_color: uiEstiloRaw?.home?.titulo_color || '',
  home_eslogan_color: uiEstiloRaw?.home?.eslogan_color || '',
  home_menu_color: uiEstiloRaw?.home?.menu_color || '',
  home_subtexto_color: uiEstiloRaw?.home?.subtexto_color || '',
  home_borde_destacado_color: uiEstiloRaw?.home?.borde_destacado_color || '',
  home_overlay_opacity:
    uiEstiloRaw?.home?.overlay_opacity ?? HOME_PX_DEFAULTS.overlay_opacity,
  home_overlay_estilo: normalizeOverlayEstilo(
    uiEstiloRaw?.home?.overlay_estilo,
  ),
  home_fondo_animacion: normalizeFondoAnimacion(
    uiEstiloRaw?.home?.fondo_animacion,
  ),
  home_efecto_entrada: normalizeEfectoEntrada(
    uiEstiloRaw?.home?.efecto_entrada,
  ),
  home_gadget_servicios_estilo: normalizeGadgetServiciosEstilo(
    uiEstiloRaw?.home?.gadget_servicios_estilo,
  ),
  nosotros_color_fondo: uiEstiloRaw?.nosotros?.color_fondo || '',
  nosotros_color_titulo: uiEstiloRaw?.nosotros?.color_titulo || '',
  nosotros_color_cuerpo: uiEstiloRaw?.nosotros?.color_cuerpo || '',
  nosotros_contenedor_estilo: normalizeContenedorEstilo(
    uiEstiloRaw?.nosotros?.contenedor_estilo,
  ),
  nosotros_fuente_titulo: resolveNosotrosFuenteTitulo(
    uiEstiloRaw?.nosotros?.fuente_titulo,
  ).id,
  nosotros_fuente_cuerpo: resolveNosotrosFuenteCuerpo(
    uiEstiloRaw?.nosotros?.fuente_cuerpo,
  ).id,
  ubicacion_color_fondo: uiEstiloRaw?.ubicacion?.color_fondo || '',
  ubicacion_color_titulo: uiEstiloRaw?.ubicacion?.color_titulo || '',
  ubicacion_color_cuerpo: uiEstiloRaw?.ubicacion?.color_cuerpo || '',
  ubicacion_color_boton: uiEstiloRaw?.ubicacion?.color_acento || uiEstiloRaw?.ubicacion?.color_boton || '',
  ubicacion_color_acento: uiEstiloRaw?.ubicacion?.color_acento || uiEstiloRaw?.ubicacion?.color_boton || '',
  ubicacion_grid_estilo: normalizeUbicacionGridEstilo(uiEstiloRaw?.ubicacion?.grid_estilo),
  ubicacion_fuente_titulo: resolveNosotrosFuenteTitulo(
    uiEstiloRaw?.ubicacion?.fuente_titulo,
  ).id,
  ubicacion_fuente_cuerpo: resolveNosotrosFuenteCuerpo(
    uiEstiloRaw?.ubicacion?.fuente_cuerpo,
  ).id,
  /** Canónico: ui_estilo.css_avanzado; alias columna custom_css */
  css_avanzado: uiEstiloRaw?.css_avanzado || restaurante?.custom_css || '',
  custom_css: uiEstiloRaw?.css_avanzado || restaurante?.custom_css || '',
  fondo_home_tipo: fondoHome.tipo,
  fondo_home_valor: fondoHome.valor,
  fondo_nosotros_tipo: fondoNosotros.tipo,
  fondo_nosotros_valor: fondoNosotros.valor,
  fondo_menu_tipo: fondoMenu.tipo,
  fondo_menu_valor: fondoMenu.valor,
  menu_fondos_cinematicos:
    uiEstiloRaw?.menu?.fondos_cinematicos === true ||
    uiEstiloRaw?.menu?.fondos_cinematicos === false
      ? Boolean(uiEstiloRaw.menu.fondos_cinematicos)
      : (categorias || []).some((cat) => {
          const tipo = String(cat.bg_type || '').toLowerCase();
          const valor = String(cat.bg_valor || '').trim();
          return Boolean(valor) && (tipo === 'image' || tipo === 'video' || /^https?:\/\//i.test(valor));
        }),
  menu_font: resolveMenuFont(restaurante?.menu_font).family,
  menu_color_texto:
    uiEstiloRaw?.menu?.color_texto ||
    uiEstiloRaw?.menu?.color_titulo ||
    restaurante?.color_texto ||
    '#ffffff',
  menu_color_fondo:
    uiEstiloRaw?.menu?.color_fondo || uiEstiloRaw?.menu?.color_chip || '#1a1a1a',
  menu_color_acento:
    uiEstiloRaw?.menu?.color_acento ||
    uiEstiloRaw?.menu?.color_chip_activo ||
    restaurante?.color_primario ||
    '#9f1239',
  menu_chips_layout: normalizeChipsLayout(uiEstiloRaw?.menu?.chips_layout),
  menu_chips_estilo: normalizeChipsEstilo(uiEstiloRaw?.menu?.chips_estilo),
  menu_platos_layout: normalizePlatosLayout(uiEstiloRaw?.menu?.platos_layout),
  menu_estilo_tarjetas: normalizeEstiloTarjetas(uiEstiloRaw?.menu?.estilo_tarjetas),
  menu_destacados_estilo: normalizeDestacadosEstilo(uiEstiloRaw?.menu?.destacados_estilo),
  menu_destacados_efecto: normalizeDestacadosEfecto(uiEstiloRaw?.menu?.destacados_efecto),
  menu_navegacion: normalizeMenuNavegacion(
    uiEstiloRaw?.menu?.navegacion ?? uiEstiloRaw?.menu?.layout,
  ),
  menu_layout: normalizeMenuLayout(
    uiEstiloRaw?.menu?.layout ?? uiEstiloRaw?.menu?.navegacion,
  ),
  menu_fuente_titulo: resolveNosotrosFuenteTitulo(
    uiEstiloRaw?.menu?.fuente_titulo || restaurante?.menu_font || 'playfair',
  ).id,
  menu_fuente_cuerpo: resolveNosotrosFuenteCuerpo(
    uiEstiloRaw?.menu?.fuente_cuerpo || 'plus-jakarta',
  ).id,
  fondo_ubicacion_tipo: fondoUbicacion.tipo,
  fondo_ubicacion_valor: fondoUbicacion.valor,
  nosotros_bloques: nosotrosBloques,
  direccion: restaurante?.direccion || '',
  coordenadas_maps: restaurante?.coordenadas_maps || '',
  redes_instagram: redesById.instagram?.url || '',
  redes_facebook: redesById.facebook?.url || '',
  redes_tiktok: redesById.tiktok?.url || '',
  redes_tripadvisor: redesById.tripadvisor?.url || '',
  redes_whatsapp: redesById.whatsapp?.url || '',
  whatsapp_url: redesById.whatsapp?.url || '',
  horarios: restaurante?.horarios || '',
  gadget_wifi: Boolean(restaurante?.gadget_wifi),
  gadget_reservas: Boolean(restaurante?.gadget_reservas),
  wifi_ssid:
    restaurante?.gadget_wifi_ssid || configWifi.ssid || '',
  wifi_password:
    restaurante?.gadget_wifi_clave || configWifi.password || '',
  gadget_boutique: Boolean(restaurante?.gadget_boutique),
  gadget_nutricion: Boolean(restaurante?.gadget_nutricion),
  gadget_ar: Boolean(restaurante?.gadget_ar),
  gadget_sucursales: gadgetSucursales,
  sucursales_cupo: sucursalesCupo,
  boutique_titulo: boutiqueConfig.titulo || 'Boutique',
  boutique_catalogo_url: boutiqueConfig.catalogo_url || '',
  gadget_ar_modo_vista: uiEstiloRaw?.gadgets?.ar?.modo_vista || 'rotacion_360',
  gadget_ar_intensidad: uiEstiloRaw?.gadgets?.ar?.intensidad_iluminacion ?? 70,
  gadget_nut_filtro_gluten_free:
    uiEstiloRaw?.gadgets?.nutricion?.filtro_gluten_free !== false,
  gadget_nut_filtro_vegano: uiEstiloRaw?.gadgets?.nutricion?.filtro_vegano !== false,
  gadget_nut_filtro_frutos_secos:
    uiEstiloRaw?.gadgets?.nutricion?.filtro_frutos_secos !== false,
  gadget_nut_filtro_calorias: uiEstiloRaw?.gadgets?.nutricion?.filtro_calorias !== false,
  boutique_productos: boutiqueConfig.productos,
  home_theme: adminHomeTheme,
  home_layout: adminHomeLayout,
  nosotros_theme: (() => {
    const rawTheme = restaurante?.nosotros_theme ?? uiEstiloRaw?.nosotros?.theme;
    const rawLayout = uiEstiloRaw?.nosotros?.layout;
    if (rawLayout) return nosotrosLayoutToTheme(rawLayout);
    return normalizeNosotrosTheme(rawTheme);
  })(),
  nosotros_layout: (() => {
    const rawLayout = uiEstiloRaw?.nosotros?.layout;
    if (rawLayout) return normalizeNosotrosLayout(rawLayout);
    return nosotrosThemeToLayout(
      restaurante?.nosotros_theme ?? uiEstiloRaw?.nosotros?.theme,
    );
  })(),
  ubicacion_theme: (() => {
    const rawTheme = restaurante?.ubicacion_theme ?? uiEstiloRaw?.ubicacion?.theme;
    const rawLayout = uiEstiloRaw?.ubicacion?.layout;
    if (rawLayout) return ubicacionLayoutToTheme(rawLayout);
    return normalizeUbicacionTheme(rawTheme);
  })(),
  ubicacion_layout: (() => {
    const rawLayout = uiEstiloRaw?.ubicacion?.layout;
    if (rawLayout) return normalizeUbicacionLayout(rawLayout);
    return ubicacionThemeToLayout(
      restaurante?.ubicacion_theme ?? uiEstiloRaw?.ubicacion?.theme,
    );
  })(),
  reservas_label: configReservas.label || 'Reservar Mesa',
  reservas_subtitulo: configReservas.subtitulo || configReservas.subtitle || '',
  reservas_incluye_delivery: Boolean(configReservas.incluyeDelivery),
  reservas_layout: configReservas.layout || 'whatsapp_concierge',
  reservas_destino_tipo: configReservas.destinoTipo || 'whatsapp',
  reservas_destino_valor: configReservas.destinoValor || '',
  reservas_boton_ubicacion: configReservas.botonUbicacion || 'flotante',
  reservas_efecto_visual: configReservas.efectoVisual || 'estatico',
  reservas_mensaje_whatsapp: configReservas.mensajeWhatsapp || '',
  reservas_plataforma_externa: configReservas.plataformaExterna || 'custom',
  reservas_politica: configReservas.politica || '',
  reservas_confirmacion_nativa: configReservas.confirmacionNativa || 'ninguna',
};

const marcaHasOperationalGadgets = hasOperationalGadgets({
  wifi: marca.gadget_wifi,
  boutique: marca.gadget_boutique,
});

/** Glass Bento chrome (Menú, modales, bulk). */
const bounceWallClass =
  'relative z-10 dark:bg-zinc-900/95 bg-white/80 backdrop-blur-xl border border-zinc-500/10 rounded-2xl shadow-xl';
/** Bento unificado Identidad — Light blanco / Dark zinc glass (escape via .identidad-studio-card) */
const identidadCardClass =
  'identidad-studio-card studio-card relative z-10 solid-obstacle bg-white dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800/80 text-zinc-900 dark:text-zinc-100 rounded-3xl p-6 shadow-[0_4px_25px_rgba(0,0,0,0.03)] dark:shadow-none backdrop-blur-xl transition-all flex flex-col gap-5';
const studioCardClass = identidadCardClass;
/** Encabezados de tarjeta Identidad */
const identidadHeadingClass =
  'text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-4 block';
/** Inputs Identidad — light zinc-50 / dark zinc-950 */
const fieldClass =
  'w-full rounded-xl px-3.5 py-2 text-xs sm:text-sm outline-none transition-all bg-zinc-50 border border-zinc-200 text-zinc-900 placeholder:text-zinc-400 focus:bg-white focus:border-zinc-400 dark:bg-zinc-950 dark:border-zinc-800 dark:text-white dark:placeholder:text-zinc-600 focus:dark:border-zinc-600';
const identidadFieldClass = fieldClass;
/** Campos Gadgets / QR — misma matriz Light/Dark */
const gadgetFieldClass = fieldClass;
const labelClass = 'text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-zinc-500 dark:text-zinc-500';
const gadgetLabelClass = 'block text-xs font-medium text-zinc-600 dark:text-zinc-400 mb-1.5';
/** Selectores de plantilla — activo esmeralda */
const studioLayoutCardBase =
  'studio-layout-card group relative rounded-2xl p-4 transition-all flex flex-col justify-between cursor-pointer min-h-[85px]';
const studioLayoutCardIdle =
  'bg-zinc-50/80 hover:bg-zinc-100 border border-zinc-200/90 text-zinc-600 dark:bg-zinc-900/40 dark:hover:bg-zinc-900 dark:border-zinc-800 dark:text-zinc-400';
const studioLayoutCardActive =
  'studio-layout-card--active bg-emerald-500/10 border-2 border-emerald-500 text-emerald-950 shadow-xs dark:bg-emerald-500/15 dark:border-emerald-400 dark:text-emerald-100';
const studioLayoutBadgeActive =
  'px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-600 text-white dark:bg-emerald-500 dark:text-zinc-950 shadow-xs';
/** Sliders de escala Identidad */
const identidadRangeClass = 'w-full accent-emerald-500 dark:accent-emerald-400 bg-zinc-200 dark:bg-zinc-800 rounded-full h-1.5';
const identidadRangeValueClass = 'font-mono text-xs font-bold text-zinc-900 dark:text-white tabular-nums';
const colorRowClass =
  'identidad-color-capsule flex items-center gap-2.5 p-2 rounded-xl bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200/90 dark:border-zinc-800 transition-all';
const colorPickerClass =
  'w-7 h-7 rounded-full border border-zinc-200 dark:border-zinc-700 cursor-pointer overflow-hidden p-0 shrink-0 bg-transparent';
const colorHexClass =
  'bg-transparent text-xs font-mono font-medium text-zinc-900 dark:text-zinc-100 outline-none w-20 uppercase tracking-wide placeholder:text-zinc-400';
function formatNutricionPreview(plato) {
  const parts = [];
  if (plato?.calorias != null && String(plato.calorias).trim() !== '') {
    parts.push(`${plato.calorias} kcal`);
  }
  const alergias = Array.isArray(plato?.alergias) ? plato.alergias : [];
  if (alergias.length) {
    const labels = alergias
      .map((id) => ALERGENOS_OPTIONS.find((opt) => opt.id === id)?.label || id)
      .slice(0, 3);
    parts.push(labels.join(', ') + (alergias.length > 3 ? '…' : ''));
  }
  return parts.length ? parts.join(' · ') : 'Sin ficha · clic para editar';
}

const tabPillBase =
  'dashboard-tab shrink-0 px-4 py-1.5 rounded-full text-xs font-semibold tracking-tight transition-all';
const tabPillActive = `${tabPillBase} is-on`;
const tabPillInactive = `${tabPillBase}`;

const sampleBulk = isSuperAdmin
  ? `Categoría | Nombre | Descripción | Precio | Destacado | Imagen
Crudos | Edamame | Salteado con sal marina | 6.50 | SI | https://res.cloudinary.com/demo/image/upload/sample.jpg
De Tierra | Bife | Corte a la parrilla | 24.00 | NO |
Contornos | Yuca frita | Crujiente | 6.00 | NO |
Postres | Tres leches | Coco | 9.00 | SI |`
  : '';
---

<Layout
  title={`${nombre} · Menú`}
  theme="crx"
  themeColor="#09090b"
  description="Gestión masiva del menú"
  adminPanel={true}
>
  <header
    class="admin-studio-header solid-obstacle relative sticky top-0 z-50 flex h-16 w-full min-w-0 items-center justify-between gap-2 overflow-x-clip border-b border-zinc-200/80 bg-white/80 px-3 backdrop-blur-xl dark:border-zinc-800/80 dark:bg-zinc-950/80 sm:gap-4 sm:px-8"
  >
    <div class="z-10 flex h-16 max-h-16 min-w-0 items-center gap-1.5 sm:gap-2">
      <a
        href={managingAsSuperAdmin || isSuperAdmin ? '/admin/super/dashboard' : '/admin/dashboard'}
        class="group flex h-16 items-center transition-opacity hover:opacity-80"
        aria-label="Xemilla Studio"
      >
        <img
          src={xemillaWordmark}
          alt="Xemilla"
          width="160"
          height="48"
          class="admin-studio-header__xemilla block h-8 w-auto max-h-9 max-w-[6.5rem] object-contain sm:h-10 sm:max-h-10 sm:max-w-none"
          loading="eager"
          decoding="async"
        />
      </a>

      {
        restaurante ? (
          <>
            <span class="select-none text-lg font-light leading-none text-zinc-300 dark:text-zinc-600" aria-hidden="true">
              /
            </span>
            {
              hubLogoTrimUrl ? (
                <img
                  src={hubLogoTrimUrl}
                  alt={restaurante.nombre_comercial || 'Restaurante'}
                  class="admin-studio-header__venue-logo ml-1.5 block h-8 w-auto max-h-9 max-w-[4.75rem] object-contain sm:ml-2.5 sm:h-10 sm:max-h-10 sm:max-w-[9rem]"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span class="ml-1.5 max-w-[6.5rem] truncate text-sm font-semibold tracking-tight text-zinc-800 dark:text-zinc-200 sm:ml-2.5 sm:max-w-[10rem]">
                  {restaurante.nombre_comercial || 'Restaurante'}
                </span>
              )
            }
          </>
        ) : null
      }
    </div>

    <div class="z-10 flex min-w-0 shrink-0 items-center gap-1 sm:gap-4">
      {
        (managingAsSuperAdmin || isSuperAdmin) && restaurante ? (
          <a
            href="/admin/super/dashboard"
            class="admin-superadmin-chip hidden items-center gap-1.5 rounded-md border px-2 py-1 text-[0.6rem] font-bold uppercase tracking-[0.12em] shadow-sm transition sm:inline-flex"
          >
            ← SuperAdmin
          </a>
        ) : null
      }
      {
        publicWebAppUrl ? (
          <div class="admin-studio-header__utils flex items-center gap-1">
            <a
              href={publicWebAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="admin-studio-header__link"
              aria-label="Abrir WebApp del restaurante"
              title="Abrir WebApp"
            >
              WebApp ↗
            </a>
          </div>
        ) : null
      }

      {
        isSuperAdmin && restaurante ? (
          <button
            type="button"
            id="marca-save"
            hidden
            data-save-state="idle"
            class="marca-save-btn admin-action-btn inline-flex h-8 w-8 items-center justify-center rounded-lg p-0 text-[0.65rem] font-semibold uppercase tracking-[0.14em] transition active:scale-[0.98] disabled:opacity-50 sm:h-auto sm:w-auto sm:px-4 sm:py-1.5"
            aria-label="Guardar cambios"
          >
            <svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 5h11l3 3v11H5V5z"></path>
              <path d="M8 5v4h8V5"></path>
              <path d="M8 19v-6h8v6"></path>
            </svg>
            <span class="marca-save-label hidden sm:inline">Guardar</span>
          </button>
        ) : null
      }

      <form method="POST" action="/api/admin-logout">
        <button type="submit" class="admin-studio-header__link inline-flex items-center" title="Cerrar sesión" aria-label="Cerrar sesión">
          <svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"></path>
            <path d="M10 17l-5-5 5-5"></path>
            <path d="M5 12h11"></path>
          </svg>
          <span class="hidden sm:inline">Salir</span>
        </button>
      </form>
    </div>

    {/* Nav pills — desktop centered; mobile uses bottom dock */}
    {
      restaurante ? (
        <nav
          class="admin-studio-header__nav hidden w-full items-center justify-center overflow-x-auto scrollbar-hide lg:absolute lg:left-1/2 lg:order-2 lg:flex lg:w-auto lg:-translate-x-1/2"
          role="tablist"
          aria-label="Secciones del panel"
          data-admin-top-nav
        >
          <div class="admin-studio-header__tabs flex gap-1 rounded-full p-1">
            <button
              type="button"
              role="tab"
              id="tab-menu"
              data-tab-target="menu"
              aria-selected="true"
              aria-controls="panel-menu"
              class={`${tabPillActive} active`}
            >
              Menú
            </button>
            {
              !isSuperAdmin && (
            <button
              type="button"
              role="tab"
              id="tab-perfil"
              data-tab-target="perfil"
              aria-selected="false"
              aria-controls="panel-perfil"
              class={`${tabPillInactive}`}
            >
              Operación &amp; Anuncios
            </button>
              )
            }
            <button
              type="button"
              role="tab"
              id="tab-metricas"
              data-tab-target="metricas"
              aria-selected="false"
              aria-controls="panel-metricas"
              class={`${tabPillInactive}`}
            >
              Métricas
            </button>
            {
              isSuperAdmin && (
                <button
                  type="button"
                  role="tab"
                  id="tab-identidad"
                  data-tab-target="identidad"
                  aria-selected="false"
                  aria-controls="panel-identidad"
                  class={`${tabPillInactive}`}
                >
                  Identidad
                </button>
              )
            }
          </div>
        </nav>
      ) : null
    }
  </header>

  <main class="relative z-10 min-h-[calc(100dvh-4rem)] w-full min-w-full max-w-none bg-transparent">
    <div class="relative z-10 w-full max-w-none overflow-x-clip px-4 py-6 sm:px-8 lg:px-12 pb-[max(9.5rem,calc(env(safe-area-inset-bottom)+8rem))] sm:pb-16">
    {
      !restaurante ? (
        <div class={`glass-panel ${bounceWallClass} max-w-xl p-8 text-center`}>
          <p class="text-sm text-zinc-400">
            {
              isSuperAdmin
                ? 'No encontramos ese restaurante. Volvé al hub de SuperAdmin y abrí un local.'
                : assignedRestauranteId
                ? 'Tu restaurante asignado ya no existe en la base. Pedile al SuperAdmin que te reasigne.'
                : 'No tenés un restaurante asignado. Pedile al SuperAdmin que cree tus credenciales operativas.'
            }
          </p>
          {
            isSuperAdmin ? (
              <a
                href="/admin/super/dashboard"
                class="mt-4 inline-flex text-sm font-semibold text-white underline"
              >
                Ir al hub
              </a>
            ) : null
          }
        </div>
      ) : (
        <div
          data-restaurante-id={restId}
          id="dashboard-root"
          class="w-full min-w-0 max-w-none"
          data-slug={publicSlug}
          data-categorias={categoriasJson}
          data-sucursales={sucursalesJson}
          data-agotados-sucursal={agotadosSucursalJson}
          data-gadget-sucursales={gadgetSucursales ? 'true' : 'false'}
          data-sucursales-cupo={sucursalesCupo}
          data-is-super-admin={isSuperAdmin ? 'true' : 'false'}
          data-gadget-nutricion={marca.gadget_nutricion ? 'true' : 'false'}
          data-gadget-ar={marca.gadget_ar ? 'true' : 'false'}
        >
          <div
            id="panel-menu"
            role="tabpanel"
            aria-labelledby="tab-menu"
            data-tab-panel="menu"
            class="admin-fade-in-up w-full min-w-0 max-w-none"
          >
          {
            isSuperAdmin && (
              <div class="menu-command mb-2">
                <div class="hidden flex-wrap items-center gap-2 sm:flex">
                  <button
                    type="button"
                    id="bulk-toggle"
                    aria-expanded="false"
                    aria-controls="bulk-panel"
                    class="menu-cmd-btn"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <path d="M12 16V4"></path>
                      <path d="M8 8l4-4 4 4"></path>
                      <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"></path>
                    </svg>
                    Carga Masiva (CSV / Texto)
                    <svg id="bulk-toggle-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300" aria-hidden="true">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </button>

                  <button
                    type="button"
                    id="nutricion-bulk-toggle"
                    data-shows-when-nutricion
                    aria-expanded="false"
                    aria-controls="nutricion-bulk-panel"
                    class:list={[
                      'menu-cmd-btn',
                      !marca.gadget_nutricion && 'hidden',
                    ]}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <path d="M4 6.75h16M6 6.75v10.5A1.5 1.5 0 0 0 7.5 18.75h9a1.5 1.5 0 0 0 1.5-1.5V6.75M9 10.5h6M9 14h4" />
                    </svg>
                    Carga nutricional
                  </button>

                  <button
                    type="button"
                    id="nuevo-plato-open"
                    data-nuevo-plato-open
                    class="menu-cmd-btn menu-cmd-btn--primary"
                  >
                    <span aria-hidden="true">+</span>
                    Nuevo Plato
                  </button>
                </div>

                {/* Mobile primary actions — full-width app bar */}
                <div class="grid grid-cols-2 gap-2 sm:hidden">
                  <button
                    type="button"
                    id="bulk-toggle-mobile"
                    aria-expanded="false"
                    aria-controls="bulk-panel"
                    class="menu-cmd-btn justify-center py-3 sm:py-2"
                  >
                    Carga masiva
                  </button>
                  <button
                    type="button"
                    data-nuevo-plato-open
                    class="menu-cmd-btn menu-cmd-btn--primary justify-center py-3 sm:py-2"
                  >
                    + Nuevo
                  </button>
                  <button
                    type="button"
                    id="nutricion-bulk-toggle-mobile"
                    data-shows-when-nutricion
                    aria-expanded="false"
                    aria-controls="nutricion-bulk-panel"
                    class:list={[
                      'col-span-2 menu-cmd-btn justify-center py-3',
                      !marca.gadget_nutricion && 'hidden',
                    ]}
                  >
                    Carga nutricional
                  </button>
                </div>

                <section
                  id="bulk-panel"
                  class={`bulk-panel glass-panel ${bounceWallClass} overflow-hidden`}
                  data-open="false"
                  aria-hidden="true"
                >
                  <div class="bulk-panel__inner p-6 lg:p-7">
                    <p class="text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-zinc-500">
                      Bulk Upload
                    </p>
                    <h2 class="mt-2 font-blacksushi-display text-2xl font-semibold tracking-tight">
                      Cargador Masivo de Menú
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-500">
                      Pegá filas con Categoría, Nombre, Descripción, Precio, Destacado e Imagen.
                      La columna Categoría define el lugar (ej. Contornos, De Tierra, Crudos); aliases como
                      Guarniciones se normalizan solos.
                    </p>
                    <p class="mt-3 max-w-2xl rounded-xl border border-white/8 bg-white/[0.03] px-3.5 py-3 text-xs leading-relaxed text-zinc-500">
                      Tip multimedia: en la columna
                      <span class="font-medium text-zinc-300">Imagen</span>
                      podés pegar URLs de Cloudinary (foto, GIF o video).
                    </p>

                    <label for="bulk-text" class="sr-only">Texto del menú</label>
                    <textarea
                      id="bulk-text"
                      rows="12"
                      spellcheck="false"
                      placeholder={sampleBulk}
                      class="mt-5 min-h-[16rem] w-full resize-y rounded-2xl border border-white/10 bg-black/35 px-4 py-4 font-mono text-[12px] leading-relaxed text-zinc-200 outline-none transition placeholder:text-zinc-700 focus:border-white/25 focus:ring-2 focus:ring-white/10"
                    ></textarea>

                    <div id="bulk-preview" class="bulk-preview mt-4 hidden" aria-live="polite">
                      <div class="bulk-preview__head">
                        <p class="bulk-preview__title">Vista previa de macros</p>
                        <p id="bulk-preview-meta" class="bulk-preview__meta"></p>
                      </div>
                      <div id="bulk-preview-summary" class="bulk-preview__summary"></div>
                      <div class="bulk-preview__table-wrap">
                        <table class="bulk-preview__table">
                          <thead>
                            <tr>
                              <th>#</th>
                              <th>Plato</th>
                              <th>Categoría</th>
                              <th>Macro</th>
                              <th>Precio</th>
                            </tr>
                          </thead>
                          <tbody id="bulk-preview-body"></tbody>
                        </table>
                      </div>
                      <p id="bulk-preview-errors" class="bulk-preview__errors hidden"></p>
                    </div>

                    <p id="bulk-feedback" class="mt-3 hidden text-xs leading-relaxed" role="status"></p>

                    <button
                      type="button"
                      id="bulk-submit"
                      data-restaurante-id={restId}
                      class="admin-action-btn mt-4 inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-zinc-950 transition-all duration-200 hover:opacity-90 hover:bg-zinc-100 active:scale-95 disabled:opacity-50"
                    >
                      Procesar e Insertar Menú Completo
                    </button>
                  </div>
                </section>

                <section
                  id="nutricion-bulk-panel"
                  class:list={[
                    `bulk-panel glass-panel ${bounceWallClass} overflow-hidden`,
                    !marca.gadget_nutricion && 'hidden',
                  ]}
                  data-open="false"
                  data-shows-when-nutricion
                  aria-hidden="true"
                >
                  <div class="bulk-panel__inner p-6 lg:p-7">
                    <p class="text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-zinc-500">
                      Nutrición
                    </p>
                    <h2 class="mt-2 font-blacksushi-display text-2xl font-semibold tracking-tight">
                      Carga masiva nutricional
                    </h2>
                    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-zinc-500">
                      Pegá un array JSON. El match es por <span class="text-zinc-300">nombre</span> de plato.
                      Campos:
                      <span class="font-mono text-zinc-400">nombre, calorias, proteinas, carbs, grasas, alergias[], ingredientes_detalle</span>.
                    </p>
                    <textarea
                      id="nutricion-bulk-text"
                      rows="8"
                      spellcheck="false"
                      placeholder='[{"nombre":"Ceviche de Pargo","calorias":220,"proteinas":28,"carbs":8,"grasas":9,"alergias":["pescado","picante"],"ingredientes_detalle":"Pargo, limón, ají…"}]'
