---
import Layout from '../layouts/Layout.astro';

const waHref =
  'https://wa.me/584148706285?text=Hola.%20Me%20interesa%20elevar%20la%20experiencia%20digital%20de%20mi%20restaurante%20y%20me%20gustar%C3%ADa%20agendar%20un%20demo%20de%20Xemilla.';

const logoSrc =
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337620/Photoroom_20260810_004814_islrgw.png';

/**
 * Placeholder cinematic BG — Mixkit free stock (smoke on black).
 * Swap `videoSrc` for a branded/dark particles asset when available.
 */
const videoSrc = 'https://assets.mixkit.co/videos/1961/1961-720.mp4';

const slogan = 'Plantamos la tecnología, tú cosechas el éxito.';
---

<Layout
  title="Xemilla · Software gastronómico"
  theme="crx"
  themeColor="#000000"
  description="Xemilla — software gastronómico de marca blanca para restaurantes"
>
  <main class="relative h-dvh w-screen overflow-hidden bg-black">
    {/* Immersive background — play once, climax zoom + fade to black */}
    <div class="hero-video-fade absolute inset-0 z-0 overflow-hidden bg-black" aria-hidden="true">
      <!-- TODO: Reemplazar este src por el enlace del video definitivo de Cloudinary -->
      <video
        id="hero-video"
        autoplay
        muted
        playsinline
        class="absolute inset-0 w-full h-full object-cover z-0"
        src={videoSrc}
      />
    </div>

    {/* Dark cinematic veil */}
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/50 to-black/90 z-10 pointer-events-none"></div>

    {/* Film grain between veil and UI */}
    <div class="bg-film-grain absolute inset-0 z-[15]" aria-hidden="true" />

    {/* System label — absolute top-right, out of central flow */}
    <p
      class="absolute top-8 right-8 z-50 backdrop-blur-md bg-white/10 border border-white/20 text-[9px] tracking-[0.4em] text-white/90 px-5 py-2 rounded-full uppercase shadow-[0_0_20px_rgba(255,255,255,0.05)]"
    >
      SOFTWARE GASTRONÓMICO
    </p>

    {/* Central hero — Logo → Slogan → CTA */}
    <div class="relative z-20 flex flex-col items-center justify-center min-h-screen px-4">
      <img
        src={logoSrc}
        alt="Xemilla"
        width="256"
        height="108"
        class="h-auto w-56 object-contain opacity-95 sm:w-64"
      />

      <h1
        class="slogan-typewriter text-xl md:text-3xl font-light tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-zinc-400 text-center max-w-xl mx-auto text-balance mt-6 mb-10 animate-[typewriter_5.5s_steps(46)_forwards]"
      >
        {slogan}
      </h1>

      <div
        id="cta-container"
        class="opacity-0 pointer-events-none transition-opacity duration-[1500ms] ease-in-out mt-12"
      >
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-subtle-scale inline-block backdrop-blur-xl bg-white/10 border border-white/20 text-white font-semibold tracking-wide px-10 py-4 rounded-lg transition-transform duration-300 hover:scale-[1.03] animate-[subtleScale_4s_ease-in-out_infinite]"
        >
          SOLICITAR ACCESO
        </a>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @keyframes typewriter {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  .slogan-typewriter {
    animation: typewriter 5.5s steps(46) forwards;
  }

  @keyframes subtleScale {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }

  .cta-subtle-scale {
    animation: subtleScale 4s ease-in-out infinite;
  }

  @keyframes fadeInSoft {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intoTheVoid {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.4); opacity: 0; }
  }
  .animate-void {
    animation: intoTheVoid 3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* Video wrapper: soft opacity fade from black (climax via .animate-void) */
  .hero-video-fade {
    opacity: 0;
    animation: fadeInSoft 3s ease-in-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-fade {
      opacity: 1;
      transform: none;
      animation: none !important;
    }

    .slogan-typewriter {
      clip-path: none;
      animation: none !important;
    }

    #cta-container {
      opacity: 1;
      pointer-events: auto;
    }

    .cta-subtle-scale {
      animation: none !important;
    }
  }
</style>

<script>
  function bindHeroClimax() {
    const video = document.getElementById('hero-video');
    const cta = document.getElementById('cta-container');
    if (!video) return;

    // Single bind guard (DOMContentLoaded + astro:page-load / ClientRouter)
    if (video.dataset.climaxBound === '1') return;
    video.dataset.climaxBound = '1';

    let transitionTriggered = false;

    video.addEventListener('timeupdate', () => {
      const timeLeft = video.duration - video.currentTime;

      // Detonar la transición 3 segundos antes de que acabe el video
      if (timeLeft <= 3.0 && !transitionTriggered) {
        transitionTriggered = true;

        // Inyectar la clase CSS pura que hace el zoom y el fundido
        video.classList.add('animate-void');

        // Revelar el botón CTA sincronizado con el fundido a negro
        if (cta) {
          // Aumentamos la duración del fade del botón para que sea más dramático
          cta.classList.replace('duration-[1500ms]', 'duration-[2500ms]');
          cta.classList.remove('opacity-0', 'pointer-events-none');
          cta.classList.add('opacity-100', 'pointer-events-auto');
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', bindHeroClimax);
  document.addEventListener('astro:page-load', bindHeroClimax);
</script>
