---
import Layout from '../layouts/Layout.astro';

const waHref =
  'https://wa.me/584148706285?text=Hola.%20Me%20interesa%20elevar%20la%20experiencia%20digital%20de%20mi%20restaurante%20y%20me%20gustar%C3%ADa%20agendar%20un%20demo%20de%20Xemilla.';

const logoSrc =
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337620/Photoroom_20260810_004814_islrgw.png';

/**
 * Placeholder cinematic BG — Mixkit free stock (smoke on black).
 * Swap `videoSrc` for a branded/dark particles asset when available.
 */
const videoSrc = 'https://assets.mixkit.co/videos/1961/1961-720.mp4';

const slogan = 'Plantamos la tecnología, tú cosechas el éxito.';
---

<Layout
  title="Xemilla · Software gastronómico"
  theme="crx"
  themeColor="#000000"
  description="Xemilla — software gastronómico de marca blanca para restaurantes"
>
  <main class="relative h-dvh w-screen overflow-hidden bg-black">
    {/* Immersive background — play once, climax zoom + fade to black */}
    <div class="hero-video-fade absolute inset-0 z-0 overflow-hidden bg-black" aria-hidden="true">
      <!-- TODO: Reemplazar este src por el enlace del video definitivo de Cloudinary -->
      <video
        id="hero-video"
        autoplay
        muted
        playsinline
        class="absolute inset-0 w-full h-full object-cover z-0"
        src={videoSrc}
      />
    </div>

    {/* Dark cinematic veil */}
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/50 to-black/90 z-10 pointer-events-none"></div>

    {/* Film grain between veil and UI */}
    <div class="bg-film-grain absolute inset-0 z-[15]" aria-hidden="true" />

    {/* Verified brand badge — exact top center */}
    <p
      class="absolute top-6 left-1/2 -translate-x-1/2 z-30 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-white/10 text-[10px] uppercase font-mono tracking-[0.25em] text-zinc-300 shadow-xl backdrop-blur-md hover:border-white/20 transition-all"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      SOFTWARE GASTRONÓMICO
    </p>

    {/* Central hero — Logo → Slogan → CTA */}
    <div class="relative z-20 flex min-h-screen flex-col items-center justify-center px-4 mt-12">
      <img
        src={logoSrc}
        alt="Xemilla"
        width="256"
        height="108"
        class="h-auto w-56 object-contain opacity-95 sm:w-64"
      />

      <h1
        id="hero-slogan"
        class="slogan-typewriter text-xl md:text-3xl font-light tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-zinc-400 text-center max-w-xl mx-auto text-balance mt-6 mb-10 animate-[typewriter_7s_steps(46)_3s_both,blink_0.75s_step-end_10s_4,hideCaret_0.01s_linear_13s_forwards] border-r-2 border-white/80 pr-1 inline-block"
      >
        {slogan}
      </h1>

      <div
        id="cta-container"
        class="opacity-0 pointer-events-none transition-opacity duration-[1500ms] ease-in-out mt-12"
      >
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-subtle-scale inline-block backdrop-blur-xl bg-white/10 border border-white/20 text-white font-semibold tracking-wide px-10 py-4 rounded-lg transition-transform duration-300 hover:scale-[1.03] animate-[subtleScale_4s_ease-in-out_infinite]"
        >
          SOLICITAR ACCESO
        </a>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  @keyframes typewriter {
    0% { clip-path: inset(0 100% 0 0); }
    100% { clip-path: inset(0 0 0 0); }
  }

  @keyframes blink {
    from, to { border-color: transparent; }
    50% { border-color: rgba(255, 255, 255, 0.9); }
  }

  @keyframes hideCaret {
    to {
      border-color: transparent;
      border-right-width: 0;
      padding-right: 0;
    }
  }

  .slogan-typewriter {
    display: inline-block;
    border-right: 2px solid rgba(255, 255, 255, 0.8);
    padding-right: 0.25rem;
    /* 0–3s clip delay → 3–10s type → 10–13s blink → 13s hide caret */
    animation:
      typewriter 7s steps(46) 3s both,
      blink 0.75s step-end 10s 4,
      hideCaret 0.01s linear 13s forwards;
  }

  @keyframes subtleScale {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }

  .cta-subtle-scale {
    animation: subtleScale 4s ease-in-out infinite;
  }

  @keyframes fadeInSoft {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intoTheVoid {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.4); opacity: 0; }
  }
  .animate-void {
    animation: intoTheVoid 3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* Video wrapper: soft opacity fade from black (climax via .animate-void) */
  .hero-video-fade {
    opacity: 0;
    animation: fadeInSoft 3s ease-in-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-fade {
      opacity: 1;
      transform: none;
      animation: none !important;
    }

    .slogan-typewriter {
      clip-path: none;
      animation: none !important;
    }

    #cta-container {
      opacity: 1;
      pointer-events: auto;
    }

    .cta-subtle-scale {
      animation: none !important;
    }
  }
</style>

<script>
  function bindHeroClimax() {
    const video = document.getElementById('hero-video');
    const cta = document.getElementById('cta-container');
    if (!video) return;

    // Single bind guard (DOMContentLoaded + astro:page-load / ClientRouter)
    if (video.dataset.climaxBound === '1') return;
    video.dataset.climaxBound = '1';

    let transitionTriggered = false;
    const startTime = performance.now();

    const tryTriggerClimax = () => {
      if (transitionTriggered) return;

      const duration = video.duration;
      const timeLeft = Number.isFinite(duration) ? duration - video.currentTime : Infinity;
      const typingDone = performance.now() - startTime >= 10000;
      const nearEnd = video.ended || timeLeft <= 3.0;

      // Video-driven climax, but wait until slogan typewriter (3s delay + 7s type = ~10s) finishes
      if (nearEnd && typingDone) {
        transitionTriggered = true;

        // Inyectar la clase CSS pura que hace el zoom y el fundido
        video.classList.add('animate-void');

        // Revelar el botón CTA sincronizado con el fundido a negro
        if (cta) {
          // Aumentamos la duración del fade del botón para que sea más dramático
          cta.classList.replace('duration-[1500ms]', 'duration-[2500ms]');
          cta.classList.remove('opacity-0', 'pointer-events-none');
          cta.classList.add('opacity-100', 'pointer-events-auto');
        }
      }
    };

    video.addEventListener('timeupdate', tryTriggerClimax);
    video.addEventListener('ended', tryTriggerClimax);
    // If video ends before typewriter, re-check once typing would finish
    setTimeout(tryTriggerClimax, 10000);

    // Fallback: ensure caret is gone after post-type blink (3s + 7s + 3s)
    setTimeout(() => {
      const sloganEl = document.getElementById('hero-slogan');
      if (!sloganEl) return;
      sloganEl.classList.remove('border-r-2', 'border-white/80', 'pr-1');
      sloganEl.style.borderRightWidth = '0';
      sloganEl.style.borderColor = 'transparent';
      sloganEl.style.paddingRight = '0';
    }, 13000);
  }

  document.addEventListener('DOMContentLoaded', bindHeroClimax);
  document.addEventListener('astro:page-load', bindHeroClimax);
</script>
