---
import Layout from '../layouts/Layout.astro';
import { restaurantes } from '../config/restaurantes.js';

const lista = Object.values(restaurantes);
---

<Layout title="CRX Restaurantes" theme="crx" themeColor="#09090b" description="SaaS multi-inquilino CRX">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col px-6 pb-12 pt-14 text-white">
    <header class="text-center">
      <p class="text-[0.62rem] font-semibold uppercase tracking-[0.35em] text-zinc-500">
        Multi-inquilino
      </p>
      <h1 class="mt-3 font-blacksushi-display text-4xl font-semibold tracking-tight">CRX</h1>
      <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-zinc-400">
        Experiencia web móvil por marca. Entra a un restaurante de prueba.
      </p>
    </header>

    <ul class="mt-12 space-y-3.5">
      {
        lista.map((r) => (
          <li>
            <a href={`/${r.slug}`} class="btn-premium block">
              <span class="btn-premium__inner !bg-zinc-950/90 !text-white">
                <span class="btn-premium__shine" aria-hidden="true" />
                <span class="flex flex-col items-center gap-1">
                  <span class="tracking-[0.28em]">{r.nombre}</span>
                  <span class="text-[10px] font-medium tracking-normal text-zinc-500 normal-case">
                    /{r.slug}
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="mt-auto pt-12 text-center text-[10px] tracking-[0.28em] uppercase text-zinc-600">
      Powered by CRX
    </footer>
  </main>
</Layout>

<style>
  .btn-premium {
    background: linear-gradient(
      135deg,
      rgba(159, 18, 57, 0.7),
      rgba(63, 63, 70, 0.85) 45%,
      rgba(24, 24, 27, 0.95)
    );
  }
</style>
