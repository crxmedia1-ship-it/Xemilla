---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { listPublicNetworkLogos } from '../lib/network-logos.js';

const waHref =
  'https://wa.me/584148706285?text=Hola.%20Me%20interesa%20elevar%20la%20experiencia%20digital%20de%20mi%20restaurante%20y%20me%20gustar%C3%ADa%20agendar%20un%20demo%20de%20Xemilla.';

const logoSrc =
  'https://res.cloudinary.com/dgphys1xd/image/upload/v1786337620/Photoroom_20260810_004814_islrgw.png';

/**
 * Placeholder cinematic BG — Mixkit free stock (smoke on black).
 * Swap `videoSrc` for a branded/dark particles asset when available.
 */
const videoSrc = 'https://assets.mixkit.co/videos/1961/1961-720.mp4';

const slogan = 'Plantamos la tecnología, tú cosechas el éxito.';

const networkLogos = await listPublicNetworkLogos();
/** Duplicado para marquee infinito sin corte */
const marqueeLogos =
  networkLogos.length > 0 ? [...networkLogos, ...networkLogos] : [];
---

<Layout
  title="Xemilla · Software gastronómico"
  theme="crx"
  themeColor="#000000"
  description="Xemilla — software gastronómico de marca blanca para restaurantes"
>
  <main
    id="hero-stage"
    class="landing-lock relative h-[100dvh] max-h-[100dvh] w-screen overflow-hidden overflow-x-hidden overscroll-none bg-black"
  >
    {/* Immersive background — play once, climax zoom + fade to black */}
    <div class="hero-video-fade absolute inset-0 z-0 overflow-hidden bg-black" aria-hidden="true">
      <!-- TODO: Reemplazar este src por el enlace del video definitivo de Cloudinary -->
      <video
        id="hero-video"
        autoplay
        muted
        playsinline
        class="absolute inset-0 z-0 h-full w-full object-cover"
        src={videoSrc}
      />
    </div>

    {/* Spatial void — black cosmos; fades in on climax */}
    <div id="spatial-void" class="spatial-void absolute inset-0 z-[1]" aria-hidden="true">
      <div class="spatial-void__base"></div>
      <div class="spatial-void__nebula"></div>
      <div class="spatial-void__stars"></div>
    </div>

    {/* Dark cinematic veil — softens with void over matched 3s crossfade */}
    <div
      class="cinematic-veil absolute inset-0 bg-gradient-to-b from-black/90 via-black/75 to-black/95 z-10 pointer-events-none transition-opacity duration-[3000ms] ease-in-out"
    ></div>

    {/* Film grain between veil and UI */}
    <div class="bg-film-grain absolute inset-0 z-[15] pointer-events-none" aria-hidden="true" />

    {/* Pointer light — paint-only, above grain / below CTA */}
    <div id="pointer-light" class="pointer-light absolute inset-0 z-[16]" aria-hidden="true"></div>

    {/* Light-revealed: partner logos + powered by CRX */}
    <div
      id="crx-credit"
      class="crx-credit absolute inset-0 z-[17] flex flex-col items-center justify-end gap-5 pb-[max(2.25rem,env(safe-area-inset-bottom))] pointer-events-none sm:gap-6 sm:pb-[max(2.75rem,env(safe-area-inset-bottom))]"
      aria-hidden="true"
    >
      {
        networkLogos.length > 0 && (
            <div class="partner-marquee mb-8 w-full max-w-3xl px-6 sm:mb-10" data-partner-marquee>
            <div class="partner-marquee__track">
              {marqueeLogos.map((item, i) => (
                <div class="partner-marquee__item" data-dup={i >= networkLogos.length ? '1' : '0'}>
                  <img
                    src={item.logoUrl}
                    alt=""
                    width="120"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    class="partner-marquee__logo"
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }
      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-white/90">
        powered by CRX
      </span>
    </div>

    {/* Verified brand badge — exact top center */}
    <p
      class="absolute top-[max(1.5rem,env(safe-area-inset-top))] left-1/2 -translate-x-1/2 z-30 inline-flex items-center justify-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-white/10 text-center text-[10px] uppercase font-mono tracking-[0.25em] text-zinc-300 shadow-xl backdrop-blur-md hover:border-white/20 transition-all"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      SOFTWARE GASTRONÓMICO
    </p>

    {/* Central hero — Logo → Slogan → CTA (raised on mobile, centered md+) */}
    <div
      class="relative z-20 flex h-[100dvh] max-h-[100dvh] w-full max-w-full flex-col items-center justify-start gap-3 overflow-hidden px-4 pt-[18vh] pb-[max(2.5rem,env(safe-area-inset-bottom))] md:justify-center md:gap-0 md:pt-0 md:pb-8"
    >
      <img
        src={logoSrc}
        alt="Xemilla"
        width="256"
        height="108"
        class="logo-settle h-auto w-[70%] max-w-[220px] object-contain opacity-95 sm:w-64 sm:max-w-none md:w-64"
      />

      <h1
        id="hero-slogan"
        class="slogan-typewriter inline-block whitespace-nowrap text-sm sm:text-xl md:text-3xl font-light tracking-tight sm:tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-zinc-400 text-center mt-0 mb-3 md:mt-6 md:mb-10 animate-[typewriter_7s_steps(46)_3s_both,blink_0.75s_step-end_10s_4,hideCaret_0.01s_linear_13s_forwards] border-r-2 border-white/80 pr-1"
      >
        {slogan}
      </h1>

      <div
        id="cta-container"
        class="opacity-0 pointer-events-none transition-opacity duration-[1500ms] ease-in-out mt-3 md:mt-12"
      >
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-subtle-scale inline-block backdrop-blur-xl bg-white/10 border border-white/20 text-white font-semibold tracking-wide px-8 py-3.5 md:px-10 md:py-4 rounded-lg transition-transform duration-300 hover:scale-[1.03] animate-[subtleScale_4s_ease-in-out_infinite]"
        >
          SOLICITAR ACCESO
        </a>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* Lock landing to one viewport — no rubber-band scroll on mobile */
  html:has(.landing-lock),
  html:has(.landing-lock) body {
    height: 100%;
    max-height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .landing-lock {
    overscroll-behavior: none;
    touch-action: manipulation;
  }

  @keyframes typewriter {
    0% { clip-path: inset(0 100% 0 0); }
    100% { clip-path: inset(0 0 0 0); }
  }

  @keyframes blink {
    from, to { border-color: transparent; }
    50% { border-color: rgba(255, 255, 255, 0.9); }
  }

  @keyframes hideCaret {
    to {
      border-color: transparent;
      border-right-width: 0;
      padding-right: 0;
    }
  }

  .slogan-typewriter {
    display: inline-block;
    white-space: nowrap;
    max-width: 100%;
    border-right: 2px solid rgba(255, 255, 255, 0.8);
    padding-right: 0.25rem;
    /* 0–3s clip delay → 3–10s type → 10–13s blink → 13s hide caret */
    animation:
      typewriter 7s steps(46) 3s both,
      blink 0.75s step-end 10s 4,
      hideCaret 0.01s linear 13s forwards;
  }

  /* Fit 46-char Spanish line on very narrow phones without wrapping */
  @media (max-width: 380px) {
    .slogan-typewriter {
      font-size: 0.72rem;
      letter-spacing: -0.025em;
    }
  }

  @keyframes logoSettle {
    from {
      opacity: 0.85;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .logo-settle {
    animation: logoSettle 3s cubic-bezier(0.16, 1, 0.3, 1) both;
    transform-origin: center center;
  }

  @keyframes subtleScale {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }

  .cta-subtle-scale {
    animation: subtleScale 4s ease-in-out infinite;
  }

  @keyframes fadeInSoft {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes intoTheVoid {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  #hero-video.animate-void {
    animation: intoTheVoid 3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    will-change: transform, opacity;
  }

  /* Video wrapper: soft opacity fade from black (climax via .animate-void) */
  .hero-video-fade {
    opacity: 0;
    animation: fadeInSoft 3s ease-in-out forwards;
  }

  /* After intoTheVoid (3s) finishes: park video layer fully off */
  #hero-stage.climax-done .hero-video-fade {
    opacity: 0 !important;
    animation: none !important;
  }

  /* ——— Spatial void — black cosmos (no purple); 3s crossfade with intoTheVoid ——— */
  .spatial-void {
    opacity: 0;
    pointer-events: none;
    transition: opacity 3s ease-in-out;
  }

  .spatial-void.void-active {
    opacity: 1;
  }

  .spatial-void__base,
  .spatial-void__nebula,
  .spatial-void__stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Near-pure black + charcoal vignette only */
  .spatial-void__base {
    background:
      radial-gradient(ellipse 120% 90% at 50% 40%, rgba(18, 18, 18, 0.55) 0%, transparent 55%),
      radial-gradient(ellipse 100% 100% at 50% 100%, rgba(0, 0, 0, 0.95) 0%, transparent 50%),
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0, 0, 0, 0.75) 0%, transparent 45%),
      #050505;
  }

  /* Soft white/charcoal nebula — no purple / indigo / blue-violet */
  .spatial-void__nebula {
    background:
      radial-gradient(ellipse 55% 40% at 22% 68%, rgba(255, 255, 255, 0.045) 0%, transparent 70%),
      radial-gradient(ellipse 45% 35% at 78% 28%, rgba(160, 160, 160, 0.04) 0%, transparent 65%),
      radial-gradient(ellipse 50% 45% at 58% 72%, rgba(40, 40, 40, 0.55) 0%, transparent 70%);
    filter: blur(28px);
    opacity: 0.9;
    transform: translate3d(0, 0, 0);
    animation: nebulaDrift 28s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes nebulaDrift {
    0% { transform: translate3d(-1.5%, 1%, 0) scale(1); }
    100% { transform: translate3d(2%, -1.5%, 0) scale(1.04); }
  }

  /* White/grey stars — denser field, mostly faint so it never crowds the void */
  .spatial-void__stars {
    opacity: 0.58;
    background-image:
      /* Primary (a bit brighter, sparse) */
      radial-gradient(1.5px 1.5px at 8% 12%, rgba(255, 255, 255, 0.78), transparent),
      radial-gradient(1px 1px at 18% 42%, rgba(200, 200, 200, 0.5), transparent),
      radial-gradient(1.5px 1.5px at 27% 78%, rgba(255, 255, 255, 0.48), transparent),
      radial-gradient(1px 1px at 35% 18%, rgba(180, 180, 180, 0.4), transparent),
      radial-gradient(2px 2px at 44% 55%, rgba(255, 255, 255, 0.68), transparent),
      radial-gradient(1px 1px at 52% 8%, rgba(220, 220, 220, 0.5), transparent),
      radial-gradient(1.5px 1.5px at 61% 33%, rgba(255, 255, 255, 0.36), transparent),
      radial-gradient(1px 1px at 69% 71%, rgba(190, 190, 190, 0.52), transparent),
      radial-gradient(1.5px 1.5px at 76% 14%, rgba(255, 255, 255, 0.58), transparent),
      radial-gradient(1px 1px at 84% 48%, rgba(200, 200, 200, 0.4), transparent),
      radial-gradient(2px 2px at 91% 82%, rgba(255, 255, 255, 0.62), transparent),
      radial-gradient(1px 1px at 12% 88%, rgba(170, 170, 170, 0.36), transparent),
      radial-gradient(1px 1px at 40% 92%, rgba(255, 255, 255, 0.3), transparent),
      radial-gradient(1.5px 1.5px at 95% 25%, rgba(210, 210, 210, 0.45), transparent),
      radial-gradient(1px 1px at 58% 44%, rgba(255, 255, 255, 0.26), transparent),
      /* Mid layer */
      radial-gradient(1px 1px at 5% 58%, rgba(255, 255, 255, 0.36), transparent),
      radial-gradient(1px 1px at 15% 28%, rgba(210, 210, 210, 0.3), transparent),
      radial-gradient(1.2px 1.2px at 22% 64%, rgba(255, 255, 255, 0.38), transparent),
      radial-gradient(1px 1px at 31% 8%, rgba(190, 190, 190, 0.32), transparent),
      radial-gradient(1px 1px at 38% 48%, rgba(255, 255, 255, 0.28), transparent),
      radial-gradient(1.3px 1.3px at 47% 22%, rgba(230, 230, 230, 0.4), transparent),
      radial-gradient(1px 1px at 54% 66%, rgba(255, 255, 255, 0.3), transparent),
      radial-gradient(1px 1px at 63% 88%, rgba(180, 180, 180, 0.34), transparent),
      radial-gradient(1.2px 1.2px at 72% 42%, rgba(255, 255, 255, 0.36), transparent),
      radial-gradient(1px 1px at 80% 6%, rgba(200, 200, 200, 0.32), transparent),
      radial-gradient(1px 1px at 88% 60%, rgba(255, 255, 255, 0.28), transparent),
      radial-gradient(1.4px 1.4px at 97% 38%, rgba(220, 220, 220, 0.38), transparent),
      radial-gradient(1px 1px at 3% 34%, rgba(255, 255, 255, 0.24), transparent),
      radial-gradient(1px 1px at 26% 52%, rgba(190, 190, 190, 0.28), transparent),
      radial-gradient(1px 1px at 49% 80%, rgba(255, 255, 255, 0.32), transparent),
      /* Dust (tiny, very faint) */
      radial-gradient(0.8px 0.8px at 10% 50%, rgba(255, 255, 255, 0.22), transparent),
      radial-gradient(0.8px 0.8px at 20% 16%, rgba(255, 255, 255, 0.2), transparent),
      radial-gradient(0.8px 0.8px at 33% 70%, rgba(255, 255, 255, 0.21), transparent),
      radial-gradient(0.8px 0.8px at 42% 30%, rgba(255, 255, 255, 0.18), transparent),
      radial-gradient(0.8px 0.8px at 56% 58%, rgba(255, 255, 255, 0.2), transparent),
      radial-gradient(0.8px 0.8px at 67% 20%, rgba(255, 255, 255, 0.19), transparent),
      radial-gradient(0.8px 0.8px at 74% 86%, rgba(255, 255, 255, 0.21), transparent),
      radial-gradient(0.8px 0.8px at 82% 34%, rgba(255, 255, 255, 0.18), transparent),
      radial-gradient(0.8px 0.8px at 90% 72%, rgba(255, 255, 255, 0.2), transparent),
      radial-gradient(0.8px 0.8px at 6% 76%, rgba(255, 255, 255, 0.17), transparent),
      radial-gradient(0.8px 0.8px at 48% 12%, rgba(255, 255, 255, 0.19), transparent),
      radial-gradient(0.8px 0.8px at 93% 52%, rgba(255, 255, 255, 0.18), transparent);
    transition: opacity 3s ease-in-out;
  }

  .spatial-void.void-active .spatial-void__stars {
    opacity: 0.88;
  }

  /* Soften black veil so stars read — still black, no purple haze */
  #hero-stage.void-active .cinematic-veil {
    opacity: 0.35;
  }

  /* Pointer spotlight — soft white; coords from window listeners */
  .pointer-light {
    --lx: 50%;
    --ly: 50%;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--lx, 50%) var(--ly, 50%),
      rgba(255, 255, 255, 0.2),
      rgba(160, 160, 160, 0.06) 35%,
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    mix-blend-mode: screen;
  }

  .pointer-light.light-active {
    opacity: 1;
  }

  /* Light-revealed credit + logos — full-bleed; mask at pointer reveals bottom strip */
  .crx-credit {
    --lx: -9999px;
    --ly: -9999px;
    opacity: 0;
    transition: opacity 0.35s ease;
    -webkit-mask-image: radial-gradient(
      260px circle at var(--lx) var(--ly),
      #000 0%,
      rgba(0, 0, 0, 0.75) 42%,
      transparent 72%
    );
    mask-image: radial-gradient(
      260px circle at var(--lx) var(--ly),
      #000 0%,
      rgba(0, 0, 0, 0.75) 42%,
      transparent 72%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .crx-credit.light-active {
    opacity: 1;
  }

  /* Partner logo marquee — monochrome white; only visible under light mask */
  .partner-marquee {
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  .partner-marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 2.25rem;
    animation: partnerMarquee 38s linear infinite;
    will-change: transform;
  }

  .partner-marquee__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.75rem;
  }

  .partner-marquee__logo {
    display: block;
    height: 1.55rem;
    width: auto;
    max-width: 7.5rem;
    object-fit: contain;
    /* Unifica todos los logos al mismo color (blanco) */
    filter: brightness(0) invert(1);
    opacity: 0.88;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (min-width: 768px) {
    .partner-marquee__item {
      height: 2rem;
    }

    .partner-marquee__logo {
      height: 1.85rem;
      max-width: 9rem;
    }

    .partner-marquee__track {
      gap: 2.75rem;
    }
  }

  @keyframes partnerMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-fade {
      opacity: 1;
      transform: none;
      animation: none !important;
    }

    #hero-video.animate-void {
      transform: none;
      animation: none !important;
      will-change: auto;
    }

    .logo-settle {
      opacity: 0.95;
      transform: none;
      animation: none !important;
    }

    .slogan-typewriter {
      clip-path: none;
      animation: none !important;
    }

    #cta-container {
      opacity: 1;
      pointer-events: auto;
    }

    .cta-subtle-scale {
      animation: none !important;
    }

    .spatial-void {
      transition: none;
    }

    .spatial-void.void-active {
      opacity: 1;
    }

    .spatial-void__nebula {
      animation: none !important;
      will-change: auto;
    }

    #hero-stage.void-active .cinematic-veil {
      opacity: 0.35;
      transition: none;
    }

    .partner-marquee__track {
      animation: none !important;
      transform: none !important;
      justify-content: center;
      width: 100%;
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }

    .partner-marquee__item[data-dup='1'] {
      display: none;
    }
  }
</style>

<script>
  function bindHeroClimax() {
    const video = document.getElementById('hero-video');
    const cta = document.getElementById('cta-container');
    const stage = document.getElementById('hero-stage');
    const voidEl = document.getElementById('spatial-void');
    const lightEl = document.getElementById('pointer-light');
    const creditEl = document.getElementById('crx-credit');
    if (!video) return;

    // Single bind guard (DOMContentLoaded + astro:page-load / ClientRouter)
    if (video.dataset.climaxBound === '1') return;
    video.dataset.climaxBound = '1';

    let transitionTriggered = false;
    const startTime = performance.now();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setLight = (x, y) => {
      const lx = `${x}px`;
      const ly = `${y}px`;
      if (lightEl) {
        lightEl.style.setProperty('--lx', lx);
        lightEl.style.setProperty('--ly', ly);
        lightEl.classList.add('light-active');
      }
      if (creditEl) {
        creditEl.style.setProperty('--lx', lx);
        creditEl.style.setProperty('--ly', ly);
        creditEl.classList.add('light-active');
      }
    };

    const hideLight = () => {
      lightEl?.classList.remove('light-active');
      creditEl?.classList.remove('light-active');
      if (creditEl) {
        creditEl.style.setProperty('--lx', '-9999px');
        creditEl.style.setProperty('--ly', '-9999px');
      }
    };

    // Ignore mouse events that browsers fire after a touch (would re-stick the light)
    let touchActive = false;
    let ignoreMouseUntil = 0;

    const onMouseMove = (e) => {
      if (touchActive || performance.now() < ignoreMouseUntil) return;
      setLight(e.clientX, e.clientY);
    };

    const onTouchPoint = (e) => {
      const t = e.touches && e.touches[0];
      if (!t) return;
      touchActive = true;
      setLight(t.clientX, t.clientY);
    };

    const onTouchEnd = () => {
      touchActive = false;
      ignoreMouseUntil = performance.now() + 500;
      hideLight();
    };

    // Listen on window so CTA stays clickable (light + credit are pointer-events-none)
    // Touch: press-and-hold only — hide on lift/cancel. Mouse: follow while moving.
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseleave', hideLight, { passive: true });
    document.documentElement.addEventListener('mouseleave', hideLight, { passive: true });
    window.addEventListener('touchstart', onTouchPoint, { passive: true });
    window.addEventListener('touchmove', onTouchPoint, { passive: true });
    window.addEventListener('touchend', onTouchEnd, { passive: true });
    window.addEventListener('touchcancel', onTouchEnd, { passive: true });

    // Reduced motion: show cosmos + CTA without waiting on climax
    if (reduceMotion) {
      stage?.classList.add('climax-done', 'void-active');
      voidEl?.classList.add('void-active');
    }

    const tryTriggerClimax = () => {
      if (transitionTriggered) return;

      const duration = video.duration;
      const timeLeft = Number.isFinite(duration) ? duration - video.currentTime : Infinity;
      const typingDone = performance.now() - startTime >= 10000;
      const nearEnd = video.ended || timeLeft <= 3.0;

      // Video-driven climax, but wait until slogan typewriter (3s delay + 7s type = ~10s) finishes
      if (nearEnd && typingDone) {
        transitionTriggered = true;

        // Classic crossfade: intoTheVoid (3s) + spatial void + veil all start together
        video.classList.add('animate-void');
        stage?.classList.add('void-active');
        voidEl?.classList.add('void-active');

        // Park video layer only after dissolve — avoids hard cut via climax-done
        window.setTimeout(() => {
          stage?.classList.add('climax-done');
        }, 3000);

        // CTA with climax; slight delay so void is already blending under
        if (cta) {
          window.setTimeout(() => {
            cta.classList.replace('duration-[1500ms]', 'duration-[2500ms]');
            cta.classList.remove('opacity-0', 'pointer-events-none');
            cta.classList.add('opacity-100', 'pointer-events-auto');
          }, 400);
        }
      }
    };

    video.addEventListener('timeupdate', tryTriggerClimax);
    video.addEventListener('ended', tryTriggerClimax);
    // If video ends before typewriter, re-check once typing would finish
    setTimeout(tryTriggerClimax, 10000);

    // Fallback: ensure caret is gone after post-type blink (3s + 7s + 3s)
    setTimeout(() => {
      const sloganEl = document.getElementById('hero-slogan');
      if (!sloganEl) return;
      sloganEl.classList.remove('border-r-2', 'border-white/80', 'pr-1');
      sloganEl.style.borderRightWidth = '0';
      sloganEl.style.borderColor = 'transparent';
      sloganEl.style.paddingRight = '0';
    }, 13000);
  }

  document.addEventListener('DOMContentLoaded', bindHeroClimax);
  document.addEventListener('astro:page-load', bindHeroClimax);
</script>
