---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { listPublicNetworkLogos } from '../lib/network-logos.js';

const waHref =
  'https://wa.me/584148706285?text=Hola.%20Me%20interesa%20elevar%20la%20experiencia%20digital%20de%20mi%20restaurante%20y%20me%20gustar%C3%ADa%20agendar%20un%20demo%20de%20Xemilla.';

const FONT_HREF = 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap';

const slogan = 'Plantamos la tecnología, tú cosechas el éxito.';

const networkLogos = await listPublicNetworkLogos();
/** La tira se repite para que el carrusel llene el ancho cuando entren más marcas. */
const logoStrip = networkLogos.length
  ? Array.from({ length: Math.ceil(8 / networkLogos.length) }, () => networkLogos).flat()
  : [];

/** Trazo fino (script) necesita más altura. */
function markScale(name: string) {
  const n = name.toLowerCase();
  if (n.includes('sanza')) return 2.05;
  if (n.includes('cant')) return 1.15;
  return 1;
}

/** El rombo blanco de Hangang, al pasarlo a negro, tapa el dibujo. */
function partnerLogo(item: { name: string; logoUrl: string }) {
  if (/hangang/i.test(item.name) || /hangang\.svg/i.test(item.logoUrl)) return '/logos/hangang-ink.svg';
  return item.logoUrl;
}

---

<Layout
  title="Xemilla · Software gastronómico"
  theme="crx"
  themeColor="#e07028"
  fontHref={FONT_HREF}
  description="Xemilla — software gastronómico de marca blanca para restaurantes"
  ogImage={`${Astro.url.origin}/home/og.jpg`}
  ogUrl={Astro.url.origin}
  manifestHref="/manifest.webmanifest"
  appName="Xemilla"
>
  <div class="studio" aria-hidden="true">
    <img
      class="studio__photo"
      src="/home/fondo.jpg"
      alt=""
      width="1024"
      height="1024"
      decoding="async"
      fetchpriority="high"
    />
    <div class="studio__veil"></div>
  </div>

  <main class="landing-lock relative z-10 flex h-[100dvh] max-h-[100dvh] w-full flex-col items-center overflow-hidden px-5 font-blacksushi text-zinc-950">
    <p class="landing-in mt-[max(1.5rem,env(safe-area-inset-top))] inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/60 px-3.5 py-1.5 text-[10px] font-medium uppercase tracking-[0.24em] text-zinc-500 shadow-[0_10px_30px_-18px_rgba(40,30,20,0.35)] backdrop-blur-xl">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>
      Software gastronómico
    </p>

    <div class="flex w-full flex-1 flex-col items-center justify-center text-center">
      <img
        src="/propuesta/xemilla-on-light.png"
        alt="Xemilla"
        width="766"
        height="249"
        class="landing-in h-auto w-[74%] max-w-[340px] sm:w-[24rem] sm:max-w-none"
        style="--d: 0.1s"
        decoding="async"
      />
      <h1
        class="landing-in mt-12 max-w-lg text-balance text-[1.45rem] font-normal leading-[1.2] tracking-[-0.03em] text-zinc-950/70 sm:mt-16 sm:text-[2.15rem]"
        style="--d: 0.25s"
      >
        {slogan}
      </h1>
      <div class="access landing-in mt-8" style="--d: 0.4s" data-href={waHref}>
        <span class="access__sheen" aria-hidden="true"></span>
        <span class="access__label">Solicitar acceso</span>
        <button type="button" class="access__knob" aria-label="Desliza para solicitar acceso">
          <svg class="access__glyph access__glyph--go" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4.5 4.25 8 8l-3.5 3.75M8.5 4.25 12 8l-3.5 3.75" />
          </svg>
          <svg class="access__glyph access__glyph--ok" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
          </svg>
        </button>
      </div>
    </div>

    <footer class="landing-in flex w-full flex-col items-center gap-5 pb-[max(1.75rem,env(safe-area-inset-bottom))] sm:gap-6" style="--d: 0.55s">
      {
        networkLogos.length > 0 && (
          <div class="partners" role="region" aria-label="Restaurantes que usan Xemilla">
            <div class="partners__track">
              {[0, 1].map((copy) => (
                <ul class="partners__set" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {logoStrip.map((item, i) => (
                    <li style={`--mark:${markScale(item.name)}`}>
                      <img
                        src={partnerLogo(item)}
                        alt={copy === 0 && i < networkLogos.length ? item.name : ''}
                        width="160"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        )
      }
      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-zinc-950/55">powered by CRX</span>
    </footer>
  </main>

</Layout>

<style is:global>
  /* Una sola pantalla, sin rebote de scroll en móvil. */
  html:has(.landing-lock),
  html:has(.landing-lock) body {
    height: 100%;
    max-height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>

<style>
  .landing-lock {
    overscroll-behavior: none;
    touch-action: manipulation;
  }

  .studio {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #e07028;
  }

  .studio__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: 46% 42%;
    animation: ken-burns 32s ease-in-out infinite alternate;
    will-change: transform;
  }

  .studio__veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 46% 34% at 50% 44%, rgba(255, 250, 242, 0.42), transparent 72%);
  }

  .landing-in {
    animation: landing-rise 1.05s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both;
  }

  .landing-lock > p.landing-in,
  .landing-lock img.landing-in,
  .landing-lock h1.landing-in {
    animation-name: landing-rise-soft;
  }

  @keyframes ken-burns {
    from {
      transform: scale(1.06) translate3d(1.4%, 0.6%, 0);
    }
    to {
      transform: scale(1.16) translate3d(-1.8%, -1.5%, 0);
    }
  }

  @keyframes landing-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 28px, 0) scale(0.96);
    }
  }

  @keyframes landing-rise-soft {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translate3d(0, 28px, 0) scale(0.96);
    }
  }

  .access {
    --p: 0;
    position: relative;
    display: flex;
    align-items: center;
    width: min(100%, 19.25rem);
    height: 3.55rem;
    padding: 0.22rem;
    border-radius: 999px;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.32) 0%,
      rgba(255, 255, 255, 0.1) 46%,
      rgba(255, 255, 255, 0.16) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.58);
    color: #161616;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.82),
      inset 0 -1px 0 rgba(255, 255, 255, 0.22),
      0 14px 28px -22px rgba(40, 12, 0, 0.4);
    backdrop-filter: blur(3px) saturate(1.2);
    touch-action: none;
    user-select: none;
  }

  .access__sheen {
    position: absolute;
    top: 0.22rem;
    bottom: 0.22rem;
    left: 0.22rem;
    width: calc(3.05rem + (100% - 3.05rem - 0.44rem) * var(--p));
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    pointer-events: none;
    transition:
      width 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.4s ease;
  }

  .access.is-dragging .access__sheen {
    transition: none;
  }

  .access.is-done .access__sheen {
    width: calc(100% - 0.44rem);
    background: #f6f3ee;
  }

  .access.is-done {
    animation: access-pop 0.72s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .access__label {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding-inline: 3.4rem 1.1rem;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    pointer-events: none;
    opacity: calc(1 - var(--p));
    color: #141414;
    background-image: linear-gradient(
      105deg,
      #141414 0%,
      #141414 42%,
      #6b6258 50%,
      #141414 58%,
      #141414 100%
    );
    background-size: 220% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: access-shimmer 2.6s linear infinite;
  }

  .access__knob {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3.05rem;
    height: 3.05rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #141414;
    color: #f6f3ee;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 8px 16px -10px rgba(0, 0, 0, 0.55);
    transform: translateX(calc(var(--p) * var(--travel, 0px)));
    transition:
      transform 0.55s cubic-bezier(0.16, 1.15, 0.3, 1),
      background 0.35s ease,
      color 0.35s ease;
    cursor: grab;
  }

  .access.is-dragging .access__knob,
  .access.is-dragging .access__sheen {
    transition: none;
    cursor: grabbing;
  }

  .access.is-done .access__knob {
    background: #f6f3ee;
    color: #141414;
  }

  .access__knob svg {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.28s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .access__glyph--go {
    animation: access-nudge 1.25s ease-in-out infinite;
  }

  .access__glyph--ok {
    opacity: 0;
    transform: scale(0.6);
  }

  .access.is-dragging .access__glyph--go,
  .access.is-done .access__glyph--go {
    animation: none;
  }

  .access.is-done .access__glyph--go {
    opacity: 0;
    transform: scale(0.5);
  }

  .access.is-done .access__glyph--ok {
    opacity: 1;
    transform: scale(1);
  }

  .access__knob:focus-visible {
    outline: 2px solid #f7f4ef;
    outline-offset: 3px;
  }

  @keyframes access-pop {
    0% {
      transform: scale(1);
    }
    38% {
      transform: scale(1.055);
    }
    72% {
      transform: scale(0.985);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes access-shimmer {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -120% 0;
    }
  }

  @keyframes access-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(3px);
    }
  }

  .partners {
    width: 100%;
    margin-bottom: 0.65rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
  }

  .partners__track {
    display: flex;
    width: max-content;
    animation: partners-roll 48s linear infinite;
  }

  .partners:hover .partners__track {
    animation-play-state: paused;
  }

  .partners__set {
    display: flex;
    flex: none;
    align-items: center;
    gap: 3.25rem;
    margin: 0;
    padding: 0.85rem 1.625rem;
    list-style: none;
  }

  .partners li {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partners img {
    display: block;
    width: auto;
    height: calc(1.65rem * var(--mark, 1));
    max-width: calc(7rem * var(--mark, 1));
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    filter: brightness(0);
  }

  @media (min-width: 640px) {
    .partners__set {
      gap: 4.25rem;
      padding: 0.95rem 2.125rem;
    }

    .partners img {
      height: calc(1.9rem * var(--mark, 1));
      max-width: calc(8.5rem * var(--mark, 1));
    }
  }

  @keyframes partners-roll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio__photo {
      animation: none;
      transform: none;
    }

    .landing-in,
    .access,
    .access__label,
    .access__knob svg {
      animation: none;
    }

    .access__label {
      color: #161616;
      background: none;
    }

    .partners__track {
      animation-play-state: paused;
    }
  }
</style>

<script>
  const slide = document.querySelector<HTMLElement>('.access');
  const knob = slide?.querySelector<HTMLButtonElement>('.access__knob');
  const href = slide?.getAttribute('data-href');

  if (slide && knob && href) {
    const measure = () => {
      const pad = parseFloat(getComputedStyle(slide).paddingLeft) || 0;
      const travel = Math.max(0, slide.clientWidth - knob.offsetWidth - pad * 2);
      slide.style.setProperty('--travel', `${travel}px`);
      return travel;
    };

    let travel = measure();
    window.addEventListener('resize', () => {
      travel = measure();
    });

    let dragging = false;
    let origin = 0;
    let originP = 0;

    const progress = () => Number.parseFloat(slide.style.getPropertyValue('--p')) || 0;

    const setProgress = (value: number) => {
      const next = Math.min(1, Math.max(0, value));
      slide.style.setProperty('--p', String(next));
      return next;
    };

    const finish = () => {
      if (slide.classList.contains('is-done')) return;
      slide.classList.remove('is-dragging');
      setProgress(1);
      slide.classList.add('is-done');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.setTimeout(() => {
        window.location.assign(href);
      }, reduce ? 40 : 720);
    };

    const release = (value: number) => {
      slide.classList.remove('is-dragging');
      dragging = false;
      if (value >= 0.86) finish();
      else setProgress(0);
    };

    knob.addEventListener('pointerdown', (event) => {
      if (slide.classList.contains('is-done')) return;
      travel = measure();
      if (travel < 1) return;
      dragging = true;
      origin = event.clientX;
      originP = progress();
      slide.classList.add('is-dragging');
      knob.setPointerCapture(event.pointerId);
    });

    knob.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      setProgress(originP + (event.clientX - origin) / travel);
    });

    knob.addEventListener('pointerup', () => {
      if (!dragging) return;
      release(progress());
    });

    knob.addEventListener('pointercancel', () => {
      if (!dragging) return;
      release(0);
    });

    knob.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      finish();
    });
  }
</script>
