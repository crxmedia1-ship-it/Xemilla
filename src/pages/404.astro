---
import Layout from '../layouts/Layout.astro';
import XemillaQuiet from '../components/XemillaQuiet.astro';

const FONT_HREF = 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap';
---

<Layout
  title="No encontrado · Xemilla"
  theme="crx"
  themeColor="#e07028"
  fontHref={FONT_HREF}
  description="Esta página no está en Xemilla."
>
  <XemillaQuiet
    kicker="Página no encontrada"
    title="Este enlace no lleva a ninguna mesa."
    detail="Puede que haya cambiado o que esté incompleto."
    actionHref="/"
    actionLabel="Volver al inicio"
  />
</Layout>
