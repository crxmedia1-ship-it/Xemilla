<script>
  import { initCurrencyEngine } from '../scripts/currency-engine';

  /* Quien abre la propuesta se queda en ella: esta pestaña no entra al resto de Xemilla. */
  try {
    sessionStorage.setItem('xemilla-propuesta-only', `${location.pathname}${location.search}`);
  } catch {
    /* almacenamiento bloqueado: el enlace de WhatsApp sigue siendo la única salida */
  }
  document.addEventListener(
    'click',
    (event) => {
      const anchor = (event.target as Element | null)?.closest?.('a');
      if (!(anchor instanceof HTMLAnchorElement) || !anchor.href) return;
      const url = new URL(anchor.href, location.origin);
      const external = url.origin !== location.origin;
      if (external || url.pathname === '/propuesta') return;
      event.preventDefault();
      event.stopPropagation();
    },
    true,
  );

  /*
   * Los bocados viven en coordenadas del documento, no de la pantalla:
   * cada uno ocupa un lugar en la página y solo se ve cuando el lector
   * hace scroll hasta ahí.
   *
   * Paredes: cada línea de texto, cada enlace/botón y todo lo marcado con
   * data-collide. Un texto con data-pass (o dentro de uno) deja pasar la
   * comida por detrás, para resaltarlo.
   */
  const TEXT = 'h1, h2, h3, h4, p, li, blockquote, figcaption';
  const SOLID = 'a, button, [data-collide]';
  type Wall = { left: number; top: number; right: number; bottom: number };

  const space = document.getElementById('food-space');
  if (space && space.dataset.live !== '1') {
    space.dataset.live = '1';
    const root: HTMLElement = space;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GAP = 6;

    const pieces = [...space.querySelectorAll<HTMLElement>('[data-food]')].map((el) => ({
      el,
      size: 0,
      r: 0,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      heading: Math.random() * Math.PI * 2,
      cruise: 9 + Math.random() * 7,
      rot: Math.random() * 360,
      spin: (Math.random() - 0.5) * 8,
      seed: Math.random() * 1000,
    }));

    type Piece = (typeof pieces)[number];

    let width = 0;
    let height = 0;
    let walls: Wall[] = [];
    /** Paredes que viajan con la pantalla (la barra fija); se miden en cada frame. */
    let floating: HTMLElement[] = [];

    const toWall = (r: DOMRect, box: DOMRect): Wall => ({
      left: r.left - box.left - GAP,
      top: r.top - box.top - GAP,
      right: r.right - box.left + GAP,
      bottom: r.bottom - box.top + GAP,
    });

    const passes = (el: Element) => el.closest('[data-pass]') !== null;

    function isFixed(el: Element | null) {
      for (let node = el; node && node !== document.body; node = node.parentElement) {
        if (getComputedStyle(node).position === 'fixed') return true;
      }
      return false;
    }

    function measure() {
      const box = root.getBoundingClientRect();
      width = box.width;
      height = box.height;
      const next: Wall[] = [];
      floating = [];

      for (const el of document.querySelectorAll<HTMLElement>(SOLID)) {
        if (root.contains(el) || passes(el)) continue;
        if (isFixed(el)) {
          floating.push(el);
          continue;
        }
        const r = el.getBoundingClientRect();
        if (r.width > 4 && r.height > 4) next.push(toWall(r, box));
      }

      const range = document.createRange();
      for (const el of document.querySelectorAll('main ' + TEXT.split(', ').join(', main '))) {
        if (passes(el) || el.closest(SOLID)) continue;
        range.selectNodeContents(el);
        for (const r of range.getClientRects()) {
          if (r.width > 4 && r.height > 4) next.push(toWall(r, box));
        }
      }

      walls = next;
      for (const p of pieces) {
        p.size = p.el.offsetWidth;
        p.r = p.size * 0.45;
      }
    }

    function floatingWalls() {
      if (!floating.length) return [];
      const box = root.getBoundingClientRect();
      return floating.map((el) => toWall(el.getBoundingClientRect(), box));
    }

    function overlapsWall(x: number, y: number, r: number) {
      return walls.some((w) => {
        const dx = x - Math.min(Math.max(x, w.left), w.right);
        const dy = y - Math.min(Math.max(y, w.top), w.bottom);
        return dx * dx + dy * dy < r * r;
      });
    }

    function overlapsPiece(x: number, y: number, r: number, upTo: number) {
      for (let i = 0; i < upTo; i++) {
        const o = pieces[i];
        if (Math.hypot(x - o.x, y - o.y) < r + o.r + 8) return true;
      }
      return false;
    }

    /** Reparte un bocado por franja vertical para que cada sección tenga el suyo. */
    function place(p: Piece, index: number) {
      const band = height / pieces.length;
      for (let attempt = 0; attempt < 60; attempt++) {
        const x = p.r + Math.random() * Math.max(1, width - p.r * 2);
        const y = band * index + p.r + Math.random() * Math.max(1, band - p.r * 2);
        if (!overlapsWall(x, y, p.r) && !overlapsPiece(x, y, p.r, index)) {
          p.x = x;
          p.y = y;
          return;
        }
      }
      p.x = p.r + Math.random() * Math.max(1, width - p.r * 2);
      p.y = band * index + band / 2;
    }

    function reflect(p: Piece, nx: number, ny: number) {
      const vn = p.vx * nx + p.vy * ny;
      if (vn < 0) {
        p.vx -= 2 * vn * nx;
        p.vy -= 2 * vn * ny;
        p.heading = Math.atan2(p.vy, p.vx);
        p.spin += (Math.random() - 0.5) * 6;
      }
    }

    function collideWall(p: Piece, w: Wall) {
      const cx = Math.min(Math.max(p.x, w.left), w.right);
      const cy = Math.min(Math.max(p.y, w.top), w.bottom);
      const dx = p.x - cx;
      const dy = p.y - cy;
      const d2 = dx * dx + dy * dy;
      if (d2 >= p.r * p.r) return;
      let nx = 0;
      let ny = 0;
      let depth = 0;
      if (d2 > 1e-6) {
        const d = Math.sqrt(d2);
        nx = dx / d;
        ny = dy / d;
        depth = p.r - d;
      } else {
        const toLeft = p.x - w.left;
        const toRight = w.right - p.x;
        const toTop = p.y - w.top;
        const toBottom = w.bottom - p.y;
        const min = Math.min(toLeft, toRight, toTop, toBottom);
        if (min === toLeft) [nx, depth] = [-1, toLeft + p.r];
        else if (min === toRight) [nx, depth] = [1, toRight + p.r];
        else if (min === toTop) [ny, depth] = [-1, toTop + p.r];
        else [ny, depth] = [1, toBottom + p.r];
      }
      p.x += nx * depth;
      p.y += ny * depth;
      reflect(p, nx, ny);
    }

    function collideEdges(p: Piece) {
      if (p.x < p.r) {
        p.x = p.r;
        reflect(p, 1, 0);
      } else if (p.x > width - p.r) {
        p.x = width - p.r;
        reflect(p, -1, 0);
      }
      if (p.y < p.r) {
        p.y = p.r;
        reflect(p, 0, 1);
      } else if (p.y > height - p.r) {
        p.y = height - p.r;
        reflect(p, 0, -1);
      }
    }

    function collidePair(a: Piece, b: Piece) {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.hypot(dx, dy) || 0.01;
      const min = a.r + b.r;
      if (dist >= min) return;
      const nx = dx / dist;
      const ny = dy / dist;
      const push = (min - dist) / 2;
      a.x -= nx * push;
      a.y -= ny * push;
      b.x += nx * push;
      b.y += ny * push;
      const rel = (b.vx - a.vx) * nx + (b.vy - a.vy) * ny;
      if (rel >= 0) return;
      a.vx += rel * nx;
      a.vy += rel * ny;
      b.vx -= rel * nx;
      b.vy -= rel * ny;
      a.heading = Math.atan2(a.vy, a.vx);
      b.heading = Math.atan2(b.vy, b.vx);
      a.spin += (Math.random() - 0.5) * 5;
      b.spin += (Math.random() - 0.5) * 5;
    }

    function draw(p: Piece, t: number) {
      const bob = Math.sin(t * 0.0009 + p.seed) * 3;
      const left = p.x - p.size / 2;
      const top = p.y - p.size / 2 + bob;
      p.el.style.transform = `translate3d(${left}px, ${top}px, 0) rotate(${p.rot}deg)`;
    }

    function step(dt: number, t: number) {
      const moving = floatingWalls();
      for (const p of pieces) {
        p.heading += Math.sin(t * 0.00025 + p.seed) * 0.35 * dt;
        const targetX = Math.cos(p.heading) * p.cruise;
        const targetY = Math.sin(p.heading) * p.cruise;
        const ease = Math.min(1, dt * 0.8);
        p.vx += (targetX - p.vx) * ease;
        p.vy += (targetY - p.vy) * ease;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.spin = Math.max(-12, Math.min(12, p.spin * (1 - dt * 0.05)));
        p.rot += p.spin * dt;
        collideEdges(p);
        for (const w of walls) collideWall(p, w);
        for (const w of moving) collideWall(p, w);
      }
      for (let i = 0; i < pieces.length; i++) {
        for (let j = i + 1; j < pieces.length; j++) collidePair(pieces[i], pieces[j]);
      }
      for (const p of pieces) collideEdges(p);
    }

    measure();
    pieces.forEach(place);
    const start = performance.now();
    pieces.forEach((p) => draw(p, start));
    space.classList.add('is-on');

    const relayout = () => {
      measure();
      for (const p of pieces) {
        collideEdges(p);
        for (const w of walls) collideWall(p, w);
      }
    };
    new ResizeObserver(relayout).observe(document.documentElement);
    window.addEventListener('load', relayout, { once: true });
    document.fonts?.ready.then(relayout);

    if (!reduced) {
      let raf = 0;
      let last = start;
      const frame = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        step(dt, now);
        for (const p of pieces) draw(p, now);
        raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
      document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
    }
  }

  const loadModelViewer = () => {
    if (customElements.get('model-viewer') || document.querySelector('script[data-model-viewer]')) return;
    const s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js';
    s.setAttribute('data-model-viewer', 'true');
    document.head.appendChild(s);
  };

  const propuestaTrackId = document.querySelector('main')?.getAttribute('data-propuesta-id') || '';
  const trackPropuesta = (tipo: string) => {
    if (!propuestaTrackId || !tipo) return;
    const body = JSON.stringify({ id: propuestaTrackId, tipo });
    const blob = new Blob([body], { type: 'application/json' });
    if (!navigator.sendBeacon?.('/api/propuesta-evento', blob)) {
      void fetch('/api/propuesta-evento', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body,
        keepalive: true,
      });
    }
  };
  const dialogTipos: Record<string, string> = {
    'ar-dialog': 'ar',
    'nutri-dialog': 'nutri',
    'qr-dialog': 'qr',
    'ia-dialog': 'ia',
  };

  const shop = document.querySelector<HTMLElement>('[data-shop]');
  if (shop) {
    const count = shop.querySelector<HTMLElement>('[data-shop-count]');
    const total = shop.querySelector<HTMLElement>('[data-shop-total]');
    let items = 0;
    let sum = 0;
    for (const btn of shop.querySelectorAll<HTMLElement>('[data-shop-add]')) {
      btn.addEventListener('click', () => {
        items += 1;
        sum += Number(btn.dataset.shopAdd) || 0;
        if (count) {
          count.hidden = false;
          count.textContent = String(items);
          count.classList.remove('is-bump');
          void count.offsetWidth;
          count.classList.add('is-bump');
        }
        if (total) total.textContent = `$${sum}`;
        shop.classList.add('has-items');
      });
    }
  }

  const loyal = document.querySelector<HTMLElement>('[data-loyal]');
  if (loyal) {
    const stamps = [...loyal.querySelectorAll<HTMLElement>('.loyal__stamp')];
    const status = loyal.querySelector<HTMLElement>('[data-loyal-status]');
    const btn = loyal.querySelector<HTMLButtonElement>('[data-loyal-stamp]');
    const render = () => {
      const on = stamps.filter((s) => s.classList.contains('is-on')).length;
      const left = stamps.length - on;
      loyal.classList.toggle('is-done', left === 0);
      if (status) {
        status.innerHTML =
          left === 0
            ? '<b>¡Postre gratis desbloqueado!</b> Muéstralo en caja'
            : `Te faltan <b>${left}</b> ${left === 1 ? 'visita' : 'visitas'} para tu postre gratis`;
      }
      if (btn) btn.textContent = left === 0 ? 'Canjear y empezar de nuevo' : 'Sellar visita';
    };
    btn?.addEventListener('click', () => {
      const next = stamps.find((s) => !s.classList.contains('is-on'));
      if (next) next.classList.add('is-on', 'is-new');
      else stamps.forEach((s) => s.classList.remove('is-on', 'is-new'));
      render();
    });
  }

  for (const btn of document.querySelectorAll<HTMLElement>('[data-dialog-open]')) {
    const dialog = document.getElementById(btn.dataset.dialogOpen ?? '');
    if (!(dialog instanceof HTMLDialogElement)) continue;

    btn.addEventListener('click', () => {
      const viewer = dialog.querySelector<HTMLElement>('model-viewer');
      if (viewer) {
        loadModelViewer();
        if (!viewer.getAttribute('src')) viewer.setAttribute('src', viewer.dataset.src ?? '');
      }
      dialog.showModal();
      trackPropuesta(dialogTipos[dialog.id] || '');
    });
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const r = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
      if (!inside) dialog.close();
    });
  }

  const formatPropUsd = (amount: number) => {
    const n = Number(amount);
    if (!Number.isFinite(n) || n <= 0) return 'A consultar';
    const whole = Number.isInteger(n) ? String(n) : n.toFixed(2);
    return `${whole} USD`;
  };

  const paintPropMoney = () => {
    document.querySelectorAll<HTMLElement>('[data-prop-usd]').forEach((el) => {
      if (el.hasAttribute('data-ticket-total') || el.hasAttribute('data-qr-total')) return;
      const raw = el.getAttribute('data-prop-usd') || '';
      if (!raw) return;
      el.textContent = formatPropUsd(Number(raw.replace(',', '.')));
    });
  };
  paintPropMoney();

  const boundPicks = new WeakSet<HTMLElement>();
  const initTicket = () => {
    const ticketAddons = document.querySelector<HTMLElement>('[data-ticket-addons]');
    const ticketTotal = document.querySelector<HTMLElement>('[data-ticket-total]');
    const ticketConsultar = document.querySelector<HTMLElement>('[data-ticket-consultar]');
    const addonPicks = [...document.querySelectorAll<HTMLElement>('[data-addon-pick]')];
    if (!ticketAddons || !ticketTotal || !addonPicks.length) return;
    const baseRaw = ticketTotal.dataset.base ?? '';
    const base = baseRaw === '' ? null : Number(baseRaw.replace(',', '.'));
    const amountOf = (raw: string) => {
      const n = Number(String(raw).replace(',', '.'));
      return Number.isFinite(n) && n > 0 ? n : 0;
    };
    const labelOf = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(2));
    const arPacks = [...document.querySelectorAll<HTMLElement>('[data-ar-pack]')];
    const qrPieces = [...document.querySelectorAll<HTMLElement>('[data-qr-piece]')];
    const qrTotal = document.querySelector<HTMLElement>('[data-qr-total]');
    const qrSlide = document.querySelector<HTMLElement>(".gadget-slide[data-splash='qr']");
    const qrUnit = amountOf(qrTotal?.dataset.unit ?? '');
    const scopeAttr = document.querySelector('.ticket__row')?.getAttributeNames().find((name) => name.startsWith('data-astro-cid'));
    const stamp = (el: HTMLElement) => {
      if (scopeAttr) el.setAttribute(scopeAttr, '');
    };
    const ticketMonthly = document.querySelector<HTMLElement>('[data-ticket-monthly]');
    const ticketMonthlyNote = document.querySelector<HTMLElement>('[data-ticket-monthly-note]');
    const addLine = (label: string, valueText: string, noteText = '') => {
      const li = document.createElement('li');
      const row = document.createElement('p');
      row.className = 'ticket__row';
      const name = document.createElement('span');
      name.textContent = label;
      const dots = document.createElement('i');
      dots.setAttribute('aria-hidden', 'true');
      const value = document.createElement('b');
      value.textContent = valueText;
      stamp(li);
      stamp(row);
      stamp(name);
      stamp(dots);
      stamp(value);
      row.append(name, dots, value);
      li.append(row);
      if (noteText) {
        const note = document.createElement('p');
        note.className = 'ticket__note';
        note.textContent = noteText;
        stamp(note);
        li.append(note);
      }
      ticketAddons.append(li);
    };
    const paintTicket = () => {
      ticketAddons.replaceChildren();
      let extra = 0;
      let monthly = 0;
      let consultar = false;
      for (const pick of addonPicks) {
        const on = pick.getAttribute('aria-pressed') === 'true';
        const name = pick.dataset.addonName || 'adicional';
        pick.setAttribute('aria-label', on ? `Quitar ${name} de la cuenta` : `Añadir ${name} a la cuenta`);
        pick.closest('.gadget-slide')?.classList.toggle('is-picked', on);
        if (!on) continue;
        if (pick.dataset.addonId === 'ar') continue;
        if (pick.dataset.addonId === 'ia') {
          const inst = amountOf(pick.dataset.addonPrice ?? '');
          const mens = amountOf(pick.dataset.addonMonthly ?? '');
          if (!inst && !mens) {
            consultar = true;
            addLine('1 × Klientiq', 'A consultar');
          }
          if (inst) {
            extra += inst;
            addLine('1 × Klientiq instalación', formatPropUsd(inst));
          }
          if (mens) {
            monthly += mens;
            addLine('1 × Klientiq mensual', `${formatPropUsd(mens)}/mes`);
          }
          continue;
        }
        const price = amountOf(pick.dataset.addonPrice ?? '');
        if (price) extra += price;
        else consultar = true;
        addLine(`1 × ${pick.dataset.addonName || 'Adicional'}`, price ? formatPropUsd(price) : 'A consultar');
      }
      for (const pack of arPacks) {
        const on = pack.getAttribute('aria-pressed') === 'true';
        pack.textContent = on ? 'En la cuenta' : 'Sumar';
        if (!on) continue;
        const price = amountOf(pack.dataset.packPrice ?? '');
        if (price) extra += price;
        else consultar = true;
        const platos = pack.dataset.packPlatos || '';
        addLine(
          `1 × ${pack.dataset.packName || 'Paquete'} (AR)`,
          price ? formatPropUsd(price) : 'A consultar',
          platos ? `${platos} ${platos === '1' ? 'plato' : 'platos'}` : '',
        );
      }
      let qrCount = 0;
      let qrMoney = 0;
      for (const piece of qrPieces) {
        const qtyEl = piece.querySelector<HTMLElement>('[data-qr-qty]');
        const unit = amountOf(piece.dataset.piecePrice ?? '');
        if (!unit) {
          if (qtyEl) qtyEl.textContent = '0';
          piece.hidden = true;
          piece.setAttribute('aria-pressed', 'false');
          continue;
        }
        const qty = Math.max(0, Math.min(99, Number(qtyEl?.textContent) || 0));
        if (qtyEl) qtyEl.textContent = String(qty);
        piece.setAttribute('aria-pressed', qty > 0 ? 'true' : 'false');
        if (!qty) continue;
        qrCount += qty;
        const price = unit ? unit * qty : 0;
        if (price) {
          extra += price;
          qrMoney += price;
        } else consultar = true;
        addLine(
          `${qty} × ${piece.dataset.pieceName || 'QR & NFC'}`,
          price ? formatPropUsd(price) : 'A consultar',
          qty > 1 && unit ? `${formatPropUsd(unit)} c/u` : '',
        );
      }
      if (qrSlide) qrSlide.classList.toggle('is-picked', qrCount > 0);
      const sedeBill = document.querySelector<HTMLElement>('[data-sede-bill]');
      if (sedeBill?.dataset.sedeOn === 'true') {
        const qty = Math.max(1, Math.min(99, Number(sedeBill.dataset.sedeQty) || 1));
        const unit = amountOf(sedeBill.dataset.sedePrice ?? '');
        const price = unit ? unit * qty : 0;
        if (!price) consultar = true;
        addLine(
          `${qty} × Sucursal`,
          price ? `${formatPropUsd(price)}/año` : 'A consultar',
          unit ? `${formatPropUsd(unit)} al año cada una · mantenimiento` : 'Mantenimiento al año',
        );
      }
      if (qrTotal) {
        if (qrCount > 0 && qrMoney > 0) qrTotal.textContent = formatPropUsd(qrMoney);
        else if (qrCount > 0) qrTotal.textContent = 'A consultar';
        else qrTotal.textContent = qrUnit ? formatPropUsd(qrUnit) : 'A consultar';
      }
      ticketAddons.hidden = ticketAddons.childElementCount === 0;
      if (ticketMonthly) ticketMonthly.textContent = monthly ? `${formatPropUsd(monthly)}/mes` : '0';
      if (ticketMonthlyNote) ticketMonthlyNote.textContent = monthly ? ` y ${formatPropUsd(monthly)} al mes` : '';
      if (base == null || !Number.isFinite(base)) ticketTotal.textContent = 'A consultar';
      else ticketTotal.textContent = formatPropUsd(base + extra);
      if (ticketConsultar) ticketConsultar.hidden = !consultar;
    };
    for (const pick of addonPicks) {
      if (boundPicks.has(pick)) continue;
      boundPicks.add(pick);
      pick.addEventListener('click', () => {
        const on = pick.getAttribute('aria-pressed') === 'true';
        pick.setAttribute('aria-pressed', on ? 'false' : 'true');
        paintTicket();
      });
    }
    for (const pack of arPacks) {
      if (boundPicks.has(pack)) continue;
      boundPicks.add(pack);
      pack.addEventListener('click', () => {
        const on = pack.getAttribute('aria-pressed') === 'true';
        pack.setAttribute('aria-pressed', on ? 'false' : 'true');
        paintTicket();
      });
    }
    for (const piece of qrPieces) {
      if (boundPicks.has(piece)) continue;
      boundPicks.add(piece);
      piece.addEventListener('click', (event) => {
        const step = (event.target as HTMLElement | null)?.closest?.('[data-qr-step]');
        if (!(step instanceof HTMLElement)) return;
        const qtyEl = piece.querySelector<HTMLElement>('[data-qr-qty]');
        if (!qtyEl || !amountOf(piece.dataset.piecePrice ?? '')) return;
        const qty = Math.max(0, Number(qtyEl.textContent) || 0);
        const next = Math.max(0, Math.min(99, qty + (step.dataset.qrStep === '1' ? 1 : -1)));
        if (next === qty) return;
        qtyEl.textContent = String(next);
        paintTicket();
      });
    }
    paintTicket();
  };
  initTicket();
  document.addEventListener('astro:page-load', initTicket);

  document.querySelector('[data-propuesta-event="whatsapp"]')?.addEventListener('click', () => {
    trackPropuesta('whatsapp');
  });

  for (const track of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const nav = track.previousElementSibling;
    for (const btn of nav?.querySelectorAll<HTMLElement>('[data-carousel-step]') ?? []) {
      btn.addEventListener('click', () => {
        const card = track.firstElementChild as HTMLElement | null;
        const step = (card?.offsetWidth ?? 160) + 10;
        track.scrollBy({ left: Number(btn.dataset.carouselStep) * step, behavior: 'smooth' });
      });
    }
  }

  for (const demo of document.querySelectorAll<HTMLElement>('[data-feat-currency]')) {
    initCurrencyEngine(demo, { persist: false });
    // Probar el selector no debe girar la tarjeta.
    demo.addEventListener('click', (event) => event.stopPropagation());
    demo.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') event.stopPropagation();
    });
  }

  const featCarousel = document.querySelector<HTMLElement>('[data-feat-carousel]');
  const featDots = [...document.querySelectorAll<HTMLButtonElement>('[data-feat-dot]')];
  if (featCarousel && featDots.length) {
    const slides = [...featCarousel.children] as HTMLElement[];
    const center = (slide: HTMLElement) => slide.offsetLeft + slide.offsetWidth / 2 - featCarousel.clientWidth / 2;
    let frame = 0;
    featCarousel.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          let active = 0;
          slides.forEach((slide, n) => {
            if (Math.abs(center(slide) - featCarousel.scrollLeft) < Math.abs(center(slides[active]) - featCarousel.scrollLeft)) active = n;
          });
          featDots.forEach((dot, n) => dot.toggleAttribute('aria-current', n === active));
        });
      },
      { passive: true },
    );
    featDots.forEach((dot, n) => {
      dot.addEventListener('click', () => featCarousel.scrollTo({ left: center(slides[n]), behavior: 'smooth' }));
    });
  }

  const gadgetRail = document.querySelector<HTMLElement>('[data-gadget-carousel]');
  const gadgetDots = [...document.querySelectorAll<HTMLButtonElement>('[data-gadget-dot]')];
  if (gadgetRail && gadgetDots.length) {
    const slides = [...gadgetRail.children] as HTMLElement[];
    const go = (index: number) => {
      const slide = slides[index];
      if (!slide) return;
      gadgetRail.scrollTo({ left: slide.offsetLeft - gadgetRail.offsetLeft, behavior: 'smooth' });
    };
    let frame = 0;
    gadgetRail.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const origin = gadgetRail.scrollLeft;
          let active = 0;
          slides.forEach((slide, n) => {
            const left = slide.offsetLeft - gadgetRail.offsetLeft;
            if (Math.abs(left - origin) < Math.abs(slides[active].offsetLeft - gadgetRail.offsetLeft - origin)) active = n;
          });
          gadgetDots.forEach((dot, n) => dot.toggleAttribute('aria-current', n === active));
        });
      },
      { passive: true },
    );
    gadgetDots.forEach((dot, n) => {
      dot.addEventListener('click', () => go(n));
    });
  }

  for (const card of document.querySelectorAll<HTMLElement>('[data-feat-flip]')) {
    const [front, back] = card.children;
    const flip = () => {
      const open = card.getAttribute('aria-pressed') !== 'true';
      card.setAttribute('aria-pressed', String(open));
      front?.setAttribute('aria-hidden', String(open));
      back?.setAttribute('aria-hidden', String(!open));
    };
    card.addEventListener('click', flip);
    card.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      flip();
    });
  }
</script>

