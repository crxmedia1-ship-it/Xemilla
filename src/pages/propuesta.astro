    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px 8px;
  }

  .shop__avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: #18181b;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
