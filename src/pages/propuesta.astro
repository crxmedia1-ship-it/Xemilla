function readText(value: string | null, fallback: string, max = 80) {
  const clean = (value ?? '').replace(/\s+/g, ' ').trim().slice(0, max);
  return clean || fallback;
}

function readAmount(value: string | null, fallback: string) {
  const clean = (value ?? '').trim().replace(/[^\d.,]/g, '').slice(0, 12);
  return clean || fallback;
}

const esPrecio = (value: string) => {
  const n = Number(String(value).replace(',', '.'));
  return Number.isFinite(n) && n > 0;
};

function readLogo(value: string | null) {
  const raw = (value ?? '').trim();
  if (!raw) return '';
  try {
    const url = new URL(raw);
    if (url.protocol !== 'https:' && url.protocol !== 'http:') return '';
    return logoSinPlaca(url.href);
  } catch {
    return '';
  }
}

/** Un SVG guardado como archivo crudo llega como descarga y el ticket no lo pinta. */
async function logoVisible(value: string | null) {
  const href = readLogo(value);
  if (!href.includes('res.cloudinary.com') || !href.includes('/raw/upload/')) return href;
  try {
    const res = await fetch(href);
    if (!res.ok) return href;
    const text = await res.text();
    const svg = text.trimStart();
    if (!svg.startsWith('<svg') && !svg.startsWith('<?xml')) return href;
    const safe = svg.replace(/<script[\s\S]*?<\/script>/gi, '');
    return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(safe)}`;
  } catch {
    return href;
  }
}

/** Quita el cuadrado blanco que viene pegado alrededor del logo. */
function logoSinPlaca(href: string) {
  const marker = '/image/upload/';
  const at = href.indexOf(marker);
  if (at === -1 || !href.includes('res.cloudinary.com')) return href;
  const rest = href.slice(at + marker.length);
  const version = rest.search(/\/v\d+\//);
  const tail = version === -1 ? rest : rest.slice(version + 1);
  return `${href.slice(0, at + marker.length)}e_make_transparent:20,f_png,q_auto,w_800,c_limit/${tail}`;
}

function readDomain(value: string | null, fallback: string) {
  const clean = (value ?? '')
    .trim()
    .toLowerCase()
    .replace(/^https?:\/\//, '')
    .replace(/^www\./, '')
    .split('/')[0];
  return /^[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(clean) ? clean : fallback;
}

function toSlug(name: string) {
  const slug = name
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  return slug || 'tu-restaurante';
}

