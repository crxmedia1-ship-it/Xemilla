    animation: bn-hours-roll 6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .bn-hours__toast {
    position: absolute;
    bottom: 8px;
    left: 50%;
    padding: 4px 10px;
    border-radius: 999px;
    background: #1c1917;
    color: #f6f3ee;
    font-size: 9.5px;
    font-weight: 600;
    white-space: nowrap;
    transform: translateX(-50%);
    animation: bn-hours-toast 6s ease infinite;
  }

  @keyframes bn-hours-live {
    50% {
      opacity: 0.35;
    }
  }

  @keyframes bn-hours-day {
    0%,
    30%,
    100% {
      background: #f5f2ee;
      color: #c4bfba;
      text-decoration: line-through;
    }
    38%,
    92% {
      background: rgba(5, 150, 105, 0.14);
      color: #047857;
      text-decoration: none;
    }
  }

  @keyframes bn-hours-roll {
    0%,
    14% {
      transform: translateY(0);
    }
    22%,
    92% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes bn-hours-mark {
    0%,
    14%,
    40%,
    100% {
      background: transparent;
      color: #1c1917;
    }
    22%,
    32% {
      background: rgba(154, 107, 63, 0.14);
      color: #9a6b3f;
    }
  }

  @keyframes bn-hours-toast {
    0%,
    44% {
      opacity: 0;
      transform: translate(-50%, 6px);
    }
    52%,
    90% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bn-open__scan,
    .bn-open__nfc path,
    .bn-open__src,
    .bn-open__social,
    .bn-open__link,
    .bn-open__menu i,
    .bn-eco__orbit,
    .bn-eco__node,
    .bn-eco__node > span,
    .bn-eco__flow,
    .bn-eco__core::before,
    .bn-eco__core::after,
    .bn-hours__status i,
    .bn-hours__days .is-new,
    .bn-hours__roll,
    .bn-hours__roll span,
    .bn-hours__toast {
      animation: none;
    }
  }

