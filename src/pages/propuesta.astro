  .gadget-slide__pick[aria-pressed='true'] button {
    background: #fff;
    color: #1c1917;
  }

  .gadget-slide__pick button:active,
  .gadget-slide__action:active {
    transform: scale(0.97);
  }

  .gadget-slide__action {
    border-radius: 999px;
    background: var(--color-zinc-50);
    padding: 0.7rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-zinc-950);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.18);
  }

  .gadget-slide__action:active {
    transform: scale(0.97);
  }

  .gadget-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }

  .gadget-dots button {
    position: relative;
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-zinc-500) 45%, transparent);
  }

  .gadget-dots button::after {
    content: '';
    position: absolute;
    inset: -10px -4px;
  }

  .gadget-dots button[aria-current] {
    width: 18px;
    background: var(--color-zinc-300);
  }

  /* Tarjeta que gira: las dos caras ocupan la misma celda, así mide lo que la más alta. */
  .feat-flip {
    perspective: 1200px;
  }

  .feat-flip__card {
    position: relative;
    display: grid;
    height: 100%;
    border-radius: 22px;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .feat-flip__card[aria-pressed='true'] {
    transform: rotateY(180deg);
  }

  .feat-flip__card:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-white) 45%, transparent);
    outline-offset: 3px;
  }

  .feat-flip__face {
    position: relative;
    grid-area: 1 / 1;
    transform: rotateY(0deg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: visibility 0s linear 0.3s;
  }

  .feat-flip__card[aria-pressed='true'] > .feat-flip__face:not(.feat-flip__back) {
    visibility: hidden;
  }

  .feat-flip__card:not([aria-pressed='true']) > .feat-flip__back {
    visibility: hidden;
  }

  .feat-flip__back {
    justify-content: center;
    align-items: flex-start;
    gap: 0;
    padding: 22px 22px 46px;
    border-color: rgba(255, 255, 255, 0.72);
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 10px 28px -18px rgba(28, 25, 23, 0.35);
    transform: rotateY(180deg);
    text-align: left;
  }

  .feat-flip__eyebrow {
    color: #a8a29e;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .feat-flip__hook {
    margin-top: 8px;
    max-width: 16ch;
    color: #1c1917;
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .feat--wide .feat-flip__hook {
    max-width: 18ch;
    font-size: 1.5rem;
  }

  .feat-flip__more {
    margin-top: 8px;
    max-width: 34ch;
    color: #57534e;
    font-size: 0.92rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.011em;
    text-wrap: pretty;
  }

  .feat-flip__face > div:not(.feat__stage) {
    padding-right: 34px;
  }

  .feat-flip__hint {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(28, 25, 23, 0.07);
    color: #78716c;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .feat-flip__hint svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .feat-flip__card:hover .feat-flip__hint {
      transform: rotate(-60deg);
      background: rgba(28, 25, 23, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-flip__card,
    .feat-flip__face {
      transition: none;
    }
  }

  .feat__stage {
    display: flex;
    align-items: center;
    min-height: 92px;
    padding: 16px 18px;
    border-radius: 16px;
    background: #f6f3ee;
    color: #1c1917;
  }

  .feat--wide .feat__stage {
    min-height: 108px;
  }

  .feat__domain {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .feat__tld {
    --tld-step: 1.28em;
    display: inline-grid;
    height: var(--tld-step);
    overflow: hidden;
    color: #9a6b3f;
  }

  .feat__tld-sizer,
  .feat__tld-track {
    grid-area: 1 / 1;
  }

  .feat__tld-sizer {
    visibility: hidden;
  }

  .feat__tld-track {
    display: flex;
    flex-direction: column;
    animation: feat-tld 16.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .feat__tld-track span,
  .feat__tld-sizer {
    display: block;
    height: var(--tld-step);
    line-height: 1;
  }

  @keyframes feat-tld {
    0%,
    14.8% {
      transform: translateY(0);
    }
    16.666%,
    31.466% {
      transform: translateY(calc(var(--tld-step) * -1));
    }
    33.333%,
    48.133% {
      transform: translateY(calc(var(--tld-step) * -2));
    }
    50%,
    64.8% {
      transform: translateY(calc(var(--tld-step) * -3));
    }
    66.666%,
    81.466% {
      transform: translateY(calc(var(--tld-step) * -4));
    }
    83.333%,
    98.133% {
      transform: translateY(calc(var(--tld-step) * -5));
    }
    100% {
      transform: translateY(calc(var(--tld-step) * -6));
    }
  }

  .feat-menu {
    display: grid;
    width: 100%;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feat-menu li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
  }

  .feat-menu li span:last-child {
    color: #9a6b3f;
    font-variant-numeric: tabular-nums;
  }

  /* El tercer plato se crea en bucle: botón «Nuevo plato» y luego el plato con su etiqueta. */
  .feat-menu li.feat-new {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .feat-new__add,
  .feat-new__dish {
    grid-area: 1 / 1;
  }

  .feat-new__add {
    justify-self: start;
    padding: 2px 10px;
    border: 1px dashed #a8a29e;
    border-radius: 999px;
    color: #78716c;
    font-family: system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    animation: feat-new-add 4.5s ease infinite;
  }

  .feat-menu li.feat-new .feat-new__dish {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: #1c1917;
    animation: feat-new-dish 4.5s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .feat-menu li.feat-new .feat-new__dish > span:last-child {
    color: #9a6b3f;
  }

  .feat-new__dish em {
    line-height: 1.3;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 999px;
    background: #059669;
    color: #fff;
    font-family: system-ui, sans-serif;
    font-size: 8.5px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 3px;
  }

  @keyframes feat-new-add {
    0%,
    30% {
      opacity: 1;
      transform: none;
    }
    38%,
    92% {
      opacity: 0;
      transform: scale(0.94);
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes feat-new-dish {
    0%,
    34% {
      opacity: 0;
      transform: translateY(6px);
    }
    44%,
    90% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-new__add {
      display: none;
    }

    .feat-menu li.feat-new .feat-new__dish {
      animation: none;
    }
  }

  .feat-cur {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 8px;
    margin-block: -4px;
    --menu-texto-color: #1c1917;
    --menu-surface-color: #fffdf9;
    --menu-accent-color: #9a6b3f;
  }

  .feat-cur__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .feat-cur :global(.currency-compact__menu) {
    right: auto;
    left: 0;
    transform-origin: top left;
  }

  .feat-cur__try {
    color: #9a6b3f;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .feat-cur__dish {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
  }

  .feat-cur__dish .precio-dinamico {
    color: #9a6b3f;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  .feat-cur__dish .precio-dinamico.is-converting {
    opacity: 0;
  }

  /* El menú de divisas abierto debe quedar sobre las tarjetas vecinas. */
  .feat-flip:has(.currency-compact.is-open) {
    position: relative;
    z-index: 5;
  }

  .feat__stage--map {
    position: relative;
    overflow: hidden;
    padding: 0;
  }

  .feat-map {
    position: relative;
    width: 100%;
    height: 112px;
  }

  @media (min-width: 640px) {
    .feat-map {
      height: 140px;
    }
  }

  .feat-map__art {
    display: block;
    width: 100%;
    height: 100%;
  }

  .feat-map__pin {
    position: absolute;
    top: 46%;
    left: 56%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50% 50% 50% 0;
    background: #c2410c;
    box-shadow: 0 8px 16px -6px rgba(124, 45, 18, 0.6);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    rotate: -45deg;
    translate: -50% -100%;
  }

  .feat-map__pin > span {
    rotate: 45deg;
  }

  .feat-map__pin::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: -6px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: rgba(194, 65, 12, 0.35);
    animation: feat-map-pulse 2.4s ease-out infinite;
  }

  @keyframes feat-map-pulse {
    from {
      scale: 0.6;
      opacity: 1;
    }
    to {
      scale: 2.4;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-map__pin::after {
      animation: none;
    }
  }

  .feat-map__chip {
    position: absolute;
    bottom: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px 5px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 6px 14px -8px rgba(28, 25, 23, 0.45);
    color: #1c1917;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: -0.01em;
    pointer-events: none;
  }

  .feat-open__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #059669;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.18);
  }

  /* Flyer del banner en un teléfono que asoma desde el borde inferior: aparece al abrir el menú, en bucle. */
  .feat__stage:has(.feat-ev) {
    overflow: hidden;
  }

  .feat-ev {
    width: 100%;
    height: 92px;
    margin-block: -16px;
    container: feat-ev / inline-size;
  }

  .feat-ev__row {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .feat-ev__phone {
    position: relative;
    flex: none;
    align-self: flex-end;
    width: 62px;
    height: 104px;
    margin-bottom: -26px;
