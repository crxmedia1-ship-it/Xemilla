  /* Ecosistema: el local al centro, conectado a todo lo que el cliente necesita. */
  .bento__stage--bare {
    overflow: visible;
    background: none;
    box-shadow: none;
  }

  .bn-eco {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150px;
    height: 150px;
    transform: translate(-50%, -50%);
  }

  .bn-eco__orbit {
    position: absolute;
    inset: 0;
    animation: bn-eco-spin 48s linear infinite;
  }

  .bn-eco__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
  }

  .bn-eco__ring {
    stroke-width: 1;
    stroke-opacity: 0.35;
  }

  .bn-eco__flow {
    stroke-width: 1.4;
    stroke-dasharray: 2 4;
    stroke-linecap: round;
    stroke-opacity: 0.75;
    animation: bn-eco-flow 1.4s linear infinite;
  }

  .bn-eco__node {
    position: absolute;
    translate: -50% -50%;
    animation: bn-eco-spin 48s linear infinite reverse;
  }

  .bn-eco__node > span {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: #fff;
    color: #44403c;
    box-shadow:
      0 0 0 1px rgba(28, 25, 23, 0.06),
      0 8px 18px -8px rgba(28, 25, 23, 0.45);
    animation: bn-eco-node 3s ease-in-out infinite;
  }

  .bn-eco__node svg {
    width: 15px;
    height: 15px;
  }

  .bn-eco__core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 15px;
    font-size: 19px;
    font-weight: 700;
    box-shadow: 0 12px 24px -10px rgba(28, 25, 23, 0.55);
    transform: translate(-50%, -50%);
  }

  .bn-eco__core::before,
  .bn-eco__core::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1.5px solid rgba(120, 113, 108, 0.6);
    opacity: 0;
    z-index: -1;
    animation: bn-eco-halo 3s ease-out infinite;
  }

  .bn-eco__core::after {
    animation-delay: 1.5s;
  }

  .bn-eco__pdf {
    position: absolute;
    top: 16px;
    right: -30px;
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(185, 28, 28, 0.1);
    color: #b91c1c;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    rotate: 8deg;
  }

  @keyframes bn-eco-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes bn-eco-flow {
    to {
      stroke-dashoffset: -6;
    }
  }

  @keyframes bn-eco-halo {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  @keyframes bn-eco-node {
    0%,
    70%,
    100% {
      scale: 1;
      color: #44403c;
    }
    15% {
      scale: 1.14;
      color: #059669;
    }
  }

  /* Horario: cierras más tarde y abres el domingo, y se publica al instante. */
  .bn-hours {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .bn-hours__card {
    width: min(86%, 208px);
    padding: 9px 11px 10px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 12px 26px -14px rgba(28, 25, 23, 0.5);
    transform: translateY(-12px);
  }

  .bn-hours__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #a8a29e;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bn-hours__status {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    border-radius: 999px;
    background: rgba(5, 150, 105, 0.1);
    color: #047857;
    font-size: 8.5px;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .bn-hours__status i {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #059669;
    animation: bn-hours-live 1.6s ease-in-out infinite;
  }

  .bn-hours__days {
    display: flex;
    justify-content: space-between;
    margin-top: 9px;
  }

  .bn-hours__days span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: #f5f2ee;
    color: #57534e;
    font-size: 9px;
    font-weight: 600;
  }

  .bn-hours__days .is-today {
    background: #1c1917;
    color: #f6f3ee;
  }

  .bn-hours__days .is-new {
    animation: bn-hours-day 6s ease infinite;
  }

  .bn-hours__time {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 9px;
    color: #1c1917;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .bn-hours__time i {
    color: #a8a29e;
    font-style: normal;
    font-weight: 400;
  }

  .bn-hours__roll {
    position: relative;
    display: block;
    height: 1.3em;
    overflow: hidden;
    margin: 0 -4px;
    padding: 0 4px;
    border-radius: 6px;
    line-height: 1.3em;
    animation: bn-hours-mark 6s ease infinite;
  }

  .bn-hours__roll span {
    display: block;
    animation: bn-hours-roll 6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .bn-hours__toast {
    position: absolute;
    bottom: 8px;
    left: 50%;
    padding: 4px 10px;
    border-radius: 999px;
    background: #1c1917;
    color: #f6f3ee;
    font-size: 9.5px;
    font-weight: 600;
    white-space: nowrap;
    transform: translateX(-50%);
    animation: bn-hours-toast 6s ease infinite;
  }

  @keyframes bn-hours-live {
    50% {
      opacity: 0.35;
    }
  }

  @keyframes bn-hours-day {
    0%,
    30%,
    100% {
      background: #f5f2ee;
      color: #c4bfba;
      text-decoration: line-through;
    }
    38%,
    92% {
      background: rgba(5, 150, 105, 0.14);
      color: #047857;
      text-decoration: none;
    }
  }

  @keyframes bn-hours-roll {
    0%,
    14% {
      transform: translateY(0);
    }
    22%,
    92% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes bn-hours-mark {
    0%,
    14%,
    40%,
    100% {
      background: transparent;
      color: #1c1917;
    }
    22%,
    32% {
      background: rgba(154, 107, 63, 0.14);
      color: #9a6b3f;
    }
  }

  @keyframes bn-hours-toast {
    0%,
    44% {
      opacity: 0;
      transform: translate(-50%, 6px);
    }
    52%,
    90% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bn-open__scan,
    .bn-open__nfc path,
    .bn-open__arrow,
    .bn-open__menu i,
    .bn-eco__orbit,
    .bn-eco__node,
    .bn-eco__node > span,
    .bn-eco__flow,
    .bn-eco__core::before,
    .bn-eco__core::after,
    .bn-hours__status i,
    .bn-hours__days .is-new,
    .bn-hours__roll,
    .bn-hours__roll span,
    .bn-hours__toast {
      animation: none;
    }
  }

