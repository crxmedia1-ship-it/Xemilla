  .gadget-slide__pick button {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
    background: #1c1917;
    color: #fff;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1;
