  .loyal__status :global(b) {
    color: #0f2a3d;
    font-weight: 600;
  }

  .loyal.is-done .loyal__status :global(b) {
    color: #b45309;
  }

  .loyal__btn {
    height: 46px;
    border-radius: 14px;
    background: #18181b;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    transition: scale 0.15s ease;
  }

  .loyal__btn:active {
