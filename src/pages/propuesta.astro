  .feat-dots button[aria-current] {
    width: 18px;
    background: var(--color-zinc-300);
  }

  .gadget-rail {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .gadget-rail::-webkit-scrollbar {
    display: none;
  }

  .gadget-slide {
    position: relative;
    display: flex;
    flex: 0 0 min(78%, 17.5rem);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 0;
    height: 21rem;
    padding: 1rem 0.85rem 0.9rem;
    overflow: hidden;
    scroll-snap-align: center;
    text-align: center;
    background: transparent !important;
    border-color: rgb(255 255 255 / 0.72) !important;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 22px 48px -20px rgb(40 24 12 / 0.28) !important;
    isolation: isolate;
  }

  .gadget-slide::before {
    content: '';
    position: absolute;
    inset: -8%;
    z-index: 0;
    pointer-events: none;
  }

  .gadget-slide__art,
  .gadget-slide__lens {
    position: absolute;
    pointer-events: none;
  }

  .gadget-slide__art {
    inset: 0;
    z-index: 0;
  }

  .gadget-slide__lens {
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background:
      linear-gradient(128deg, rgb(255 255 255 / 0.42) 0%, rgb(255 255 255 / 0.08) 34%, transparent 52%),
      linear-gradient(320deg, rgb(255 255 255 / 0.16) 0%, transparent 28%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 0 0 1px rgb(255 255 255 / 0.35);
    backdrop-filter: blur(1.5px) saturate(1.25);
  }

  .gadget-slide > :not(.gadget-slide__art):not(.gadget-slide__lens) {
    position: relative;
    z-index: 2;
  }

  .gadget-slide[data-splash='ar']::before {
    background:
      linear-gradient(128deg, transparent 28%, rgb(125 211 252 / 0.85) 40%, transparent 52%),
      linear-gradient(210deg, transparent 46%, rgb(192 132 252 / 0.8) 58%, transparent 70%),
      radial-gradient(42% 36% at 100% 0%, #38bdf8 0%, transparent 62%),
      linear-gradient(180deg, #f4f7ff, #e7e4ff);
  }

  .gadget-slide[data-splash='ar'] .gadget-slide__art {
    top: 6%;
    right: 4%;
    left: auto;
    width: 46%;
    height: 46%;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.2), transparent 46%),
      linear-gradient(160deg, #7dd3fc 0%, #6366f1 52%, #c084fc 100%);
    clip-path: polygon(50% 6%, 92% 28%, 92% 72%, 50% 94%, 8% 72%, 8% 28%);
    box-shadow: 18px 22px 0 -6px rgb(56 189 248 / 0.45);
  }

  .gadget-slide[data-splash='nutri']::before {
    background:
      linear-gradient(90deg, #123d28 0%, #123d28 18%, transparent 19%),
      radial-gradient(70% 50% at 100% 0%, #e8ff9a 0%, transparent 60%),
      linear-gradient(200deg, #f4ffe8 0%, #b7e38a 100%);
  }

  .gadget-slide[data-splash='nutri'] .gadget-slide__art {
    background:
      linear-gradient(#145c38, #145c38) 58% 18% / 3px 46% no-repeat,
      radial-gradient(ellipse at 62% 28%, #d8ff6a 0 18%, #3d9b4a 46%, #145c38 72%, transparent 73%);
    clip-path: ellipse(34% 42% at 68% 30%);
    transform: rotate(28deg);
    transform-origin: 68% 30%;
  }

  .gadget-slide[data-splash='qr']::before {
    background:
      radial-gradient(28% 24% at 0% 100%, #1c1917 0%, transparent 68%),
      radial-gradient(36% 30% at 100% 0%, #e7c27a 0%, transparent 64%),
      linear-gradient(165deg, #f7f3ec, #efe6d6);
  }

  .gadget-slide[data-splash='qr'] .gadget-slide__art {
    z-index: 2;
    top: 6%;
    left: 5%;
    width: 42%;
    height: 42%;
