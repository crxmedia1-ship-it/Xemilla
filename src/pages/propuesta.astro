---
export const prerender = false;

import PhoneSync from '../components/propuesta/PhoneSync.astro';
import QrArt from '../components/propuesta/QrArt.astro';
import CurrencySwitcher from '../components/app/CurrencySwitcher.astro';
import { getPropuesta, isPropuestaId, touchPropuesta } from '../lib/propuestas.js';
import { createSupabaseServiceClient } from '../lib/supabase/service.js';
import Layout from '../layouts/Layout.astro';

/** Número comercial de WhatsApp. Editar solo los dígitos, con código de país. */
const WHATSAPP_NUMBER = '584120000000';

/** Fuentes de la propuesta + las de la carta y el panel reales que replica PhoneSync. */
const FONT_HREF =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Syne:wght@600;700&family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;600&family=Instrument+Sans:wght@500;600;700&display=swap';

function readText(value: string | null, fallback: string, max = 80) {
  const clean = (value ?? '').replace(/\s+/g, ' ').trim().slice(0, max);
  return clean || fallback;
}

function readAmount(value: string | null, fallback: string) {
  const clean = (value ?? '').trim().replace(/[^\d.,]/g, '').slice(0, 12);
  return clean || fallback;
}

function readLogo(value: string | null) {
  const raw = (value ?? '').trim();
  if (!raw) return '';
  try {
    const url = new URL(raw);
    if (url.protocol !== 'https:' && url.protocol !== 'http:') return '';
    return url.href;
  } catch {
    return '';
  }
}

function readDomain(value: string | null, fallback: string) {
  const clean = (value ?? '')
    .trim()
    .toLowerCase()
    .replace(/^https?:\/\//, '')
    .replace(/^www\./, '')
    .split('/')[0];
  return /^[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(clean) ? clean : fallback;
}

function toSlug(name: string) {
  const slug = name
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
  return slug || 'tu-restaurante';
}

const params = Astro.url.searchParams;
const propuestaService = createSupabaseServiceClient();
const propuestaGuardada =
  propuestaService && isPropuestaId(params.get('p'))
    ? await getPropuesta(propuestaService, String(params.get('p')))
    : null;
if (propuestaGuardada && propuestaService) {
  await touchPropuesta(propuestaService, propuestaGuardada.id, 'vista');
}
const propuestaId = propuestaGuardada?.id ?? '';

const para = readText(propuestaGuardada?.nombre ?? params.get('para'), 'Tu Restaurante');
const setup = readAmount(propuestaGuardada?.setup ?? params.get('setup'), '500');
const anual = readAmount(propuestaGuardada?.anual ?? params.get('anual'), '200');
const sinPrecio = propuestaGuardada ? propuestaGuardada.sin_precio === true : params.get('precio') === 'consultar';
const logo = readLogo(propuestaGuardada?.logo_url ?? params.get('logo'));
const initial = para.charAt(0).toUpperCase();
const slug = toSlug(para);
const domain = readDomain(
  propuestaGuardada?.dominio ?? params.get('dominio'),
  `${slug.replace(/-/g, '')}.com`,
);
const domainName = domain.split('.')[0] || domain;
const domainTlds = ['.com', '.net', '.org', '.app', '.io', '.co'] as const;

const waText = `Hola, revisé la propuesta de Xemilla para ${para} y quiero coordinar el despliegue.`;
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(waText)}`;

/** Trazos de íconos (viewBox 24×24, solo stroke). */
const ICONS = {
  cube: 'M12 2.5 20.5 7v10L12 21.5 3.5 17V7zM3.5 7 12 11.5 20.5 7M12 11.5v10',
  leaf: 'M5 19.5c0-8.5 6-14.5 15-14.5 0 9-6 15-14.5 15M5 19.5l7.5-7.5',
  qr: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2.5v2.5H14zM17.5 17.5H20V20h-2.5zM14 17.5h2.5V20H14zM17.5 14H20v2.5h-2.5z',
  instagram: 'M7.5 3.5h9a4 4 0 0 1 4 4v9a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4v-9a4 4 0 0 1 4-4zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zM17 7h.01',
  pin: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  wifi: 'M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.5 16a5 5 0 0 1 7 0M12 19.5h.01',
  whatsapp: 'M4 20l1.3-3.9A8 8 0 1 1 8 18.8zM9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2z',
  spark: 'M10 3.5l1.6 4.4 4.4 1.6-4.4 1.6L10 15.5l-1.6-4.4L4 9.5l4.4-1.6zM17.5 14l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z',
} as const;

const pains = [
  {
    stat: '0,5',
    unit: 's',
    visual: 'channels',
    title: 'Abre al instante.',
    body: 'Con el QR o el NFC de la mesa, o un link en tu Instagram. Sin zoom ni descargas.',
  },
  {
    stat: '1',
    unit: 'ecosistema',
    visual: 'eco',
    title: 'No es un PDF.',
    body: 'Menú, horarios, ubicación, reservas y WhatsApp conectados en un solo lugar.',
  },
