    font-size: 13px;
    text-align: center;
  }

  .ia-chat__sub {
    margin-top: 2px;
    color: #71717a;
    font-size: 12px;
  }

  .ia-chat {
    overflow: hidden;
    border-radius: 20px;
    background: #efeae2;
  }

  .ia-chat__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #075e54;
    color: #fff;
  }

  .ia-chat__avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    font-size: 14px;
    font-weight: 700;
  }

  .ia-chat__avatar--logo {
    overflow: hidden;
    width: 42px;
    height: 42px;
    padding: 4px;
    background: #fff;
  }

  .ia-chat__avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ia-chat__name {
    overflow: hidden;
    font-size: 14px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ia-chat__status {
    font-size: 11px;
    opacity: 0.8;
  }

  .ia-chat__thread {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
  }

  .ia-chat__msg {
    max-width: 84%;
    padding: 7px 10px 5px;
    border-radius: 12px;
    box-shadow: 0 1px 0.5px rgba(0, 0, 0, 0.12);
    font-size: 13.5px;
    line-height: 1.35;
  }

  .ia-chat__msg time {
    margin-left: 6px;
    color: #8696a0;
    font-size: 10px;
    white-space: nowrap;
  }

  .ia-chat__msg--in {
    align-self: flex-start;
    border-top-left-radius: 4px;
    background: #fff;
  }

  .ia-chat__msg--out {
    align-self: flex-end;
    border-top-right-radius: 4px;
    background: #d9fdd3;
  }

  .ia-chat__crm {
    margin: 0 12px 12px;
    padding: 10px 12px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.85);
  }

  .ia-chat__crm-title {
    color: #71717a;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ia-chat__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .ia-chat__tags li {
    padding: 4px 9px;
    border-radius: 999px;
    background: #f4f4f5;
    color: #3f3f46;
    font-size: 11.5px;
    font-weight: 500;
  }

  .feat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    border-radius: 22px;
    border: 1px solid color-mix(in oklab, var(--color-white) 10%, transparent);
    background: color-mix(in oklab, var(--color-white) 4%, transparent);
  }

  /* Tarjeta que gira: las dos caras ocupan la misma celda, así mide lo que la más alta. */
  .feat-flip {
    perspective: 1200px;
  }

  .feat-flip__card {
    position: relative;
    display: grid;
    height: 100%;
    border-radius: 22px;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .feat-flip__card[aria-pressed='true'] {
    transform: rotateY(180deg);
  }

  .feat-flip__card:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-white) 45%, transparent);
    outline-offset: 3px;
  }

  .feat-flip__face {
    position: relative;
    grid-area: 1 / 1;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .feat-flip__back {
    justify-content: center;
    gap: 0;
    padding: 18px;
    transform: rotateY(180deg);
  }

  .feat-flip__eyebrow {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .feat-flip__hook {
    margin-top: 6px;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .feat-flip__more {
    margin-top: 10px;
    padding-right: 26px;
    font-size: 0.84rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .feat-flip__face > div:not(.feat__stage) {
    padding-right: 34px;
  }

  .feat-flip__hint {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(28, 25, 23, 0.07);
    color: #78716c;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .feat-flip__hint svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .feat-flip__card:hover .feat-flip__hint {
      transform: rotate(-60deg);
      background: rgba(28, 25, 23, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-flip__card {
      transition: none;
    }
  }

  .feat__stage {
    display: flex;
    align-items: center;
    min-height: 92px;
    padding: 16px 18px;
    border-radius: 16px;
    background: #f6f3ee;
    color: #1c1917;
  }

  .feat--wide .feat__stage {
    min-height: 108px;
  }

  .feat__domain {
    display: flex;
    align-items: baseline;
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .feat__tld {
    --tld-step: 1.28em;
    display: inline-grid;
    height: var(--tld-step);
    overflow: hidden;
    color: #9a6b3f;
  }

  .feat__tld-sizer,
  .feat__tld-track {
    grid-area: 1 / 1;
  }

  .feat__tld-sizer {
    visibility: hidden;
  }

  .feat__tld-track {
    display: flex;
    flex-direction: column;
    animation: feat-tld 16.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .feat__tld-track span,
  .feat__tld-sizer {
    display: block;
    height: var(--tld-step);
    line-height: 1;
  }

  @keyframes feat-tld {
    0%,
    14.8% {
      transform: translateY(0);
    }
    16.666%,
    31.466% {
      transform: translateY(calc(var(--tld-step) * -1));
    }
    33.333%,
    48.133% {
      transform: translateY(calc(var(--tld-step) * -2));
    }
    50%,
    64.8% {
      transform: translateY(calc(var(--tld-step) * -3));
    }
    66.666%,
    81.466% {
      transform: translateY(calc(var(--tld-step) * -4));
    }
    83.333%,
    98.133% {
      transform: translateY(calc(var(--tld-step) * -5));
    }
    100% {
      transform: translateY(calc(var(--tld-step) * -6));
    }
  }

  .feat-menu {
    display: grid;
    width: 100%;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feat-menu li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
  }

  .feat-menu li span:last-child {
    color: #9a6b3f;
    font-variant-numeric: tabular-nums;
  }

  /* El tercer plato se crea en bucle: botón «Nuevo plato» y luego el plato con su etiqueta. */
  .feat-menu li.feat-new {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .feat-new__add,
  .feat-new__dish {
    grid-area: 1 / 1;
  }

  .feat-new__add {
    justify-self: start;
    padding: 2px 10px;
    border: 1px dashed #a8a29e;
    border-radius: 999px;
    color: #78716c;
    font-family: system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    animation: feat-new-add 4.5s ease infinite;
  }

  .feat-menu li.feat-new .feat-new__dish {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    color: #1c1917;
    animation: feat-new-dish 4.5s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .feat-menu li.feat-new .feat-new__dish > span:last-child {
    color: #9a6b3f;
  }

  .feat-new__dish em {
    line-height: 1.3;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 999px;
    background: #059669;
    color: #fff;
    font-family: system-ui, sans-serif;
    font-size: 8.5px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 3px;
  }

  @keyframes feat-new-add {
    0%,
    30% {
      opacity: 1;
      transform: none;
    }
    38%,
    92% {
      opacity: 0;
      transform: scale(0.94);
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes feat-new-dish {
    0%,
    34% {
      opacity: 0;
      transform: translateY(6px);
    }
    44%,
    90% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-new__add {
      display: none;
    }

    .feat-menu li.feat-new .feat-new__dish {
      animation: none;
    }
  }

  .feat-cur {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 8px;
    margin-block: -4px;
    --menu-texto-color: #1c1917;
    --menu-surface-color: #fffdf9;
    --menu-accent-color: #9a6b3f;
  }

  .feat-cur__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .feat-cur :global(.currency-compact__menu) {
    right: auto;
    left: 0;
    transform-origin: top left;
  }

  .feat-cur__try {
    color: #9a6b3f;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .feat-cur__dish {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
  }

  .feat-cur__dish .precio-dinamico {
    color: #9a6b3f;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  .feat-cur__dish .precio-dinamico.is-converting {
    opacity: 0;
  }

  /* El menú de divisas abierto debe quedar sobre las tarjetas vecinas. */
  .feat-flip:has(.currency-compact.is-open) {
    position: relative;
    z-index: 5;
  }

  .feat-open {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .feat-open b {
    display: block;
    font-weight: 600;
  }

  .feat-open i {
    display: block;
    margin-top: 3px;
    color: #78716c;
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
  }

  .feat-open__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #059669;
    box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.16);
  }

  /* Flyer del banner en un teléfono que asoma desde el borde inferior: aparece al abrir el menú, en bucle. */
  .feat__stage:has(.feat-ev) {
    overflow: hidden;
  }

  .feat-ev {
    width: 100%;
    height: 92px;
    margin-block: -16px;
    container: feat-ev / inline-size;
  }

  .feat-ev__row {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .feat-ev__phone {
    position: relative;
    flex: none;
    align-self: flex-end;
    width: 62px;
    height: 104px;
    margin-bottom: -26px;
    padding: 3px;
    border-radius: 15px;
    background: linear-gradient(145deg, #3f3f46, #18181b 40%, #27272a);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 14px 26px -12px rgba(28, 25, 23, 0.55);
  }

  /* Botones laterales: volumen a la izquierda, encendido a la derecha. */
  .feat-ev__phone::before,
  .feat-ev__phone::after {
    content: '';
    position: absolute;
    width: 2px;
    border-radius: 2px;
    background: #27272a;
  }

  .feat-ev__phone::before {
    top: 20px;
    left: -2px;
    height: 12px;
    box-shadow: 0 16px 0 #27272a;
  }

  .feat-ev__phone::after {
    top: 26px;
    right: -2px;
    height: 18px;
  }

  .feat-ev__screen {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #fffdf9;
  }

  /* Dynamic Island */
  .feat-ev__screen::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 50%;
    z-index: 3;
    width: 18px;
    height: 5px;
    border-radius: 999px;
    background: #0a0a0a;
    transform: translateX(-50%);
  }

  .feat-ev__screen::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(28, 25, 23, 0.5);
    animation: feat-ev-dim 5s ease infinite;
  }

  .feat-ev__status {
    position: absolute;
    top: 3px;
    left: 6px;
    color: #1c1917;
    font-size: 5px;
    font-weight: 700;
  }

  .feat-ev__menu {
    display: grid;
    gap: 5px;
    padding: 16px 7px 0;
  }

  .feat-ev__menu i {
    height: 3.5px;
    border-radius: 999px;
    background: #e7e5e4;
  }

  .feat-ev__menu i:first-child {
    width: 60%;
    height: 5px;
    margin-bottom: 2px;
    background: #d6d3d1;
  }

  .feat-ev__menu i:nth-child(3) {
    width: 75%;
  }

  .feat-ev__flyer {
    position: absolute;
    top: 14px;
    left: 6px;
    right: 6px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 2px 5px;
    border-radius: 5px;
    background: linear-gradient(170deg, #7a2133, #3b0d17);
    color: #fbefe3;
    box-shadow:
      0 6px 12px -4px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1px rgba(232, 196, 140, 0.4);
    animation: feat-ev-pop 5s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    will-change: transform, opacity;
  }

  .feat-ev__flyer img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .feat-ev__flyer b {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
  }

  .feat-ev__flyer em {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 7px;
    line-height: 1.1;
    opacity: 0.85;
  }

  .feat-ev__flyer-date {
    margin-top: 3px;
    color: #e8c48c;
    font-size: 4.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .feat-ev__info {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .feat-ev__eyebrow {
    color: #9a6b3f;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .feat-ev__info strong {
    margin-top: 3px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .feat-ev__chip {
    margin-top: 7px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #1c1917;
    color: #f6f3ee;
    font-size: 10px;
    font-weight: 600;
  }

  .feat-ev__eyebrow,
  .feat-ev__info strong {
    white-space: nowrap;
  }

  @container feat-ev (max-width: 220px) {
    .feat-ev__row {
      justify-content: flex-start;
      gap: 12px;
      padding-left: 2px;
    }

    .feat-ev__eyebrow {
      font-size: 8.5px;
      letter-spacing: 0.1em;
    }

    .feat-ev__info strong {
      font-size: 17px;
    }
  }

  @keyframes feat-ev-pop {
    0%,
    8% {
      opacity: 0;
      transform: translateY(8px) scale(0.8);
    }
    20%,
    88% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes feat-ev-dim {
    0%,
    8%,
    100% {
      opacity: 0;
    }
    20%,
    88% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-ev__flyer,
    .feat-ev__screen::after {
      animation: none;
    }
  }

  .feat-bars {
    display: flex;
    width: 100%;
    align-items: flex-end;
    gap: 8px;
    height: 56px;
  }

  .feat-bars span {
    flex: 1;
    border-radius: 6px 6px 2px 2px;
    background: #e4dfd8;
  }

  .feat-bars span:nth-child(4) {
    background: #059669;
  }

  .world {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .chef-bar {
    background:
      radial-gradient(ellipse 140% 90% at 50% 0%, #17110b 0%, transparent 62%),
      #0a0806;
  }

  .stone-veins {
    position: absolute;
    inset: -40%;
    background-size: 1200px 1200px;
    opacity: 0.16;
    filter: blur(0.6px);
    transform: rotate(-22deg);
    mask-image: radial-gradient(ellipse 22% 30% at 50% 50%, rgba(0, 0, 0, 0.4), #000 100%);
  }

  .stone-grain {
    position: absolute;
    inset: 0;
    background-size: 320px 320px;
    mix-blend-mode: overlay;
  }

  .pendant-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 42% at 50% 6%, rgba(255, 196, 128, 0.2), transparent 72%),
      radial-gradient(ellipse 26% 20% at 50% 2%, rgba(255, 226, 180, 0.16), transparent 70%),
      radial-gradient(ellipse 40% 34% at 88% 78%, rgba(255, 170, 100, 0.07), transparent 70%);
    animation: light-breathe 9s ease-in-out infinite alternate;
  }

  .dust {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.5px;
    height: 1.5px;
    border-radius: 999px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 10%, #000 30%, transparent 80%);
    animation: dust-drift 26s ease-in-out infinite alternate;
  }

  .bar-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 90% 80% at 50% 35%, transparent 45%, rgba(0, 0, 0, 0.72) 100%);
  }

  @keyframes light-breathe {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.86;
    }
  }

  @keyframes dust-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(14px, -26px, 0);
    }
  }

  /* Paleta zinc invertida: el mismo markup oscuro se lee en claro. */
  [data-palette='light'] {
    --color-white: oklch(0% 0 0);
    --color-zinc-50: oklch(14.1% 0.005 285.823);
    --color-zinc-100: oklch(21% 0.006 285.885);
    --color-zinc-200: oklch(27.4% 0.006 286.033);
    --color-zinc-300: oklch(37% 0.013 285.805);
    --color-zinc-400: oklch(46% 0.016 285.9);
    --color-zinc-500: oklch(56% 0.016 285.938);
    --color-zinc-600: oklch(70.5% 0.015 286.067);
    --color-zinc-700: oklch(87.1% 0.006 286.286);
    --color-zinc-800: oklch(92% 0.004 286.32);
    --color-zinc-900: oklch(98.5% 0 0);
    --color-zinc-950: oklch(99.5% 0 0);
    --color-emerald-400: oklch(59.6% 0.145 163.225);
  }

  .xemilla-mark--light {
    display: none;
  }

  [data-palette='light'] .xemilla-mark--dark {
    display: none;
  }

  [data-palette='light'] .xemilla-mark--light {
    display: block;
  }

  [data-palette='light'] .plan-frame {
    background: linear-gradient(180deg, #ffffff, rgba(0, 0, 0, 0.08));
