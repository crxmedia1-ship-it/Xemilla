  .loyal__stamps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .loyal__stamp {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    color: rgba(15, 42, 61, 0.16);
  }

  .loyal__stamp img {
    max-width: 94%;
    max-height: 74%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.13;
    mix-blend-mode: multiply;
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  .loyal__mark {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
  }

  .loyal__stamp.is-on {
    color: #12395c;
  }

  .loyal__stamp.is-on img {
    filter: none;
    opacity: 0.92;
  }

  .loyal__stamp.is-on:nth-child(3n + 1) {
    rotate: -9deg;
  }

  .loyal__stamp.is-on:nth-child(3n + 2) {
    rotate: 6deg;
  }

  .loyal__stamp.is-on:nth-child(3n) {
    rotate: -3deg;
  }

  .loyal__stamp.is-new {
    animation: loyal-stamp 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  @keyframes loyal-stamp {
    from {
      scale: 1.7;
      opacity: 0;
    }
  }

  .loyal__stamp--prize {
    color: rgba(180, 83, 9, 0.45);
  }

  .loyal__stamp--prize svg {
    width: 52%;
    height: 52%;
  }

  .loyal__stamp--prize.is-on {
    color: #b45309;
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.55));
  }

  .loyal__status {
    position: relative;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(15, 42, 61, 0.12);
    color: rgba(15, 42, 61, 0.72);
    font-size: 13px;
