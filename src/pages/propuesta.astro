      linear-gradient(155deg, rgb(255 255 255 / 0.72) 0%, rgb(255 255 255 / 0.22) 42%, rgb(255 255 255 / 0.08) 100%);
    color: #1c1917;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 0 -18px 28px rgb(255 255 255 / 0.18),
      0 16px 36px rgb(28 25 23 / 0.12);
    backdrop-filter: blur(18px) saturate(1.6);
