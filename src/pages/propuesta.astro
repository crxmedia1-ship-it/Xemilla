  /* Siempre cuadrada: las zonas de impresión se miden sobre la foto completa. */
  .shop__art {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    aspect-ratio: 1;
    container-type: inline-size;
    translate: 0 -50%;
  }

  .shop__art > img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .shop__print {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    mix-blend-mode: multiply;
  }

  .shop__print img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0.9;
  }

  .shop__brand {
    color: #1c1917;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4.2cqw;
    font-weight: 700;
    letter-spacing: 0.08em;
