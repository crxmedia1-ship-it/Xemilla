---
/**
 * Panel admin (claro) y una carta genérica (oscura) lado a lado:
 * al apagar "Disponible" en el panel, el plato desaparece de la carta.
 * Solo HTML/CSS, sin datos reales ni imports de la app.
 */
interface Props {
  domain: string;
}

const { domain } = Astro.props;

const dishes = [
  {
    name: 'Burrata & tomates',
    note: 'Tomates de temporada, albahaca y aceite de oliva.',
    price: '12.00',
    hue: 8,
    live: false,
  },
  {
    name: 'Risotto de hongos',
    note: 'Arroz carnaroli, setas silvestres y parmesano.',
    price: '16.00',
    hue: 38,
    live: true,
  },
  {
    name: 'Pulpo a la brasa',
    note: 'Puré de papa ahumada, paprika y limón.',
    price: '19.00',
    hue: 16,
    live: false,
  },
  {
    name: 'Tiramisú de la casa',
    note: 'Mascarpone, café espresso y cacao amargo.',
    price: '8.00',
    hue: 26,
    live: false,
  },
];

const panelDishes = dishes.slice(0, 3);
---

<div
  data-collide
  role="img"
  aria-label={`Al apagar un plato en tu panel, desaparece al instante de ${domain}`}
  class="phone-pair"
>
  <figure class="phone-col" aria-hidden="true">
    <figcaption class="phone-label">Tu panel</figcaption>
    <div class="phone">
      <div class="screen admin">
        <span class="island"></span>

        {
          panelDishes.map((dish) => (
            <article class:list={['admin-card', dish.live && 'is-live']}>
              <div class="admin-identity">
                <span class="admin-thumb" style={`--hue:${dish.hue}`} />
                <span class="admin-copy">
                  <span class="admin-name">{dish.name}</span>
                  <span class="admin-note">{dish.note}</span>
                </span>
              </div>
              <div class="admin-foot">
                <span class="admin-price">{dish.price}</span>
                <span class="admin-avail">
                  <span class="admin-avail-label">
                    <span class="on-label">En carta</span>
                    {dish.live && <span class="off-label">Agotado</span>}
                  </span>
                  <span class:list={['admin-toggle', 'is-on', dish.live && 'is-live']}>
                    <span class="knob" />
                    {dish.live && <span class="tap" />}
                  </span>
                </span>
              </div>
            </article>
          ))
        }

        <nav class="admin-dock">
          <span class="is-active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
            Menú
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21a8 8 0 10-16 0" /><circle cx="12" cy="8" r="3.5" /></svg>
            Perfil
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2" /></svg>
            Métricas
          </span>
        </nav>
      </div>
    </div>
  </figure>

  <span class="phone-sync" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>

  <figure class="phone-col" aria-hidden="true">
    <figcaption class="phone-label">Lo que ve tu cliente</figcaption>
    <div class="phone">
      <div class="screen carta">
        <span class="island"></span>

        {
          dishes.map((dish) => (
            <article class:list={['carta-card', dish.live && 'is-live']}>
              <div class="carta-copy">
                <span class="carta-name">{dish.name}</span>
                <p class="carta-note">{dish.note}</p>
                <span class="carta-price">${dish.price}</span>
              </div>
              <span class="carta-photo" style={`--hue:${dish.hue}`}>
                <span class="carta-add">+</span>
              </span>
            </article>
          ))
        }

        <div class="carta-safari">
          <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
          </svg>
          {domain}
        </div>
      </div>
    </div>
  </figure>
</div>

<style>
  .phone-pair {
    --cycle: 7s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }

  .phone-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin: 0;
  }

  .phone-label {
    color: var(--color-zinc-500);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .phone-sync {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-top: 24px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-white) 12%, transparent);
    color: var(--color-zinc-400);
  }

  .phone {
    width: 232px;
    border-radius: 40px;
    padding: 7px;
    background: linear-gradient(150deg, #3a3a40, #101012 45%, #1d1d21);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 70px -30px rgba(20, 15, 10, 0.55),
      0 12px 24px -12px rgba(20, 15, 10, 0.35);
  }

  .screen {
    position: relative;
    height: 350px;
    overflow: hidden;
    border-radius: 33px;
    padding: 40px 10px 0;
  }

  .island {
    position: absolute;
    top: 9px;
    left: 50%;
    z-index: 3;
    width: 70px;
    height: 20px;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }

  .knob {
    position: absolute;
    border-radius: 999px;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.22),
      0 3px 7px rgba(0, 0, 0, 0.12);
  }

  /* ── Panel admin (siempre claro) ── */
  .admin {
    background: #f1f5f9;
    color: #18181b;
    font-family: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    letter-spacing: -0.016em;
  }

  .admin-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 7px;
    padding: 8px;
    border: 1px solid rgba(24, 24, 27, 0.1);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
  }

  .admin-card.is-live {
    animation: admin-card-sync var(--cycle) ease-in-out infinite;
  }

  .admin-identity {
    display: flex;
    gap: 8px;
  }

  .admin-thumb {
    flex: 0 0 62px;
    aspect-ratio: 4 / 3;
    border-radius: 9px;
    background:
      radial-gradient(circle at 35% 30%, hsl(var(--hue) 75% 74% / 0.95), transparent 55%),
      radial-gradient(circle at 65% 70%, hsl(calc(var(--hue) + 20) 55% 40%), hsl(var(--hue) 35% 18%));
  }

  .admin-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .admin-name {
    overflow: hidden;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .admin-note {
    display: -webkit-box;
    overflow: hidden;
    color: #52525b;
    font-size: 7.5px;
    font-weight: 500;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .admin-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .admin-price {
    display: flex;
    align-items: center;
    width: 52px;
    height: 24px;
    padding: 0 7px;
    border: 1px solid rgba(24, 24, 27, 0.12);
    border-radius: 9px;
    background: rgba(24, 24, 27, 0.035);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
  }

  .admin-avail {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 3px 0 8px;
    border-radius: 999px;
    background: rgba(24, 24, 27, 0.05);
  }

  .admin-avail-label {
    display: grid;
    color: #71717a;
    font-size: 6.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .admin-avail-label > span {
    grid-area: 1 / 1;
    text-align: right;
  }

  .off-label {
    color: #fb7185;
    opacity: 0;
  }

  .is-live .on-label {
    animation: label-on-sync var(--cycle) ease-in-out infinite;
  }

  .is-live .off-label {
    animation: label-off-sync var(--cycle) ease-in-out infinite;
  }

  .admin-toggle {
    position: relative;
    width: 31px;
    height: 18px;
    border-radius: 999px;
    background: #3f3f46;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .admin-toggle.is-on {
    background: #059669;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 0 2px color-mix(in srgb, #059669 18%, transparent);
  }

  .admin-toggle .knob {
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
  }

  .admin-toggle.is-on .knob {
    transform: translateX(13px);
  }

  .admin-toggle.is-live {
    animation: toggle-sync var(--cycle) ease-in-out infinite;
  }

  .admin-toggle.is-live .knob {
    animation: knob-sync var(--cycle) cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .tap {
    position: absolute;
    inset: -10px;
    border-radius: 999px;
    background: rgba(24, 24, 27, 0.16);
    opacity: 0;
    animation: tap-sync var(--cycle) ease-out infinite;
  }

  .admin-dock {
    position: absolute;
    right: 18px;
    bottom: 12px;
    left: 18px;
    display: flex;
    justify-content: space-around;
    padding: 6px 4px;
    border: 1px solid rgba(24, 24, 27, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
    color: #a1a1aa;
    font-size: 6.5px;
  }

  .admin-dock span {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .admin-dock svg {
    width: 12px;
    height: 12px;
  }

  .admin-dock .is-active {
    color: #18181b;
  }

  /* ── Carta genérica (oscura, neutra) ── */
  .carta {
    background: radial-gradient(120% 60% at 50% 0%, #26231f, #121110 70%);
    color: #f4efe6;
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
  }

  .carta-card {
    display: flex;
    align-items: center;
    gap: 10px;
    max-height: 90px;
    padding: 10px 2px;
    overflow: hidden;
    border-bottom: 1px solid rgba(244, 239, 230, 0.09);
  }

  .carta-card.is-live {
    animation: carta-card-sync var(--cycle) ease-in-out infinite;
  }

  .carta-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 3px;
  }

  .carta-name {
    overflow: hidden;
    font-family: 'Cormorant Garamond', ui-serif, Georgia, serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .carta-note {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: rgba(244, 239, 230, 0.55);
    font-size: 7.5px;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .carta-price {
    margin-top: 2px;
    color: #d9c29a;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .carta-photo {
    position: relative;
    flex: 0 0 58px;
    height: 58px;
    border-radius: 14px;
    background:
      radial-gradient(circle at 35% 30%, hsl(var(--hue) 75% 74% / 0.95), transparent 55%),
      radial-gradient(circle at 65% 70%, hsl(calc(var(--hue) + 20) 55% 40%), hsl(var(--hue) 35% 18%));
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.45);
  }

  .carta-add {
    position: absolute;
    right: 4px;
    bottom: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #f4efe6;
    color: #121110;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4);
  }

  .carta-safari {
    position: absolute;
    right: 22px;
    bottom: 12px;
    left: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 0;
    border-radius: 999px;
    background: rgba(44, 44, 46, 0.86);
    backdrop-filter: blur(10px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
    color: #f5f5f7;
    font-family: -apple-system, 'SF Pro Text', ui-sans-serif, system-ui, sans-serif;
    font-size: 8.5px;
    font-weight: 500;
  }

  /* ── Coreografía: tap → switch off → plato se va → vuelve ── */
  @keyframes tap-sync {
    0%, 31% { opacity: 0; transform: scale(0.4); }
    34% { opacity: 1; transform: scale(1); }
    41%, 75% { opacity: 0; transform: scale(1.5); }
    78% { opacity: 1; transform: scale(1); }
    85%, 100% { opacity: 0; transform: scale(1.5); }
  }

  @keyframes toggle-sync {
    0%, 36% { background: #059669; }
    40%, 80% { background: #3f3f46; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
    84%, 100% { background: #059669; }
  }

  @keyframes knob-sync {
    0%, 36% { transform: translateX(13px); }
    40%, 80% { transform: translateX(0); }
    84%, 100% { transform: translateX(13px); }
  }

  @keyframes label-on-sync {
    0%, 37% { opacity: 1; }
    40%, 80% { opacity: 0; }
    83%, 100% { opacity: 1; }
  }

  @keyframes label-off-sync {
    0%, 37% { opacity: 0; }
    40%, 80% { opacity: 1; }
    83%, 100% { opacity: 0; }
  }

  @keyframes admin-card-sync {
    0%, 37% { opacity: 1; }
    40%, 80% { opacity: 0.78; }
    83%, 100% { opacity: 1; }
  }

  @keyframes carta-card-sync {
    0%, 42% {
      max-height: 90px;
      padding-block: 10px;
      opacity: 1;
      transform: none;
    }
    50%, 80% {
      max-height: 0;
      padding-block: 0;
      border-color: transparent;
      opacity: 0;
      transform: translateX(16px);
    }
    90%, 100% {
      max-height: 90px;
      padding-block: 10px;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 599px) {
    .phone-pair {
      gap: 10px;
      zoom: 0.68;
    }

    .phone-sync {
      display: none;
    }

    .phone-label {
      font-size: 13px;
      letter-spacing: 0.18em;
    }
  }

  @media (max-width: 429px) {
    .phone-pair {
      zoom: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-pair * {
      animation: none !important;
    }
  }
</style>
