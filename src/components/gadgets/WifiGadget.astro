---
/**
 * Wi‑Fi invitados: QR WIFI:S:…;T:WPA;P:…;; + copia de clave + toast.
 * Compacto en móvil para caber en una sola pantalla del overlay.
 */
interface Props {
  ssid: string;
  password: string;
  textColor?: string;
  mutedColor?: string;
}

const {
  ssid,
  password,
  textColor = 'text-white',
  mutedColor = 'text-zinc-400',
} = Astro.props;

function escapeWifiField(value: string) {
  return String(value || '').replace(/([\\;,:"])/g, '\\$1');
}

const wifiPayload = `WIFI:S:${escapeWifiField(ssid)};T:WPA;P:${escapeWifiField(password)};;`;
const qrSrc = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&margin=6&data=${encodeURIComponent(wifiPayload)}`;
---

<section
  class="wifi-gadget glass-panel"
  data-wifi-gadget
  data-ssid={ssid}
  data-password={password}
  data-wifi-payload={wifiPayload}
>
  <div class="wifi-gadget__inner relative px-4 pb-4 pt-4 md:px-5 md:pb-6 md:pt-6">
    <p class={`text-[0.58rem] font-semibold uppercase tracking-[0.24em] ${mutedColor}`}>
      Wi‑Fi invitados
    </p>
    <h2 class={`mt-1 text-lg font-semibold tracking-tight md:mt-2 md:text-xl ${textColor}`}>
      Conéctate
    </h2>
    <p class={`mt-1 hidden text-sm leading-relaxed md:mt-1.5 md:block ${mutedColor}`}>
      Escanea el código con la cámara para unirte a la red.
    </p>

    <div class="wifi-gadget__body mt-4 md:mt-6">
      <div class="flex flex-col items-center">
        <div
          class="rounded-xl border border-white/15 bg-white p-2 shadow-[0_10px_28px_rgba(0,0,0,0.3)] md:rounded-2xl md:p-3"
        >
          <img
            src={qrSrc}
            alt={`Código QR Wi‑Fi ${ssid}`}
            width="180"
            height="180"
            class="wifi-gadget__qr size-[8.5rem] rounded-md md:size-[11rem] md:rounded-lg"
            data-wifi-qr
            loading="eager"
            decoding="async"
          />
        </div>
        <p
          class={`mt-2 text-center text-[0.52rem] font-semibold uppercase tracking-[0.18em] md:mt-3 md:text-[0.58rem] md:tracking-[0.2em] ${mutedColor}`}
        >
          Escanea para conectar
        </p>
      </div>

      <dl class="wifi-gadget__creds relative mt-3 space-y-2 md:mt-6 md:space-y-3">
        <div class="rounded-xl border border-white/10 bg-white/5 px-3.5 py-2.5 shadow-inner backdrop-blur-md md:px-4 md:py-3.5">
          <dt class={`text-[0.52rem] font-semibold uppercase tracking-[0.2em] md:text-[0.58rem] md:tracking-[0.24em] ${mutedColor}`}>
            Red
          </dt>
          <dd class={`mt-0.5 truncate text-sm font-medium tracking-wide md:mt-1 ${textColor}`} data-wifi-ssid>
            {ssid || '—'}
          </dd>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 px-3.5 py-2.5 shadow-inner backdrop-blur-md md:px-4 md:py-3.5">
          <dt class={`text-[0.52rem] font-semibold uppercase tracking-[0.2em] md:text-[0.58rem] md:tracking-[0.24em] ${mutedColor}`}>
            Clave
          </dt>
          <dd class={`mt-0.5 font-mono text-sm tracking-[0.12em] md:mt-1 md:tracking-[0.14em] ${textColor}`} data-wifi-password>
            {password || '—'}
          </dd>
        </div>
      </dl>
    </div>

    <button type="button" data-wifi-copy class="glass-btn wifi-gadget__copy mt-3 md:mt-5">
      <span data-wifi-copy-label>Copiar Clave</span>
    </button>
  </div>
</section>

<style>
  /* Móvil: caber en una sola pantalla del overlay (sin scroll cortado) */
  @media (max-width: 767px) {
    .wifi-gadget {
      border-radius: 1.1rem;
    }

    .wifi-gadget__body {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.85rem;
    }

    .wifi-gadget__body > div:first-child {
      align-items: flex-start;
    }

    .wifi-gadget__creds {
      margin-top: 0;
    }

    .wifi-gadget__qr {
      width: 7.25rem;
      height: 7.25rem;
    }

    .wifi-gadget__copy {
      padding-block: 0.75rem;
      font-size: 0.62rem;
    }
  }

  @media (max-width: 767px) and (max-height: 700px) {
    .wifi-gadget__inner {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }

    .wifi-gadget__qr {
      width: 6.5rem;
      height: 6.5rem;
    }

    .wifi-gadget__body {
      margin-top: 0.65rem;
      gap: 0.65rem;
    }
  }
</style>

<script>
  /**
   * @param {string} message
   */
  function showWifiToast(message) {
    let toast = document.querySelector('[data-wifi-toast]');
    if (!(toast instanceof HTMLElement)) {
      toast = document.createElement('div');
      toast.setAttribute('data-wifi-toast', '');
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');
      toast.className =
        'pointer-events-none absolute left-1/2 top-[max(1rem,env(safe-area-inset-top))] z-[100] w-[min(92%,22rem)] -translate-x-1/2 rounded-2xl border border-white/15 bg-zinc-950/92 px-4 py-3 text-center text-[0.72rem] font-medium tracking-wide text-white opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 translate-y-[-6px]';
      const host = document.querySelector('[data-restaurant-app]') || document.body;
      host.appendChild(toast);
    }
    toast.textContent = message;
    toast.style.opacity = '1';
    toast.style.transform = 'translate(-50%, 0)';
    clearTimeout(/** @type {any} */ (toast)._timer);
    /** @type {any} */ (toast)._timer = setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translate(-50%, -6px)';
    }, 2800);
  }

  /**
   * @param {HTMLElement} gadget
   */
  async function copyWifiPassword(gadget) {
    const password = gadget.dataset.password ?? '';
    const label = gadget.querySelector('[data-wifi-copy-label]');
    if (!password) return;
    try {
      await navigator.clipboard.writeText(password);
      if (label) label.textContent = '¡Copiada!';
      showWifiToast('¡Contraseña copiada al portapapeles!');
      setTimeout(() => {
        if (label) label.textContent = 'Copiar Clave';
      }, 1800);
    } catch {
      if (label) label.textContent = 'No se pudo copiar';
      setTimeout(() => {
        if (label) label.textContent = 'Copiar Clave';
      }, 1800);
    }
  }

  /**
   * @param {HTMLElement} gadget
   */
  function runWifiOpenActions(gadget) {
    if (gadget.dataset.autoRan === 'true') return;
    gadget.dataset.autoRan = 'true';
    copyWifiPassword(gadget);
  }

  function initWifiGadgets() {
    document.querySelectorAll('[data-wifi-gadget]').forEach((gadget) => {
      if (!(gadget instanceof HTMLElement)) return;
      if (gadget.dataset.ready === 'true') return;
      gadget.dataset.ready = 'true';

      const btn = gadget.querySelector('[data-wifi-copy]');
      btn?.addEventListener('click', () => copyWifiPassword(gadget));
    });

    if (document.documentElement.dataset.wifiOpenBound !== 'true') {
      document.documentElement.dataset.wifiOpenBound = 'true';
      document.addEventListener('xemilla:wifi-open', () => {
        document.querySelectorAll('[data-wifi-gadget]').forEach((gadget) => {
          if (!(gadget instanceof HTMLElement)) return;
          gadget.dataset.autoRan = 'false';
          runWifiOpenActions(gadget);
        });
      });
    }
  }

  initWifiGadgets();
  document.addEventListener('astro:page-load', initWifiGadgets);
</script>
