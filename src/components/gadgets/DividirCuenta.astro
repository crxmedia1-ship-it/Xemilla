---
/**
 * Pedir / Dividir cuenta: alerta a cocina + calculadora opcional.
 */
interface Props {
  restauranteId?: string;
  textColor?: string;
  mutedColor?: string;
  accentText?: string;
}

const {
  restauranteId = '',
  textColor = 'text-sanza-ink',
  mutedColor = 'text-sanza-muted',
  accentText = 'text-sanza-ink',
} = Astro.props;
---

<section class="dividir-cuenta glass-panel space-y-4">
  {
    restauranteId ? (
      <div
        class="relative px-5 pb-5 pt-6"
        data-mesa-alerta
        data-alerta-tipo="cuenta"
        data-restaurante-id={restauranteId}
      >
        <p class={`text-[0.62rem] font-semibold uppercase tracking-[0.28em] ${mutedColor}`}>
          Servicio en mesa
        </p>
        <h2 class={`mt-2 text-xl font-semibold tracking-tight ${textColor}`}>
          Pedir la cuenta
        </h2>
        <p class={`mt-1.5 text-sm leading-relaxed ${mutedColor}`}>
          Avisa al equipo para que traigan la cuenta a tu mesa.
        </p>

        <div class="mt-5 rounded-xl border border-white/10 bg-white/5 px-4 py-3.5">
          <p class={`text-[0.58rem] font-semibold uppercase tracking-[0.24em] ${mutedColor}`}>
            Tu mesa
          </p>
          <p class={`mt-1 text-lg font-semibold tracking-tight ${textColor}`} data-mesa-display>
            —
          </p>
          <input type="hidden" data-mesa-input value="" />
        </div>

        <button type="button" class="glass-btn mt-4 w-full" data-mesa-enviar>
          Pedir la cuenta
        </button>

        <p
          class={`mt-3 hidden text-center text-xs ${mutedColor}`}
          data-mesa-status
          role="status"
        ></p>
      </div>
    ) : null
  }

  <div class="relative border-t border-white/8 px-5 pb-6 pt-5">
    <div
      class="pointer-events-none absolute -left-10 top-0 h-40 w-40 rounded-full bg-sanza-gold/20 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <p class={`text-[0.62rem] font-semibold uppercase tracking-[0.28em] ${mutedColor}`}>
      Calculadora
    </p>
    <h2 class={`mt-2 text-xl font-semibold tracking-tight ${textColor}`}>Dividir cuenta</h2>
    <p class={`mt-1.5 text-sm leading-relaxed ${mutedColor}`}>
      Ingresa el total y cuántos pagan.
    </p>

    <form class="relative mt-6 space-y-4" data-dividir-form>
      <label class="block">
        <span class={`mb-2 block text-[0.58rem] font-semibold uppercase tracking-[0.24em] ${mutedColor}`}>
          Total de la cuenta
        </span>
        <div class="relative">
          <span
            class={`pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm ${mutedColor}`}
          >
            $
          </span>
          <input
            type="number"
            name="total"
            inputmode="decimal"
            min="0"
            step="0.01"
            placeholder="0.00"
            required
            class={`glass-field pl-8 ${textColor} placeholder:opacity-35`}
          />
        </div>
      </label>

      <label class="block">
        <span class={`mb-2 block text-[0.58rem] font-semibold uppercase tracking-[0.24em] ${mutedColor}`}>
          Número de personas
        </span>
        <input
          type="number"
          name="personas"
          inputmode="numeric"
          min="1"
          step="1"
          value="2"
          required
          class={`glass-field ${textColor}`}
        />
      </label>

      <button type="submit" class="glass-btn">Calcular</button>
    </form>

    <div
      class="mt-5 hidden rounded-xl border border-white/10 bg-white/5 px-4 py-4 shadow-inner backdrop-blur-md"
      data-dividir-resultado
      aria-live="polite"
    >
      <p class={`text-[0.58rem] font-semibold uppercase tracking-[0.24em] ${mutedColor}`}>
        Cada uno paga
      </p>
      <p
        class={`mt-1 text-3xl font-semibold tabular-nums tracking-tight ${accentText}`}
        data-dividir-monto
      >
        $0.00
      </p>
    </div>
  </div>
</section>

<script>
  import { initAllMesaAlertas } from '../../lib/mesa-alerta-client.js';

  function initDividirCuenta() {
    initAllMesaAlertas('[data-mesa-alerta][data-alerta-tipo="cuenta"]', {
      defaultLabel: 'Pedir la cuenta',
    });

    document.querySelectorAll('[data-dividir-form]').forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;
      if (form.dataset.ready === 'true') return;
      form.dataset.ready = 'true';

      const section = form.closest('.dividir-cuenta');
      const resultado = section?.querySelector('[data-dividir-resultado]');
      const monto = section?.querySelector('[data-dividir-monto]');

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const total = Number(data.get('total'));
        const personas = Number(data.get('personas'));
        if (!Number.isFinite(total) || total < 0 || !Number.isFinite(personas) || personas < 1) {
          return;
        }
        const cadaUno = total / personas;
        if (monto) {
          monto.textContent = `$${cadaUno.toFixed(2)}`;
        }
        resultado?.classList.remove('hidden');
      });
    });
  }

  initDividirCuenta();
  document.addEventListener('astro:page-load', initDividirCuenta);
</script>
