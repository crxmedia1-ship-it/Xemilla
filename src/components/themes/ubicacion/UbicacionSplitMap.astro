---
/**
 * Ubicación Split Map — mapa hero + tabs (Uber Eats / Escape Cafe).
 */
import { googleMapsEmbedSrc } from '../../../lib/maps-preview.js';
import {
  resolveHorarioFilas,
  resolveRedesActivas,
  resolveMapsHref,
} from '../../../lib/ubicacion-theme-data.js';
import UbicacionActionPills from './UbicacionActionPills.astro';

interface Props {
  direccion: string;
  ciudad: string;
  telefono: string;
  email?: string;
  instagram?: string;
  whatsapp?: string;
  redes?: Array<{ red: string; url: string; activo?: boolean }>;
  mapaLabel: string;
  mapaUrl: string;
  horarios: string | Array<{ dia: string; horas: string }>;
  horariosRows?: Array<{ dia: string; horas: string }>;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  direccion,
  ciudad,
  telefono,
  email = '',
  instagram = '',
  whatsapp = '',
  redes = [],
  mapaUrl,
  horarios,
  horariosRows,
  sectionColors = {},
  estilos,
} = Astro.props;

const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;

const telHref = String(telefono || '').replace(/[^\d+]/g, '');
const emailHref = email.trim();
const mapsQuery = [direccion, ciudad].filter(Boolean).join(', ');
const mapsHref = resolveMapsHref(mapaUrl, direccion, ciudad);
const wazeHref = `https://waze.com/ul?q=${encodeURIComponent(mapsQuery || 'restaurante')}&navigate=yes`;
const mapsEmbed = googleMapsEmbedSrc(mapaUrl, mapsQuery);
const redesActivas = resolveRedesActivas(
  instagram,
  redes,
  whatsapp || telefono,
);

const horarioFilas = resolveHorarioFilas(horarios, horariosRows);
const horariosJson = JSON.stringify(horarioFilas);

const glassCard =
  'rounded-2xl border border-white/10 bg-black/40 backdrop-blur-xl';
---

<div
  class="ubicacion-split mx-auto flex w-full max-w-none flex-col px-4 pb-[max(2.5rem,env(safe-area-inset-bottom))] pt-4"
  data-ubicacion-panel
  data-ubicacion-theme="split"
  data-horarios={horariosJson}
>
  <header class={`overflow-hidden ${glassCard}`}>
    <div class="relative aspect-[16/10] w-full overflow-hidden bg-black/40">
      {
        mapsEmbed ? (
          <iframe
            title="Mapa del restaurante"
            src={mapsEmbed}
            class="absolute inset-0 h-full w-full border-0 grayscale-[25%] contrast-110"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        ) : (
          <div class="absolute inset-0 grid place-items-center px-6 text-center text-sm text-white/50">
            Mapa no configurado
          </div>
        )
      }
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/40"></div>

      <div
        class="live-badge absolute left-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-black/45 px-2.5 py-1.5 backdrop-blur-xl"
        data-live-badge
        role="status"
        aria-live="polite"
      >
        <span data-live-dot class="size-2 rounded-full bg-current opacity-40" aria-hidden="true"></span>
        <span data-live-label class="text-[0.55rem] font-semibold uppercase tracking-[0.16em] text-white">
          …
        </span>
      </div>

      {
        mapsQuery ? (
          <div class="absolute bottom-3 left-3 right-3 z-10 flex items-end justify-between gap-2">
            <p class="max-w-[70%] truncate rounded-full border border-white/12 bg-black/55 px-3 py-1.5 text-xs text-white/85 backdrop-blur-xl">
              {mapsQuery}
            </p>
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 rounded-full border border-white/12 bg-white/95 px-3.5 py-1.5 text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-black transition active:scale-95"
            >
              Cómo llegar
            </a>
          </div>
        ) : null
      }
    </div>
  </header>

  <div
    class={`mt-5 grid grid-cols-2 gap-1 p-1 ${glassCard}`}
    role="tablist"
    aria-label="Secciones de ubicación"
  >
    <button
      type="button"
      role="tab"
      aria-selected="true"
      data-ubicacion-tab="horarios"
      class="ubicacion-tab is-active rounded-xl px-3 py-2.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-white/55 transition-all duration-200"
    >
      Horarios
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-ubicacion-tab="redes"
      class="ubicacion-tab rounded-xl px-3 py-2.5 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-white/55 transition-all duration-200"
    >
      Redes
    </button>
  </div>

  <div class="mt-4" data-ubicacion-pane="horarios">
    <div class={`overflow-hidden ${glassCard}`}>
      <div class="flex items-center gap-2 border-b border-white/8 px-4 py-3">
        <span class="split-icon split-icon--clock" aria-hidden="true"></span>
        <p
          class={`text-[0.58rem] font-semibold uppercase tracking-[0.18em] ${estilos.softColor}`}
          style={bodyStyle}
        >
          Horario semanal
        </p>
      </div>
      <ul class="divide-y divide-white/8 px-3 py-1">
        {
          horarioFilas.length === 0 ? (
            <li class={`px-1 py-4 text-sm ${estilos.mutedColor}`} style={bodyStyle}>
              Sin horarios
            </li>
          ) : (
            horarioFilas.map((h, index) => (
              <li
                class="horario-row flex items-baseline justify-between gap-3 rounded-xl px-2 py-3 transition-colors"
                data-horario-row
                data-horario-index={index}
                data-dia={h.dia}
                data-horas={h.horas}
              >
                <span class={`text-sm ${estilos.mutedColor}`} style={bodyStyle}>{h.dia}</span>
                <span
                  class={`text-sm font-medium tabular-nums ${estilos.textColor}`}
                  style={titleStyle}
                >
                  {h.horas}
                </span>
              </li>
            ))
          )
        }
      </ul>
    </div>
  </div>

  <div class="mt-4 hidden" data-ubicacion-pane="redes" hidden>
    <div class={`space-y-4 p-4 ${glassCard}`}>
      <UbicacionActionPills
        mapsHref={mapsHref}
        redesActivas={redesActivas}
        layout="grid"
      />

      {
        telefono && telHref ? (
          <a
            href={`tel:${telHref}`}
            class={`flex items-center justify-between rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-sm transition active:scale-[0.99] ${estilos.textColor}`}
            style={titleStyle}
          >
            <span class={`text-[0.55rem] uppercase tracking-[0.16em] ${estilos.mutedColor}`} style={bodyStyle}>
              Llamar
            </span>
            <span class="font-medium">{telefono}</span>
          </a>
        ) : null
      }
      {
        emailHref ? (
          <a
            href={`mailto:${emailHref}`}
            class={`flex items-center justify-between rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-sm transition active:scale-[0.99] ${estilos.textColor}`}
            style={titleStyle}
          >
            <span class={`text-[0.55rem] uppercase tracking-[0.16em] ${estilos.mutedColor}`} style={bodyStyle}>
              Email
            </span>
            <span class="truncate font-medium">{emailHref}</span>
          </a>
        ) : null
      }

      <div class="grid grid-cols-2 gap-2 border-t border-white/8 pt-3">
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class={`rounded-xl border border-white/10 bg-black/30 px-3 py-3 text-center text-[0.55rem] font-semibold uppercase tracking-[0.14em] backdrop-blur-xl transition active:scale-95 ${estilos.textColor}`}
          style={titleStyle}
        >
          Google Maps
        </a>
        <a
          href={wazeHref}
          target="_blank"
          rel="noopener noreferrer"
          class={`rounded-xl border border-white/10 bg-black/30 px-3 py-3 text-center text-[0.55rem] font-semibold uppercase tracking-[0.14em] backdrop-blur-xl transition active:scale-95 ${estilos.textColor}`}
          style={titleStyle}
        >
          Waze
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .live-badge.is-open [data-live-dot] {
    background: #22c55e;
    opacity: 1;
  }

  .live-badge.is-closed [data-live-dot] {
    background: #ef4444;
    opacity: 1;
  }

  .ubicacion-tab.is-active {
    background: color-mix(in srgb, var(--color-primario) 28%, transparent);
    color: var(--color-texto);
  }

  .split-icon {
    width: 1rem;
    height: 1rem;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    opacity: 0.75;
  }

  .split-icon--clock {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%23a1a1aa' stroke-width='1.8' viewBox='0 0 24 24'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>");
  }

  [data-horario-row].is-today {
    background: color-mix(in srgb, white 7%, transparent);
    font-weight: 600;
  }

  [data-horario-row].is-today span:first-child {
    color: var(--color-texto, #fff);
  }
</style>

<script>
  import { initUbicacionLivePanels } from '../../../lib/ubicacion-live-client.js';

  function initSplitTabs() {
    document.querySelectorAll('[data-ubicacion-theme="split"]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.tabsReady === 'true') return;
      root.dataset.tabsReady = 'true';

      const tabs = root.querySelectorAll('[data-ubicacion-tab]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          if (!(tab instanceof HTMLElement)) return;
          const id = tab.dataset.ubicacionTab || '';
          tabs.forEach((t) => {
            if (!(t instanceof HTMLElement)) return;
            const on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          root.querySelectorAll('[data-ubicacion-pane]').forEach((pane) => {
            if (!(pane instanceof HTMLElement)) return;
            const show = pane.dataset.ubicacionPane === id;
            pane.classList.toggle('hidden', !show);
            pane.hidden = !show;
          });
        });
      });
    });
  }

  initUbicacionLivePanels();
  initSplitTabs();
  document.addEventListener('astro:page-load', () => {
    initUbicacionLivePanels();
    initSplitTabs();
  });
</script>
