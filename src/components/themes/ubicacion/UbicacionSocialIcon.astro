---
interface Props {
  id: string;
  uid?: string;
}

const { id, uid = id } = Astro.props;
const key = String(id || '').toLowerCase();
const gradId = `ig-grad-${uid}`;
---

{
  key === 'maps' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="ubicacion-social-icon__svg">
      <path fill="#EA4335" d="M12 11.5c1.38 0 2.5-1.12 2.5-2.5S13.38 6.5 12 6.5 9.5 7.62 9.5 9s1.12 2.5 2.5 2.5z" />
      <path fill="#4285F4" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" />
      <path fill="#FBBC04" d="M5 9c0-1.02.31-1.97.84-2.75L12 17.5 18.16 6.25A6.96 6.96 0 0 0 12 2v7.5L7.9 8.5A2.98 2.98 0 0 0 5 9z" opacity=".85" />
      <path fill="#34A853" d="M12 22s7-7.75 7-13c0-.34-.03-.67-.08-1L12 17.5 5.08 8c-.05.33-.08.66-.08 1 0 5.25 7 13 7 13z" opacity=".75" />
    </svg>
  ) : key === 'whatsapp' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="ubicacion-social-icon__svg">
      <path fill="#fff" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
    </svg>
  ) : key === 'instagram' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="ubicacion-social-icon__svg">
      <defs>
        <linearGradient id={gradId} x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#FD5949" />
          <stop offset="50%" stop-color="#D6249F" />
          <stop offset="100%" stop-color="#285AEB" />
        </linearGradient>
      </defs>
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill={`url(#${gradId})`} />
      <circle cx="12" cy="12" r="4.2" fill="none" stroke="#fff" stroke-width="1.8" />
      <circle cx="17.4" cy="6.6" r="1.2" fill="#fff" />
    </svg>
  ) : key === 'facebook' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="ubicacion-social-icon__svg">
      <path fill="#fff" d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
    </svg>
  ) : key === 'tiktok' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="ubicacion-social-icon__svg">
      <path fill="#fff" d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z" />
    </svg>
  ) : key === 'tripadvisor' ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="ubicacion-social-icon__svg">
      <circle cx="7.2" cy="14" r="3.1" fill="#fff" />
      <circle cx="16.8" cy="14" r="3.1" fill="#fff" />
      <circle cx="7.2" cy="14" r="1.5" fill="#000" />
      <circle cx="16.8" cy="14" r="1.5" fill="#000" />
      <path fill="#fff" d="M12 3.5 13.4 7l3.6.5-2.6 2.5.6 3.6L12 11.5 9 13.6l.6-3.6-2.6-2.5 3.6-.5L12 3.5z" />
      <path fill="#fff" d="M3.5 8.5h3.2l.5 1.2c.8-.9 2-1.5 3.3-1.5 1.4 0 2.6.6 3.4 1.6l.5-1.3h3.2l-2.8 6.8h-2.4l.3-3.2a3.2 3.2 0 0 0-2.9 1.8 3.2 3.2 0 0 0-2.9-1.8l.3 3.2H6.3L3.5 8.5z" />
    </svg>
  ) : null
}
