---
/**
 * Ubicación Modal — drawer inferior estilo bottom sheet (Zesty / Tabby).
 */
import {
  resolveHorarioFilas,
  resolveRedesActivas,
  resolveMapsHref,
} from '../../../lib/ubicacion-theme-data.js';
import UbicacionActionPills from './UbicacionActionPills.astro';

interface Props {
  direccion: string;
  ciudad: string;
  telefono: string;
  email?: string;
  instagram?: string;
  whatsapp?: string;
  redes?: Array<{ red: string; url: string; activo?: boolean }>;
  mapaLabel: string;
  mapaUrl: string;
  horarios: string | Array<{ dia: string; horas: string }>;
  horariosRows?: Array<{ dia: string; horas: string }>;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  direccion,
  ciudad,
  telefono,
  instagram = '',
  whatsapp = '',
  redes = [],
  mapaUrl,
  horarios,
  horariosRows,
  sectionColors = {},
  estilos,
} = Astro.props;

const secFondo = (sectionColors.color_fondo || '').trim();
const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;
const drawerBgStyle = secFondo
  ? `background: color-mix(in srgb, ${secFondo} 94%, transparent)`
  : undefined;

const mapsQuery = [direccion, ciudad].filter(Boolean).join(', ');
const addressLine = mapsQuery || 'Nuestro local';
const mapsHref = resolveMapsHref(mapaUrl, direccion, ciudad);
const redesActivas =   resolveRedesActivas(instagram, redes, whatsapp);

const horarioFilas = resolveHorarioFilas(horarios, horariosRows);
const horariosJson = JSON.stringify(horarioFilas);
---

<div
  class="ubicacion-drawer-root fixed inset-0 z-[60] mx-auto flex w-full items-end justify-center"
  data-ubicacion-drawer
  data-open="false"
  aria-hidden="true"
>
  <button
    type="button"
    class="absolute inset-0 bg-black/60 backdrop-blur-[3px] transition-opacity duration-300"
    data-ubicacion-drawer-backdrop
    aria-label="Cerrar ubicación"
  ></button>

  <div
    class="ubicacion-drawer relative z-10 max-h-[min(90dvh,42rem)] w-full overflow-hidden rounded-t-[1.85rem] border border-white/12 shadow-[0_-20px_60px_rgba(0,0,0,0.5)] backdrop-blur-xl"
    style={drawerBgStyle}
    role="dialog"
    aria-modal="true"
    aria-labelledby="ubicacion-drawer-title"
  >
    <div class="flex justify-center pt-3.5 pb-1" aria-hidden="true">
      <span class="h-1 w-11 rounded-full bg-white/30"></span>
    </div>

    <div
      class="ubicacion-modal overflow-y-auto overscroll-contain px-5 pb-[max(1.75rem,env(safe-area-inset-bottom))] pt-2"
      data-ubicacion-panel
      data-ubicacion-theme="modal"
      data-horarios={horariosJson}
    >
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <p
            class={`text-[0.58rem] font-semibold uppercase tracking-[0.28em] ${estilos.softColor}`}
            style={bodyStyle}
          >
            Horarios de atención
          </p>
          <h3
            id="ubicacion-drawer-title"
            class={`mt-2 font-[family-name:var(--font-heading,var(--fuente-titulos))] text-base font-medium leading-snug tracking-tight ${estilos.textColor}`}
            style={titleStyle}
          >
            {addressLine}
          </h3>
          {
            mapsQuery ? (
              <p
                class={`mt-2 inline-flex items-center gap-1.5 text-xs ${estilos.mutedColor}`}
                style={bodyStyle}
              >
                <span class="ubicacion-pin" aria-hidden="true"></span>
                {mapsQuery}
              </p>
            ) : null
          }
        </div>

        <div class="flex shrink-0 flex-col items-end gap-2">
          <button
            type="button"
            data-ubicacion-drawer-close
            class="flex size-8 items-center justify-center rounded-full border border-white/10 bg-black/40 text-white/70 backdrop-blur-xl transition hover:text-white"
            aria-label="Cerrar"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5">
              <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
          <div
            class="live-badge inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-black/40 px-2.5 py-1.5 backdrop-blur-xl"
            data-live-badge
            data-open="unknown"
            role="status"
            aria-live="polite"
          >
            <span data-live-dot class="size-2 rounded-full bg-current opacity-40" aria-hidden="true"></span>
            <span
              data-live-label
              class={`text-[0.55rem] font-semibold uppercase tracking-[0.16em] ${estilos.mutedColor}`}
              style={bodyStyle}
            >
              …
            </span>
          </div>
        </div>
      </div>

      <div class="mt-5 overflow-hidden rounded-2xl border border-white/10 bg-black/35 backdrop-blur-xl">
        <div class="border-b border-white/8 px-4 py-2.5">
          <p
            class={`text-[0.55rem] font-semibold uppercase tracking-[0.2em] ${estilos.softColor}`}
            style={bodyStyle}
          >
            Esta semana
          </p>
        </div>
        <ul class="divide-y divide-white/8 px-3 py-1">
          {
            horarioFilas.length === 0 ? (
              <li class={`px-1 py-4 text-sm ${estilos.mutedColor}`} style={bodyStyle}>
                Sin horarios configurados
              </li>
            ) : (
              horarioFilas.map((h, index) => (
                <li
                  class="horario-row flex items-baseline justify-between gap-3 rounded-xl px-2 py-2.5 transition-colors"
                  data-horario-row
                  data-horario-index={index}
                  data-dia={h.dia}
                  data-horas={h.horas}
                >
                  <span class={`text-sm ${estilos.mutedColor}`} style={bodyStyle}>{h.dia}</span>
                  <span
                    class={`text-sm font-medium tabular-nums ${estilos.textColor}`}
                    style={titleStyle}
                  >
                    {h.horas}
                  </span>
                </li>
              ))
            )
          }
        </ul>
      </div>

      <div class="mt-5">
        <p
          class={`mb-3 text-[0.55rem] font-semibold uppercase tracking-[0.2em] ${estilos.softColor}`}
          style={bodyStyle}
        >
          Redes y contacto
        </p>
        <UbicacionActionPills
          mapsHref={mapsHref}
          redesActivas={redesActivas}
          layout="scroll"
        />
      </div>
    </div>
  </div>
</div>

<style>
  .ubicacion-drawer-root {
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ubicacion-drawer-root.is-open {
    pointer-events: auto;
    opacity: 1;
  }

  .ubicacion-drawer {
    transform: translateY(100%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    background: color-mix(in srgb, var(--color-fondo) 94%, transparent);
  }

  .ubicacion-drawer-root.is-open .ubicacion-drawer {
    transform: translateY(0);
  }

  .ubicacion-pin {
    width: 0.85rem;
    height: 0.85rem;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%23a1a1aa' stroke-width='1.8' viewBox='0 0 24 24'><path d='M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z'/><circle cx='12' cy='10' r='2.5'/></svg>") center/contain no-repeat;
  }

  .live-badge.is-open [data-live-dot] {
    background: #22c55e;
    opacity: 1;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
  }

  .live-badge.is-closed [data-live-dot] {
    background: #ef4444;
    opacity: 1;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.18);
  }

  [data-horario-row].is-today {
    background: color-mix(in srgb, white 7%, transparent);
    font-weight: 600;
  }

  [data-horario-row].is-today span:first-child {
    color: var(--color-texto, #fff);
  }

  @media (prefers-reduced-motion: reduce) {
    .ubicacion-drawer-root,
    .ubicacion-drawer {
      transition: none !important;
    }
  }
</style>

<script>
  import { initUbicacionLivePanels } from '../../../lib/ubicacion-live-client.js';

  initUbicacionLivePanels();
  document.addEventListener('astro:page-load', () => initUbicacionLivePanels());
</script>
