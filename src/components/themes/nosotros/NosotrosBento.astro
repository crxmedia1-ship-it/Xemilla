---
/**
 * Nosotros Bento — Bond / Clay / Cosmos.
 * Grid asimétrico de cápsulas glass. Móvil: 2 cols; desktop: 6 cols con spans.
 */
import {
  resolveNosotrosBloques,
  renderTitleHtml,
  renderBodyHtml,
  normalizeContenedorEstilo,
  contenedorCardStyle,
} from '../../../lib/nosotros-layout.js';
import NosotrosMediaStack from './NosotrosMediaStack.astro';

interface BloqueEditorial {
  subtitulo?: string;
  titulo?: string;
  tituloAcento?: string;
  caption?: string;
  imagen?: string | null;
  media_url?: string | null;
  media?: string[];
  texto?: string;
  contenido?: string;
  alineacion?: string;
  acentos?: string[];
}

interface Props {
  bloques?: BloqueEditorial[];
  texto?: string;
  highlights?: string[];
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
    contenedor_estilo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  bloques = [],
  texto = '',
  highlights = [],
  sectionColors = {},
  estilos,
} = Astro.props;

const containerBg = (sectionColors.color_fondo || '').trim();
const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;
const cardSkin = contenedorCardStyle(
  normalizeContenedorEstilo(sectionColors.contenedor_estilo),
  containerBg,
);

const items = resolveNosotrosBloques({ bloques, texto, highlights });
const [hero, ...rest] = items;

function shortPhrase(text: string, max = 72) {
  const clean = String(text || '').replace(/\s+/g, ' ').trim();
  if (!clean) return '';
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > 24 ? cut.slice(0, lastSpace) : cut).trim()}…`;
}

function wordMetric(text: string) {
  const words = String(text || '')
    .trim()
    .split(/\s+/)
    .filter(Boolean).length;
  return words > 0 ? String(words) : '—';
}

function panelStyle(extra = '') {
  return [cardSkin, extra].filter(Boolean).join('; ') || undefined;
}
---

<div
  class="nosotros-bento mx-auto w-full max-w-5xl px-4 pb-[max(3.5rem,env(safe-area-inset-bottom))] pt-5 font-[family-name:var(--font-body,var(--fuente-principal))] sm:px-5 md:pt-8"
>
  {
    items.length === 0 ? (
      <p class={`mx-auto max-w-prose text-center text-sm leading-relaxed ${estilos.mutedColor}`}>
        Pronto contaremos nuestra historia.
      </p>
    ) : (
      <div class="grid grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-6 md:auto-rows-[minmax(7rem,auto)] md:gap-3.5">
        {hero && (
          <article
            class="glass-panel col-span-2 flex flex-col justify-between gap-3.5 rounded-2xl p-4 sm:rounded-[1.35rem] sm:p-5 md:col-span-4 md:row-span-2 md:gap-4"
            data-reveal
            style={panelStyle(
              'border-color:color-mix(in srgb, var(--color-primario) 28%, transparent)',
            )}
          >
            <div class="min-w-0 space-y-2">
              <span
                class="inline-flex items-center rounded-full px-2.5 py-1 text-[0.55rem] font-semibold uppercase tracking-[0.18em]"
                style="background:color-mix(in srgb, var(--color-primario) 18%, transparent); color:var(--color-primario)"
              >
                {hero.subtitulo || 'Historia'}
              </span>
              {hero.titulo && (
                <h3
                  class={`nosotros-copy break-words text-[1.35rem] font-semibold leading-[1.12] tracking-[0.02em] font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[1.55rem] md:text-[1.75rem] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                  style={titleStyle}
                  set:html={renderTitleHtml(hero.titulo, hero.tituloAcento)}
                />
              )}
            </div>

            {(Array.isArray(hero.media) ? hero.media : []).length > 0 && (
              <div class="overflow-hidden rounded-2xl">
                <NosotrosMediaStack
                  media={hero.media}
                  aspectClass="aspect-[16/10]"
                  softColor={estilos.softColor}
                />
              </div>
            )}

            {hero.texto && (
              <p
                class={`nosotros-copy break-words text-[0.88rem] leading-[1.7] sm:text-[0.94rem] ${!bodyColor ? estilos.textColor : ''}`}
                style={bodyStyle}
                set:html={renderBodyHtml(hero.texto, hero.acentos)}
              />
            )}
          </article>
        )}

        {hero?.texto && (
          <article
            class="glass-panel col-span-1 flex min-w-0 flex-col justify-between rounded-2xl p-3.5 sm:rounded-[1.25rem] sm:p-4 md:col-span-2"
            data-reveal
            style={panelStyle(
              containerBg
                ? ''
                : 'background:color-mix(in srgb, var(--color-primario) 16%, transparent); border-color:color-mix(in srgb, var(--color-primario) 40%, transparent)',
            )}
          >
            <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.2em] ${estilos.softColor}`}>
              Palabras
            </p>
            <p
              class={`mt-2 break-words text-[2rem] font-semibold tabular-nums leading-none tracking-tight font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[2.35rem] ${!titleColor ? estilos.textColor : ''}`}
              style={titleStyle}
            >
              {wordMetric(hero.texto)}
            </p>
            <p class={`mt-2 text-[0.7rem] leading-snug ${estilos.softColor}`}>
              en la historia principal
            </p>
          </article>
        )}

        {hero?.titulo && (
          <article
            class="glass-panel col-span-1 flex min-w-0 flex-col justify-center gap-2 rounded-2xl p-3.5 sm:rounded-[1.25rem] sm:p-4 md:col-span-2"
            data-reveal
            style={panelStyle()}
          >
            <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.2em] ${estilos.softColor}`}>
              Frase
            </p>
            <p
              class={`nosotros-copy break-words text-[0.92rem] font-medium leading-snug font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[1rem] ${!titleColor ? estilos.textColor : ''}`}
              style={titleStyle}
            >
              “{shortPhrase(hero.titulo, 42)}”
            </p>
          </article>
        )}

        {rest.map((bloque, index) => {
          const titleHtml = renderTitleHtml(bloque.titulo || '', bloque.tituloAcento);
          const bodyHtml = renderBodyHtml(
            shortPhrase(bloque.texto || '', 120),
            bloque.acentos,
          );
          const wide = index % 3 === 0;
          const mediaList = Array.isArray(bloque.media) ? bloque.media : [];

          return (
            <article
              class:list={[
                'glass-panel flex min-w-0 flex-col gap-2.5 rounded-2xl p-3.5 sm:rounded-[1.25rem] sm:p-4',
                wide ? 'col-span-2 md:col-span-3' : 'col-span-1 md:col-span-2',
              ]}
              data-reveal
              style={panelStyle(
                'border-color:color-mix(in srgb, var(--color-primario) 18%, transparent)',
              )}
            >
              <div class="flex items-center justify-between gap-2">
                <span class={`text-[0.55rem] font-semibold uppercase tracking-[0.18em] ${estilos.softColor}`}>
                  {String(index + 2).padStart(2, '0')}
                </span>
                {bloque.subtitulo && (
                  <span class={`truncate text-[0.55rem] uppercase tracking-[0.12em] ${estilos.softColor}`}>
                    {bloque.subtitulo}
                  </span>
                )}
              </div>

              {mediaList.length > 0 && (
                <div class="overflow-hidden rounded-xl">
                  <NosotrosMediaStack
                    media={mediaList}
                    aspectClass="aspect-[4/3]"
                    softColor={estilos.softColor}
                  />
                </div>
              )}

              {bloque.titulo && (
                <h3
                  class={`nosotros-copy break-words text-[1rem] font-semibold leading-snug font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[1.05rem] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                  style={titleStyle}
                  set:html={titleHtml}
                />
              )}

              {bloque.texto && (
                <p
                  class={`nosotros-copy break-words text-[0.8rem] leading-[1.6] sm:text-[0.84rem] ${!bodyColor ? estilos.textColor : ''}`}
                  style={bodyStyle}
                  set:html={bodyHtml}
                />
              )}
            </article>
          );
        })}
      </div>
    )
  }
</div>

<style>
  .editorial-accent {
    color: var(--color-primario);
  }

  .nosotros-copy {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
