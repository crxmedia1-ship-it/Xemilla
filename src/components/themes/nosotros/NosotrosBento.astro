---
/**
 * Nosotros Bento — grid asimétrico de cápsulas (historia + métricas/frases).
 */
import {
  resolveNosotrosBloques,
  renderTitleHtml,
  renderBodyHtml,
  isVideoUrl,
} from '../../../lib/nosotros-layout.js';

interface BloqueEditorial {
  subtitulo?: string;
  titulo?: string;
  tituloAcento?: string;
  caption?: string;
  imagen?: string | null;
  media_url?: string | null;
  texto?: string;
  contenido?: string;
  alineacion?: string;
  acentos?: string[];
}

interface Props {
  bloques?: BloqueEditorial[];
  texto?: string;
  highlights?: string[];
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  bloques = [],
  texto = '',
  highlights = [],
  sectionColors = {},
  estilos,
} = Astro.props;

const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;

const items = resolveNosotrosBloques({ bloques, texto, highlights });
const [hero, ...rest] = items;

function shortPhrase(text: string, max = 72) {
  const clean = String(text || '').replace(/\s+/g, ' ').trim();
  if (!clean) return '';
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > 24 ? cut.slice(0, lastSpace) : cut).trim()}…`;
}

function wordMetric(text: string) {
  const words = String(text || '')
    .trim()
    .split(/\s+/)
    .filter(Boolean).length;
  return words > 0 ? String(words) : '—';
}
---

<div
  class="nosotros-bento mx-auto w-full max-w-none px-4 pb-[max(3.5rem,env(safe-area-inset-bottom))] pt-6 font-[family-name:var(--font-body,var(--fuente-principal))] sm:px-5"
>
  {
    items.length === 0 ? (
      <p class={`mx-auto max-w-prose text-center text-sm leading-relaxed ${estilos.mutedColor}`}>
        Pronto contaremos nuestra historia.
      </p>
    ) : (
      <div class="nosotros-bento__grid grid grid-cols-2 gap-3 sm:gap-3.5 md:grid-cols-6 md:auto-rows-[minmax(7.5rem,auto)]">
        {hero && (
          <article
            class="glass-panel studio-card col-span-2 flex flex-col justify-between gap-4 p-4 sm:p-5 md:col-span-4 md:row-span-2"
            data-reveal
            style="border-color:color-mix(in srgb, var(--color-primario) 28%, transparent)"
          >
            <div class="space-y-2">
              <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.28em] ${estilos.softColor}`}>
                {hero.subtitulo || 'Historia'}
              </p>
              {hero.titulo && (
                <h3
                  class={`text-[1.45rem] font-semibold leading-[1.15] tracking-[0.02em] font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[1.7rem] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                  style={titleStyle}
                  set:html={renderTitleHtml(hero.titulo, hero.tituloAcento)}
                />
              )}
            </div>

            {hero.media_url && (
              <div class="overflow-hidden rounded-2xl">
                {isVideoUrl(hero.media_url) ? (
                  <video
                    src={hero.media_url}
                    class="aspect-[16/10] w-full object-cover"
                    autoplay
                    muted
                    loop
                    playsinline
                    data-reveal-media
                  />
                ) : (
                  <img
                    src={hero.media_url}
                    alt=""
                    class="aspect-[16/10] w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    data-reveal-media
                  />
                )}
              </div>
            )}

            {hero.texto && (
              <p
                class={`text-[0.9rem] leading-[1.75] ${!bodyColor ? estilos.textColor : ''}`}
                style={bodyStyle}
                set:html={renderBodyHtml(hero.texto, hero.acentos)}
              />
            )}
          </article>
        )}

        {hero?.texto && (
          <article
            class="glass-panel studio-card col-span-1 flex flex-col justify-between p-4 md:col-span-2"
            data-reveal
            style="background:color-mix(in srgb, var(--color-primario) 16%, transparent); border-color:color-mix(in srgb, var(--color-primario) 40%, transparent)"
          >
            <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.22em] ${estilos.softColor}`}>
              Palabras
            </p>
            <p
              class={`mt-3 text-3xl font-semibold tabular-nums tracking-tight font-[family-name:var(--font-heading,var(--fuente-display))] ${!titleColor ? estilos.textColor : ''}`}
              style={titleStyle}
            >
              {wordMetric(hero.texto)}
            </p>
            <p class={`mt-2 text-[0.72rem] leading-snug ${estilos.softColor}`}>
              en nuestra historia principal
            </p>
          </article>
        )}

        {hero?.titulo && (
          <article
            class="glass-panel studio-card col-span-1 flex flex-col justify-center gap-2 p-4 md:col-span-2"
            data-reveal
          >
            <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.22em] ${estilos.softColor}`}>
              Frase
            </p>
            <p
              class={`text-[0.95rem] font-medium leading-snug font-[family-name:var(--font-heading,var(--fuente-display))] ${!titleColor ? estilos.textColor : ''}`}
              style={titleStyle}
            >
              “{shortPhrase(hero.titulo, 48)}”
            </p>
          </article>
        )}

        {rest.map((bloque, index) => {
          const titleHtml = renderTitleHtml(bloque.titulo || '', bloque.tituloAcento);
          const bodyHtml = renderBodyHtml(
            shortPhrase(bloque.texto || '', 140),
            bloque.acentos,
          );
          const wide = index % 3 === 0;
          const media = bloque.media_url?.trim() || null;
          const video = media ? isVideoUrl(media) : false;

          return (
            <article
              class:list={[
                'glass-panel studio-card flex flex-col gap-3 p-4',
                wide ? 'col-span-2 md:col-span-3' : 'col-span-1 md:col-span-2',
              ]}
              data-reveal
              style="border-color:color-mix(in srgb, var(--color-primario) 18%, transparent)"
            >
              <div class="flex items-center justify-between gap-2">
                <span class={`text-[0.55rem] font-semibold uppercase tracking-[0.2em] ${estilos.softColor}`}>
                  {String(index + 2).padStart(2, '0')}
                </span>
                {bloque.subtitulo && (
                  <span class={`truncate text-[0.55rem] uppercase tracking-[0.14em] ${estilos.softColor}`}>
                    {bloque.subtitulo}
                  </span>
                )}
              </div>

              {media && (
                <div class="overflow-hidden rounded-xl">
                  {video ? (
                    <video
                      src={media}
                      class="aspect-[4/3] w-full object-cover"
                      autoplay
                      muted
                      loop
                      playsinline
                      data-reveal-media
                    />
                  ) : (
                    <img
                      src={media}
                      alt=""
                      class="aspect-[4/3] w-full object-cover"
                      loading="lazy"
                      decoding="async"
                      data-reveal-media
                    />
                  )}
                </div>
              )}

              {bloque.titulo && (
                <h3
                  class={`text-[1.05rem] font-semibold leading-snug font-[family-name:var(--font-heading,var(--fuente-display))] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                  style={titleStyle}
                  set:html={titleHtml}
                />
              )}

              {bloque.texto && (
                <p
                  class={`text-[0.82rem] leading-[1.65] ${!bodyColor ? estilos.textColor : ''}`}
                  style={bodyStyle}
                  set:html={bodyHtml}
                />
              )}
            </article>
          );
        })}
      </div>
    )
  }
</div>

<style>
  .editorial-accent {
    color: var(--color-primario);
  }
</style>
