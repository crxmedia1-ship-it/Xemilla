---
/**
 * Nosotros Split — Eat Hungry Tiger / Bond.
 * Desktop: media fija 50% + historia scroll. Móvil: hero arriba + tarjetas apiladas (sin overflow horizontal).
 */
import {
  resolveNosotrosBloques,
  renderTitleHtml,
  renderBodyHtml,
  isVideoUrl,
  normalizeContenedorEstilo,
  contenedorCardStyle,
} from '../../../lib/nosotros-layout.js';
import NosotrosMediaStack from './NosotrosMediaStack.astro';

interface BloqueEditorial {
  subtitulo?: string;
  titulo?: string;
  tituloAcento?: string;
  caption?: string;
  imagen?: string | null;
  media_url?: string | null;
  media?: string[];
  texto?: string;
  contenido?: string;
  alineacion?: string;
  acentos?: string[];
}

interface Props {
  bloques?: BloqueEditorial[];
  texto?: string;
  highlights?: string[];
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
    contenedor_estilo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  bloques = [],
  texto = '',
  highlights = [],
  sectionColors = {},
  estilos,
} = Astro.props;

const containerBg = (sectionColors.color_fondo || '').trim();
const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;
const cardSkin = contenedorCardStyle(
  normalizeContenedorEstilo(sectionColors.contenedor_estilo),
  containerBg,
);

const items = resolveNosotrosBloques({ bloques, texto, highlights });
const heroBlock =
  items.find((b) => Array.isArray(b.media) && b.media.length > 0) || items[0];
const heroMediaList = Array.isArray(heroBlock?.media) ? heroBlock.media : [];
const heroMedia = heroMediaList[0] || null;
const heroVideo = heroMedia ? isVideoUrl(heroMedia) : false;
const lead = items[0];

function panelStyle(extra = '') {
  return [cardSkin, extra].filter(Boolean).join('; ') || undefined;
}
---

<div
  class="nosotros-split w-full font-[family-name:var(--font-body,var(--fuente-principal))] md:flex md:min-h-[min(72dvh,42rem)] md:items-stretch"
>
  {
    items.length === 0 ? (
      <p class={`mx-auto w-full max-w-prose px-5 py-10 text-center text-sm leading-relaxed ${estilos.mutedColor}`}>
        Pronto contaremos nuestra historia.
      </p>
    ) : (
      <>
        <aside class="nosotros-split__media relative w-full shrink-0 overflow-hidden md:sticky md:top-0 md:h-[min(72dvh,42rem)] md:w-1/2 md:self-start">
          {heroMediaList.length > 1 ? (
            <div class="h-[42vw] min-h-[12.5rem] max-h-[18rem] w-full md:h-full md:max-h-none">
              <NosotrosMediaStack
                media={heroMediaList}
                aspectClass="h-full w-full"
                softColor={estilos.softColor}
              />
            </div>
          ) : heroMedia ? (
            heroVideo ? (
              <video
                src={heroMedia}
                class="h-[42vw] min-h-[12.5rem] max-h-[18rem] w-full object-cover md:h-full md:max-h-none"
                autoplay
                muted
                loop
                playsinline
                data-reveal-media
              />
            ) : (
              <img
                src={heroMedia}
                alt=""
                class="h-[42vw] min-h-[12.5rem] max-h-[18rem] w-full object-cover md:h-full md:max-h-none"
                loading="lazy"
                decoding="async"
                data-reveal-media
              />
            )
          ) : (
            <div
              class="flex h-[42vw] min-h-[12.5rem] max-h-[18rem] w-full items-center justify-center md:h-full md:max-h-none"
              aria-hidden="true"
              style="background:color-mix(in srgb, var(--color-primario) 14%, transparent)"
            >
              <span class={`text-[0.55rem] uppercase tracking-[0.18em] ${estilos.softColor}`}>
                Media
              </span>
            </div>
          )}
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent md:bg-gradient-to-r md:from-transparent md:via-transparent md:to-black/40"
            aria-hidden="true"
          />
          {lead?.titulo && (
            <div class="pointer-events-none absolute inset-x-0 bottom-0 p-4 md:hidden">
              <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.24em] ${estilos.softColor}`}>
                {lead.subtitulo || 'Nuestra historia'}
              </p>
              <h3
                class={`nosotros-copy mt-1.5 line-clamp-2 break-words text-[1.25rem] font-semibold uppercase leading-tight tracking-[0.02em] font-[family-name:var(--font-heading,var(--fuente-display))] ${estilos.displayClass} ${!titleColor ? 'text-white' : ''}`}
                style={titleStyle}
                set:html={renderTitleHtml(lead.titulo, lead.tituloAcento)}
              />
            </div>
          )}
        </aside>

        <div
          class="nosotros-split__stories flex min-w-0 flex-1 flex-col gap-4 overflow-x-hidden px-4 pb-[max(3.5rem,env(safe-area-inset-bottom))] pt-5 sm:px-5 md:w-1/2 md:overflow-y-auto md:px-7 md:py-8 lg:px-9"
        >
          <header class="hidden md:block" data-reveal>
            <p class={`text-[0.55rem] font-semibold uppercase tracking-[0.28em] ${estilos.softColor}`}>
              Nuestra historia
            </p>
            {lead?.titulo && (
              <h3
                class={`nosotros-copy mt-3 break-words text-[1.75rem] font-semibold uppercase leading-[1.1] tracking-[0.03em] font-[family-name:var(--font-heading,var(--fuente-display))] lg:text-[2rem] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                style={titleStyle}
                set:html={renderTitleHtml(lead.titulo, lead.tituloAcento)}
              />
            )}
          </header>

          <div class="flex flex-col gap-3.5">
            {items.map((bloque, index) => {
              const titleHtml = renderTitleHtml(bloque.titulo || '', bloque.tituloAcento);
              const bodyHtml = renderBodyHtml(bloque.texto || '', bloque.acentos);
              const mediaList = Array.isArray(bloque.media) ? bloque.media : [];
              const isLead = index === 0;
              // El lead ya usa sus medias en el hero; en tarjeta solo extras de otros bloques
              const cardMediaList = isLead ? [] : mediaList;

              return (
                <article
                  class="glass-panel flex w-full min-w-0 flex-col gap-3 rounded-2xl p-4 sm:rounded-[1.35rem] sm:p-5"
                  data-reveal
                  style={panelStyle(
                    'border-color:color-mix(in srgb, var(--color-primario) 24%, transparent)',
                  )}
                >
                  <div class="flex items-center justify-between gap-3">
                    <span
                      class="inline-flex size-7 items-center justify-center rounded-full text-[0.62rem] font-semibold tabular-nums"
                      style="background:color-mix(in srgb, var(--color-primario) 22%, transparent); color:var(--color-primario)"
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {bloque.subtitulo && (
                      <span class={`truncate text-[0.55rem] uppercase tracking-[0.16em] ${estilos.softColor}`}>
                        {bloque.subtitulo}
                      </span>
                    )}
                  </div>

                  {cardMediaList.length > 0 && (
                    <div class="overflow-hidden rounded-xl">
                      <NosotrosMediaStack
                        media={cardMediaList}
                        aspectClass="aspect-[16/10]"
                        softColor={estilos.softColor}
                      />
                    </div>
                  )}

                  {bloque.titulo && !isLead && (
                    <h3
                      class={`nosotros-copy break-words text-[1.12rem] font-semibold leading-snug tracking-[0.02em] font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[1.2rem] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                      style={titleStyle}
                      set:html={titleHtml}
                    />
                  )}
                  {bloque.titulo && isLead && (
                    <h3
                      class={`nosotros-copy break-words text-[1.12rem] font-semibold leading-snug tracking-[0.02em] font-[family-name:var(--font-heading,var(--fuente-display))] md:hidden ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                      style={titleStyle}
                      set:html={titleHtml}
                    />
                  )}

                  {bloque.texto && (
                    <p
                      class={`nosotros-copy break-words text-[0.9rem] leading-[1.7] sm:text-[0.95rem] sm:leading-[1.75] ${!bodyColor ? estilos.textColor : ''}`}
                      style={bodyStyle}
                      set:html={bodyHtml}
                    />
                  )}
                </article>
              );
            })}
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  .editorial-accent {
    color: var(--color-primario);
  }

  .nosotros-copy {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .nosotros-split__stories {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  @media (min-width: 768px) {
    .nosotros-split__stories {
      max-height: min(72dvh, 42rem);
    }
  }
</style>
