---
/**
 * Nosotros Editorial — revista (Graza / Palmer / Clay).
 * Drop cap, tipografía fluida, media intercalada. Móvil: stack; desktop: 50/50 alternado.
 */
import {
  resolveNosotrosBloques,
  renderTitleHtml,
  renderBodyHtml,
  mediaPrimero,
  normalizeContenedorEstilo,
  contenedorCardStyle,
} from '../../../lib/nosotros-layout.js';
import NosotrosMediaStack from './NosotrosMediaStack.astro';

interface BloqueEditorial {
  subtitulo?: string;
  titulo?: string;
  tituloAcento?: string;
  caption?: string;
  imagen?: string | null;
  media_url?: string | null;
  media?: string[];
  texto?: string;
  contenido?: string;
  alineacion?: string;
  acentos?: string[];
}

interface Props {
  bloques?: BloqueEditorial[];
  texto?: string;
  highlights?: string[];
  designDnaId?: string;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
    contenedor_estilo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  bloques = [],
  texto = '',
  highlights = [],
  designDnaId = 'elegant',
  sectionColors = {},
  estilos,
} = Astro.props;

const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;
const cardStyle = contenedorCardStyle(
  normalizeContenedorEstilo(sectionColors.contenedor_estilo),
  sectionColors.color_fondo,
);

const dropCapClass =
  'editorial-body first-letter:float-left first-letter:mr-2 first-letter:mt-1 first-letter:text-5xl first-letter:font-bold first-letter:leading-none first-letter:text-[var(--color-primario)] sm:first-letter:text-6xl';

const editorial = resolveNosotrosBloques({ bloques, texto, highlights });
---

<div
  class="nosotros-editorial mx-auto w-full max-w-3xl px-4 pb-[max(3.5rem,env(safe-area-inset-bottom))] pt-5 font-[family-name:var(--font-body,var(--fuente-principal))] sm:px-6 md:max-w-5xl md:px-8 md:pt-10 lg:max-w-6xl"
>
  {
    editorial.length === 0 ? (
      <p class={`mx-auto max-w-prose text-center text-sm leading-relaxed ${estilos.mutedColor}`}>
        Pronto contaremos nuestra historia.
      </p>
    ) : (
      <div class="flex w-full flex-col gap-12 md:gap-16">
        {editorial.map((bloque, index) => {
          const mediaList = Array.isArray(bloque.media) ? bloque.media : [];
          const caption =
            bloque.caption?.trim() || String(index + 1).padStart(2, '0');
          const titleHtml = renderTitleHtml(bloque.titulo || '', bloque.tituloAcento);
          const bodyHtml = renderBodyHtml(bloque.texto || '', bloque.acentos);
          const reverse = mediaPrimero(bloque, index);
          const useDrop = index === 0 || designDnaId === 'elegant';

          return (
            <article
              class="editorial-row grid w-full grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-10 lg:gap-14"
              data-reveal
              data-editorial-block
              data-alineacion={bloque.alineacion}
            >
              {mediaList.length > 0 && (
              <div class:list={['min-w-0', reverse ? 'md:order-1' : 'md:order-2']}>
                <figure class="w-full">
                  <div class="overflow-hidden rounded-2xl sm:rounded-3xl">
                    <NosotrosMediaStack
                      media={mediaList}
                      softColor={estilos.softColor}
                    />
                  </div>
                  <figcaption
                    class={`mt-2.5 text-right text-[0.55rem] font-medium uppercase tracking-[0.2em] ${estilos.softColor}`}
                  >
                    {caption}
                  </figcaption>
                </figure>
              </div>
              )}

              <div
                class:list={[
                  'nosotros-card min-w-0 rounded-2xl p-4 sm:rounded-3xl sm:p-5',
                  reverse ? 'md:order-2' : 'md:order-1',
                  !mediaList.length && 'md:col-span-2',
                ]}
                style={cardStyle || undefined}
              >
                {bloque.subtitulo && (
                  <p
                    class={`text-[0.58rem] font-semibold uppercase tracking-[0.28em] ${estilos.softColor}`}
                  >
                    {bloque.subtitulo}
                  </p>
                )}
                {bloque.titulo && (
                  <h3
                    class={`nosotros-copy mt-3 break-words text-[1.55rem] font-semibold uppercase leading-[1.12] tracking-[0.03em] font-[family-name:var(--font-heading,var(--fuente-display))] sm:text-[1.85rem] md:text-[2.05rem] ${estilos.displayClass} ${!titleColor ? estilos.textColor : ''}`}
                    style={titleStyle}
                    set:html={titleHtml}
                  />
                )}
                {bloque.texto && (
                  <p
                    class:list={[
                      'nosotros-copy mt-5 max-w-[36rem] break-words text-[0.95rem] leading-[1.75] sm:text-[1.02rem] sm:leading-[1.8]',
                      !bodyColor ? estilos.textColor : '',
                      useDrop ? dropCapClass : '',
                    ]}
                    style={bodyStyle}
                    set:html={bodyHtml}
                  />
                )}
              </div>
            </article>
          );
        })}
      </div>
    )
  }
</div>

<style>
  .editorial-accent {
    color: var(--color-primario);
  }

  .nosotros-copy {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
