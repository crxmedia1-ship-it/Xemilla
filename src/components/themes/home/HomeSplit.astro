---
/**
 * HomeSplit — Split Architecture.
 * Mitad superior identidad · mitad inferior bloques de impacto.
 */
import { resolveSafeHomeProps } from '../../../lib/home-safe-props.js';
import { resolveHomePxSizes } from '../../../lib/secciones-ui.js';

interface Props {
  nombre?: string;
  logoText?: string;
  logoLetter?: string;
  logoUrl?: string | null;
  logo_url?: string | null;
  tagline?: string;
  eslogan?: string;
  reservasCta?: { label: string; href: string } | null;
  reservas_link?: string;
  homeUi?: Record<string, unknown>;
  restaurante?: Record<string, unknown>;
}

const props = Astro.props as Record<string, unknown>;
const r =
  props?.restaurante && typeof props.restaurante === 'object'
    ? (props.restaurante as Record<string, unknown>)
    : props;

const { nombre, logoText, logoLetter, logoUrl, tagline, reservasCta, homeUi } =
  resolveSafeHomeProps(props);

const { logoSizePx, estiloNavegacion, efectoEntrada } = resolveHomePxSizes(homeUi || props?.homeUi);

const navFrontal = estiloNavegacion === 'frontal';
const immersiveLogoOnly = estiloNavegacion === 'hamburguesa';
const navAppTabs = estiloNavegacion === 'app_tabs';
const hasEntrance =
  efectoEntrada === 'rise' ||
  efectoEntrada === 'blur' ||
  efectoEntrada === 'zoom' ||
  efectoEntrada === 'tracking';

const logoPx = logoSizePx || 140;
const brandName = String(nombre || logoText || 'Restaurante').trim();
const eslogan =
  tagline || String(props?.eslogan || r?.eslogan || '').trim() || 'Experiencia gastronómica';
const reservasLink = String(props?.reservas_link || r?.reservas_link || reservasCta?.href || '#').trim() || '#';
const reservasIsExternal = reservasLink !== '#';

type NavItem = { id: string; label: string; kind: 'section' | 'reservas' };
const navItems: NavItem[] = [
  { id: 'menu', label: '01 · EL MENÚ', kind: 'section' },
  { id: 'reservas', label: '02 · RESERVAS & PEDIDOS', kind: 'reservas' },
  { id: 'nosotros', label: '03 · NUESTRA HISTORIA', kind: 'section' },
  { id: 'ubicacion', label: '04 · CONTACTO & VISITA', kind: 'section' },
];

const blockClass =
  'split-block group flex w-full cursor-pointer items-center justify-between rounded-2xl border border-white/15 bg-zinc-950/60 p-4 text-left backdrop-blur-xl transition-all hover:bg-zinc-900/80 focus:outline-none active:scale-[0.97] active:bg-zinc-900/95';
---

<div
  class:list={[
    'home-split linktree-home relative z-10 mx-auto flex min-h-[100dvh] w-full max-w-xl select-none flex-col justify-between bg-transparent p-6 sm:p-10 font-[family-name:var(--font-body,var(--fuente-principal))]',
    navAppTabs && 'pb-24',
  ]}
  data-linktree-home
  data-home-theme="split"
  data-estilo-navegacion={estiloNavegacion}
>
  {/* Mitad superior — cabecera editorial */}
  <header
    class:list={[
      'flex flex-col items-center gap-3 pt-[max(0.5rem,env(safe-area-inset-top))] text-center',
      hasEntrance && 'home-enter home-enter--logo',
      immersiveLogoOnly && 'my-auto',
    ]}
    data-home-header
  >
    <div class="flex items-center justify-center" data-home-logo>
      {
        logoUrl ? (
          <img
            src={logoUrl}
            alt={brandName}
            class="h-[var(--home-logo-size,140px)] w-auto max-w-[85vw] object-contain drop-shadow-[0_8px_30px_rgba(0,0,0,0.85)] sm:h-[var(--home-logo-size,170px)]"
            data-home-logo
          />
        ) : (
          <span
            class="flex items-center justify-center rounded-full border border-white/20 font-medium uppercase tracking-[0.28em] text-white/90"
            style={`height: var(--home-logo-size, ${logoPx}px); width: var(--home-logo-size, ${logoPx}px); font-size: calc(var(--home-logo-size, ${logoPx}px) * 0.28);`}
            data-home-logo-fallback
            aria-hidden="true"
          >
            {logoLetter || brandName.slice(0, 1)}
          </span>
        )
      }
    </div>
    {
      !immersiveLogoOnly ? (
        <>
          <h1
            class="font-serif text-2xl font-medium uppercase tracking-[0.2em] text-white sm:text-3xl font-[family-name:var(--font-heading,var(--fuente-display))]"
            data-home-titulo
          >
            {brandName}
          </h1>
          <p
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-zinc-400 sm:text-xs"
            data-home-eslogan
          >
            {eslogan}
          </p>
        </>
      ) : null
    }
  </header>

  {/* Mitad inferior — bloques de impacto */}
  {
    navFrontal ? (
      <nav
        class:list={[
          'my-auto flex w-full flex-col gap-3 py-4',
          hasEntrance && 'home-enter home-enter--botones',
        ]}
        aria-label={`Navegación ${brandName}`}
        data-home-menu
      >
        {
          navItems.map((item) => {
            const inner = (
              <>
                <span class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-white/90 transition-colors group-hover:text-white sm:text-sm">
                  {item.label}
                </span>
                <span class="font-mono text-sm text-zinc-400 transition-all group-hover:translate-x-0.5 group-hover:text-emerald-400" aria-hidden="true">
                  ↗
                </span>
              </>
            );

            if (item.kind === 'reservas') {
              if (reservasIsExternal) {
                return (
                  <a
                    href={reservasLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-tab-trigger="reservas"
                    data-reservas-home-cta
                    class={blockClass}
                  >
                    {inner}
                  </a>
                );
              }
              return (
                <button type="button" data-tab-trigger="reservas" data-reservas-home-cta class={blockClass}>
                  {inner}
                </button>
              );
            }

            return (
              <button
                type="button"
                data-tab-trigger={item.id}
                data-open-section={item.id}
                data-open-ubicacion={item.id === 'ubicacion' ? 'true' : undefined}
                class={blockClass}
              >
                {inner}
              </button>
            );
          })
        }
      </nav>
    ) : null
  }
</div>

<style>
  .split-block {
    -webkit-tap-highlight-color: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .split-block {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
