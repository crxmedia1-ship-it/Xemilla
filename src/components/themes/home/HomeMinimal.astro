---
/**
 * Home Minimal — Stories / Mobile-First 100vh.
 * Solo estructura (logo / títulos / nav). Atmósfera vive en RestaurantApp.
 */
import { buildHomeNavSequence } from '../../../lib/layout-themes.js';
import { resolveSafeHomeProps } from '../../../lib/home-safe-props.js';
import { resolveHomePxSizes } from '../../../lib/secciones-ui.js';

interface Props {
  nombre?: string;
  logoText?: string;
  logoLetter?: string;
  logoUrl?: string | null;
  logo_url?: string | null;
  tagline?: string;
  eslogan?: string;
  menuLink?: string;
  menu_link?: string;
  estilos?: Record<string, string>;
  showWifi?: boolean;
  showDividir?: boolean;
  showLlamarMesero?: boolean;
  showBoutique?: boolean;
  wifiSsid?: string;
  wifiClave?: string;
  reservasCta?: { label: string; href: string } | null;
  homeUi?: Record<string, unknown>;
  onOpenUbicacion?: () => void;
  onOpenNosotros?: () => void;
  onOpenMenu?: () => void;
  restaurante?: Record<string, unknown>;
}

const {
  nombre,
  logoText,
  logoLetter,
  logoUrl,
  tagline,
  taglineSuperior,
  showWifi,
  showDividir,
  showLlamarMesero,
  showBoutique,
  wifiSsid,
  wifiClave,
  reservasCta,
  homeUi,
} = resolveSafeHomeProps(Astro.props as Record<string, unknown>);

const {
  logoSizePx,
  tituloSizePx,
  esloganSizePx,
  menuSizePx,
  tituloColor,
  esloganColor,
  menuColor,
  estiloNavegacion,
  efectoEntrada,
} = resolveHomePxSizes(homeUi);

const navFrontal = estiloNavegacion === 'frontal';
const immersiveLogoOnly = estiloNavegacion === 'hamburguesa';
const navAppTabs = estiloNavegacion === 'app_tabs';
const hasReveal = efectoEntrada === 'reveal';
const hasEntrance =
  efectoEntrada === 'rise' ||
  efectoEntrada === 'blur' ||
  efectoEntrada === 'zoom' ||
  efectoEntrada === 'tracking';
const animClass =
  efectoEntrada === 'rise'
    ? 'home-anim-rise'
    : efectoEntrada === 'blur'
      ? 'home-anim-blur'
      : efectoEntrada === 'zoom'
        ? 'home-anim-zoom'
        : efectoEntrada === 'tracking'
          ? 'home-anim-tracking'
          : hasReveal
            ? 'home-anim-reveal'
            : '';

/** Size/color only — public layout ignores X/Y offsets */
const logoBoxStyle = `height: var(--logo-size, var(--home-logo-size, ${logoSizePx}px)); width: var(--logo-size, var(--home-logo-size, ${logoSizePx}px));`;
const logoImgStyle = `height: var(--logo-size, var(--home-logo-size, ${logoSizePx}px)); max-width: min(100%, 18rem); width: auto; object-fit: contain;`;
const logoFallbackStyle = `font-size: calc(var(--logo-size, var(--home-logo-size, ${logoSizePx}px)) * 0.28); color: var(--titulo-color, var(--color-text, var(--color-texto)))`;
const tituloColorCss = `var(--titulo-color, ${tituloColor || 'var(--color-text, var(--color-texto))'})`;
const esloganColorCss = `var(--eslogan-color, ${esloganColor || 'var(--home-subtitulo-color, var(--color-primary, var(--color-primario)))'})`;
const menuColorCss = `var(--menu-color, ${menuColor || 'var(--color-text, var(--color-texto))'})`;
const subtextoColorCss = `var(--subtexto-color, var(--home-subtexto-color, color-mix(in srgb, var(--color-text, var(--color-texto)) 45%, transparent)))`;
const tituloStyle = `font-size: var(--titulo-size, ${tituloSizePx}px); max-width:var(--home-titulo-max-w, 20rem); color: ${tituloColorCss};`;
const esloganStyle = `font-size: var(--eslogan-size, ${esloganSizePx}px); margin-top: 0.375rem; color: ${esloganColorCss};`;
const menuTitleStyle = `font-size: var(--menu-size, var(--home-menu-size, ${menuSizePx}px)); color: ${menuColorCss}`;
const menuSubStyle = `color: ${subtextoColorCss}`;

const navSequence = buildHomeNavSequence({
  tagline,
  showWifi,
  showDividir,
  showLlamarMesero,
  showBoutique,
  wifiSsid,
  wifiClave,
  reservasCta,
  compact: true,
});

const pillClass =
  'minimal-pill group flex w-full items-center justify-between gap-3 rounded-full border px-5 py-3.5 text-left transition-transform duration-200 active:scale-[0.97]';
const pillStyle =
  'border-color:color-mix(in srgb, var(--color-text, var(--color-texto)) 18%, transparent); background:color-mix(in srgb, var(--color-text, var(--color-texto)) 6%, transparent)';
---

<div
  class:list={[
    'home-minimal linktree-home relative z-10 flex min-h-dvh w-full flex-col items-center overflow-hidden bg-transparent px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-[max(1.75rem,env(safe-area-inset-top))] font-[family-name:var(--font-body,var(--fuente-principal))] text-[color:var(--color-text,var(--color-texto))]',
    immersiveLogoOnly && 'justify-center',
    navAppTabs && 'pb-24',
    animClass,
  ]}
  data-linktree-home
  data-home-theme="minimal"
  data-estilo-navegacion={estiloNavegacion}
  data-efecto-entrada={efectoEntrada}
>
  <header class="flex w-full shrink-0 flex-col items-center justify-center gap-3 text-center" data-home-header>
    <div class:list={[hasEntrance && 'home-enter home-enter--logo']}>
      <div
        class="flex items-center justify-center overflow-hidden rounded-full"
        style={`border:1px solid color-mix(in srgb, var(--color-text, var(--color-texto)) 16%, transparent); ${logoBoxStyle}`}
        data-home-logo
        aria-hidden="true"
      >
        {
          logoUrl ? (
            <img
              src={logoUrl}
              alt=""
              class="max-w-full object-contain p-1"
              data-home-logo
              style={logoImgStyle}
            />
          ) : (
            <span
              class="font-semibold tracking-widest"
              style={logoFallbackStyle}
              data-home-logo-fallback
            >
              {logoLetter}
            </span>
          )
        }
      </div>
    </div>
    {
      !immersiveLogoOnly ? (
        <div class="flex w-full flex-col items-center justify-center gap-1">
          <div
            class:list={[
              'mt-1 flex w-full items-center justify-center',
              hasEntrance && 'home-enter home-enter--titulo',
              hasReveal && 'overflow-hidden',
            ]}
          >
            <h1
              class:list={[
                'truncate font-semibold uppercase tracking-[0.24em] font-[family-name:var(--font-heading,var(--fuente-display))]',
                hasReveal && 'home-reveal-inner home-reveal--titulo',
              ]}
              data-home-titulo
              style={tituloStyle}
            >
              {logoText}
            </h1>
          </div>
          {
            taglineSuperior ? (
              <p
                class="line-clamp-1 text-[0.62rem] uppercase tracking-[0.28em] opacity-70"
                style={esloganStyle}
                data-home-tagline-superior
              >
                {taglineSuperior}
              </p>
            ) : null
          }
          {
            tagline ? (
              <div
                class:list={[
                  'flex w-full items-center justify-center',
                  hasEntrance && 'home-enter home-enter--eslogan',
                  hasReveal && 'overflow-hidden',
                ]}
              >
                <p
                  class:list={[
                    'line-clamp-1 uppercase tracking-[0.16em]',
                    hasReveal && 'home-reveal-inner home-reveal--eslogan',
                  ]}
                  style={esloganStyle}
                  data-home-eslogan
                >
                  {tagline}
                </p>
              </div>
            ) : null
          }
        </div>
      ) : null
    }
  </header>

  {
    navFrontal ? (
  <nav
    class:list={[
      'mt-6 flex min-h-0 w-full flex-1 flex-col items-center justify-center gap-2.5 overflow-y-auto overscroll-contain',
      hasEntrance && 'home-enter home-enter--botones',
    ]}
    aria-label={`Navegación ${nombre}`}
    data-home-menu
  >
    {
      navSequence.map((item) => {
        const arrow = (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            class="size-4 shrink-0 opacity-45 transition group-hover:translate-x-0.5 group-hover:opacity-80"
            aria-hidden="true"
            style="color:var(--color-text, var(--color-texto))"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        );

        if (item.kind === 'reservas' && item.href) {
          return (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              data-reservas-home-cta
              class={pillClass}
              style={pillStyle}
            >
              <span
                class="font-semibold uppercase tracking-[0.18em]"
                style={menuTitleStyle}
              >
                {item.label}
              </span>
              {arrow}
            </a>
          );
        }

        if (item.kind === 'boutique') {
          return (
            <button type="button" data-open-boutique class={pillClass} style={pillStyle}>
              <span
                class="font-semibold uppercase tracking-[0.18em]"
                style={menuTitleStyle}
              >
                {item.label}
              </span>
              {arrow}
            </button>
          );
        }

        return (
          <button
            type="button"
            data-open-section={item.id}
            data-open-ubicacion={item.id === 'ubicacion' ? 'true' : undefined}
            data-requires-mesa={item.requiresMesa ? 'true' : undefined}
            aria-disabled={item.requiresMesa ? 'true' : undefined}
            class:list={[
              pillClass,
              item.requiresMesa && 'carrd-nav-link--mesa-gated is-mesa-locked',
            ]}
            style={pillStyle}
          >
            <span class="min-w-0 flex-1 text-left">
              <span
                class="block font-semibold uppercase tracking-[0.18em]"
                style={menuTitleStyle}
                data-carrd-subtitle
              >
                {item.label}
              </span>
              {item.requiresMesa ? (
                <span
                  class="carrd-mesa-lock mt-1 block text-[8px] uppercase tracking-[0.12em]"
                  style={menuSubStyle}
                  data-mesa-lock-hint
                  hidden
                >
                  Requiere QR de mesa
                </span>
              ) : null}
            </span>
            {arrow}
          </button>
        );
      })
    }
  </nav>
    ) : null
  }
</div>

<style>
  .minimal-pill {
    -webkit-tap-highlight-color: transparent;
  }

  .carrd-nav-link--mesa-gated.is-mesa-locked {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
    transform: none !important;
  }

  .carrd-nav-link--mesa-gated.is-mesa-locked [data-carrd-subtitle] {
    display: none;
  }

  .carrd-nav-link--mesa-gated.is-mesa-locked [data-mesa-lock-hint] {
    display: block !important;
  }

  .carrd-nav-link--mesa-gated:not(.is-mesa-locked) [data-mesa-lock-hint] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .minimal-pill {
      transition: none !important;
    }
  }
</style>
