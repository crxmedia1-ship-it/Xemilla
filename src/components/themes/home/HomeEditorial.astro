---
/**
 * HomeEditorial — Grand Editorial (ultra-lujo).
 * Tipografía pura Michelin/Monocle. Cero subtextos, cero cajas en nav.
 */
import { resolveSafeHomeProps } from '../../../lib/home-safe-props.js';
import { resolveHomePxSizes } from '../../../lib/secciones-ui.js';

interface Props {
  nombre?: string;
  logoText?: string;
  logoLetter?: string;
  logoUrl?: string | null;
  logo_url?: string | null;
  tagline?: string;
  eslogan?: string;
  taglineSuperior?: string;
  tagline_superior?: string;
  estilos?: Record<string, string>;
  reservasCta?: {
    label: string;
    href: string;
    subtitulo?: string;
    activo?: boolean;
  } | null;
  showReservas?: boolean;
  reservas_activo?: boolean;
  reservas_texto?: string;
  reservas_link?: string;
  homeUi?: Record<string, unknown>;
  restaurante?: Record<string, unknown>;
}

const props = Astro.props as Record<string, unknown>;
const r =
  props?.restaurante && typeof props.restaurante === 'object'
    ? (props.restaurante as Record<string, unknown>)
    : props;

const {
  nombre,
  logoText,
  logoLetter,
  logoUrl,
  tagline,
  reservasCta,
  homeUi,
} = resolveSafeHomeProps(props);

const {
  logoSizePx,
  estiloNavegacion,
  overlayEstilo,
  efectoEntrada,
} = resolveHomePxSizes(homeUi || props?.homeUi);

const navFrontal = estiloNavegacion === 'frontal';
const immersiveLogoOnly = estiloNavegacion === 'hamburguesa';
const navAppTabs = estiloNavegacion === 'app_tabs';
const textShadowPuro = overlayEstilo === 'puro';

const animRise = efectoEntrada === 'rise';
const animBlur = efectoEntrada === 'blur';
const animReveal = efectoEntrada === 'reveal';
const animZoom = efectoEntrada === 'zoom';
const animTracking = efectoEntrada === 'tracking';
const hasEntrance = animRise || animBlur || animZoom || animTracking;

const logoPx = logoSizePx || 130;
const logoFallbackStyle = `max-height: var(--home-logo-size, ${logoPx}px); height: var(--home-logo-size, ${logoPx}px); width: var(--home-logo-size, ${logoPx}px); font-size: calc(var(--home-logo-size, ${logoPx}px) * 0.28);`;

const eslogan = tagline || String(props?.eslogan || r?.eslogan || '').trim();
const taglineDisplay = (tagline || eslogan || 'EXPERIENCIA GASTRONÓMICA').toUpperCase();

const reservasLink = String(props?.reservas_link || r?.reservas_link || reservasCta?.href || '#').trim() || '#';
const reservasIsExternal = reservasLink !== '#';

type NavItem = {
  id: string;
  label: string;
  kind: 'section' | 'reservas';
};

/** Labels cortos y simétricos — no wrap en 360–390px */
const navItems: NavItem[] = [
  { id: 'menu', label: 'EL MENÚ', kind: 'section' },
  { id: 'reservas', label: 'RESERVAS & PEDIDOS', kind: 'reservas' },
  { id: 'nosotros', label: 'NOSOTROS', kind: 'section' },
  { id: 'ubicacion', label: 'CONTACTO & VISITA', kind: 'section' },
];

const linkClass =
  'editorial-link group relative flex w-full max-w-xs cursor-pointer select-none flex-col items-center justify-center px-4 py-2.5 transition-transform duration-300 active:scale-[0.97] focus:outline-none sm:max-w-md sm:py-3.5 md:hover:scale-105';
---

<div
  class:list={[
    'home-editorial linktree-home relative z-10 flex min-h-[100dvh] w-full select-none flex-col items-center justify-between bg-transparent px-6 py-10 sm:py-14 md:py-16 font-[family-name:var(--font-body,var(--fuente-principal))]',
    textShadowPuro && 'home-editorial--overlay-puro',
    animRise && 'home-anim-rise',
    animBlur && 'home-anim-blur',
    animReveal && 'home-anim-reveal',
    animZoom && 'home-anim-zoom',
    animTracking && 'home-anim-tracking',
    navAppTabs && 'pb-24',
  ]}
  data-linktree-home
  data-home-theme="editorial"
  data-estilo-navegacion={estiloNavegacion}
  data-nav-mode={estiloNavegacion}
  data-overlay-estilo={overlayEstilo}
  data-efecto-entrada={efectoEntrada}
>
  {/* ── Branding ── */}
  <header
    class:list={[
      'mx-auto flex max-w-xl flex-col items-center gap-3 text-center',
      hasEntrance && 'home-enter home-enter--logo',
      immersiveLogoOnly && 'my-auto',
    ]}
    data-home-header
  >
    <div class="flex items-center justify-center" data-home-logo>
      {
        logoUrl ? (
          <img
            src={logoUrl}
            alt={nombre || 'Logo'}
            class="max-h-[var(--home-logo-size,130px)] h-[var(--home-logo-size,130px)] w-auto max-w-[85vw] object-contain drop-shadow-[0_4px_20px_rgba(255,255,255,0.08)] sm:h-[var(--home-logo-size,170px)] sm:max-h-[var(--home-logo-size,170px)] md:h-[var(--home-logo-size,200px)] md:max-h-[var(--home-logo-size,200px)]"
            data-home-logo
          />
        ) : (
          <span
            class="flex items-center justify-center font-medium uppercase tracking-[0.28em] text-white/90"
            data-home-logo-fallback
            style={logoFallbackStyle}
            aria-hidden="true"
          >
            {logoLetter || (logoText || nombre || '?').slice(0, 1)}
          </span>
        )
      }
    </div>

    {
      !immersiveLogoOnly ? (
        <p
          class:list={[
            'font-mono text-[10px] uppercase tracking-[0.3em] text-white/60 min-[390px]:text-xs',
            hasEntrance && 'home-enter home-enter--eslogan',
          ]}
          data-home-eslogan
          data-home-tagline-superior
        >
          {taglineDisplay}
        </p>
      ) : null
    }
  </header>

  {/* ── Navegación Editorial Pura (solo frontal) ── */}
  {
    navFrontal ? (
      <nav
        class:list={[
          'mx-auto my-auto flex w-full max-w-xl flex-col items-center justify-center space-y-4 py-2 sm:space-y-6 sm:py-4 md:space-y-8',
          hasEntrance && 'home-enter home-enter--botones',
        ]}
        aria-label={`Navegación ${nombre || 'restaurante'}`}
        data-editorial-nav
        data-home-menu
        data-home-block="nav"
      >
        {
          navItems.map((item) => {
            const inner = (
              <>
                <span class="editorial-title whitespace-nowrap text-center font-serif text-base uppercase leading-none tracking-[0.24em] text-white/85 drop-shadow-sm transition-all duration-300 group-hover:text-white min-[390px]:text-lg min-[390px]:tracking-[0.28em] sm:text-2xl sm:tracking-[0.35em] md:text-3xl lg:text-4xl">
                  {item.label}
                </span>
                <span
                  class="editorial-rule mt-2.5 h-px w-6 bg-white/20 transition-all duration-300 ease-out group-hover:w-16 group-hover:bg-emerald-400 sm:mt-3.5"
                  aria-hidden="true"
                />
              </>
            );

            if (item.kind === 'reservas') {
              if (reservasIsExternal) {
                return (
                  <a
                    href={reservasLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-tab-trigger="reservas"
                    data-reservas-home-cta
                    class={linkClass}
                  >
                    {inner}
                  </a>
                );
              }
              return (
                <button type="button" data-tab-trigger="reservas" data-reservas-home-cta class={linkClass}>
                  {inner}
                </button>
              );
            }

            return (
              <button
                type="button"
                data-tab-trigger={item.id}
                data-open-section={item.id}
                data-open-ubicacion={item.id === 'ubicacion' ? 'true' : undefined}
                class={linkClass}
              >
                {inner}
              </button>
            );
          })
        }
      </nav>
    ) : null
  }

  {/* ── Estado en vivo ── */}
  {
    !immersiveLogoOnly ? (
      <footer class="flex shrink-0 flex-col items-center pt-2">
        <div class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-black/40 px-4 py-2 font-mono text-xs tracking-widest text-emerald-400 shadow-2xl backdrop-blur-xl">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400" aria-hidden="true" />
          <span>ABIERTO HOY</span>
        </div>
      </footer>
    ) : null
  }
</div>

<style>
  .editorial-link {
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    border: none;
  }

  /* Hover desktop: glow tipográfico */
  @media (hover: hover) and (pointer: fine) {
    .editorial-link:hover .editorial-title {
      text-shadow:
        0 0 24px rgba(255, 255, 255, 0.28),
        0 2px 12px rgba(0, 0, 0, 0.35);
    }
  }

  /* Feedback táctil: brillo inmediato en título + línea (equiv. group-active) */
  .editorial-link:active .editorial-title {
    color: #fff;
  }
  .editorial-link:active .editorial-rule {
    width: 4rem;
    background-color: #34d399;
  }

  .home-editorial--overlay-puro img[data-home-logo] {
    filter: drop-shadow(0 6px 28px rgba(0, 0, 0, 0.55)) drop-shadow(0 1px 4px rgba(0, 0, 0, 0.4));
  }
  .home-editorial--overlay-puro [data-home-eslogan],
  .home-editorial--overlay-puro .editorial-title {
    text-shadow:
      0 2px 20px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-link,
    .editorial-link span {
      transition: none !important;
      transform: none !important;
    }
    footer .animate-pulse {
      animation: none !important;
    }
  }
</style>
