---
/**
 * HomeEditorial — Grand Editorial (ultra-lujo).
 * Nav frontal: cilindro vertical tipo slot (scroll-snap + scale al centro).
 */
import { resolveSafeHomeProps } from '../../../lib/home-safe-props.js';
import { resolveHomePxSizes } from '../../../lib/secciones-ui.js';

interface Props {
  nombre?: string;
  logoText?: string;
  logoLetter?: string;
  logoUrl?: string | null;
  logo_url?: string | null;
  tagline?: string;
  eslogan?: string;
  taglineSuperior?: string;
  tagline_superior?: string;
  estilos?: Record<string, string>;
  reservasCta?: {
    label: string;
    href: string;
    subtitulo?: string;
    activo?: boolean;
  } | null;
  showReservas?: boolean;
  reservas_activo?: boolean;
  reservas_texto?: string;
  reservas_link?: string;
  homeUi?: Record<string, unknown>;
  restaurante?: Record<string, unknown>;
}

const props = Astro.props as Record<string, unknown>;
const r =
  props?.restaurante && typeof props.restaurante === 'object'
    ? (props.restaurante as Record<string, unknown>)
    : props;

const {
  nombre,
  logoText,
  logoLetter,
  logoUrl,
  tagline,
  taglineSuperior,
  reservasCta,
  homeUi,
} = resolveSafeHomeProps(props);

const {
  logoSizePx,
  estiloNavegacion,
  overlayEstilo,
  efectoEntrada,
} = resolveHomePxSizes(homeUi || props?.homeUi);

const navFrontal = estiloNavegacion === 'frontal';
const immersiveLogoOnly = estiloNavegacion === 'hamburguesa';
const navAppTabs = estiloNavegacion === 'app_tabs';
const textShadowPuro = overlayEstilo === 'puro';

const animRise = efectoEntrada === 'rise';
const animBlur = efectoEntrada === 'blur';
const animReveal = efectoEntrada === 'reveal';
const animZoom = efectoEntrada === 'zoom';
const animTracking = efectoEntrada === 'tracking';
const hasEntrance = animRise || animBlur || animZoom || animTracking;

const logoPx = logoSizePx || 130;
const logoFallbackStyle = `max-height: var(--home-logo-size, ${logoPx}px); height: var(--home-logo-size, ${logoPx}px); width: var(--home-logo-size, ${logoPx}px); font-size: calc(var(--home-logo-size, ${logoPx}px) * 0.28);`;

const eslogan = tagline || String(props?.eslogan || r?.eslogan || '').trim();
const taglineDisplay = (tagline || eslogan || 'EXPERIENCIA GASTRONÓMICA').toUpperCase();

const menuSubtitle = String(
  props?.menu_subtitle ||
    props?.menuSubtitle ||
    r?.menu_subtitle ||
    taglineSuperior ||
    props?.taglineSuperior ||
    props?.tagline_superior ||
    'CARTA DE AUTOR',
)
  .trim()
  .toUpperCase() || 'CARTA DE AUTOR';

const subtituloReservas = String(
  props?.reservas_subtitulo ||
    r?.reservas_subtitulo ||
    reservasCta?.subtitulo ||
    'EXPERIENCIA PREMIUM',
)
  .trim()
  .toUpperCase() || 'EXPERIENCIA PREMIUM';

const reservasLink = String(props?.reservas_link || r?.reservas_link || reservasCta?.href || '#').trim() || '#';
const reservasIsExternal = reservasLink !== '#';

type NavItem = {
  id: string;
  label: string;
  subtitle: string;
  kind: 'section' | 'reservas';
};

const navItems: NavItem[] = [
  { id: 'menu', label: 'MENÚ', subtitle: menuSubtitle, kind: 'section' },
  {
    id: 'reservas',
    label: 'RESERVAS & PEDIDOS',
    subtitle: subtituloReservas,
    kind: 'reservas',
  },
  {
    id: 'nosotros',
    label: 'NOSOTROS',
    subtitle: 'NUESTRA FILOSOFÍA',
    kind: 'section',
  },
  {
    id: 'ubicacion',
    label: 'CONTACTO & VISITA',
    subtitle: 'MAPA · CONTACTO · REDES',
    kind: 'section',
  },
];

const linkClass =
  'editorial-link relative flex h-full w-full cursor-pointer select-none flex-col items-center justify-center px-3 focus:outline-none sm:px-4';
---

<div
  class:list={[
    'home-editorial linktree-home relative z-10 flex h-[100svh] max-h-[100svh] min-h-0 w-full select-none flex-col items-center overflow-hidden bg-transparent px-5 pt-[max(1rem,env(safe-area-inset-top))] pb-[max(1rem,env(safe-area-inset-bottom))] font-[family-name:var(--font-body,var(--fuente-principal))] md:h-auto md:max-h-none md:min-h-[100dvh] md:overflow-visible md:px-6 md:py-16',
    textShadowPuro && 'home-editorial--overlay-puro',
    animRise && 'home-anim-rise',
    animBlur && 'home-anim-blur',
    animReveal && 'home-anim-reveal',
    animZoom && 'home-anim-zoom',
    animTracking && 'home-anim-tracking',
    navAppTabs && 'pb-24',
  ]}
  data-linktree-home
  data-home-theme="editorial"
  data-estilo-navegacion={estiloNavegacion}
  data-nav-mode={estiloNavegacion}
  data-overlay-estilo={overlayEstilo}
  data-efecto-entrada={efectoEntrada}
>
  {/* ── Branding ── */}
  <header
    class:list={[
      'home-editorial__brand mx-auto flex w-full max-w-xl shrink-0 flex-col items-center gap-2 text-center md:gap-3',
      hasEntrance && 'home-enter home-enter--logo',
      immersiveLogoOnly && 'my-auto',
    ]}
    data-home-header
  >
    <div class="flex items-center justify-center" data-home-logo>
      {
        logoUrl ? (
          <img
            src={logoUrl}
            alt={nombre || 'Logo'}
            class="home-editorial__logo-img h-[min(var(--home-logo-size,145px),16svh)] max-h-[16svh] w-auto max-w-[72vw] object-contain md:h-[var(--home-logo-size,210px)] md:max-h-[var(--home-logo-size,210px)] md:max-w-[88vw]"
            data-home-logo
          />
        ) : (
          <span
            class="flex items-center justify-center font-medium uppercase tracking-[0.28em] text-white"
            data-home-logo-fallback
            style={logoFallbackStyle}
            aria-hidden="true"
          >
            {logoLetter || (logoText || nombre || '?').slice(0, 1)}
          </span>
        )
      }
    </div>

    {
      !immersiveLogoOnly ? (
        <p
          class:list={[
            'home-editorial__tagline font-mono text-[10px] uppercase leading-relaxed tracking-[0.24em] text-white/80 min-[390px]:text-xs md:tracking-[0.32em]',
            hasEntrance && 'home-enter home-enter--eslogan',
          ]}
          data-home-eslogan
          data-home-tagline-superior
        >
          {taglineDisplay}
        </p>
      ) : null
    }
  </header>

  {/* ── Cilindro vertical (slot) — flota sobre el video, sin caja ── */}
  {
    navFrontal ? (
      <nav
        class:list={[
          'editorial-reel relative mx-auto w-full max-w-xl',
          hasEntrance && 'home-enter home-enter--botones',
        ]}
        aria-label={`Navegación ${nombre || 'restaurante'}`}
        data-editorial-nav
        data-editorial-reel
        data-home-menu
        data-home-block="nav"
      >
        <div class="editorial-reel__viewport" data-editorial-reel-viewport>
          <div class="editorial-reel__spacer" aria-hidden="true" />
          {
            navItems.map((item, index) => {
              const inner = (
                <>
                  <span class="editorial-title text-center font-serif uppercase leading-none tracking-[0.14em]">
                    {item.label}
                  </span>
                  <span class="editorial-subtitle mt-2 block text-center font-light uppercase">
                    {item.subtitle}
                  </span>
                  <span class="editorial-rule" aria-hidden="true" />
                </>
              );

              const slideAttrs = {
                class: 'editorial-reel__slide',
                'data-editorial-slide': '',
                'data-slide-index': String(index),
                style: '--reel-scale: 0.78; --reel-opacity: 0.4; --reel-blur: 1.5px;',
              };

              if (item.kind === 'reservas') {
                if (reservasIsExternal) {
                  return (
                    <div {...slideAttrs}>
                      <a
                        href={reservasLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-tab-trigger="reservas"
                        data-reservas-home-cta
                        data-editorial-pick
                        class={linkClass}
                      >
                        {inner}
                      </a>
                    </div>
                  );
                }
                return (
                  <div {...slideAttrs}>
                    <button
                      type="button"
                      data-tab-trigger="reservas"
                      data-reservas-home-cta
                      data-editorial-pick
                      class={linkClass}
                    >
                      {inner}
                    </button>
                  </div>
                );
              }

              return (
                <div {...slideAttrs}>
                  <button
                    type="button"
                    data-tab-trigger={item.id}
                    data-open-section={item.id}
                    data-open-ubicacion={item.id === 'ubicacion' ? 'true' : undefined}
                    data-editorial-pick
                    class={linkClass}
                  >
                    {inner}
                  </button>
                </div>
              );
            })
          }
          <div class="editorial-reel__spacer" aria-hidden="true" />
        </div>
      </nav>
    ) : null
  }

  {/* ── Estado en vivo ── */}
  {
    !immersiveLogoOnly ? (
      <footer class="home-editorial__foot flex shrink-0 flex-col items-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.06] px-3.5 py-1.5 font-mono text-[0.65rem] tracking-[0.18em] text-emerald-300/95 backdrop-blur-md md:px-4 md:py-2 md:text-xs md:tracking-widest">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" aria-hidden="true" />
          <span>ABIERTO HOY</span>
        </div>
      </footer>
    ) : null
  }
</div>

<script>
  function initEditorialReel(root = document) {
    root.querySelectorAll('[data-editorial-reel]').forEach((nav) => {
      if (nav instanceof HTMLElement) delete nav.dataset.reelReady;
    });
    const reels = root.querySelectorAll('[data-editorial-reel]');
    reels.forEach((nav) => {
      if (!(nav instanceof HTMLElement)) return;
      if (nav.dataset.reelReady === '1') return;
      const viewport = nav.querySelector('[data-editorial-reel-viewport]');
      if (!(viewport instanceof HTMLElement)) return;
      nav.dataset.reelReady = '1';

      const slides = () =>
        Array.from(viewport.querySelectorAll('[data-editorial-slide]')).filter(
          (el) => el instanceof HTMLElement,
        );

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let ticking = false;
      let activeIndex = -1;

      const updateCylinder = () => {
        ticking = false;
        const list = slides();
        if (!list.length) return;
        const rect = viewport.getBoundingClientRect();
        const centerY = rect.top + rect.height / 2;
        const half = Math.max(rect.height / 2, 1);
        let best = 0;
        let bestDist = Infinity;

        list.forEach((slide, i) => {
          const sRect = slide.getBoundingClientRect();
          const mid = sRect.top + sRect.height / 2;
          const dist = mid - centerY;
          const t = Math.min(1, Math.abs(dist) / half);
          // Curva tipo cara del cilindro: centro grande, bordes chicos
          const scale = reduceMotion ? 1 - t * 0.22 : 1 - t * 0.42;
          const opacity = reduceMotion ? 1 - t * 0.4 : 1 - t * 0.72;
          const blur = reduceMotion ? 0 : t * 3.2;
          slide.style.setProperty('--reel-scale', String(Math.max(0.58, scale)));
          slide.style.setProperty('--reel-opacity', String(Math.max(0.22, opacity)));
          slide.style.setProperty('--reel-blur', `${blur.toFixed(2)}px`);
          if (Math.abs(dist) < bestDist) {
            bestDist = Math.abs(dist);
            best = i;
          }
        });

        list.forEach((slide, i) => {
          const on = i === best;
          slide.toggleAttribute('data-active', on);
          const pick = slide.querySelector('[data-editorial-pick]');
          if (pick instanceof HTMLElement) {
            if (on) pick.setAttribute('aria-current', 'true');
            else pick.removeAttribute('aria-current');
          }
        });
        activeIndex = best;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateCylinder);
      };

      viewport.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      // Primer tap centra; si ya está activo, deja pasar el open nativo
      viewport.addEventListener(
        'click',
        (event) => {
          const pick =
            event.target instanceof Element ? event.target.closest('[data-editorial-pick]') : null;
          if (!(pick instanceof HTMLElement)) return;
          const slide = pick.closest('[data-editorial-slide]');
          if (!(slide instanceof HTMLElement)) return;
          if (slide.hasAttribute('data-active')) return;
          event.preventDefault();
          event.stopPropagation();
          slide.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
          requestAnimationFrame(updateCylinder);
        },
        true,
      );

      const syncPad = () => {
        // Spacers CSS se encargan del centrado; solo refrescar cilindro
      };

      syncPad();
      updateCylinder();
      requestAnimationFrame(() => {
        syncPad();
        const first = slides()[0];
        if (first instanceof HTMLElement) {
          first.scrollIntoView({ block: 'center', behavior: 'auto' });
        }
        requestAnimationFrame(updateCylinder);
      });
    });
  }

  initEditorialReel();
  document.addEventListener('astro:page-load', () => initEditorialReel());
</script>

<style is:global>
  /* Teléfono: home a pantalla completa, sin scroll de página; video se ve de borde a borde */
  @media (max-width: 767px) {
    html:has(.home-editorial),
    body:has(.home-editorial) {
      height: 100svh;
      max-height: 100svh;
      overflow: hidden;
      overscroll-behavior: none;
      background: transparent;
    }

    html:has([data-fondo-home-tipo='video'] .home-editorial),
    body:has([data-fondo-home-tipo='video'] .home-editorial) {
      background: #000;
    }

    .restaurant-app:has(.home-editorial),
    [data-home-shell]:has(.home-editorial) {
      height: 100svh;
      max-height: 100svh;
      min-height: 0;
      overflow: hidden;
      background: transparent !important;
    }

    [data-home-shell]:has(.home-editorial) > .relative {
      height: 100svh;
      max-height: 100svh;
      min-height: 0;
      overflow: hidden;
      background: transparent !important;
    }
  }
</style>

<style>
  .editorial-link {
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    border: none;
  }

  /* Distribución vertical móvil: marca arriba, cilindro al centro, estado abajo */
  @media (max-width: 767px) {
    .home-editorial {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      align-items: center;
      justify-items: center;
      row-gap: 0.35rem;
      background: transparent !important;
    }

    .home-editorial__brand {
      padding-top: 0.35rem;
    }

    .home-editorial__foot {
      padding-bottom: 0.25rem;
    }

    .editorial-reel {
      align-self: stretch;
      width: 100%;
      height: 100%;
      max-height: none;
      min-height: 0;
      background: transparent;
    }
  }

  @media (min-width: 768px) {
    .home-editorial {
      justify-content: space-between;
      gap: 1.5rem;
    }

    .editorial-reel {
      height: min(44vh, 24rem);
      max-height: 44vh;
      flex: 1 1 auto;
    }
  }

  .editorial-reel__viewport {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    background: transparent;
    /* Fade suave solo en tipografía, sin capa negra encima del video */
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  .editorial-reel__viewport::-webkit-scrollbar {
    display: none;
  }

  .editorial-reel__spacer {
    flex-shrink: 0;
    height: calc(50% - 3.85rem);
    min-height: 3.25rem;
    pointer-events: none;
  }

  .editorial-reel__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 7.7rem;
    flex-shrink: 0;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    transform: scale(var(--reel-scale, 0.72));
    opacity: var(--reel-opacity, 0.35);
    filter: blur(var(--reel-blur, 2px));
    transition:
      transform 0.1s linear,
      opacity 0.1s linear,
      filter 0.1s linear;
    will-change: transform, opacity, filter;
    background: transparent;
  }

  .editorial-reel__slide[data-active] {
    z-index: 2;
  }

  .editorial-title {
    font-size: clamp(1.65rem, 7.6vw, 2.5rem);
    letter-spacing: 0.15em;
    font-weight: 500;
    color: #fff;
    transition: color 0.2s ease, text-shadow 0.2s ease;
    max-width: 92vw;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.95),
      0 4px 16px rgba(0, 0, 0, 0.7),
      0 0 28px rgba(0, 0, 0, 0.45);
  }

  .editorial-subtitle {
    font-size: clamp(0.6rem, 2.7vw, 0.74rem);
    letter-spacing: 0.2em;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.78);
    opacity: 0.85;
    max-width: min(18rem, 88vw);
    transition: opacity 0.2s ease, color 0.2s ease;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.75);
  }

  @media (min-width: 768px) {
    .editorial-reel__slide {
      height: 8.5rem;
    }
    .editorial-title {
      font-size: clamp(2.45rem, 4.4vw, 3.75rem);
      letter-spacing: 0.22em;
    }
    .editorial-subtitle {
      font-size: 0.8rem;
      letter-spacing: 0.26em;
      margin-top: 0.65rem;
    }
  }

  .editorial-reel__slide[data-active] .editorial-title {
    color: #fff;
    text-shadow:
      0 0 32px rgba(255, 255, 255, 0.35),
      0 2px 4px rgba(0, 0, 0, 0.9),
      0 8px 28px rgba(0, 0, 0, 0.75);
  }

  .editorial-reel__slide[data-active] .editorial-subtitle {
    opacity: 1;
    color: color-mix(
      in srgb,
      var(--home-subtexto-color, var(--color-primario, #c9a84c)) 55%,
      #fff 45%
    );
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.7);
  }

  .editorial-rule {
    margin-top: 0.65rem;
    height: 2px;
    width: 1.1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.45);
    transition:
      width 0.28s ease,
      background-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .editorial-reel__slide[data-active] .editorial-rule {
    width: 4.25rem;
    height: 2px;
    background: #34d399;
    box-shadow:
      0 0 12px rgba(52, 211, 153, 0.75),
      0 0 24px rgba(52, 211, 153, 0.35);
  }

  /* Logo + tagline: más presencia sobre video oscuro */
  .home-editorial__logo-img {
    filter:
      drop-shadow(0 2px 4px rgba(0, 0, 0, 0.9))
      drop-shadow(0 10px 28px rgba(0, 0, 0, 0.75))
      drop-shadow(0 0 40px rgba(255, 255, 255, 0.12));
  }

  .home-editorial__tagline {
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.95),
      0 4px 14px rgba(0, 0, 0, 0.7);
  }

  [data-home-logo-fallback] {
    text-shadow:
      0 2px 8px rgba(0, 0, 0, 0.85),
      0 0 24px rgba(255, 255, 255, 0.15);
  }

  .editorial-link:active .editorial-title {
    color: #fff;
  }

  .home-editorial--overlay-puro img[data-home-logo] {
    filter: drop-shadow(0 6px 28px rgba(0, 0, 0, 0.55)) drop-shadow(0 1px 4px rgba(0, 0, 0, 0.4));
  }
  .home-editorial--overlay-puro [data-home-eslogan],
  .home-editorial--overlay-puro .editorial-title {
    text-shadow:
      0 2px 20px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.45);
  }

  :global([data-fondo-home-tipo='video']) .home-editorial img[data-home-logo],
  :global([data-fondo-home-tipo='video']) .home-editorial .home-editorial__logo-img {
    filter:
      drop-shadow(0 2px 6px rgba(0, 0, 0, 0.95))
      drop-shadow(0 12px 36px rgba(0, 0, 0, 0.8))
      drop-shadow(0 0 48px rgba(255, 255, 255, 0.14));
  }

  :global([data-fondo-home-tipo='video']) .home-editorial [data-home-eslogan],
  :global([data-fondo-home-tipo='video']) .home-editorial [data-home-tagline-superior],
  :global([data-fondo-home-tipo='video']) .home-editorial .home-editorial__tagline {
    color: rgba(255, 255, 255, 0.9);
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.95),
      0 4px 18px rgba(0, 0, 0, 0.75),
      0 0 32px rgba(0, 0, 0, 0.5);
  }

  :global([data-fondo-home-tipo='video']) .home-editorial .editorial-title {
    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.95),
      0 8px 28px rgba(0, 0, 0, 0.8),
      0 0 42px rgba(0, 0, 0, 0.55);
  }

  :global([data-fondo-home-tipo='video']) .home-editorial .editorial-subtitle {
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 4px 14px rgba(0, 0, 0, 0.7);
  }

  :global([data-fondo-home-tipo='video']) .home-editorial .editorial-rule {
    box-shadow: 0 0 14px rgba(0, 0, 0, 0.6);
  }

  :global([data-fondo-home-tipo='video'])
    .home-editorial
    .editorial-reel__slide[data-active]
    .editorial-rule {
    box-shadow:
      0 0 14px rgba(52, 211, 153, 0.85),
      0 0 28px rgba(52, 211, 153, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-reel__slide {
      transition: none !important;
      filter: none !important;
    }
    .editorial-reel__viewport {
      scroll-behavior: auto;
    }
    footer .animate-pulse {
      animation: none !important;
    }
  }
</style>
