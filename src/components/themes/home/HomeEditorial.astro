---
/**
 * HomeEditorial — Grand Editorial (ultra-lujo).
 * Nav frontal: cilindro vertical tipo slot (scroll-snap + scale al centro).
 */
import { resolveSafeHomeProps } from '../../../lib/home-safe-props.js';
import { resolveHomePxSizes } from '../../../lib/secciones-ui.js';

interface Props {
  nombre?: string;
  logoText?: string;
  logoLetter?: string;
  logoUrl?: string | null;
  logo_url?: string | null;
  tagline?: string;
  eslogan?: string;
  taglineSuperior?: string;
  tagline_superior?: string;
  estilos?: Record<string, string>;
  reservasCta?: {
    label: string;
    href: string;
    subtitulo?: string;
    activo?: boolean;
  } | null;
  showReservas?: boolean;
  reservas_activo?: boolean;
  reservas_texto?: string;
  reservas_link?: string;
  homeUi?: Record<string, unknown>;
  restaurante?: Record<string, unknown>;
}

const props = Astro.props as Record<string, unknown>;
const r =
  props?.restaurante && typeof props.restaurante === 'object'
    ? (props.restaurante as Record<string, unknown>)
    : props;

const {
  nombre,
  logoText,
  logoLetter,
  logoUrl,
  tagline,
  taglineSuperior,
  reservasCta,
  homeUi,
} = resolveSafeHomeProps(props);

const {
  logoSizePx,
  estiloNavegacion,
  overlayEstilo,
  efectoEntrada,
} = resolveHomePxSizes(homeUi || props?.homeUi);

const navFrontal = estiloNavegacion === 'frontal';
const immersiveLogoOnly = estiloNavegacion === 'hamburguesa';
const navAppTabs = estiloNavegacion === 'app_tabs';
const textShadowPuro = overlayEstilo === 'puro';

const animRise = efectoEntrada === 'rise';
const animBlur = efectoEntrada === 'blur';
const animReveal = efectoEntrada === 'reveal';
const animZoom = efectoEntrada === 'zoom';
const animTracking = efectoEntrada === 'tracking';
const hasEntrance = animRise || animBlur || animZoom || animTracking;

const logoPx = logoSizePx || 130;
const logoFallbackStyle = `max-height: var(--home-logo-size, ${logoPx}px); height: var(--home-logo-size, ${logoPx}px); width: var(--home-logo-size, ${logoPx}px); font-size: calc(var(--home-logo-size, ${logoPx}px) * 0.28);`;

const eslogan = tagline || String(props?.eslogan || r?.eslogan || '').trim();
const taglineSuperiorResolved = String(
  taglineSuperior ||
    props?.tagline_superior ||
    props?.taglineSuperior ||
    r?.taglineSuperior ||
    '',
).trim();
/** Texto Superior (Identidad) bajo el logo; Slogan como fallback. */
const taglineDisplay = (
  taglineSuperiorResolved ||
  eslogan ||
  'EXPERIENCIA GASTRONÓMICA'
).toUpperCase();

const menuSubtitle = String(
  props?.menu_subtitle ||
    props?.menuSubtitle ||
    'CARTA DE AUTOR',
)
  .trim()
  .toUpperCase() || 'CARTA DE AUTOR';

const subtituloReservas = String(
  props?.reservas_subtitulo ||
    r?.reservas_subtitulo ||
    reservasCta?.subtitulo ||
    'MESA · PEDIDOS · TAKEAWAY',
)
  .trim()
  .toUpperCase() || 'MESA · PEDIDOS · TAKEAWAY';

const reservasLabel = String(
  props?.reservas_texto ||
    r?.reservas_texto ||
    reservasCta?.label ||
    'RESERVAS',
)
  .trim()
  .toUpperCase() || 'RESERVAS';

const reservasLink = String(props?.reservas_link || r?.reservas_link || reservasCta?.href || '#').trim() || '#';
const reservasIsExternal = reservasLink !== '#';

/** Subtítulos universales — sirven a cualquier restaurante (no contenido de bloque/dirección). */
const navNosotrosLabel = 'NOSOTROS';
const navNosotrosSubtitle = 'NUESTRA HISTORIA';
const navUbicacionLabel = 'HORARIOS Y UBICACIÓN';
const navUbicacionSubtitle = 'HORARIO · MAPA · REDES';

const horariosRows = Array.isArray(props?.horariosRows)
  ? props.horariosRows
  : Array.isArray(r?.horariosRows)
    ? r.horariosRows
    : [];
const horariosJson = JSON.stringify(horariosRows);

type NavItem = {
  id: string;
  label: string;
  subtitle: string;
  kind: 'section' | 'reservas';
};

const navItems: NavItem[] = [
  { id: 'menu', label: 'MENÚ', subtitle: menuSubtitle, kind: 'section' },
  {
    id: 'reservas',
    label: reservasLabel,
    subtitle: subtituloReservas,
    kind: 'reservas',
  },
  {
    id: 'nosotros',
    label: navNosotrosLabel,
    subtitle: navNosotrosSubtitle,
    kind: 'section',
  },
  {
    id: 'ubicacion',
    label: navUbicacionLabel,
    subtitle: navUbicacionSubtitle,
    kind: 'section',
  },
];

const linkClass =
  'editorial-link relative flex h-full w-full cursor-pointer select-none flex-col items-center justify-center px-3 focus:outline-none sm:px-4';

/** Tres copias del carrusel para loop infinito (prev | real | next). */
const reelCopies = [0, 1, 2] as const;
---

<div
  class:list={[
    'home-editorial linktree-home relative z-10 flex h-[100svh] max-h-[100svh] min-h-0 w-full select-none flex-col items-center overflow-hidden bg-transparent px-5 pt-[max(1rem,env(safe-area-inset-top))] pb-[max(1rem,env(safe-area-inset-bottom))] font-[family-name:var(--font-body,var(--fuente-principal))] md:h-auto md:max-h-none md:min-h-[100dvh] md:overflow-visible md:px-6 md:py-16',
    textShadowPuro && 'home-editorial--overlay-puro',
    animRise && 'home-anim-rise',
    animBlur && 'home-anim-blur',
    animReveal && 'home-anim-reveal',
    animZoom && 'home-anim-zoom',
    animTracking && 'home-anim-tracking',
    navAppTabs && 'pb-24',
  ]}
  data-linktree-home
  data-home-theme="editorial"
  data-estilo-navegacion={estiloNavegacion}
  data-nav-mode={estiloNavegacion}
  data-overlay-estilo={overlayEstilo}
  data-efecto-entrada={efectoEntrada}
>
  {/* ── Branding ── */}
  <header
    class:list={[
      'home-editorial__brand mx-auto flex w-full max-w-xl shrink-0 flex-col items-center gap-2 text-center md:gap-3',
      hasEntrance && 'home-enter home-enter--logo',
      immersiveLogoOnly && 'my-auto',
    ]}
    data-home-header
  >
    <div class="flex items-center justify-center" data-home-logo>
      {
        logoUrl ? (
          <img
            src={logoUrl}
            alt={nombre || 'Logo'}
            class="home-editorial__logo-img h-[min(var(--home-logo-size,145px),16svh)] max-h-[16svh] w-auto max-w-[72vw] object-contain md:h-[var(--home-logo-size,210px)] md:max-h-[var(--home-logo-size,210px)] md:max-w-[88vw]"
            data-home-logo
          />
        ) : (
          <span
            class="flex items-center justify-center font-medium uppercase tracking-[0.28em] text-white"
            data-home-logo-fallback
            style={logoFallbackStyle}
            aria-hidden="true"
          >
            {logoLetter || (logoText || nombre || '?').slice(0, 1)}
          </span>
        )
      }
    </div>

    {
      !immersiveLogoOnly ? (
        <p
          class:list={[
            'home-editorial__tagline font-mono text-[10px] uppercase leading-relaxed tracking-[0.24em] text-white/80 min-[390px]:text-xs md:tracking-[0.32em]',
            hasEntrance && 'home-enter home-enter--eslogan',
          ]}
          data-home-eslogan
          data-home-tagline-superior
        >
          {taglineDisplay}
        </p>
      ) : null
    }
  </header>

  {/* ── Cilindro vertical (slot) — flota sobre el video, sin caja ── */}
  {
    navFrontal ? (
      <nav
        class:list={[
          'editorial-reel relative mx-auto w-full max-w-xl',
          hasEntrance && 'home-enter home-enter--botones',
        ]}
        aria-label={`Navegación ${nombre || 'restaurante'}`}
        data-editorial-nav
        data-editorial-reel
        data-home-menu
        data-home-block="nav"
      >
        <div
          class="editorial-reel__viewport"
          data-editorial-reel-viewport
          data-reel-count={String(navItems.length)}
        >
          <div class="editorial-reel__spacer" aria-hidden="true" />
          {
            reelCopies.flatMap((copy) =>
              navItems.map((item, index) => {
                const inner = (
                  <div
                    class="editorial-reel__face"
                    style="--reel-scale: 0.72; --reel-opacity: 0.38;"
                  >
                    <span class="editorial-title text-center font-serif uppercase leading-none tracking-[0.12em]">
                      {item.label}
                    </span>
                    <span class="editorial-subtitle mt-2.5 block text-center font-light uppercase">
                      {item.subtitle}
                    </span>
                    <span class="editorial-rule" aria-hidden="true" />
                  </div>
                );

                const slideAttrs = {
                  class: 'editorial-reel__slide',
                  'data-editorial-slide': '',
                  'data-slide-index': String(index),
                  'data-slide-copy': String(copy),
                  'aria-hidden': copy !== 1 ? 'true' : undefined,
                };

                const pickExtras =
                  copy !== 1
                    ? ({ tabindex: -1, 'aria-hidden': 'true' } as const)
                    : ({} as const);

                if (item.kind === 'reservas') {
                  if (reservasIsExternal) {
                    return (
                      <div {...slideAttrs}>
                        <a
                          href={reservasLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-tab-trigger="reservas"
                          data-reservas-home-cta
                          data-editorial-pick
                          class={linkClass}
                          {...pickExtras}
                        >
                          {inner}
                        </a>
                      </div>
                    );
                  }
                  return (
                    <div {...slideAttrs}>
                      <button
                        type="button"
                        data-tab-trigger="reservas"
                        data-reservas-home-cta
                        data-editorial-pick
                        class={linkClass}
                        {...pickExtras}
                      >
                        {inner}
                      </button>
                    </div>
                  );
                }

                return (
                  <div {...slideAttrs}>
                    <button
                      type="button"
                      data-tab-trigger={item.id}
                      data-open-section={item.id}
                      data-open-ubicacion={item.id === 'ubicacion' ? 'true' : undefined}
                      data-editorial-pick
                      class={linkClass}
                      {...pickExtras}
                    >
                      {inner}
                    </button>
                  </div>
                );
              }),
            )
          }
          <div class="editorial-reel__spacer" aria-hidden="true" />
        </div>
      </nav>
    ) : null
  }

  {/* ── Estado en vivo (desde horarios de Identidad) ── */}
  {
    !immersiveLogoOnly ? (
      <footer
        class="home-editorial__foot flex shrink-0 flex-col items-center"
        data-home-live-status
        data-ubicacion-panel
        data-horarios={horariosJson}
        data-live-badge
      >
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.06] px-3.5 py-1.5 font-mono text-[0.65rem] tracking-[0.18em] text-emerald-300/95 backdrop-blur-md md:px-4 md:py-2 md:text-xs md:tracking-widest">
          <span
            class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"
            data-live-dot
            aria-hidden="true"
          />
          <span data-live-label>HORARIO</span>
        </div>
      </footer>
    ) : null
  }
</div>

<script>
  import { refreshUbicacionLiveStatus } from '../../../lib/ubicacion-live-client.js';

  function initHomeLiveStatus(root = document) {
    root.querySelectorAll('[data-home-live-status]').forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      refreshUbicacionLiveStatus(el);
      const label = el.querySelector('[data-live-label]');
      if (label instanceof HTMLElement) {
        if (label.textContent === 'ABIERTO') label.textContent = 'ABIERTO HOY';
        if (label.textContent === 'Horario no disponible') label.textContent = 'HORARIO';
      }
      if (el.dataset.liveInterval === '1') return;
      el.dataset.liveInterval = '1';
      window.setInterval(() => {
        refreshUbicacionLiveStatus(el);
        const lb = el.querySelector('[data-live-label]');
        if (lb instanceof HTMLElement && lb.textContent === 'ABIERTO') {
          lb.textContent = 'ABIERTO HOY';
        }
      }, 60_000);
    });
  }

  initHomeLiveStatus();
  document.addEventListener('astro:page-load', () => initHomeLiveStatus());
</script>

<script>
  function initEditorialReel(root = document) {
    root.querySelectorAll('[data-editorial-reel]').forEach((nav) => {
      if (nav instanceof HTMLElement) delete nav.dataset.reelReady;
    });
    const reels = root.querySelectorAll('[data-editorial-reel]');
    reels.forEach((nav) => {
      if (!(nav instanceof HTMLElement)) return;
      if (nav.dataset.reelReady === '1') return;
      const viewport = nav.querySelector('[data-editorial-reel-viewport]');
      if (!(viewport instanceof HTMLElement)) return;
      nav.dataset.reelReady = '1';

      const count = Math.max(1, Number(viewport.dataset.reelCount || 0) || 1);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isCoarse = window.matchMedia('(pointer: coarse)').matches;

      /** @returns {HTMLElement[]} */
      const slides = () =>
        Array.from(viewport.querySelectorAll('[data-editorial-slide]')).filter(
          (el) => el instanceof HTMLElement,
        );

      let ticking = false;
      let wrapping = false;
      let activeAbs = -1;
      let settleTimer = 0;

      const centerScrollTop = (slide) => {
        const slideMid = slide.offsetTop + slide.offsetHeight / 2;
        return Math.max(0, slideMid - viewport.clientHeight / 2);
      };

      const findBestIndex = () => {
        const list = slides();
        if (!list.length) return { list, best: 0 };
        const rect = viewport.getBoundingClientRect();
        const centerY = rect.top + rect.height / 2;
        let best = 0;
        let bestDist = Infinity;
        list.forEach((slide, i) => {
          const sRect = slide.getBoundingClientRect();
          const mid = sRect.top + sRect.height / 2;
          const dist = Math.abs(mid - centerY);
          if (dist < bestDist) {
            bestDist = dist;
            best = i;
          }
        });
        return { list, best };
      };

      const jumpToAbs = (absIndex) => {
        const list = slides();
        const target = list[absIndex];
        if (!(target instanceof HTMLElement)) return;
        wrapping = true;
        viewport.style.scrollSnapType = 'none';
        viewport.style.scrollBehavior = 'auto';
        viewport.scrollTop = centerScrollTop(target);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            viewport.style.scrollSnapType = '';
            viewport.style.scrollBehavior = '';
            wrapping = false;
            paintCylinder(true);
          });
        });
      };

      /** Tras inercia: si estás en copia prev/next, salta a la del medio. */
      const normalizeLoop = () => {
        if (wrapping) return;
        const { best } = findBestIndex();
        if (best < count) {
          jumpToAbs(best + count);
          return;
        }
        if (best >= count * 2) {
          jumpToAbs(best - count);
        }
      };

      const paintCylinder = (force = false) => {
        ticking = false;
        if (wrapping && !force) return;
        const { list, best } = findBestIndex();
        if (!list.length) return;
        const rect = viewport.getBoundingClientRect();
        const centerY = rect.top + rect.height / 2;
        const half = Math.max(rect.height / 2, 1);
        // Más contraste: inactivo más chico; activo crece un poco por encima de 1
        const scaleEase = reduceMotion ? 0.2 : isCoarse ? 0.38 : 0.44;
        const opacityEase = reduceMotion ? 0.35 : isCoarse ? 0.58 : 0.7;
        const activeBoost = reduceMotion ? 1 : 1.08;

        list.forEach((slide, i) => {
          const face = slide.querySelector('.editorial-reel__face');
          const sRect = slide.getBoundingClientRect();
          const mid = sRect.top + sRect.height / 2;
          const t = Math.min(1, Math.abs(mid - centerY) / half);
          const on = i === best;
          const scale = on ? activeBoost : Math.max(0.58, 1 - t * scaleEase);
          const opacity = on ? 1 : Math.max(0.28, 1 - t * opacityEase);
          if (face instanceof HTMLElement) {
            face.style.setProperty('--reel-scale', String(scale));
            face.style.setProperty('--reel-opacity', String(opacity));
          }
        });

        if (best === activeAbs && !force) return;
        activeAbs = best;
        list.forEach((slide, i) => {
          const on = i === best;
          slide.toggleAttribute('data-active', on);
          const pick = slide.querySelector('[data-editorial-pick]');
          if (pick instanceof HTMLElement) {
            if (on) pick.setAttribute('aria-current', 'true');
            else pick.removeAttribute('aria-current');
          }
        });
      };

      const onScroll = () => {
        if (wrapping) return;
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => paintCylinder(false));
        }
        // Fallback si no hay scrollend (Safari viejo)
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(() => {
          normalizeLoop();
          paintCylinder(true);
        }, isCoarse ? 90 : 120);
      };

      viewport.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      viewport.addEventListener(
        'scrollend',
        () => {
          window.clearTimeout(settleTimer);
          normalizeLoop();
          paintCylinder(true);
        },
        { passive: true },
      );

      viewport.addEventListener(
        'click',
        (event) => {
          const pick =
            event.target instanceof Element ? event.target.closest('[data-editorial-pick]') : null;
          if (!(pick instanceof HTMLElement)) return;
          const slide = pick.closest('[data-editorial-slide]');
          if (!(slide instanceof HTMLElement)) return;

          const list = slides();
          const abs = list.indexOf(slide);
          if (abs < 0) return;
          const logical = abs % count;
          const midAbs = count + logical;

          // Inactivo: centrar y luego abrir (un solo tap abre el drawer/panel)
          if (!slide.hasAttribute('data-active')) {
            event.preventDefault();
            event.stopPropagation();
            jumpToAbs(midAbs);
            window.setTimeout(() => {
              const mid = slides()[midAbs];
              const midPick = mid?.querySelector('[data-editorial-pick]');
              if (!(midPick instanceof HTMLElement)) return;
              if (midPick instanceof HTMLAnchorElement) {
                const href = midPick.getAttribute('href') || '';
                if (href && href !== '#') {
                  if (midPick.target === '_blank') {
                    window.open(href, '_blank', 'noopener,noreferrer');
                  } else {
                    window.location.href = href;
                  }
                  return;
                }
              }
              midPick.click();
            }, isCoarse ? 70 : 40);
            return;
          }
        },
        true,
      );

      requestAnimationFrame(() => {
        const list = slides();
        const start = list[count];
        if (start instanceof HTMLElement) {
          wrapping = true;
          viewport.style.scrollSnapType = 'none';
          viewport.style.scrollBehavior = 'auto';
          viewport.scrollTop = centerScrollTop(start);
          requestAnimationFrame(() => {
            viewport.style.scrollSnapType = '';
            viewport.style.scrollBehavior = '';
            wrapping = false;
            paintCylinder(true);
          });
        } else {
          paintCylinder(true);
        }
      });
    });
  }

  initEditorialReel();
  document.addEventListener('astro:page-load', () => initEditorialReel());
</script>

<style is:global>
  /* Teléfono: home a pantalla completa; overflow solo en el shell del home
     (no en .restaurant-app) para que el drawer fixed no quede clipado. */
  @media (max-width: 767px) {
    html:has(.home-editorial):not(.drawer-open),
    body:has(.home-editorial):not(:has(.has-drawer-open)) {
      height: 100svh;
      max-height: 100svh;
      overflow: hidden;
      overscroll-behavior: none;
      background: transparent;
    }

    html:has([data-fondo-home-tipo='video'] .home-editorial),
    body:has([data-fondo-home-tipo='video'] .home-editorial) {
      background: #000;
    }

    .restaurant-app:has(.home-editorial) {
      height: 100svh;
      max-height: 100svh;
      min-height: 0;
      overflow: visible;
      background: transparent !important;
    }

    .restaurant-app.has-drawer-open {
      overflow: visible !important;
    }

    [data-home-shell]:has(.home-editorial) {
      height: 100svh;
      max-height: 100svh;
      min-height: 0;
      overflow: hidden;
      background: transparent !important;
    }

    [data-home-shell]:has(.home-editorial) > .relative {
      height: 100svh;
      max-height: 100svh;
      min-height: 0;
      overflow: hidden;
      background: transparent !important;
    }

    /* Drawer por encima del shell con overflow */
    .restaurant-app [data-ubicacion-drawer] {
      position: fixed;
      inset: 0;
      z-index: 80;
    }
  }
</style>

<style>
  .editorial-link {
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    border: none;
  }

  /* Distribución vertical móvil: marca arriba, cilindro al centro, estado abajo */
  @media (max-width: 767px) {
    .home-editorial {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      align-items: center;
      justify-items: center;
      row-gap: 0.35rem;
      background: transparent !important;
    }

    .home-editorial__brand {
      padding-top: 0.35rem;
    }

    .home-editorial__foot {
      padding-bottom: 0.25rem;
    }

    .home-editorial__foot[data-open='false'] .inline-flex,
    .home-editorial__foot.is-closed .inline-flex {
      color: rgba(251, 113, 133, 0.95);
    }

    .home-editorial__foot[data-open='false'] [data-live-dot],
    .home-editorial__foot.is-closed [data-live-dot] {
      background: #fb7185;
      animation: none;
    }

    .editorial-reel {
      align-self: stretch;
      width: 100%;
      height: 100%;
      max-height: none;
      min-height: 0;
      background: transparent;
    }
  }

  @media (min-width: 768px) {
    .home-editorial {
      justify-content: space-between;
      gap: 1.5rem;
    }

    .editorial-reel {
      height: min(52vh, 28rem);
      max-height: 52vh;
      flex: 1 1 auto;
    }
  }

  .editorial-reel__viewport {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: auto;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    background: transparent;
    touch-action: pan-y;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 14%,
      #000 86%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 14%,
      #000 86%,
      transparent 100%
    );
  }

  .editorial-reel__viewport::-webkit-scrollbar {
    display: none;
  }

  .editorial-reel__spacer {
    flex-shrink: 0;
    height: calc(50% - 4.6rem);
    min-height: 3.5rem;
    pointer-events: none;
  }

  /* Caja fija para snap estable; el scale vive en .face (evita temblor) */
  .editorial-reel__slide {
