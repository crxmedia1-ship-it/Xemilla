---
---

<button
  type="button"
  class="install-app"
  data-install-app
  hidden
  aria-label="Instalar aplicación"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.75v9.5m0 0l3.25-3.25M12 14.25L8.75 11"></path>
    <path stroke-linecap="round" d="M5.25 18.25h13.5"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-install-app]');
    if (!root || root.getAttribute('data-install-bound') === '1') return;
    root.setAttribute('data-install-bound', '1');

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    }

    var standalone =
      window.matchMedia('(display-mode: standalone)').matches ||
      window.navigator.standalone === true;
    if (standalone) return;

    var isIos =
      /iphone|ipad|ipod/i.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var deferred = null;

    window.addEventListener('beforeinstallprompt', function (event) {
      event.preventDefault();
      deferred = event;
      root.hidden = false;
    });

    if (isIos) root.hidden = false;

    root.addEventListener('click', function () {
      if (!deferred) return;
      var promptEvent = deferred;
      deferred = null;
      promptEvent.prompt();
      if (promptEvent.userChoice && promptEvent.userChoice.then) {
        promptEvent.userChoice.then(function (choice) {
          if (choice && choice.outcome === 'accepted') root.hidden = true;
        });
      }
    });
  })();
</script>

<style>
  .install-app[hidden] {
    display: none !important;
  }

  .install-app {
    position: fixed;
    z-index: 55;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.3);
    color: rgba(255, 255, 255, 0.55);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(12px);
    -webkit-tap-highlight-color: transparent;
  }

  .install-app svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .install-app:active {
    transform: scale(0.95);
  }

  :global(.restaurant-app:not([data-surface='home']) .install-app) {
    display: none !important;
  }

  @media (display-mode: standalone) {
    .install-app {
      display: none !important;
    }
  }
</style>
