---
/**
 * Switcher de plantilla Nosotros (editorial | split | bento).
 */
import NosotrosEditorial from '../themes/nosotros/NosotrosEditorial.astro';
import NosotrosSplit from '../themes/nosotros/NosotrosSplit.astro';
import NosotrosBento from '../themes/nosotros/NosotrosBento.astro';
import {
  normalizeNosotrosTheme,
  DEFAULT_NOSOTROS_THEME,
} from '../../lib/layout-themes.js';

interface Props {
  theme?: string | null;
  bloques?: unknown[];
  texto?: string;
  highlights?: string[];
  designDnaId?: string;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  theme: themeProp,
  bloques = [],
  texto = '',
  highlights = [],
  designDnaId = 'elegant',
  sectionColors = {},
  estilos,
} = Astro.props;

const nosotrosTheme = normalizeNosotrosTheme(themeProp ?? DEFAULT_NOSOTROS_THEME);

const shared = {
  bloques,
  texto,
  highlights,
  designDnaId,
  sectionColors,
  estilos,
};
---

<div data-nosotros-panel data-nosotros-theme={nosotrosTheme}>
  {
    nosotrosTheme === 'split' ? (
      <NosotrosSplit {...shared} />
    ) : nosotrosTheme === 'bento' ? (
      <NosotrosBento {...shared} />
    ) : (
      <NosotrosEditorial {...shared} />
    )
  }
</div>

<style>
  [data-nosotros-panel] [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition:
      opacity var(--motion-reveal, 520ms cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--motion-reveal, 520ms cubic-bezier(0.22, 1, 0.36, 1));
  }

  [data-nosotros-panel] [data-reveal].is-inview {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  [data-nosotros-panel] [data-reveal-media] {
    opacity: 0;
    transform: scale(0.97);
    transform-origin: center;
    transition:
      opacity var(--motion-reveal, 620ms cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--motion-reveal, 620ms cubic-bezier(0.22, 1, 0.36, 1));
  }

  [data-nosotros-panel] [data-reveal].is-inview [data-reveal-media],
  [data-nosotros-panel] [data-reveal-media].is-inview {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-nosotros-panel] [data-reveal],
    [data-nosotros-panel] [data-reveal-media] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initNosotrosReveal() {
    document.querySelectorAll('[data-nosotros-panel]').forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      if (panel.dataset.revealReady === 'true') return;
      panel.dataset.revealReady = 'true';

      const items = panel.querySelectorAll('[data-reveal], [data-reveal-media]');
      if (!items.length) return;

      const scrollRoot =
        panel.closest('[data-section]')?.querySelector('.overflow-y-auto') ?? null;

      if (typeof IntersectionObserver === 'undefined') {
        items.forEach((el) => el.classList.add('is-inview'));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-inview');
            io.unobserve(entry.target);
          }
        },
        {
          root: scrollRoot instanceof Element ? scrollRoot : null,
          rootMargin: '0px 0px -6% 0px',
          threshold: 0.1,
        },
      );

      items.forEach((el) => io.observe(el));
    });
  }

  initNosotrosReveal();
  document.addEventListener('astro:page-load', initNosotrosReveal);
</script>
