---
/**
 * Switcher de plantilla Nosotros (editorial | cinematic | capsule).
 */
import NosotrosEditorial from '../themes/nosotros/NosotrosEditorial.astro';
import NosotrosCinematic from '../themes/nosotros/NosotrosCinematic.astro';
import NosotrosCapsule from '../themes/nosotros/NosotrosCapsule.astro';
import {
  normalizeNosotrosTheme,
  DEFAULT_NOSOTROS_THEME,
} from '../../lib/layout-themes.js';
import { normalizeContenedorEstilo } from '../../lib/nosotros-layout.js';
import {
  resolveNosotrosFuenteTitulo,
  resolveNosotrosFuenteCuerpo,
  buildNosotrosFontsHref,
} from '../../config/nosotros-typography.js';

interface Props {
  theme?: string | null;
  bloques?: unknown[];
  texto?: string;
  highlights?: string[];
  designDnaId?: string;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
    contenedor_estilo?: string;
    fuente_titulo?: string;
    fuente_cuerpo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  theme: themeProp,
  bloques = [],
  texto = '',
  highlights = [],
  designDnaId = 'elegant',
  sectionColors = {},
  estilos,
} = Astro.props;

const nosotrosTheme = normalizeNosotrosTheme(themeProp ?? DEFAULT_NOSOTROS_THEME);
const contenedorEstilo = normalizeContenedorEstilo(sectionColors.contenedor_estilo);
const fuenteTitulo = resolveNosotrosFuenteTitulo(sectionColors.fuente_titulo);
const fuenteCuerpo = resolveNosotrosFuenteCuerpo(sectionColors.fuente_cuerpo);
const contenedorBg = (sectionColors.color_fondo || '').trim();
const fontsHref = buildNosotrosFontsHref(fuenteTitulo.id, fuenteCuerpo.id);

const panelStyle = [
  `--nosotros-font-heading:${fuenteTitulo.stack}`,
  `--nosotros-font-body:${fuenteCuerpo.stack}`,
  `--font-heading:${fuenteTitulo.stack}`,
  `--font-body:${fuenteCuerpo.stack}`,
  contenedorBg ? `--nosotros-contenedor-bg:${contenedorBg}` : '',
]
  .filter(Boolean)
  .join(';');

const shared = {
  bloques,
  texto,
  highlights,
  designDnaId,
  sectionColors,
  estilos,
};
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontsHref} />

<div
  data-nosotros-panel
  data-nosotros-theme={nosotrosTheme}
  data-contenedor={contenedorEstilo}
  style={panelStyle || undefined}
>
  {
    nosotrosTheme === 'cinematic' ? (
      <NosotrosCinematic {...shared} />
    ) : nosotrosTheme === 'capsule' ? (
      <NosotrosCapsule {...shared} />
    ) : (
      <NosotrosEditorial {...shared} />
    )
  }
</div>

<style>
  [data-nosotros-panel] {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    font-family: var(--nosotros-font-body, var(--font-body, var(--fuente-principal)));
  }

  [data-nosotros-panel] :global(.nosotros-copy),
  [data-nosotros-panel] :global(.editorial-body) {
    overflow-wrap: anywhere;
    word-break: break-word;
    hyphens: auto;
  }

  [data-nosotros-panel] :global(h1),
  [data-nosotros-panel] :global(h2),
  [data-nosotros-panel] :global(h3) {
    font-family: var(--nosotros-font-heading, var(--font-heading, var(--fuente-display)));
    text-wrap: balance;
  }

  [data-nosotros-panel] :global(img),
  [data-nosotros-panel] :global(video) {
    max-width: 100%;
  }

  [data-nosotros-panel] :global(.nosotros-media),
  [data-nosotros-panel] :global(.nosotros-capsule__gallery),
  [data-nosotros-panel] :global(.nosotros-cinematic__hero) {
    max-width: 100%;
  }

  @media (min-width: 768px) {
    [data-nosotros-panel] :global(.nosotros-editorial),
    [data-nosotros-panel] :global(.nosotros-cinematic),
    [data-nosotros-panel] :global(.nosotros-capsule) {
      margin-left: auto;
      margin-right: auto;
    }
  }

  [data-nosotros-panel] [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition:
      opacity var(--motion-reveal, 520ms cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--motion-reveal, 520ms cubic-bezier(0.22, 1, 0.36, 1));
  }

  [data-nosotros-panel] [data-reveal].is-inview {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  [data-nosotros-panel] [data-reveal-media] {
    opacity: 0;
    transform: scale(0.97);
    transform-origin: center;
    transition:
      opacity var(--motion-reveal, 620ms cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--motion-reveal, 620ms cubic-bezier(0.22, 1, 0.36, 1));
  }

  [data-nosotros-panel] [data-reveal].is-inview [data-reveal-media],
  [data-nosotros-panel] [data-reveal-media].is-inview {
    opacity: 1;
    transform: scale(1);
  }

  [data-nosotros-panel] :global(.glass-panel),
  [data-nosotros-panel] :global(.nosotros-card) {
    border-width: 1px;
    border-style: solid;
  }

  [data-nosotros-panel][data-contenedor='vidrio'] :global(.glass-panel),
  [data-nosotros-panel][data-contenedor='vidrio'] :global(.nosotros-card) {
    background: color-mix(
      in srgb,
      var(--nosotros-contenedor-bg, var(--sec-nosotros-fondo, #ffffff)) 24%,
      transparent
    ) !important;
    border-color: color-mix(
      in srgb,
      var(--nosotros-contenedor-bg, var(--sec-nosotros-fondo, #ffffff)) 44%,
      transparent
    ) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    box-shadow:
      0 18px 44px color-mix(in srgb, #000 16%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 10%, transparent) !important;
  }

  [data-nosotros-panel][data-contenedor='solido'] :global(.glass-panel),
  [data-nosotros-panel][data-contenedor='solido'] :global(.nosotros-card) {
    background: var(
      --nosotros-contenedor-bg,
      var(--sec-nosotros-fondo, var(--color-fondo, #141414))
    ) !important;
    border-color: color-mix(
      in srgb,
      var(--nosotros-contenedor-bg, var(--sec-nosotros-fondo, #141414)) 72%,
      transparent
    ) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: 0 16px 40px color-mix(in srgb, #000 20%, transparent) !important;
  }

  [data-nosotros-panel][data-contenedor='linea'] :global(.glass-panel),
  [data-nosotros-panel][data-contenedor='linea'] :global(.nosotros-card) {
    background: transparent !important;
    border-color: color-mix(
      in srgb,
      var(--sec-nosotros-cuerpo, var(--color-texto, currentColor)) 32%,
      transparent
    ) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
  }

  [data-nosotros-panel][data-contenedor='ninguno'] :global(.glass-panel),
  [data-nosotros-panel][data-contenedor='ninguno'] :global(.nosotros-card) {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
    padding-left: 0;
    padding-right: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-nosotros-panel] [data-reveal],
    [data-nosotros-panel] [data-reveal-media] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initNosotrosReveal() {
    document.querySelectorAll('[data-nosotros-panel]').forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      if (panel.dataset.revealReady === 'true') return;
      panel.dataset.revealReady = 'true';

      const items = panel.querySelectorAll('[data-reveal], [data-reveal-media]');
      if (!items.length) return;

      const scrollRoot =
        panel.closest('[data-section]')?.querySelector('.overflow-y-auto') ?? null;

      if (typeof IntersectionObserver === 'undefined') {
        items.forEach((el) => el.classList.add('is-inview'));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-inview');
            io.unobserve(entry.target);
          }
        },
        {
          root: scrollRoot instanceof Element ? scrollRoot : null,
          rootMargin: '0px 0px -6% 0px',
          threshold: 0.1,
        },
      );

      items.forEach((el) => io.observe(el));
    });
  }

  initNosotrosReveal();
  document.addEventListener('astro:page-load', initNosotrosReveal);
</script>
