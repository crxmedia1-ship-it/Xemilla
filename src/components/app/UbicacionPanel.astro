---
import { googleMapsEmbedSrc, mapsOpenHref } from '../../lib/maps-preview.js';

interface Props {
  direccion: string;
  ciudad: string;
  telefono: string;
  email?: string;
  instagram?: string;
  whatsapp?: string;
  redes?: Array<{ red: string; url: string; activo?: boolean }>;
  mapaLabel: string;
  mapaUrl: string;
  horarios: string | Array<{ dia: string; horas: string }>;
  horariosRows?: Array<{ dia: string; horas: string }>;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
  };
  estilos: {
    mutedColor: string;
    softColor: string;
    textColor: string;
    borderColor: string;
    displayClass: string;
  };
}

const {
  direccion,
  ciudad,
  telefono,
  email = '',
  instagram = '',
  whatsapp = '',
  redes = [],
  mapaLabel,
  mapaUrl,
  horarios,
  horariosRows,
  sectionColors = {},
  estilos,
} = Astro.props;

const titleColor = (sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const titleStyle = titleColor ? `color:${titleColor}` : undefined;
const bodyStyle = bodyColor ? `color:${bodyColor}` : undefined;

const telHref = telefono.replace(/[^\d+]/g, '');
const emailHref = email.trim();
const waRaw = String(whatsapp || telefono).trim();
const waDigits = waRaw.replace(/\D/g, '');
const waHref = /^https?:\/\//i.test(waRaw)
  ? waRaw
  : waDigits
    ? `https://wa.me/${waDigits}`
    : '';

const redesActivas =
  Array.isArray(redes) && redes.length > 0
    ? redes.filter((r) => r?.red && r?.url && r?.activo !== false)
    : instagram.trim()
      ? [
          {
            red: 'instagram',
            url: /^https?:\/\//i.test(instagram)
              ? instagram.trim()
              : `https://instagram.com/${instagram.replace(/^@/, '')}`,
          },
        ]
      : [];

const mapsQuery = [direccion, ciudad].filter(Boolean).join(', ');
const mapsHref =
  mapsOpenHref(mapaUrl, mapsQuery) ||
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery || 'restaurante')}`;
const mapsEmbed = googleMapsEmbedSrc(mapaUrl, mapsQuery);

const wazeHref = `https://waze.com/ul?q=${encodeURIComponent(mapsQuery || mapsHref || 'restaurante')}&navigate=yes`;

const horariosIsText = typeof horarios === 'string';
const horariosTexto = horariosIsText ? horarios.trim() : '';
const horarioFilas: Array<{ dia: string; horas: string }> = Array.isArray(horariosRows)
  ? horariosRows
  : Array.isArray(horarios)
    ? horarios
    : [];

function parseHorariosTexto(text: string): Array<{ dia: string; horas: string }> {
  return text
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => {
      const idx = line.indexOf(':');
      if (idx === -1) return { dia: '', horas: line };
      return { dia: line.slice(0, idx).trim(), horas: line.slice(idx + 1).trim() };
    });
}

const liveHorarios =
  horarioFilas.length > 0
    ? horarioFilas
    : horariosTexto
      ? parseHorariosTexto(horariosTexto)
      : [];

const horariosJson = JSON.stringify(liveHorarios);

const socialMeta: Record<string, { label: string; path: string }> = {
  instagram: {
    label: 'Instagram',
    path: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.5 1 .4.4.7.9 1 1.5.2.4.4 1.1.4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-1 1.5-.4.4-.9.7-1.5 1-.4.2-1.1.4-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.2-2.3-.4-.6-.2-1-.5-1.5-1-.4-.4-.7-.9-1-1.5-.2-.4-.4-1.1-.4-2.3C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.9.4-2.3.2-.6.5-1 1-1.5.4-.4.9-.7 1.5-1 .4-.2 1.1-.4 2.3-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.2 0-3.5 0-4.8.1-1 .1-1.6.2-1.9.4-.5.2-.8.4-1.2.8-.4.4-.6.7-.8 1.2-.1.3-.3.9-.4 1.9-.1 1.2-.1 1.6-.1 4.8s0 3.5.1 4.8c.1 1 .2 1.6.4 1.9.2.5.4.8.8 1.2.4.4.7.6 1.2.8.3.1.9.3 1.9.4 1.2.1 1.6.1 4.8.1s3.5 0 4.8-.1c1-.1 1.6-.2 1.9-.4.5-.2.8-.4 1.2-.8.4-.4.6-.7.8-1.2.1-.3.3-.9.4-1.9.1-1.2.1-1.6.1-4.8s0-3.5-.1-4.8c-.1-1-.2-1.6-.4-1.9-.2-.5-.4-.8-.8-1.2-.4-.4-.7-.6-1.2-.8-.3-.1-.9-.3-1.9-.4-1.3-.1-1.6-.1-4.8-.1zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2zm6.1-.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0z',
  },
  facebook: {
    label: 'Facebook',
    path: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z',
  },
  tiktok: {
    label: 'TikTok',
    path: 'M19.6 8.2a6.7 6.7 0 0 1-3.9-1.2v7.1a5.6 5.6 0 1 1-4.8-5.5v2.9a2.8 2.8 0 1 0 2 2.7V2.5h2.8c.3 1.8 1.6 3.3 3.3 3.9v1.8z',
  },
  tripadvisor: {
    label: 'TripAdvisor',
    path: 'M12 4c-4.4 0-8 2.9-9.5 7h2.2a7.4 7.4 0 0 1 14.6 0h2.2C20 6.9 16.4 4 12 4zm-4.3 7.2a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6zm8.6 0a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6zM12 20c4.4 0 8-2.9 9.5-7h-2.2a7.4 7.4 0 0 1-14.6 0H2.5c1.5 4.1 5.1 7 9.5 7z',
  },
};
---

<div
  class="mx-auto flex w-full max-w-none flex-col items-center px-5 pb-[max(2.5rem,env(safe-area-inset-bottom))] pt-6"
  data-ubicacion-panel
  data-horarios={horariosJson}
  style={[titleStyle && `--sec-titulo:${titleColor}`, bodyStyle && `--sec-cuerpo:${bodyColor}`]
    .filter(Boolean)
    .join('; ')}
>
  <!-- 1. Cabecera: status + separador -->
  <header class="flex w-full flex-col items-center">
    <div
      class="inline-flex items-center justify-center gap-2"
      data-live-status
      role="status"
      aria-live="polite"
    >
      <span
        data-live-dot
        class="size-2 shrink-0 rounded-full bg-current opacity-40"
        aria-hidden="true"
      ></span>
      <p
        data-live-label
        class={`text-center text-[0.65rem] font-semibold uppercase tracking-[0.22em] ${estilos.mutedColor}`}
      >
        Consultando…
      </p>
    </div>
    <div class={`mt-5 h-px w-full max-w-[12rem] border-t ${estilos.borderColor}`} aria-hidden="true"></div>
  </header>

  <!-- 2. Horarios -->
  <section class="mt-8 flex w-full flex-col items-center">
    <h3
      class={`w-full text-center text-[0.62rem] font-semibold uppercase tracking-[0.28em] ${!titleColor ? estilos.softColor : ''}`}
      style={titleStyle}
    >
      Horarios
    </h3>

    {
      horariosIsText && horariosTexto ? (
        <p
          class={`mt-5 w-full max-w-xs whitespace-pre-line text-center text-sm font-medium leading-relaxed tracking-wide tabular-nums ${!bodyColor ? estilos.textColor : ''}`}
          style={bodyStyle}
          data-horarios-texto
        >
          {horariosTexto}
        </p>
      ) : (
        <ul class="mt-5 w-full max-w-xs" data-horarios-list>
          {liveHorarios.length === 0 ? (
            <li class={`py-2 text-center text-sm ${estilos.mutedColor}`} style={bodyStyle}>Sin horarios</li>
          ) : (
            liveHorarios.map((h, index) => (
              <li
                class="flex w-full items-baseline justify-between gap-4 py-2.5"
                data-horario-row
                data-horario-index={index}
                data-dia={h.dia}
                data-horas={h.horas}
              >
                <span class={`horario-dia text-left text-sm ${!bodyColor ? estilos.mutedColor : ''}`} style={bodyStyle}>{h.dia}</span>
                <span
                  class={`horario-horas whitespace-pre-line text-right text-sm font-medium tabular-nums tracking-wide ${!bodyColor ? estilos.textColor : ''}`}
                  style={bodyStyle}
                >
                  {h.horas}
                </span>
              </li>
            ))
          )}
        </ul>
      )
    }
  </section>

  <!-- 3. Contacto y redes -->
  <section class="mt-10 flex w-full flex-col items-center">
    <h3
      class={`w-full text-center text-[0.62rem] font-semibold uppercase tracking-[0.28em] ${estilos.softColor}`}
    >
      Contacto
    </h3>

    <div class="mt-5 flex w-full flex-col gap-3">
      {
        telefono && (
          <a
            href={`tel:${telHref}`}
            class={`flex w-full items-center justify-center rounded-xl border px-4 py-3.5 text-center text-sm tracking-wide transition-transform duration-200 active:scale-95 ${estilos.borderColor} ${estilos.textColor}`}
          >
            <span>
              Llamar: <span class="font-medium">{telefono}</span>
            </span>
          </a>
        )
      }

      {
        emailHref && (
          <a
            href={`mailto:${emailHref}`}
            class={`flex w-full items-center justify-center rounded-xl border px-4 py-3.5 text-center text-sm tracking-wide transition-transform duration-200 active:scale-95 ${estilos.borderColor} ${estilos.textColor}`}
          >
            <span>
              Email: <span class="font-medium">{emailHref}</span>
            </span>
          </a>
        )
      }

      {
        waHref && (
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class={`flex w-full items-center justify-center rounded-xl border px-3 py-3.5 text-center text-[0.62rem] font-semibold uppercase tracking-[0.16em] transition-transform duration-200 active:scale-95 ${estilos.borderColor} ${estilos.textColor}`}
          >
            WhatsApp
          </a>
        )
      }

      {
        redesActivas.length > 0 && (
          <div
            class:list={[
              'grid w-full gap-3',
              redesActivas.length === 1 && 'grid-cols-1',
              redesActivas.length === 2 && 'grid-cols-2',
              redesActivas.length >= 3 && 'grid-cols-2 sm:grid-cols-4',
            ]}
          >
            {redesActivas.map((item) => {
              const meta = socialMeta[item.red] || {
                label: item.red,
                path: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z',
              };
              return (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`flex flex-col items-center justify-center gap-2 rounded-xl border px-3 py-3.5 transition-transform duration-200 active:scale-95 ${estilos.borderColor} ${estilos.textColor}`}
                  aria-label={meta.label}
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-5 w-5"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={meta.path}></path>
                  </svg>
                  <span class="text-[0.55rem] font-semibold uppercase tracking-[0.14em]">
                    {meta.label}
                  </span>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <!-- 4. Ubicación -->
  <section class="mt-10 flex w-full flex-col items-center">
    <h3
      class={`w-full text-center text-[0.62rem] font-semibold uppercase tracking-[0.28em] ${estilos.softColor}`}
    >
      Ubicación
    </h3>

    {
      mapsEmbed ? (
        <div class="mt-5 w-full overflow-hidden rounded-2xl">
          <div class="relative aspect-[16/9] w-full overflow-hidden bg-black/20">
            <iframe
              title="Mapa del restaurante"
              src={mapsEmbed}
              class="pointer-events-none absolute inset-0 h-full w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="absolute inset-0 z-10"
              aria-label="Abrir en Google Maps"
            />
          </div>
        </div>
      ) : null
    }

    <div class="mt-6 grid w-full grid-cols-2 gap-3">
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class={`flex flex-col items-center justify-center gap-2 rounded-xl border px-3 py-4 transition-transform duration-200 active:scale-95 ${estilos.borderColor} ${estilos.textColor}`}
        aria-label="Abrir en Google Maps"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
          <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
        </svg>
        <span class="text-[0.55rem] font-semibold uppercase tracking-[0.16em]">
          Google Maps
        </span>
      </a>
      <a
        href={wazeHref}
        target="_blank"
        rel="noopener noreferrer"
        class={`flex flex-col items-center justify-center gap-2 rounded-xl border px-3 py-4 transition-transform duration-200 active:scale-95 ${estilos.borderColor} ${estilos.textColor}`}
        aria-label="Abrir en Waze"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
          <path d="M12.9 2.2C7.3 2.2 2.8 6.5 2.8 11.8c0 2.6 1.1 4.9 2.8 6.6l-.7 2.6 2.8-.8c1.4.7 3 .9 4.6.9h.1c5.6 0 10.1-4.3 10.1-9.6 0-5.3-4.5-9.3-9.6-9.3zm-1.7 13.3c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9zm3.6 0c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9zm2.2-4.3H7.9c-.3-2.1 1.4-3.9 3.5-4.1.2 0 .3 0 .5 0 2.3.1 4.1 1.9 4.1 4.1z" />
        </svg>
        <span class="text-[0.55rem] font-semibold uppercase tracking-[0.16em]">
          Waze
        </span>
      </a>
    </div>
  </section>
</div>

<style>
  /* Solo feedback estructural / estado — sin cosméticos de marca */
  .horario-row.is-today .horario-dia,
  .horario-row.is-today .horario-horas {
    font-weight: 600;
  }

  [data-live-dot].is-open {
    opacity: 1;
  }

  [data-live-dot].is-closed {
    opacity: 0.35;
  }
</style>

<script>
  import { initUbicacionLivePanels } from '../../lib/ubicacion-live-client.js';

  initUbicacionLivePanels();
  document.addEventListener('astro:page-load', () => initUbicacionLivePanels());
</script>
