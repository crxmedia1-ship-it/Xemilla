---
import {
  NUTRICION_FILTROS_PUBLICOS,
  ALERGENOS_OPTIONS,
} from '../../config/nutricion.js';

interface Plato {
  id?: number;
  nombre: string;
  descripcion: string;
  precio: string;
  imagenUrl?: string | null;
  destacado?: boolean;
  categoriaId?: string;
  categoriaNombre?: string;
  calorias?: number | null;
  proteinas?: number | null;
  carbs?: number | null;
  grasas?: number | null;
  alergias?: string[];
  ingredientesDetalle?: string;
}

interface Props {
  categorias: Array<{
    id: string;
    nombre: string;
    platos: Plato[];
    bgType?: string;
    bgValor?: string;
  }>;
  destacados?: Plato[];
  /** Fondo global del menú (fallback) */
  fondoGlobal?: { tipo?: string; valor?: string };
  /** Gadget nutrición activo — si false, cero rastro DOM */
  showNutricion?: boolean;
  /** VES por 1 USD (BCV) */
  tasaBcv?: number;
  /** VES por 1 EUR (BCV) */
  tasaEur?: number;
  estilos: {
    panelColor: string;
    borderColor: string;
    mutedColor: string;
    softColor: string;
    textColor: string;
    priceColor: string;
    chipIdle: string;
    chipActive: string;
    buttonGhost: string;
    displayClass: string;
  };
}

const {
  categorias,
  destacados = [],
  fondoGlobal = { tipo: 'color', valor: '' },
  showNutricion = false,
  tasaBcv = 766.8603,
  tasaEur = 885.0795,
  estilos,
} = Astro.props;

function hasMedia(url: string | null | undefined) {
  return Boolean(url && String(url).trim());
}

function isVideoUrl(url: string) {
  return /\.(mp4|webm|ogg|mov)(\?|$)/i.test(url) || /\/video\/upload\//i.test(url);
}

function alergiasCsv(plato: Plato) {
  if (!Array.isArray(plato.alergias) || plato.alergias.length === 0) return '';
  return plato.alergias.map((id) => String(id).trim().toLowerCase()).filter(Boolean).join(',');
}

function alergiasLabels(plato: Plato) {
  if (!Array.isArray(plato.alergias) || plato.alergias.length === 0) return [];
  return plato.alergias
    .map((id) => ALERGENOS_OPTIONS.find((opt) => opt.id === id)?.label || id)
    .filter(Boolean);
}

/** Strip currency symbols / whitespace so parseFloat always gets a clean number */
function precioUsd(precio: string): string {
  const n = parseFloat(String(precio).replace(/[^0-9.]/g, ''));
  return isNaN(n) ? '0' : String(n);
}

const CHIP_BASE =
  'border px-4 py-2 text-[0.62rem] font-semibold tracking-[0.2em] uppercase active:scale-95';
const CHIP_ACTIVE =
  'border-[color-mix(in_srgb,var(--color-primario)_65%,transparent)] bg-[var(--color-primario)] text-white shadow-inner';
const CHIP_IDLE =
  'border-white/15 bg-white/5 text-[color:color-mix(in_srgb,var(--color-texto)_55%,transparent)] backdrop-blur-md';

const globalBgType = fondoGlobal.tipo || 'color';
const globalBgValor = fondoGlobal.valor || '';
---

<div
  class="menu-panel relative z-10 min-h-full overflow-x-clip overflow-y-visible bg-transparent pb-[max(2.5rem,env(safe-area-inset-bottom))] text-[color:var(--color-texto)] font-[family-name:var(--fuente-principal)]"
  data-menu-panel
  data-menu-bg-global-type={globalBgType}
  data-menu-bg-global-valor={globalBgValor}
  data-show-nutricion={showNutricion ? 'true' : 'false'}
  data-tasa-bcv={String(tasaBcv)}
  data-tasa-eur={String(tasaEur)}
>
  {/* Capas de fondo dinámico por categoría — morph fluido + fallback global */}
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true" data-menu-bg-root>
    <div
      class="menu-bg-layer absolute inset-0 opacity-100 transition-opacity duration-700 ease-in-out will-change-[opacity]"
      data-menu-bg-layer="global"
      data-active="true"
    >
      {
        globalBgType === 'image' && globalBgValor ? (
          <>
            <div
              class="absolute inset-0 bg-cover bg-center transition-[background-image] duration-700 ease-in-out"
              style={`background-image:url("${globalBgValor.replace(/"/g, '\\"')}")`}
            />
            <div class="absolute inset-0 bg-black/60 backdrop-blur-[1px]" />
          </>
        ) : globalBgType === 'video' && globalBgValor ? (
          <>
            <video
              class="absolute inset-0 h-full w-full object-cover"
              src={globalBgValor}
              autoplay
              muted
              loop
              playsinline
            />
            <div class="absolute inset-0 bg-black/60 backdrop-blur-[1px]" />
          </>
        ) : globalBgValor && globalBgType === 'color' ? (
          <div
            class="absolute inset-0 transition-colors duration-700 ease-in-out"
            style={`background-color:${globalBgValor}`}
          />
        ) : (
          <div class="absolute inset-0 bg-[var(--color-fondo)] transition-colors duration-700 ease-in-out" />
        )
      }
    </div>

    {
      categorias.map((cat) => {
        const tipo = (cat.bgType || 'color').toLowerCase();
        const valor = (cat.bgValor || '').trim();
        if (!valor || (tipo !== 'image' && tipo !== 'video' && tipo !== 'color')) return null;
        return (
          <div
            class="menu-bg-layer absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out will-change-[opacity]"
            data-menu-bg-layer={cat.id}
            data-active="false"
          >
            {tipo === 'image' ? (
              <>
                <div
                  class="absolute inset-0 bg-cover bg-center"
                  style={`background-image:url("${valor.replace(/"/g, '\\"')}")`}
                />
                <div class="absolute inset-0 bg-black/60 backdrop-blur-[1px]" />
              </>
            ) : tipo === 'video' ? (
              <>
                <video
                  class="absolute inset-0 h-full w-full object-cover"
                  src={valor}
                  autoplay
                  muted
                  loop
                  playsinline
                />
                <div class="absolute inset-0 bg-black/60 backdrop-blur-[1px]" />
              </>
            ) : (
              <div
                class="absolute inset-0 transition-colors duration-700 ease-in-out"
                style={`background-color:${valor}`}
              />
            )}
          </div>
        );
      })
    }
  </div>

  <div class="relative z-10">
  <div class="sticky top-0 z-20 border-b border-white/10 bg-[color-mix(in_srgb,var(--color-fondo)_72%,transparent)] backdrop-blur-md">
    <nav
      class="overflow-x-auto whitespace-nowrap scrollbar-none px-4 py-3.5"
      aria-label="Categorías del menú"
      data-menu-cats
    >
      <div class="inline-flex gap-2">
        <button
          type="button"
          data-cat-btn="all"
          data-cat-filter="all"
          class={`menu-chip ${CHIP_BASE} ${CHIP_ACTIVE}`}
        >
          Todos
        </button>
        {
          categorias.map((cat) => (
            <button
              type="button"
              data-cat-btn={cat.id}
              data-cat-filter={cat.id}
              data-cat-bg-type={cat.bgType || ''}
              data-cat-bg-valor={cat.bgValor || ''}
              class={`menu-chip ${CHIP_BASE} ${CHIP_IDLE}`}
            >
              {cat.nombre}
            </button>
          ))
        }
      </div>
    </nav>
    {
      showNutricion && (
        <div class="alergia-bar" data-alergias-filtros aria-label="Filtros de dieta y alérgenos">
          {/* Pills */}
          <div class="alergia-bar__pills" role="group" aria-label="Filtros activos">
            {NUTRICION_FILTROS_PUBLICOS.map((f) => (
              <button
                type="button"
                data-alergia-filtro={f.id}
                data-hides-any={f.hidesAny.join(',')}
                data-hide-unknown={f.hideUnknown ? 'true' : 'false'}
                class="alergia-pill"
                aria-pressed="false"
              >
                <span class="alergia-pill__emoji" aria-hidden="true">{f.emoji}</span>
                <span class="alergia-pill__label">{f.label}</span>
              </button>
            ))}
          </div>
          {/* Reset — always rendered, JS shows/hides */}
          <button
            type="button"
            class="alergia-reset hidden"
            data-alergia-reset
            aria-label="Quitar todos los filtros"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3" aria-hidden="true">
              <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
            </svg>
            Limpiar
          </button>
        </div>
      )
    }

    {/* —— Selector de Divisas —— */}
    <div
      class="currency-bar"
      data-currency-switcher
      data-tasa-bcv={String(tasaBcv)}
      data-tasa-eur={String(tasaEur)}
    >
      <span class="currency-bar__label" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 opacity-60">
          <path d="M10.75 10.818v2.614A3.13 3.13 0 0 0 11.888 13c.482-.315.612-.648.612-.875 0-.227-.13-.56-.612-.875a3.13 3.13 0 0 0-1.138-.432ZM8.33 8.62c.053.055.115.11.184.164.208.16.46.284.736.363V6.603a2.45 2.45 0 0 0-.35.13c-.14.065-.27.143-.386.233-.377.292-.514.627-.514.909 0 .184.058.39.33.576Z" />
          <path fill-rule="evenodd" d="M9.99 1.375a8.625 8.625 0 1 0 0 17.25 8.625 8.625 0 0 0 0-17.25ZM9.24 4a.75.75 0 0 1 .75.75v.628a4.56 4.56 0 0 1 1.794.574c.428.26.909.756.909 1.548 0 .69-.35 1.226-.787 1.554-.25.185-.54.324-.837.406v2.884a3.93 3.93 0 0 0 .88-.36c.303-.186.477-.395.477-.644a.75.75 0 0 1 1.5 0c0 .76-.433 1.38-.915 1.72-.537.378-1.21.605-1.942.667V15a.75.75 0 0 1-1.5 0v-.61a4.907 4.907 0 0 1-1.84-.636c-.479-.291-.962-.8-.962-1.554 0-.76.436-1.28.878-1.576.24-.162.495-.28.754-.36V7.995a2.29 2.29 0 0 0-.469.166c-.16.08-.265.17-.317.236a.75.75 0 1 1-1.17-.94c.27-.336.65-.578 1.01-.739.27-.12.567-.21.946-.267V4.75A.75.75 0 0 1 9.24 4Z" clip-rule="evenodd" />
        </svg>
        Precios
      </span>

      <div class="currency-pill-group" role="group" aria-label="Divisa de visualización">
        <button type="button" class="cpill cpill--active" data-currency-btn="USD" aria-pressed="true">USD</button>
        <button type="button" class="cpill" data-currency-btn="BS" aria-pressed="false">BS</button>
        <button type="button" class="cpill" data-currency-btn="EUR" aria-pressed="false">EUR</button>
      </div>

      <span class="currency-bar__rate" data-currency-rate aria-live="polite">
        Tasa BCV
      </span>
    </div>
  </div>

  {
    destacados.length > 0 && (
      <section
        class="border-b border-white/8 pb-6 pt-6"
        data-destacados
        aria-label="Sugerencias del Chef"
      >
        <h3 class="mb-4 px-5 font-[family-name:var(--fuente-display)] text-[0.78rem] font-semibold tracking-[0.22em] uppercase text-[color:color-mix(in_srgb,var(--color-texto)_70%,transparent)]">
          Sugerencias del Chef
        </h3>
        <div
          class="flex gap-4 overflow-x-auto px-5 pb-1 scrollbar-none snap-x snap-mandatory scroll-smooth [-webkit-overflow-scrolling:touch]"
          data-destacados-track
          aria-roledescription="carrusel"
        >
          {destacados.map((plato) => {
            const mediaUrl = plato.imagenUrl?.trim() || '';
            const video = hasMedia(mediaUrl) && isVideoUrl(mediaUrl);
            const catId = plato.categoriaId || '';
            const catName = plato.categoriaNombre || 'Menú';
            return (
              <button
                type="button"
                class="menu-featured menu-card snap-center shrink-0 w-[min(85%,22rem)] border border-white/10 bg-white/[0.04] text-left active:scale-[0.98]"
                data-reveal
                data-goto-plato={plato.id}
                data-goto-cat={catId}
                data-alergias={alergiasCsv(plato)}
                data-plato-nombre={plato.nombre}
                data-ingredientes={plato.ingredientesDetalle || ''}
                aria-label={`Ir a ${plato.nombre} en ${catName}`}
              >
                <div class="menu-media relative mb-3.5 w-full overflow-hidden bg-black/40 aspect-[4/3]">
                  {hasMedia(mediaUrl) ? (
                    video ? (
                      <span class="flex size-full items-center justify-center text-[0.55rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">
                        Video
                      </span>
                    ) : (
                      <img
                        src={mediaUrl}
                        alt=""
                        data-reveal-media
                        class="size-full object-cover will-change-transform"
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  ) : (
                    <span class="flex size-full items-center justify-center text-[0.55rem] uppercase tracking-[0.18em] text-zinc-600">
                      Sin media
                    </span>
                  )}
                  <span class="chef-cat-badge absolute left-2.5 top-2.5 max-w-[70%] truncate rounded-md border border-white/15 bg-black/45 px-2 py-1 text-[0.52rem] font-semibold uppercase tracking-[0.14em] text-white/90 backdrop-blur-md">
                    {catName}
                  </span>
                </div>
                <h4 class="line-clamp-2 text-[1.05rem] font-semibold leading-snug font-[family-name:var(--fuente-menu,var(--fuente-display))]">
                  {plato.nombre}
                </h4>
                <p class="mt-1.5 text-[1.05rem] font-semibold tabular-nums text-[color:var(--color-texto)] font-[family-name:var(--fuente-menu,var(--fuente-display))]">
                  <span class="precio-dinamico" data-precio-usd={precioUsd(plato.precio)}>${plato.precio}</span>
                </p>
              </button>
            );
          })}
        </div>
      </section>
    )
  }

  <div class="menu-list px-5 pt-7" data-menu-list>
    {
      categorias.map((cat) => (
        <section
          id={`menu-cat-${cat.id}`}
          aria-labelledby={`menu-cat-heading-${cat.id}`}
          data-menu-cat={cat.id}
          data-cat-bg-type={cat.bgType || ''}
          data-cat-bg-valor={cat.bgValor || ''}
          class="menu-cat-section scroll-mt-36"
        >
          <h3
            id={`menu-cat-heading-${cat.id}`}
            class="mb-5 text-[0.65rem] font-semibold tracking-[0.32em] uppercase text-[color:color-mix(in_srgb,var(--color-texto)_55%,transparent)]"
          >
            {cat.nombre}
          </h3>

          <ul class="menu-items" role="list">
            {cat.platos.map((plato) => {
              const mediaUrl = plato.imagenUrl?.trim() || '';
              return (
                <li
                  id={`plato-${plato.id}`}
                  class="menu-plato-item group scroll-mt-40"
                  data-reveal
                  data-plato-id={plato.id}
                  data-alergias={alergiasCsv(plato)}
                  data-plato-nombre={plato.nombre}
                  data-ingredientes={plato.ingredientesDetalle || ''}
                >
                  <div class="flex items-baseline gap-1">
                    <h4 class="min-w-0 flex-1 text-[1.02rem] font-semibold leading-snug font-[family-name:var(--fuente-menu,var(--fuente-display))]">
                      {plato.nombre}
                    </h4>
                    <span class="menu-leader" aria-hidden="true" />
                    <span class="shrink-0 text-[1.05rem] font-semibold tabular-nums tracking-wide text-[color:var(--color-texto)] font-[family-name:var(--fuente-menu,var(--fuente-display))]">
                      <span class="precio-dinamico" data-precio-usd={precioUsd(plato.precio)}>${plato.precio}</span>
                    </span>
                  </div>

                  {plato.descripcion && (
                    <p class="mt-2 w-full text-[0.8rem] leading-relaxed text-[color:color-mix(in_srgb,var(--color-texto)_50%,transparent)]">
                      {plato.descripcion}
                    </p>
                  )}

                  {showNutricion && alergiasLabels(plato).length > 0 && (
                    <p class="mt-1.5 flex flex-wrap gap-1" aria-label="Alérgenos">
                      {alergiasLabels(plato).map((label) => (
                        <span class="alergia-chip">{label}</span>
                      ))}
                    </p>
                  )}

                  {hasMedia(mediaUrl) || showNutricion ? (
                    <button
                      type="button"
                      data-open-detalle
                      data-media-url={mediaUrl}
                      data-media-title={plato.nombre}
                      data-plato-id={plato.id}
                      data-plato-nombre={plato.nombre}
                      data-plato-desc={plato.descripcion || ''}
                      data-plato-calorias={showNutricion ? String(plato.calorias ?? '') : ''}
                      data-plato-proteinas={showNutricion ? String(plato.proteinas ?? '') : ''}
                      data-plato-carbs={showNutricion ? String(plato.carbs ?? '') : ''}
                      data-plato-grasas={showNutricion ? String(plato.grasas ?? '') : ''}
                      data-plato-alergias={showNutricion ? alergiasCsv(plato) : ''}
                      data-plato-ingredientes={showNutricion ? (plato.ingredientesDetalle || '') : ''}
                      data-plato-has-nut={showNutricion ? 'true' : 'false'}
                      class="menu-btn mt-3 border border-white/15 bg-white/5 px-3.5 py-1.5 text-[0.58rem] font-semibold tracking-[0.18em] uppercase text-[color:var(--color-texto)] shadow-inner backdrop-blur-md active:scale-95"
                    >
                      Ver detalle
                    </button>
                  ) : null}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="menu-empty-filtros hidden px-5 pt-8 text-center text-[0.8rem] text-[color:color-mix(in_srgb,var(--color-texto)_45%,transparent)]" data-menu-empty-filtros>
    Ningún plato coincide con esos filtros.
  </p>
  </div>
</div>

<style>
  .menu-chip {
    border-radius: var(--radius-chip, 9999px);
    transition: transform var(--motion-spring, 220ms ease), background-color 200ms ease,
      border-color 200ms ease, color 200ms ease;
  }

  .menu-card,
  .menu-media,
  .menu-btn {
    border-radius: var(--radius-card, 1rem);
  }

  .menu-media {
    border-radius: var(--radius-media, 0.875rem);
  }

  .menu-btn {
    border-radius: var(--radius-button, 9999px);
    transition: transform var(--motion-spring, 220ms ease), opacity 200ms ease;
  }

  .menu-featured {
    padding: var(--pad-card, 1rem);
    transition: transform var(--motion-spring, 220ms ease);
  }

  .menu-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-section, 2.25rem);
  }

  .menu-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-item, 1.25rem);
  }

  .menu-cat-section.is-hidden,
  [data-destacados].is-hidden {
    display: none;
  }

  .menu-plato-item.is-alergia-hidden,
  .menu-featured.is-alergia-hidden {
    display: none !important;
  }

  .menu-plato-item {
    border-radius: var(--radius-card, 0.75rem);
    padding: 0.35rem 0.4rem;
    margin-inline: -0.4rem;
    transition:
      box-shadow 400ms ease,
      background-color 400ms ease,
      transform 400ms ease;
  }

  .menu-plato-item.is-focus-plato {
    background: color-mix(in srgb, var(--color-primario) 12%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-primario) 55%, transparent),
      0 0 24px color-mix(in srgb, var(--color-primario) 22%, transparent);
    transform: scale(1.015);
  }

  /* Scroll reveal — GPU-friendly (opacity + transform only) */
  [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition:
      opacity var(--motion-reveal, 520ms cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--motion-reveal, 520ms cubic-bezier(0.22, 1, 0.36, 1));
  }

  [data-reveal].is-inview {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  [data-reveal-media] {
    opacity: 0;
    transform: scale(0.95);
    transform-origin: center;
    transition:
      opacity var(--motion-reveal, 620ms cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--motion-reveal, 620ms cubic-bezier(0.22, 1, 0.36, 1));
  }

  [data-reveal].is-inview [data-reveal-media] {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-reveal-media],
    .menu-chip,
    .menu-featured,
    .menu-btn,
    .menu-plato-item,
    .precio-dinamico,
    .cpill,
    .alergia-pill {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* ── Currency Bar ────────────────────────────────────────── */
  .currency-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .currency-bar__label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 45%, transparent);
    user-select: none;
  }

  .currency-pill-group {
    display: inline-flex;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
  }

  .cpill {
    padding: 0.28rem 0.72rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 48%, transparent);
    background: transparent;
    border: none;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    line-height: 1.7;
    transition:
      background-color 160ms ease,
      color 140ms ease,
      box-shadow 160ms ease;
  }

  .cpill + .cpill {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cpill:active {
    opacity: 0.7;
  }

  .cpill--active {
    background: var(--color-primario);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .currency-bar__rate {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--color-texto) 40%, transparent);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .currency-bar__rate strong {
    font-weight: 600;
    color: color-mix(in srgb, var(--color-texto) 65%, transparent);
  }

  /* ── Allergen Bar ────────────────────────────────────────── */
  .alergia-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .alergia-bar::-webkit-scrollbar {
    display: none;
  }

  .alergia-bar__pills {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .alergia-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0.28rem 0.65rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease,
      transform 120ms ease;
    user-select: none;
  }

  .alergia-pill__emoji {
    font-size: 0.75rem;
    line-height: 1;
  }

  .alergia-pill__label {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 65%, transparent);
    transition: color 150ms ease;
  }

  .alergia-pill:active {
    transform: scale(0.95);
  }

  .alergia-pill[aria-pressed="true"] {
    background: color-mix(in srgb, var(--color-primario) 90%, transparent);
    border-color: var(--color-primario);
  }

  .alergia-pill[aria-pressed="true"] .alergia-pill__label {
    color: #fff;
  }

  .alergia-reset {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 45%, transparent);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 0.28rem 0.6rem;
    cursor: pointer;
    transition: opacity 150ms ease, background-color 150ms ease;
    white-space: nowrap;
  }

  .alergia-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-texto) 14%, transparent);
    background: color-mix(in srgb, var(--color-texto) 6%, transparent);
    padding: 0.12rem 0.45rem;
    font-size: 0.52rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 55%, transparent);
  }

  .alergia-reset:active {
    opacity: 0.65;
  }

  /* ── Category section collapsed by allergen filter ────────── */
  .menu-cat-section.is-alergia-empty,
  [data-destacados].is-alergia-empty {
    display: none;
  }

  /* ── Dynamic price fade ──────────────────────────────────── */
  .precio-dinamico {
    display: inline-block;
    transition: opacity 130ms ease;
  }

  .precio-dinamico.is-converting {
    opacity: 0;
  }
</style>

<script>
  const CHIP_BASE =
    'menu-chip border px-4 py-2 text-[0.62rem] font-semibold tracking-[0.2em] uppercase active:scale-95';
  const CHIP_ACTIVE =
    'border-[color-mix(in_srgb,var(--color-primario)_65%,transparent)] bg-[var(--color-primario)] text-white shadow-inner';
  const CHIP_IDLE =
    'border-white/15 bg-white/5 text-[color:color-mix(in_srgb,var(--color-texto)_55%,transparent)] backdrop-blur-md';

  const AUTOPLAY_MS = 4000;
  const HIGHLIGHT_MS = 1100;

  /**
   * @param {HTMLElement} track
   */
  function initDestacadosAutoplay(track) {
    if (track.dataset.autoplayReady === 'true') return;
    const cards = Array.from(track.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );
    if (cards.length < 2) return;
    track.dataset.autoplayReady = 'true';

    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;

    const nearestIndex = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((card, i) => {
        const center = card.offsetLeft + card.offsetWidth / 2;
        const dist = Math.abs(center - mid);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    };

    const goTo = (i: number) => {
      index = ((i % cards.length) + cards.length) % cards.length;
      const card = cards[index];
      if (!card) return;
      const left = card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2;
      track.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    const start = () => {
      stop();
      timer = setInterval(() => {
        if (document.hidden) return;
        goTo(index + 1);
      }, AUTOPLAY_MS);
    };

    const resetFromUser = () => {
      stop();
      if (resumeTimer) clearTimeout(resumeTimer);
      index = nearestIndex();
      resumeTimer = setTimeout(() => {
        index = nearestIndex();
        start();
      }, 700);
    };

    track.addEventListener('pointerdown', resetFromUser);
    track.addEventListener('touchstart', resetFromUser, { passive: true });
    track.addEventListener('wheel', resetFromUser, { passive: true });

    let scrollDebounce: ReturnType<typeof setTimeout> | null = null;
    track.addEventListener(
      'scroll',
      () => {
        if (scrollDebounce) clearTimeout(scrollDebounce);
        scrollDebounce = setTimeout(() => {
          index = nearestIndex();
        }, 100);
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }

  /**
   * @param {HTMLElement} panel
   * @param {Element | null} scrollRoot
   */
  function initScrollReveal(panel, scrollRoot) {
    const items = panel.querySelectorAll('[data-reveal]');
    if (!items.length) return;

    if (typeof IntersectionObserver === 'undefined') {
      items.forEach((el) => el.classList.add('is-inview'));
      return;
    }

    const rootEl = scrollRoot instanceof Element ? scrollRoot : null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-inview');
          io.unobserve(entry.target);
        }
      },
      {
        root: rootEl,
        rootMargin: '0px 0px -8% 0px',
        threshold: 0.12,
      },
    );

    items.forEach((el) => io.observe(el));
  }

  /**
   * @param {HTMLElement} target
   */
  function pulsePlatoFocus(target) {
    target.classList.add('is-inview');
    target.classList.remove('is-focus-plato');
    void target.offsetWidth;
    target.classList.add('is-focus-plato');
    setTimeout(() => {
      target.classList.remove('is-focus-plato');
    }, HIGHLIGHT_MS);
  }

  function initMenuPanels() {
    document.querySelectorAll('[data-menu-panel]').forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      if (panel.dataset.ready === 'true') return;
      panel.dataset.ready = 'true';

      const buttons = panel.querySelectorAll('[data-cat-filter]');
      const sections = panel.querySelectorAll('[data-menu-cat]');
      const destacados = panel.querySelector('[data-destacados]');
      const track = panel.querySelector('[data-destacados-track]');
      const sectionEl = panel.closest('[data-section]');
      const scrollRoot =
        sectionEl?.querySelector('.overflow-y-auto') ?? null;

      // Anclar capas de fondo al sheet (no al scroll) para el fade por categoría
      const bgRoot = panel.querySelector('[data-menu-bg-root]');
      if (
        bgRoot instanceof HTMLElement &&
        sectionEl instanceof HTMLElement &&
        bgRoot.parentElement !== sectionEl
      ) {
        sectionEl.insertBefore(bgRoot, sectionEl.firstChild);
        bgRoot.classList.add('absolute', 'inset-0', 'z-0');
      }

      const paintChips = (activeId: string) => {
        buttons.forEach((btn) => {
          if (!(btn instanceof HTMLElement)) return;
          const active = btn.dataset.catFilter === activeId;
          btn.className = `${CHIP_BASE} ${active ? CHIP_ACTIVE : CHIP_IDLE}`;
        });
      };

      /**
       * @param {string} layerId
       */
      const setMenuBg = (layerId: string) => {
        const scope = sectionEl instanceof HTMLElement ? sectionEl : panel;
        const layers = scope.querySelectorAll('[data-menu-bg-layer]');
        let matched = false;
        layers.forEach((layer) => {
          if (!(layer instanceof HTMLElement)) return;
          const id = layer.dataset.menuBgLayer || '';
          const on = id === layerId;
          if (on) matched = true;
          layer.style.opacity = on ? '1' : '0';
          layer.dataset.active = on ? 'true' : 'false';
        });
        if (!matched) {
          const global = scope.querySelector('[data-menu-bg-layer="global"]');
          if (global instanceof HTMLElement) {
            global.style.opacity = '1';
            global.dataset.active = 'true';
          }
        }
      };

      /**
       * @param {string} id
       */
      const resolveBgLayer = (id: string) => {
        if (id === 'all') return 'global';
        const section = panel.querySelector(`[data-menu-cat="${CSS.escape(id)}"]`);
        if (!(section instanceof HTMLElement)) return 'global';
        const tipo = (section.dataset.catBgType || '').toLowerCase();
        const valor = (section.dataset.catBgValor || '').trim();
        if (valor && (tipo === 'image' || tipo === 'video' || tipo === 'color')) {
          return id;
        }
        return 'global';
      };

      const filterByCategory = (id: string) => {
        const showAll = id === 'all';
        sections.forEach((section) => {
          if (!(section instanceof HTMLElement)) return;
          const match = showAll || section.dataset.menuCat === id;
          section.classList.toggle('is-hidden', !match);
          section.setAttribute('aria-hidden', match ? 'false' : 'true');
        });
        if (destacados instanceof HTMLElement) {
          destacados.classList.toggle('is-hidden', !showAll);
        }
        paintChips(id);
        setMenuBg(resolveBgLayer(id));

        const activeChip = panel.querySelector(`[data-cat-filter="${id}"]`);
        if (activeChip instanceof HTMLElement) {
          activeChip.scrollIntoView({
            behavior: 'smooth',
            inline: 'center',
            block: 'nearest',
          });
        }
      };

      // Al scrollear con "Todos", cambia el fondo según la categoría visible
      if (typeof IntersectionObserver !== 'undefined' && scrollRoot) {
        const catIo = new IntersectionObserver(
          (entries) => {
            const allChip = panel.querySelector('[data-cat-filter="all"]');
            const allActive =
              allChip instanceof HTMLElement &&
              allChip.className.includes('bg-[var(--color-primario)]');
            if (!allActive) return;
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (!visible || !(visible.target instanceof HTMLElement)) return;
            const catId = visible.target.dataset.menuCat || '';
            if (catId) setMenuBg(resolveBgLayer(catId));
          },
          {
            root: scrollRoot instanceof Element ? scrollRoot : null,
            threshold: [0.25, 0.45, 0.6],
            rootMargin: '-15% 0px -45% 0px',
          },
        );
        sections.forEach((section) => catIo.observe(section));
      }

      /**
       * @param {string} platoId
       * @param {string} catId
       */
      const goToPlato = (platoId, catId) => {
        if (!platoId) return;
        const filterId = catId || 'all';
        filterByCategory(filterId);

        const target = panel.querySelector(`#plato-${CSS.escape(platoId)}`);
        if (!(target instanceof HTMLElement)) return;

        // Dejar que el layout aplique el filtro antes de scrollear
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            pulsePlatoFocus(target);
          });
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!(btn instanceof HTMLElement)) return;
          const id = btn.dataset.catFilter;
          if (!id) return;
          filterByCategory(id);

          if (scrollRoot instanceof HTMLElement) {
            scrollRoot.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });

      panel.querySelectorAll('[data-goto-plato]').forEach((card) => {
        card.addEventListener('click', () => {
          if (!(card instanceof HTMLElement)) return;
          const platoId = card.dataset.gotoPlato || '';
          const catId = card.dataset.gotoCat || '';
          goToPlato(platoId, catId);
        });
      });

      filterByCategory('all');
      initScrollReveal(panel, scrollRoot);

      if (track instanceof HTMLElement) {
        initDestacadosAutoplay(track);
      }
    });
  }

  // ── Currency Conversion Engine ─────────────────────────────────────────────

  /**
   * Round to n decimal places using integer math to avoid float drift.
   * e.g. roundTo(10.005, 2) = 10.01 (correct), while toFixed alone may not be.
   */
  function roundTo(n: number, decimals: number): number {
    const factor = Math.pow(10, decimals);
    return Math.round((n + Number.EPSILON) * factor) / factor;
  }

  /** "1.234,56 Bs." — Venezuelan thousand-dot, comma-decimal format */
  function formatBS(amount: number): string {
    const fixed = roundTo(amount, 2).toFixed(2);
    const [intPart, decPart] = fixed.split('.');
    const intFormatted = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    return `${intFormatted},${decPart} Bs.`;
  }

  /** "1.234,56 €" — Euro comma-decimal format */
  function formatEUR(amount: number): string {
    const fixed = roundTo(amount, 2).toFixed(2);
    const [intPart, decPart] = fixed.split('.');
    const intFormatted = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    return `${intFormatted},${decPart} €`;
  }

  /** "$1,234.56" — standard US dollar format */
  function formatUSD(amount: number): string {
    const fixed = roundTo(amount, 2).toFixed(2);
    const [intPart, decPart] = fixed.split('.');
    const intFormatted = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return `$${intFormatted}.${decPart}`;
  }

  function initCurrencyEngine(panel: HTMLElement) {
    const switcher = panel.querySelector<HTMLElement>('[data-currency-switcher]');
    if (!switcher) return;

    let usdVes = parseFloat(switcher.dataset.tasaBcv || panel.dataset.tasaBcv || '766.8603');
    let eurVes = parseFloat(switcher.dataset.tasaEur || panel.dataset.tasaEur || '885.0795');
    if (!Number.isFinite(usdVes) || usdVes < 1) usdVes = 766.8603;
    if (!Number.isFinite(eurVes) || eurVes < 1) eurVes = 885.0795;

    const rateEl = switcher.querySelector<HTMLElement>('[data-currency-rate]');
    let current = 'USD';

    const usdToEur = (usd: number) => usd * (usdVes / eurVes);

    const setRateHint = (currency: string) => {
      if (!rateEl) return;
      if (currency === 'EUR') {
        rateEl.innerHTML = `$1 ≈ <strong>${formatEUR(usdToEur(1))}</strong>`;
      } else {
        rateEl.innerHTML = `$1 = <strong>${formatBS(usdVes)}</strong>`;
      }
    };

    const convertAll = (currency: string) => {
      const spans = panel.querySelectorAll<HTMLElement>('.precio-dinamico');
      spans.forEach((el) => el.classList.add('is-converting'));

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          spans.forEach((el) => {
            el.classList.remove('is-converting');
            const usd = parseFloat(el.dataset.precioUsd ?? '');
            if (!Number.isFinite(usd) || usd < 0) return;
            if (currency === 'BS') {
              el.textContent = formatBS(usd * usdVes);
            } else if (currency === 'EUR') {
              el.textContent = formatEUR(usdToEur(usd));
            } else {
              el.textContent = formatUSD(usd);
            }
          });
          setRateHint(currency);
        });
      });
    };

    setRateHint('USD');

    void fetch('/api/tasas-cambio')
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data || !data.ok) return;
        const nextUsd = Number(data.usdVes);
        const nextEur = Number(data.eurVes);
        if (Number.isFinite(nextUsd) && nextUsd > 1) usdVes = nextUsd;
        if (Number.isFinite(nextEur) && nextEur > 1) eurVes = nextEur;
        switcher.dataset.tasaBcv = String(usdVes);
        switcher.dataset.tasaEur = String(eurVes);
        panel.dataset.tasaBcv = String(usdVes);
        panel.dataset.tasaEur = String(eurVes);
        if (current !== 'USD') convertAll(current);
        else setRateHint(current);
      })
      .catch(() => {});

    switcher.addEventListener('click', (e) => {
      const btn = (e.target as Element)?.closest<HTMLElement>('[data-currency-btn]');
      if (!btn) return;
      const currency = btn.dataset.currencyBtn ?? '';
      if (!currency || currency === current) return;
      current = currency;

      switcher.querySelectorAll<HTMLElement>('[data-currency-btn]').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('cpill--active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      convertAll(currency);
    });
  }

  function initAlergiaEngine(panel: HTMLElement) {
    const bar = panel.querySelector<HTMLElement>('[data-alergias-filtros]');
    if (!bar) return;

    const pills = bar.querySelectorAll<HTMLElement>('[data-alergia-filtro]');
    const resetBtn = bar.querySelector<HTMLElement>('[data-alergia-reset]');
    const sections = panel.querySelectorAll<HTMLElement>('[data-menu-cat]');
    const featuredSection = panel.querySelector<HTMLElement>('[data-destacados]');
    const emptyEl = panel.querySelector<HTMLElement>('[data-menu-empty-filtros]');

    const ALIAS: Record<string, string> = {
      trigo: 'gluten',
      wheat: 'gluten',
      celiaco: 'gluten',
      celiac: 'gluten',
      huevos: 'huevo',
      egg: 'huevo',
      lacteo: 'lacteos',
      leche: 'lacteos',
      dairy: 'lacteos',
      peanut: 'mani',
      nuts: 'frutos_secos',
      sesame: 'sesamo',
      spicy: 'picante',
      meat: 'carne',
      carnes: 'carne',
      non_vegan: 'no_vegano',
      novegano: 'no_vegano',
    };

    const canon = (raw: string) => {
      const id = String(raw || '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/\p{M}/gu, '')
        .replace(/[-\s]+/g, '_');
      return ALIAS[id] || id;
    };

    const toIds = (raw: string): Set<string> => {
      return new Set(
        String(raw || '')
          .split(/[,|;]/)
          .map(canon)
          .filter(Boolean),
      );
    };

    const looksAnimal = (nombre: string) =>
      /res\b|jam[oó]n|hamburg|ribeye|steak|pork|belly|carne|pollo|cerdo|chorizo|bacon|lomo|filete|pescado|at[uú]n|salm[oó]n|camar[oó]n|marisco|calamar|pulpo|langost|ternera|cordero|pavo|nugget|alita|costilla|tocino|mortadela|chicharr[oó]n|ib[eé]rico|smash|carpaccio/i.test(
        nombre,
      );

    const GLUTEN_HINT =
      /gluten|\btrigo\b|\bwheat\b|centeno|cebada|espelta|pan\s*rallad|harina\s+de\s+trigo|bread\s*crumb/i;
    const LACTEOS_HINT =
      /\bl[aá]cteo|\bleche\b|mantequilla|queso|crema|yogur|bechamel|dairy|\bbutter\b|\bcheese\b/i;
    const NUTS_HINT =
      /fruto[s]?\s*seco|\bmani\b|\bnuez|\balmendr|cacahuate|pistachio|avellana|\bpeanut|\bwalnut/i;
    const PICANTE_HINT = /picante|ají|aji\b|chile|habanero|cayena|sriracha|spicy/i;

    const textoCubre = (filtroId: string, blob: string) => {
      if (filtroId === 'sin_gluten') return GLUTEN_HINT.test(blob);
      if (filtroId === 'sin_lacteos') return LACTEOS_HINT.test(blob);
      if (filtroId === 'sin_frutos_secos') return NUTS_HINT.test(blob);
      if (filtroId === 'sin_picante') return PICANTE_HINT.test(blob);
      return false;
    };

    const apply = () => {
      const activePills = Array.from(pills).filter(
        (p) => p.getAttribute('aria-pressed') === 'true',
      );
      const hasActive = activePills.length > 0;
      if (resetBtn) resetBtn.classList.toggle('hidden', !hasActive);

      const allItems = panel.querySelectorAll<HTMLElement>(
        '.menu-plato-item, .menu-featured',
      );
      allItems.forEach((item) => {
        const itemAlergias = toIds(item.dataset.alergias ?? '');
        const nombre = item.dataset.platoNombre || '';
        const blob = `${nombre} ${item.dataset.ingredientes || ''}`;
        let hide = false;
        if (hasActive) {
          hide = activePills.some((pill) => {
            const filtroId = pill.dataset.alergiaFiltro || '';
            const hides = toIds(pill.dataset.hidesAny ?? '');
            const hideUnknown = pill.dataset.hideUnknown === 'true';
            const isVegan = filtroId === 'vegano';
            if (hideUnknown && itemAlergias.size === 0) return true;
            if (isVegan && looksAnimal(nombre)) return true;
            for (const id of hides) {
              if (itemAlergias.has(id)) return true;
            }
            if (textoCubre(filtroId, blob)) return true;
            return false;
          });
        }
        item.classList.toggle('is-alergia-hidden', hide);
        item.setAttribute('aria-hidden', hide ? 'true' : 'false');
      });

      sections.forEach((section) => {
        if (section.classList.contains('is-hidden')) return;
        const items = section.querySelectorAll<HTMLElement>('.menu-plato-item');
        const allHidden =
          items.length > 0 &&
          Array.from(items).every((it) => it.classList.contains('is-alergia-hidden'));
        section.classList.toggle('is-alergia-empty', allHidden);
      });

      if (featuredSection) {
        const featuredItems = featuredSection.querySelectorAll<HTMLElement>('.menu-featured');
        const allHidden =
          featuredItems.length > 0 &&
          Array.from(featuredItems).every((it) => it.classList.contains('is-alergia-hidden'));
        featuredSection.classList.toggle('is-alergia-empty', allHidden);
      }

      if (emptyEl) {
        const visible = Array.from(allItems).some((item) => {
          if (item.classList.contains('is-alergia-hidden')) return false;
          const section = item.closest('[data-menu-cat], [data-destacados]');
          if (section instanceof HTMLElement && section.classList.contains('is-hidden')) {
            return false;
          }
          return true;
        });
        emptyEl.classList.toggle('hidden', !hasActive || visible);
      }
    };

    bar.addEventListener('click', (e) => {
      const pill = (e.target as Element)?.closest<HTMLElement>('[data-alergia-filtro]');
      if (pill && bar.contains(pill)) {
        const next = pill.getAttribute('aria-pressed') !== 'true';
        pill.setAttribute('aria-pressed', next ? 'true' : 'false');
        apply();
        return;
      }
      const reset = (e.target as Element)?.closest<HTMLElement>('[data-alergia-reset]');
      if (reset) {
        pills.forEach((p) => p.setAttribute('aria-pressed', 'false'));
        apply();
      }
    });
  }

  // ── Boot ───────────────────────────────────────────────────────────────────

  function initAllEngines() {
    document.querySelectorAll<HTMLElement>('[data-menu-panel]').forEach((panel) => {
      // Currency engine (idempotent via flag)
      if (panel.dataset.currencyReady !== 'true') {
        panel.dataset.currencyReady = 'true';
        initCurrencyEngine(panel);
      }
      // Allergen engine (idempotent via flag)
      if (panel.dataset.alergiaReady !== 'true') {
        panel.dataset.alergiaReady = 'true';
        initAlergiaEngine(panel);
      }
    });
  }

  function boot() {
    initMenuPanels();
    initAllEngines();
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
