---
import {
  NUTRICION_FILTROS_PUBLICOS,
} from '../../config/nutricion.js';
import {
  resolveNosotrosFuenteTitulo,
  resolveNosotrosFuenteCuerpo,
  buildNosotrosFontsHref,
} from '../../config/nosotros-typography.js';
import { normalizeChipsLayout, normalizeChipsEstilo, normalizePlatosLayout, normalizeEstiloTarjetas, expandMenuMasterTokens } from '../../lib/secciones-ui.js';

interface Plato {
  id?: number;
  nombre: string;
  descripcion: string;
  precio: string;
  imagenUrl?: string | null;
  destacado?: boolean;
  categoriaId?: string;
  categoriaNombre?: string;
  calorias?: number | null;
  proteinas?: number | null;
  carbs?: number | null;
  grasas?: number | null;
  alergias?: string[];
  ingredientesDetalle?: string;
  modelo3dUrl?: string;
}

interface Props {
  categorias: Array<{
    id: string;
    nombre: string;
    platos: Plato[];
    bgType?: string;
    bgValor?: string;
  }>;
  destacados?: Plato[];
  /** Fondo global del menú (fallback) */
  fondoGlobal?: { tipo?: string; valor?: string };
  /** Cross-fade vive en SectionAtmosphere; el panel no apila capas */
  cinematicCategoryBg?: boolean;
  /** Gadget nutrición activo — si false, cero rastro DOM */
  showNutricion?: boolean;
  /** Gadget AR activo — si true, emite data-plato-modelo3d-url en cada botón */
  showAr?: boolean;
  /** VES por 1 USD (BCV) — fallback visual si no hay tasa en vivo */
  tasaBcv?: number;
  /** EUR por 1 USD — fallback visual */
  tasaEurUsd?: number;
  /** VES por 1 EUR (BCV) — opcional, solo para hint de tasa */
  tasaEur?: number;
  menuUi?: {
    color_fondo?: string;
    color_texto?: string;
    color_acento?: string;
    chips_layout?: string;
    chips_estilo?: string;
    platos_layout?: string;
    estilo_tarjetas?: string;
    fuente_titulo?: string;
    fuente_cuerpo?: string;
  };
  menuFont?: string;
  estilos: {
    panelColor: string;
    borderColor: string;
    mutedColor: string;
    softColor: string;
    textColor: string;
    priceColor: string;
    chipIdle: string;
    chipActive: string;
    buttonGhost: string;
    displayClass: string;
  };
}

const {
  categorias = [],
  destacados = [],
  fondoGlobal = { tipo: 'color', valor: '' },
  cinematicCategoryBg = false,
  showNutricion = false,
  showAr = false,
  tasaBcv = 36.5,
  tasaEurUsd = 0.92,
  tasaEur = 0,
  menuUi = {},
  menuFont = '',
  estilos,
} = Astro.props;

function hasMedia(url: string | null | undefined) {
  return Boolean(url && String(url).trim());
}

function isVideoUrl(url: string) {
  return /\.(mp4|webm|ogg|mov)(\?|$)/i.test(url) || /\/video\/upload\//i.test(url);
}

function alergiasCsv(plato: Plato) {
  if (!Array.isArray(plato.alergias) || plato.alergias.length === 0) return '';
  return plato.alergias.map((id) => String(id).trim().toLowerCase()).filter(Boolean).join(',');
}

/** Valor base USD limpio para data-precio-usd */
function precioUsd(precio: string): string {
  const raw = String(precio ?? '').trim();
  if (!raw) return '0.00';
  const normalized =
    raw.includes(',') && !raw.includes('.') ? raw.replace(',', '.') : raw;
  const n = Number.parseFloat(normalized.replace(/[^0-9.]/g, ''));
  return Number.isFinite(n) ? n.toFixed(2) : '0.00';
}

const CHIP_BASE =
  'border px-4 py-2 text-[0.62rem] font-semibold tracking-[0.2em] uppercase active:scale-95';

const globalBgType = fondoGlobal.tipo || 'color';
const globalBgValor = fondoGlobal.valor || '';
const chipsLayout = normalizeChipsLayout(menuUi.chips_layout);
const chipsEstilo = normalizeChipsEstilo(menuUi.chips_estilo);
const platosLayout = normalizePlatosLayout(menuUi.platos_layout);
const estiloTarjetas = normalizeEstiloTarjetas(menuUi.estilo_tarjetas);
const menuTokens = expandMenuMasterTokens(menuUi);
const accentColor = menuUi.color_acento || menuTokens.color_chip_activo || '';
const detalleBtnStyle = accentColor
  ? `background-color:${accentColor};border-color:${accentColor};color:#ffffff`
  : '';
const platoCardSurfaceClass =
  estiloTarjetas === 'solido'
    ? 'bg-zinc-900 border border-white/5 shadow-xl'
    : 'bg-black/40 backdrop-blur-xl border border-white/10 shadow-2xl';
const chipsNavClass =
  chipsLayout === 'scroll'
    ? 'menu-chips-nav overflow-x-auto whitespace-nowrap scrollbar-none px-4 py-3.5'
    : 'menu-chips-nav menu-chips-nav--static px-4 py-3.5';
const chipsRowClass =
  chipsLayout === 'grid'
    ? 'menu-chips-row menu-chips-row--grid gap-2'
    : chipsLayout === 'wrap'
      ? 'menu-chips-row menu-chips-row--wrap gap-2'
      : 'menu-chips-row menu-chips-row--scroll inline-flex gap-2';
const fuenteTitulo = resolveNosotrosFuenteTitulo(menuUi.fuente_titulo || menuFont || 'playfair');
const fuenteCuerpo = resolveNosotrosFuenteCuerpo(menuUi.fuente_cuerpo || 'plus-jakarta');
const fontsHref = buildNosotrosFontsHref(fuenteTitulo.id, fuenteCuerpo.id);

const menuPanelStyle = [
  menuUi.color_texto || menuTokens.color_texto
    ? `--menu-texto-color:${menuUi.color_texto || menuTokens.color_texto}`
    : '',
  menuUi.color_fondo || menuTokens.color_chip
    ? `--menu-surface-color:${menuUi.color_fondo || menuTokens.color_chip}`
    : '',
  menuUi.color_acento || menuTokens.color_chip_activo
    ? `--menu-accent-color:${menuUi.color_acento || menuTokens.color_chip_activo}`
    : '',
  menuTokens.color_titulo ? `--menu-titulo-color:${menuTokens.color_titulo}` : '',
  menuTokens.color_header ? `--menu-header-color:${menuTokens.color_header}` : '',
  menuTokens.color_precio ? `--menu-precio-color:${menuTokens.color_precio}` : '',
  menuTokens.color_chip ? `--menu-chip-bg:${menuTokens.color_chip}` : '',
  menuTokens.color_chip_texto ? `--menu-chip-texto:${menuTokens.color_chip_texto}` : '',
  menuTokens.color_chip_activo ? `--menu-chip-activo:${menuTokens.color_chip_activo}` : '',
  menuTokens.color_boton ? `--menu-boton-bg:${menuTokens.color_boton}` : '',
  menuTokens.color_boton_texto ? `--menu-boton-texto:${menuTokens.color_boton_texto}` : '',
  `--menu-font-heading:${fuenteTitulo.stack}`,
  `--menu-font-body:${fuenteCuerpo.stack}`,
  globalBgTipoColor(),
]
  .filter(Boolean)
  .join(';');

function globalBgTipoColor() {
  if (globalBgType === 'color' && globalBgValor) {
    return `--menu-sticky-bg:${globalBgValor}`;
  }
  return '';
}
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontsHref} />

<div
  class="menu-panel relative z-10 min-h-full overflow-x-clip overflow-y-visible bg-transparent pb-[max(2.5rem,env(safe-area-inset-bottom))] text-[color:var(--menu-cuerpo-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-body,var(--fuente-menu,var(--fuente-display)))]"
  data-menu-panel
  data-menu-filter="all"
  data-cinematic-cat-bg={cinematicCategoryBg ? 'true' : 'false'}
  data-menu-bg-global-type={globalBgType}
  data-menu-bg-global-valor={globalBgValor}
  data-show-nutricion={showNutricion ? 'true' : 'false'}
  data-tasa-bcv={String(tasaBcv)}
  data-tasa-eur-usd={String(tasaEurUsd)}
  data-tasa-eur={String(tasaEur || '')}
  data-chips-layout={chipsLayout}
  data-chips-estilo={chipsEstilo}
  data-platos-layout={platosLayout}
  data-estilo-tarjetas={estiloTarjetas}
  style={menuPanelStyle || undefined}
>
  <div class="relative z-10">
  <div class="sticky top-0 z-20 border-b border-white/10 menu-sticky">
    <nav class={chipsNavClass} aria-label="Categorías del menú" data-menu-cats>
      <div class={chipsRowClass}>
        <button
          type="button"
          data-cat-btn="all"
          data-cat-filter="all"
          class={`tab-categoria menu-chip ${CHIP_BASE} is-active`}
        >
          Todos
        </button>
        {
          (categorias || []).map((cat) => (
            <button
              type="button"
              data-cat-btn={cat.id}
              data-cat-filter={cat.id}
              data-cat-bg-type={cat.bgType || ''}
              data-cat-bg-valor={cat.bgValor || ''}
              class={`tab-categoria menu-chip ${CHIP_BASE}`}
            >
              {cat.nombre}
            </button>
          ))
        }
      </div>
    </nav>
    {
      showNutricion && (
        <div class="alergia-bar" data-alergias-filtros aria-label="Filtros de dieta y alérgenos">
          {/* Pills */}
          <div class="alergia-bar__pills" role="group" aria-label="Filtros activos">
            {NUTRICION_FILTROS_PUBLICOS.map((f) => (
              <button
                type="button"
                data-alergia-filtro={f.id}
                data-hides-any={f.hidesAny.join(',')}
                data-hide-unknown={f.hideUnknown ? 'true' : 'false'}
                class="alergia-pill"
                aria-pressed="false"
              >
                <span class="alergia-pill__emoji" aria-hidden="true">{f.emoji}</span>
                <span class="alergia-pill__label">{f.label}</span>
              </button>
            ))}
          </div>
          {/* Reset — always rendered, JS shows/hides */}
          <button
            type="button"
            class="alergia-reset hidden"
            data-alergia-reset
            aria-label="Quitar todos los filtros"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3" aria-hidden="true">
              <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
            </svg>
            Limpiar
          </button>
        </div>
      )
    }

    {/* —— Selector de Divisas (visual, client-side) —— */}
    <div
      class="currency-bar mx-[0.85rem] mb-3 mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl border border-white/10 bg-black/40 p-2 shadow-lg backdrop-blur-xl"
      data-currency-switcher
      data-tasa-bcv={String(tasaBcv)}
      data-tasa-eur-usd={String(tasaEurUsd)}
      data-tasa-eur={String(tasaEur || '')}
    >
      <span class="currency-bar__label" aria-hidden="true">
        Precios
      </span>

      <div class="currency-pill-group" role="group" aria-label="Divisa de visualización">
        <button type="button" class="cpill cpill--active" data-currency-btn="USD" aria-pressed="true">USD</button>
        <button type="button" class="cpill" data-currency-btn="BS" aria-pressed="false">BS</button>
        <button type="button" class="cpill" data-currency-btn="EUR" aria-pressed="false">EUR</button>
      </div>

      <span class="currency-bar__rate" data-currency-rate aria-live="polite">
        Tasa BCV
      </span>
    </div>
  </div>

  {
    destacados.length > 0 && (
      <section
        class="border-b border-white/8 pb-6 pt-6"
        data-destacados
        aria-label="Sugerencias del Chef"
      >
        <h3 class="mb-4 px-5 font-[family-name:var(--menu-font-heading,var(--fuente-display))] text-[0.78rem] font-semibold tracking-[0.22em] uppercase text-[color:var(--menu-titulo-color,color-mix(in_srgb,var(--menu-texto-color,var(--color-texto))_70%,transparent))]">
          Sugerencias del Chef
        </h3>
        <div
          class="flex gap-4 overflow-x-auto px-5 pb-1 scrollbar-none snap-x snap-mandatory scroll-smooth [-webkit-overflow-scrolling:touch]"
          data-destacados-track
          aria-roledescription="carrusel"
        >
          {destacados.map((plato) => {
            const mediaUrl = plato.imagenUrl?.trim() || '';
            const video = hasMedia(mediaUrl) && isVideoUrl(mediaUrl);
            const catId = plato.categoriaId || '';
            const catName = plato.categoriaNombre || 'Menú';
            return (
              <button
                type="button"
                class="menu-featured menu-card snap-center shrink-0 w-[min(85%,22rem)] border border-white/10 bg-white/[0.04] text-left active:scale-[0.98]"
                data-reveal
                data-goto-plato={plato.id}
                data-goto-cat={catId}
                data-alergias={alergiasCsv(plato)}
                data-plato-nombre={plato.nombre}
                data-ingredientes={plato.ingredientesDetalle || ''}
                aria-label={`Ir a ${plato.nombre} en ${catName}`}
              >
                <div class="menu-media relative mb-3.5 w-full overflow-hidden bg-black/40 aspect-[4/3]">
                  {hasMedia(mediaUrl) ? (
                    video ? (
                      <span class="flex size-full items-center justify-center text-[0.55rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">
                        Video
                      </span>
                    ) : (
                      <img
                        src={mediaUrl}
                        alt=""
                        data-reveal-media
                        class="size-full object-cover will-change-transform"
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  ) : (
                    <span class="flex size-full items-center justify-center text-[0.55rem] uppercase tracking-[0.18em] text-zinc-600">
                      Sin media
                    </span>
                  )}
                  <span class="chef-cat-badge absolute left-2.5 top-2.5 max-w-[70%] truncate rounded-md border border-white/15 bg-black/45 px-2 py-1 text-[0.52rem] font-semibold uppercase tracking-[0.14em] text-white/90 backdrop-blur-md">
                    {catName}
                  </span>
                </div>
                <h4 class="line-clamp-2 text-[1.05rem] font-semibold leading-snug font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))] text-[color:var(--menu-titulo-color,var(--menu-texto-color,inherit))]">
                  {plato.nombre}
                </h4>
                <p class="mt-1.5 text-[1.05rem] font-semibold tabular-nums text-[color:var(--menu-precio-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))]">
                  <span class="precio-dinamico" data-precio-usd={precioUsd(plato.precio)}>${precioUsd(plato.precio)}</span>
                </p>
              </button>
            );
          })}
        </div>
      </section>
    )
  }

  <div class="menu-list px-5 pt-7" data-menu-list>
    {
      (categorias || []).map((cat) => (
        <section
          id={`menu-cat-${cat.id}`}
          aria-labelledby={`menu-cat-heading-${cat.id}`}
          data-menu-cat={cat.id}
          data-cat-bg-type={cat.bgType || ''}
          data-cat-bg-valor={cat.bgValor || ''}
          class="menu-cat-section scroll-mt-36"
        >
          <h3
            id={`menu-cat-heading-${cat.id}`}
            class="mb-5 text-[0.65rem] font-semibold tracking-[0.32em] uppercase text-[color:var(--menu-titulo-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))]"
          >
            {cat.nombre}
          </h3>

          <ul class="menu-items" role="list">
            {(cat.platos || []).map((plato) => {
              const mediaUrl = plato.imagenUrl?.trim() || '';
              return (
                <li
                  id={`plato-${plato.id}`}
                  class:list={[
                    'menu-plato-item group scroll-mt-40',
                    platoCardSurfaceClass,
                    hasMedia(mediaUrl) && platosLayout === 'bento' && 'menu-plato-item--bento-media',
                  ]}
                  data-reveal
                  data-plato-id={plato.id}
                  data-alergias={alergiasCsv(plato)}
                  data-plato-nombre={plato.nombre}
                  data-ingredientes={plato.ingredientesDetalle || ''}
                  data-has-media={hasMedia(mediaUrl) ? 'true' : 'false'}
                  data-estilo-tarjeta={estiloTarjetas}
                >
                  {
                    platosLayout === 'bento' && hasMedia(mediaUrl) && !isVideoUrl(mediaUrl) ? (
                      <div class="menu-bento-media mb-3 overflow-hidden rounded-xl border border-white/10 bg-black/30">
                        <img
                          src={mediaUrl}
                          alt=""
                          class="h-36 w-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ) : null
                  }
                  <div class="flex items-baseline gap-1">
                    <h4 class="min-w-0 flex-1 text-[1.02rem] font-semibold leading-snug font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))] text-[color:var(--menu-titulo-color,var(--menu-texto-color,inherit))]">
                      {plato.nombre}
                    </h4>
                    <span class="menu-leader" aria-hidden="true" />
                    <span class="shrink-0 text-[1.05rem] font-semibold tabular-nums tracking-wide text-[color:var(--menu-precio-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))]">
                      <span class="precio-dinamico" data-precio-usd={precioUsd(plato.precio)}>${precioUsd(plato.precio)}</span>
                    </span>
                  </div>

                  {plato.descripcion && (
                    <p class="menu-plato-desc mt-2 w-full text-[0.8rem] leading-relaxed text-current/70 font-[family-name:var(--menu-font-body,inherit)]">
                      {plato.descripcion}
                    </p>
                  )}

                  {hasMedia(mediaUrl) || showNutricion || (showAr && plato.modelo3dUrl) ? (
                    <button
                      type="button"
                      data-open-detalle
                      data-media-url={mediaUrl}
                      data-media-title={plato.nombre}
                      data-plato-id={plato.id}
                      data-plato-nombre={plato.nombre}
                      data-plato-desc={plato.descripcion || ''}
                      data-plato-calorias={showNutricion ? String(plato.calorias ?? '') : ''}
                      data-plato-proteinas={showNutricion ? String(plato.proteinas ?? '') : ''}
                      data-plato-carbs={showNutricion ? String(plato.carbs ?? '') : ''}
                      data-plato-grasas={showNutricion ? String(plato.grasas ?? '') : ''}
                      data-plato-alergias={showNutricion ? alergiasCsv(plato) : ''}
                      data-plato-has-nut={showNutricion ? 'true' : 'false'}
                      data-plato-modelo3d-url={plato.modelo3dUrl || ''}
                      class="menu-btn menu-btn--detalle mt-3"
                      style={detalleBtnStyle || undefined}
                    >
                      Ver detalle
                      <span aria-hidden="true">›</span>
                    </button>
                  ) : null}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="menu-empty-filtros hidden px-5 pt-8 text-center text-[0.8rem] text-[color:color-mix(in_srgb,var(--color-texto)_45%,transparent)]" data-menu-empty-filtros>
    Ningún plato coincide con esos filtros.
  </p>
  </div>
</div>

<style>
  .menu-panel {
    color: var(--menu-texto-color, var(--color-texto));
    font-family: var(--menu-font-body, var(--fuente-menu, var(--fuente-display)));
  }

  .menu-plato-desc {
    color: color-mix(in srgb, var(--menu-texto-color, var(--color-texto)) 70%, transparent);
  }

  .menu-sticky {
    background: color-mix(in srgb, var(--menu-sticky-bg, var(--color-fondo)) 90%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .menu-chip {
    border-radius: var(--radius-chip, 9999px);
    background: var(--menu-chip-bg, color-mix(in srgb, var(--menu-surface-color, currentColor) 88%, transparent));
    color: var(
      --menu-chip-texto,
      color-mix(in srgb, var(--menu-texto-color, var(--color-texto)) 70%, transparent)
    );
    border-color: color-mix(in srgb, var(--menu-chip-texto, currentColor) 22%, transparent);
    transition: transform var(--motion-spring, 220ms ease), background-color 200ms ease,
      border-color 200ms ease, color 200ms ease;
  }

  .menu-chip.is-active {
    background: var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario)));
    color: #fff;
    border-color: color-mix(
      in srgb,
      var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario))) 80%,
      transparent
    );
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 18%, transparent);
  }

  .menu-chips-nav--static {
    overflow: visible;
    white-space: normal;
  }

  .menu-chips-row--scroll {
    width: max-content;
    min-width: min(100%, max-content);
  }

  .menu-panel[data-chips-layout='wrap'] .menu-chips-row--wrap {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .menu-panel[data-chips-layout='wrap'] .menu-chip {
    flex: 0 1 auto;
    max-width: 100%;
  }

  .menu-panel[data-chips-layout='grid'] .menu-chips-row--grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }

  @media (min-width: 640px) {
    .menu-panel[data-chips-layout='grid'] .menu-chips-row--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .menu-panel[data-chips-layout='grid'] .menu-chip {
    width: 100%;
    min-height: 2.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding-inline: 0.65rem;
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .menu-panel[data-chips-estilo='cuadrado'] .menu-chip {
    border-radius: 0.55rem;
  }

  .menu-panel[data-chips-estilo='linea'] .menu-chip {
    background: transparent;
    border-color: color-mix(in srgb, var(--menu-chip-texto, currentColor) 28%, transparent);
    box-shadow: none;
  }

  .menu-panel[data-chips-estilo='linea'] .menu-chip.is-active {
    background: transparent;
    color: var(--menu-chip-activo, var(--color-primario));
    border-color: var(--menu-chip-activo, var(--color-primario));
  }

  .menu-panel[data-chips-layout='scroll'][data-chips-estilo='linea'] .menu-chip {
