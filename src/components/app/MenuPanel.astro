  .menu-chip:hover {
    border-color: color-mix(in srgb, var(--menu-accent-color, var(--color-primario)) 42%, transparent);
  }

  .menu-chip.is-active {
    background: var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario)));
    color: #fff;
    border-color: color-mix(
      in srgb,
      var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario))) 85%,
      transparent
    );
    box-shadow:
      0 0 0 1px color-mix(in srgb, #fff 12%, transparent) inset,
      0 8px 20px color-mix(in srgb, var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario))) 28%, transparent);
  }

  /* —— Wrap fluido —— */
  .menu-panel[data-chips-layout='wrap'] .menu-chips-row--wrap {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: 0.45rem;
  }

  .menu-panel[data-chips-layout='wrap'] .menu-chip {
    flex: 0 1 auto;
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }

  /* —— Grids de categorías (responsive por ancho real del panel) —— */
  .menu-panel[data-chips-layout='grid'] .menu-chips-row--grid,
  .menu-panel[data-chips-layout='grid-3'] .menu-chips-row--grid {
    display: grid;
    width: 100%;
    gap: 0.45rem;
  }

  .menu-panel[data-chips-layout='grid'] .menu-chips-row--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .menu-panel[data-chips-layout='grid-3'] .menu-chips-row--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .menu-panel[data-chips-layout='grid'] .menu-chip,
  .menu-panel[data-chips-layout='grid-3'] .menu-chip {
    width: 100%;
    min-height: 2.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: normal;
    line-height: 1.25;
    letter-spacing: 0.12em;
    padding: 0.55rem 0.55rem;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .menu-panel[data-chips-layout='grid-3'] .menu-chip {
    min-height: 2.55rem;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    padding-inline: 0.35rem;
  }

  @container menu (min-width: 28rem) {
    .menu-panel[data-chips-layout='grid-3'] .menu-chips-row--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .menu-panel[data-chips-layout='grid-3'] .menu-chip {
      font-size: 0.62rem;
      min-height: 2.65rem;
    }
  }

  @container menu (min-width: 36rem) {
    .menu-panel[data-chips-layout='grid'] .menu-chips-row--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container menu (min-width: 52rem) {
    .menu-panel[data-chips-layout='grid'] .menu-chips-row--grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.55rem;
    }

    .menu-panel[data-chips-layout='grid-3'] .menu-chips-row--grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.55rem;
    }
  }

  .menu-panel[data-chips-estilo='cuadrado'] .menu-chip {
    border-radius: 0.7rem;
  }

  .menu-panel[data-chips-estilo='linea'] .menu-chip {
    background: transparent;
    border-color: color-mix(in srgb, var(--menu-chip-texto, currentColor) 24%, transparent);
    box-shadow: none;
  }

  .menu-panel[data-chips-estilo='linea'] .menu-chip.is-active {
    background: color-mix(in srgb, var(--menu-chip-activo, var(--color-primario)) 14%, transparent);
    color: var(--menu-chip-activo, var(--color-primario));
    border-color: var(--menu-chip-activo, var(--color-primario));
    box-shadow: none;
  }

  .menu-panel[data-chips-layout='scroll'][data-chips-estilo='linea'] .menu-chip {
    border-radius: 0;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    padding-inline: 0.9rem;
    box-shadow: none;
  }

  .menu-panel[data-chips-layout='scroll'][data-chips-estilo='linea'] .menu-chip.is-active {
    color: var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario)));
    border-bottom-color: var(--menu-chip-activo, var(--menu-accent-color, var(--color-primario)));
