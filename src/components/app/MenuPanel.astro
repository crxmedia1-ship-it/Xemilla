    margin-bottom: 0.15rem;
    padding: 0.16rem 0.45rem;
    border: 1.5px solid var(--menu-accent-color, #e11d48);
    border-radius: 0.3rem;
    color: var(--menu-accent-color, #e11d48);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: rotate(-8deg);
    pointer-events: none;
    user-select: none;
  }

  .menu-featured--promo {
    border-color: color-mix(in srgb, var(--menu-accent-color, #e11d48) 45%, rgba(255, 255, 255, 0.1));
  }

  /* —— Sugerencias del Chef: grid compacto —— */
  [data-destacados-estilo='scroll'] [data-destacados-track] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
    overflow: visible;
    padding-left: max(var(--menu-gutter-x), env(safe-area-inset-left, 0px));
    padding-right: max(var(--menu-gutter-x), env(safe-area-inset-right, 0px));
    scroll-snap-type: none;
  }

  [data-destacados-estilo='scroll'] .menu-featured {
    width: 100%;
    padding: 0.4rem;
    scroll-snap-align: unset;
  }

  [data-destacados-estilo='scroll'] .menu-featured:only-child {
    grid-column: span 1;
    max-width: 10.5rem;
    justify-self: start;
  }

  [data-destacados-estilo='scroll'] .menu-featured__media {
    margin-bottom: 0.35rem;
  }

  [data-destacados-estilo='scroll'] .menu-featured__title {
    font-size: 0.68rem !important;
    line-height: 1.2;
  }

  [data-destacados-estilo='scroll'] .menu-featured__price {
    font-size: 1rem !important;
    font-weight: 700;
    margin-top: 0.15rem !important;
  }

  [data-destacados-estilo='scroll'] .menu-featured__media img {
    object-position: center;
  }

  @media (max-width: 767px) {
    /* Teléfono: carrusel 1×1 lento (Sugerencias del Chef) */
    [data-destacados-estilo='scroll'] [data-destacados-track],
    [data-destacados-estilo='carrusel'] [data-destacados-track] {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--menu-gutter-x), env(safe-area-inset-left, 0px));
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-left: max(var(--menu-gutter-x), env(safe-area-inset-left, 0px));
      padding-right: max(var(--menu-gutter-x), env(safe-area-inset-right, 0px));
    }

    [data-destacados-estilo='scroll'] [data-destacados-track]::-webkit-scrollbar,
    [data-destacados-estilo='carrusel'] [data-destacados-track]::-webkit-scrollbar {
      display: none;
    }

    [data-destacados-estilo='scroll'] .menu-featured,
    [data-destacados-estilo='carrusel'] .menu-featured {
      width: var(--featured-w);
      flex-shrink: 0;
      scroll-snap-align: center;
      padding: 0.55rem;
    }

    [data-destacados-estilo='scroll'] .menu-featured:only-child,
    [data-destacados-estilo='carrusel'] .menu-featured:only-child {
      max-width: var(--featured-w);
      width: var(--featured-w);
      justify-self: unset;
      margin-inline: auto;
    }

    [data-destacados-estilo='scroll'] .menu-featured__media,
    [data-destacados-estilo='carrusel'] .menu-featured__media,
    [data-destacados-estilo='fade'] .menu-featured__media {
      margin-bottom: 0.55rem;
      border-radius: 0.85rem;
    }

    [data-destacados-estilo='scroll'] .menu-featured__title,
    [data-destacados-estilo='carrusel'] .menu-featured__title {
      font-size: 0.88rem !important;
      line-height: 1.25;
    }

    [data-destacados-estilo='scroll'] .menu-featured__price,
    [data-destacados-estilo='carrusel'] .menu-featured__price {
      font-size: 1.08rem !important;
      font-weight: 700;
      margin-top: 0.25rem !important;
    }

    .menu-featured__sign {
      width: 5.6rem;
      height: 2.15rem;
    }

    [data-destacados-estilo='fade'] .destacados-fade-stage {
      max-width: none;
      padding-inline: max(var(--menu-gutter-x), env(safe-area-inset-left, 0px));
    }

    [data-destacados-estilo='fade'] .menu-featured {
      max-width: var(--featured-w);
    }
  }

  @container menu (min-width: 30rem) {
    [data-destacados-estilo='scroll'] [data-destacados-track] {
      display: flex;
      gap: 0.65rem;
      overflow-x: auto;
      padding-inline: 1.25rem;
      scroll-snap-type: x proximity;
    }

    [data-destacados-estilo='scroll'] .menu-featured {
      width: var(--featured-w);
      flex-shrink: 0;
      scroll-snap-align: start;
    }

    [data-destacados-estilo='scroll'] .menu-featured:only-child {
      max-width: none;
    }
  }

  @container menu (min-width: 48rem) {
    [data-destacados-estilo='scroll'] [data-destacados-track] {
      gap: 0.85rem;
      padding-inline: 1.35rem;
    }

    [data-destacados-estilo='scroll'] .menu-featured {
