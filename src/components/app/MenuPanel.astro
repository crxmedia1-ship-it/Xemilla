      --featured-w: 16.5rem;
    }
  }

  .menu-featured {
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    transition: transform var(--motion-spring, 220ms ease);
  }

  .menu-featured__media {
    flex: none;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-height: none;
  }

  .menu-featured__media img {
    object-fit: cover;
    object-position: center;
  }

