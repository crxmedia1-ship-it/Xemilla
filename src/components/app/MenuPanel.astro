---
import {
  NUTRICION_FILTROS_PUBLICOS,
} from '../../config/nutricion.js';
import {
  resolveNosotrosFuenteTitulo,
  resolveNosotrosFuenteCuerpo,
  buildNosotrosFontsHref,
} from '../../config/nosotros-typography.js';
import { normalizeChipsLayout, normalizeChipsEstilo, normalizePlatosLayout, normalizeEstiloTarjetas, normalizeDestacadosEstilo, normalizeMenuNavegacion, expandMenuMasterTokens } from '../../lib/secciones-ui.js';

interface Plato {
  id?: number;
  nombre: string;
  descripcion: string;
  precio: string;
  imagenUrl?: string | null;
  destacado?: boolean;
  categoriaId?: string;
  categoriaNombre?: string;
  calorias?: number | null;
  proteinas?: number | null;
  carbs?: number | null;
  grasas?: number | null;
  alergias?: string[];
  ingredientesDetalle?: string;
  modelo3dUrl?: string;
}

interface Props {
  categorias: Array<{
    id: string;
    nombre: string;
    platos: Plato[];
    bgType?: string;
    bgValor?: string;
  }>;
  destacados?: Plato[];
  /** Fondo global del menú (fallback) */
  fondoGlobal?: { tipo?: string; valor?: string };
  /** Cross-fade vive en SectionAtmosphere; el panel no apila capas */
  cinematicCategoryBg?: boolean;
  /** Gadget nutrición activo — si false, cero rastro DOM */
  showNutricion?: boolean;
  /** Gadget AR activo — si true, emite data-plato-modelo3d-url en cada botón */
  showAr?: boolean;
  /** VES por 1 USD (BCV) — fallback visual si no hay tasa en vivo */
  tasaBcv?: number;
  /** EUR por 1 USD — fallback visual */
  tasaEurUsd?: number;
  /** VES por 1 EUR (BCV) — opcional, solo para hint de tasa */
  tasaEur?: number;
  menuUi?: {
    color_fondo?: string;
    color_texto?: string;
    color_acento?: string;
    chips_layout?: string;
    chips_estilo?: string;
    platos_layout?: string;
    estilo_tarjetas?: string;
    destacados_estilo?: string;
    navegacion?: string;
    fuente_titulo?: string;
    fuente_cuerpo?: string;
  };
  menuFont?: string;
  estilos: {
    panelColor: string;
    borderColor: string;
    mutedColor: string;
    softColor: string;
    textColor: string;
    priceColor: string;
    chipIdle: string;
    chipActive: string;
    buttonGhost: string;
    displayClass: string;
  };
}

const {
  categorias = [],
  destacados = [],
  fondoGlobal = { tipo: 'color', valor: '' },
  cinematicCategoryBg = false,
  showNutricion = false,
  showAr = false,
  tasaBcv = 36.5,
  tasaEurUsd = 0.92,
  tasaEur = 0,
  menuUi = {},
  menuFont = '',
  estilos,
} = Astro.props;

function hasMedia(url: string | null | undefined) {
  return Boolean(url && String(url).trim());
}

function isVideoUrl(url: string) {
  return /\.(mp4|webm|ogg|mov)(\?|$)/i.test(url) || /\/video\/upload\//i.test(url);
}

function alergiasCsv(plato: Plato) {
  if (!Array.isArray(plato.alergias) || plato.alergias.length === 0) return '';
  return plato.alergias.map((id) => String(id).trim().toLowerCase()).filter(Boolean).join(',');
}

/** Valor base USD limpio para data-precio-usd */
function precioUsd(precio: string): string {
  const raw = String(precio ?? '').trim();
  if (!raw) return '0.00';
  const normalized =
    raw.includes(',') && !raw.includes('.') ? raw.replace(',', '.') : raw;
  const n = Number.parseFloat(normalized.replace(/[^0-9.]/g, ''));
  return Number.isFinite(n) ? n.toFixed(2) : '0.00';
}

const CHIP_BASE =
  'menu-chip border font-semibold uppercase active:scale-[0.98]';

const globalBgType = fondoGlobal.tipo || 'color';
const globalBgValor = fondoGlobal.valor || '';
const chipsLayout = normalizeChipsLayout(menuUi.chips_layout);
const chipsEstilo = normalizeChipsEstilo(menuUi.chips_estilo);
const platosLayout = normalizePlatosLayout(menuUi.platos_layout);
const estiloTarjetas = normalizeEstiloTarjetas(menuUi.estilo_tarjetas);

/** Solo bento muestra imagen inline; lista y cuadrícula usan «Ver más». */
function shouldShowDetalleBtn(plato: Plato, mediaUrl: string) {
  if (platosLayout === 'bento') {
    return showNutricion || (showAr && Boolean(plato.modelo3dUrl?.trim()));
  }
  return hasMedia(mediaUrl) || showNutricion || (showAr && Boolean(plato.modelo3dUrl?.trim()));
}
const destacadosEstilo = normalizeDestacadosEstilo(menuUi.destacados_estilo);
const menuNavegacion = normalizeMenuNavegacion(menuUi.navegacion);
const isHubMode = menuNavegacion === 'hub_categories';
const destacadosTrackClass =
  destacadosEstilo === 'fade'
    ? 'destacados-fade-stage relative mx-auto w-full max-w-[12.5rem] px-5'
    : destacadosEstilo === 'carrusel'
      ? 'flex gap-3 overflow-x-auto pb-1 scrollbar-none snap-x snap-mandatory scroll-smooth [-webkit-overflow-scrolling:touch] destacados-carrusel-track'
      : 'destacados-scroll-track pb-1';
const menuTokens = expandMenuMasterTokens(menuUi);
const accentColor = menuUi.color_acento || menuTokens.color_chip_activo || '';
const detalleBtnStyle = accentColor
  ? `background-color:${accentColor};border-color:${accentColor};color:${menuTokens.color_boton_texto || '#ffffff'}`
  : '';
const platoCardSurfaceClass =
  estiloTarjetas === 'solido'
    ? 'bg-zinc-900 border border-white/5 shadow-xl'
    : estiloTarjetas === 'outline'
      ? 'bg-transparent border border-white/25 shadow-none'
      : 'bg-black/40 backdrop-blur-xl border border-white/10 shadow-2xl';
const chipsNavClass =
  chipsLayout === 'scroll'
    ? 'menu-chips-nav menu-chips-nav--scroll overflow-x-auto whitespace-nowrap scrollbar-none'
    : 'menu-chips-nav menu-chips-nav--static';
const chipsRowClass =
  chipsLayout === 'grid' || chipsLayout === 'grid-3'
    ? 'menu-chips-row menu-chips-row--grid'
    : chipsLayout === 'wrap'
      ? 'menu-chips-row menu-chips-row--wrap'
      : 'menu-chips-row menu-chips-row--scroll';
const fuenteTitulo = resolveNosotrosFuenteTitulo(menuUi.fuente_titulo || menuFont || 'playfair');
const fuenteCuerpo = resolveNosotrosFuenteCuerpo(menuUi.fuente_cuerpo || 'plus-jakarta');
const fontsHref = buildNosotrosFontsHref(fuenteTitulo.id, fuenteCuerpo.id);

const menuPanelStyle = [
  menuUi.color_texto || menuTokens.color_texto
    ? `--menu-texto-color:${menuUi.color_texto || menuTokens.color_texto}`
    : '',
  menuUi.color_fondo || menuTokens.color_chip
    ? `--menu-surface-color:${menuUi.color_fondo || menuTokens.color_chip}`
    : '',
  menuUi.color_acento || menuTokens.color_chip_activo
    ? `--menu-accent-color:${menuUi.color_acento || menuTokens.color_chip_activo}`
    : '',
  menuTokens.color_titulo ? `--menu-titulo-color:${menuTokens.color_titulo}` : '',
  menuTokens.color_header ? `--menu-header-color:${menuTokens.color_header}` : '',
  menuTokens.color_precio ? `--menu-precio-color:${menuTokens.color_precio}` : '',
  menuTokens.color_chip ? `--menu-chip-bg:${menuTokens.color_chip}` : '',
  menuTokens.color_chip_texto ? `--menu-chip-texto:${menuTokens.color_chip_texto}` : '',
  menuTokens.color_chip_activo ? `--menu-chip-activo:${menuTokens.color_chip_activo}` : '',
  menuTokens.color_boton ? `--menu-boton-bg:${menuTokens.color_boton}` : '',
  menuTokens.color_boton_texto ? `--menu-boton-texto:${menuTokens.color_boton_texto}` : '',
  `--menu-font-heading:${fuenteTitulo.stack}`,
  `--menu-font-body:${fuenteCuerpo.stack}`,
  globalBgTipoColor(),
]
  .filter(Boolean)
  .join(';');

function globalBgTipoColor() {
  // Solo colores hex/rgb — nunca URLs (rompe color-mix del sticky)
  if (globalBgType === 'color' && globalBgValor && isCssColorValue(globalBgValor)) {
    return `--menu-sticky-bg:${globalBgValor}`;
  }
  return '';
}

function isCssColorValue(value) {
  const v = String(value || '').trim();
  if (!v) return false;
  if (/^https?:\/\//i.test(v) || v.includes('/')) return false;
  return (
    /^#([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(v) ||
    /^(rgb|rgba|hsl|hsla)\(/i.test(v) ||
    /^[a-z]+$/i.test(v)
  );
}

function hubCardStyle(
  cat: { bgType?: string; bgValor?: string },
  index: number,
) {
  const bgType = String(cat.bgType || '').toLowerCase();
  const bgValor = String(cat.bgValor || '').trim();
  if (bgType === 'video' && bgValor) {
    return 'background:linear-gradient(180deg,rgba(0,0,0,.15) 0%,rgba(0,0,0,.78) 100%)';
  }
  if (bgType === 'image' && bgValor && (/^https?:\/\//i.test(bgValor) || bgValor.startsWith('/'))) {
    return `background-image:linear-gradient(180deg,rgba(0,0,0,.2) 0%,rgba(0,0,0,.82) 100%),url("${bgValor}");background-size:cover;background-position:center`;
  }
  if (bgType === 'color' && bgValor && isCssColorValue(bgValor)) {
    return `background:linear-gradient(155deg,color-mix(in srgb,${bgValor} 82%,#000) 0%,color-mix(in srgb,${bgValor} 38%,#0a0a0a) 100%)`;
  }
  const fallbacks = ['#14101c', '#0f141c', '#1c1014', '#101c14'];
  const base = fallbacks[index % fallbacks.length];
  return `background:linear-gradient(145deg,color-mix(in srgb,var(--menu-accent-color,#9f1239) 32%,${base}) 0%,${base} 100%)`;
}
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontsHref} />

<div
  class="menu-panel relative z-10 min-h-full overflow-y-visible bg-transparent pb-[max(2.5rem,env(safe-area-inset-bottom))] text-[color:var(--menu-cuerpo-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-body,var(--fuente-menu,var(--fuente-display)))]"
  data-menu-panel
  data-menu-filter="all"
  data-cinematic-cat-bg={cinematicCategoryBg ? 'true' : 'false'}
  data-menu-bg-global-type={globalBgType}
  data-menu-bg-global-valor={globalBgValor}
  data-show-nutricion={showNutricion ? 'true' : 'false'}
  data-tasa-bcv={String(tasaBcv)}
  data-tasa-eur-usd={String(tasaEurUsd)}
  data-tasa-eur={String(tasaEur || '')}
  data-chips-layout={chipsLayout}
  data-chips-estilo={chipsEstilo}
  data-platos-layout={platosLayout}
  data-estilo-tarjetas={estiloTarjetas}
  data-destacados-estilo={destacadosEstilo}
  data-menu-navegacion={menuNavegacion}
  data-hub-view={isHubMode ? 'home' : undefined}
  style={menuPanelStyle || undefined}
>
  <div class="relative z-10">
  <div class="sticky top-0 z-20 border-b border-white/10 menu-sticky">
    <div class="menu-sticky-toolbar" data-menu-sticky-toolbar>
      {
        isHubMode ? (
          <div
            class="menu-hub-nav min-w-0 flex-1 items-center gap-3"
            data-menu-hub-nav
            aria-hidden="true"
          >
            <button
              type="button"
              class="menu-hub-back inline-flex items-center gap-1.5 rounded-full border border-white/12 bg-white/[0.06] px-3 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-[color:var(--menu-texto-color,var(--color-texto))] transition active:scale-[0.98]"
              data-menu-hub-back
            >
              <span aria-hidden="true">←</span>
              Categorías
            </button>
            <span
              class="menu-hub-nav__title min-w-0 flex-1 truncate text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-[color:var(--menu-titulo-color,var(--menu-texto-color,var(--color-texto)))]"
              data-menu-hub-title
            />
          </div>
        ) : (
          <span class="menu-sticky-toolbar__spacer min-w-0 flex-1" aria-hidden="true" />
        )
      }
      <div class="menu-sticky-toolbar__actions">
        <div
          class="currency-compact"
          data-currency-switcher
          data-tasa-bcv={String(tasaBcv)}
          data-tasa-eur-usd={String(tasaEurUsd)}
          data-tasa-eur={String(tasaEur || '')}
        >
          <button
            type="button"
            class="currency-compact__trigger"
            data-currency-trigger
            aria-label="Cambiar divisa de precios"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span data-currency-trigger-label>$</span>
          </button>
          <div class="currency-compact__menu" data-currency-menu hidden role="listbox" aria-label="Divisa de visualización">
            <button type="button" class="currency-compact__option is-active" data-currency-btn="USD" aria-pressed="true">USD</button>
            <button type="button" class="currency-compact__option" data-currency-btn="BS" aria-pressed="false">BS</button>
            <button type="button" class="currency-compact__option" data-currency-btn="EUR" aria-pressed="false">EUR</button>
            <p class="currency-compact__rate" data-currency-rate aria-live="polite">Tasa BCV</p>
          </div>
        </div>
        <button
          type="button"
          data-close-section
          class="menu-mobile-close inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-[color:var(--menu-texto-color,var(--color-texto))] shadow-inner backdrop-blur-md transition active:scale-95"
          aria-label="Cerrar menú"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>
    <nav class={chipsNavClass} aria-label="Categorías del menú" data-menu-cats>
      <div class={chipsRowClass}>
        <button
          type="button"
          data-cat-btn="all"
          data-cat-filter="all"
          class={`tab-categoria menu-chip ${CHIP_BASE} is-active`}
        >
          Todos
        </button>
        {
          (categorias || []).map((cat) => (
            <button
              type="button"
              data-cat-btn={cat.id}
              data-cat-filter={cat.id}
              data-cat-bg-type={cat.bgType || ''}
              data-cat-bg-valor={cat.bgValor || ''}
              class={`tab-categoria menu-chip ${CHIP_BASE}`}
            >
              {cat.nombre}
            </button>
          ))
        }
      </div>
    </nav>
    {
      showNutricion && (
        <div class="alergia-bar" data-alergias-filtros aria-label="Filtros de dieta y alérgenos">
          {/* Pills */}
          <div class="alergia-bar__pills" role="group" aria-label="Filtros activos">
            {NUTRICION_FILTROS_PUBLICOS.map((f) => (
              <button
                type="button"
                data-alergia-filtro={f.id}
                data-hides-any={f.hidesAny.join(',')}
                data-hide-unknown={f.hideUnknown ? 'true' : 'false'}
                class="alergia-pill"
                aria-pressed="false"
              >
                <span class="alergia-pill__emoji" aria-hidden="true">{f.emoji}</span>
                <span class="alergia-pill__label">{f.label}</span>
              </button>
            ))}
          </div>
          {/* Reset — always rendered, JS shows/hides */}
          <button
            type="button"
            class="alergia-reset hidden"
            data-alergia-reset
            aria-label="Quitar todos los filtros"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3" aria-hidden="true">
              <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
            </svg>
            Limpiar
          </button>
        </div>
      )
    }
  </div>

  {
    destacados.length > 0 && (
      <section
        class="border-b border-white/8 pb-3 pt-3 sm:pb-4 sm:pt-4"
        data-destacados
        data-destacados-estilo={destacadosEstilo}
        aria-label="Sugerencias del Chef"
      >
        <h3 class="menu-gutter-x mb-2 font-[family-name:var(--menu-font-heading,var(--fuente-display))] text-[0.62rem] font-semibold tracking-[0.2em] uppercase text-[color:var(--menu-titulo-color,color-mix(in_srgb,var(--menu-texto-color,var(--color-texto))_70%,transparent))] sm:mb-3 sm:text-[0.72rem]">
          Sugerencias del Chef
        </h3>
        <div
          class={destacadosTrackClass}
          data-destacados-track
          aria-roledescription={destacadosEstilo === 'fade' ? 'presentación' : 'carrusel'}
        >
          {destacados.map((plato, idx) => {
            const mediaUrl = plato.imagenUrl?.trim() || '';
            const video = hasMedia(mediaUrl) && isVideoUrl(mediaUrl);
            const catId = plato.categoriaId || '';
            const catName = plato.categoriaNombre || 'Menú';
            return (
              <button
                type="button"
                class:list={[
                  'menu-featured menu-card shrink-0 border border-white/10 bg-white/[0.04] text-left active:scale-[0.98]',
                  destacadosEstilo === 'fade' && idx === 0 && 'is-active',
                ]}
                data-reveal={destacadosEstilo === 'fade' ? undefined : true}
                data-goto-plato={plato.id}
                data-goto-cat={catId}
                data-alergias={alergiasCsv(plato)}
                data-plato-nombre={plato.nombre}
                data-ingredientes={plato.ingredientesDetalle || ''}
                aria-label={`Ir a ${plato.nombre} en ${catName}`}
                aria-hidden={destacadosEstilo === 'fade' && idx !== 0 ? 'true' : undefined}
              >
                <div class="menu-media menu-featured__media relative mb-1 w-full overflow-hidden bg-black/40 sm:mb-1.5">
                  {hasMedia(mediaUrl) ? (
                    video ? (
                      <span class="flex size-full items-center justify-center text-[0.55rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">
                        Video
                      </span>
                    ) : (
                      <img
                        src={mediaUrl}
                        alt=""
                        data-reveal-media
                        class="size-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  ) : (
                    <span class="flex size-full items-center justify-center text-[0.55rem] uppercase tracking-[0.18em] text-zinc-600">
                      Sin media
                    </span>
                  )}
                  <span class="chef-cat-badge absolute left-1.5 top-1.5 max-w-[70%] truncate rounded border border-white/15 bg-black/45 px-1 py-0.5 text-[0.42rem] font-semibold uppercase tracking-[0.12em] text-white/90 sm:left-2 sm:top-2 sm:px-1.5 sm:text-[0.48rem]">
                    {catName}
                  </span>
                </div>
                <h4 class="menu-featured__title line-clamp-2 text-[0.78rem] font-semibold leading-snug font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))] text-[color:var(--menu-titulo-color,var(--menu-texto-color,inherit))] sm:text-[0.92rem]">
                  {plato.nombre}
                </h4>
                <p class="menu-featured__price mt-0.5 text-[0.78rem] font-semibold tabular-nums text-[color:var(--menu-precio-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))] sm:mt-1 sm:text-[0.92rem]">
                  <span class="precio-dinamico" data-precio-usd={precioUsd(plato.precio)}>${precioUsd(plato.precio)}</span>
                </p>
              </button>
            );
          })}
        </div>
      </section>
    )
  }

  {
    isHubMode && (
      <section class="menu-hub menu-gutter-x pb-2 pt-4" data-menu-hub aria-label="Portal de categorías">
        <p class="menu-hub__lead mb-3 text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-[color:color-mix(in_srgb,var(--menu-texto-color,var(--color-texto))_62%,transparent)]">
          Explora por sección
        </p>
        <div class="menu-hub-grid" role="list">
          {
            (categorias || []).map((cat, idx) => {
              const count = (cat.platos || []).length;
              const cardStyle = hubCardStyle(cat, idx);
              const hubVideoUrl =
                String(cat.bgType || '').toLowerCase() === 'video'
                  ? String(cat.bgValor || '').trim()
                  : '';
              return (
                <button
                  type="button"
                  role="listitem"
                  class="menu-hub-card group text-left"
                  data-hub-cat={cat.id}
                  data-hub-cat-name={cat.nombre}
                  data-cat-bg-type={cat.bgType || ''}
                  data-cat-bg-valor={cat.bgValor || ''}
                  style={cardStyle}
                  aria-label={`Abrir ${cat.nombre}, ${count} plato${count === 1 ? '' : 's'}`}
                >
                  {hubVideoUrl ? (
                    <video
                      class="menu-hub-card__video"
                      src={hubVideoUrl}
                      muted
                      loop
                      playsinline
                      autoplay
                      aria-hidden="true"
                    />
                  ) : null}
                  <span class="menu-hub-card__badge rounded-md border border-white/15 bg-black/40 font-semibold uppercase tracking-[0.14em] text-white/90 backdrop-blur-md">
                    {count} {count === 1 ? 'plato' : 'platos'}
                  </span>
                  <span class="menu-hub-card__name font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))] font-semibold leading-snug tracking-[0.04em] text-white">
                    {cat.nombre}
                  </span>
                </button>
              );
            })
          }
        </div>
      </section>
    )
  }

  <div class="menu-list" data-menu-list>
    {
      (categorias || []).map((cat) => (
        <section
          id={`menu-cat-${cat.id}`}
          aria-labelledby={`menu-cat-heading-${cat.id}`}
          data-menu-cat={cat.id}
          data-cat-bg-type={cat.bgType || ''}
          data-cat-bg-valor={cat.bgValor || ''}
          class="menu-cat-section scroll-mt-36"
        >
          <h3
            id={`menu-cat-heading-${cat.id}`}
            class="mb-5 text-[0.65rem] font-semibold tracking-[0.32em] uppercase text-[color:var(--menu-titulo-color,var(--menu-texto-color,var(--color-texto)))] font-[family-name:var(--menu-font-heading,var(--fuente-menu,var(--fuente-display)))]"
          >
