  .menu-btn--detalle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: max-content;
    max-width: 100%;
    height: 2rem;
    min-height: 2rem;
    margin-top: 0.7rem;
    padding: 0 0.85rem;
    border: 1px solid transparent;
    background: var(--menu-boton-bg, var(--menu-accent-color, var(--color-primario)));
    color: var(--menu-boton-texto, #fff);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    white-space: nowrap;
    text-align: center;
    font-family: var(--menu-font-body, inherit);
    box-shadow: none;
  }

  .menu-card,
  .menu-media,
  .menu-btn {
    border-radius: var(--radius-card, 1rem);
  }

  .menu-media {
    border-radius: var(--radius-media, 0.875rem);
  }

  .menu-btn {
    border-radius: var(--radius-button, 9999px);
    transition: transform var(--motion-spring, 220ms ease), opacity 200ms ease;
  }

  /* Un solo ancho y una sola proporción de foto para todos los estilos y pantallas. */
  [data-destacados-track] {
    --featured-w: min(72vw, 17rem);
  }

  @container menu (min-width: 40rem) {
    [data-destacados-track] {
      --featured-w: 15rem;
    }
  }

  @container menu (min-width: 64rem) {
