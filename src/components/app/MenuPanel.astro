  /* PC: todas las categorías a la vista; cada chip a su ancho y en filas si no caben. */
  @container menu (min-width: 48rem) {
    .menu-panel[data-chips-layout='scroll'] .menu-chips-nav--scroll {
      overflow: visible;
      white-space: normal;
      mask-image: none;
