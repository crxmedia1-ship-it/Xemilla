    .menu-sticky {
      isolation: isolate;
      background: transparent;
      border-bottom-color: color-mix(in srgb, var(--menu-texto-color, #fff) 10%, transparent);
      box-shadow: none;
      transform: none;
      -webkit-backface-visibility: visible;
      backface-visibility: visible;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      overflow: visible;
      will-change: auto;
