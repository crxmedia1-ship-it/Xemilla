    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    row-gap: 0.9rem;
    align-items: start;
  }

  .menu-panel[data-menu-navegacion='hub_categories'][data-hub-view='detail'][data-platos-layout='grid'] .menu-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    row-gap: 0.9rem;
  }

  @container menu (min-width: 34rem) {
    .menu-panel[data-platos-layout='grid'] .menu-items {
