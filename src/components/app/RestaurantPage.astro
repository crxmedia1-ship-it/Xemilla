---
import Layout from '../../layouts/Layout.astro';
import XemillaQuiet from '../XemillaQuiet.astro';
import RestaurantApp from './RestaurantApp.astro';
import SucursalPicker from './SucursalPicker.astro';
import { normalizeBrandSlug } from '../../config/brand.js';
import { DEFAULT_THEME } from '../../lib/theme.js';
import { designThemes, DEFAULT_DESIGN_DNA } from '../../config/themes.js';
import {
  sanitizeTheme,
  normalizeUbicacionTheme,
  normalizeNosotrosTheme,
  DEFAULT_UBICACION_THEME,
  DEFAULT_NOSOTROS_THEME,
} from '../../lib/layout-themes.js';
import { buildRestaurantPwa } from '../../lib/pwa.js';

interface Props {
  slug: string;
  restauranteRaw: any;
}

const { slug, restauranteRaw } = Astro.props;

const homeThemeRawDb = restauranteRaw?.home_theme ?? null;
const sanitizedHomeTheme = sanitizeTheme(homeThemeRawDb);
const nosotrosThemeResolved = normalizeNosotrosTheme(
  restauranteRaw?.nosotros_theme ??
    restauranteRaw?.uiEstilo?.nosotros?.theme ??
    DEFAULT_NOSOTROS_THEME,
);
const ubicacionThemeResolved = normalizeUbicacionTheme(
  restauranteRaw?.ubicacion_theme ?? DEFAULT_UBICACION_THEME,
);

/**
 * Home y Ubicación son plantillas independientes.
 * home_theme se deja RAW; el sanitize controla solo el componente montado.
 */
const restaurante = restauranteRaw
  ? {
      ...restauranteRaw,
      home_theme: homeThemeRawDb,
      homeTheme: sanitizedHomeTheme,
      nosotrosTheme: nosotrosThemeResolved,
      nosotros_theme:
        restauranteRaw.nosotros_theme ?? nosotrosThemeResolved,
      ubicacionTheme: ubicacionThemeResolved,
      ubicacion_theme:
        restauranteRaw.ubicacion_theme ?? ubicacionThemeResolved,
    }
  : null;

const brandKey = normalizeBrandSlug(slug ?? '');
const layoutTheme = (brandKey === 'sanza' || brandKey === 'blacksushi' ? brandKey : 'crx') as
  | 'blacksushi'
  | 'sanza'
  | 'crx';

const brandTheme = restaurante?.theme ?? DEFAULT_THEME;
const dna =
  brandTheme.design ??
  designThemes[(brandTheme.designDnaId as keyof typeof designThemes) || DEFAULT_DESIGN_DNA] ??
  designThemes[DEFAULT_DESIGN_DNA];

const ogImage = restaurante?.shareImageUrl || restaurante?.logoUrl || '';
const pwa = restaurante ? buildRestaurantPwa(restaurante) : null;
const appIcon = pwa?.appleIcon || restaurante?.appIconUrl || restaurante?.logoUrl || '';
const siteOrigin = Astro.url.origin;
const sucursalPath =
  restaurante?.multiSucursal && restaurante?.sucursal ? `/${restaurante.sucursal.slug}` : '';
const ogUrl = restaurante ? `${siteOrigin}/${restaurante.slug}${sucursalPath}` : '';
const pageTitle = restaurante
  ? [restaurante.nombre || 'Menú', sucursalPath ? restaurante.sucursal.nombre : '']
      .filter(Boolean)
      .join(' · ')
  : '';
---

{
  !restaurante ? (
    <Layout
      title="No encontrado · Xemilla"
      theme="crx"
      themeColor="#e07028"
      fontHref="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      description="Este menú no está disponible."
    >
      <XemillaQuiet
        kicker="Menú no disponible"
        title="Este restaurante no está en la carta."
        detail="Revisá el enlace con el local."
        actionHref="/"
        actionLabel="Volver al inicio"
      />
    </Layout>
  ) : (
    <Layout
      title={pageTitle}
      description={`${restaurante.nombre || 'Restaurante'} · ${restaurante.tagline || ''}`}
      theme={layoutTheme}
      themeColor={brandTheme.colorFondo}
      fontHref={brandTheme.googleFontsHref || dna.fonts.googleHref}
      customCss=""
      ogImage={ogImage}
      appIcon={appIcon}
      manifestHref={pwa?.manifestHref || ''}
      appName={pwa?.shortName || ''}
      pwaScope={pwa?.swScope || ''}
      ogUrl={ogUrl}
    >
      {restaurante.requiereSucursal ? (
        <SucursalPicker restaurante={restaurante} />
      ) : (
        <RestaurantApp
          restaurante={restaurante}
          homeTheme={sanitizedHomeTheme}
          nosotrosTheme={nosotrosThemeResolved}
          ubicacionTheme={ubicacionThemeResolved}
        />
      )}
    </Layout>
  )
}
