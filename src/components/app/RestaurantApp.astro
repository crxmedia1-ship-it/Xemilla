---
import OverlayPanel from './OverlayPanel.astro';
import MenuPanel from './MenuPanel.astro';
import NosotrosPanel from './NosotrosPanel.astro';
import SectionAtmosphere from './SectionAtmosphere.astro';
import WifiGadget from '../gadgets/WifiGadget.astro';
import DividirCuenta from '../gadgets/DividirCuenta.astro';
import LlamarMeseroGadget from '../gadgets/LlamarMeseroGadget.astro';
import BoutiqueGadget from '../gadgets/BoutiqueGadget.astro';
import HomeEditorial from '../themes/home/HomeEditorial.astro';
import HomeHeroCards from '../themes/home/HomeHeroCards.astro';
import HomeBentoGrid from '../themes/home/HomeBentoGrid.astro';
import HomeMinimal from '../themes/home/HomeMinimal.astro';
import UbicacionModal from '../themes/ubicacion/UbicacionModal.astro';
import UbicacionSplitMap from '../themes/ubicacion/UbicacionSplitMap.astro';
import { themeToCssVars, homeBackgroundCssVars, DEFAULT_THEME } from '../../lib/theme.js';
import {
  sanitizeTheme,
  normalizeUbicacionTheme,
} from '../../lib/layout-themes.js';
import { resolveMediaUrl } from '../../lib/cloudinary.js';
import { resolveSafeHomeProps } from '../../lib/home-safe-props.js';
import { fetchTasasCambio } from '../../lib/tasas-cambio.js';
import {
  scopeCssAvanzado,
  normalizeEstiloNavegacion,
  normalizeFondoAnimacion,
  normalizeOverlayEstilo,
} from '../../lib/secciones-ui.js';

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  restaurante: any;
  /** Plantilla Home forzada desde [slug].astro (SSR) — solo estructura */
  homeTheme?: string;
  /** Plantilla Ubicación forzada desde [slug].astro (SSR) */
  ubicacionTheme?: string;
}

const { restaurante, homeTheme: homeThemeProp, ubicacionTheme: ubicacionThemeProp } = Astro.props;
const theme = restaurante?.theme ?? DEFAULT_THEME;
const gadgets = restaurante?.gadgets || {};
const uiEstilo = restaurante?.uiEstilo || {};
const showWifi = Boolean(gadgets?.wifi);
const showDividir = Boolean(gadgets?.dividirCuenta);
const showReservas = Boolean(gadgets?.reservas);
const showLlamarMesero = Boolean(gadgets?.llamarMesero);
const showBoutique = Boolean(gadgets?.boutique);
const showNutricion = Boolean(gadgets?.nutricion);
const showAr = Boolean(gadgets?.ar);
let tasasCambio = { usdVes: 36.5, eurVes: 40, fuente: 'fallback', fecha: null };
try {
  tasasCambio = (await fetchTasasCambio()) || tasasCambio;
} catch (err) {
  console.error('[RestaurantApp] tasas de cambio:', err);
}
const boutiqueProductos = Array.isArray(restaurante?.boutique?.productos)
  ? restaurante.boutique.productos
  : [];

/** sanitizeTheme(restaurante.home_theme) — sin fallback agresivo a Bento */
let homeTheme = sanitizeTheme(
  homeThemeProp ?? restaurante?.home_theme ?? restaurante?.homeTheme ?? '',
);
const ubicacionTheme = normalizeUbicacionTheme(
  ubicacionThemeProp ?? restaurante?.ubicacionTheme ?? restaurante?.ubicacion_theme,
);

console.log('🔥 [SUPABASE READ]', {
  raw_db: restaurante?.home_theme,
  sanitized: sanitizeTheme(restaurante?.home_theme),
});

/** Fondos desde Identidad de Marca (independientes de home_theme) */
const fondos = restaurante?.seccionesFondo ?? {};
const fondoHome = fondos?.home ?? { tipo: 'color', valor: theme.colorFondo };
const fondoNosotros = fondos?.nosotros ?? { tipo: 'color', valor: '' };
const fondoMenu = fondos?.menu ?? { tipo: 'color', valor: '' };
const fondoUbicacion = fondos?.ubicacion ?? { tipo: 'color', valor: '' };

/** Atmósfera siempre tiene capa base (color) si falta media — shell es bg-transparent */
const atmosphereTipo = String(fondoHome?.valor || '').trim()
  ? String(fondoHome?.tipo || 'color')
  : 'color';
const atmosphereValor = String(fondoHome?.valor || '').trim() || theme.colorFondo;

/** Overlay Home: estilo cinemático + opacidad (solo filtro oscuro / cinematico) */
const homeOverlayOpacity =
  uiEstilo?.home?.overlay_opacity ??
  uiEstilo?.home?.overlayOpacity ??
  40;
const homeOverlayEstilo = normalizeOverlayEstilo(
  uiEstilo?.home?.overlay_estilo ?? uiEstilo?.home?.overlayEstilo,
);
const homeFondoAnimacion = normalizeFondoAnimacion(
  uiEstilo?.home?.fondo_animacion ?? uiEstilo?.home?.fondoAnimacion,
);

/** Navegación Home: frontal | hamburguesa | app_tabs (legacy fijo/oculto normalizados) */
const estiloNavegacion = normalizeEstiloNavegacion(
  uiEstilo?.home?.estilo_navegacion ??
    uiEstilo?.home?.estiloNavegacion ??
    uiEstilo?.home?.nav_style,
);
const isNavHamburguesa = estiloNavegacion === 'hamburguesa';
const isNavAppTabs = estiloNavegacion === 'app_tabs';
const hideCentralNav = isNavHamburguesa || isNavAppTabs;

const menuColorCss =
  uiEstilo?.home?.menu_color ||
  uiEstilo?.home?.menuColor ||
  '#ffffff';

const cssVars = [
  themeToCssVars(theme),
  homeBackgroundCssVars(fondoHome, theme.colorFondo),
  restaurante?.uiCssVars || '',
]
  .filter(Boolean)
  .join('; ');

const reservas = restaurante?.reservas ?? {};
/** CTA visible con el switch ON (aunque falte href aún) */
const reservasCta = showReservas
  ? {
      label: reservas?.label || 'PEDIR / RESERVAR',
      href: reservas?.href || '#',
      subtitulo: reservas?.subtitulo || reservas?.subtitle || 'EXPERIENCIA PREMIUM',
      activo: true,
    }
  : null;

/** Ficha nutricional embebida para el modal de la WebApp */
const menuNutricionById = {};
if (showNutricion) {
  const cats = restaurante?.menu?.categorias || [];
  for (const cat of cats) {
    for (const p of cat.platos || []) {
      if (p?.id == null) continue;
      menuNutricionById[String(p.id)] = {
        calorias: p.calorias ?? null,
        proteinas: p.proteinas ?? null,
        carbs: p.carbs ?? null,
        grasas: p.grasas ?? null,
        alergias: Array.isArray(p.alergias) ? p.alergias : [],
        ingredientes: p.ingredientesDetalle || p.ingredientes_detalle || '',
      };
    }
  }
}

/** Logo: logo_url | logo → siempre por resolveMediaUrl */
let logoUrl = null;
try {
  logoUrl = resolveMediaUrl(
    restaurante?.logo_url || restaurante?.logo || restaurante?.logoUrl || '',
  );
} catch (e) {
  console.error('Error renderizando tema:', e);
  logoUrl = null;
}

/** Props Home blindadas — nunca undefined sin fallback */
const taglineSuperior = String(
  restaurante?.taglineSuperior ||
    uiEstilo?.home?.tagline_superior ||
    uiEstilo?.home?.taglineSuperior ||
    '',
).trim();
const brandTagline = String(
  restaurante?.tagline || restaurante?.eslogan || '',
).trim();

let homeProps = {
  ...resolveSafeHomeProps({
    nombre: restaurante?.nombre || 'Restaurante',
    logoText: restaurante?.logoText,
    logoLetter: restaurante?.logoLetter,
    logoUrl: logoUrl || null,
    logo_url: logoUrl || null,
    tagline: brandTagline,
    eslogan: brandTagline,
    taglineSuperior,
    tagline_superior: taglineSuperior,
    slug: restaurante?.slug || '',
    menu_link:
      restaurante?.menu_link ||
      (restaurante?.slug ? `/${restaurante.slug}/menu` : ''),
    estilos: restaurante?.estilos,
    showWifi,
    showDividir,
    showLlamarMesero,
    showBoutique,
    wifiSsid: restaurante?.wifi?.ssid || '',
    wifiClave: restaurante?.wifi?.password || '',
    reservasCta,
    homeUi: uiEstilo?.home || {},
  }),
  taglineSuperior,
  tagline_superior: taglineSuperior,
  /** Reservas CTA — visibles con switch ON (no dependen de href) */
  showReservas,
  reservas_activo: showReservas,
  reservas_texto: reservas?.label || 'PEDIR / RESERVAR',
  reservas_subtitulo:
    reservas?.subtitulo || reservas?.subtitle || 'EXPERIENCIA PREMIUM',
  reservas_link: reservas?.href || '#',
  estiloNavegacion,
  hideCentralNav,
};

const ubicacion = restaurante?.ubicacion ?? {};
const ubicacionProps = {
  direccion: ubicacion?.direccion || '',
  ciudad: ubicacion?.ciudad || '',
  telefono: ubicacion?.telefono || '',
  email: ubicacion?.email || '',
  instagram: ubicacion?.instagram || '',
  whatsapp: ubicacion?.whatsapp || restaurante?.whatsapp || '',
  redes: Array.isArray(ubicacion?.redes) ? ubicacion.redes : [],
  mapaLabel: ubicacion?.mapaLabel || '',
  mapaUrl: ubicacion?.mapaUrl || '',
  horarios: ubicacion?.horarios || [],
  horariosRows: ubicacion?.horariosRows || [],
  sectionColors: uiEstilo?.ubicacion,
  estilos: homeProps.estilos,
};

/** Si falla la resolución del tema, loguear y caer a bento solo por error real */
try {
  if (!homeProps?.nombre) {
    throw new Error('homeProps.nombre vacío tras resolveSafeHomeProps');
  }
} catch (e) {
  console.error('Error renderizando tema:', e);
  homeTheme = 'bento';
  homeProps = {
    ...resolveSafeHomeProps({ nombre: 'Restaurante', estilos: restaurante?.estilos }),
    showReservas,
    reservas_activo: showReservas,
    reservas_texto: 'PEDIR / RESERVAR',
    reservas_subtitulo: 'EXPERIENCIA PREMIUM',
    reservas_link: '#',
    estiloNavegacion,
    hideCentralNav,
  };
}

const estilos = homeProps.estilos;
const menu = restaurante?.menu ?? {};
const nosotros = restaurante?.nosotros ?? {};

/** CSS avanzado: ui_estilo.css_avanzado (canónico) ↔ columna custom_css */
const cssAvanzadoScoped = scopeCssAvanzado(
  uiEstilo?.css_avanzado ||
    restaurante?.customCss ||
    restaurante?.custom_css ||
    '',
);
---

{cssAvanzadoScoped ? <style is:inline set:html={cssAvanzadoScoped} /> : null}

<div
  class="restaurant-app relative z-10 mx-auto min-h-dvh w-full bg-transparent text-[color:var(--color-text,var(--color-texto))] font-[family-name:var(--font-body,var(--fuente-principal))]"
  data-restaurant-app
  data-preview-live="true"
  data-restaurante-id={restaurante?.id || ''}
  data-design={theme?.designDnaId || 'elegant'}
  data-home-theme={homeTheme}
  data-ubicacion-theme={ubicacionTheme}
  data-estilo-navegacion={estiloNavegacion}
  data-fondo-home-tipo={fondoHome.tipo || 'color'}
  data-show-nutricion={showNutricion ? 'true' : 'false'}
  data-show-ar={showAr ? 'true' : 'false'}
  style={cssVars}
>
  {
    showNutricion ? (
      <script is:inline type="application/json" data-menu-nutricion-json set:html={JSON.stringify(menuNutricionById || {})} />
    ) : null
  }
  {/*
    HOME stacking (decoupled):
    - Atmosphere: fixed inset-0 z-0 pointer-events-none (SectionAtmosphere)
    - Theme chrome: relative z-10 pointer-events-auto
    Nav structure (hamburguesa / app_tabs) never mutates atmosphere.
    Nota: z-0 (no z-[-1]) — z negativo puede pintar detrás del background del body.
  */}
  <div
    class="relative flex min-h-dvh w-full flex-col bg-transparent"
    data-home-shell
    data-resolved-home-theme={homeTheme}
  >
    {/* Atmósfera centralizada — color | image | carrusel | video + overlays */}
    <SectionAtmosphere
      tipo={atmosphereTipo}
      valor={atmosphereValor}
      overlayOpacity={homeOverlayOpacity}
      overlayEstilo={homeOverlayEstilo}
      fondoAnimacion={homeFondoAnimacion}
      fixed
    />

    {
      !String(fondoHome?.valor || '').trim() && (
        <div
          class="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-40"
          aria-hidden="true"
          data-parallax-root
        >
          <div
            class="absolute inset-[-10%] bg-[radial-gradient(ellipse_at_top,color-mix(in_srgb,var(--color-primary,var(--color-primario))_28%,transparent),transparent_55%)] will-change-transform"
            data-parallax-layer
            style="transform: translate3d(0,0,0)"
          />
        </div>
      )
    }

    {/* Tema Home: solo estructura (logo / títulos / nav) */}
    <div class="relative z-10 flex min-h-dvh w-full flex-col bg-transparent pointer-events-auto">
      {
        (() => {
          try {
            if (homeTheme === 'editorial') {
              return <HomeEditorial {...homeProps} />;
            }
            if (homeTheme === 'hero') {
              return <HomeHeroCards {...homeProps} />;
            }
            if (homeTheme === 'minimal') {
              return <HomeMinimal {...homeProps} />;
            }
            return <HomeBentoGrid {...homeProps} />;
          } catch (e) {
            console.error('Error renderizando tema:', e);
            return <HomeBentoGrid {...homeProps} />;
          }
        })()
      }
    </div>
  </div>

  {
    isNavHamburguesa ? (
      <>
        <button
          type="button"
          class="absolute right-4 top-[max(1rem,env(safe-area-inset-top))] z-30 flex size-11 items-center justify-center text-2xl leading-none transition-all duration-500 ease-in-out hover:opacity-70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/40 sm:right-6"
          style={`color: ${menuColorCss}`}
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="app-nav-overlay"
          data-app-nav-burger
        >
          ☰
        </button>

        <div
          id="app-nav-overlay"
          class="pointer-events-none fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/95 px-6 opacity-0 backdrop-blur-2xl transition-all duration-500 ease-in-out"
          data-app-nav-overlay
          aria-hidden="true"
        >
          <button
            type="button"
            class="absolute right-4 top-[max(1rem,env(safe-area-inset-top))] z-50 flex size-11 items-center justify-center text-2xl leading-none text-white/70 transition-all duration-500 ease-in-out hover:text-white sm:right-6"
            aria-label="Cerrar menú"
            data-app-nav-close
          >
            ✕
          </button>

          <nav
            class="flex max-h-[min(85dvh,40rem)] w-full max-w-[22rem] flex-col items-center gap-2 overflow-y-auto overscroll-contain py-16 text-center"
            aria-label="Navegación principal"
            data-app-nav-panel
          >
            <button
              type="button"
              data-open-section="menu"
              class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white focus-visible:tracking-[0.3em] focus-visible:text-white focus-visible:outline-none sm:text-4xl"
            >
              Menú
            </button>
            <button
              type="button"
              data-open-section="nosotros"
              class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white focus-visible:tracking-[0.3em] focus-visible:text-white focus-visible:outline-none sm:text-4xl"
            >
              Nosotros
            </button>
            <button
              type="button"
              data-open-section="ubicacion"
              class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white focus-visible:tracking-[0.3em] focus-visible:text-white focus-visible:outline-none sm:text-4xl"
            >
              Ubicación
            </button>
            {
              showWifi ? (
                <button
                  type="button"
                  data-open-section="wifi"
                  class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white sm:text-4xl"
                >
                  Wi-Fi
                </button>
              ) : null
            }
            {
              showLlamarMesero ? (
                <button
                  type="button"
                  data-open-section="mesero"
                  data-requires-mesa="true"
                  class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white sm:text-4xl"
                >
                  Llamar mesero
                </button>
              ) : null
            }
            {
              showDividir ? (
                <button
                  type="button"
                  data-open-section="dividir"
                  data-requires-mesa="true"
                  class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white sm:text-4xl"
                >
                  Dividir cuenta
                </button>
              ) : null
            }
            {
              showBoutique ? (
                <button
                  type="button"
                  data-open-boutique
                  class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white sm:text-4xl"
                >
                  Boutique
                </button>
              ) : null
            }
            {
              showReservas && reservasCta ? (
                <a
                  href={reservasCta.href || '#'}
                  target={reservasCta.href && reservasCta.href !== '#' ? '_blank' : undefined}
                  rel={reservasCta.href && reservasCta.href !== '#' ? 'noopener noreferrer' : undefined}
                  class="mt-6 w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white sm:text-4xl"
                  data-reservas-home-cta
                >
                  {reservasCta.label || 'Pedir / Reservar'}
                </a>
              ) : null
            }
          </nav>
        </div>
      </>
    ) : null
  }

  {
    isNavAppTabs ? (
      <nav
        class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full items-stretch justify-around border-t border-white/10 bg-black/80 px-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] pt-2 backdrop-blur-xl"
        aria-label="Navegación inferior"
        data-app-tabs
      >
        <button
          type="button"
          data-open-section="menu"
          data-app-tab="menu"
          class="app-tab flex flex-1 flex-col items-center gap-1 py-2 text-[0.58rem] font-medium uppercase tracking-[0.14em] text-white/55 transition-colors duration-300 data-[active=true]:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h10"></path>
          </svg>
          Menú
        </button>
        <button
          type="button"
          data-open-section="nosotros"
          data-app-tab="nosotros"
          class="app-tab flex flex-1 flex-col items-center gap-1 py-2 text-[0.58rem] font-medium uppercase tracking-[0.14em] text-white/55 transition-colors duration-300 data-[active=true]:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true">
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
            <path d="M4 20a8 8 0 0 1 16 0"></path>
          </svg>
          Nosotros
        </button>
        <button
          type="button"
          data-open-section="ubicacion"
          data-app-tab="ubicacion"
          class="app-tab flex flex-1 flex-col items-center gap-1 py-2 text-[0.58rem] font-medium uppercase tracking-[0.14em] text-white/55 transition-colors duration-300 data-[active=true]:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true">
            <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
          Ubicación
        </button>
      </nav>
    ) : null
  }

  {/* Overlays / drawers: hermanos del Home, no hijos (z-index por encima del shell) */}
  <div class="relative z-50" data-overlays-root>
    <OverlayPanel
      sectionId="menu"
      title="IL MENÚ"
      estilos={{ ...estilos, panelColor: 'bg-transparent' }}
    >
      <MenuPanel
        categorias={menu?.categorias || []}
        destacados={menu?.destacados ?? []}
        fondoGlobal={fondoMenu}
        showNutricion={showNutricion}
        showAr={showAr}
        tasaBcv={tasasCambio.usdVes}
        tasaEurUsd={
          Number(tasasCambio.usdVes) > 0 && Number(tasasCambio.eurVes) > 0
            ? Number(tasasCambio.usdVes) / Number(tasasCambio.eurVes)
            : 0.92
        }
        tasaEur={tasasCambio.eurVes}
        estilos={estilos}
      />
    </OverlayPanel>

    <OverlayPanel
      sectionId="nosotros"
      title={nosotros?.titulo || 'NOSOTROS'}
      fondoTipo={fondoNosotros.tipo}
      fondoValor={fondoNosotros.valor}
      sectionColors={uiEstilo?.nosotros}
      estilos={estilos}
    >
      <NosotrosPanel
        bloques={nosotros?.bloques ?? []}
        texto={nosotros?.texto || ''}
        highlights={nosotros?.highlights || []}
        designDnaId={theme?.designDnaId || 'elegant'}
        sectionColors={uiEstilo?.nosotros}
        estilos={estilos}
      />
    </OverlayPanel>

    {
      ubicacionTheme === 'split' ? (
        <OverlayPanel
          sectionId="ubicacion"
          title={ubicacion?.titulo || 'UBICACIÓN Y HORARIOS'}
          fondoTipo={fondoUbicacion.tipo}
          fondoValor={fondoUbicacion.valor}
          sectionColors={uiEstilo.ubicacion}
          estilos={estilos}
        >
          <UbicacionSplitMap {...ubicacionProps} />
        </OverlayPanel>
      ) : (
        <UbicacionModal {...ubicacionProps} />
      )
    }

    {
      showWifi && (
        <OverlayPanel sectionId="wifi" title="CONECTAR WI-FI" estilos={estilos}>
          <div class="px-5 py-8">
            <WifiGadget
              ssid={restaurante?.wifi?.ssid || ''}
              password={restaurante?.wifi?.password || ''}
              textColor={estilos?.textColor || ''}
              mutedColor={estilos?.mutedColor || ''}
            />
          </div>
        </OverlayPanel>
      )
    }

    {
      showDividir && (
        <OverlayPanel sectionId="dividir" title="PEDIR / DIVIDIR CUENTA" estilos={estilos}>
          <div class="px-5 py-8">
            <DividirCuenta
              restauranteId={restaurante?.id || ''}
              textColor={estilos?.textColor || ''}
              mutedColor={estilos?.mutedColor || ''}
              accentText={estilos?.accentText || ''}
            />
          </div>
        </OverlayPanel>
      )
    }

    {
      showLlamarMesero && (
        <OverlayPanel sectionId="mesero" title="LLAMAR MESERO" estilos={estilos}>
          <div class="px-5 py-8">
            <LlamarMeseroGadget
              restauranteId={restaurante?.id || ''}
              whatsapp={restaurante?.whatsapp || ubicacion?.whatsapp || ''}
              nombreRestaurante={restaurante?.nombre || homeProps.nombre}
              textColor={estilos?.textColor || ''}
              mutedColor={estilos?.mutedColor || ''}
            />
          </div>
        </OverlayPanel>
      )
    }

    {
      showBoutique && (
        <BoutiqueGadget
          productos={boutiqueProductos}
          textColor={estilos?.textColor || ''}
          mutedColor={estilos?.mutedColor || ''}
          displayClass={estilos?.displayClass || ''}
        />
      )
    }

    {/* Modal de detalle multimedia — fuera de paneles transformados/scroll */}
    <div
      class="detalle-modal pointer-events-none fixed inset-0 z-[90] flex items-end justify-center opacity-0 transition-all duration-300 ease-out md:items-center md:px-6 md:py-8"
      data-detalle-modal
      aria-hidden="true"
    >
      <button
        type="button"
        class="absolute inset-0 bg-black/75 backdrop-blur-md transition-opacity duration-300"
        data-detalle-backdrop
        aria-label="Cerrar detalle"
      ></button>

      <div
        class="detalle-modal__card relative z-10 flex w-full max-h-[min(92dvh,44rem)] max-w-none flex-col overflow-hidden rounded-t-[1.65rem] border border-white/12 bg-[var(--color-fondo)] opacity-0 shadow-[0_24px_80px_rgba(0,0,0,0.6)] transition-all duration-300 ease-out md:max-w-[46rem] md:max-h-[min(86dvh,38rem)] md:flex-row md:rounded-[1.65rem]"
        role="dialog"
        aria-modal="true"
        aria-labelledby="detalle-modal-title"
      >
        <button
          type="button"
          data-detalle-close
          class="absolute right-3 top-3 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-black/55 text-zinc-100 backdrop-blur-md transition-all duration-200 active:scale-95 hover:text-white"
          aria-label="Cerrar"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            class="h-3.5 w-3.5"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>

        <div class="relative aspect-[4/3] shrink-0 overflow-hidden bg-black/50 md:aspect-auto md:min-h-[22rem] md:w-[46%]" data-detalle-media-std>
          <div class="detalle-modal__handle md:hidden" aria-hidden="true"></div>
          <img
            data-detalle-img
            src=""
            alt=""
            class="absolute inset-0 hidden size-full object-cover object-center"
          />
          <video
            data-detalle-video
            class="absolute inset-0 hidden size-full object-cover object-center"
            autoplay
            loop
            muted
            playsinline
          ></video>
          <div
            data-detalle-ar
            class="absolute inset-0 z-[8] hidden bg-zinc-950/80"
            style="touch-action: pan-y;"
          ></div>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-4 md:px-6 md:py-6">
          <h3
            id="detalle-modal-title"
            class={`pr-10 text-[1.2rem] font-semibold leading-snug ${estilos?.displayClass || ''} text-[color:var(--color-texto)]`}
            data-detalle-title
          >
            Plato
          </h3>
          <p
            class="mt-2 hidden text-[0.88rem] leading-relaxed text-[color:color-mix(in_srgb,var(--color-texto)_62%,transparent)]"
            data-detalle-desc
          ></p>
          <button
            type="button"
            data-detalle-ar-btn
            class="detalle-ar-btn mt-4 hidden"
            aria-label="Ver en realidad aumentada"
          >
            Ver en AR
          </button>
          {
            showNutricion && (
              <div class="detalle-nut mt-4 hidden" data-detalle-nutricion>
                <div class="detalle-nut__macros" data-detalle-macros>
                  <div class="detalle-nut__metric">
                    <p class="detalle-nut__k">kcal</p>
                    <p class="detalle-nut__v" data-detalle-kcal>—</p>
                  </div>
                  <div class="detalle-nut__metric">
                    <p class="detalle-nut__k">Prot</p>
                    <p class="detalle-nut__v" data-detalle-prot>—</p>
                  </div>
                  <div class="detalle-nut__metric">
                    <p class="detalle-nut__k">Carbs</p>
                    <p class="detalle-nut__v" data-detalle-carbs>—</p>
                  </div>
                  <div class="detalle-nut__metric">
                    <p class="detalle-nut__k">Grasas</p>
                    <p class="detalle-nut__v" data-detalle-grasas>—</p>
                  </div>
                </div>
                <p class="detalle-nut__alergias-label">Contiene</p>
                <div class="detalle-nut__tags" data-detalle-alergias-badges></div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .detalle-modal.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  .detalle-modal__card {
    transform: translateY(1.25rem);
  }
  .detalle-modal.is-open .detalle-modal__card {
    transform: translateY(0);
    opacity: 1;
  }
  @media (min-width: 768px) {
    .detalle-modal__card {
      transform: translateY(0) scale(0.96);
    }
    .detalle-modal.is-open .detalle-modal__card {
      transform: scale(1);
    }
  }

  .detalle-modal__handle {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    z-index: 8;
    width: 2.4rem;
    height: 0.28rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    transform: translateX(-50%);
  }

  .detalle-nut {
    padding: 0.9rem;
    border-radius: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-texto) 12%, transparent);
    background: color-mix(in srgb, var(--color-texto) 5.5%, transparent);
  }

  .detalle-nut__macros {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .detalle-nut__metric {
    min-width: 0;
    padding: 0.6rem 0.15rem 0.65rem;
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-texto) 7%, transparent);
    text-align: center;
  }

  .detalle-nut__k {
    margin: 0;
    font-size: 0.52rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 42%, transparent);
  }

  .detalle-nut__v {
    margin: 0.18rem 0 0;
    font-size: 0.95rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--color-texto);
  }

  .detalle-nut__alergias-label {
    margin: 0.85rem 0 0.45rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-texto) 48%, transparent);
  }

  .detalle-nut__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .detalle-nut__tags:empty {
    display: none;
  }

  .detalle-nut__tags:empty + .detalle-nut__alergias-label,
  .detalle-nut__alergias-label:has(+ .detalle-nut__tags:empty) {
    display: none;
  }

  .detalle-ar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    min-height: 2.65rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(196, 181, 253, 0.45);
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.42), rgba(109, 40, 217, 0.28));
    color: #f5f3ff;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .detalle-ar-btn.is-on {
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.55), rgba(109, 40, 217, 0.38));
    border-color: rgba(221, 214, 254, 0.55);
    color: #fff;
  }
  .detalle-ar-native {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: none;
  }
  .detalle-ar-btn.hidden {
    display: none;
  }

  .detalle-nut-chip,
  .alergeno-badge {
    --badge: #94a3b8;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--badge) 58%, transparent);
    background: color-mix(in srgb, var(--badge) 22%, transparent);
    padding: 0.32rem 0.75rem 0.32rem 0.48rem;
    min-height: 1.85rem;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--badge) 55%, #fff);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  .alergeno-badge[data-alergeno='gluten'] { --badge: #eab308; }
  .alergeno-badge[data-alergeno='lacteos'] { --badge: #38bdf8; }
  .alergeno-badge[data-alergeno='huevo'] { --badge: #facc15; }
  .alergeno-badge[data-alergeno='mani'] { --badge: #f97316; }
  .alergeno-badge[data-alergeno='frutos_secos'] { --badge: #c4a574; }
  .alergeno-badge[data-alergeno='mariscos'] { --badge: #fb7185; }
  .alergeno-badge[data-alergeno='pescado'] { --badge: #22d3ee; }
  .alergeno-badge[data-alergeno='soja'] { --badge: #84cc16; }
  .alergeno-badge[data-alergeno='sesamo'] { --badge: #d6d3d1; }
  .alergeno-badge[data-alergeno='picante'] { --badge: #ef4444; }
  .alergeno-badge[data-alergeno='carne'] { --badge: #f43f5e; }
  .alergeno-badge[data-alergeno='no_vegano'] { --badge: #a78bfa; }
  .alergeno-badge--empty {
    --badge: #94a3b8;
    color: color-mix(in srgb, var(--color-texto) 55%, transparent);
    border-color: color-mix(in srgb, var(--color-texto) 14%, transparent);
    background: color-mix(in srgb, var(--color-texto) 6%, transparent);
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 600;
  }

  [data-app-nav-overlay].is-open {
    pointer-events: auto;
    opacity: 1;
  }

  [data-app-nav-overlay].is-open [data-app-nav-panel] {
    animation: app-nav-fade-in 0.5s ease both;
  }

  @keyframes app-nav-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-estilo-navegacion='app_tabs'] [data-home-shell] {
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
  }

  @media (prefers-reduced-motion: reduce) {
    [data-app-nav-overlay],
    [data-app-nav-overlay].is-open [data-app-nav-panel] {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { syncMesaSession, hasValidMesaSession, getStoredMesa } from '../../lib/mesa-session.js';

  const OPEN_CLASSES = ['translate-y-0', 'opacity-100', 'pointer-events-auto'];
  const CLOSED_CLASSES = ['translate-y-full', 'opacity-0', 'pointer-events-none'];
  const MESA_GATED_SECTIONS = new Set(['mesero', 'dividir']);

  // Persist ?mesa= ASAP (también si el hub aún no montó el gate)
  syncMesaSession();

  /**
   * Aplica bloqueo Carrd de mesero/cuenta sin mesa (todos los home themes).
   */
  function applyMesaGate() {
    const mesa = syncMesaSession();
    const unlocked = Boolean(mesa);

    document.querySelectorAll('[data-requires-mesa="true"]').forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      el.classList.toggle('is-mesa-locked', !unlocked);
      el.setAttribute('aria-disabled', unlocked ? 'false' : 'true');
      if (unlocked) {
        el.removeAttribute('tabindex');
      } else {
        el.setAttribute('tabindex', '-1');
      }
    });

    document.documentElement.dataset.mesaAsignada = unlocked ? 'true' : 'false';
    if (mesa) {
      document.documentElement.dataset.mesa = mesa;
    } else {
      delete document.documentElement.dataset.mesa;
    }
  }

  applyMesaGate();
  document.addEventListener('astro:page-load', applyMesaGate);

  function isVideoUrl(url: string) {
    return /\.(mp4|webm|ogg|mov)(\?|$)/i.test(url) || /\/video\/upload\//i.test(url);
  }

  function setPanelOpen(panel: HTMLElement, open: boolean) {
    panel.dataset.open = open ? 'true' : 'false';
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    panel.classList.remove(...(open ? CLOSED_CLASSES : OPEN_CLASSES));
    panel.classList.add(...(open ? OPEN_CLASSES : CLOSED_CLASSES));
  }

  function openUbicacionDrawer(app: HTMLElement) {
    const drawer = app.querySelector('[data-ubicacion-drawer]');
    if (!(drawer instanceof HTMLElement)) return;
    closeDetalle(app);
    closeBoutique(app);
    app.querySelectorAll('[data-section]').forEach((el) => {
      if (el instanceof HTMLElement) setPanelOpen(el, false);
    });
    drawer.classList.add('is-open');
    drawer.dataset.open = 'true';
    drawer.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeUbicacionDrawer(app: HTMLElement) {
    const drawer = app.querySelector('[data-ubicacion-drawer]');
    if (!(drawer instanceof HTMLElement)) return;
    drawer.classList.remove('is-open');
    drawer.dataset.open = 'false';
    drawer.setAttribute('aria-hidden', 'true');
  }

  function setAppTabsActive(app: HTMLElement, id: string | null) {
    app.querySelectorAll('[data-app-tab]').forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      el.dataset.active = id && el.dataset.appTab === id ? 'true' : 'false';
    });
  }

  function closeAppNavOverlay(app: HTMLElement) {
    const overlay = app.querySelector('[data-app-nav-overlay]');
    const burger = app.querySelector('[data-app-nav-burger]');
    if (overlay instanceof HTMLElement) {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
    }
    if (burger instanceof HTMLElement) {
      burger.setAttribute('aria-expanded', 'false');
    }
    // No forzar overflow aquí: openSection puede mantener el lock del panel
  }

  function openSection(app: HTMLElement, id: string) {
    // Mantener ?mesa= en sessionStorage antes de cualquier navegación interna
    syncMesaSession();
    applyMesaGate();
    closeAppNavOverlay(app);

    if (MESA_GATED_SECTIONS.has(id) && !hasValidMesaSession()) {
      return;
    }

    // Ubicación: modal/drawer (default) o overlay split
    if (id === 'ubicacion') {
      const ubiTheme = String(app.dataset.ubicacionTheme || 'modal')
        .trim()
        .toLowerCase();
      if (ubiTheme !== 'split') {
        const home = app.querySelector('[data-linktree-home]');
        openUbicacionDrawer(app);
        home?.classList.add('scale-[0.98]', 'opacity-40');
        setAppTabsActive(app, 'ubicacion');
        return;
      }
    }

    const home = app.querySelector('[data-linktree-home]');
    const panel = app.querySelector(`[data-section="${id}"]`);
    if (!(panel instanceof HTMLElement)) return;

    closeUbicacionDrawer(app);
    app.querySelectorAll('[data-section]').forEach((el) => {
      if (el instanceof HTMLElement) setPanelOpen(el, false);
    });

    setPanelOpen(panel, true);
    home?.classList.add('scale-[0.98]', 'opacity-40');
    document.documentElement.style.overflow = 'hidden';
    setAppTabsActive(app, id === 'menu' || id === 'nosotros' || id === 'ubicacion' ? id : null);

    if (id === 'wifi') {
      document.dispatchEvent(new CustomEvent('xemilla:wifi-open'));
    }

    if (MESA_GATED_SECTIONS.has(id)) {
      document.dispatchEvent(
        new CustomEvent('xemilla:mesa-panel-open', {
          detail: { section: id, mesa: getStoredMesa() },
        }),
      );
    }
  }

  function closeSections(app: HTMLElement) {
    const home = app.querySelector('[data-linktree-home]');
    closeUbicacionDrawer(app);
    closeAppNavOverlay(app);
    app.querySelectorAll('[data-section]').forEach((el) => {
      if (el instanceof HTMLElement) setPanelOpen(el, false);
    });
    home?.classList.remove('scale-[0.98]', 'opacity-40');
    document.documentElement.style.overflow = '';
    setAppTabsActive(app, null);
  }

  const ALERGENO_META: Record<string, { label: string; emoji: string }> = {
    gluten: { label: 'Gluten', emoji: '🌾' },
    lacteos: { label: 'Lácteos', emoji: '🥛' },
    huevo: { label: 'Huevo', emoji: '🥚' },
    mani: { label: 'Maní', emoji: '🥜' },
    frutos_secos: { label: 'Frutos secos', emoji: '🌰' },
    mariscos: { label: 'Mariscos', emoji: '🦐' },
    pescado: { label: 'Pescado', emoji: '🐟' },
    soja: { label: 'Soja', emoji: '🫘' },
    sesamo: { label: 'Sésamo', emoji: '⚪' },
    picante: { label: 'Picante', emoji: '🌶️' },
    carne: { label: 'Carne', emoji: '🥩' },
    no_vegano: { label: 'No vegano', emoji: '🚫' },
  };

  function renderAlergenoBadges(host: HTMLElement, raw: string) {
    host.replaceChildren();
    const ids = String(raw || '')
      .split(/[,|;]/)
      .map((s) => s.trim().toLowerCase())
      .filter(Boolean);
    const labelEl = host.previousElementSibling;
    if (ids.length === 0) {
      const empty = document.createElement('span');
      empty.className = 'alergeno-badge alergeno-badge--empty';
      empty.textContent = 'Sin alérgenos declarados';
      host.appendChild(empty);
      if (labelEl instanceof HTMLElement) {
        labelEl.textContent = 'Alérgenos';
        labelEl.hidden = false;
      }
      return;
    }
    if (labelEl instanceof HTMLElement) {
      labelEl.textContent = 'Contiene';
      labelEl.hidden = false;
    }
    for (const id of ids) {
      const meta = ALERGENO_META[id] || { label: id, emoji: '⚠️' };
      const badge = document.createElement('span');
      badge.className = 'alergeno-badge';
      badge.dataset.alergeno = id;
      const emoji = document.createElement('span');
      emoji.className = 'alergeno-badge__emoji';
      emoji.setAttribute('aria-hidden', 'true');
      emoji.textContent = meta.emoji;
      const label = document.createElement('span');
      label.className = 'alergeno-badge__label';
      label.textContent = meta.label;
      badge.append(emoji, label);
      host.appendChild(badge);
    }
  }

  function clearDetalleMedia(app: HTMLElement) {
    const imgEl = app.querySelector('[data-detalle-img]');
    const videoEl = app.querySelector('[data-detalle-video]');
    const arEl = app.querySelector('[data-detalle-ar]');
    const mediaStdEl = app.querySelector('[data-detalle-media-std]');
    if (imgEl instanceof HTMLImageElement) {
      imgEl.classList.add('hidden');
      imgEl.removeAttribute('src');
      imgEl.alt = '';
    }
    if (videoEl instanceof HTMLVideoElement) {
      videoEl.pause();
      videoEl.classList.add('hidden');
      videoEl.removeAttribute('src');
      videoEl.load();
    }
    if (arEl instanceof HTMLElement) {
      arEl.innerHTML = '';
      arEl.classList.add('hidden');
    }
    const arBtn = app.querySelector('[data-detalle-ar-btn]');
    if (arBtn instanceof HTMLElement) {
      arBtn.classList.add('hidden');
      arBtn.classList.remove('is-on');
      arBtn.textContent = 'Ver en AR';
      arBtn.removeAttribute('data-ar-src');
    }
    if (mediaStdEl instanceof HTMLElement) mediaStdEl.classList.remove('hidden');
    const descEl = app.querySelector('[data-detalle-desc]');
    if (descEl instanceof HTMLElement) {
      descEl.textContent = '';
      descEl.classList.add('hidden');
    }
    const nutEl = app.querySelector('[data-detalle-nutricion]');
    if (nutEl instanceof HTMLElement) {
      nutEl.classList.add('hidden');
    }
    const badges = app.querySelector('[data-detalle-alergias-badges]');
    if (badges instanceof HTMLElement) badges.innerHTML = '';
  }

  function closeDetalle(app: HTMLElement) {
    const modal = app.querySelector('[data-detalle-modal]');
    if (!(modal instanceof HTMLElement)) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    clearDetalleMedia(app);
  }

  function openBoutique(app: HTMLElement) {
    const modal = app.querySelector('[data-boutique-modal]');
    if (!(modal instanceof HTMLElement)) return;
    closeDetalle(app);
    closeUbicacionDrawer(app);
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeBoutique(app: HTMLElement) {
    const modal = app.querySelector('[data-boutique-modal]');
    if (!(modal instanceof HTMLElement)) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    const anySectionOpen = Array.from(app.querySelectorAll('[data-section]')).some(
      (el) => el instanceof HTMLElement && el.dataset.open === 'true',
    );
    const drawerOpen = app.querySelector('[data-ubicacion-drawer].is-open');
    if (!anySectionOpen && !drawerOpen) {
      document.documentElement.style.overflow = '';
    }
  }

  function macroText(val) {
    if (val == null || val === '') return '—';
    return String(val);
  }

  /** @type {Map<string, {
   *   calorias?: string | number | null,
   *   proteinas?: string | number | null,
   *   carbs?: string | number | null,
   *   grasas?: string | number | null,
   *   alergias?: string[] | string,
   *   ingredientes?: string,
   *   ingredientes_detalle?: string,
   * }>} */
  const nutCache = new Map();

  function readEmbeddedNutricion(app) {
    const el = app.querySelector('[data-menu-nutricion-json]');
    if (!el) return;
    try {
      const parsed = JSON.parse(el.textContent || '{}');
      if (!parsed || typeof parsed !== 'object') return;
      for (const [id, row] of Object.entries(parsed)) {
        nutCache.set(String(id), row);
      }
    } catch {
      /* ignore */
    }
  }

  function mergeNutricion(id, fallback) {
    const live = id ? nutCache.get(String(id)) : null;
    const alergiasLive = Array.isArray(live?.alergias)
      ? live.alergias.join(',')
      : String(live?.alergias || '');
    return {
      calorias: macroText(live?.calorias ?? fallback?.calorias),
      proteinas: macroText(live?.proteinas ?? fallback?.proteinas),
      carbs: macroText(live?.carbs ?? fallback?.carbs),
      grasas: macroText(live?.grasas ?? fallback?.grasas),
      alergias: alergiasLive || fallback?.alergias || '',
      ingredientes:
        String(live?.ingredientes || live?.ingredientes_detalle || fallback?.ingredientes || '').trim(),
    };
  }

  async function hydrateWebappNutricion(app) {
    if (app.dataset.showNutricion !== 'true') return;
    readEmbeddedNutricion(app);
    const restauranteId = app.dataset.restauranteId || '';
    if (!restauranteId) return;
    try {
      const res = await fetch(
        `/api/platos-nutricion?restaurante_id=${encodeURIComponent(restauranteId)}`,
        { cache: 'no-store' },
      );
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !Array.isArray(json.platos)) return;
      for (const plato of json.platos) {
        nutCache.set(String(plato.id), plato);
        const row = app.querySelector(`[data-plato-id="${plato.id}"]`);
        if (row instanceof HTMLElement) {
          row.dataset.alergias = Array.isArray(plato.alergias) ? plato.alergias.join(',') : '';
          row.dataset.ingredientes = plato.ingredientes_detalle || '';
        }
        const btn = app.querySelector(`[data-open-detalle][data-plato-id="${plato.id}"]`);
        if (btn instanceof HTMLElement) {
          if (plato.calorias != null) btn.dataset.platoCalorias = String(plato.calorias);
          if (plato.proteinas != null) btn.dataset.platoProteinas = String(plato.proteinas);
          if (plato.carbs != null) btn.dataset.platoCarbs = String(plato.carbs);
          if (plato.grasas != null) btn.dataset.platoGrasas = String(plato.grasas);
          btn.dataset.platoAlergias = Array.isArray(plato.alergias) ? plato.alergias.join(',') : '';
          btn.dataset.platoIngredientes = plato.ingredientes_detalle || '';
          btn.dataset.platoHasNut = 'true';
        }
      }
    } catch {
      /* silencioso */
    }
  }

  function openDetalle(
    app: HTMLElement,
    url: string,
    title: string,
    platoId?: string,
    platoNombre?: string,
    meta?: {
      desc?: string;
      hasNut?: boolean;
      calorias?: string;
      proteinas?: string;
      carbs?: string;
      grasas?: string;
      alergias?: string;
      ingredientes?: string;
      modelo3dUrl?: string;
    },
  ) {
    const modal = app.querySelector('[data-detalle-modal]');
    const titleEl = app.querySelector('[data-detalle-title]');
    const imgEl = app.querySelector('[data-detalle-img]');
    const videoEl = app.querySelector('[data-detalle-video]');
    if (!(modal instanceof HTMLElement)) return;
    // AR only when the gadget is on AND this dish has a 3D URL
    const hasArContent =
      app.dataset.showAr === 'true' && Boolean(meta?.modelo3dUrl?.trim());
    if (!url && !meta?.hasNut && !hasArContent) return;

    clearDetalleMedia(app);
    if (titleEl) titleEl.textContent = title || 'Plato';

    const descEl = app.querySelector('[data-detalle-desc]');
    const desc = String(meta?.desc || '').trim();
    if (descEl instanceof HTMLElement) {
      if (desc) {
        descEl.textContent = desc;
        descEl.classList.remove('hidden');
      } else {
        descEl.classList.add('hidden');
      }
    }

    const nutEl = app.querySelector('[data-detalle-nutricion]');
    if (nutEl instanceof HTMLElement && app.dataset.showNutricion === 'true') {
      const merged = mergeNutricion(platoId, meta);
      const setMacro = (sel: string, val?: string) => {
        const el = app.querySelector(sel);
        if (el) el.textContent = val && val !== '' ? val : '—';
      };
      setMacro('[data-detalle-kcal]', merged.calorias === '—' ? '' : merged.calorias);
      setMacro('[data-detalle-prot]', merged.proteinas === '—' ? '' : merged.proteinas);
      setMacro('[data-detalle-carbs]', merged.carbs === '—' ? '' : merged.carbs);
      setMacro('[data-detalle-grasas]', merged.grasas === '—' ? '' : merged.grasas);

      const badges = app.querySelector('[data-detalle-alergias-badges]');
      if (badges instanceof HTMLElement) {
        renderAlergenoBadges(badges, merged.alergias || '');
      }

      nutEl.classList.remove('hidden');

      if (platoId) {
        void fetch(`/api/platos-nutricion?id=${encodeURIComponent(platoId)}`, {
          cache: 'no-store',
        })
          .then((res) => res.json().catch(() => ({})))
          .then((json) => {
            if (!json?.plato) return;
            nutCache.set(String(json.plato.id), json.plato);
            const fresh = mergeNutricion(platoId, meta);
            setMacro('[data-detalle-kcal]', fresh.calorias === '—' ? '' : fresh.calorias);
            setMacro('[data-detalle-prot]', fresh.proteinas === '—' ? '' : fresh.proteinas);
            setMacro('[data-detalle-carbs]', fresh.carbs === '—' ? '' : fresh.carbs);
            setMacro('[data-detalle-grasas]', fresh.grasas === '—' ? '' : fresh.grasas);
            if (badges instanceof HTMLElement) {
              renderAlergenoBadges(badges, fresh.alergias || '');
            }
          })
          .catch(() => {});
      }
    }

    const showAr = app.dataset.showAr === 'true';
    const modelo3dUrl = String(meta?.modelo3dUrl || '').trim();
    const arEl = app.querySelector('[data-detalle-ar]');
    const arChip = app.querySelector('[data-detalle-ar-btn]');
    const mediaStdEl = app.querySelector('[data-detalle-media-std]');
    if (mediaStdEl instanceof HTMLElement) mediaStdEl.classList.remove('hidden');

    if (showAr && modelo3dUrl && arChip instanceof HTMLElement) {
      arChip.dataset.arSrc = modelo3dUrl;
      arChip.dataset.arTitle = title || 'Modelo 3D';
      arChip.classList.remove('hidden', 'is-on');
      arChip.textContent = 'Ver en AR';
    } else if (arChip instanceof HTMLElement) {
      arChip.classList.add('hidden');
    }

    if (isVideoUrl(url) && videoEl instanceof HTMLVideoElement) {
      videoEl.src = url;
      videoEl.muted = true;
      videoEl.loop = true;
      videoEl.playsInline = true;
      videoEl.classList.remove('hidden');
      void videoEl.play().catch(() => {
        /* autoplay bloqueado — silencioso */
      });
    } else if (url && imgEl instanceof HTMLImageElement) {
      imgEl.src = url;
      imgEl.alt = title || 'Plato';
      imgEl.classList.remove('hidden');
    }

    if (arEl instanceof HTMLElement) {
      arEl.innerHTML = '';
      arEl.classList.add('hidden');
    }

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');

    // Analytics en background — no await, no bloquea UX
    const restauranteId = app.dataset.restauranteId || '';
    const idNum = Number(platoId);
    if (restauranteId && Number.isFinite(idNum) && idNum > 0) {
      void fetch('/api/registro-vista', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          restaurante_id: restauranteId,
          plato_id: idNum,
          plato_nombre: platoNombre || title || '',
        }),
        keepalive: true,
      }).catch(() => {
        /* silencioso */
      });
    }
  }

  function hideDetalleArViewer(app: HTMLElement) {
    const arEl = app.querySelector('[data-detalle-ar]');
    const arChip = app.querySelector('[data-detalle-ar-btn]');
    if (arEl instanceof HTMLElement) {
      arEl.innerHTML = '';
      arEl.classList.add('hidden');
    }
    if (arChip instanceof HTMLElement) {
      arChip.classList.remove('is-on');
      arChip.textContent = 'Ver en AR';
    }
  }

  function launchDetalleAr(app: HTMLElement) {
    if (app.dataset.showAr !== 'true') return;
    ensureModelViewerLoaded();
    const arEl = app.querySelector('[data-detalle-ar]');
    const arChip = app.querySelector('[data-detalle-ar-btn]');
    if (!(arEl instanceof HTMLElement) || !(arChip instanceof HTMLElement)) return;
    const src = String(arChip.dataset.arSrc || '').trim();
    if (!src) return;

    let mv = arEl.querySelector('model-viewer') as
      | (HTMLElement & { activateAR?: () => Promise<void> })
      | null;

    if (!mv) {
      mv = document.createElement('model-viewer') as HTMLElement & {
        activateAR?: () => Promise<void>;
      };
      mv.setAttribute('src', src);
      mv.setAttribute('alt', arChip.dataset.arTitle || 'Modelo 3D');
      mv.setAttribute('ar', '');
      mv.setAttribute('ar-modes', 'webxr scene-viewer quick-look');
      mv.setAttribute('camera-controls', '');
      mv.setAttribute('auto-rotate', '');
      mv.setAttribute('shadow-intensity', '1.5');
      mv.setAttribute('touch-action', 'pan-y');
      mv.setAttribute('reveal', 'auto');
      mv.style.cssText =
        'width:100%;height:100%;background:transparent;touch-action:pan-y;display:block;';

      const nativeAr = document.createElement('button');
      nativeAr.setAttribute('slot', 'ar-button');
      nativeAr.className = 'detalle-ar-native';
      nativeAr.textContent = 'Ver en AR';
      mv.appendChild(nativeAr);

      arEl.innerHTML = '';
      arEl.appendChild(mv);
      arEl.classList.remove('hidden');
    }

    arChip.classList.add('is-on');
    arChip.textContent = 'Ver en AR';

    const tryActivate = () => {
      if (typeof mv?.activateAR === 'function') {
        void mv.activateAR().catch(() => {
          /* PC sin WebXR: queda el modelo 3D girando */
        });
      }
    };

    if (customElements.get('model-viewer')) {
      tryActivate();
    } else {
      customElements.whenDefined('model-viewer').then(tryActivate).catch(() => {});
    }
  }

  function initRestaurantApps() {
    document.querySelectorAll('[data-restaurant-app]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.navReady === 'true') return;
      if (root.dataset.showAr === 'true') ensureModelViewerLoaded();
      root.dataset.navReady = 'true';
      void hydrateWebappNutricion(root);

      // Hamburguesa Alchemist — overlay fullscreen
      const burger = root.querySelector('[data-app-nav-burger]');
      const overlay = root.querySelector('[data-app-nav-overlay]');
      const closeNav = root.querySelector('[data-app-nav-close]');
      if (burger instanceof HTMLElement && overlay instanceof HTMLElement) {
        const setOpen = (open: boolean) => {
          overlay.classList.toggle('is-open', open);
          overlay.setAttribute('aria-hidden', open ? 'false' : 'true');
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (open) {
            document.documentElement.style.overflow = 'hidden';
          } else {
            const anyOpen = Array.from(root.querySelectorAll('[data-section]')).some(
              (el) => el instanceof HTMLElement && el.dataset.open === 'true',
            );
            const drawerOpen = root.querySelector('[data-ubicacion-drawer].is-open');
            if (!anyOpen && !drawerOpen) {
              document.documentElement.style.overflow = '';
            }
          }
          document.documentElement.classList.remove('overflow-hidden');
        };
        burger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          setOpen(true);
        });
        closeNav?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          setOpen(false);
        });
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
            setOpen(false);
          }
        });
      }

      // Delegación: cubre HomeBentoGrid / Hero / Editorial (incl. UBICACIÓN)
      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const openBtn = target.closest('[data-open-section]');
        if (openBtn instanceof HTMLElement && root.contains(openBtn)) {
          const id = openBtn.dataset.openSection?.trim();
          if (id) {
            event.preventDefault();
            openSection(root, id);
            return;
          }
        }

        if (target.closest('[data-open-boutique]') && root.contains(target.closest('[data-open-boutique]'))) {
          closeAppNavOverlay(root);
          openBoutique(root);
          return;
        }

        if (target.closest('[data-close-section]')) {
          closeDetalle(root);
          closeBoutique(root);
          closeSections(root);
          return;
        }

        const detalleBtn = target.closest('[data-open-detalle]');
        if (detalleBtn instanceof HTMLElement) {
          const url = detalleBtn.dataset.mediaUrl?.trim() || '';
          const title = detalleBtn.dataset.mediaTitle || 'Plato';
          const platoId = detalleBtn.dataset.platoId || '';
          const platoNombre = detalleBtn.dataset.platoNombre || title;
          const modelo3dUrl = detalleBtn.dataset.platoModelo3dUrl?.trim() || '';
          const hasAr = root.dataset.showAr === 'true' && Boolean(modelo3dUrl);
          if (url || detalleBtn.dataset.platoHasNut === 'true' || hasAr) {
            openDetalle(root, url, title, platoId, platoNombre, {
              desc: detalleBtn.dataset.platoDesc || '',
              hasNut: detalleBtn.dataset.platoHasNut === 'true',
              calorias: detalleBtn.dataset.platoCalorias || '',
              proteinas: detalleBtn.dataset.platoProteinas || '',
              carbs: detalleBtn.dataset.platoCarbs || '',
              grasas: detalleBtn.dataset.platoGrasas || '',
              alergias: detalleBtn.dataset.platoAlergias || '',
              ingredientes: detalleBtn.dataset.platoIngredientes || '',
              modelo3dUrl,
            });
          }
          return;
        }

        const arChipBtn = target.closest('[data-detalle-ar-btn]');
        if (arChipBtn instanceof HTMLElement && root.contains(arChipBtn)) {
          event.preventDefault();
          event.stopPropagation();
          launchDetalleAr(root);
          return;
        }

        if (
          target.closest('[data-detalle-close]') ||
          target.closest('[data-detalle-backdrop]')
        ) {
          closeDetalle(root);
          return;
        }

        if (
          target.closest('[data-ubicacion-drawer-close]') ||
          target.closest('[data-ubicacion-drawer-backdrop]')
        ) {
          closeSections(root);
          return;
        }

        if (
          target.closest('[data-boutique-close]') ||
          target.closest('[data-boutique-backdrop]')
        ) {
          closeBoutique(root);
        }
      });

      // Parallax ligero: solo transform3d en el scroll del panel de menú
      const parallaxLayer = root.querySelector('[data-parallax-layer]');
      const menuScroll = root
        .querySelector('[data-section="menu"]')
        ?.querySelector('.overflow-y-auto');

      if (
        parallaxLayer instanceof HTMLElement &&
        menuScroll instanceof HTMLElement
      ) {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const y = menuScroll.scrollTop * 0.22;
            parallaxLayer.style.transform = `translate3d(0, ${y}px, 0)`;
            ticking = false;
          });
        };
        menuScroll.addEventListener('scroll', onScroll, { passive: true });
      }
    });
  }

  function ensureModelViewerLoaded() {
    if (typeof customElements === 'undefined') return;
    if (customElements.get('model-viewer')) return;
    if (document.querySelector('script[data-model-viewer]')) return;
    const s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js';
    s.setAttribute('data-model-viewer', 'true');
    document.head.appendChild(s);
  }

  initRestaurantApps();
  document.addEventListener('astro:page-load', initRestaurantApps);
</script>
