---
import OverlayPanel from './OverlayPanel.astro';
import MenuPanel from './MenuPanel.astro';
import NosotrosPanel from './NosotrosPanel.astro';
import SectionAtmosphere from './SectionAtmosphere.astro';
import WifiGadget from '../gadgets/WifiGadget.astro';
import BoutiqueGadget from '../gadgets/BoutiqueGadget.astro';
import GadgetFloatingButton from './GadgetFloatingButton.astro';
import WelcomePopup from './WelcomePopup.astro';
import HomeEditorial from '../themes/home/HomeEditorial.astro';
import HomeSheet from '../themes/home/HomeSheet.astro';
import HomePergamino from '../themes/home/HomePergamino.astro';
import HomeSplit from '../themes/home/HomeSplit.astro';
import HomeCards from '../themes/home/HomeCards.astro';
import UbicacionModal from '../themes/ubicacion/UbicacionModal.astro';
import UbicacionSplitMap from '../themes/ubicacion/UbicacionSplitMap.astro';
import UbicacionMinimal from '../themes/ubicacion/UbicacionMinimal.astro';
import { themeToCssVars, homeBackgroundCssVars, DEFAULT_THEME } from '../../lib/theme.js';
import {
  resolveHomeThemeAndNav,
  normalizeUbicacionTheme,
  normalizeNosotrosTheme,
  DEFAULT_NOSOTROS_THEME,
} from '../../lib/layout-themes.js';
import { resolveMediaUrl, optimizeHomeVideoUrl } from '../../lib/cloudinary.js';
import { resolveSafeHomeProps } from '../../lib/home-safe-props.js';
import { fetchTasasCambio } from '../../lib/tasas-cambio.js';
import {
  scopeCssAvanzado,
  normalizeFondoAnimacion,
  normalizeOverlayEstilo,
} from '../../lib/secciones-ui.js';
import {
  hasOperationalGadgets,
  normalizeGadgetServiciosEstilo,
} from '../../lib/gadgets.js';
import { resolveUbicacionSectionColors } from '../../lib/ubicacion-theme-data.js';
import { parsePopupBanner } from '../../lib/popup-banner.js';
import { jsonForScript } from '../../lib/safe-json.js';

interface Props {
   
  restaurante: any;
  /** Plantilla Home forzada desde [slug].astro (SSR) — solo estructura */
  homeTheme?: string;
  /** Plantilla Nosotros forzada desde [slug].astro (SSR) */
  nosotrosTheme?: string;
  /** Plantilla Ubicación forzada desde [slug].astro (SSR) */
  ubicacionTheme?: string;
}

const { restaurante, homeTheme: homeThemeProp, nosotrosTheme: nosotrosThemeProp, ubicacionTheme: ubicacionThemeProp } = Astro.props;
const theme = restaurante?.theme ?? DEFAULT_THEME;
const gadgets = restaurante?.gadgets || {};
const uiEstilo = restaurante?.uiEstilo || {};
const showWifi = Boolean(gadgets?.wifi);
const showReservas = Boolean(gadgets?.reservas);
const showBoutique = Boolean(gadgets?.boutique);
const showNutricion = Boolean(gadgets?.nutricion);
const showAr = Boolean(gadgets?.ar);
const hasOperationalFloating = hasOperationalGadgets(gadgets);
const gadgetServiciosEstilo = normalizeGadgetServiciosEstilo(
  uiEstilo?.home?.gadget_servicios_estilo ?? uiEstilo?.home?.gadgetServiciosEstilo,
);
let tasasCambio = { usdVes: 36.5, eurVes: 40, fuente: 'fallback', fecha: null };
try {
  tasasCambio = (await fetchTasasCambio()) || tasasCambio;
} catch (err) {
  console.error('[RestaurantApp] tasas de cambio:', err);
}
const boutiqueProductos = Array.isArray(restaurante?.boutique?.productos)
  ? restaurante.boutique.productos
  : [];

/** Plantilla Home + navegación (hamburguesa vive en plantilla) */
const resolvedHome = resolveHomeThemeAndNav(
  uiEstilo?.home?.layout ||
    homeThemeProp ||
    restaurante?.home_theme ||
    restaurante?.homeTheme ||
    '',
  uiEstilo?.home?.estilo_navegacion ??
    uiEstilo?.home?.estiloNavegacion ??
    uiEstilo?.home?.nav_style,
);
let homeTheme = resolvedHome.homeTheme;
/** Pergamino lleva el Wi‑Fi dentro del rollo: no duplicarlo en el botón flotante. */
const floatingGadgets = homeTheme === 'pergamino' ? { ...gadgets, wifi: false } : gadgets;
const estiloNavegacion = resolvedHome.estiloNavegacion;
const ubicacionTheme = normalizeUbicacionTheme(
  ubicacionThemeProp ?? restaurante?.ubicacionTheme ?? restaurante?.ubicacion_theme,
);
const nosotrosTheme = normalizeNosotrosTheme(
  nosotrosThemeProp ??
    restaurante?.nosotrosTheme ??
    restaurante?.nosotros_theme ??
    restaurante?.uiEstilo?.nosotros?.theme ??
    DEFAULT_NOSOTROS_THEME,
);

/** Fondos desde Identidad de Marca (independientes de home_theme) */
const fondos = restaurante?.seccionesFondo ?? {};
const fondoHome = fondos?.home ?? { tipo: 'color', valor: theme.colorFondo };
const fondoNosotros = fondos?.nosotros ?? { tipo: 'color', valor: '' };
const fondoMenu = fondos?.menu ?? { tipo: 'color', valor: '' };
const fondoUbicacion = fondos?.ubicacion ?? { tipo: 'color', valor: '' };

/** Atmósfera siempre tiene capa base (color) si falta media — shell es bg-transparent */
const atmosphereTipo = String(fondoHome?.valor || '').trim()
  ? String(fondoHome?.tipo || 'color')
  : 'color';
const atmosphereValorRaw = String(fondoHome?.valor || '').trim() || theme.colorFondo;
const atmosphereValor =
  atmosphereTipo === 'video'
    ? optimizeHomeVideoUrl(atmosphereValorRaw)
    : atmosphereValorRaw;

/** Overlay Home: estilo cinemático + opacidad (solo filtro oscuro / cinematico) */
const homeOverlayOpacity =
  uiEstilo?.home?.overlay_opacity ??
  uiEstilo?.home?.overlayOpacity ??
  40;
const homeOverlayEstilo = normalizeOverlayEstilo(
  uiEstilo?.home?.overlay_estilo ?? uiEstilo?.home?.overlayEstilo,
);
const homeFondoAnimacion = normalizeFondoAnimacion(
  uiEstilo?.home?.fondo_animacion ?? uiEstilo?.home?.fondoAnimacion,
);

/** Navegación Home derivada de plantilla */
const isNavHamburguesa = estiloNavegacion === 'hamburguesa';
const isNavAppTabs = estiloNavegacion === 'app_tabs';
const hideCentralNav = isNavHamburguesa || isNavAppTabs;
const fabOffsetClass = isNavAppTabs ? '!bottom-24' : '';

const menuColorCss =
  uiEstilo?.home?.menu_color ||
  uiEstilo?.home?.menuColor ||
  '#ffffff';

const cssVars = [
  themeToCssVars(theme),
  homeBackgroundCssVars(fondoHome, theme.colorFondo),
  restaurante?.uiCssVars || '',
]
  .filter(Boolean)
  .join('; ');

const reservas = restaurante?.reservas ?? {};
const reservasHomeLabel = reservas?.incluyeDelivery
  ? 'RESERVA & DELIVERY'
  : reservas?.label || 'PEDIR / RESERVAR';
/** CTA visible con el switch ON (aunque falte href aún) */
const reservasCta = showReservas
  ? {
      label: reservasHomeLabel,
      href: reservas?.href || '#',
      subtitulo: reservas?.subtitulo || reservas?.subtitle || 'EXPERIENCIA PREMIUM',
      activo: true,
    }
  : null;

/** Ficha nutricional embebida para el modal de la WebApp */
const menuNutricionById = {};
if (showNutricion) {
  const cats = restaurante?.menu?.categorias || [];
  for (const cat of cats) {
    for (const p of cat.platos || []) {
      if (p?.id == null) continue;
      menuNutricionById[String(p.id)] = {
        calorias: p.calorias ?? null,
        proteinas: p.proteinas ?? null,
        carbs: p.carbs ?? null,
        grasas: p.grasas ?? null,
        alergias: Array.isArray(p.alergias) ? p.alergias : [],
        ingredientes: p.ingredientesDetalle || p.ingredientes_detalle || '',
      };
    }
  }
}

/** Logo: logo_url | logo → siempre por resolveMediaUrl */
let logoUrl = null;
try {
  logoUrl = resolveMediaUrl(
    restaurante?.logo_url || restaurante?.logo || restaurante?.logoUrl || '',
    'logo',
  );
} catch (e) {
  console.error('Error renderizando tema:', e);
  logoUrl = null;
}

/** Props Home blindadas — nunca undefined sin fallback */
const taglineSuperior = String(
  restaurante?.taglineSuperior ||
    uiEstilo?.home?.tagline_superior ||
    uiEstilo?.home?.taglineSuperior ||
    '',
).trim();
const brandTagline = String(
  restaurante?.tagline || restaurante?.eslogan || '',
).trim();

let homeProps = {
  ...resolveSafeHomeProps({
    nombre: restaurante?.nombre || 'Restaurante',
    logoText: restaurante?.logoText,
    logoLetter: restaurante?.logoLetter,
    logoUrl: logoUrl || null,
    logo_url: logoUrl || null,
    tagline: brandTagline,
    eslogan: brandTagline,
    taglineSuperior,
    tagline_superior: taglineSuperior,
    slug: restaurante?.slug || '',
    menu_link:
      restaurante?.menu_link ||
      (restaurante?.slug ? `/${restaurante.slug}/menu` : ''),
    estilos: restaurante?.estilos,
    showWifi: hasOperationalFloating ? false : showWifi,
    showBoutique: hasOperationalFloating ? false : showBoutique,
    wifiSsid: restaurante?.wifi?.ssid || '',
    wifiClave: restaurante?.wifi?.password || '',
    reservasCta,
    homeUi: uiEstilo?.home || {},
  }),
  taglineSuperior,
  tagline_superior: taglineSuperior,
  /** Reservas CTA — visibles con switch ON (no dependen de href) */
  showReservas,
  reservas_activo: showReservas,
  reservas_texto: reservasHomeLabel,
  reservas_subtitulo:
    reservas?.subtitulo || reservas?.subtitle || 'EXPERIENCIA PREMIUM',
  reservas_link: reservas?.href || '#',
  wifiActivo: showWifi,
  wifiRed: restaurante?.wifi?.ssid || '',
  estiloNavegacion,
  hideCentralNav,
};

const ubicacion = restaurante?.ubicacion ?? {};
const ubicacionSectionColors = resolveUbicacionSectionColors(
  uiEstilo?.ubicacion || {},
  uiEstilo?.home || {},
  {
    fondoColor:
      String(fondoUbicacion?.tipo || '').toLowerCase() === 'color'
        ? String(fondoUbicacion?.valor || '').trim()
        : '',
  },
);
const ubicacionProps = {
  direccion: ubicacion?.direccion || '',
  ciudad: ubicacion?.ciudad || '',
  telefono: ubicacion?.telefono || '',
  email: ubicacion?.email || '',
  instagram: ubicacion?.instagram || '',
  whatsapp: ubicacion?.whatsapp || restaurante?.whatsapp || '',
  redes: Array.isArray(ubicacion?.redes) ? ubicacion.redes : [],
  mapaLabel: ubicacion?.mapaLabel || '',
  mapaUrl: ubicacion?.mapaUrl || '',
  horarios: ubicacion?.horarios ?? '',
  horariosRows: ubicacion?.horariosRows ?? [],
  sectionColors: ubicacionSectionColors,
  estilos: homeProps.estilos,
};

homeProps = {
  ...homeProps,
  horariosRows: Array.isArray(ubicacion?.horariosRows) ? ubicacion.horariosRows : [],
};

/** Si falla la resolución del tema, loguear y caer a bento solo por error real */
try {
  if (!homeProps?.nombre) {
    throw new Error('homeProps.nombre vacío tras resolveSafeHomeProps');
  }
} catch (e) {
  console.error('Error renderizando tema:', e);
  homeTheme = 'editorial';
  homeProps = {
    ...resolveSafeHomeProps({ nombre: 'Restaurante', estilos: restaurante?.estilos }),
    showReservas,
    reservas_activo: showReservas,
    reservas_texto: 'PEDIR / RESERVAR',
    reservas_subtitulo: 'EXPERIENCIA PREMIUM',
    reservas_link: '#',
    estiloNavegacion,
    hideCentralNav,
  };
}

const estilos = homeProps.estilos;
const menu = restaurante?.menu ?? {};
const nosotros = restaurante?.nosotros ?? {};
const hasCatCinematicMedia = (menu?.categorias || []).some((cat) => {
  const tipo = String(cat?.bgType || '').toLowerCase();
  const valor = String(cat?.bgValor || '').trim();
  return Boolean(valor) && (tipo === 'image' || tipo === 'video' || /^https?:\/\//i.test(valor));
});
const menuFondosCinematicos =
  uiEstilo?.menu?.fondos_cinematicos === true ||
  (uiEstilo?.menu?.fondos_cinematicos == null && hasCatCinematicMedia);
const popupBanner = parsePopupBanner(restaurante?.popup_banner ?? restaurante?.popupBanner);

/** CSS avanzado: ui_estilo.css_avanzado (canónico) ↔ columna custom_css */
const cssAvanzadoScoped = scopeCssAvanzado(
  uiEstilo?.css_avanzado ||
    restaurante?.customCss ||
    restaurante?.custom_css ||
    '',
);
---

{cssAvanzadoScoped ? <style is:inline set:html={cssAvanzadoScoped} /> : null}

<div
  class="restaurant-app relative z-10 mx-auto min-h-dvh w-full bg-transparent text-[color:var(--color-text,var(--color-texto))] font-[family-name:var(--font-body,var(--fuente-principal))]"
  data-restaurant-app
  data-preview-live="true"
  data-surface="home"
  data-restaurante-id={restaurante?.id || ''}
  data-design={theme?.designDnaId || 'elegant'}
  data-home-theme={homeTheme}
  data-nosotros-theme={nosotrosTheme}
  data-ubicacion-theme={ubicacionTheme}
  data-estilo-navegacion={estiloNavegacion}
  data-fondo-home-tipo={fondoHome.tipo || 'color'}
  data-show-nutricion={showNutricion ? 'true' : 'false'}
  data-show-ar={showAr ? 'true' : 'false'}
  style={cssVars}
>
  {
    showNutricion ? (
      <script is:inline type="application/json" data-menu-nutricion-json set:html={jsonForScript(menuNutricionById || {})} />
    ) : null
  }
  {/*
    HOME stacking (decoupled):
    - Atmosphere: fixed inset-0 z-0 pointer-events-none (SectionAtmosphere)
    - Theme chrome: relative z-10 pointer-events-auto
    Nav structure (hamburguesa / app_tabs) never mutates atmosphere.
    Nota: z-0 (no z-[-1]) — z negativo puede pintar detrás del background del body.
  */}
  <div
    class="relative flex min-h-dvh w-full flex-col bg-transparent"
    data-home-shell
    data-resolved-home-theme={homeTheme}
  >
    {/* Atmósfera centralizada — color | image | carrusel | video + overlays */}
    <SectionAtmosphere
      tipo={atmosphereTipo}
      valor={atmosphereValor}
      overlayOpacity={homeOverlayOpacity}
      overlayEstilo={homeOverlayEstilo}
      fondoAnimacion={homeFondoAnimacion}
      fixed
    />

    {
      !String(fondoHome?.valor || '').trim() && (
        <div
          class="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-40"
          aria-hidden="true"
          data-parallax-root
        >
          <div
            class="absolute inset-[-10%] bg-[radial-gradient(ellipse_at_top,color-mix(in_srgb,var(--color-primary,var(--color-primario))_28%,transparent),transparent_55%)] will-change-transform"
            data-parallax-layer
            style="transform: translate3d(0,0,0)"
          />
        </div>
      )
    }

    {/* Tema Home: solo estructura (logo / títulos / nav) */}
    <div class="relative z-10 flex min-h-dvh w-full flex-col bg-transparent pointer-events-auto">
      {
        (() => {
          try {
            if (homeTheme === 'editorial') {
              return <HomeEditorial {...homeProps} />;
            }
            if (homeTheme === 'sheet' || homeTheme === 'cinematic' || homeTheme === 'hamburguesa' || homeTheme === 'minimal') {
              return <HomeSheet {...homeProps} />;
            }
            if (homeTheme === 'split') {
              return <HomeSplit {...homeProps} />;
            }
            if (homeTheme === 'pergamino') {
              return <HomePergamino {...homeProps} />;
            }
            if (homeTheme === 'cards' || homeTheme === 'bento' || homeTheme === 'hero') {
              return <HomeCards {...homeProps} />;
            }
            return <HomeEditorial {...homeProps} />;
          } catch (e) {
            console.error('Error renderizando tema:', e);
            return <HomeEditorial {...homeProps} />;
          }
        })()
      }
    </div>
  </div>

  {
    isNavHamburguesa ? (
      <>
        <button
          type="button"
          class="absolute right-4 top-[max(1rem,env(safe-area-inset-top))] z-30 flex size-11 items-center justify-center text-2xl leading-none transition-all duration-500 ease-in-out hover:opacity-70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/40 sm:right-6"
          style={`color: ${menuColorCss}`}
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="app-nav-overlay"
          data-app-nav-burger
        >
          ☰
        </button>

        <div
          id="app-nav-overlay"
          class="pointer-events-none fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/95 px-6 opacity-0 backdrop-blur-2xl transition-all duration-500 ease-in-out"
          data-app-nav-overlay
          aria-hidden="true"
        >
          <button
            type="button"
            class="absolute right-4 top-[max(1rem,env(safe-area-inset-top))] z-50 flex size-11 items-center justify-center text-2xl leading-none text-white/70 transition-all duration-500 ease-in-out hover:text-white sm:right-6"
            aria-label="Cerrar menú"
            data-app-nav-close
          >
            ✕
          </button>

          <nav
            class="flex max-h-[min(85dvh,40rem)] w-full max-w-[22rem] flex-col items-center gap-2 overflow-y-auto overscroll-contain py-16 text-center"
            aria-label="Navegación principal"
            data-app-nav-panel
          >
            <button
              type="button"
              data-open-section="menu"
              class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white focus-visible:tracking-[0.3em] focus-visible:text-white focus-visible:outline-none sm:text-4xl"
            >
              Menú
            </button>
            <button
              type="button"
              data-open-section="nosotros"
              class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white focus-visible:tracking-[0.3em] focus-visible:text-white focus-visible:outline-none sm:text-4xl"
            >
              Nosotros
            </button>
            <button
              type="button"
              data-open-section="ubicacion"
              class="w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white focus-visible:tracking-[0.3em] focus-visible:text-white focus-visible:outline-none sm:text-4xl"
            >
              Horarios y Ubicación
            </button>
            {
              showReservas && reservasCta ? (
                <a
                  href={reservasCta.href || '#'}
                  target={reservasCta.href && reservasCta.href !== '#' ? '_blank' : undefined}
                  rel={reservasCta.href && reservasCta.href !== '#' ? 'noopener noreferrer' : undefined}
                  class="mt-6 w-full py-3 text-3xl font-light uppercase tracking-widest text-white/70 transition-all duration-500 hover:tracking-[0.3em] hover:text-white sm:text-4xl"
                  data-reservas-home-cta
                >
                  {reservasCta.label || 'Pedir / Reservar'}
                </a>
              ) : null
            }
          </nav>
        </div>
      </>
    ) : null
  }

  {
    isNavAppTabs ? (
      <nav
        class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full items-stretch justify-around border-t border-white/10 bg-black/80 px-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] pt-2 backdrop-blur-xl"
        aria-label="Navegación inferior"
        data-app-tabs
      >
        <button
          type="button"
          data-open-section="menu"
          data-app-tab="menu"
          class="app-tab flex flex-1 flex-col items-center gap-1 py-2 text-[0.58rem] font-medium uppercase tracking-[0.14em] text-white/55 transition-colors duration-300 data-[active=true]:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h10"></path>
          </svg>
          Menú
        </button>
        <button
          type="button"
          data-open-section="nosotros"
          data-app-tab="nosotros"
          class="app-tab flex flex-1 flex-col items-center gap-1 py-2 text-[0.58rem] font-medium uppercase tracking-[0.14em] text-white/55 transition-colors duration-300 data-[active=true]:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true">
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
            <path d="M4 20a8 8 0 0 1 16 0"></path>
          </svg>
          Nosotros
        </button>
        <button
          type="button"
          data-open-section="ubicacion"
          data-app-tab="ubicacion"
          class="app-tab flex flex-1 flex-col items-center gap-1 py-2 text-[0.58rem] font-medium uppercase tracking-[0.14em] text-white/55 transition-colors duration-300 data-[active=true]:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true">
            <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
          Horarios y Ubicación
        </button>
      </nav>
    ) : null
  }

  {/* Overlays / drawers: hermanos del Home, no hijos (z-index por encima del shell) */}
  <div class="relative z-50" data-overlays-root>
    <OverlayPanel
      sectionId="menu"
      title="MENÚ"
      fondoTipo={String(fondoMenu?.valor || '').trim() ? fondoMenu.tipo : 'color'}
      fondoValor={String(fondoMenu?.valor || '').trim() || theme.colorFondo}
      overlayEstilo="puro"
      overlayOpacity={0}
      categoryCrossfade={menuFondosCinematicos}
      categoryBackgrounds={Object.fromEntries(
        (menu?.categorias || []).map((cat) => [
          String(cat.id),
          { tipo: cat.bgType || 'color', valor: cat.bgValor || '' },
        ]),
      )}
      sectionColors={{
        color_header: uiEstilo?.menu?.color_texto || '',
        color_titulo: uiEstilo?.menu?.color_texto || '',
        color_cuerpo: uiEstilo?.menu?.color_texto || '',
      }}
      estilos={{ ...estilos, panelColor: 'bg-transparent' }}
    >
      <MenuPanel
        categorias={menu?.categorias || []}
        destacados={menu?.destacados ?? []}
        fondoGlobal={fondoMenu}
        cinematicCategoryBg={menuFondosCinematicos}
        showNutricion={showNutricion}
        showAr={showAr}
        tasaBcv={tasasCambio.usdVes}
        tasaEurUsd={
          Number(tasasCambio.usdVes) > 0 && Number(tasasCambio.eurVes) > 0
            ? Number(tasasCambio.usdVes) / Number(tasasCambio.eurVes)
            : 0.92
        }
        tasaEur={tasasCambio.eurVes}
        menuUi={uiEstilo?.menu}
        menuFont={restaurante?.menu_font || restaurante?.theme?.menuFont || ''}
        menuTitle="MENÚ"
        estilos={estilos}
      />
    </OverlayPanel>

    <OverlayPanel
      sectionId="nosotros"
      title={nosotros?.titulo || 'NOSOTROS'}
      fondoTipo={fondoNosotros.tipo}
      fondoValor={fondoNosotros.valor}
      sectionColors={uiEstilo?.nosotros}
      estilos={estilos}
    >
      <NosotrosPanel
        theme={nosotrosTheme}
        bloques={nosotros?.bloques ?? []}
        texto={nosotros?.texto || ''}
        highlights={nosotros?.highlights || []}
        designDnaId={theme?.designDnaId || 'elegant'}
        sectionColors={uiEstilo?.nosotros}
        estilos={estilos}
      />
    </OverlayPanel>

    {
