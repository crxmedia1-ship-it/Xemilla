---
import SectionAtmosphere from './SectionAtmosphere.astro';

interface Props {
  sectionId: string;
  title: string;
  fondoTipo?: string;
  fondoValor?: string;
  overlayEstilo?: string;
  overlayOpacity?: number | string;
  fondoAnimacion?: string;
  categoryCrossfade?: boolean;
  categoryBackgrounds?: Record<string, { tipo?: string; valor?: string }>;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
    color_header?: string;
  };
  estilos: {
    textColor: string;
    borderColor: string;
    mutedColor: string;
    displayClass: string;
    panelColor: string;
  };
}

const {
  sectionId,
  title,
  fondoTipo = 'color',
  fondoValor = '',
  overlayEstilo,
  overlayOpacity,
  fondoAnimacion,
  categoryCrossfade = false,
  categoryBackgrounds = {},
  sectionColors = {},
  estilos,
} = Astro.props;

const containerBg = (sectionColors.color_fondo || '').trim();
const titleColor = (sectionColors.color_header || sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const fondoValorTrim = String(fondoValor || '').trim();
const fondoTipoNorm = String(fondoTipo || 'color').trim().toLowerCase();

/** Atmósfera = fondo general (no se cancela si hay color de contenedor). */
const hasAtmosphere =
  categoryCrossfade ||
  ((fondoTipoNorm === 'image' ||
    fondoTipoNorm === 'video' ||
    fondoTipoNorm === 'color' ||
    fondoTipoNorm === 'carrusel') &&
    Boolean(fondoValorTrim));

/**
 * Color sólido sin overlay salvo que el caller pida uno (p.ej. menú con Home oscuro).
 * Media: overlay del caller o puro.
 */
const hasExplicitOverlay = Boolean(
  overlayEstilo && String(overlayEstilo).trim().toLowerCase() !== 'puro',
);
const atmosphereOverlay =
  fondoTipoNorm === 'color' ? hasExplicitOverlay : true;
const atmosphereOverlayEstilo =
  fondoTipoNorm === 'color'
    ? hasExplicitOverlay
      ? overlayEstilo
      : 'puro'
    : overlayEstilo || 'puro';

/**
 * Contenedor:
 * - Sin atmósfera → pinta el sheet completo.
 * - Con atmósfera → solo CSS var para tarjetas/contenido (no tapa el fondo).
 */
const sheetStyle = [
  containerBg ? `--sec-fondo:${containerBg}` : '',
  titleColor ? `--sec-titulo:${titleColor}` : '',
  bodyColor ? `--sec-cuerpo:${bodyColor}` : '',
  !hasAtmosphere && containerBg ? `background-color:${containerBg}` : '',
  !hasAtmosphere && !containerBg && fondoTipoNorm === 'color' && fondoValorTrim
    ? `background-color:${fondoValorTrim}`
    : '',
  hasAtmosphere && fondoTipoNorm !== 'color'
    ? 'background-color:var(--color-fondo)'
    : '',
]
  .filter(Boolean)
  .join('; ');

const headerStyle = [
  containerBg && !hasAtmosphere
    ? `background-color:color-mix(in srgb, ${containerBg} 92%, transparent)`
    : hasAtmosphere && fondoTipoNorm === 'color' && fondoValorTrim
      ? `background-color:color-mix(in srgb, ${fondoValorTrim} 88%, transparent)`
      : hasAtmosphere
        ? 'background-color:color-mix(in srgb, var(--color-fondo) 72%, transparent)'
        : '',
  titleColor ? `color:${titleColor}` : '',
]
  .filter(Boolean)
  .join('; ');

const bodyStyle = [bodyColor ? `color:${bodyColor}` : ''].filter(Boolean).join('; ');
---

<section
  id={`section-${sectionId}`}
  data-section={sectionId}
  data-open="false"
  class:list={[
    'panel-sheet pointer-events-none fixed inset-0 z-50 mx-auto flex w-full translate-y-full flex-col opacity-0 transition-[transform,opacity] duration-300 ease-out',
    !hasAtmosphere && !containerBg && estilos.panelColor,
    !titleColor && !bodyColor ? estilos.textColor : '',
  ]}
  style={sheetStyle || undefined}
  aria-hidden="true"
>
  {hasAtmosphere && (
    <SectionAtmosphere
      tipo={fondoTipoNorm}
      valor={fondoValorTrim}
      overlay={atmosphereOverlay}
      overlayEstilo={atmosphereOverlayEstilo}
      overlayOpacity={overlayOpacity}
      fondoAnimacion={fondoAnimacion}
      categoryCrossfade={categoryCrossfade}
      categoryBackgrounds={categoryBackgrounds}
    />
  )}

  <header
    class:list={[
      'sticky top-0 z-20 flex items-center justify-between border-b border-white/10 px-5 py-4 pt-[max(1rem,env(safe-area-inset-top))]',
      !hasAtmosphere && !containerBg && estilos.panelColor,
      estilos.borderColor,
    ]}
    style={headerStyle || undefined}
  >
    <h2
      class={`relative z-10 text-[0.72rem] font-semibold tracking-[0.28em] uppercase ${estilos.displayClass}`}
      style={titleColor ? `color:${titleColor}` : undefined}
    >
      {title}
    </h2>
    <button
      type="button"
      data-close-section
      class={`relative z-10 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 shadow-inner backdrop-blur-md transition-all duration-200 active:scale-95 ${estilos.mutedColor}`}
      aria-label="Cerrar"
      style={titleColor ? `color:${titleColor}` : undefined}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        class="h-4 w-4"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </header>

  <div
    class:list={[
      'relative z-10 flex-1 overflow-y-auto overscroll-contain',
      !hasAtmosphere && !containerBg && estilos.panelColor,
    ]}
    style={bodyStyle || undefined}
  >
    <slot />
  </div>
</section>
