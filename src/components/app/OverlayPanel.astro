---
import SectionAtmosphere from './SectionAtmosphere.astro';

interface Props {
  sectionId: string;
  title: string;
  fondoTipo?: string;
  fondoValor?: string;
  overlayEstilo?: string;
  overlayOpacity?: number | string;
  fondoAnimacion?: string;
  categoryCrossfade?: boolean;
  categoryBackgrounds?: Record<string, { tipo?: string; valor?: string }>;
  sectionColors?: {
    color_fondo?: string;
    color_titulo?: string;
    color_cuerpo?: string;
    color_header?: string;
  };
  estilos: {
    textColor: string;
    borderColor: string;
    mutedColor: string;
    displayClass: string;
    panelColor: string;
  };
}

const {
  sectionId,
  title,
  fondoTipo = 'color',
  fondoValor = '',
  overlayEstilo,
  overlayOpacity,
  fondoAnimacion,
  categoryCrossfade = false,
  categoryBackgrounds = {},
  sectionColors = {},
  estilos,
} = Astro.props;

const containerBg = (sectionColors.color_fondo || '').trim();
const titleColor = (sectionColors.color_header || sectionColors.color_titulo || '').trim();
const bodyColor = (sectionColors.color_cuerpo || '').trim();
const fondoValorTrim = String(fondoValor || '').trim();
const fondoTipoNorm = String(fondoTipo || 'color').trim().toLowerCase();

/** Atmósfera = fondo general (no se cancela si hay color de contenedor). */
const hasAtmosphere =
  categoryCrossfade ||
  ((fondoTipoNorm === 'image' ||
    fondoTipoNorm === 'video' ||
    fondoTipoNorm === 'color' ||
    fondoTipoNorm === 'carrusel') &&
    Boolean(fondoValorTrim));

/**
 * Color sólido sin overlay salvo que el caller pida uno (p.ej. menú con Home oscuro).
 * Media: overlay del caller o puro.
 */
const hasExplicitOverlay = Boolean(
  overlayEstilo && String(overlayEstilo).trim().toLowerCase() !== 'puro',
);
const atmosphereOverlay =
  fondoTipoNorm === 'color' ? hasExplicitOverlay : true;
const atmosphereOverlayEstilo =
  fondoTipoNorm === 'color'
    ? hasExplicitOverlay
      ? overlayEstilo
      : 'puro'
    : overlayEstilo || 'puro';

const paintPanelFondo = sectionId === 'ubicacion';

function colorLuminance(input: string) {
  const raw = String(input || '').trim();
  let r = 255;
  let g = 255;
  let b = 255;
  const hex = raw.match(/^#([\da-f]{3}|[\da-f]{6})$/i);
  if (hex) {
    let h = hex[1];
    if (h.length === 3) h = h.split('').map((c) => c + c).join('');
    r = parseInt(h.slice(0, 2), 16);
    g = parseInt(h.slice(2, 4), 16);
    b = parseInt(h.slice(4, 6), 16);
  } else {
    const rgb = raw.match(/rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)/i);
    if (!rgb) return 1;
    r = Number(rgb[1]);
    g = Number(rgb[2]);
    b = Number(rgb[3]);
  }
  const lin = [r, g, b].map((channel) => {
    const s = channel / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2];
}

const menuSheetColor = fondoTipoNorm === 'color' ? fondoValorTrim || containerBg : '';
const menuLife =
  sectionId === 'menu' &&
  fondoTipoNorm === 'color' &&
  Boolean(menuSheetColor) &&
  colorLuminance(menuSheetColor) < 0.34;

/**
 * Contenedor:
 * - Sin atmósfera → pinta el sheet completo.
 * - Con atmósfera → solo CSS var para tarjetas/contenido (no tapa el fondo).
 * - Ubicación: el swatch FONDO pinta el sheet aunque haya atmósfera de color.
 */
const sheetStyle = [
  containerBg ? `--sec-fondo:${containerBg}` : '',
  titleColor ? `--sec-titulo:${titleColor}` : '',
  bodyColor ? `--sec-cuerpo:${bodyColor}` : '',
  !hasAtmosphere && containerBg ? `background-color:${containerBg}` : '',
  !hasAtmosphere && !containerBg && fondoTipoNorm === 'color' && fondoValorTrim
    ? `background-color:${fondoValorTrim}`
    : '',
  paintPanelFondo && hasAtmosphere && fondoTipoNorm === 'color' && (containerBg || fondoValorTrim)
    ? `background-color:${containerBg || fondoValorTrim}`
    : '',
  hasAtmosphere && fondoTipoNorm !== 'color'
    ? 'background-color:transparent'
    : '',
]
  .filter(Boolean)
  .join('; ');

const headerStyle = [
  (containerBg && (!hasAtmosphere || paintPanelFondo))
    ? `background-color:color-mix(in srgb, ${containerBg} 92%, transparent)`
    : hasAtmosphere && fondoTipoNorm === 'color' && fondoValorTrim
      ? `background-color:color-mix(in srgb, ${fondoValorTrim} 88%, transparent)`
      : hasAtmosphere
        ? 'background-color:color-mix(in srgb, var(--color-fondo) 72%, transparent)'
        : '',
  titleColor ? `color:${titleColor}` : '',
]
  .filter(Boolean)
  .join('; ');

const bodyStyle = [bodyColor ? `color:${bodyColor}` : ''].filter(Boolean).join('; ');
---

<section
  id={`section-${sectionId}`}
  data-section={sectionId}
  data-open="false"
  class:list={[
    'panel-sheet pointer-events-none fixed inset-0 z-50 mx-auto flex w-full translate-y-full flex-col opacity-0 transition-[transform,opacity] duration-300 ease-out',
    !hasAtmosphere && !containerBg && estilos.panelColor,
    !titleColor && !bodyColor ? estilos.textColor : '',
  ]}
  style={sheetStyle || undefined}
  aria-hidden="true"
>
  {hasAtmosphere && (
    <SectionAtmosphere
      tipo={fondoTipoNorm}
      valor={fondoValorTrim}
      overlay={atmosphereOverlay}
      overlayEstilo={atmosphereOverlayEstilo}
      overlayOpacity={overlayOpacity}
      fondoAnimacion={fondoAnimacion}
      categoryCrossfade={categoryCrossfade}
      categoryBackgrounds={categoryBackgrounds}
    />
  )}
  {menuLife && (
    <div class="menu-atmosphere-life" aria-hidden="true">
      <span class="menu-atmosphere-life__glow"></span>
      <span class="menu-atmosphere-life__vignette"></span>
      <span class="menu-atmosphere-life__grain"></span>
    </div>
  )}

  <header
    class:list={[
      'sticky top-0 z-20 flex items-center justify-between border-b border-white/10 px-5 py-4 pt-[max(1rem,env(safe-area-inset-top))]',
      !hasAtmosphere && !containerBg && estilos.panelColor,
      estilos.borderColor,
    ]}
    style={headerStyle || undefined}
  >
    <h2
      class={`relative z-10 text-[0.72rem] font-semibold tracking-[0.28em] uppercase ${estilos.displayClass}`}
      style={titleColor ? `color:${titleColor}` : undefined}
    >
      {title}
    </h2>
    <button
      type="button"
      data-close-section
      class={`relative z-10 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 shadow-inner backdrop-blur-md transition-all duration-200 active:scale-95 ${estilos.mutedColor}`}
      aria-label="Cerrar"
      style={titleColor ? `color:${titleColor}` : undefined}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        class="h-4 w-4"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </header>

  <div
    class:list={[
      'panel-scroll-root relative z-10 flex-1 overflow-y-auto overscroll-y-contain [-webkit-overflow-scrolling:touch]',
      !hasAtmosphere && !containerBg && estilos.panelColor,
    ]}
    style={[
      bodyStyle,
      paintPanelFondo &&
      hasAtmosphere &&
      fondoTipoNorm === 'color' &&
      (containerBg || fondoValorTrim)
        ? `background-color:${containerBg || fondoValorTrim}`
        : '',
    ]
      .filter(Boolean)
      .join('; ') || undefined}
  >
    <slot />
  </div>
</section>

<style>
  .panel-scroll-root {
    overflow-anchor: none;
    -webkit-overflow-scrolling: touch;
  }

  /* Negro con luz de sala: un resplandor lento, viñeta y grano. */
  .menu-atmosphere-life {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .menu-atmosphere-life__glow {
    position: absolute;
    inset: -8%;
    background:
      radial-gradient(ellipse 95% 58% at 12% 6%, rgb(214 176 112 / 0.42), transparent 62%),
      radial-gradient(ellipse 72% 48% at 100% 28%, rgb(150 58 30 / 0.34), transparent 58%),
      radial-gradient(ellipse 85% 55% at 46% 108%, rgb(96 64 32 / 0.28), transparent 64%);
    animation: menu-atmosphere-glow 28s ease-in-out infinite alternate;
  }

  .menu-atmosphere-life__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%, transparent 28%, rgb(0 0 0 / 0.5) 100%);
  }

  .menu-atmosphere-life__grain {
    position: absolute;
    inset: -20%;
    opacity: 0.22;
    mix-blend-mode: screen;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 160px 160px;
    animation: menu-atmosphere-grain 1.1s steps(2) infinite;
  }

  @keyframes menu-atmosphere-glow {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(7%, 9%, 0) scale(1.06);
    }
  }

  @keyframes menu-atmosphere-grain {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(-1.5%, 1%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-atmosphere-life__glow,
    .menu-atmosphere-life__grain {
      animation: none;
    }
  }

  /* El menú usa su propia barra sticky (título, divisas, cerrar). */
  .panel-sheet[data-section='menu'] > header {
    display: none;
  }

  /* Wi‑Fi: una sola pantalla en móvil — sin scroll cortado */
  @media (max-width: 767px) {
    .panel-sheet[data-section='wifi'] {
      height: 100svh;
      max-height: 100svh;
    }

    .panel-sheet[data-section='wifi'] > header {
      padding-top: max(0.65rem, env(safe-area-inset-top));
      padding-bottom: 0.65rem;
    }

    .panel-sheet[data-section='wifi'] .panel-scroll-root {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow: hidden;
      overscroll-behavior: none;
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    }

    .panel-sheet[data-section='wifi'] .wifi-overlay-wrap {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
