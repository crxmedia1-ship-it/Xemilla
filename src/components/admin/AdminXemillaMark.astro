---
/**
 * Isotipo Xemilla discreto para pie de paneles admin.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

---

<footer
  class:list={['admin-xemilla-mark', className]}
  aria-label="Xemilla"
>
  <img
    src="/propuesta/xemilla.png"
    alt="Xemilla"
    width="766"
    height="249"
    loading="lazy"
    decoding="async"
    class="admin-xemilla-mark__img admin-xemilla-mark__img--cream"
  />
  <img
    src="/propuesta/xemilla-on-light.png"
    alt=""
    width="766"
    height="249"
    loading="lazy"
    decoding="async"
    class="admin-xemilla-mark__img admin-xemilla-mark__img--ink"
  />
</footer>
