---
/**
 * Toggle Sol / Luna del panel admin.
 * Persistencia: localStorage `xemilla-admin-theme` → dark | light
 * dark  = Observatorio Cósmico
 * light = La Habitación del Tiempo
 */
import { ADMIN_THEME_KEY } from '../../config/admin-themes.js';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={['admin-mode-toggle', className]}
  data-admin-mode-toggle
  aria-label="Cambiar modo claro u oscuro"
  title="Tema del panel"
>
  <span class="admin-mode-toggle__icon admin-mode-toggle__icon--sun" aria-hidden="true">☀️</span>
  <span class="admin-mode-toggle__icon admin-mode-toggle__icon--moon" aria-hidden="true">🌙</span>
</button>

<script define:vars={{ ADMIN_THEME_KEY }}>
  /**
   * @param {string} theme
   */
  function applyAdminTheme(theme) {
    const id =
      theme === 'light' ||
      theme === 'claro' ||
      theme === 'alabastro' ||
      theme === 'organico' ||
      theme === 'organic' ||
      theme === 'cristalino' ||
      theme === 'habitacion' ||
      theme === 'habitacion-del-tiempo'
        ? 'light'
        : 'dark';
    const root = document.documentElement;
    root.classList.add('admin-panel', 'transition-colors', 'duration-500');
    root.classList.toggle('dark', id === 'dark');
    root.classList.toggle('light', id === 'light');
    root.setAttribute('data-theme', id);
    try {
      localStorage.setItem(ADMIN_THEME_KEY, id);
    } catch {
      /* ignore */
    }
    const meta = document.getElementById('meta-theme-color');
    if (meta) {
      meta.setAttribute('content', id === 'light' ? '#f8fafc' : '#030712');
    }
    document.querySelectorAll('[data-admin-mode-toggle]').forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      btn.setAttribute('aria-pressed', id === 'dark' ? 'true' : 'false');
      btn.setAttribute(
        'aria-label',
        id === 'dark'
          ? 'Cambiar a La Habitación del Tiempo'
          : 'Cambiar a Observatorio Cósmico',
      );
      btn.title =
        id === 'dark'
          ? 'Observatorio Cósmico · tocar para Habitación del Tiempo'
          : 'Habitación del Tiempo · tocar para Observatorio Cósmico';
    });
  }

  function readStoredTheme() {
    try {
      return localStorage.getItem(ADMIN_THEME_KEY) || 'dark';
    } catch {
      return 'dark';
    }
  }

  function initAdminModeToggle() {
    applyAdminTheme(readStoredTheme());
    document.querySelectorAll('[data-admin-mode-toggle]').forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      if (btn.dataset.ready === 'true') return;
      btn.dataset.ready = 'true';
      btn.addEventListener('click', () => {
        const current = readStoredTheme();
        const next =
          current === 'light' ||
          current === 'alabastro' ||
          current === 'organico' ||
          current === 'claro' ||
          current === 'cristalino'
            ? 'dark'
            : 'light';
        applyAdminTheme(next);
      });
    });
  }

  initAdminModeToggle();
  document.addEventListener('DOMContentLoaded', initAdminModeToggle);
  document.addEventListener('astro:page-load', initAdminModeToggle);
</script>
