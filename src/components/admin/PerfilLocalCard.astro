---
import { DIAS_SEMANA } from '../../lib/horarios-semana.js';

/**
 * Horario + mapa + redes (mismo bloque en Perfil y en Identidad → Horarios).
 * @typedef {{ url: string, on: boolean }} RedState
 */
interface Props {
  scope: string;
  mapsInputId: string;
  horarioHiddenId: string;
  horarioSemana: Record<string, { closed?: boolean; open?: string; close?: string }>;
  horarioHoy: { id: string; open: boolean; text: string };
  mapsUrl: string;
  mapsEmbed: string;
  mapsOpen: string;
  horarioText: string;
  direccion?: string;
  direccionInputId?: string;
  instagram: RedState;
  facebook: RedState;
  tiktok: RedState;
  tripadvisor: RedState;
  whatsapp: RedState;
  telefono?: RedState;
  socialIdPrefix: string;
  nestInParent?: boolean;
  showMap?: boolean;
  showHours?: boolean;
  showSocial?: boolean;
  socialWide?: boolean;
  variant?: 'default' | 'studio';
}

const {
  scope,
  mapsInputId,
  horarioHiddenId,
  horarioSemana,
  horarioHoy,
  mapsUrl,
  mapsEmbed,
  mapsOpen,
  horarioText,
  direccion = '',
  direccionInputId = '',
  instagram,
  facebook,
  tiktok,
  tripadvisor,
  whatsapp,
  telefono = { url: '', on: false },
  socialIdPrefix,
  nestInParent = false,
  showMap = true,
  showHours = true,
  showSocial = true,
  socialWide = false,
  variant = 'default',
} = Astro.props;

const redes = [
  {
    id: 'whatsapp',
    label: 'WhatsApp',
    placeholder: '+58… o https://wa.me/…',
    state: whatsapp,
    icon: 'wa',
    inputType: 'text',
  },
  {
    id: 'telefono',
    label: 'Teléfono',
    placeholder: '+58…',
    state: telefono,
    icon: 'ph',
    inputType: 'tel',
  },
  {
    id: 'instagram',
    label: 'Instagram',
    placeholder: 'https://instagram.com/',
    state: instagram,
    icon: 'ig',
    inputType: 'url',
  },
  {
    id: 'facebook',
    label: 'Facebook',
    placeholder: 'https://facebook.com/',
    state: facebook,
    icon: 'fb',
    inputType: 'url',
  },
  {
    id: 'tiktok',
    label: 'TikTok',
    placeholder: 'https://tiktok.com/@',
    state: tiktok,
    icon: 'tt',
    inputType: 'url',
  },
  {
    id: 'tripadvisor',
    label: 'Tripadvisor',
    placeholder: 'https://tripadvisor.com/',
    state: tripadvisor,
    icon: 'ta',
    inputType: 'url',
  },
];

const studioCardBase =
  'identidad-studio-card w-full min-w-0 bg-white dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800/80 rounded-3xl p-6 shadow-[0_4px_25px_rgba(0,0,0,0.03)] dark:shadow-none backdrop-blur-xl transition-all flex flex-col gap-5';
const studioHoursCardClass = `${studioCardBase} h-full w-full justify-between`;
const studioMapCardClass = `${studioCardBase} h-full w-full justify-between`;
const studioSocialCardClass = studioCardBase;

const studioInputClass =
  'w-full px-3.5 py-2 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-800 rounded-xl text-zinc-900 dark:text-white placeholder:text-zinc-400 dark:placeholder:text-zinc-600 focus:border-zinc-400 dark:focus:border-zinc-600 outline-none transition-all';

const studioHeadTitleClass = 'm-0 text-sm font-semibold tracking-tight text-zinc-900 dark:text-white';
const studioIconWrapClass =
  'mr-3 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-400';

const studioDayRowClass =
  'grid grid-cols-[85px_1fr_auto] items-center gap-3 py-2.5 border-b border-zinc-100 dark:border-zinc-800/60 last:border-0 w-full min-w-0';

const studioTimesClass = 'flex items-center justify-between gap-2 w-full min-w-0';

const studioTimeInputClass =
  'flex-1 w-full min-w-0 px-2.5 py-1.5 text-center text-xs sm:text-sm font-mono rounded-xl outline-none transition-all bg-zinc-50 border border-zinc-200 text-zinc-900 focus:bg-white focus:border-zinc-400 dark:bg-zinc-950 dark:border-zinc-800 dark:text-white focus:dark:border-zinc-600 appearance-none sm:max-w-[125px]';

const studioMapInputClass = studioInputClass;

const studioSocialRowClass =
  'flex w-full min-w-0 flex-wrap items-center gap-3 border-b border-zinc-100 py-2.5 last:border-0 sm:flex-nowrap dark:border-zinc-800/60';

const studioSocialGridClass =
  'grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 w-full';

const studioSocialWideCellClass =
  'flex w-full min-w-0 flex-col rounded-2xl border border-zinc-200/70 bg-zinc-50/70 p-3 transition-colors hover:bg-zinc-50 dark:border-zinc-800/80 dark:bg-zinc-900/40 hover:dark:bg-zinc-900/50';

const studioSocialStackedInputClass = studioInputClass;

const studioSocialInputClass =
  `flex-1 w-full min-w-0 order-last sm:order-none ${studioInputClass}`;

const studioStatusOpenClass =
  'perfil-status is-open shrink-0 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 inline-flex items-center gap-1.5';
const studioStatusClosedClass =
  'perfil-status is-closed shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-500 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700';
---

<div
  class:list={[
    nestInParent && variant === 'studio'
      ? 'contents perfil-local-ops perfil-local-ops--studio'
      : ['perfil-local-ops', variant === 'studio' && 'perfil-local-ops--studio space-y-6'],
  ]}
  {...(nestInParent ? {} : { 'data-local-ops': scope })}
  data-variant={variant}
>
  {
    showHours ? (
      <div class:list={['perfil-group', variant === 'studio' ? studioHoursCardClass : null]}>
        <div class:list={['perfil-group__head', variant === 'studio' && 'min-w-0']}>
          <div class="flex min-w-0 items-center justify-between gap-3">
            <div class="flex min-w-0 items-center">
            {variant === 'studio' ? (
              <div class={studioIconWrapClass} aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              </div>
            ) : null}
            <div class="min-w-0">
              <h3 class:list={[variant === 'studio' && studioHeadTitleClass]}>Horario de Atención</h3>
            </div>
            </div>
            <span
              id={variant === 'studio' && scope === 'perfil' ? 'ops-open-badge' : undefined}
              class:list={[
                variant === 'studio'
                  ? horarioHoy.open
                    ? studioStatusOpenClass
                    : studioStatusClosedClass
                  : ['perfil-status shrink-0', horarioHoy.open ? 'is-open' : 'is-closed'],
              ]}
            >
              {horarioHoy.text}
            </span>
          </div>
        </div>
        <ul
          class:list={[
            'perfil-list perfil-list--hours min-w-0',
            variant === 'studio' && 'flex flex-col justify-between flex-1 gap-1 mt-2',
          ]}
          data-hours-week={scope}
        >
          {
            DIAS_SEMANA.map((dia) => {
              const row = horarioSemana[dia.id];
              const closed = Boolean(row?.closed);
              const isToday = dia.id === horarioHoy.id;
              return (
                <li
                  class:list={[
                    'perfil-day',
                    isToday && 'is-today',
                    variant === 'studio' && studioDayRowClass,
                  ]}
                  data-day={dia.id}
                  data-closed={closed ? 'true' : 'false'}
                >
                  <div class="perfil-day__head contents">
                    <span
                      class:list={[
                        'perfil-day__name',
                        variant === 'studio' && 'text-xs sm:text-sm font-medium text-zinc-800 dark:text-zinc-200',
                      ]}
                    >
                      {dia.label}
                      {isToday ? <em>Hoy</em> : null}
                    </span>
                    {
                      variant !== 'studio' ? (
                        <div class="sm:hidden shrink-0">
                          <button
                            type="button"
                            role="switch"
                            aria-checked={!closed}
                            aria-label={closed ? `${dia.label} cerrado` : `${dia.label} abierto`}
                            data-hours-toggle
                            title={closed ? 'Cerrado' : 'Abierto'}
                            class:list={[
                              'ios-toggle',
                              'ios-toggle--live',
                              'perfil-toggle',
                              'shrink-0',
                              'bg-zinc-200 dark:bg-zinc-800',
                              !closed && 'is-on bg-emerald-500 dark:bg-emerald-500',
                            ]}
                          >
                            <span class="ios-toggle__knob bg-white shadow-sm" aria-hidden="true"></span>
                          </button>
                        </div>
                      ) : null
                    }
                  </div>
                  <div
                    class:list={[
                      'perfil-day__mid',
                      variant === 'studio' && studioTimesClass,
                    ]}
                  >
                    <span class="perfil-day__closed-label">Cerrado</span>
                    <span class:list={['perfil-day__times', variant === 'studio' && studioTimesClass]}>
                      <input
                        type="time"
                        data-hours-open
                        value={row?.open || '12:00'}
                        disabled={closed}
                        aria-label={`Apertura ${dia.label}`}
                        class:list={[variant === 'studio' && ['perfil-day__time-pill', studioTimeInputClass]]}
                      />
                      <span class:list={['perfil-day__to', variant === 'studio' && 'text-zinc-400 font-mono text-xs shrink-0']}>–</span>
                      <input
                        type="time"
                        data-hours-close
                        value={row?.close || '22:00'}
                        disabled={closed}
                        aria-label={`Cierre ${dia.label}`}
                        class:list={[variant === 'studio' && ['perfil-day__time-pill', studioTimeInputClass]]}
                      />
                    </span>
                  </div>
                  <div class:list={[variant === 'studio' ? 'shrink-0 justify-self-end' : 'hidden shrink-0 justify-self-end sm:block']}>
                    <button
                      type="button"
                      role="switch"
                      aria-checked={!closed}
                      aria-label={closed ? `${dia.label} cerrado` : `${dia.label} abierto`}
                      data-hours-toggle
                      title={closed ? 'Cerrado' : 'Abierto'}
                      class:list={[
                        'ios-toggle',
                        'ios-toggle--live',
                        'perfil-toggle',
                        'shrink-0',
                        'bg-zinc-200 dark:bg-zinc-800',
                              !closed && 'is-on bg-emerald-500 dark:bg-emerald-500',
                      ]}
                    >
                      <span class="ios-toggle__knob bg-white shadow-sm" aria-hidden="true"></span>
                    </button>
                  </div>
                </li>
              );
            })
          }
        </ul>
        <input type="hidden" id={horarioHiddenId} value={horarioText} data-horario-hidden />
      </div>
    ) : null
  }

  {
    showMap ? (
      <div class:list={['perfil-group', variant === 'studio' ? studioMapCardClass : null]}>
        <div class="perfil-group__head">
          <div class="flex min-w-0 items-center">
            {variant === 'studio' ? (
              <div class={studioIconWrapClass} aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"></path>
                  <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
              </div>
            ) : null}
            <div class="min-w-0">
              <h3 class:list={[variant === 'studio' && studioHeadTitleClass]}>Ubicación &amp; Mapa</h3>
            </div>
          </div>
        </div>
        <div class:list={['perfil-map w-full', variant === 'studio' && 'flex flex-col gap-4']} data-maps-preview>
          <div
            class:list={[
              'perfil-map__frame relative w-full overflow-hidden',
              variant === 'studio'
                ? 'h-52 w-full rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-inner'
                : 'rounded-xl border border-zinc-200',
            ]}
          >
            {
              mapsEmbed ? (
                <iframe
                  title="Mapa del restaurante"
                  src={mapsEmbed}
                  class={variant === 'studio' ? 'h-full w-full border-0' : undefined}
                  allowfullscreen
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  data-map-embed
                />
              ) : (
                <span class="perfil-map__empty" data-map-empty>
                  Pegá el enlace de Google Maps
                </span>
              )
            }
            <a
              class="perfil-map__hit"
              href={mapsOpen || '#'}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Abrir en Google Maps"
              data-map-open
              hidden={!mapsOpen}
            />
          </div>
          {
            variant === 'studio' ? (
              <div class="perfil-map__studio-fields mt-1 flex w-full flex-col gap-3">
                <label class="perfil-field perfil-field--map flex w-full min-w-0 flex-col gap-1.5">
                  <span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-zinc-500">Dirección en texto</span>
                  <input
                    type="text"
                    id={direccionInputId || undefined}
                    value={direccion}
                    placeholder="Ej. Av. Principal, Valencia"
                    autocomplete="street-address"
                    data-direccion-input
                    class={studioMapInputClass}
                  />
                </label>
                <label class="perfil-field perfil-field--map flex w-full min-w-0 flex-col gap-1.5">
                  <span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-zinc-500">Iframe de Google Maps</span>
                  <textarea
                    id={mapsInputId}
                    rows={2}
                    placeholder="https://maps.google.com/… o iframe embed"
                    autocomplete="off"
                    data-maps-url
                    class:list={['perfil-map__textarea', studioMapInputClass]}
                  >{mapsUrl}</textarea>
                </label>
              </div>
            ) : (
              <div class="perfil-map__actions">
                <button type="button" class="perfil-map__change-btn" data-maps-url-toggle>
                  Cambiar enlace de Google Maps
                </button>
                <div class="perfil-map__url-panel" data-maps-url-panel hidden>
                  <label class="perfil-field perfil-field--map">
                    <span class="sr-only">Enlace o iframe de Google Maps</span>
                    <textarea
                      id={mapsInputId}
                      rows={3}
                      placeholder="https://maps.google.com/… o iframe embed"
                      autocomplete="off"
                      data-maps-url
                      class="perfil-map__textarea"
                    >{mapsUrl}</textarea>
                  </label>
                  <div class="perfil-map__url-actions">
                    <button type="button" class="perfil-map__url-done" data-maps-url-done>
                      Listo
                    </button>
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>
    ) : null
  }

  {
    showSocial ? (
      <div class:list={['perfil-group', variant === 'studio' ? studioSocialCardClass : null]}>
        <div class="perfil-group__head">
          <div class="flex min-w-0 items-center">
            {variant === 'studio' ? (
              <div class={studioIconWrapClass} aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
                </svg>
              </div>
            ) : null}
            <div class="min-w-0">
              <h3 class:list={[variant === 'studio' && studioHeadTitleClass]}>Canales de contacto</h3>
            </div>
          </div>
        </div>
        <ul
          class:list={[
            'perfil-list min-w-0',
            variant === 'studio' && socialWide && ['perfil-list--social-grid', studioSocialGridClass],
          ]}
        >
          {
            redes.map((net) => (
              <li
                class:list={[
                  'perfil-social',
                  variant === 'studio' && (socialWide ? studioSocialWideCellClass : studioSocialRowClass),
                ]}
                data-social={net.id}
                data-on={net.state.on ? 'true' : 'false'}
              >
                {
                  variant === 'studio' ? (
                    <>
                      <div class="flex w-full items-center justify-between gap-2 mb-1.5">
                        <span class="perfil-social__brand min-w-0 text-xs sm:text-sm font-medium text-zinc-800 dark:text-zinc-200">
                          <span class={`perfil-social__glyph perfil-social__glyph--${net.icon} text-zinc-500 dark:text-zinc-400`} aria-hidden="true"></span>
                          {net.label}
                        </span>
                        <button
                          type="button"
                          role="switch"
                          aria-checked={net.state.on}
                          aria-label={`${net.label} ${net.state.on ? 'visible' : 'oculta'}`}
                          data-social-toggle
                          title={net.state.on ? 'Visible en la WebApp' : 'Oculta en la WebApp'}
                          class:list={[
                            'ios-toggle',
                            'ios-toggle--live',
                            'perfil-toggle',
                            'shrink-0',
                            'bg-zinc-200 dark:bg-zinc-800',
                            net.state.on && 'is-on bg-emerald-500 dark:bg-emerald-500',
                          ]}
                        >
                          <span class="ios-toggle__knob bg-white shadow-sm" aria-hidden="true"></span>
                        </button>
                      </div>
                      <input
                        type={net.inputType || 'url'}
                        id={`${socialIdPrefix}${net.id}`}
                        value={net.state.url}
                        placeholder={net.placeholder}
                        autocomplete="off"
                        disabled={!net.state.on}
                        hidden={!net.state.on}
                        data-social-input
                        class={socialWide ? studioSocialStackedInputClass : studioSocialInputClass}
                      />
                    </>
                  ) : (
                    <>
                      <div class="perfil-social__bar">
                        <span class="perfil-social__brand">
                          <span class={`perfil-social__glyph perfil-social__glyph--${net.icon}`} aria-hidden="true"></span>
                          {net.label}
                        </span>
                        <button
                          type="button"
                          role="switch"
                          aria-checked={net.state.on}
                          aria-label={`${net.label} ${net.state.on ? 'visible' : 'oculta'}`}
                          data-social-toggle
                          title={net.state.on ? 'Visible en la WebApp' : 'Oculta en la WebApp'}
                          class:list={[
                            'ios-toggle',
                            'ios-toggle--live',
                            'perfil-toggle',
                            'bg-zinc-200 dark:bg-zinc-800',
                            net.state.on && 'is-on bg-emerald-500 dark:bg-emerald-500',
                          ]}
                        >
                          <span class="ios-toggle__knob bg-white shadow-sm" aria-hidden="true"></span>
                        </button>
                      </div>
                      <input
                        type={net.inputType || 'url'}
                        id={`${socialIdPrefix}${net.id}`}
                        value={net.state.url}
                        placeholder={net.placeholder}
                        autocomplete="off"
                        disabled={!net.state.on}
                        hidden={!net.state.on}
                        data-social-input
                      />
                    </>
                  )
                }
              </li>
            ))
          }
        </ul>
      </div>
    ) : null
  }
</div>

<script>
  function setSocialRow(row, on) {
    if (!(row instanceof HTMLElement)) return;
    row.dataset.on = on ? 'true' : 'false';
    const toggle = row.querySelector('[data-social-toggle]');
    if (toggle instanceof HTMLElement) {
      toggle.setAttribute('aria-checked', String(on));
      toggle.classList.toggle('is-on', on);
      toggle.classList.toggle('bg-emerald-500', on);
      toggle.classList.toggle('dark:bg-emerald-500', on);
      toggle.style.backgroundColor = on ? '#10b981' : '';
      toggle.title = on ? 'Visible en la WebApp' : 'Oculta en la WebApp';
    }
    const input = row.querySelector('[data-social-input], input:not([type="hidden"])');
    if (input instanceof HTMLInputElement) {
      input.disabled = !on;
      input.hidden = !on;
    }
  }

  function setDayRow(row, closed) {
    if (!(row instanceof HTMLElement)) return;
    row.dataset.closed = closed ? 'true' : 'false';
    row.querySelectorAll('[data-hours-toggle]').forEach((toggle) => {
      if (!(toggle instanceof HTMLElement)) return;
      toggle.setAttribute('aria-checked', String(!closed));
      toggle.classList.toggle('is-on', !closed);
      toggle.classList.toggle('bg-emerald-500', !closed);
      toggle.classList.toggle('dark:bg-emerald-500', !closed);
      toggle.style.backgroundColor = !closed ? '#10b981' : '';
      toggle.title = closed ? 'Cerrado' : 'Abierto';
    });
    row.querySelectorAll('[data-hours-open], [data-hours-close]').forEach((el) => {
      if (el instanceof HTMLInputElement) el.disabled = closed;
    });
  }

  function bindOpsToggles(root) {
    if (!(root instanceof HTMLElement)) return;
    root.querySelectorAll('[data-social-toggle]').forEach((btn) => {
      if (!(btn instanceof HTMLElement) || btn.dataset.toggleBound === '1') return;
      btn.dataset.toggleBound = '1';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const row = btn.closest('[data-social]');
        if (!(row instanceof HTMLElement)) return;
        const next = row.dataset.on !== 'true';
        setSocialRow(row, next);
        root.dispatchEvent(new CustomEvent('ops-social-change', { bubbles: true }));
      });
    });

    root.querySelectorAll('[data-hours-toggle]').forEach((btn) => {
      if (!(btn instanceof HTMLElement) || btn.dataset.toggleBound === '1') return;
      btn.dataset.toggleBound = '1';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const row = btn.closest('[data-day]');
        if (!(row instanceof HTMLElement)) return;
        setDayRow(row, row.dataset.closed !== 'true');
        root.dispatchEvent(new CustomEvent('ops-hours-change', { bubbles: true }));
      });
    });

    root.querySelectorAll('[data-hours-open], [data-hours-close]').forEach((input) => {
      if (!(input instanceof HTMLInputElement) || input.dataset.hoursSaveBound === '1') return;
      input.dataset.hoursSaveBound = '1';
      const emit = () => {
        root.dispatchEvent(new CustomEvent('ops-hours-change', { bubbles: true }));
      };
      input.addEventListener('input', emit);
      input.addEventListener('change', emit);
    });

    root.querySelectorAll('[data-social-input]').forEach((input) => {
      if (!(input instanceof HTMLInputElement) || input.dataset.socialSaveBound === '1') return;
      input.dataset.socialSaveBound = '1';
      const emit = () => {
        root.dispatchEvent(new CustomEvent('ops-social-change', { bubbles: true }));
      };
      input.addEventListener('input', emit);
      input.addEventListener('change', emit);
    });
  }

  function bootOpsToggles() {
    document.querySelectorAll('.perfil-local-ops, #ops-contacto-card').forEach(bindOpsToggles);
    // When display:contents, query cards directly
    document.querySelectorAll('#ops-contacto-card [data-social-toggle], #ops-contacto-card [data-hours-toggle]').forEach((btn) => {
      const host = btn.closest('.perfil-group') || btn.closest('#ops-contacto-card');
      if (host) bindOpsToggles(host);
    });
  }

  bootOpsToggles();
  document.addEventListener('astro:page-load', bootOpsToggles);
</script>

<style>
  .perfil-local-ops {
    width: 100%;
  }

  .perfil-group {
    margin-bottom: 0.75rem;
    overflow: hidden;
