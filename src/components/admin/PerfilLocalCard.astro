---
import { DIAS_SEMANA } from '../../lib/horarios-semana.js';

/**
 * Horario + mapa + redes (mismo bloque en Perfil y en Identidad → Horarios).
 * @typedef {{ url: string, on: boolean }} RedState
 */
interface Props {
  scope: string;
  mapsInputId: string;
  horarioHiddenId: string;
  horarioSemana: Record<string, { closed?: boolean; open?: string; close?: string }>;
  horarioHoy: { id: string; open: boolean; text: string };
  mapsUrl: string;
  mapsEmbed: string;
  mapsOpen: string;
  horarioText: string;
  instagram: RedState;
  facebook: RedState;
  tiktok: RedState;
  tripadvisor: RedState;
  whatsapp: RedState;
  socialIdPrefix: string;
}

const {
  scope,
  mapsInputId,
  horarioHiddenId,
  horarioSemana,
  horarioHoy,
  mapsUrl,
  mapsEmbed,
  mapsOpen,
  horarioText,
  instagram,
  facebook,
  tiktok,
  tripadvisor,
  whatsapp,
  socialIdPrefix,
} = Astro.props;

const redes = [
  {
    id: 'whatsapp',
    label: 'WhatsApp',
    placeholder: '+58… o https://wa.me/…',
    state: whatsapp,
    icon: 'wa',
    inputType: 'text',
  },
  {
    id: 'instagram',
    label: 'Instagram',
    placeholder: 'https://instagram.com/',
    state: instagram,
    icon: 'ig',
    inputType: 'url',
  },
  {
    id: 'facebook',
    label: 'Facebook',
    placeholder: 'https://facebook.com/',
    state: facebook,
    icon: 'fb',
    inputType: 'url',
  },
  {
    id: 'tiktok',
    label: 'TikTok',
    placeholder: 'https://tiktok.com/@',
    state: tiktok,
    icon: 'tt',
    inputType: 'url',
  },
  {
    id: 'tripadvisor',
    label: 'Tripadvisor',
    placeholder: 'https://tripadvisor.com/',
    state: tripadvisor,
    icon: 'ta',
    inputType: 'url',
  },
];
---

<div class="perfil-local-ops" data-local-ops={scope}>
  <div class="perfil-group">
    <div class="perfil-group__head">
      <div>
        <h3>Horario de atención</h3>
        <p class="perfil-group__sub">El switch abre o cierra el día. Los atajos copian el primer horario abierto.</p>
      </div>
      <div class="perfil-seg" role="group" aria-label="Atajos de horario">
        <button type="button" class="perfil-seg__btn" data-hours-preset="lv">Lun–Vie</button>
        <button type="button" class="perfil-seg__btn" data-hours-preset="finde">Fin de semana</button>
        <button type="button" class="perfil-seg__btn" data-hours-preset="todos">Todos</button>
        <button type="button" class="perfil-seg__btn perfil-seg__btn--mute" data-hours-preset="cerrados">Cerrar</button>
      </div>
    </div>
    <ul class="perfil-list perfil-list--hours" data-hours-week={scope}>
      {
        DIAS_SEMANA.map((dia) => {
          const row = horarioSemana[dia.id];
          const closed = Boolean(row?.closed);
          const isToday = dia.id === horarioHoy.id;
          return (
            <li
              class:list={['perfil-day', isToday && 'is-today']}
              data-day={dia.id}
              data-closed={closed ? 'true' : 'false'}
            >
              <span class="perfil-day__name">
                {dia.label}
                {isToday ? <em>Hoy</em> : null}
              </span>
              <div class="perfil-day__mid">
                <span class="perfil-day__closed-label">Cerrado</span>
                <span class="perfil-day__times">
                  <input
                    type="time"
                    data-hours-open
                    value={row?.open || '12:00'}
                    disabled={closed}
                    aria-label={`Apertura ${dia.label}`}
                  />
                  <span class="perfil-day__to">–</span>
                  <input
                    type="time"
                    data-hours-close
                    value={row?.close || '22:00'}
                    disabled={closed}
                    aria-label={`Cierre ${dia.label}`}
                  />
                </span>
              </div>
              <button
                type="button"
                role="switch"
                aria-checked={!closed}
                aria-label={closed ? `${dia.label} cerrado` : `${dia.label} abierto`}
                data-hours-toggle
                title={closed ? 'Cerrado' : 'Abierto'}
                class:list={['ios-toggle', 'ios-toggle--live', 'perfil-toggle', !closed && 'is-on']}
              >
                <span class="ios-toggle__knob" aria-hidden="true"></span>
              </button>
            </li>
          );
        })
      }
    </ul>
    <p class="perfil-footnote">Se publica en la WebApp de este restaurante.</p>
    <input type="hidden" id={horarioHiddenId} value={horarioText} data-horario-hidden />
  </div>

  <div class="perfil-group">
    <div class="perfil-group__head">
      <div>
        <h3>Mapa</h3>
        <p class="perfil-group__sub">Enlace de Google Maps o código iframe de «Incorporar mapa»</p>
      </div>
    </div>
    <div class="perfil-map" data-maps-preview>
      <div class="perfil-map__frame">
        {
          mapsEmbed ? (
            <iframe
              title="Mapa del restaurante"
              src={mapsEmbed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              data-map-embed
            />
          ) : (
            <span class="perfil-map__empty" data-map-empty>
              Pegá el enlace o el iframe de Google Maps
            </span>
          )
        }
        <a
          class="perfil-map__hit"
          href={mapsOpen || '#'}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Abrir en Google Maps"
          data-map-open
          hidden={!mapsOpen}
        />
      </div>
      <label class="perfil-field perfil-field--map">
        <span>Google Maps — enlace o iframe</span>
        <textarea
          id={mapsInputId}
          rows={3}
          placeholder="https://maps.google.com/…&#10;o&#10;&lt;iframe src=&quot;https://www.google.com/maps/embed?pb=…&quot; …&gt;&lt;/iframe&gt;"
          autocomplete="off"
          data-maps-url
          class="perfil-map__textarea"
        >{mapsUrl}</textarea>
      </label>
    </div>
  </div>

  <div class="perfil-group">
    <div class="perfil-group__head">
      <div>
        <h3>Redes</h3>
        <p class="perfil-group__sub">El switch muestra u oculta cada red en la WebApp</p>
      </div>
    </div>
    <ul class="perfil-list">
      {
        redes.map((net) => (
          <li
            class="perfil-social"
            data-social={net.id}
            data-on={net.state.on ? 'true' : 'false'}
          >
            <div class="perfil-social__bar">
              <span class="perfil-social__brand">
                <span class={`perfil-social__glyph perfil-social__glyph--${net.icon}`} aria-hidden="true"></span>
                {net.label}
              </span>
              <button
                type="button"
                role="switch"
                aria-checked={net.state.on}
                aria-label={`${net.label} ${net.state.on ? 'visible' : 'oculta'}`}
                data-social-toggle
                title={net.state.on ? 'Visible en la WebApp' : 'Oculta en la WebApp'}
                class:list={['ios-toggle', 'ios-toggle--live', 'perfil-toggle', net.state.on && 'is-on']}
              >
                <span class="ios-toggle__knob" aria-hidden="true"></span>
              </button>
            </div>
            <input
              type={net.inputType || 'url'}
              id={`${socialIdPrefix}${net.id}`}
              value={net.state.url}
              placeholder={net.placeholder}
              autocomplete="off"
              disabled={!net.state.on}
            />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .perfil-local-ops {
    width: 100%;
  }

  .perfil-group {
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: 1.1rem;
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
    background: var(--bg-card, rgba(24, 24, 27, 0.55));
  }

  .perfil-group__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    padding: 0.7rem 0.9rem 0.4rem;
  }

  .perfil-group__head h3 {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .perfil-group__sub {
    margin: 0.18rem 0 0;
    font-size: 0.7rem;
    color: var(--text-muted, #71717a);
  }

  .perfil-seg {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 0.18rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary, #fff) 7%, transparent);
    gap: 0.12rem;
  }

  .perfil-seg__btn {
    border: 0;
    border-radius: 999px;
    padding: 0.32rem 0.62rem;
    background: transparent;
    color: var(--text-muted, #a1a1aa);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    cursor: pointer;
    font-family: inherit;
  }

  .perfil-seg__btn:hover {
    color: var(--text-primary, #fff);
  }

  .perfil-seg__btn:active {
    background: var(--text-primary, #fff);
    color: var(--bg-page, #09090b);
  }

  .perfil-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .perfil-day {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.42rem 0.9rem;
    border-top: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .perfil-day__name {
    width: 5.35rem;
    flex-shrink: 0;
    font-size: 0.86rem;
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .perfil-day.is-today .perfil-day__name {
    font-weight: 700;
  }

  .perfil-day__name em {
    margin-left: 0.4rem;
    font-style: normal;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #16a34a;
  }

  .perfil-day__mid {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    flex: 0 1 auto;
  }

  .perfil-day .perfil-toggle {
    margin-left: auto;
    flex-shrink: 0;
  }

  .perfil-day__times {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .perfil-day__to {
    font-size: 0.72rem;
    color: var(--text-muted, #71717a);
  }

  .perfil-day__closed-label {
    display: none;
    font-size: 0.82rem;
    color: var(--text-muted, #71717a);
  }

  .perfil-day[data-closed='true'] .perfil-day__times {
    display: none;
  }

  .perfil-day[data-closed='true'] .perfil-day__closed-label {
    display: inline;
  }

  .perfil-day[data-closed='true'] .perfil-day__name {
    color: var(--text-muted, #71717a);
  }

  .perfil-day input[type='time'],
  .perfil-field input,
  .perfil-social input {
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1));
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--text-primary, #fff) 4%, transparent);
    color: var(--text-primary, #fff);
    font: inherit;
    font-size: 0.82rem;
    padding: 0.42rem 0.55rem;
    color-scheme: inherit;
  }

  .perfil-day input[type='time'] {
    min-width: 5.4rem;
    padding: 0.28rem 0.4rem;
    font-size: 0.75rem;
  }

  .perfil-toggle {
    --toggle-off: #3f3f46;
    --toggle-on: #16a34a;
    position: relative;
    display: inline-block;
    width: 2.75rem;
    height: 1.62rem;
    flex-shrink: 0;
    border: 0;
    padding: 0;
    border-radius: 9999px;
    cursor: pointer;
    background: var(--toggle-off);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    vertical-align: middle;
  }

  .perfil-toggle.is-on {
    background: var(--toggle-on);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 0 0 3px color-mix(in srgb, var(--toggle-on) 18%, transparent);
  }

  .perfil-toggle :global(.ios-toggle__knob) {
    position: absolute;
    top: 0.17rem;
    left: 0.17rem;
    width: 1.28rem;
    height: 1.28rem;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.22);
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    transform: translateX(0);
  }

  .perfil-toggle.is-on :global(.ios-toggle__knob) {
    transform: translateX(1.12rem);
  }

  .perfil-footnote {
    margin: 0;
    padding: 0.4rem 0.9rem 0.7rem;
    font-size: 0.68rem;
    line-height: 1.35;
    color: var(--text-muted, #71717a);
  }

  .perfil-map {
    padding: 0 0 0.35rem;
  }

  .perfil-map__frame {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    margin: 0.15rem 0.9rem 0.35rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--text-primary, #fff) 6%, transparent);
  }

  .perfil-map__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }

  .perfil-map__hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .perfil-map__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    font-size: 0.82rem;
    color: var(--text-muted, #71717a);
    text-align: center;
  }

  .perfil-field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.55rem 1.1rem 0.9rem;
  }

  .perfil-field span {
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--text-muted, #71717a);
  }

  .perfil-field input,
  .perfil-field textarea {
    width: 100%;
    min-width: 0;
    font-size: 0.84rem;
  }

  .perfil-map__textarea {
    min-height: 5.5rem;
    resize: vertical;
    line-height: 1.45;
    padding: 0.58rem 0.75rem;
    border-radius: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .perfil-social {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.58rem 0.9rem;
    border-top: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
  }

  .perfil-social__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .perfil-social__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .perfil-social__glyph {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 0.5rem;
    background-color: color-mix(in srgb, var(--text-primary, #fff) 8%, transparent);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 0.95rem;
  }

  .perfil-social__glyph--wa {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='%23a1a1aa' viewBox='0 0 24 24'><path d='M17.5 14.1c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.1-.3.2-.5.1-.2 0-.4 0-.5 0-.1-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.7.6.4 1.2.3 1.6.2.5-.1 1.8-.7 2.1-1.4.2-.7.2-1.3.2-1.4 0-.1-.2-.2-.5-.3z'/><path d='M12 2C6.5 2 2 6.1 2 11.2c0 1.8.5 3.5 1.4 5L2 22l5.9-1.5c1.6.9 3.5 1.3 5.5 1.3 5.5 0 10-4.1 10-9.2S17.5 2 12 2z'/></svg>");
  }

  .perfil-social__glyph--ig {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%23a1a1aa' stroke-width='1.8' viewBox='0 0 24 24'><rect x='3' y='3' width='18' height='18' rx='5'/><circle cx='12' cy='12' r='4'/><circle cx='17.5' cy='6.5' r='0.8' fill='%23a1a1aa' stroke='none'/></svg>");
  }

  .perfil-social__glyph--fb {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='%23a1a1aa' viewBox='0 0 24 24'><path d='M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1z'/></svg>");
  }

  .perfil-social__glyph--tt {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='%23a1a1aa' viewBox='0 0 24 24'><path d='M14 4c.4 2.4 1.8 4 4.2 4.3v2.4c-1.5 0-2.8-.5-4.2-1.4v6.4A6.3 6.3 0 1 1 11.2 9v2.5a3.8 3.8 0 1 0 2.8 3.6V4z'/></svg>");
  }

  .perfil-social__glyph--ta {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%23a1a1aa' stroke-width='1.8' viewBox='0 0 24 24'><path d='M4 10h16M12 4v6M8.5 10l-3 8M15.5 10l3 8M7 16h10'/></svg>");
  }

  .perfil-social input {
    width: 100%;
    min-width: 0;
    font-size: 0.84rem;
    padding: 0.58rem 0.75rem;
    border-radius: 0.75rem;
  }

  .perfil-social[data-on='false'] input {
    opacity: 0.42;
  }

  @media (max-width: 768px) {
    .perfil-group__head {
      padding: 0.8rem 0.85rem 0.4rem;
    }

    .perfil-day,
    .perfil-field,
    .perfil-social {
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }

    .perfil-day {
      flex-wrap: wrap;
      gap: 0.35rem 0.55rem;
    }

    .perfil-day__name {
      width: auto;
      flex: 1 1 auto;
    }

    .perfil-day .perfil-toggle {
      margin-left: 0;
    }

    .perfil-day__mid {
      flex: 1 1 100%;
      justify-content: flex-start;
    }

    .perfil-day input[type='time'] {
      min-width: 5.15rem;
      font-size: 0.75rem;
    }
  }
</style>
