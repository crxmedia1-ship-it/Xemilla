---
/**
 * Métricas — bento modular: tipografía de labels, dona monocroma y ranking rosa/azul.
 */
import { platoFillUrl } from '../../lib/plato-media-url.js';

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  metrics: any;
  title?: string;
  subtitle?: string;
  network?: boolean;
  brandName?: string;
  brandLogoUrl?: string;
  brandTagline?: string;
  allowLogoUpload?: boolean;
  restauranteId?: string;
  createdAt?: string | Date | null;
  localesCount?: number;
  localesActivos?: number;
  menuPlatos?: Array<{
    id?: string | number;
    nombre?: string;
    imagen_url?: string;
    categoria_nombre?: string;
    precio?: number | string;
  }>;
}

const {
  metrics,
  title = 'Métricas & Rendimiento',
  subtitle = '',
  network = false,
  createdAt = null,
  localesCount = 0,
  localesActivos = 0,
  menuPlatos = [],
} = Astro.props;

const m = metrics || {};
const masRaw = Array.isArray(m.platosMasVistos) ? m.platosMasVistos : [];
const menosRaw = Array.isArray(m.platosMenosVistos) ? m.platosMenosVistos : [];

const MONTHS_ES = [
  'Enero',
  'Febrero',
  'Marzo',
  'Abril',
  'Mayo',
  'Junio',
  'Julio',
  'Agosto',
  'Septiembre',
  'Octubre',
  'Noviembre',
  'Diciembre',
];

const now = new Date();
const currentMonthKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

/**
 * Meses desde el alta del restaurante hasta el mes en curso.
 * @param {string | Date | null | undefined} createdAtRaw
 * @param {Date} endDate
 * @returns {Array<{ value: string, label: string }>}
 */
function buildMonthOptions(createdAtRaw, endDate) {
  const end = new Date(endDate.getFullYear(), endDate.getMonth(), 1);
  let start = end;
  if (createdAtRaw) {
    const parsed = createdAtRaw instanceof Date ? createdAtRaw : new Date(createdAtRaw);
    if (!Number.isNaN(parsed.getTime())) {
      start = new Date(parsed.getFullYear(), parsed.getMonth(), 1);
    }
  }
  if (start > end) start = end;

  /** @type {Array<{ value: string, label: string }>} */
  const options = [];
  const cursor = new Date(start.getTime());
  while (cursor <= end) {
    options.push({
      value: `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, '0')}`,
      label: `${MONTHS_ES[cursor.getMonth()]} ${cursor.getFullYear()}`,
    });
    cursor.setMonth(cursor.getMonth() + 1);
  }
  return options;
}

const monthOptions = buildMonthOptions(createdAt, now);

/** @param {number} n */
function formatKpi(n) {
  return (Number(n) || 0).toLocaleString('en-US');
}

/** @param {number} n */
function formatRank(n) {
  return `#${String(Math.max(1, Number(n) || 1)).padStart(2, '0')}`;
}

/** @param {unknown} n */
function formatPrecio(n) {
  const v = Number(n);
  if (!Number.isFinite(v) || v < 0) return '';
  const body = Number.isInteger(v) ? String(v) : v.toFixed(2).replace(/\.00$/, '').replace('.', ',');
  return `$ ${body}`;
}

const totalVistas = Number(m.totalVistas) || masRaw.reduce((acc, row) => acc + (Number(row.vistas) || 0), 0);
const qrShare = 65;
const linkShare = 35;
const qrCount = 0;
const linkCount = 0;
const nosotrosCount = 0;
const reservasCount = 0;
const mapsCount = 0;

const moduleClass =
  'studio-kpi-card studio-kpi-module bg-white dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800/80 rounded-[2rem] p-6 lg:p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] dark:shadow-none dark:backdrop-blur-xl transition-all flex flex-col justify-between min-h-[230px]';

const boardClass =
  'studio-kpi-card studio-kpi-board bg-white dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800/80 rounded-[2rem] p-6 lg:p-7 shadow-[0_8px_30px_rgba(0,0,0,0.04)] dark:shadow-none dark:backdrop-blur-xl transition-all flex flex-col gap-4';

const photoChipBase =
  'studio-photo-chip relative z-10 px-2.5 py-1 rounded-xl text-xs font-mono font-bold bg-black/80 backdrop-blur-md border border-white/15';

const WEEK_LABELS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const WEEK_FALLBACK = [40, 55, 75, 48, 90, 62, 35];

/**
 * @param {unknown} counts
 * @returns {number[]}
 */
function heightsFromCounts(counts) {
  const nums = Array.isArray(counts) ? counts.map((n) => Number(n) || 0) : [];
  const max = Math.max(0, ...nums);
  if (max <= 0) return WEEK_FALLBACK;
  return nums.map((n) => (n > 0 ? Math.max(12, Math.round((n / max) * 100)) : 6));
}

const metaById = new Map();
const metaByName = new Map();
for (const plato of menuPlatos) {
  const meta = {
    imagen: String(plato?.imagen_url || '').trim(),
    categoria: String(plato?.categoria_nombre || '').trim(),
    precio: formatPrecio(plato?.precio),
  };
  if (plato?.id != null) metaById.set(String(plato.id), meta);
  const name = String(plato?.nombre || '').trim().toLowerCase();
  if (name) metaByName.set(name, meta);
}

const viewById = new Map();
const viewByName = new Map();
for (const row of [...masRaw, ...menosRaw]) {
  const vistas = Number(row.vistas) || 0;
  if (row.plato_id) viewById.set(String(row.plato_id), vistas);
  const name = String(row.nombre || '').trim().toLowerCase();
  if (name) viewByName.set(name, Math.max(viewByName.get(name) || 0, vistas));
}

const mergedMenu = (Array.isArray(menuPlatos) ? menuPlatos : [])
  .map((plato) => {
    const id = plato?.id != null ? String(plato.id) : '';
    const nombre = String(plato?.nombre || 'Plato').trim() || 'Plato';
    const vistas = (id && viewById.get(id)) || viewByName.get(nombre.toLowerCase()) || 0;
    return {
      plato_id: id,
      nombre,
      vistas,
      imagen: String(plato?.imagen_url || '').trim(),
      categoria: String(plato?.categoria_nombre || '').trim(),
      precio: formatPrecio(plato?.precio),
    };
  })
  .filter((row) => row.nombre);

const ranked =
  mergedMenu.length > 0
    ? mergedMenu
    : [...masRaw, ...menosRaw]
        .filter((row, i, arr) => {
          const key = String(row.plato_id || row.nombre || i);
          return arr.findIndex((x) => String(x.plato_id || x.nombre) === key) === i;
        })
        .map((row) => {
          const id = String(row.plato_id || '');
          const extra = (id && metaById.get(id)) || metaByName.get(String(row.nombre || '').toLowerCase()) || {};
          return {
            plato_id: id,
            nombre: String(row.nombre || 'Plato'),
            vistas: Number(row.vistas) || 0,
            imagen: extra.imagen || '',
            categoria: extra.categoria || '',
            precio: extra.precio || '',
          };
        });

const maxVistas = Math.max(
  1,
  ...ranked.map((row) => row.vistas),
  ...masRaw.map((row) => Number(row.vistas) || 0),
);

function withMeta(list) {
  return list.map((row) => {
    const extra =
      (row.plato_id && metaById.get(row.plato_id)) ||
      metaByName.get(String(row.nombre || '').toLowerCase()) ||
      {};
    const imagen = row.imagen || extra.imagen || '';
    const categoria = row.categoria || extra.categoria || '';
    const precio = row.precio || extra.precio || '';
    const detalle = [categoria, precio].filter(Boolean).join(' · ');
    return {
      ...row,
      categoria,
      precio,
      detalle,
      pct: row.vistas > 0 ? Math.max(6, Math.round((row.vistas / maxVistas) * 100)) : 0,
      imagen,
      foto: imagen ? platoFillUrl(imagen, { w: 960, h: 720 }) : '',
    };
  });
}

function takeTen(list) {
  const rows = withMeta(list).slice(0, 10);
  if (rows.length > 0) return rows;
  return Array.from({ length: 5 }, () => ({
    plato_id: '',
    nombre: 'Sin datos aún',
    vistas: 0,
    pct: 0,
    imagen: '',
    foto: '',
    categoria: '',
    precio: '',
    detalle: '',
  }));
}

const topMas = takeTen([...ranked].sort((a, b) => b.vistas - a.vistas));
const topMenos = takeTen(
  [...ranked].sort((a, b) => a.vistas - b.vistas || a.nombre.localeCompare(b.nombre)),
);

const shownDefault = Math.min(5, topMas.length);
const canExpandMas = topMas.length > 5;
const canExpandMenos = topMenos.length > 5;

const seriesRaw = m.vistasSeries || {};
const weekdaysRaw = seriesRaw.weekdays || {};
const weekHeights = heightsFromCounts(weekdaysRaw.all);
const monthsMap = seriesRaw.months || {};

/**
 * @param {string} key
 */
function previousMonthKey(key) {
  const [y, mo] = String(key)
    .split('-')
    .map((part) => Number(part));
  if (!y || !mo) return '';
  if (mo === 1) return `${y - 1}-12`;
  return `${y}-${String(mo - 1).padStart(2, '0')}`;
}

const currMonthTotal = Number(monthsMap[currentMonthKey]?.total) || 0;
const prevMonthTotal = Number(monthsMap[previousMonthKey(currentMonthKey)]?.total) || 0;
const momPct = prevMonthTotal > 0 ? Math.round(((currMonthTotal - prevMonthTotal) / prevMonthTotal) * 100) : 0;
const momLabel = `${momPct >= 0 ? '+' : ''}${momPct}% este mes`;

const listRowClass =
  'flex items-center justify-between gap-4 py-3 px-2 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-900/40 transition-colors';

const actionRowClass =
  'studio-action-row p-3 rounded-2xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors';

const seriesPayload = {
  eventMode: Boolean(m.eventMode),
  currentMonth: currentMonthKey,
  all: seriesRaw.all || { total: totalVistas, platos: {} },
  months: monthsMap,
  weekdays: {
    all: Array.isArray(weekdaysRaw.all) ? weekdaysRaw.all : WEEK_FALLBACK,
    months: weekdaysRaw.months || {},
  },
  fallbackWeek: WEEK_FALLBACK,
};

const tfOn =
  'studio-tf-on px-3 py-1.5 rounded-xl font-semibold bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white shadow-xs';
const tfOff =
  'px-3 py-1.5 rounded-xl font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors';

const segOn =
  'studio-seg-on px-2.5 py-1 rounded-lg bg-white dark:bg-zinc-700 shadow-xs font-medium text-zinc-800 dark:text-zinc-200';
const segOff =
  'px-2.5 py-1 rounded-lg text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors';
---

<section
  class="w-full flex flex-col gap-6"
  data-admin-metrics
  data-kit-metrics
  data-metrics-series={JSON.stringify(seriesPayload)}
>
  <header class="flex flex-wrap items-center justify-between gap-4 pb-2">
    <div class="min-w-0">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">{title}</h2>
      {
        subtitle || network ? (
          <p class="mt-1 text-sm text-zinc-500">
            {subtitle}
            {network ? `${subtitle ? ' · ' : ''}${localesCount} locales · ${localesActivos} activos` : ''}
          </p>
        ) : null
      }
    </div>
    <div
      class="inline-flex p-1 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl border border-zinc-200/80 dark:border-zinc-700/80 text-xs"
      data-timeframe-bar
      role="group"
      aria-label="Periodo de métricas"
    >
      <button type="button" class={tfOn} data-timeframe="all" aria-pressed="true">General</button>
      <button type="button" class={tfOff} data-timeframe="current" aria-pressed="false">Este Mes</button>
      <select
        class="bg-transparent text-zinc-500 font-medium px-2 py-1 outline-none cursor-pointer hover:text-zinc-900 dark:hover:text-white"
        data-timeframe-month
        aria-label="Mes a mes"
      >
        <option value="" selected>Mes a mes</option>
        {monthOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
      </select>
    </div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-6 w-full items-stretch">
    <article class={`${moduleClass} xl:col-span-5`}>
      <div class="flex items-start justify-between gap-3">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400">Vistas Totales WebApp</span>
        <span
          class="studio-mom text-[11px] font-mono font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full"
          data-mom
        >
          {momLabel}
        </span>
      </div>
      <p
        class="text-5xl lg:text-6xl font-light font-mono text-zinc-900 dark:text-white tracking-tight my-2"
        data-kit-count={String(totalVistas)}
        data-kit-display={formatKpi(totalVistas)}
        data-kpi="vistas"
      >
        {formatKpi(totalVistas)}
      </p>
      <div class="flex items-end justify-between gap-3 h-24 pt-4 border-b border-zinc-100 dark:border-zinc-800/60 pb-2" data-week-chart aria-hidden="true">
        {
          WEEK_LABELS.map((day, i) => (
            <div class="studio-week-col group relative flex-1 flex flex-col items-center h-full justify-end">
              <div
                class="studio-week-bar w-full rounded-t-md bg-zinc-900 dark:bg-zinc-100 group-hover:bg-zinc-700 dark:group-hover:bg-white transition-all min-h-[6px]"
                data-week-bar
                data-fallback={String(WEEK_FALLBACK[i])}
                style={`height:${weekHeights[i] || WEEK_FALLBACK[i]}%`}
              ></div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 mt-2">{day}</span>
            </div>
          ))
        }
      </div>
    </article>

    <article class={`${moduleClass} xl:col-span-3`}>
      <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400">Origen del Tráfico</span>
      <div
        class="studio-donut relative w-24 h-24 mx-auto my-2 rounded-full flex items-center justify-center ring-1 ring-zinc-200/80 dark:ring-zinc-700"
        style={`background: conic-gradient(#18181b ${qrShare}%, #e4e4e7 0)`}
        data-donut
      >
        <div class="studio-donut-hole w-16 h-16 bg-white dark:bg-zinc-950 rounded-full flex items-center justify-center text-xs font-mono font-bold text-zinc-900 dark:text-white">
          <span data-donut-pct>{qrShare}%</span>
        </div>
      </div>
      <div class="flex flex-col w-full">
        <div class="flex items-center justify-between py-2 border-b border-zinc-100 dark:border-zinc-800/60 last:border-0 text-xs">
          <span class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400">
            <span class="studio-dot-ink w-2 h-2 rounded-full bg-zinc-900 dark:bg-white"></span>
            QR en Mesa
          </span>
          <span class="font-mono font-bold text-zinc-900 dark:text-white">
            <span data-kpi="qr">{formatKpi(qrCount)}</span>
            {' '}
            <span class="text-zinc-400 font-normal text-[10px]">({qrShare}%)</span>
          </span>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-zinc-100 dark:border-zinc-800/60 last:border-0 text-xs">
          <span class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400">
            <span class="studio-dot-mute w-2 h-2 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            Enlace Directo
          </span>
          <span class="font-mono font-bold text-zinc-900 dark:text-white">
            <span data-kpi="link">{formatKpi(linkCount)}</span>
            {' '}
            <span class="text-zinc-400 font-normal text-[10px]">({linkShare}%)</span>
          </span>
        </div>
      </div>
    </article>

    <article class={`${moduleClass} xl:col-span-4`}>
      <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400">Acciones de Comensales</span>
      <div class="flex flex-col gap-2">
        <div class={actionRowClass}>
          <span class="text-xs font-medium text-zinc-700 dark:text-zinc-300">📖 Sección Nosotros</span>
          <span
            class="text-base font-mono font-bold text-zinc-900 dark:text-white"
            data-kit-count={String(nosotrosCount)}
            data-kit-display={formatKpi(nosotrosCount)}
            data-kpi="nosotros"
          >
            {formatKpi(nosotrosCount)}
          </span>
        </div>
        <div class={actionRowClass}>
          <span class="text-xs font-medium text-zinc-700 dark:text-zinc-300">🔔 Pedir / Reservar</span>
          <span
            class="text-base font-mono font-bold text-zinc-900 dark:text-white"
            data-kit-count={String(reservasCount)}
            data-kit-display={formatKpi(reservasCount)}
            data-kpi="reservas"
          >
            {formatKpi(reservasCount)}
          </span>
        </div>
        <div class={actionRowClass}>
          <span class="text-xs font-medium text-zinc-700 dark:text-zinc-300">📍 Rutas en Maps</span>
          <span
            class="text-base font-mono font-bold text-zinc-900 dark:text-white"
            data-kit-count={String(mapsCount)}
            data-kit-display={formatKpi(mapsCount)}
            data-kpi="maps"
          >
            {formatKpi(mapsCount)}
          </span>
        </div>
      </div>
    </article>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full items-start pb-10">
    <article
      class={boardClass}
      data-platos-board
      data-board-sort="desc"
      data-expanded="false"
    >
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-sm font-semibold tracking-wide text-zinc-900 dark:text-white">Top Rendimiento (Más Vistos)</h3>
        <div class="inline-flex gap-1 rounded-xl bg-zinc-100 p-1 text-xs dark:bg-zinc-800" role="group" aria-label="Vista Top Rendimiento">
          <button type="button" class={segOn} data-tab-view="list" aria-pressed="true">Lista</button>
          <button type="button" class={segOff} data-tab-view="grid" aria-pressed="false">Fotos</button>
        </div>
      </div>

      <div class="view-list flex flex-col divide-y divide-zinc-100 dark:divide-zinc-800/50 w-full">
        {
          topMas.map((row, i) => (
            <div
              class={listRowClass}
              data-rank={i + 1}
              data-plato-id={row.plato_id || ''}
              hidden={i >= 5}
            >
              <span class="studio-hot font-mono text-xs font-bold w-7 text-rose-500" data-rank-label>
                {formatRank(i + 1)}
              </span>
              <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 truncate flex-1">{row.nombre}</span>
              <div class="w-24 sm:w-28 h-1 bg-zinc-100 dark:bg-zinc-800 rounded-full overflow-hidden hidden sm:block shrink-0">
                <div class="studio-pct-ink h-full bg-zinc-900 dark:bg-zinc-200 rounded-full" data-pct-bar style={`width:${row.pct}%`}></div>
              </div>
              <span class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 shrink-0" data-vistas-label>
                {formatKpi(row.vistas)} vistas
              </span>
            </div>
          ))
        }
      </div>

      <div class="view-grid hidden grid grid-cols-2 gap-4 w-full">
        {
          topMas.map((row, i) => (
            <article
              class="studio-photo-card aspect-[16/10] relative rounded-2xl overflow-hidden bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800 shadow-sm group p-2.5 flex flex-col justify-between"
              data-rank={i + 1}
              data-plato-id={row.plato_id || ''}
              hidden={i >= 5}
            >
              {row.foto ? (
                <img
                  src={row.foto}
                  alt={row.nombre}
                  class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
              <div class="relative z-10 flex items-start justify-between gap-1.5">
                <span class={`${photoChipBase} studio-chip-hot text-rose-500`} data-rank-label>{formatRank(i + 1)}</span>
                <span class={`${photoChipBase} studio-chip-ink text-white`} data-vistas-label>
                  {formatKpi(row.vistas)} vistas
                </span>
              </div>
              <div class="studio-photo-caption relative z-10 p-2.5 rounded-xl bg-black/80 backdrop-blur-md border border-white/15 flex flex-col gap-0.5 mt-auto">
                <h4 class="text-sm font-bold text-white truncate">{row.nombre}</h4>
                <span class="studio-photo-meta text-xs text-zinc-300 font-mono truncate">{row.detalle || row.precio}</span>
              </div>
            </article>
          ))
        }
      </div>

      <footer class="flex items-center justify-between gap-3">
        <span class="text-xs text-zinc-400" data-activos-label>
          {shownDefault} platos activos
        </span>
        <button
          type="button"
          class="text-xs font-medium text-zinc-500 transition-colors hover:text-zinc-800 disabled:pointer-events-none disabled:opacity-40 dark:hover:text-zinc-200"
          data-expand-top
          disabled={!canExpandMas}
        >
          Ver Top 10 completo ↓
        </button>
      </footer>
    </article>

    <article
      class={boardClass}
      data-platos-board
      data-board-sort="asc"
      data-expanded="false"
    >
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-sm font-semibold tracking-wide text-zinc-900 dark:text-white">Oportunidades (Menos Vistos)</h3>
        <div class="inline-flex gap-1 rounded-xl bg-zinc-100 p-1 text-xs dark:bg-zinc-800" role="group" aria-label="Vista Oportunidades">
          <button type="button" class={segOn} data-tab-view="list" aria-pressed="true">Lista</button>
          <button type="button" class={segOff} data-tab-view="grid" aria-pressed="false">Fotos</button>
        </div>
      </div>

      <div class="view-list flex flex-col divide-y divide-zinc-100 dark:divide-zinc-800/50 w-full">
        {
          topMenos.map((row, i) => (
            <div
              class={listRowClass}
              data-rank={i + 1}
              data-plato-id={row.plato_id || ''}
              hidden={i >= 5}
            >
              <span class="studio-cold font-mono text-xs font-bold w-7 text-sky-500" data-rank-label>
                {formatRank(i + 1)}
              </span>
              <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 truncate flex-1">{row.nombre}</span>
              <div class="w-24 sm:w-28 h-1 bg-zinc-100 dark:bg-zinc-800 rounded-full overflow-hidden hidden sm:block shrink-0">
                <div class="studio-pct-ink h-full bg-zinc-900 dark:bg-zinc-200 rounded-full" data-pct-bar style={`width:${row.pct}%`}></div>
              </div>
              <span class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 shrink-0" data-vistas-label>
                {formatKpi(row.vistas)} vistas
              </span>
            </div>
          ))
        }
      </div>

      <div class="view-grid hidden grid grid-cols-2 gap-4 w-full">
        {
          topMenos.map((row, i) => (
            <article
              class="studio-photo-card aspect-[16/10] relative rounded-2xl overflow-hidden bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800 shadow-sm group p-2.5 flex flex-col justify-between"
              data-rank={i + 1}
              data-plato-id={row.plato_id || ''}
              hidden={i >= 5}
            >
              {row.foto ? (
                <img
                  src={row.foto}
                  alt={row.nombre}
                  class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
              <div class="relative z-10 flex items-start justify-between gap-1.5">
                <span class={`${photoChipBase} studio-chip-cold text-sky-400`} data-rank-label>{formatRank(i + 1)}</span>
                <span class={`${photoChipBase} studio-chip-ink text-white`} data-vistas-label>
                  {formatKpi(row.vistas)} vistas
                </span>
              </div>
              <div class="studio-photo-caption relative z-10 p-2.5 rounded-xl bg-black/80 backdrop-blur-md border border-white/15 flex flex-col gap-0.5 mt-auto">
                <h4 class="text-sm font-bold text-white truncate">{row.nombre}</h4>
                <span class="studio-photo-meta text-xs text-zinc-300 font-mono truncate">{row.detalle || row.precio}</span>
              </div>
            </article>
          ))
        }
      </div>

      <footer class="flex items-center justify-between gap-3">
        <span class="text-xs text-zinc-400" data-activos-label>
          {shownDefault} platos activos
        </span>
        <button
          type="button"
          class="text-xs font-medium text-zinc-500 transition-colors hover:text-zinc-800 disabled:pointer-events-none disabled:opacity-40 dark:hover:text-zinc-200"
          data-expand-top
          disabled={!canExpandMenos}
        >
          Ver Top 10 completo ↓
        </button>
      </footer>
    </article>
  </div>
</section>

<script>
  /** @param {number} n */
  function formatKpi(n) {
    return Math.max(0, Number(n) || 0).toLocaleString('en-US');
  }

  /** @param {number} n */
  function formatRank(n) {
    return `#${String(Math.max(1, Number(n) || 1)).padStart(2, '0')}`;
  }

  /**
   * @param {unknown} counts
   * @param {number[]} fallback
   * @returns {number[]}
   */
  function heightsFromCounts(counts, fallback) {
    const nums = Array.isArray(counts) ? counts.map((n) => Number(n) || 0) : [];
    const max = Math.max(0, ...nums);
    if (max <= 0) return fallback;
    return nums.map((n) => (n > 0 ? Math.max(12, Math.round((n / max) * 100)) : 6));
  }

  /**
   * @param {HTMLElement} el
   */
  function animateCount(el) {
    const target = Number(el.dataset.kitCount);
    if (!Number.isFinite(target)) return;
    const finalText = el.dataset.kitDisplay || formatKpi(target);
    const duration = 820;
    const start = performance.now();

    /** @param {number} now */
    function frame(now) {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - (1 - t) ** 3;
      el.textContent = formatKpi(Math.round(target * eased));
      if (t < 1) requestAnimationFrame(frame);
      else el.textContent = finalText;
    }
    requestAnimationFrame(frame);
  }

  /**
   * @param {HTMLElement} kit
   */
  function playKitMotion(kit) {
    if (kit.dataset.live === 'true') return;
    kit.dataset.live = 'true';
    kit.querySelectorAll('[data-kit-count]').forEach((node) => {
      if (node instanceof HTMLElement) animateCount(node);
    });
  }

  const SEG_ON =
    'studio-seg-on px-2.5 py-1 rounded-lg bg-white dark:bg-zinc-700 shadow-xs font-medium text-zinc-800 dark:text-zinc-200';
  const SEG_OFF =
    'px-2.5 py-1 rounded-lg text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors';
  const TF_ON =
    'studio-tf-on px-3 py-1.5 rounded-xl font-semibold bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white shadow-xs';
  const TF_OFF =
    'px-3 py-1.5 rounded-xl font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors';

  /**
   * @param {HTMLElement} board
   */
  function initPlatosBoard(board) {
    if (board.dataset.ready === 'true') return;
    board.dataset.ready = 'true';

    const list = board.querySelector('.view-list');
    const grid = board.querySelector('.view-grid');
    const label = board.querySelector('[data-activos-label]');
    const totalRanked = board.querySelectorAll('[data-rank]').length / 2;

    /**
     * @param {'list' | 'grid'} view
     */
    function setView(view) {
      if (list instanceof HTMLElement) {
        list.classList.toggle('hidden', view !== 'list');
      }
      if (grid instanceof HTMLElement) {
        grid.classList.toggle('hidden', view !== 'grid');
      }
      board.querySelectorAll('[data-tab-view]').forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        const on = btn.getAttribute('data-tab-view') === view;
        btn.className = on ? SEG_ON : SEG_OFF;
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    board.querySelectorAll('[data-tab-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        setView(btn.getAttribute('data-tab-view') === 'grid' ? 'grid' : 'list');
      });
    });

    const expandBtn = board.querySelector('[data-expand-top]');
    if (expandBtn instanceof HTMLButtonElement && !expandBtn.disabled) {
      expandBtn.addEventListener('click', () => {
        const next = board.dataset.expanded !== 'true';
        board.dataset.expanded = next ? 'true' : 'false';
        board.querySelectorAll('[data-rank]').forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const rank = Number(el.getAttribute('data-rank'));
          if (rank > 5) el.hidden = !next;
        });
        const shown = Math.min(next ? 10 : 5, Number.isFinite(totalRanked) ? totalRanked : 5);
        if (label) label.textContent = `${shown} platos activos`;
        expandBtn.textContent = next ? 'Ver Top 5 ↑' : 'Ver Top 10 completo ↓';
      });
    }
  }

  /**
   * @param {unknown} raw
   */
  function parseSeries(raw) {
    if (!raw) {
      return {
        eventMode: false,
        currentMonth: '',
        all: { total: 0, platos: {} },
        months: {},
        weekdays: { all: [], months: {} },
        fallbackWeek: [40, 55, 75, 48, 90, 62, 35],
      };
    }
    try {
      return typeof raw === 'string' ? JSON.parse(raw) : raw;
    } catch {
      return {
        eventMode: false,
        currentMonth: '',
        all: { total: 0, platos: {} },
        months: {},
        weekdays: { all: [], months: {} },
        fallbackWeek: [40, 55, 75, 48, 90, 62, 35],
      };
    }
  }

  /**
   * @param {HTMLElement} kit
   * @param {{ total?: number, platos?: Record<string, number> }} bucket
   * @param {number[]} weekCounts
   */
  function applyBucket(kit, bucket, weekCounts) {
    const platos = bucket?.platos || {};
    const total = Number(bucket?.total) || 0;
    const vistasEl = kit.querySelector('[data-kpi="vistas"]');
    if (vistasEl instanceof HTMLElement) {
      vistasEl.dataset.kitCount = String(total);
      vistasEl.dataset.kitDisplay = formatKpi(total);
      vistasEl.textContent = formatKpi(total);
    }

    const bars = [...kit.querySelectorAll('[data-week-bar]')];
    const fallback = bars.map((el) => Number(el.getAttribute('data-fallback')) || 40);
    const heights = heightsFromCounts(weekCounts, fallback);
    bars.forEach((bar, i) => {
      if (bar instanceof HTMLElement) bar.style.height = `${heights[i] || fallback[i] || 40}%`;
    });

    kit.querySelectorAll('[data-platos-board]').forEach((board) => {
      if (!(board instanceof HTMLElement)) return;
      const sortAsc = board.getAttribute('data-board-sort') === 'asc';
      const list = board.querySelector('.view-list');
      const grid = board.querySelector('.view-grid');

      /**
       * @param {Element | null} wrap
       */
      function rankWrap(wrap) {
        if (!(wrap instanceof HTMLElement)) return;
        const cards = [...wrap.querySelectorAll('[data-plato-id]')];
        const max = Math.max(1, ...cards.map((el) => Number(platos[el.getAttribute('data-plato-id') || ''] || 0)));
        cards.sort((a, b) => {
          const va = Number(platos[a.getAttribute('data-plato-id') || ''] || 0);
          const vb = Number(platos[b.getAttribute('data-plato-id') || ''] || 0);
          if (va !== vb) return sortAsc ? va - vb : vb - va;
          return (a.textContent || '').localeCompare(b.textContent || '');
        });
        cards.forEach((el, i) => {
          if (!(el instanceof HTMLElement)) return;
          const id = el.getAttribute('data-plato-id') || '';
          const vistas = Number(platos[id] || 0);
          const pct = vistas > 0 ? Math.max(6, Math.round((vistas / max) * 100)) : 0;
          el.setAttribute('data-rank', String(i + 1));
          const expanded = board.dataset.expanded === 'true';
          el.hidden = !expanded && i >= 5;
          const rankLabel = el.querySelector('[data-rank-label]');
          if (rankLabel) rankLabel.textContent = formatRank(i + 1);
          const vistasLabel = el.querySelector('[data-vistas-label]');
          if (vistasLabel) vistasLabel.textContent = `${formatKpi(vistas)} vistas`;
          const bar = el.querySelector('[data-pct-bar]');
          if (bar instanceof HTMLElement) bar.style.width = `${pct}%`;
          wrap.appendChild(el);
        });
      }

      rankWrap(list);
      rankWrap(grid);
    });
  }

  /**
   * @param {HTMLElement} kit
   */
  function initTimeframe(kit) {
    if (kit.dataset.tfReady === 'true') return;
    kit.dataset.tfReady = 'true';

    const series = parseSeries(kit.getAttribute('data-metrics-series'));
    const bar = kit.querySelector('[data-timeframe-bar]');
    const monthSelect = kit.querySelector('[data-timeframe-month]');
    if (!(bar instanceof HTMLElement)) return;

    /**
     * @param {'all' | 'current' | 'month'} mode
     * @param {string} [month]
     */
    function setTimeframe(mode, month = '') {
      const buttons = bar.querySelectorAll('[data-timeframe]');
      buttons.forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        const on =
          mode === 'all'
            ? btn.getAttribute('data-timeframe') === 'all'
            : mode === 'current'
              ? btn.getAttribute('data-timeframe') === 'current'
              : false;
        btn.className = on ? TF_ON : TF_OFF;
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (monthSelect instanceof HTMLSelectElement) {
        monthSelect.classList.toggle('studio-tf-select-on', mode === 'month');
        if (mode !== 'month') monthSelect.value = '';
      }

      let bucket = series.all || { total: 0, platos: {} };
      let weekCounts = series.weekdays?.all || [];
      if (series.eventMode) {
        if (mode === 'current') {
          bucket = series.months?.[series.currentMonth] || { total: 0, platos: {} };
          weekCounts = series.weekdays?.months?.[series.currentMonth] || [];
        } else if (mode === 'month' && month) {
          bucket = series.months?.[month] || { total: 0, platos: {} };
          weekCounts = series.weekdays?.months?.[month] || [];
        }
      }
      applyBucket(kit, bucket, weekCounts);
    }

    bar.querySelectorAll('[data-timeframe]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-timeframe') === 'current' ? 'current' : 'all';
        setTimeframe(mode);
      });
    });

    if (monthSelect instanceof HTMLSelectElement) {
      monthSelect.addEventListener('change', () => {
        const value = monthSelect.value;
        if (!value) {
          setTimeframe('all');
          return;
        }
        setTimeframe('month', value);
      });
    }
  }

  function initMetricsUi() {
    /** @type {Set<Element>} */
    const seen = new Set();

    /**
     * @param {Element} panel
     */
    function bindPanel(panel) {
      if (!(panel instanceof HTMLElement) || seen.has(panel)) return;
      seen.add(panel);
      const run = () => {
        if (panel.hidden || panel.classList.contains('hidden')) return;
        const kit = panel.querySelector('[data-kit-metrics]');
        if (kit instanceof HTMLElement) playKitMotion(kit);
      };
      run();
      const observer = new MutationObserver(run);
      observer.observe(panel, { attributes: true, attributeFilter: ['hidden', 'class'] });
    }

    document.querySelectorAll('[data-tab-panel="metricas"], [data-super-panel="metricas"]').forEach(bindPanel);
    document.querySelectorAll('[data-kit-metrics]').forEach((kit) => {
      const panel = kit.closest('[data-tab-panel], [data-super-panel]');
      if (panel) bindPanel(panel);
      else if (kit instanceof HTMLElement) playKitMotion(kit);
      if (kit instanceof HTMLElement) {
        initTimeframe(kit);
        kit.querySelectorAll('[data-platos-board]').forEach((board) => {
          if (board instanceof HTMLElement) initPlatosBoard(board);
        });
      }
    });
  }

  initMetricsUi();
  document.addEventListener('astro:page-load', initMetricsUi);
</script>
