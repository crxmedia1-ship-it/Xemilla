---
/**
 * Flyer / pop-up de bienvenida — diseño premium (switch + imagen).
 */
interface PopupBannerState {
  enabled: boolean;
  image_url: string;
  title?: string;
  description?: string;
  button_text?: string;
  action_type?: string;
  action_url?: string;
}

interface Props {
  scope?: string;
  banner: PopupBannerState;
}

const { scope = 'perfil', banner } = Astro.props;
const enabled = Boolean(banner.enabled);
const hasImage = Boolean(String(banner.image_url || '').trim());
---

<div
  class="w-full h-full bg-white border border-zinc-200 rounded-2xl p-6 flex flex-col shadow-sm welcome-popup-admin"
  data-welcome-popup={scope}
  data-popup-enabled-state={enabled ? 'true' : 'false'}
>
  <div class="mb-4 flex items-center justify-between gap-3 border-b border-zinc-100 pb-4">
    <div class="min-w-0">
      <h3 class="m-0 text-base font-semibold text-zinc-900">Flyer / Pop-up de Bienvenida</h3>
      <p class="mt-0.5 m-0 text-xs text-zinc-500">
        Muestra una promoción o evento en pantalla completa al entrar al menú
      </p>
    </div>
    <button
      type="button"
      role="switch"
      aria-checked={enabled}
      aria-label="Activar flyer de bienvenida"
      data-popup-enabled-toggle
      title="Activar o desactivar flyer"
      class:list={[
        'flyer-switch relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40',
        enabled ? 'is-on bg-emerald-500' : 'bg-zinc-200',
      ]}
    >
      <span
        data-popup-switch-knob
        class:list={[
          'flyer-switch__knob pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out',
          enabled ? 'translate-x-5' : 'translate-x-0',
        ]}
        aria-hidden="true"
      ></span>
    </button>
  </div>

  <div
    class="rounded-xl border border-zinc-200/60 bg-zinc-50/70 p-6 text-center"
    data-popup-empty
    hidden={enabled}
  >
    <div
      class="mx-auto mb-3 grid h-10 w-10 place-items-center rounded-full bg-white text-zinc-500 shadow-sm ring-1 ring-zinc-200/80"
      aria-hidden="true"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 11v2a1 1 0 0 0 1 1h1.2l7.3 4.4a1 1 0 0 0 1.5-.8V6.4a1 1 0 0 0-1.5-.8L5.2 10H4a1 1 0 0 0-1 1z"></path>
        <path d="M16.5 8.5a4.5 4.5 0 0 1 0 7"></path>
        <path d="M18.7 6.3a7.5 7.5 0 0 1 0 11.4"></path>
      </svg>
    </div>
    <p class="m-0 text-xs font-medium text-zinc-500">
      El pop-up está desactivado. Activa el switch para cargar un flyer promocional.
    </p>
  </div>

  <div class="flex min-h-0 flex-1 flex-col" data-popup-body hidden={!enabled}>
    <div
      class:list={[
        'welcome-popup-admin__drop group relative flex w-full flex-1 cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl transition-all',
        hasImage
          ? 'has-image aspect-[4/5] border border-zinc-200 bg-zinc-100 shadow-sm'
          : 'aspect-[4/5] border-2 border-dashed border-zinc-300 bg-zinc-50 p-6 text-center hover:border-zinc-400 hover:bg-zinc-100/80',
      ]}
      data-popup-drop
      data-popup-has-image={hasImage ? 'true' : 'false'}
    >
      <input
        type="file"
        accept="image/*"
        data-popup-file
        class="sr-only"
        id={`${scope}-popup-file`}
      />

      {
        hasImage ? (
          <img
            src={banner.image_url}
            alt="Flyer promocional"
            class="absolute inset-0 h-full w-full object-cover"
            data-popup-preview-img
          />
        ) : (
          <div class="flex flex-col items-center justify-center" data-popup-drop-empty>
            <div class="mb-3 rounded-full bg-white p-3 text-zinc-600 shadow-sm transition-transform group-hover:scale-105">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 16V6"></path>
                <path d="m8 10 4-4 4 4"></path>
                <path d="M4 18h16"></path>
              </svg>
            </div>
            <span class="text-xs font-semibold text-zinc-800">Haz clic o arrastra tu flyer</span>
            <span class="mt-1 text-[11px] text-zinc-400">Formato vertical (PNG, JPG o WebP)</span>
          </div>
        )
      }

      <div
        class:list={[
          'welcome-popup-admin__drop-actions absolute inset-x-0 bottom-0 z-[2] flex flex-wrap items-center justify-center gap-2 p-3',
          hasImage
            ? 'bg-gradient-to-t from-black/55 via-black/25 to-transparent opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100'
            : 'relative mt-0 bg-transparent opacity-0 pointer-events-none',
        ]}
      >
        <button
          type="button"
          class="rounded-full bg-white px-3 py-1.5 text-[0.65rem] font-semibold text-zinc-900 shadow-sm transition hover:bg-zinc-50"
          data-popup-change
        >
          {hasImage ? 'Cambiar imagen' : 'Subir flyer'}
        </button>
        <button
          type="button"
          class="rounded-full border border-white/40 bg-black/35 px-3 py-1.5 text-[0.65rem] font-semibold text-white backdrop-blur-sm transition hover:bg-black/50"
          data-popup-remove
          hidden={!hasImage}
        >
          Eliminar
        </button>
      </div>
    </div>
    <input type="hidden" data-popup-image-url value={banner.image_url} />
  </div>

  <input type="hidden" data-popup-enabled value={enabled ? 'true' : 'false'} />
</div>

<style>
  .flyer-switch {
    width: 2.75rem;
    height: 1.5rem;
    background: #e4e4e7;
  }

  .flyer-switch.is-on {
    background: #10b981;
  }

  .flyer-switch__knob {
    width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.125rem;
  }

  .flyer-switch.is-on .flyer-switch__knob {
    transform: translateX(1.25rem);
  }

  [data-popup-body][hidden],
  [data-popup-empty][hidden],
  [data-popup-remove][hidden] {
    display: none !important;
  }

  .welcome-popup-admin__drop.is-dragover {
    border-color: #10b981 !important;
    background: rgba(16, 185, 129, 0.08) !important;
  }

  .welcome-popup-admin__drop.has-image:not(:hover):not(:focus-within) .welcome-popup-admin__drop-actions {
    opacity: 0;
  }
</style>
